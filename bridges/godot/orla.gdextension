; The in-process session: `OrlaSession`, from `cargo build --release -p
; orla-godot`. The library is found relative to this file, in the
; workspace's target directory; without it the project still runs, over
; the socket.

[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.5
reloadable = true

[libraries]
macos.debug = "res://../../target/release/liborla_godot.dylib"
macos.release = "res://../../target/release/liborla_godot.dylib"
linux.debug.x86_64 = "res://../../target/release/liborla_godot.so"
linux.release.x86_64 = "res://../../target/release/liborla_godot.so"
linux.debug.arm64 = "res://../../target/release/liborla_godot.so"
linux.release.arm64 = "res://../../target/release/liborla_godot.so"
windows.debug.x86_64 = "res://../../target/release/orla_godot.dll"
windows.release.x86_64 = "res://../../target/release/orla_godot.dll"
