//! One clip playing on one skeleton, as one node. Place it with
//!   node posed: graph "skin.orlapkg/graphs/pose.osn" {
//!       mesh <- mesh; weights <- weights; skeleton <- skeleton;
//!       clip <- walk; at <- clock.result; rate = 30.0;
//!   }
//! and hand `posed.result` to whatever projects it. Blending two clips
//! wants the Kernels themselves: sample each, `skin.blend@1`, then
//! `skin.palette@1`.
use "../kernels/skin.orla";

input mesh: Rows<Point>;
input weights: Rows<Bound>;
input skeleton: Skeleton;
input clip: Clip;
input at: Rows<Float>;

param rate: Float = 30.0;
param repeat: Bool = true;
param depth: Int = 64;

node poses: skin.sample@1 {
    skeleton <- skeleton;
    clip <- clip;
    at <- at;
    rate = rate;
    repeat = repeat;
}
node palette: skin.palette@1 { poses <- poses.result; skeleton <- skeleton; depth = depth; }
node posed: skin.apply@1 {
    mesh <- mesh;
    weights <- weights;
    palette <- palette.result;
    skeleton <- skeleton;
}

output result <- posed.result;
output palette <- palette.result;
