// The marks of age a surface gathers, each a mask from 0 to 1 a material
// darkens, stains or wets by: streaks run down a wall from rain, grime
// risen from the ground, drips under a sill, dust and moss on what faces
// up, edges worn back, dirt gathered in hollows, puddles, and what water
// does to a surface it wets.
use "random.entpkg";

/// Rain's streaks down a wall: across it at `u`, up it at `v` (meters),
/// `every` meters apart on the whole, `length` meters long on the whole
/// (`seed` their hash).
fn texture_streaks(u: Float, v: Float, every: Float, length: Float, seed: Int) -> Float {
    let n = fbm2(vec2(u / max(every, 0.001), v / max(length, 0.001)), 3, seed) * 0.5 + 0.5;
    return smoothstep(0.55, 0.8, n);
}

/// Grime risen from the ground on what stands on it, `height` meters up,
/// fading out by `reach`, uneven by a noise at `uv` (`seed`).
fn texture_grime(height: Float, reach: Float, uv: Vec2, seed: Int) -> Float {
    let n = fbm2(uv * 0.7, 3, seed) * 0.5 + 0.5;
    return smoothstep(reach, 0.0, height) * (0.55 + 0.45 * n);
}

/// The drip under an opening (a sill, a vent): `across` meters off its
/// middle, `below` meters under it; `width` as wide as the opening at its
/// head, running out by `length`, broken by a noise at `uv` (`seed`).
fn texture_drip(across: Float, below: Float, width: Float, length: Float, uv: Vec2, seed: Int) -> Float {
    let spread = width * 0.5 * (1.0 - 0.5 * saturate(below / max(length, 0.001)));
    let n = fbm2(vec2(uv.x * 3.0, uv.y * 0.4), 2, seed) * 0.5 + 0.5;
    return step(0.0, below) * smoothstep(spread, spread * 0.6, abs(across)) * smoothstep(length, 0.0, below) * smoothstep(0.3, 0.75, n);
}

/// How much a surface facing `n` faces `toward` (dust and snow on what
/// faces up, moss on what faces the north): none at `from`, all at `to`
/// (the cosines between).
fn texture_facing(n: Vec3, toward: Vec3, from: Float, to: Float) -> Float { return smoothstep(from, to, dot(n, normalize(toward))); }

/// An edge worn back, `edge` meters from it: worn within `width`, the wear
/// ragged by `noise` (0 to 1).
fn texture_edge_wear(edge: Float, width: Float, noise: Float) -> Float { return smoothstep(width * (0.4 + noise), 0.0, edge); }

/// Dirt gathered where a surface is shut in (`open` 0 shut to 1 open, as an
/// ambient occlusion has it): none where open, all `depth` shut.
fn texture_cavity(open: Float, depth: Float) -> Float { return smoothstep(1.0, 1.0 - max(depth, 0.0001), open); }

/// Puddles on the ground at `uv` (meters), pools of about `size` meters,
/// `level` of the ground under water (0 none to 1 all but the highest
/// points, `seed` their hash): 1 under water, its rim soft.
fn texture_puddles(uv: Vec2, size: Float, level: Float, seed: Int) -> Float {
    let n = fbm2(uv / max(size, 0.001), 3, seed) * 0.5 + 0.5;
    return smoothstep(1.0 - level, 1.0 - level + 0.08, 1.0 - n);
}

/// A surface wetted `wet` (0 to 1): its color darkened as water darkens a
/// porous one (rgb), its roughness smoothed toward water's (w).
fn texture_wet(color: Vec3, rough: Float, wet: Float) -> Vec4 {
    let dark = color * mix(1.0, 0.5 + 0.3 * dot(color, vec3(0.3333, 0.3333, 0.3333)), wet);
    return vec4(dark.x, dark.y, dark.z, mix(rough, 0.04, wet));
}
