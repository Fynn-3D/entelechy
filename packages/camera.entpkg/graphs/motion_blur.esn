//! Motion blur (`kernels/motion_blur.ent`) over a picture: the lens's last frame kept to find where each point was; `motion`
//! the things' own moves this frame (one pixel for none).
use "../kernels/";

input image: Image;
input surface: Grid<Vec4>;
input lens: Lenses;
input motion: Grid<Vec4>;
param shutter: Float = 0.5;
param most: Float = 32.0;
param samples: Int = 12;

node now_lens: camera.same_lens@1 { lens <- lens; domain = 1; }
node blurred: camera.motion_blur@1 { image <- image; surface <- surface; lens <- lens; was_lens <~ now_lens.result from now_lens.result; motion <- motion;
    shutter = shutter; most = most; samples = samples; domain = size(image); }

output result <- blurred.result;
