// Motion blur at points whose answers are known: a checkered picture on a wall ten meters off, seen through a lens that
// stands still the first frame and slides sideways after it; still, nothing is blurred; sliding, the squares are
// smeared into each other.
use "../kernels/";
use "geometry.entpkg";

node lens: kernel {
    requires { field.write; time.read; }
    output result: Lenses;
    domain = 1;
    compute { return Lens { eye: vec3(time() * 20.0, 0.0, 0.0), ahead: vec3(0.0, 0.0, -1.0), right: vec3(1.0, 0.0, 0.0), up: vec3(0.0, 1.0, 0.0), focal: 1.0 }; }
}
node wall: Grid<Vec4> { domain = vec2(64, 36); value = vec4(0.0, 0.0, 1.0, 10.0); }
node checks: kernel {
    requires { field.write; }
    output result: Image;
    domain = vec2(64, 36);
    compute { let c = coord(); let k = (int(c.x) + int(c.y)) % 2; return if k == 0 { vec4(0.0, 0.0, 0.0, 1.0) } else { vec4(1.0, 1.0, 1.0, 1.0) }; }
}
node none: Grid<Vec4> { domain = vec2(1, 1); }
node blurred: graph "../graphs/motion_blur.esn" { image <- checks.result; surface <- wall.result; lens <- lens.result; motion <- none.result; }

output result <- blurred.result;
