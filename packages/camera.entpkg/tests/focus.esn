// Depth of field at points whose answers are known, on a picture 720 high (the aperture's own scale): a flat surface
// eight meters off is focused on at eight meters; squares 16 pixels wide over it, all in focus, are left as they were;
// over a surface far behind the focus, a square's edge is blurred into its neighbor; with no aperture, nothing is.
use "../kernels/";
use "surface.entpkg";

node near: Grid<Vec4> { domain = vec2(64, 720); value = vec4(0.0, 0.0, 1.0, 8.0); }
node far: Grid<Vec4> { domain = vec2(64, 720); value = vec4(0.0, 0.0, 1.0, 400.0); }
node checks: kernel {
    requires { field.write; }
    output result: Image;
    domain = vec2(64, 720);
    compute { let c = coord(); let k = (int(c.x) / 16 + int(c.y) / 16) % 2; return if k == 0 { vec4(0.0, 0.0, 0.0, 1.0) } else { vec4(1.0, 1.0, 1.0, 1.0) }; }
}
node dof: camera.dof_start@1 { aperture = 6.0; domain = 1; }
node shut: camera.dof_start@1 { aperture = 0.0; domain = 1; }
node focus0: Rows<Float> { domain = 1; value = 0.0; }
node focus: camera.focus@1 { previous <~ focus.result from focus0.result; surface <- near.result; control <- dof.result; domain = 1; }
node sharp: camera.focused@1 { image <- checks.result; surface <- near.result; focus <- focus.result; control <- dof.result; }
node soft: camera.focused@1 { image <- checks.result; surface <- far.result; focus <- focus.result; control <- dof.result; }
node open: camera.focused@1 { image <- checks.result; surface <- far.result; focus <- focus.result; control <- shut.result; }

output result <- soft.result;
