scene focus.esn

# Focused at the five middle points' mean, eight meters. In focus, the
# middle of a white square stays white; far behind the focus (a blur of
# six pixels, at most nine), a white pixel two from a black square takes
# some of it; with no aperture, it stays white.
frame 0.0
expect focus.result[0] = 8 0.00001
expect sharp.result[536] = 1 1 1 1 0.00001
expect soft.result[542].x < 0.97
expect soft.result[542].x > 0.5
expect open.result[542] = 1 1 1 1
