scene resolution.esn
window 160 90

# All of the ceiling at first; under it, the window's own size, a
# multiple of eight down (160 by 88); a ceiling of 4000 pixels takes the
# window down to the root of 4000 / 14400 of a side, at least 64.
frame 0.0
expect dynamic.result[0].fraction = 1
expect extent.result[0] = 160
expect extent.result[1] = 88
expect quarter.result[0] = 80
expect quarter.result[1] = 64
expect size.result[0] = 160 88
expect count canvas.result = 14080
