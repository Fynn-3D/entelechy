// Depth of field: the lens is focused at a distance, and the further from it (before or behind) the blurrier, as a wide aperture is.
// It focuses where a scene says (the picture's middle, the pointer), following there slowly (as a camera focuses); each pixel gathers a ring of points round it:
// a point counts only where it is blurred enough to cover this pixel (its circle of confusion is large enough), and a point behind
// only where this pixel is blurred too, so a sharp foreground takes nothing from the background.

/// How a lens blurs what is out of focus, as data a scene changes as it goes: `aperture`, the blur's radius in pixels at
/// infinity for a picture 720 high (0 sharp), and `at`, where it focuses (0 to 1 across the picture; the middle (0.5,
/// 0.5), a pointer `pointer() / window()`).
struct Dof { aperture: Float; at: Vec2; }
type Dofs = Rows<Dof>;

/// One depth of field made from these parameters (`domain = 1`).
kernel camera.dof_start@1 {
    requires { field.write; }
    param aperture: Float = 4.0;
    param at: Vec2 = vec2(0.5, 0.5);
    output result: Dofs;
    compute { return Dof { aperture: aperture, at: at }; }
}

/// The circle a distance blurs to on the picture (a radius in pixels): 0 at the focus `focus`, larger the further from it,
/// `aperture` at infinity; never past `most`.
fn blur_of(d: Float, focus: Float, aperture: Float, most: Float) -> Float {
    return min(aperture * abs(1.0 - focus / max(d, 0.001)), most);
}

/// The focus of depth of field (one element, meters): the mean distance from the lens of five points about where
/// `control` focuses (the sky very far), approached by `speed` of the way each frame.
kernel camera.focus@1 {
    requires { field.read; field.write; }
    input previous: Rows<Float>;
    input surface: Grid<Vec4>;
    input control: Dofs;
    param speed: Float = 0.08;
    param far: Float = 2000.0;
    output result: Rows<Float>;
    compute {
        let c = floor(clamp(at(control, 0).at, vec2(0.0, 0.0), vec2(1.0, 1.0)) * size(surface));
        let o = max(floor(size(surface) * 0.04), vec2(1.0, 1.0));
        let d = loop 5 with acc = 0.0 {
            let at_ = if index() == 0 { c } else if index() == 1 { c + vec2(o.x, 0.0) } else if index() == 2 { c - vec2(o.x, 0.0) } else if index() == 3 { c + vec2(0.0, o.y) } else { c - vec2(0.0, o.y) };
            let w = at(surface, clamp(at_, vec2(0.0, 0.0), size(surface) - 1.0)).w;
            acc + (if w > 0.0 && w < far { w } else { far })
        } / 5.0;
        let p = at(previous, 0);
        return if p <= 0.0 { d } else { p * exp(speed * log(d / p)) };
    }
}

/// Pixel `q` of `image` (a finished picture `extent` large) blurred by depth of field: by `surface`'s distance and the
/// focus `focus` (meters), `aperture` the radius in pixels at infinity for a picture 720 high (scaled with a larger one; 0
/// sharp). It takes 24 points on a Vogel disc, a point counted where its own circle reaches this pixel, a farther one
/// only where this pixel is blurred too.
fn dof_blurred(image: Image, surface: Grid<Vec4>, q: Vec2, extent: Vec2, focus: Float, aperture: Float) -> Vec4 {
    let c = at(image, clamp(q, vec2(0.0, 0.0), size(image) - 1.0));
    if aperture <= 0.0 { return c; }
    let k = extent.y / 720.0;
    let most = aperture * k * 1.5;
    let aperture_px = aperture * k;
    let sq = clamp(floor((q + 0.5) * size(surface) / extent), vec2(0.0, 0.0), size(surface) - 1.0);
    let d0 = at(surface, sq).w;
    let own = blur_of(d0, focus, aperture_px, most);
    let acc = loop 24 with a = vec4(c.x, c.y, c.z, 1.0) {
        // A Vogel disc: the golden angle round, the root of the share out.
        let i = float(index()) + 0.5;
        let r = sqrt(i / 24.0) * most;
        let t = i * 2.39996323;
        let off = vec2(cos(t), sin(t)) * r;
        let p = clamp(q + off, vec2(0.0, 0.0), extent - 1.0);
        let ps = clamp(floor((p + 0.5) * size(surface) / extent), vec2(0.0, 0.0), size(surface) - 1.0);
        let di = at(surface, ps).w;
        let theirs = blur_of(di, focus, aperture_px, most);
        let reach = clamp(theirs - r + 1.0, 0.0, 1.0);
        let behind = if di > d0 { clamp(own - r + 1.0, 0.0, 1.0) } else { 1.0 };
        let w = reach * behind;
        let s = at(image, p);
        vec4(a.x + s.x * w, a.y + s.y * w, a.z + s.z * w, a.w + w)
    };
    return vec4(acc.x / acc.w, acc.y / acc.w, acc.z / acc.w, c.w);
}

/// Depth of field (see the file's head, `dof_blurred`): `image` blurred by `surface`'s distance, the focus `focus` and
/// `control`'s aperture.
kernel camera.focused@1 {
    requires { field.read; field.write; }
    input image: Image;
    input surface: Grid<Vec4>;
    input focus: Rows<Float>;
    input control: Dofs;
    output result: Image;
    compute { return dof_blurred(image, surface, coord(), domain(), at(focus, 0), at(control, 0).aperture); }
}
