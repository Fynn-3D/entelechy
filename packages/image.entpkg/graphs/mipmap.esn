//! The mip strip of a square texture, as a sub-graph. Place it with
//!   node strip: graph "image.entpkg/graphs/mipmap.esn" {
//!       source <- texture.result; side = 256; levels = 7;
//!   }
//! and read it with the functions in `mipmap.ent`.
//!
//! A placement does not know which repetition it is, so the level being
//! written rides beside the strip as a row of one Int and is carried on
//! with it.
use "../kernels/mipmap.ent";

input source: Image;
param side: Int = 256;
param levels: Int = 7;

node first: image.mip_first@1 { source <- source; side = side; domain = vec2(side, 2 * side); }
node one: image.mip_one@1 { domain = 1; }

node halved: graph "mipmap_level.esn" {
    times = levels;
    carry strip <- result;
    carry step <- step;
    strip <- first.result;
    step <- one.result;
    side = side;
}

output result <- halved.result;
