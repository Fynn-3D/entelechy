//! One jump-flooding pass and the step after it. `flood.esn` places this
//! `passes` times.
use "../kernels/distance.ent";

input seeds: Image;
input step: Rows<Int>;

node pass: image.flood@1 { seeds <- seeds; step <- step; }
node next: image.next_step@1 { step <- step; domain = 1; }

output result <- pass.result;
output step <- next.result;
