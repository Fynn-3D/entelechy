// Tone and colour grading: changes to each pixel by its own colour.
use "colour.ent";

/// Exposure in stops; contrast round middle grey (0.18), as a power of
/// the light, so it suits light brighter than white too; saturation and
/// hue turned in Oklab, so a change looks even across colours.
fn adjusted(c: Vec3, exposure: Float, contrast: Float, saturation: Float, hue: Float) -> Vec3 {
    let lit = max(c * exp2(exposure), 0.0);
    let grey = vec3(0.18, 0.18, 0.18);
    let shaped = pow(lit / 0.18, contrast) * grey;
    let lab = linear_to_oklab(shaped);
    let turn = hue * 6.2831853;
    let a = (lab.y * cos(turn) - lab.z * sin(turn)) * saturation;
    let b = (lab.y * sin(turn) + lab.z * cos(turn)) * saturation;
    return max(oklab_to_linear(vec3(lab.x, a, b)), 0.0);
}

/// The picture adjusted: `exposure` stops, `contrast` (1 none),
/// `saturation` (1 none, 0 grey), `hue` turned (a whole turn is 1).
kernel image.adjust@1 {
    requires { field.read; field.write; }
    input source: Image;
    param exposure: Float = 0.0;
    param contrast: Float = 1.0;
    param saturation: Float = 1.0;
    param hue: Float = 0.0;
    output result: Image;
    compute {
        let s = sample(source);
        let c = adjusted(s.xyz, exposure, contrast, saturation, hue);
        return vec4(c, s.w);
    }
}

/// Levels: `black` to 0 and `white` to 1, clamped, then bent by `gamma`
/// (above 1 brightens the middle).
kernel image.levels@1 {
    requires { field.read; field.write; }
    input source: Image;
    param black: Float = 0.0;
    param white: Float = 1.0;
    param gamma: Float = 1.0;
    output result: Image;
    compute {
        let s = sample(source);
        let t = saturate((s.xyz - black) / max(white - black, 0.0001));
        let g = 1.0 / max(gamma, 0.0001);
        return vec4(pow(t, g), s.w);
    }
}

/// Curves: each channel looked up in `curve`, rows of the output for
/// inputs spread evenly from 0 to 1 (x for red, y green, z blue),
/// blended between rows.
kernel image.curve@1 {
    requires { field.read; field.write; }
    input source: Image;
    input curve: Rows<Vec4>;
    output result: Image;
    compute {
        let s = sample(source);
        let last = float(count(curve) - 1);
        let p = saturate(s.xyz) * last + 0.5;
        return vec4(at_linear(curve, p.x).x, at_linear(curve, p.y).y, at_linear(curve, p.z).z, s.w);
    }
}

/// A 3D LUT's colour for `c`: the LUT is a strip of `n` squares side by
/// side, n*n wide and n high, red across each square, green down it,
/// blue square by square; blended between squares and within them.
fn lut_at(lut: Image, c: Vec3) -> Vec3 {
    let n = size(lut).y;
    let q = saturate(c) * (n - 1.0);
    let slice = min(floor(q.z), n - 2.0);
    let within = q.xy + 0.5;
    let lower = at_linear(lut, within + vec2(slice * n, 0.0)).xyz;
    let upper = at_linear(lut, within + vec2((slice + 1.0) * n, 0.0)).xyz;
    return mix(lower, upper, q.z - slice);
}

/// The neutral LUT of side `n` (`domain = vec2(n * n, n)`): each colour
/// itself. Grade it as a picture and `image.lut` applies that grade.
kernel image.neutral@1 {
    requires { field.write; }
    param n: Int = 33;
    output result: Image;
    compute {
        let c = icoord();
        let last = float(n - 1);
        return vec4(float(c.x % n) / last, float(c.y) / last, float(c.x / n) / last, 1.0);
    }
}

/// The picture through a 3D LUT (`lut_at`), its values taken 0 to 1.
kernel image.lut@1 {
    requires { field.read; field.write; }
    input source: Image;
    input lut: Image;
    output result: Image;
    compute {
        let s = sample(source);
        let c = lut_at(lut, s.xyz);
        return vec4(c, s.w);
    }
}
