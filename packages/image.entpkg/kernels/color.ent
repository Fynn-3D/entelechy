// Color as numbers: how bright a color looks, sRGB's transfer between
// stored values and light, and the spaces some changes are easier in:
// HSV for hue and saturation as a picker shows them, Oklab for changes
// the eye sees as even; and colors to light with: the glow of heat
// and the wheel's hues.

/// How bright a linear color looks (Rec. 709's weights).
fn luminance(c: Vec3) -> Float { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

/// One channel of sRGB's transfer: a stored value to linear light, and
/// back.
fn srgb_decode(v: Float) -> Float {
    return if v <= 0.04045 { v / 12.92 } else { pow((v + 0.055) / 1.055, 2.4) };
}
fn srgb_encode(v: Float) -> Float {
    return if v <= 0.0031308 { v * 12.92 } else { 1.055 * pow(v, 1.0 / 2.4) - 0.055 };
}
fn srgb_to_linear(c: Vec3) -> Vec3 { return vec3(srgb_decode(c.x), srgb_decode(c.y), srgb_decode(c.z)); }
fn linear_to_srgb(c: Vec3) -> Vec3 { return vec3(srgb_encode(c.x), srgb_encode(c.y), srgb_encode(c.z)); }

/// Hue (0 up to 1, red at 0), saturation and value, and back.
fn rgb_to_hsv(c: Vec3) -> Vec3 {
    let hi = max(c.x, max(c.y, c.z));
    let lo = min(c.x, min(c.y, c.z));
    let d = hi - lo;
    let h = if d <= 0.0 { 0.0 }
        else if hi == c.x { fract((c.y - c.z) / d / 6.0) }
        else if hi == c.y { ((c.z - c.x) / d + 2.0) / 6.0 }
        else { ((c.x - c.y) / d + 4.0) / 6.0 };
    let s = if hi <= 0.0 { 0.0 } else { d / hi };
    return vec3(h, s, hi);
}
fn hsv_to_rgb(c: Vec3) -> Vec3 {
    let k = abs(fract(vec3(c.x + 1.0, c.x + 2.0 / 3.0, c.x + 1.0 / 3.0)) * 6.0 - 3.0);
    let pure = saturate(k - 1.0);
    return mix(vec3(1.0, 1.0, 1.0), pure, c.y) * c.z;
}

/// A cube root that keeps the sign: `pow`'s answer, which a device may
/// give a few units off, made exact by one step of Newton's method.
fn cbrt(v: Float) -> Float {
    let a = abs(v);
    let y = pow(a, 1.0 / 3.0);
    let exact = if y > 0.0 { y - (y * y * y - a) / (3.0 * y * y) } else { 0.0 };
    return sign(v) * exact;
}

/// Linear light to Oklab (Ottosson): lightness, then the green-red and
/// blue-yellow axes; equal steps in it look equal. And back.
fn linear_to_oklab(c: Vec3) -> Vec3 {
    let l = cbrt(0.4122214708 * c.x + 0.5363325363 * c.y + 0.0514459929 * c.z);
    let m = cbrt(0.2119034982 * c.x + 0.6806995451 * c.y + 0.1073969566 * c.z);
    let s = cbrt(0.0883024619 * c.x + 0.2817188376 * c.y + 0.6299787005 * c.z);
    return vec3(0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
                1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
                0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s);
}
fn oklab_to_linear(c: Vec3) -> Vec3 {
    let l0 = c.x + 0.3963377774 * c.y + 0.2158037573 * c.z;
    let m0 = c.x - 0.1055613458 * c.y - 0.0638541728 * c.z;
    let s0 = c.x - 0.0894841775 * c.y - 1.2914855480 * c.z;
    let l = l0 * l0 * l0;
    let m = m0 * m0 * m0;
    let s = s0 * s0 * s0;
    return vec3(4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
                -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
                -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s);
}

/// Glowing matter by how hot it is, 0 to 1: deep red, orange, yellow,
/// white.
fn blackbody(heat: Float) -> Vec3 {
    let h = saturate(heat);
    let red = vec3(1.0, 0.18, 0.02);
    let orange = vec3(1.0, 0.48, 0.08);
    let yellow = vec3(1.0, 0.82, 0.45);
    let white = vec3(1.0, 0.97, 0.9);
    return if h < 0.33 { mix(red * 0.3, red, h / 0.33) }
        else if h < 0.66 { mix(red, orange, (h - 0.33) / 0.33) }
        else if h < 0.85 { mix(orange, yellow, (h - 0.66) / 0.19) }
        else { mix(yellow, white, (h - 0.85) / 0.15) };
}

/// A vivid hue round the wheel, 0 to 1: red, yellow, green, cyan, blue,
/// magenta, and red again.
fn hue(h: Float) -> Vec3 {
    let k = fract(h) * 6.0;
    return saturate(vec3(abs(k - 3.0) - 1.0, 2.0 - abs(k - 2.0), 2.0 - abs(k - 4.0)));
}

/// Linear light to sRGB's stored values (for a window or a file), and
/// back; alpha kept.
kernel image.encode@1 {
    requires { field.read; field.write; }
    input source: Image;
    output result: Image;
    compute { let s = sample(source); let c = linear_to_srgb(max(s.xyz, 0.0)); return vec4(c, s.w); }
}
kernel image.decode@1 {
    requires { field.read; field.write; }
    input source: Image;
    output result: Image;
    compute { let s = sample(source); let c = srgb_to_linear(s.xyz); return vec4(c, s.w); }
}
