// Blending: how a colour laid over another combines with it, by the
// modes painting programs share (as the W3C's compositing spec defines
// them, on values 0 to 1), and compositing one picture over another.
use "colour.ent";

type Blend = enum { Normal, Multiply, Screen, Overlay, SoftLight, Add, Difference, Darken, Lighten };

/// One channel of `top` laid over `base` by `mode`.
fn blend_channel(mode: Blend, base: Float, top: Float) -> Float {
    return match mode {
        Blend.Normal => top,
        Blend.Multiply => base * top,
        Blend.Screen => base + top - base * top,
        Blend.Overlay => if base <= 0.5 { 2.0 * base * top } else { 1.0 - 2.0 * (1.0 - base) * (1.0 - top) },
        Blend.SoftLight => if top <= 0.5 {
            base - (1.0 - 2.0 * top) * base * (1.0 - base)
        } else {
            let d = if base <= 0.25 { ((16.0 * base - 12.0) * base + 4.0) * base } else { sqrt(base) };
            base + (2.0 * top - 1.0) * (d - base)
        },
        Blend.Add => base + top,
        Blend.Difference => abs(base - top),
        Blend.Darken => min(base, top),
        Blend.Lighten => max(base, top),
    };
}

/// `top` laid over `base` by `mode`, channel by channel.
fn blend(mode: Blend, base: Vec3, top: Vec3) -> Vec3 {
    return vec3(blend_channel(mode, base.x, top.x), blend_channel(mode, base.y, top.y), blend_channel(mode, base.z, top.z));
}

type Space = enum { Encoded, Linear };

/// `top` composited over `base`, as the W3C's compositing spec does it:
/// where `top` covers (its alpha times `opacity`), its colour is
/// blended with `base`'s by `mode`, as much as `base` is there; then
/// laid over `base`, the alphas joined as one sheet over another, the
/// colour weighed by both. `space` is where the arithmetic is done: on
/// sRGB's stored values (`Encoded`), as painting programs blend and
/// the modes are defined, or on light itself (`Linear`). `top` is
/// stretched over `base` whatever its size.
kernel image.blend@1 {
    requires { field.read; field.write; }
    input base: Image;
    input top: Image;
    param mode: Blend = Blend.Normal;
    param opacity: Float = 1.0;
    param space: Space = Space.Encoded;
    output result: Image;
    compute {
        let b = sample(base);
        let uv = (coord() + 0.5) / domain();
        let t = at_linear(top, uv * size(top));
        let encoded = space == Space.Encoded;
        let cb = if encoded { linear_to_srgb(max(b.xyz, 0.0)) } else { b.xyz };
        let cs = if encoded { linear_to_srgb(max(t.xyz, 0.0)) } else { t.xyz };
        let a_base = saturate(b.w);
        let a_top = saturate(t.w * opacity);
        let mixed = cs * (1.0 - a_base) + blend(mode, cb, cs) * a_base;
        let alpha = a_top + a_base * (1.0 - a_top);
        let joined = (mixed * a_top + cb * (a_base * (1.0 - a_top))) / max(alpha, 0.000001);
        let c = if encoded { srgb_to_linear(joined) } else { joined };
        return vec4(c, alpha);
    }
}
