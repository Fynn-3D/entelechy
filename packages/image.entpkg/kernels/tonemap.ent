use "colour.ent";

/// ACES tone mapping, the fitted curve: light of any brightness to 0..1,
/// as film takes it.
fn aces(x: Vec3) -> Vec3 {
    let n = x * (x * 2.51 + vec3(0.03, 0.03, 0.03));
    let d = x * (x * 2.43 + vec3(0.59, 0.59, 0.59)) + vec3(0.14, 0.14, 0.14);
    return clamp(n / d, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0));
}

/// ACES-style tone mapping, encoded by sRGB's transfer for a window or
/// a file; edit `exposure` while the Player runs.
kernel image.tonemap@2 {
    requires { field.read; field.write; }
    input source: Image;
    param exposure: Float = 1.0;
    output result: Image;

    compute {
        let c = sample(source);
        let mapped = aces(vec3(c.r, c.g, c.b) * exposure);
        let shown = linear_to_srgb(mapped);
        return vec4(shown.x, shown.y, shown.z, c.a);
    }
}
