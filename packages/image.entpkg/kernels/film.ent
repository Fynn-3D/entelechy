// A camera's finish, as Kernels over a picture of light (rgb, which may be far
// brighter than white) that keeps in w how far away what each pixel
// shows is.
use "tone_map.ent";
use "color.ent";
use "filter.ent";
use "random.entpkg";
use "grade.ent";

/// The picture smaller, each pixel the mean of four samples: all its
/// light (`over` 0), or only what is past `over`. w, the depth, is kept.
kernel image.bright@1 {
    requires { field.read; field.write; }
    input source: Grid<Vec4>;
    param over: Float = 0.8;
    output result: Grid<Vec4>;
    compute {
        let scale = size(source) / domain();
        let p = (coord() + 0.5) * scale;
        let q = scale * 0.25;
        let c = (at_linear(source, p + q) + at_linear(source, p - q)
               + at_linear(source, p + vec2(q.x, -q.y)) + at_linear(source, p - vec2(q.x, -q.y))) * 0.25;
        let light = max(c.xyz - over, 0.0);
        return vec4(light, c.w);
    }
}

/// A lens's color fringe at `uv` (0 to 1 across the picture): red read
/// `fringe` of the picture's width outward from the middle, blue as far
/// inward, green where it is, so the split grows toward the edges.
fn fringed(source: Grid<Vec4>, uv: Vec2, fringe: Float) -> Vec3 {
    let fs = size(source);
    let off = (uv - 0.5) * fringe * fs.x;
    return vec3(at_linear(source, uv * fs + off).x, at_linear(source, uv * fs).y, at_linear(source, uv * fs - off).z);
}

/// How far out of focus a pixel `distance` away is, for a lens focused
/// at `focus`: its share of the soft copy, from none within an eighth of
/// the focus to 0.6, `strength` how fast it grows.
fn defocus(distance: Float, focus: Float, strength: Float) -> Float {
    let focused = max(focus, 0.0001);
    return clamp(abs(distance - focused) / focused * strength - 0.12, 0.0, 0.6);
}

/// The share of light a lens keeps at `uv`, darker toward the corners by
/// `amount`.
fn vignetted(uv: Vec2, amount: Float) -> Float {
    let d = uv - 0.5;
    return 1.0 - amount * dot(d, d);
}

/// Film grain at pixel `px`: a number from -`amount` / 2 to `amount` / 2,
/// new each sixtieth of a second of `time`.
fn film_grain(px: Vec2, time: Float, amount: Float) -> Float {
    return (unit_of(hash_int3(int(px.x), int(px.y), int(time * 60.0), 71)) - 0.5) * amount;
}

/// The finished picture: depth of field between the sharp picture and
/// its soft copy, by how far each pixel's depth is from `focus` (the
/// first row); the glow added, `near` and `far` of each; then exposure,
/// ACES, sRGB's transfer, color fringing toward the edges (`fringe`),
/// darkened corners (`vignette`) and grain (`grain`), new every frame.
/// Each step is a function a Kernel of another look composes as it
/// chooses.
kernel image.finish@1 {
    requires { field.read; field.write; time.read; }
    input source: Grid<Vec4>;
    input soft: Grid<Vec4>;
    input near_glow: Grid<Vec4>;
    input far_glow: Grid<Vec4>;
    input focus: Rows<Float>;
    param exposure: Float = 1.0;
    param depth: Float = 1.4;
    param fringe: Float = 0.003;
    param vignette: Float = 1.1;
    param grain: Float = 0.03;
    param near: Float = 0.55;
    param far: Float = 0.45;
    output result: Image;
    compute {
        let uv = (coord() + 0.5) / domain();
        let here = at_linear(source, uv * size(source));
        let blurred = at_linear(soft, uv * size(soft));
        let seen = mix(fringed(source, uv, fringe), blurred.xyz, defocus(here.w, at(focus, 0), depth));
        let bloom = at_linear(near_glow, uv * size(near_glow)) * near + at_linear(far_glow, uv * size(far_glow)) * far;
        let toned = aces((seen + bloom.xyz) * exposure);
        let shown = linear_to_srgb(toned) * vignetted(uv, vignette);
        let g = film_grain(coord(), time(), grain);
        return vec4(shown + g, 1.0);
    }
}

// Film: a cinematic finish over a finished picture as it is shown, as data a scene can change as it goes (`Film`), and
// each of its steps a word a scene's own kernel composes as it chooses: a grade in light (`Grade`, `grade.ent`'s), a
// split of cyan shadows and orange highlights (`film_split`), an S-shaped contrast (`film_curve`), a red glow round
// highlights (`film_halation`, film's halation), the lens's fringe, darkened corners and grain (`image.entpkg`'s
// `fringed`, `vignetted`, `film_grain`), and a widescreen's bars (`film_bars`). A few looks are kept as recipes
// (`film_preset`).
/// One film look: a grade in light (`grade`), the split's strength (`split`, 0 none), the S curve's (`curve`, 0
/// none), the halation's (`halation`), the fringe (`fringe`, a share of the width), darkened corners (`vignette`),
/// grain (`grain`, its strength; `grain_size`, its clumps in pixels), and the bars' aspect (`letterbox`, 2.39 for
/// a widescreen's; 0 none).
struct Film {
    grade: Grade; split: Float; curve: Float; halation: Float; fringe: Float; vignette: Float; grain: Float; grain_size: Float;
    letterbox: Float;
}

/// The film that changes nothing.
fn film_none() -> Film {
    return Film { grade: grade_none(), split: 0.0, curve: 0.0, halation: 0.0, fringe: 0.0, vignette: 0.0, grain: 0.0, grain_size: 1.0,
        letterbox: 0.0 };
}

/// A grade of `exposure` stops, `temperature`, `tint` and `saturation`, nothing else.
fn film_grade(exposure: Float, temperature: Float, tint: Float, saturation: Float) -> Grade {
    return Grade { ..grade_none(), exposure: exposure, temperature: temperature, tint: tint, saturation: saturation };
}

/// Looks kept as recipes: 1 a widescreen's, warm, teal and orange; 2 warm, bright and soft; 3 drained and hard, the
/// bars of 1.85; 4 black and white, coarse grain; anything else none.
fn film_preset(k: Int) -> Film {
    return if k == 1 { Film { grade: film_grade(0.0, 0.1, 0.0, 0.95), split: 0.6, curve: 0.45, halation: 0.35, fringe: 0.0015,
            vignette: 0.35, grain: 0.035, grain_size: 1.3, letterbox: 2.39 } }
        else if k == 2 { Film { grade: film_grade(0.1, 0.35, 0.05, 1.1), split: 0.2, curve: 0.35, halation: 0.5, fringe: 0.001,
            vignette: 0.3, grain: 0.045, grain_size: 1.6, letterbox: 0.0 } }
        else if k == 3 { Film { grade: film_grade(0.0, -0.05, 0.0, 0.45), split: 0.15, curve: 0.8, halation: 0.1, fringe: 0.001,
            vignette: 0.45, grain: 0.04, grain_size: 1.2, letterbox: 1.85 } }
        else if k == 4 { Film { grade: film_grade(0.1, 0.0, 0.0, 0.0), split: 0.0, curve: 0.7, halation: 0.2, fringe: 0.0,
            vignette: 0.5, grain: 0.07, grain_size: 2.0, letterbox: 0.0 } }
        else { film_none() };
}

/// Whether `uv` (0 to 1 across a picture `extent` pixels) lies inside bars that frame it to `aspect` (1 inside, 0 in a
/// bar; 0 `aspect` none).
fn film_bars(uv: Vec2, extent: Vec2, aspect: Float) -> Float {
    let bar = if aspect > 0.0 { max((1.0 - extent.x / extent.y / aspect) * 0.5, 0.0) } else { 0.0 };
    return if uv.y < bar || uv.y > 1.0 - bar { 0.0 } else { 1.0 };
}

/// Halation: the red glow `strength` strong round what is bright about pixel `q` of the shown picture `image` (eight
/// points four pixels out at 720 high, more on a taller one), as light to add.
fn film_halation(image: Image, q: Vec2, strength: Float) -> Vec3 {
    if strength <= 0.0 { return vec3(0.0, 0.0, 0.0); }
    let ext = size(image);
    let k = max(ext.y / 720.0, 1.0);
    let glow = loop 8 with a = vec3(0.0, 0.0, 0.0) {
        let t = float(index()) * 0.785398;
        let s = at(image, clamp(q + vec2(cos(t), sin(t)) * 4.0 * k, vec2(0.0, 0.0), ext - 1.0)).xyz;
        a + max(s - vec3(0.75, 0.75, 0.75), vec3(0.0, 0.0, 0.0))
    } / 8.0;
    return glow * vec3(1.0, 0.35, 0.15) * (strength * 2.0);
}

/// Light `c` split `amount` of the way: its shadows toward cyan, its highlights toward orange.
fn film_split(c: Vec3, amount: Float) -> Vec3 {
    let tone = mix(vec3(0.88, 1.0, 1.1), vec3(1.1, 1.0, 0.86), smoothstep(0.02, 0.5, luminance(c)));
    return c * mix(vec3(1.0, 1.0, 1.0), tone, amount);
}

/// A shown color `d` (0 to 1) taken `amount` of the way along an S curve.
fn film_curve(d: Vec3, amount: Float) -> Vec3 {
    let s = d * d * (vec3(3.0, 3.0, 3.0) - d * 2.0);
    return mix(d, clamp(s, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0)), amount);
}

/// One film look made from these parameters (`domain = 1`): `preset`'s recipe (`film_preset`), or with `preset` 0 the
/// parameters' own.
kernel image.film_start@1 {
    requires { field.write; }
    param preset: Int = 0;
    param exposure: Float = 0.0;
    param temperature: Float = 0.0;
    param tint: Float = 0.0;
    param saturation: Float = 1.0;
    param split: Float = 0.0;
    param curve: Float = 0.0;
    param halation: Float = 0.0;
    param fringe: Float = 0.002;
    param vignette: Float = 0.0;
    param grain: Float = 0.03;
    param grain_size: Float = 1.0;
    param letterbox: Float = 0.0;
    output result: Rows<Film>;
    compute {
        return if preset != 0 { film_preset(preset) } else { Film { grade: film_grade(exposure, temperature, tint, saturation), split: split,
            curve: curve, halation: halation, fringe: fringe, vignette: vignette, grain: grain, grain_size: grain_size, letterbox: letterbox } };
    }
}

/// The shown picture `image` (sRGB) finished by `film`'s first row (`domain = size(image)`): the fringe, the halation
/// added in light, the grade and the split there, the S curve once shown again, darkened corners, grain in clumps
/// heaviest in the middle tones, and the bars.
kernel image.film@1 {
    requires { field.read; field.write; time.read; }
    input image: Image;
    input film: Rows<Film>;
    output result: Image;
    compute {
        let q = coord();
        let here = at(image, q);
        let f = at(film, 0);
        let ext = domain();
        let uv = (q + 0.5) / ext;
        if film_bars(uv, ext, f.letterbox) < 0.5 { return vec4(0.0, 0.0, 0.0, here.w); }
        let shown = if f.fringe > 0.0 { fringed(image, uv, f.fringe) } else { here.xyz };
        let light = film_split(grade_color(srgb_to_linear(shown) + film_halation(image, q, f.halation), f.grade), f.split);
        let curved = film_curve(linear_to_srgb(max(light, vec3(0.0, 0.0, 0.0))), f.curve);
        let g = film_grain(floor(q / max(f.grain_size, 1.0)), time(), f.grain) * (1.0 - abs(luminance(curved) - 0.5) * 1.2);
        let out = curved * vignetted(uv, f.vignette) + vec3(g, g, g);
        return vec4(out.x, out.y, out.z, here.w);
    }
}
