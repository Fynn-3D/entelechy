// Wrap addressing for a linear read: `at_linear` clamps at a Field's
// edges, so a tile read through `mod` seams where the blend cannot
// reach the texel on the other side. This blends the four texels
// around a position itself, each found through `mod`, and so wraps.
// Ten lines, which is why the language has no addressing mode for it.

fn at_linear_wrapped(tile: Grid<Vec4>, q: Vec2) -> Vec4 {
    let n = size(tile);
    let base = floor(q - 0.5);
    let f = q - 0.5 - base;
    let a = at(tile, mod(base, n));
    let b = at(tile, mod(base + vec2(1.0, 0.0), n));
    let c = at(tile, mod(base + vec2(0.0, 1.0), n));
    let d = at(tile, mod(base + 1.0, n));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}
