use "color.ent";

/// ACES tone mapping, the fitted curve: light of any brightness to 0..1,
/// as film takes it.
fn aces(x: Vec3) -> Vec3 {
    let n = x * (x * 2.51 + 0.03);
    let d = x * (x * 2.43 + 0.59) + 0.14;
    return saturate(n / d);
}

/// AgX tone mapping (Troy Sobotka's, Blender's own view), in its minimal
/// fitted form: light of any brightness to 0..1 (linear), taken into AgX's
/// inset primaries, its log2 between -12.47 and 4.03 stops eased by the
/// fitted sigmoid, and out again; bright colors desaturate toward white as
/// film's do, rather than turning hue.
fn agx(x: Vec3) -> Vec3 {
    let inset = mat3(vec3(0.842479062253094, 0.0423282422610123, 0.0423756549057051),
        vec3(0.0784335999999992, 0.878468636469772, 0.0784336),
        vec3(0.0792237451477643, 0.0791661274605434, 0.879142973793104));
    let outset = mat3(vec3(1.19687900512017, -0.0528968517574562, -0.0529716355144438),
        vec3(-0.0980208811401368, 1.15190312990417, -0.0980434501171241),
        vec3(-0.0990297440797205, -0.0989611768448433, 1.15107367264116));
    let low = -12.47393;
    let high = 4.026069;
    let v = inset * max(x, vec3(0.0000000001, 0.0000000001, 0.0000000001));
    let e = (clamp(log2(v), vec3(low, low, low), vec3(high, high, high)) - low) / (high - low);
    let e2 = e * e;
    let e4 = e2 * e2;
    let s = e4 * e2 * 15.5 - e4 * e * 40.14 + e4 * 31.96 - e2 * e * 6.868 + e2 * 0.4298 + e * 0.1191 - 0.00232;
    return pow(saturate(outset * s), vec3(2.2, 2.2, 2.2));
}

/// Light `c` at `p` of `hdr` sharpened `amount` (0 not at all): pulled apart from the mean of its four neighbors, less
/// where the contrast is already high (no white rims).
fn tone_sharpened(hdr: Image, p: Vec2, c: Vec3, amount: Float) -> Vec3 {
    if amount <= 0.0 { return c; }
    let n4 = (at_linear(hdr, p + vec2(1.0, 0.0)).xyz + at_linear(hdr, p - vec2(1.0, 0.0)).xyz + at_linear(hdr, p + vec2(0.0, 1.0)).xyz
        + at_linear(hdr, p - vec2(0.0, 1.0)).xyz) * 0.25;
    let lc = luminance(c);
    let ln = luminance(n4);
    let k = amount / (1.0 + 6.0 * abs(lc - ln) / (ln + 0.05));
    return max(c + (c - n4) * k, vec3(0.0, 0.0, 0.0));
}

/// Light `c` through a tone curve: 0 ACES's fit, 1 none (light past 1 clipped, as Blender's Standard view), 2 AgX
/// (Blender's own).
fn tone_curve(c: Vec3, curve: Int) -> Vec3 {
    return if curve == 1 { saturate(c) } else if curve == 2 { agx(c) } else { aces(c) };
}

/// A toned color `c` made `vivid` (1 as it is) and tinted `warmth` of the way from `shadow_tint` in its shadows to
/// `light_tint` in its lights.
fn tone_warmth(c: Vec3, vivid: Float, warmth: Float, shadow_tint: Vec3, light_tint: Vec3) -> Vec3 {
    let gray = luminance(c);
    let rich = max(mix(vec3(gray, gray, gray), c, vivid), vec3(0.0, 0.0, 0.0));
    return rich * mix(vec3(1.0, 1.0, 1.0), mix(shadow_tint, light_tint, smoothstep(0.1, 0.6, gray)), warmth);
}
