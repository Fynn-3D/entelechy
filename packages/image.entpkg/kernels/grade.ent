// A grade: how a finished light is colored, as data a scene can change as it goes (a post process's settings, blended
// from one look to another by time, by place or by a mask), laid over the light before its tone curve: exposure in
// stops, white balance, saturation, contrast about middle gray, a gain, and a drain toward one color's lightness (the
// world gone cold and still, a memory, a night). `image.grade_start` makes one from parameters; a scene's own kernel
// makes the rows it wants and `image.grade` lays the first on (`image.masked` lays a graded picture over part of
// another).
use "color.ent";

/// One grade: `exposure` (stops), `temperature` (warm positive, cool negative), `tint` (magenta positive, green
/// negative), `saturation` (1 as it is), `contrast` (0 as it is; more pulls the light from middle gray), `gain` (each
/// channel's), `drain` (0 none to 1 all: the color taken to its lightness in `drain_color`).
struct Grade { exposure: Float; temperature: Float; tint: Float; saturation: Float; contrast: Float; gain: Vec3; drain: Float; drain_color: Vec3; }

/// The grade that changes nothing.
fn grade_none() -> Grade {
    return Grade { exposure: 0.0, temperature: 0.0, tint: 0.0, saturation: 1.0, contrast: 0.0, gain: vec3(1.0, 1.0, 1.0), drain: 0.0, drain_color: vec3(1.0, 1.0, 1.0) };
}

/// `a` turned toward `b` by `t` (0 `a`, 1 `b`): one look blended into another.
fn grade_mix(a: Grade, b: Grade, t: Float) -> Grade {
    return Grade { exposure: mix(a.exposure, b.exposure, t), temperature: mix(a.temperature, b.temperature, t), tint: mix(a.tint, b.tint, t),
        saturation: mix(a.saturation, b.saturation, t), contrast: mix(a.contrast, b.contrast, t), gain: mix(a.gain, b.gain, t),
        drain: mix(a.drain, b.drain, t), drain_color: mix(a.drain_color, b.drain_color, t) };
}

/// The channels' gains a white balance of `temperature` and `tint` makes (the film's own).
fn grade_balance(temperature: Float, tint: Float) -> Vec3 {
    return vec3(1.0 + 0.12 * temperature + 0.04 * tint, 1.0 - 0.06 * tint, 1.0 - 0.12 * temperature + 0.04 * tint);
}

/// Linear light `c` graded by `g`.
fn grade_color(c: Vec3, g: Grade) -> Vec3 {
    let lit = max(c, vec3(0.0, 0.0, 0.0)) * exp2(g.exposure) * grade_balance(g.temperature, g.tint) * g.gain;
    let l = luminance(lit);
    let colored = mix(vec3(l, l, l), lit, g.saturation);
    // Contrast in stops about middle gray, the color's balance kept.
    let lc = max(luminance(colored), 0.000001);
    let pulled = 0.18 * pow(lc / 0.18, 1.0 + g.contrast);
    let contrasted = colored * (pulled / lc);
    return mix(contrasted, g.drain_color * luminance(contrasted), g.drain);
}

/// One grade made from these parameters (`domain = 1`), for a node to hand on or a scene's kernel to start from.
kernel image.grade_start@1 {
    requires { field.write; }
    param exposure: Float = 0.0;
    param temperature: Float = 0.0;
    param tint: Float = 0.0;
    param saturation: Float = 1.0;
    param contrast: Float = 0.0;
    param gain: Vec3 = vec3(1.0, 1.0, 1.0);
    param drain: Float = 0.0;
    param drain_color: Vec3 = vec3(1.0, 1.0, 1.0);
    output result: Rows<Grade>;
    compute {
        return Grade { exposure: exposure, temperature: temperature, tint: tint, saturation: saturation, contrast: contrast, gain: gain, drain: drain,
            drain_color: drain_color };
    }
}

/// The light `hdr` graded by `grade`'s first row (`domain = size(hdr)`).
kernel image.grade@3 {
    requires { field.read; field.write; }
    input hdr: Image;
    input grade: Rows<Grade>;
    output result: Image;
    compute {
        let c = sample(hdr);
        let g = grade_color(c.xyz, at(grade, 0));
        return vec4(g.x, g.y, g.z, c.w);
    }
}
