// A watercolor's tone over a picture, after any renderer: colors a little more vivid, shadows cool, highlights warm,
// judged on the light as shown (HDR squeezed). A painted look composes it with ink (`light.outline`) and the
// renderer's painted shading (`toon`).

/// How a watercolor tones: how vivid (1 as it is), the tint of the lights and of the shadows, and the cool lift laid
/// into the shadows.
struct Watercolor { vivid: Float; light_tint: Vec3; shadow_tint: Vec3; shadow_lift: Vec3; }

/// Light `c` toned as a watercolor by `w`.
fn watercolor(c: Vec3, w: Watercolor) -> Vec3 {
    let gray = dot(c, vec3(0.299, 0.587, 0.114));
    let seen = gray / (1.0 + gray);
    let soft = mix(vec3(gray, gray, gray), c, w.vivid);
    let shade = 1.0 - smoothstep(0.15, 0.55, seen);
    return soft * mix(w.light_tint, w.shadow_tint, shade) + w.shadow_lift * shade * gray;
}

/// The HDR picture `image` toned as a watercolor, `tone` of the way (0 as it is; `domain = size(image)`).
kernel image.watercolor@1 {
    requires { field.read; field.write; }
    input image: Image;
    param tone: Float = 1.0;
    param vivid: Float = 1.12;
    param light_tint: Vec3 = vec3(1.03, 1.0, 0.95);
    param shadow_tint: Vec3 = vec3(0.93, 0.98, 1.08);
    param shadow_lift: Vec3 = vec3(0.012, 0.016, 0.03);
    output result: Image;
    compute {
        let c = sample(image);
        let out = mix(c.xyz, watercolor(c.xyz, Watercolor { vivid: vivid, light_tint: light_tint, shadow_tint: shadow_tint, shadow_lift: shadow_lift }), tone);
        return vec4(out.x, out.y, out.z, c.w);
    }
}
