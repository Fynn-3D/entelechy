scene antialias.esn

# Flat stays flat. The lone pixel stands wholly out of the eight round it,
# so it is blended the whole subpixel share, 0.6, toward its black side:
# 0.4 of it is left. Off, it is whole.
frame 0.0
expect smooth.result[40] = 0.5 0.5 0.5 1 0.0001
expect softened.result[40] = 0.4 0.4 0.4 1 0.0001
expect off.result[40] = 1 1 1 1
