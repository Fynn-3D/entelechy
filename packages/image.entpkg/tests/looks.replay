scene looks.esn
window 64 64

# sRGB's transfer stores a half as 0.735 and gives it back; the ramp
# sharpened keeps the flat middle and darkens the ramp beside the spot;
# the mip strip begins with the picture's corner.
frame 0.0
expect stored.result[528] = 0.7354 0.7354 0.7354 1 0.001
expect light.result[528] = 0.5 0.5 0.5 1 0.001
expect crisp.result[528] = 0.5 0.5 0.5 1 0.001
expect crisp.result[330] = -0.0125 -0.0125 0.5 1 0.001
expect strip.result[0] = 0 0 0.5 1 0.001
expect count strip.result = 512

