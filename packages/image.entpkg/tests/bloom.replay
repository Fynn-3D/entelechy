scene bloom.esn

# Five levels grown back over a sixth, each 1: 1 + 0.8 (1 + 0.8 (...)),
# 3.68928 at the first; under the threshold, nothing.
frame 0.0
expect glow.d1.result[0] = 1 1 1 1 0.0001
expect glow.d6.result[0] = 1 1 1 1 0.0001
expect glow.bloom[0] = 3.68928 3.68928 3.68928 1 0.0005
expect none.bloom[0] = 0 0 0 1 0.0001
