// A finish's words at points whose answers are known by hand: a widescreen's bars, a split, an S curve, halation.
use "../kernels/";

node probe: kernel {
    requires { field.write; }
    output result: Rows<Vec4>;
    domain = 3;
    compute {
        let k = element();
        let ext = vec2(160.0, 120.0);
        return if k == 0 { vec4(film_bars(vec2(0.5, 0.1), ext, 2.39), film_bars(vec2(0.5, 0.5), ext, 2.39), film_bars(vec2(0.5, 0.1), ext, 0.0),
                film_bars(vec2(0.5, 0.9), ext, 2.39)) }
            else if k == 1 { vec4(film_split(vec3(0.5, 0.5, 0.5), 1.0), film_curve(vec3(0.25, 0.25, 0.25), 0.5).x) }
            else { vec4(film_curve(vec3(0.25, 0.25, 0.25), 1.0).x, 0.0, 0.0, 0.0) };
    }
}
node white: Grid<Vec4> { domain = vec2(8, 8); value = vec4(1.0, 1.0, 1.0, 1.0); }
node glow: kernel {
    requires { field.read; field.write; }
    input image: Image <- white.result;
    output result: Rows<Vec4>;
    domain = 1;
    compute { let g = film_halation(image, vec2(4.0, 4.0), 1.0); return vec4(g.x, g.y, g.z, 0.0); }
}
node half: Grid<Vec4> { domain = vec2(160, 120); value = vec4(0.5, 0.5, 0.5, 1.0); }
node quarter: Grid<Vec4> { domain = vec2(160, 120); value = vec4(0.25, 0.25, 0.25, 1.0); }

output result <- glow.result;
