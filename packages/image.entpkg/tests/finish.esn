// A finish's words at points whose answers are known by hand: a widescreen's bars, a split, an S curve, halation, the
// recipes; the film laid on with nothing asked of it (the picture as it was), with its curve, and in bars; a
// watercolor's tone over half gray.
use "../kernels/";

node probe: kernel {
    requires { field.write; }
    output result: Rows<Vec4>;
    domain = 3;
    compute {
        let k = element();
        let ext = vec2(160.0, 120.0);
        return if k == 0 { vec4(film_bars(vec2(0.5, 0.1), ext, 2.39), film_bars(vec2(0.5, 0.5), ext, 2.39), film_bars(vec2(0.5, 0.1), ext, 0.0),
                film_preset(1).letterbox) }
            else if k == 1 { vec4(film_split(vec3(0.5, 0.5, 0.5), 1.0), film_curve(vec3(0.25, 0.25, 0.25), 0.5).x) }
            else { vec4(film_curve(vec3(0.25, 0.25, 0.25), 1.0).x, film_none().grade.exposure, film_preset(4).grade.saturation, film_preset(9).vignette) };
    }
}
node white: Grid<Vec4> { domain = vec2(8, 8); value = vec4(1.0, 1.0, 1.0, 1.0); }
node glow: kernel {
    requires { field.read; field.write; }
    input image: Image <- white.result;
    output result: Rows<Vec4>;
    domain = 1;
    compute { let g = film_halation(image, vec2(4.0, 4.0), 1.0); return vec4(g.x, g.y, g.z, 0.0); }
}
node half: Grid<Vec4> { domain = vec2(160, 120); value = vec4(0.5, 0.5, 0.5, 1.0); }
node quarter: Grid<Vec4> { domain = vec2(160, 120); value = vec4(0.25, 0.25, 0.25, 1.0); }
node nothing: image.film_start@1 { fringe = 0.0; grain = 0.0; domain = 1; }
node curved: image.film_start@1 { curve = 1.0; fringe = 0.0; grain = 0.0; domain = 1; }
node barred: image.film_start@1 { letterbox = 2.39; fringe = 0.0; grain = 0.0; domain = 1; }
node as_was: image.film@1 { image <- half.result; film <- nothing.result; }
node s_curve: image.film@1 { image <- quarter.result; film <- curved.result; }
node bars: image.film@1 { image <- half.result; film <- barred.result; }
node toned_look: image.watercolor_start@1 { domain = 1; }
node toned: image.watercolor@1 { look <- toned_look.result; image <- half.result; }

output result <- bars.result;
