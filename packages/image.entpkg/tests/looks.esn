// The looks a scene places last, on a small ramp with a bright spot:
// encoded to sRGB and decoded back, sharpened, finished as a camera's,
// mipmapped, and held to a three-color ramp in coarse pixels.
use "../kernels/";

node ramp: kernel {
    requires { field.write; }
    output result: Image;
    domain = vec2(32, 32);
    compute {
        let p = coord();
        let spot = if length(p - vec2(8.0, 8.0)) < 2.0 { 6.0 } else { 0.0 };
        return vec4(p.x / 32.0 + spot, p.y / 32.0 + spot, 0.5, 1.0);
    }
}
node deep: kernel {
    requires { field.read; field.write; }
    input picture: Image <- ramp.result;
    output result: Grid<Vec4>;
    compute { let c = sample(picture); return vec4(c.x, c.y, c.z, 5.0); }
}
node focus: kernel {
    requires { field.write; }
    output result: Rows<Float>;
    domain = 1;
    compute { return 5.0; }
}
node colors: kernel {
    requires { field.write; }
    output result: Rows<Vec3>;
    domain = 3;
    compute { return [vec3(0.1, 0.1, 0.2), vec3(0.4, 0.5, 0.3), vec3(0.9, 0.9, 0.8)][element()]; }
}
node stored: image.encode@1 { source <- ramp.result; }
node light: image.decode@1 { source <- stored.result; }
node crisp: graph "../graphs/sharpen.esn" { source <- ramp.result; sigma = 1.0; amount = 0.6; }
node film: graph "../graphs/finish.esn" { source <- deep.result; focus <- focus.result; exposure = 1.0; grain = 0.0; }
node strip: graph "../graphs/mipmap.esn" { source <- ramp.result; side = 16; levels = 4; }
node retro: graph "../graphs/nes.esn" { source <- ramp.result; colors <- colors.result; cell = 4.0; }

output result <- film.result;
