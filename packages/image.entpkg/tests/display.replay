scene display.esn

# Light of 4 past a threshold of 2: its glow's source an eighth the size,
# 2 everywhere; spread by weights summing to one, still 2. Black is black.
frame 0.0
expect bright.result[0] = 2 2 2 1 0.0001
expect spread.result[1] = 2 2 2 1 0.0001
expect dark.result[0] = 0 0 0 1

# Middle gray with no curve is sRGB's 0.4614; in a corner, the corners'
# darkening of 0.35 leaves 0.8462 of it, sRGB's 0.4266; warmed, its shadow
# share of 0.0686 tints red down and blue up; half gray's glow 0.6 strong
# over black is 0.3 of light, sRGB's 0.5838; ACES's fit takes gray to
# 0.2669 of light, sRGB's 0.5535.
expect plain.result[0] = 0.461356 0.461356 0.461356 1 0.0002
expect cornered.result[0] = 0.426646 0.426646 0.426646 1 0.0002
expect warm.result[0] = 0.456044 0.461356 0.468273 1 0.0002
expect glowing.result[0] = 0.583831 0.583831 0.583831 1 0.0002
expect filmic.result[0] = 0.553458 0.553458 0.553458 1 0.0002
