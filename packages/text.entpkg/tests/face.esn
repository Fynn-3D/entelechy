// A text's wide characters, each once, in order of code (中 文 中 A 文 字:
// 中, 字, 文), and a font's glyphs drawn twelve pixels square: 中 and 文
// as squares from 0.2 to 0.8 of an em, the ascent 11/12 of an em, the
// glyphs as a font node gives them for those codes, and drawn again four
// pixels a texel, read blended. The words as letters
// over two cells a wide one at twelve pixels, three at sixteen.
use "../kernels/";

// The bitmap font read through the package's name, as a scene anywhere reads it.
input font: Grid<Float> = "text.entpkg/tests/data/font.png";
input words: Rows<Int> = bytes "data/words.txt";

node wanted: graph "../graphs/wanted.esn" { text <- words; }

node glyphs: kernel {
    requires { field.write; }
    output result: Rows<Letterform>;
    domain = 2;
    compute {
        let code = if element() == 0 { 20013 } else { 25991 };
        return Letterform { code: code, advance: 1024, first: element() * 4, count: 4, lo: vec2(0.2, 0.2), hi: vec2(0.8, 0.8) };
    }
}
node outlines: kernel {
    requires { field.write; }
    output result: Rows<Vec4>;
    domain = 8;
    compute {
        let c = [vec2(0.2, 0.2), vec2(0.8, 0.2), vec2(0.8, 0.8), vec2(0.2, 0.8)];
        let k = element() % 4;
        let a = c[k];
        let b = c[(k + 1) % 4];
        return vec4(a.x, a.y, b.x, b.y);
    }
}
node metrics: kernel {
    requires { field.write; }
    output result: Rows<FontMetrics>;
    domain = 1;
    compute { return FontMetrics { units: 1024, ascent: 11.0 / 12.0, descent: -1.0 / 12.0, gap: 0.0 }; }
}
// A font whose ascent and descent are farther than an em apart (1.06 and
// -0.34, as a regular hand keeps room over and under its line): its em
// square centered between them, so the glyph stays inside its square.
node tall_metrics: kernel {
    requires { field.write; }
    output result: Rows<FontMetrics>;
    domain = 1;
    compute { return FontMetrics { units: 1024, ascent: 1.06, descent: -0.34, gap: 0.0 }; }
}
node tall: graph "../graphs/face.esn" { font <- font; glyphs <- glyphs.result; outlines <- outlines.result; metrics <- tall_metrics.result; side = 12; }
node letters: graph "../graphs/face.esn" { font <- font; glyphs <- glyphs.result; outlines <- outlines.result; metrics <- metrics.result; side = 12; }
node dense: graph "../graphs/face.esn" { font <- font; glyphs <- glyphs.result; outlines <- outlines.result; metrics <- metrics.result; side = 12; density = 4; }
// 中's ink at its middle, at its left edge (its square begins 2.4 texels
// in) and outside it, at the two densities.
node covers: kernel {
    requires { field.read; field.write; }
    input plain: Grid<Float> <- letters.letters;
    input fine: Grid<Float> <- dense.letters;
    output result: Rows<Float>;
    domain = 6;
    compute {
        let places = [vec2(6.0, 4.0), vec2(2.4, 4.0), vec2(1.5, 4.0)];
        let at_ = places[element() % 3];
        return if element() < 3 { letter_cover(plain, 256, at_) } else { letter_cover(fine, 256, at_) };
    }
}
node twelve: graph "../graphs/decode.esn" { text <- words; codes <- letters.codes; width = 12; side = 12; }
node sixteen: graph "../graphs/decode.esn" { text <- words; codes <- letters.codes; width = 12; side = 16; }

output result <- letters.letters;
