/// The font: a 5x7 bitmap face for the printable ASCII codes, 32 to 126,
/// written as its rows and baked into an atlas the text library reads.
/// The atlas is a Grid<Float> of 96 by 48 texels: sixteen cells of 6 by 8
/// per row, six rows, the glyph in the top-left 5 by 7 of its cell and a
/// blank column and row beside it, so cell (code - 32) % 16, (code - 32)
/// / 16 holds a code. A node running it sets `domain = vec2(96, 48);`;
/// the package's `font.png` is this atlas, baked, for a scene to read as
/// an input. Each glyph is its seven rows, top first, each row five bits with the
/// leftmost pixel highest: `rows(14, 17, 17, 31, 17, 17, 17)` is an A.
kernel text.font@1 {
    requires { field.write; }
    output result: Grid<Float>;

    // Seven five-bit rows packed into two words: the top four in `hi`,
    // the bottom three in `lo`.
    struct Bitmap { hi: Int; lo: Int; }

    fn rows(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int) -> Bitmap {
        return Bitmap { hi: a << 15 | b << 10 | c << 5 | d, lo: e << 10 | f << 5 | g };
    }

    fn row_of(b: Bitmap, y: Int) -> Int {
        return if y < 4 { (b.hi >> (5 * (3 - y))) & 31 } else { (b.lo >> (5 * (6 - y))) & 31 };
    }

    // Space, punctuation, and the digits.
    fn low(c: Int) -> Bitmap {
        return match c {
            32 => rows(0, 0, 0, 0, 0, 0, 0),   // space
            33 => rows(4, 4, 4, 4, 4, 0, 4),   // !
            34 => rows(10, 10, 10, 0, 0, 0, 0),   // "
            35 => rows(10, 10, 31, 10, 31, 10, 10),   // #
            36 => rows(4, 15, 20, 14, 5, 30, 4),   // $
            37 => rows(24, 25, 2, 4, 8, 19, 3),   // %
            38 => rows(12, 18, 20, 8, 21, 18, 13),   // &
            39 => rows(4, 4, 4, 0, 0, 0, 0),   // '
            40 => rows(2, 4, 8, 8, 8, 4, 2),   // (
            41 => rows(8, 4, 2, 2, 2, 4, 8),   // )
            42 => rows(0, 4, 21, 14, 21, 4, 0),   // *
            43 => rows(0, 4, 4, 31, 4, 4, 0),   // +
            44 => rows(0, 0, 0, 0, 12, 4, 8),   // ,
            45 => rows(0, 0, 0, 31, 0, 0, 0),   // -
            46 => rows(0, 0, 0, 0, 0, 12, 12),   // .
            47 => rows(0, 1, 2, 4, 8, 16, 0),   // /
            48 => rows(14, 17, 19, 21, 25, 17, 14),   // 0
            49 => rows(4, 12, 4, 4, 4, 4, 14),   // 1
            50 => rows(14, 17, 1, 2, 4, 8, 31),   // 2
            51 => rows(31, 2, 4, 2, 1, 17, 14),   // 3
            52 => rows(2, 6, 10, 18, 31, 2, 2),   // 4
            53 => rows(31, 16, 30, 1, 1, 17, 14),   // 5
            54 => rows(6, 8, 16, 30, 17, 17, 14),   // 6
            55 => rows(31, 1, 2, 4, 8, 8, 8),   // 7
            56 => rows(14, 17, 17, 14, 17, 17, 14),   // 8
            57 => rows(14, 17, 17, 15, 1, 2, 12),   // 9
            58 => rows(0, 12, 12, 0, 12, 12, 0),   // :
            59 => rows(0, 12, 12, 0, 12, 4, 8),   // ;
            60 => rows(2, 4, 8, 16, 8, 4, 2),   // <
            61 => rows(0, 0, 31, 0, 31, 0, 0),   // =
            62 => rows(8, 4, 2, 1, 2, 4, 8),   // >
            63 => rows(14, 17, 1, 2, 4, 0, 4),   // ?
            _ => rows(0, 0, 0, 0, 0, 0, 0),
        };
    }

    // @ and the capitals, with the brackets after them.
    fn mid(c: Int) -> Bitmap {
        return match c {
            64 => rows(14, 17, 1, 13, 21, 21, 14),   // @
            65 => rows(14, 17, 17, 31, 17, 17, 17),   // A
            66 => rows(30, 17, 17, 30, 17, 17, 30),   // B
            67 => rows(14, 17, 16, 16, 16, 17, 14),   // C
            68 => rows(28, 18, 17, 17, 17, 18, 28),   // D
            69 => rows(31, 16, 16, 30, 16, 16, 31),   // E
            70 => rows(31, 16, 16, 30, 16, 16, 16),   // F
            71 => rows(14, 17, 16, 23, 17, 17, 15),   // G
            72 => rows(17, 17, 17, 31, 17, 17, 17),   // H
            73 => rows(14, 4, 4, 4, 4, 4, 14),   // I
            74 => rows(7, 2, 2, 2, 2, 18, 12),   // J
            75 => rows(17, 18, 20, 24, 20, 18, 17),   // K
            76 => rows(16, 16, 16, 16, 16, 16, 31),   // L
            77 => rows(17, 27, 21, 21, 17, 17, 17),   // M
            78 => rows(17, 17, 25, 21, 19, 17, 17),   // N
            79 => rows(14, 17, 17, 17, 17, 17, 14),   // O
            80 => rows(30, 17, 17, 30, 16, 16, 16),   // P
            81 => rows(14, 17, 17, 17, 21, 18, 13),   // Q
            82 => rows(30, 17, 17, 30, 20, 18, 17),   // R
            83 => rows(15, 16, 16, 14, 1, 1, 30),   // S
            84 => rows(31, 4, 4, 4, 4, 4, 4),   // T
            85 => rows(17, 17, 17, 17, 17, 17, 14),   // U
            86 => rows(17, 17, 17, 17, 17, 10, 4),   // V
            87 => rows(17, 17, 17, 21, 21, 27, 17),   // W
            88 => rows(17, 17, 10, 4, 10, 17, 17),   // X
            89 => rows(17, 17, 17, 10, 4, 4, 4),   // Y
            90 => rows(31, 1, 2, 4, 8, 16, 31),   // Z
            91 => rows(14, 8, 8, 8, 8, 8, 14),   // [
            92 => rows(0, 16, 8, 4, 2, 1, 0),   // \
            93 => rows(14, 2, 2, 2, 2, 2, 14),   // ]
            94 => rows(4, 10, 17, 0, 0, 0, 0),   // ^
            95 => rows(0, 0, 0, 0, 0, 0, 31),   // _
            _ => rows(0, 0, 0, 0, 0, 0, 0),
        };
    }

    // The backtick, the small letters, and the braces.
    fn high(c: Int) -> Bitmap {
        return match c {
            96 => rows(8, 4, 2, 0, 0, 0, 0),   // `
            97 => rows(0, 0, 14, 1, 15, 17, 15),   // a
            98 => rows(16, 16, 22, 25, 17, 17, 30),   // b
            99 => rows(0, 0, 14, 16, 16, 17, 14),   // c
            100 => rows(1, 1, 13, 19, 17, 17, 15),   // d
            101 => rows(0, 0, 14, 17, 31, 16, 14),   // e
            102 => rows(6, 9, 8, 28, 8, 8, 8),   // f
            103 => rows(0, 15, 17, 17, 15, 1, 14),   // g
            104 => rows(16, 16, 22, 25, 17, 17, 17),   // h
            105 => rows(4, 0, 12, 4, 4, 4, 14),   // i
            106 => rows(2, 0, 6, 2, 2, 18, 12),   // j
            107 => rows(16, 16, 18, 20, 24, 20, 18),   // k
            108 => rows(12, 4, 4, 4, 4, 4, 14),   // l
            109 => rows(0, 0, 26, 21, 21, 17, 17),   // m
            110 => rows(0, 0, 22, 25, 17, 17, 17),   // n
            111 => rows(0, 0, 14, 17, 17, 17, 14),   // o
            112 => rows(0, 0, 30, 17, 30, 16, 16),   // p
            113 => rows(0, 0, 15, 17, 15, 1, 1),   // q
            114 => rows(0, 0, 22, 25, 16, 16, 16),   // r
            115 => rows(0, 0, 15, 16, 14, 1, 30),   // s
            116 => rows(8, 8, 28, 8, 8, 9, 6),   // t
            117 => rows(0, 0, 17, 17, 17, 19, 13),   // u
            118 => rows(0, 0, 17, 17, 17, 10, 4),   // v
            119 => rows(0, 0, 17, 17, 21, 21, 10),   // w
            120 => rows(0, 0, 17, 10, 4, 10, 17),   // x
            121 => rows(0, 0, 17, 17, 15, 1, 14),   // y
            122 => rows(0, 0, 31, 2, 4, 8, 31),   // z
            123 => rows(2, 4, 4, 8, 4, 4, 2),   // {
            124 => rows(4, 4, 4, 4, 4, 4, 4),   // |
            125 => rows(8, 4, 4, 2, 4, 4, 8),   // }
            126 => rows(0, 0, 9, 21, 18, 0, 0),   // ~
            _ => rows(0, 0, 0, 0, 0, 0, 0),
        };
    }

    compute {
        let p = coord();
        let col = int(floor(p.x / 6.0));
        let row = int(floor(p.y / 8.0));
        let code = 32 + row * 16 + col;
        let x = int(p.x) - col * 6;
        let y = int(p.y) - row * 8;
        let b = if code < 64 { low(code) } else if code < 96 { mid(code) } else { high(code) };
        // A row's leftmost pixel is its highest bit.
        let on = x < 5 && y < 7 && code <= 126 && (row_of(b, y) >> (4 - x)) & 1 == 1;
        return float(on);
    }
}
