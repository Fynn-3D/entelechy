// Text drawn by a Kernel's own code, pixel by pixel: whether a pixel is
// ink of a character, of a run of codes, or of a number, through the font
// atlas. A character's cell is 6 by 8 texels, its glyph the top-left 5 by
// 7, `scale` pixels a texel. A Kernel binds the atlas as an input (the
// package's `font.png`, or `text.font` run once) and asks per pixel.
use "text.ent";

/// Whether texel `x`, `y` of the glyph of `code` is ink; a code the font
/// lacks is a `?`.
fn glyph_ink(font: Atlas, code: Int, x: Int, y: Int) -> Bool {
    if x < 0 || y < 0 || x > 4 || y > 6 { return false; }
    let known = match code { 32..=126 => code, _ => 63 };
    let c = known - 32;
    return at(font, vec2(float((c % 16) * 6 + x), float((c / 16) * 8 + y))) > 0.5;
}

/// Whether pixel `px` is ink of `code`, its cell's top left at `origin`.
fn code_ink(font: Atlas, code: Int, px: IVec2, origin: IVec2, scale: Int) -> Bool {
    if px.x < origin.x || px.y < origin.y { return false; }
    let t = (px - origin) / max(scale, 1);
    return glyph_ink(font, code, t.x, t.y);
}

/// Whether pixel `px` is ink of `length` codes of `codes` from `first`,
/// side by side from `origin`: a word of a `text` input, say.
fn codes_ink(font: Atlas, codes: Codes, first: Int, length: Int, px: IVec2, origin: IVec2, scale: Int) -> Bool {
    if px.x < origin.x || px.y < origin.y { return false; }
    let t = (px - origin) / max(scale, 1);
    let i = t.x / 6;
    if i >= length || t.y > 7 { return false; }
    return glyph_ink(font, at(codes, first + i), t.x % 6, t.y);
}

/// How many of `length` codes from `first` there are before the trailing
/// spaces: a word's length in a table of fixed-width words.
fn trimmed_length(codes: Codes, first: Int, length: Int) -> Int {
    return loop length with n = 0 { if at(codes, first + index()) != 32 { index() + 1 } else { n } };
}

/// How many characters `n` is written with: its digits, and a `-` first
/// when it is below zero.
fn digit_count(n: Int) -> Int {
    let digits = loop 10 with k = ivec2(abs(n) / 10, 1) until k.x == 0 { ivec2(k.x / 10, k.y + 1) };
    return digits.y + int(n < 0);
}

/// The code of character `i` of `n` written out, most significant first;
/// a space past either end.
fn digit_code(n: Int, i: Int) -> Int {
    let count = digit_count(n);
    if i < 0 || i >= count { return 32; }
    if n < 0 && i == 0 { return 45; }
    let place = count - 1 - i;
    let shifted = loop 10 with k = ivec2(abs(n), 0) until k.y >= place { ivec2(k.x / 10, k.y + 1) };
    return 48 + shifted.x % 10;
}

/// Whether pixel `px` is ink of `n` written out from `origin`.
fn number_ink(font: Atlas, n: Int, px: IVec2, origin: IVec2, scale: Int) -> Bool {
    if px.x < origin.x || px.y < origin.y { return false; }
    let t = (px - origin) / max(scale, 1);
    let i = t.x / 6;
    if i >= digit_count(n) || t.y > 7 { return false; }
    return glyph_ink(font, digit_code(n, i), t.x % 6, t.y);
}
