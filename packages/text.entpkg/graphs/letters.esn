//! The letters' grid (`ui.letters`): the widgets package's bitmap font,
//! then the side of the atlas's glyphs in texels and their density, then
//! the atlas, a grid 96 pixels across that a scene draws, its glyphs
//! `side` times `density` pixels square in order of the codes it gives
//! `graphs/text.esn`.
//!
//!   node letters: graph "text.entpkg/graphs/letters.esn" { font <- font; atlas <- glyphs.result; side = 10; }
use "../kernels/letters.ent";

input font: Grid<Float>;
input atlas: Grid<Float>;
param side: Int = 10;
param density: Int = 1;

node grid: text.letters@1 { side = side; density = density; font <- font; atlas <- atlas; domain = vec2(96.0, 49.0) + size(atlas) * vec2(0.0, 1.0); }

output letters <- grid.result;
