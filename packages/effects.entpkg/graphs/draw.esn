//! Casts drawn over a picture. A project reads the package's tables and
//! hands in its casts, its picture (alpha 1 + how far, 0 for the sky)
//! and its eye:
//!
//!   input vfx_elements: Elements = "effects.entpkg/data/elements.csv";
//!   input vfx_effects: Effects = "effects.entpkg/data/effects.csv";
//!   input vfx_layers: Layers = "effects.entpkg/data/layers.csv";
//!   node fx: graph "effects.entpkg/graphs/draw.esn" { picture <- view.result; eye <- eye.result;
//!       casts <- casts.result; elements <- vfx_elements; effects <- vfx_effects; layers <- vfx_layers; }
//!
//! `result` is the picture with the casts' light; `lives` the layers as
//! they are now.
use "../kernels/";

input picture: Image;
input eye: Eyes;
input casts: Casts;
input elements: Elements;
input effects: Effects;
input layers: Layers;
/// How much coarser than the picture the light is gathered (1 for every pixel).
param shrink: Float = 2.0;

node now: effects.now@1 { casts <- casts; effects <- effects; layers <- layers; domain = count(casts) * 8; }
node light: effects.light@1 { picture <- picture; eye <- eye; lives <- now.result; elements <- elements; shrink = shrink; domain = ceil(size(picture) / shrink); }
node draw: effects.draw@1 { picture <- picture; light <- light.result; depth <- light.depth; shrink = shrink; }

output result <- draw.result;
output lives <- now.result;
