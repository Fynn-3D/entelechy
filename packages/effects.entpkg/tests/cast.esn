// Two effects cast before an eye over a dark ground whose alpha holds
// how far each pixel is: a fire bolt and a frost burst a few meters off,
// drawn as light gathered along each pixel's ray, and again in a cel
// look with inked edges.
use "../kernels/";

input elements: Elements = "../data/elements.csv";
input effects: Effects = "../data/effects.csv";
input layers: Layers = "../data/layers.csv";

node eye: kernel {
    requires { field.write; }
    output result: Eyes;
    domain = 1;
    compute { return eye_looking(vec3(0.0, 2.0, -8.0), vec3(0.0, 1.0, 0.0), 1.3); }
}
node casts: kernel {
    requires { field.write; time.read; }
    output result: Casts;
    domain = 2;
    compute {
        let i = element();
        return Cast { on: 1, effect: i, element: i, tier: 1, seed: 7 + i, from: vec3(float(i) * 3.0 - 1.5, 1.0, 0.0), to: vec3(float(i) * 3.0 - 1.5, 1.0, 4.0),
            start: 0.0, now: time(), hide: 0 };
    }
}
node ground: kernel {
    requires { field.write; }
    output result: Image;
    domain = vec2(160, 90);
    compute { return vec4(0.03, 0.03, 0.04, 1.0 + 100.0); }
}
node drawn: graph "../graphs/draw.esn" { picture <- ground.result; eye <- eye.result; casts <- casts.result; elements <- elements; effects <- effects; layers <- layers; }
node light: effects.light@1 { picture <- ground.result; eye <- eye.result; lives <- drawn.lives; elements <- elements; domain = ceil(size(picture) / 2.0); }
node style: Rows<Int> { domain = 1; value = 1; }
node inked: effects.cel@1 { picture <- ground.result; light <- light.result; depth <- light.depth; style <- style.result; }

output result <- drawn.result;
