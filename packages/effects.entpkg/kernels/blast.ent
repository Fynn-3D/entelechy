// The great spells' bursts as light: a meteor's impact, an ice spike
// out of the ground, a wall of fire.
use "random.entpkg";
use "glow.ent";
use "element.ent";

/// A meteor striking at `c`, its blast `r` across: the flash and a ring of
/// fire running out, a ring of dust behind it, a column of fire and smoke
/// climbing, rocks flung out and falling, the ground scorched and glowing.
fn meteor_impact(from: Vec3, dir: Vec3, scene: Float, c: Vec3, r: Float, age: Float, t: Float, seed: Int) -> Glow {
    let span = sphere_span(from, dir, c + vec3(0.0, r * 0.8, 0.0), r * 2.2 + 2.0);
    if span.y < span.x || span.x > scene { return no_glow(); }
    let blast = shockwave(from, dir, scene, c, r * 1.6, age, vec3(1.0, 0.55, 0.18), t, seed);
    let dust = shockwave(from, dir, scene, c, r * 2.1, clamp(age * 0.75, 0.0, 1.0), vec3(0.45, 0.33, 0.22), t, seed + 11);
    // The column: fire at its foot, rolling up into smoke.
    let climb = sqrt(age);
    let column = fire(from, dir, scene, c + vec3(0.0, 0.4, 0.0), r * (0.35 + 0.35 * climb), vec3(0.0, 1.0, 0.0), r * (0.4 + 1.6 * climb),
        1.35 * pow(1.0 - age, 1.1), t, seed + 5);
    // The scorch: the ground glowing where it struck, cooling.
    let gp = from + dir * scene;
    let gd = length(vec2(gp.x - c.x, gp.z - c.z));
    let ground = scene < 1000.0 && abs(gp.y - c.y) < 0.35 + 0.15 * gd;
    let cracks = if ground && gd < r * 1.2 { (0.5 + 0.5 * ridged3(vec3(gp.x, 0.0, gp.z) * 1.4, 2, seed)) * smoothstep(r * 1.2, r * 0.2, gd) } else { 0.0 };
    let lines = pow(cracks, 6.0);
    let scorch = Glow { light: fire_hue(0.55 + 0.3 * (1.0 - age)) * lines * 1.4 * (1.0 - smoothstep(0.4, 1.0, age)), through: 1.0 - smoothstep(r * 1.1, 0.0, gd) * 0.45 * (if ground { 1.0 } else { 0.0 }), near: 100000.0 };
    // Rocks flung out: dark, lit by the fire below them.
    let rocks = loop 14 with g = no_glow() {
        let i = index();
        let a = hash1(i, seed + 21) * 6.2832;
        let out = (0.6 + hash1(i, seed + 23)) * r * 1.4;
        let up = 5.0 + 7.0 * hash1(i, seed + 25);
        let tt = age * 1.6;
        let p = c + vec3(cos(a) * out * tt, up * tt - 9.0 * tt * tt + 0.3, sin(a) * out * tt);
        let d = ray_segment(from, dir, p, p);
        let size = 0.12 + 0.12 * hash1(i, seed + 27);
        let on = if d.y < scene && p.y > c.y - 0.2 { exp(0.0 - pow(d.x / size, 4.0)) } else { 0.0 };
        Glow { light: g.light + fire_hue(0.45) * on * 0.6 * g.through, through: g.through * (1.0 - on * 0.9), near: g.near }
    };
    return behind(behind(behind(rocks, column), behind(blast, dust)), scorch);
}

/// The spike's shape: one great crystal out of the ground, leaning, and a
/// crown of smaller ones about its foot, grown by `grown`.
fn spike_shape(q: Vec3, grown: Float, seed: Int) -> Float {
    let lean = normalize(vec3(0.15 * (hash1(seed, 3) - 0.5), 1.0, 0.15 * (hash1(seed, 5) - 0.5)));
    let tall = 4.2 * grown;
    let main = crystal(q - lean * (tall * 0.5 - 0.3), lean, tall, 0.5);
    return loop 8 with d = main {
        let k = index();
        let ang = float(k) * 0.7854 + hash1(k, seed) * 0.5;
        let out = 0.35 + 0.45 * hash1(k + 9, seed);
        let way = normalize(vec3(cos(ang) * out, 1.0, sin(ang) * out));
        let len = (1.0 + 1.3 * hash1(k + 17, seed)) * grown;
        let base = vec3(cos(ang), 0.0, sin(ang)) * (0.45 + 0.4 * hash1(k + 29, seed));
        min(d, crystal(q - base - way * (len * 0.5 - 0.15), way, len, 0.16 + 0.08 * hash1(k + 23, seed)))
    };
}

/// An ice spike bursting out of the ground at `c`, `s` its size: grown in
/// a blink, standing a moment, then gone; cold within, bright at its
/// edges, frost running out over the ground and a mist about it.
fn ice_spike(from: Vec3, dir: Vec3, scene: Float, c: Vec3, s: Float, age: Float, t: Float, seed: Int) -> Glow {
    let grown = smoothstep(0.0, 0.07, age);
    let fade = 1.0 - smoothstep(0.72, 1.0, age);
    let frost = shockwave(from, dir, scene, c, 3.2 * s, clamp(age * 1.4, 0.0, 1.0), vec3(0.4, 0.62, 1.0), t, seed + 13);
    let center = c + vec3(0.0, 2.0 * s, 0.0);
    let bound = 3.0 * s;
    let span = sphere_span(from, dir, center, bound);
    let far = min(span.y, scene);
    if far <= span.x { return frost; }
    let hit = loop 40 with m = vec2(span.x, -1.0) until m.y >= 0.0 || m.x > far {
        let p = from + dir * m.x;
        let d = spike_shape((p - c) / s, grown, seed) * s;
        if d < 0.003 { vec2(m.x, 1.0) } else { vec2(m.x + max(d, 0.012), -1.0) }
    };
    let mid = from + dir * (span.x + min(far, span.y)) * 0.5;
    let mist = (1.0 - smoothstep(0.0, bound, length(mid - center))) * 0.3 * fade;
    let mist_glow = Glow { light: vec3(0.7, 0.9, 1.0) * mist * 0.7, through: 1.0 - mist * 0.5, near: 100000.0 };
    if hit.y < 0.0 { return behind(mist_glow, frost); }
    let p = from + dir * hit.x;
    let e = 0.005;
    let q = (p - c) / s;
    let n = normalize(vec3(spike_shape(q + vec3(e, 0.0, 0.0), grown, seed) - spike_shape(q - vec3(e, 0.0, 0.0), grown, seed),
        spike_shape(q + vec3(0.0, e, 0.0), grown, seed) - spike_shape(q - vec3(0.0, e, 0.0), grown, seed),
        spike_shape(q + vec3(0.0, 0.0, e), grown, seed) - spike_shape(q - vec3(0.0, 0.0, e), grown, seed)));
    let edge = pow(1.0 - abs(dot(n, dir)), 3.0);
    let inner = 0.5 + 0.5 * fbm3(q * 4.0 + vec3(t * 0.3, 0.0, 0.0), 2, seed);
    let light = (vec3(0.3, 0.65, 1.0) * (0.3 + 0.55 * inner) + vec3(0.92, 0.98, 1.0) * edge * 2.0) * fade;
    return behind(behind(mist_glow, Glow { light: light, through: 1.0 - 0.9 * fade, near: hit.x }), frost);
}

/// Where a ray goes through a box standing upright at `c`: `ax` and `az`
/// its axes across the ground, `h` its half sizes along them and up;
/// (in, out), out below in where it misses.
fn box_span(from: Vec3, dir: Vec3, c: Vec3, ax: Vec3, az: Vec3, h: Vec3) -> Vec2 {
    let o = from - c;
    let lo = vec3(dot(o, ax), o.y, dot(o, az));
    let ld = vec3(dot(dir, ax), dir.y, dot(dir, az));
    let inv = vec3(1.0 / (if abs(ld.x) < 0.00001 { 0.00001 } else { ld.x }), 1.0 / (if abs(ld.y) < 0.00001 { 0.00001 } else { ld.y }), 1.0 / (if abs(ld.z) < 0.00001 { 0.00001 } else { ld.z }));
    let a = (vec3(0.0, 0.0, 0.0) - h - lo) * inv;
    let b = (h - lo) * inv;
    let near = max(max(min(a.x, b.x), min(a.y, b.y)), min(a.z, b.z));
    let far = min(min(max(a.x, b.x), max(a.y, b.y)), max(a.z, b.z));
    return vec2(max(near, 0.0), far);
}

/// A part of a wall of fire standing at `c`, across the way `way` it was
/// cast, `s` its size: flames as tall as a man and more, risen in a blink,
/// roaring a while and sinking; embers going up. Marched only through its
/// own box, so the wall's parts side by side cost no more than one wall.
fn fire_wall(from: Vec3, dir: Vec3, scene: Float, c: Vec3, way: Vec3, s: Float, age: Float, t: Float, seed: Int) -> Glow {
    let life = smoothstep(0.0, 0.04, age) * (1.0 - smoothstep(0.85, 1.0, age));
    let tall = 3.4 * s * life;
    if life <= 0.0 { return no_glow(); }
    let ahead = normalize(vec3(way.x, 0.0, way.z));
    let side = vec3(ahead.z, 0.0, 0.0 - ahead.x);
    let span = box_span(from, dir, c + vec3(0.0, tall * 0.6, 0.0), side, ahead, vec3(0.8 * s, tall * 0.6, 0.42 * s));
    let far = min(span.y, scene);
    if far <= span.x { return no_glow(); }
    let step = (far - span.x) / 10.0;
    let flames = loop 10 with g = no_glow() {
        let p = from + dir * (span.x + (float(index()) + 0.5) * step);
        let q = p - c;
        let x = dot(q, side) / (0.85 * s);
        let z = dot(q, ahead) / (0.4 * s);
        let y = q.y / max(tall, 0.01);
        let n = fbm3(vec3(dot(q, side) * 1.3, q.y * 0.9 - t * 4.5, dot(q, ahead) * 1.3), 2, seed);
        let body = clamp(1.0 - x * x, 0.0, 1.0) * clamp(1.0 - z * z, 0.0, 1.0) * clamp(1.0 - y, 0.0, 1.0) * (if y < 0.0 { 0.0 } else { 1.0 });
        let dens = clamp(body * 1.4 + (n - 0.45) * 1.2 * body, 0.0, 1.0);
        let hot = clamp(dens * (1.15 - 0.8 * y), 0.0, 1.0);
        let absorb = dens * step * 2.5;
        let lit = fire_hue(hot) * (0.3 + 3.2 * hot * hot) * dens * step * 3.0;
        // Flames are light: they are never outlined.
        Glow { light: g.light + lit * g.through, through: g.through * exp(0.0 - absorb), near: g.near }
    };
    let embers = rising(from, dir, scene, c, 0.75 * s, tall * 1.6 + 1.0, t, seed + 31, 6, 0.03);
    return behind(flames, Glow { light: vec3(1.0, 0.6, 0.2) * embers * 1.6, through: 1.0, near: 100000.0 });
}
