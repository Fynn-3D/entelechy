// Magick's light, gathered along a ray (`Glow`): a sphere's span on the
// ray, a segment's nearest pass, a stroke, a jagged line, a shaft; marks
// lying on the floor and motes rising.
use "random.entpkg";
use "geometry.entpkg";

/// Light gathered along a ray: its color, and how much of what lies
/// behind still shows through.
struct Glow { light: Vec3; through: Float; near: Float; }

fn no_glow() -> Glow { return Glow { light: vec3(0.0, 0.0, 0.0), through: 1.0, near: 100000.0 }; }

/// `back` seen through `front`.
fn behind(front: Glow, back: Glow) -> Glow { return Glow { light: front.light + back.light * front.through, through: front.through * back.through, near: min(front.near, back.near) }; }

/// Where a ray enters and leaves a sphere (y below x: it misses).
fn sphere_span(from: Vec3, dir: Vec3, c: Vec3, r: Float) -> Vec2 {
    let o = from - c;
    let b = dot(o, dir);
    let q = dot(o, o) - r * r;
    let h = b * b - q;
    if h < 0.0 { return vec2(1.0, -1.0); }
    let s = sqrt(h);
    return vec2(max(0.0 - b - s, 0.0), 0.0 - b + s);
}

/// How far a ray passes from a segment, and how far along the ray.
fn ray_segment(from: Vec3, dir: Vec3, a: Vec3, b: Vec3) -> Vec2 {
    let u = b - a;
    let w = from - a;
    let uu = dot(u, u);
    let ud = dot(u, dir);
    let uw = dot(u, w);
    let dw = dot(dir, w);
    let den = uu - ud * ud;
    let s = clamp(if den > 0.0001 { (uw - ud * dw) / den } else { 0.0 }, 0.0, 1.0);
    let p = a + u * s;
    let t = max(dot(p - from, dir), 0.0);
    return vec2(length(from + dir * t - p), t);
}

/// A stroke's glow along segment a-b, `w` wide, where nearer than the
/// picture.
fn stroke(from: Vec3, dir: Vec3, scene: Float, a: Vec3, b: Vec3, w: Float) -> Float {
    let rs = ray_segment(from, dir, a, b);
    if rs.y > scene { return 0.0; }
    return exp(0.0 - (rs.x / w) * (rs.x / w)) * 4.0 + exp(0.0 - (rs.x / (w * 12.0)) * (rs.x / (w * 12.0))) * 0.35;
}

/// The jag of a stroke: point `i` of `n` from a to b, thrown aside by a
/// hash that changes 24 times a second.
fn jag(a: Vec3, b: Vec3, i: Int, n: Int, frame: Int, seed: Int, wild: Float) -> Vec3 {
    let s = float(i) / float(n);
    let off = vec3(hash1(i * 3 + frame * 101, seed) - 0.5, (hash1(i * 3 + 1 + frame * 101, seed) - 0.5) * 0.4, hash1(i * 3 + 2 + frame * 101, seed) - 0.5);
    let end = if i == 0 || i == n { 0.0 } else { 1.0 };
    return mix(a, b, s) + off * wild * end * sin(3.14159 * s) * 2.0;
}

/// A missile seen solid: an arrow's shaft and its head, or a knife,
/// from `p` back along `way`; its color, and a glow about it in `glow`.
fn shaft(from: Vec3, dir: Vec3, scene: Float, p: Vec3, way: Vec3, len: Float, w: Float, col: Vec3, glow: Vec3) -> Glow {
    let rs = ray_segment(from, dir, p - way * len, p);
    if rs.y > scene { return no_glow(); }
    let cover = clamp((w - rs.x) / (w * 0.5), 0.0, 1.0);
    let halo = exp(0.0 - pow(rs.x / (w * 5.0), 2.0)) * 0.8;
    return Glow { light: col * cover + glow * halo, through: 1.0 - cover, near: if cover > 0.5 { rs.y } else { 100000.0 } };
}

// ---------------------------------------------------------------- help and states

/// Where the eye's ray meets the ground's height `y` near `c` (within
/// `r`): how far from `c` across, and the angle round it; x -1 elsewhere.
fn on_floor(from: Vec3, dir: Vec3, scene: Float, c: Vec3, r: Float) -> Vec2 {
    let gp = from + dir * scene;
    let d = length(vec2(gp.x - c.x, gp.z - c.z));
    // The ground about it only: rising with the land a little, never up a
    // body standing on it.
    if scene > 1000.0 || abs(gp.y - c.y) > 0.25 + 0.15 * d { return vec2(-1.0, 0.0); }
    return if d > r { vec2(-1.0, 0.0) } else { vec2(d, atan2(gp.z - c.z, gp.x - c.x)) };
}

/// Motes of `hue` rising about `c` within `r`, `n` of them, up to `tall`.
fn rising(from: Vec3, dir: Vec3, scene: Float, c: Vec3, r: Float, tall: Float, t: Float, seed: Int, n: Int, w: Float) -> Float {
    return loop n with m = 0.0 {
        let i = index();
        let up = fract(t * 0.6 + hash1(i, seed));
        let a = hash1(i, seed + 3) * 6.2832 + t * 0.5;
        let rr = r * (0.3 + 0.7 * hash1(i, seed + 5));
        let p = c + vec3(cos(a) * rr, up * tall, sin(a) * rr);
        let d = ray_segment(from, dir, p, p);
        m + (if d.y < scene { exp(0.0 - pow(d.x / w, 2.0)) * (1.0 - up) } else { 0.0 })
    };
}

/// A point turned about up by `f`, as the models are placed.
fn rotated_y(p: Vec3, f: Float) -> Vec3 { return vec3(p.x * cos(f) + p.z * sin(f), p.y, p.z * cos(f) - p.x * sin(f)); }

/// Where a ray goes through a box standing upright at `c`: `ax` and `az`
/// its axes across the ground, `h` its half sizes along them and up;
/// (in, out), out below in where it misses.
fn box_span(from: Vec3, dir: Vec3, c: Vec3, ax: Vec3, az: Vec3, h: Vec3) -> Vec2 {
    let o = from - c;
    let lo = vec3(dot(o, ax), o.y, dot(o, az));
    let ld = vec3(dot(dir, ax), dir.y, dot(dir, az));
    let inv = vec3(1.0 / (if abs(ld.x) < 0.00001 { 0.00001 } else { ld.x }), 1.0 / (if abs(ld.y) < 0.00001 { 0.00001 } else { ld.y }), 1.0 / (if abs(ld.z) < 0.00001 { 0.00001 } else { ld.z }));
    let a = (vec3(0.0, 0.0, 0.0) - h - lo) * inv;
    let b = (h - lo) * inv;
    let near = max(max(min(a.x, b.x), min(a.y, b.y)), min(a.z, b.z));
    let far = min(min(max(a.x, b.x), max(a.y, b.y)), max(a.z, b.z));
    return vec2(max(near, 0.0), far);
}
