//! A mesh built as levels and cut into clusters (`kernels/cluster.ent`):
//! level 0 the mesh, each level after it merged on a lattice twice as wide,
//! `mesh_cluster_levels()` in all; each level's faces sorted into clusters.
//! `cell` is level 0's cell in meters, 0 for the mesh's mean edge. The
//! library a renderer draws from: `points`, `up` (each point's merged point
//! a level up), `faces`, `clusters`, `meshes` (this mesh's one row) and
//! `errors` (each level's bricks' errors), and `sources` (each face's face
//! of the mesh it came from, for what the mesh keeps of its own faces);
//! `graphs/library.esn` joins two.
use "../kernels/";

input points: Rows<MeshPoint>;
input faces: Rows<Face>;
param cell: Float = 0.0;

node box: mesh.cluster_box@1 { points <- points; }
node edges: mesh.cluster_edges@1 { faces <- faces; points <- points; }
node frame: mesh.cluster_frame@1 { box <- box.result; edges <- edges.result; cell = cell; domain = 1; }
node no_quadrics: mesh.cluster_no_quadrics@1 { points <- points; }
node own: mesh.cluster_own_faces@1 { faces <- faces; }
node quadrics: mesh.cluster_face_quadrics@1 { faces <- faces; points <- points; frame <- frame.result; blank <- no_quadrics.result; domain = count(faces) * 3; }
node l1: graph "cluster_level.esn" { sources <- own.result; points <- points; quadrics <- quadrics.result; faces <- faces; frame <- frame.result; level = 1; bits = 31; }
node l2: graph "cluster_level.esn" { sources <- l1.sources; points <- l1.points; quadrics <- l1.quadrics; faces <- l1.faces; frame <- frame.result; level = 2; bits = 30; }
node l3: graph "cluster_level.esn" { sources <- l2.sources; points <- l2.points; quadrics <- l2.quadrics; faces <- l2.faces; frame <- frame.result; level = 3; bits = 29; }
node l4: graph "cluster_level.esn" { sources <- l3.sources; points <- l3.points; quadrics <- l3.quadrics; faces <- l3.faces; frame <- frame.result; level = 4; bits = 28; }
node l5: graph "cluster_level.esn" { sources <- l4.sources; points <- l4.points; quadrics <- l4.quadrics; faces <- l4.faces; frame <- frame.result; level = 5; bits = 27; }
node l6: graph "cluster_level.esn" { sources <- l5.sources; points <- l5.points; quadrics <- l5.quadrics; faces <- l5.faces; frame <- frame.result; level = 6; bits = 26; }
node l7: graph "cluster_level.esn" { sources <- l6.sources; points <- l6.points; quadrics <- l6.quadrics; faces <- l6.faces; frame <- frame.result; level = 7; bits = 25; }

node b0: graph "cluster_brick.esn" { sources <- own.result; points <- points; faces <- faces; frame <- frame.result; level = 0; }
node b1: graph "cluster_brick.esn" { sources <- l1.sources; points <- l1.points; faces <- l1.faces; frame <- frame.result; level = 1; }
node b2: graph "cluster_brick.esn" { sources <- l2.sources; points <- l2.points; faces <- l2.faces; frame <- frame.result; level = 2; }
node b3: graph "cluster_brick.esn" { sources <- l3.sources; points <- l3.points; faces <- l3.faces; frame <- frame.result; level = 3; }
node b4: graph "cluster_brick.esn" { sources <- l4.sources; points <- l4.points; faces <- l4.faces; frame <- frame.result; level = 4; }
node b5: graph "cluster_brick.esn" { sources <- l5.sources; points <- l5.points; faces <- l5.faces; frame <- frame.result; level = 5; }
node b6: graph "cluster_brick.esn" { sources <- l6.sources; points <- l6.points; faces <- l6.faces; frame <- frame.result; level = 6; }
node b7: graph "cluster_brick.esn" { sources <- l7.sources; points <- l7.points; faces <- l7.faces; frame <- frame.result; level = 7; }

node all_points: mesh.cluster_points8@1 { p0 <- points; p1 <- l1.points; p2 <- l2.points; p3 <- l3.points; p4 <- l4.points; p5 <- l5.points; p6 <- l6.points; p7 <- l7.points;
    domain = count(p0) + count(p1) + count(p2) + count(p3) + count(p4) + count(p5) + count(p6) + count(p7); }
node all_up: mesh.cluster_up8@1 { p0 <- points; p1 <- l1.points; p2 <- l2.points; p3 <- l3.points; p4 <- l4.points; p5 <- l5.points; p6 <- l6.points; p7 <- l7.points;
    u0 <- l1.up; u1 <- l2.up; u2 <- l3.up; u3 <- l4.up; u4 <- l5.up; u5 <- l6.up; u6 <- l7.up;
    domain = count(p0) + count(p1) + count(p2) + count(p3) + count(p4) + count(p5) + count(p6) + count(p7); }
node all_faces: mesh.cluster_faces8@1 { p0 <- points; p1 <- l1.points; p2 <- l2.points; p3 <- l3.points; p4 <- l4.points; p5 <- l5.points; p6 <- l6.points;
    f0 <- b0.faces; f1 <- b1.faces; f2 <- b2.faces; f3 <- b3.faces; f4 <- b4.faces; f5 <- b5.faces; f6 <- b6.faces; f7 <- b7.faces;
    domain = count(f0) + count(f1) + count(f2) + count(f3) + count(f4) + count(f5) + count(f6) + count(f7); }
node all_clusters: mesh.cluster_rows8@1 { f0 <- b0.faces; f1 <- b1.faces; f2 <- b2.faces; f3 <- b3.faces; f4 <- b4.faces; f5 <- b5.faces; f6 <- b6.faces;
    c0 <- b0.clusters; c1 <- b1.clusters; c2 <- b2.clusters; c3 <- b3.clusters; c4 <- b4.clusters; c5 <- b5.clusters; c6 <- b6.clusters; c7 <- b7.clusters;
    domain = count(c0) + count(c1) + count(c2) + count(c3) + count(c4) + count(c5) + count(c6) + count(c7); }
node exact: mesh.cluster_exact@1 { points <- points; }
node size0: mesh.cluster_grid_size@1 { frame <- frame.result; level = 0; domain = 1; }
node empty0: mesh.cluster_no_errors@1 { size <- size0.result; domain = value(size); }
node far0: mesh.cluster_point_errors@1 { points <- points; deviation <- exact.result; frame <- frame.result; blank <- empty0.result; level = 0; }
node size1: mesh.cluster_grid_size@1 { frame <- frame.result; level = 1; domain = 1; }
node empty1: mesh.cluster_no_errors@1 { size <- size1.result; domain = value(size); }
node far1: mesh.cluster_point_errors@1 { points <- l1.points; deviation <- l1.deviation_points; frame <- frame.result; blank <- empty1.result; level = 1; }
node none_area1: mesh.cluster_no_areas@1 { size <- size1.result; domain = value(size); }
node area1: mesh.cluster_brick_areas@1 { faces <- l1.faces; points <- l1.points; frame <- frame.result; blank <- none_area1.result; level = 1; }
node whole1: mesh.cluster_brick_areas@1 { faces <- faces; points <- points; frame <- frame.result; blank <- none_area1.result; level = 1; }
node lost1: mesh.cluster_area_errors@1 { far <- far1.result; area <- area1.result; whole <- whole1.result; frame <- frame.result; level = 1; domain = count(far); }
node grid1: mesh.cluster_grid_up@1 { own <- lost1.result; below <- far0.result; frame <- frame.result; level = 1; domain = count(own); }
node size2: mesh.cluster_grid_size@1 { frame <- frame.result; level = 2; domain = 1; }
node empty2: mesh.cluster_no_errors@1 { size <- size2.result; domain = value(size); }
node far2: mesh.cluster_point_errors@1 { points <- l2.points; deviation <- l2.deviation_points; frame <- frame.result; blank <- empty2.result; level = 2; }
node none_area2: mesh.cluster_no_areas@1 { size <- size2.result; domain = value(size); }
node area2: mesh.cluster_brick_areas@1 { faces <- l2.faces; points <- l2.points; frame <- frame.result; blank <- none_area2.result; level = 2; }
node whole2: mesh.cluster_brick_areas@1 { faces <- faces; points <- points; frame <- frame.result; blank <- none_area2.result; level = 2; }
node lost2: mesh.cluster_area_errors@1 { far <- far2.result; area <- area2.result; whole <- whole2.result; frame <- frame.result; level = 2; domain = count(far); }
node grid2: mesh.cluster_grid_up@1 { own <- lost2.result; below <- grid1.result; frame <- frame.result; level = 2; domain = count(own); }
node size3: mesh.cluster_grid_size@1 { frame <- frame.result; level = 3; domain = 1; }
node empty3: mesh.cluster_no_errors@1 { size <- size3.result; domain = value(size); }
node far3: mesh.cluster_point_errors@1 { points <- l3.points; deviation <- l3.deviation_points; frame <- frame.result; blank <- empty3.result; level = 3; }
node none_area3: mesh.cluster_no_areas@1 { size <- size3.result; domain = value(size); }
node area3: mesh.cluster_brick_areas@1 { faces <- l3.faces; points <- l3.points; frame <- frame.result; blank <- none_area3.result; level = 3; }
node whole3: mesh.cluster_brick_areas@1 { faces <- faces; points <- points; frame <- frame.result; blank <- none_area3.result; level = 3; }
node lost3: mesh.cluster_area_errors@1 { far <- far3.result; area <- area3.result; whole <- whole3.result; frame <- frame.result; level = 3; domain = count(far); }
node grid3: mesh.cluster_grid_up@1 { own <- lost3.result; below <- grid2.result; frame <- frame.result; level = 3; domain = count(own); }
node size4: mesh.cluster_grid_size@1 { frame <- frame.result; level = 4; domain = 1; }
node empty4: mesh.cluster_no_errors@1 { size <- size4.result; domain = value(size); }
node far4: mesh.cluster_point_errors@1 { points <- l4.points; deviation <- l4.deviation_points; frame <- frame.result; blank <- empty4.result; level = 4; }
node none_area4: mesh.cluster_no_areas@1 { size <- size4.result; domain = value(size); }
node area4: mesh.cluster_brick_areas@1 { faces <- l4.faces; points <- l4.points; frame <- frame.result; blank <- none_area4.result; level = 4; }
node whole4: mesh.cluster_brick_areas@1 { faces <- faces; points <- points; frame <- frame.result; blank <- none_area4.result; level = 4; }
node lost4: mesh.cluster_area_errors@1 { far <- far4.result; area <- area4.result; whole <- whole4.result; frame <- frame.result; level = 4; domain = count(far); }
node grid4: mesh.cluster_grid_up@1 { own <- lost4.result; below <- grid3.result; frame <- frame.result; level = 4; domain = count(own); }
node size5: mesh.cluster_grid_size@1 { frame <- frame.result; level = 5; domain = 1; }
node empty5: mesh.cluster_no_errors@1 { size <- size5.result; domain = value(size); }
node far5: mesh.cluster_point_errors@1 { points <- l5.points; deviation <- l5.deviation_points; frame <- frame.result; blank <- empty5.result; level = 5; }
node none_area5: mesh.cluster_no_areas@1 { size <- size5.result; domain = value(size); }
node area5: mesh.cluster_brick_areas@1 { faces <- l5.faces; points <- l5.points; frame <- frame.result; blank <- none_area5.result; level = 5; }
node whole5: mesh.cluster_brick_areas@1 { faces <- faces; points <- points; frame <- frame.result; blank <- none_area5.result; level = 5; }
node lost5: mesh.cluster_area_errors@1 { far <- far5.result; area <- area5.result; whole <- whole5.result; frame <- frame.result; level = 5; domain = count(far); }
node grid5: mesh.cluster_grid_up@1 { own <- lost5.result; below <- grid4.result; frame <- frame.result; level = 5; domain = count(own); }
node size6: mesh.cluster_grid_size@1 { frame <- frame.result; level = 6; domain = 1; }
node empty6: mesh.cluster_no_errors@1 { size <- size6.result; domain = value(size); }
node far6: mesh.cluster_point_errors@1 { points <- l6.points; deviation <- l6.deviation_points; frame <- frame.result; blank <- empty6.result; level = 6; }
node none_area6: mesh.cluster_no_areas@1 { size <- size6.result; domain = value(size); }
node area6: mesh.cluster_brick_areas@1 { faces <- l6.faces; points <- l6.points; frame <- frame.result; blank <- none_area6.result; level = 6; }
node whole6: mesh.cluster_brick_areas@1 { faces <- faces; points <- points; frame <- frame.result; blank <- none_area6.result; level = 6; }
node lost6: mesh.cluster_area_errors@1 { far <- far6.result; area <- area6.result; whole <- whole6.result; frame <- frame.result; level = 6; domain = count(far); }
node grid6: mesh.cluster_grid_up@1 { own <- lost6.result; below <- grid5.result; frame <- frame.result; level = 6; domain = count(own); }
node size7: mesh.cluster_grid_size@1 { frame <- frame.result; level = 7; domain = 1; }
node empty7: mesh.cluster_no_errors@1 { size <- size7.result; domain = value(size); }
node far7: mesh.cluster_point_errors@1 { points <- l7.points; deviation <- l7.deviation_points; frame <- frame.result; blank <- empty7.result; level = 7; }
node none_area7: mesh.cluster_no_areas@1 { size <- size7.result; domain = value(size); }
node area7: mesh.cluster_brick_areas@1 { faces <- l7.faces; points <- l7.points; frame <- frame.result; blank <- none_area7.result; level = 7; }
node whole7: mesh.cluster_brick_areas@1 { faces <- faces; points <- points; frame <- frame.result; blank <- none_area7.result; level = 7; }
node lost7: mesh.cluster_area_errors@1 { far <- far7.result; area <- area7.result; whole <- whole7.result; frame <- frame.result; level = 7; domain = count(far); }
node grid7: mesh.cluster_grid_up@1 { own <- lost7.result; below <- grid6.result; frame <- frame.result; level = 7; domain = count(own); }
node most1: mesh.cluster_deviation@1 { deviation <- grid1.result; }
node most2: mesh.cluster_deviation@1 { deviation <- grid2.result; }
node most3: mesh.cluster_deviation@1 { deviation <- grid3.result; }
node most4: mesh.cluster_deviation@1 { deviation <- grid4.result; }
node most5: mesh.cluster_deviation@1 { deviation <- grid5.result; }
node most6: mesh.cluster_deviation@1 { deviation <- grid6.result; }
node most7: mesh.cluster_deviation@1 { deviation <- grid7.result; }
node all_sources: mesh.cluster_sources8@1 { s0 <- b0.sources; s1 <- b1.sources; s2 <- b2.sources; s3 <- b3.sources; s4 <- b4.sources; s5 <- b5.sources; s6 <- b6.sources; s7 <- b7.sources;
    domain = count(s0) + count(s1) + count(s2) + count(s3) + count(s4) + count(s5) + count(s6) + count(s7); }
node all_errors: mesh.cluster_errors8@1 { g0 <- far0.result; g1 <- grid1.result; g2 <- grid2.result; g3 <- grid3.result; g4 <- grid4.result; g5 <- grid5.result; g6 <- grid6.result; g7 <- grid7.result;
    domain = count(g0) + count(g1) + count(g2) + count(g3) + count(g4) + count(g5) + count(g6) + count(g7); }
node mesh: mesh.cluster_mesh@1 { frame <- frame.result; box <- box.result; c0 <- b0.clusters; c1 <- b1.clusters; c2 <- b2.clusters; c3 <- b3.clusters; c4 <- b4.clusters; c5 <- b5.clusters; c6 <- b6.clusters; c7 <- b7.clusters;
    e1 <- most1.result; e2 <- most2.result; e3 <- most3.result; e4 <- most4.result; e5 <- most5.result; e6 <- most6.result; e7 <- most7.result;
    g0 <- far0.result; g1 <- grid1.result; g2 <- grid2.result; g3 <- grid3.result; g4 <- grid4.result; g5 <- grid5.result; g6 <- grid6.result; domain = 1; }

output points <- all_points.result;
output up <- all_up.result;
output faces <- all_faces.result;
output clusters <- all_clusters.result;
output meshes <- mesh.result;
output errors <- all_errors.result;
output sources <- all_sources.result;
