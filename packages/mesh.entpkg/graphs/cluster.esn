//! A mesh built as levels and cut into clusters, every point in one group:
//! `graphs/cluster_grouped.esn`, which says what each output is.
use "../kernels/";

input points: Rows<MeshPoint>;
input faces: Rows<Face>;
param cell: Float = 0.0;

node no_groups: mesh.cluster_no_groups@1 { points <- points; }
node built: graph "cluster_grouped.esn" { points <- points; faces <- faces; groups <- no_groups.result; cell = cell; group_bits = 1; }

output points <- built.points;
output up <- built.up;
output faces <- built.faces;
output clusters <- built.clusters;
output meshes <- built.meshes;
output errors <- built.errors;
output sources <- built.sources;
