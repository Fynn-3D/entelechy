//! Two built meshes (`graphs/cluster.esn`) or libraries as one library,
//! `b`'s after `a`'s.
use "../kernels/";

input a_points: Rows<MeshPoint>;
input a_up: Rows<Int>;
input a_faces: Rows<Face>;
input a_clusters: Rows<Cluster>;
input a_meshes: Rows<ClusterMesh>;
input a_errors: Rows<Float>;
input a_sources: Rows<Int>;
input b_points: Rows<MeshPoint>;
input b_up: Rows<Int>;
input b_faces: Rows<Face>;
input b_clusters: Rows<Cluster>;
input b_meshes: Rows<ClusterMesh>;
input b_errors: Rows<Float>;
input b_sources: Rows<Int>;

node points: mesh.cluster_join_points@1 { a <- a_points; b <- b_points; domain = count(a) + count(b); }
node up: mesh.cluster_join_up@1 { a <- a_up; b <- b_up; domain = count(a) + count(b); }
node faces: mesh.cluster_join_faces@1 { a <- a_faces; b <- b_faces; a_points <- a_points; domain = count(a) + count(b); }
node clusters: mesh.cluster_join_rows@1 { a <- a_clusters; b <- b_clusters; a_faces <- a_faces; domain = count(a) + count(b); }
node meshes: mesh.cluster_join_meshes@1 { a <- a_meshes; b <- b_meshes; a_clusters <- a_clusters; a_errors <- a_errors; domain = count(a) + count(b); }
node sources: mesh.cluster_join_sources@1 { a <- a_sources; b <- b_sources; domain = count(a) + count(b); }
node errors: mesh.cluster_join_errors@1 { a <- a_errors; b <- b_errors; domain = count(a) + count(b); }

output points <- points.result;
output up <- up.result;
output faces <- faces.result;
output clusters <- clusters.result;
output meshes <- meshes.result;
output errors <- errors.result;
output sources <- sources.result;
