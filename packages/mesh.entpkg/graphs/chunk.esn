//! One chunk of a world out of a mesh, for streaming (`kernels/stream.ent`): the mesh cut to the cell `cell_x`, `cell_z`
//! of the world's lattice (`side` meters a side from `lo` on x and z), each face meeting it clipped to its four sides
//! (three points a triangle, as `mesh.chunk_clip` leaves them), so the chunk lies within its cell and meets its
//! neighbours on the planes between them, built as levels and cut into clusters with each point's group (its part,
//! below 128; a point on the cell's edge in a group of its own, `mesh_locked_group`, so chunks built apart meet;
//! `graphs/cluster_grouped.esn`), its level 0's cell `cell` meters (0 for the chunk's mean edge; a world's chunks share
//! one, the whole mesh's, so their levels step alike), and each face's part (`face_parts`); and the same chunk for afar
//! (`far_*`): the clusters it can still draw where it stands in, where `far_error` meters span a pixel, the rest left out
//! (letters on a board keep their fine levels, the bare board its coarse ones; `mesh.far_flags`). Its outputs are the
//! arrays a scene saves (`entelechy run --save`), near or far, and streams back by `fields` nodes, joined by
//! `graphs/streamed.esn`.
use "parallel.entpkg";
use "raster.entpkg";
use "../kernels/";

input points: Rows<MeshPoint>;
input faces: Rows<Face>;
input groups: Rows<Int>;
input face_parts: Rows<Int>;
param lo: Vec2 = vec2(0.0, 0.0);
param side: Float = 16.0;
param cell_x: Int = 0;
param cell_z: Int = 0;
param cell: Float = 0.0;
param far_error: Float = 0.01;

node flags: mesh.chunk_flags@1 { points <- points; faces <- faces; lo = lo; side = side; cell_x = cell_x; cell_z = cell_z; domain = count(faces); }
node kept: graph "parallel.entpkg/graphs/compact.esn" { flags <- flags.result; }
node clipped: mesh.chunk_clip@1 { points <- points; faces <- faces; face_parts <- face_parts; groups <- groups; kept <- kept.indices; count <- kept.count;
    lo = lo; side = side; cell_x = cell_x; cell_z = cell_z; domain = max(value(count), 1) * 5; }
node triangles: graph "parallel.entpkg/graphs/compact.esn" { flags <- clipped.valid; }
node chunk_points: mesh.chunk_points@1 { a <- clipped.a; b <- clipped.b; c <- clipped.c; groups <- clipped.group; kept <- triangles.indices; count <- triangles.count;
    lo = lo; side = side; cell_x = cell_x; cell_z = cell_z; domain = max(value(count), 1) * 3; }
node chunk_faces: mesh.chunk_faces@1 { parts <- clipped.part; kept <- triangles.indices; count <- triangles.count; domain = max(value(count), 1); }
node built: graph "cluster_grouped.esn" { points <- chunk_points.result; faces <- chunk_faces.result; groups <- chunk_points.group; cell = cell; group_bits = 31; }

// The chunk for afar: the clusters it can still draw from where it stands in (their parent bricks further than
// `far_error` from the mesh, or the top level's), their faces laid again, the points those reach up their chains, all
// renumbered; the bricks no finer cluster is kept under made fine enough to draw at any distance.
node far_flags: mesh.far_flags@1 { clusters <- built.clusters; meshes <- built.meshes; errors <- built.errors; far_error = far_error; domain = count(clusters); }
node far_kept: graph "parallel.entpkg/graphs/compact.esn" { flags <- far_flags.result; }
node far_cluster_ranks: parallel.compact_offsets@1 { flags <- far_flags.result; }
node far_counts: mesh.far_cluster_faces@1 { kept <- far_kept.indices; clusters <- built.clusters; count <- far_kept.count; domain = max(value(count), 1); }
node far_runs: graph "parallel.entpkg/graphs/runs.esn" { counts <- far_counts.result; }
node far_unused: mesh.cluster_no_groups@1 { points <- built.points; }
node far_used: mesh.far_point_flags@1 { kept <- far_kept.indices; clusters <- built.clusters; faces <- built.faces; up <- built.up; ends <- far_runs.ends; counts <- far_counts.result;
    blank <- far_unused.result; entries <- far_runs.entries; domain = max(value(entries), 1); }
node far_point_ranks: parallel.compact_offsets@1 { flags <- far_used.result; }
node far_kept_points: graph "parallel.entpkg/graphs/compact.esn" { flags <- far_used.result; }
node far_points: mesh.far_points@1 { points <- built.points; up <- built.up; kept <- far_kept_points.indices; ranks <- far_point_ranks.result; count <- far_kept_points.count;
    domain = max(value(count), 1); }
node far_faces: mesh.far_faces@1 { kept <- far_kept.indices; clusters <- built.clusters; faces <- built.faces; sources <- built.sources; ranks <- far_point_ranks.result;
    ends <- far_runs.ends; counts <- far_counts.result; entries <- far_runs.entries; domain = max(value(entries), 1); }
node far_clusters: mesh.far_clusters@1 { kept <- far_kept.indices; clusters <- built.clusters; ends <- far_runs.ends; counts <- far_counts.result; count <- far_kept.count;
    domain = max(value(count), 1); }
node far_errors: mesh.far_errors@1 { errors <- built.errors; meshes <- built.meshes; far_error = far_error; }
node far_meshes: mesh.far_meshes@1 { meshes <- built.meshes; ranks <- far_cluster_ranks.result; domain = 1; }

output points <- built.points;
output up <- built.up;
output faces <- built.faces;
output clusters <- built.clusters;
output meshes <- built.meshes;
output errors <- built.errors;
output sources <- built.sources;
output parts <- chunk_faces.part;
/// How many triangles the chunk holds (0: nothing to save).
output count <- triangles.count;
output far_points <- far_points.result;
output far_up <- far_points.lifted;
output far_faces <- far_faces.result;
output far_clusters <- far_clusters.result;
output far_meshes <- far_meshes.result;
output far_errors <- far_errors.result;
output far_sources <- far_faces.source;
output far_parts <- chunk_faces.part;
