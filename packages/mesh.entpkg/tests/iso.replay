expect ball.quad_count[0] = 1440
expect ring.point_count[0] = 864
expect ring.quad_count[0] = 864
expect ball_points.result[0] = 0.0032 0.99999 0.0005
expect ball_volume.result[0] = 1.4155 0.001
expect ring_volume.result[0] = 0.4055 0.001
