// A world's chunks streamed and joined (`graphs/streamed.esn`): the four
// near chunks `stream_build.esn` built under `stream/`, each array read by a
// `fields` node, joined into one library. Each joined index must land in the
// array it points into, and each chunk's mesh row say so.
use "raster.entpkg";
use "../kernels/";

/// The four near chunks' files, sixteen bytes each: `n_000_000.field` to `n_001_001.field`.
node paths: kernel {
    requires { field.write; }
    output result: Rows<Int>;
    domain = 64;
    compute {
        let b = element();
        let k = b / 16;
        let c = b % 16;
        let x = k % 2;
        let z = k / 2;
        return if c == 0 { 110 } else if c == 1 || c == 5 { 95 } else if c == 2 || c == 3 || c == 6 || c == 7 { 48 } else if c == 4 { 48 + x } else if c == 8 { 48 + z }
            else if c == 9 { 46 } else if c == 10 { 102 } else if c == 11 { 105 } else if c == 12 { 101 } else if c == 13 { 108 } else if c == 14 { 100 } else { 0 };
    }
}
node points: Rows<MeshPoint> fields "stream/points/" { paths <- paths.result; }
node up: Rows<Int> fields "stream/up/" { paths <- paths.result; }
node faces: Rows<Face> fields "stream/faces/" { paths <- paths.result; }
node clusters: Rows<Cluster> fields "stream/clusters/" { paths <- paths.result; }
node meshes: Rows<ClusterMesh> fields "stream/meshes/" { paths <- paths.result; }
node errors: Rows<Float> fields "stream/errors/" { paths <- paths.result; }
node sources: Rows<Int> fields "stream/sources/" { paths <- paths.result; }
node parts: Rows<Int> fields "stream/parts/" { paths <- paths.result; }
node library: graph "../graphs/streamed.esn" { points <- points.result; point_ranges <- points.ranges; up <- up.result; up_ranges <- up.ranges;
    faces <- faces.result; face_ranges <- faces.ranges; clusters <- clusters.result; cluster_ranges <- clusters.ranges; meshes <- meshes.result; mesh_ranges <- meshes.ranges;
    errors <- errors.result; error_ranges <- errors.ranges; sources <- sources.result; source_ranges <- sources.ranges; part_ranges <- parts.ranges; }
/// The joined library against its arrays: the most a face's corner, an up, a cluster's last face, a mesh's last cluster
/// and brick error and a source reach, each over how many there are (below 1 where all land), and the faces, points,
/// clusters and parts there are.
node held: kernel {
    requires { field.read; field.write; }
    input points: Rows<MeshPoint> <- points.result;
    input up: Rows<Int> <- library.up;
    input faces: Rows<Face> <- library.faces;
    input clusters: Rows<Cluster> <- library.clusters;
    input meshes: Rows<ClusterMesh> <- library.meshes;
    input errors: Rows<Float> <- errors.result;
    input sources: Rows<Int> <- library.sources;
    input parts: Rows<Int> <- parts.result;
    output result: Rows<Float>;
    domain = 10;
    compute {
        let e = element();
        return if e == 0 { float(loop count(faces) with m = 0 { let f = at(faces, index()); max(m, max(f.a, max(f.b, f.c))) }) / float(count(points)) }
            else if e == 1 { float(loop count(up) with m = 0 { max(m, at(up, index())) }) / float(count(points)) }
            else if e == 2 { float(loop count(clusters) with m = 0 { let c = at(clusters, index()); max(m, c.first + c.count - 1) }) / float(count(faces)) }
            else if e == 3 { float(loop count(meshes) with m = 0 { max(m, at(meshes, index()).levels[8] - 1) }) / float(count(clusters)) }
            else if e == 4 { float(loop count(meshes) with m = 0 { max(m, at(meshes, index()).grids[7]) }) / float(count(errors)) }
            else if e == 5 { float(loop count(sources) with m = 0 { max(m, at(sources, index())) }) / float(count(parts)) }
            else if e == 6 { float(count(faces)) } else if e == 7 { float(count(points)) } else if e == 8 { float(count(clusters)) } else { float(count(parts)) };
    }
}

// The joined library's faces at each chunk's finest level, for what bakes the world as it is.
node finest: graph "../graphs/finest.esn" { meshes <- library.meshes; clusters <- library.clusters; faces <- library.faces; sources <- library.sources; }

output result <- held.result;
