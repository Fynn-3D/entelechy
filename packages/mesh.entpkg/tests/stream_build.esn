// The world `stream.esn` (and `light.entpkg`'s `tests/stream.esn`) streams,
// and one chunk of it built (`graphs/chunk.esn`): a ground eight meters a side in four chunks of four
// (33 by 33 points over it), a ball a meter across standing in each chunk's
// middle, the balls a part of their own; `cell_x`, `cell_z` the chunk, its
// far version from the coarsest level within `far_error` meters of it. The chunk files under `stream/`
// are its arrays, saved by
//   entelechy run stream_build.esn --param cell_x=X --param cell_z=Z \
//     --save chunk.points=stream/points/n_00X_00Z.field ... (and chunk.far_points to f_00X_00Z.field, ...)
use "raster.entpkg";
use "../kernels/";

param cell_x: Int = 0;
param cell_z: Int = 0;
param far_error: Float = 0.1;

node ground: mesh.plane_points@1 { size = vec2(8.0, 8.0); columns = 33; rows = 33; domain = 1089; }
node ground_faces: mesh.lattice_faces@1 { columns = 33; rows = 33; domain = 2048; }
node ball: mesh.sphere_points@1 { columns = 17; rows = 9; domain = 153; }
node ball_faces: mesh.lattice_faces@1 { columns = 17; rows = 9; domain = 256; }
/// The ground moved to stand from (0, 0) to (8, 8), then the four balls, each in its chunk's middle half a meter up.
node points: kernel {
    requires { field.read; field.write; }
    input ground: Rows<MeshPoint> <- ground.result;
    input ball: Rows<MeshPoint> <- ball.result;
    output result: Rows<MeshPoint>;
    domain = 1089 + 4 * 153;
    compute {
        let e = element();
        if e < 1089 { let p = at(ground, e); return MeshPoint { ..p, position: p.position + vec3(4.0, 0.0, 4.0) }; }
        let k = (e - 1089) / 153;
        let p = at(ball, (e - 1089) % 153);
        let middle = vec3(float(k % 2) * 4.0 + 2.0, 0.5, float(k / 2) * 4.0 + 2.0);
        return MeshPoint { ..p, position: p.position * 0.5 + middle };
    }
}
node faces: kernel {
    requires { field.read; field.write; }
    input ground: Rows<Face> <- ground_faces.result;
    input ball: Rows<Face> <- ball_faces.result;
    output result: Rows<Face>;
    domain = 2048 + 4 * 256;
    compute {
        let e = element();
        if e < 2048 { return at(ground, e); }
        let k = (e - 2048) / 256;
        let f = at(ball, (e - 2048) % 256);
        let q = 1089 + k * 153;
        return Face { a: f.a + q, b: f.b + q, c: f.c + q };
    }
}
node groups: kernel {
    requires { field.write; }
    output result: Rows<Int>;
    domain = 1089 + 4 * 153;
    compute { return int(element() >= 1089); }
}
node face_parts: kernel {
    requires { field.write; }
    output result: Rows<Int>;
    domain = 2048 + 4 * 256;
    compute { return int(element() >= 2048); }
}
node chunk: graph "../graphs/chunk.esn" { points <- points.result; faces <- faces.result; groups <- groups.result; face_parts <- face_parts.result;
    lo = vec2(0.0, 0.0); side = 4.0; cell_x = cell_x; cell_z = cell_z; far_error = far_error; }

output points <- chunk.points;
output up <- chunk.up;
output faces <- chunk.faces;
output clusters <- chunk.clusters;
output meshes <- chunk.meshes;
output errors <- chunk.errors;
output sources <- chunk.sources;
output parts <- chunk.parts;
output count <- chunk.count;
