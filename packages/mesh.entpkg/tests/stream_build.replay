scene stream_build.esn

# The first chunk: the ground's quarter under it (16 by 16 cells, two faces
# each) and its ball's 256 faces; the ball's faces its part.
frame 0.0
expect chunk.kept.total.result[0] = 768
expect count chunk.chunk_faces.part = 768
expect chunk.chunk_faces.part[0] = 0
expect chunk.chunk_faces.part[767] = 1

# Afar, only the clusters the chunk can still draw where `far_error` spans
# a pixel: 8 of its 17, 634 of its 1564 faces, 1216 points (those the kept
# faces reach, up their chains; a clipped triangle keeps three of its own);
# the points on the cell's edge kept where they are on every level.
expect chunk.far_kept.total.result[0] = 8
expect count chunk.far_faces.result = 634
expect count chunk.far_points.result = 1216

# The last chunk holds as many.
param cell_x 1
param cell_z 1
frame 0.0
expect chunk.kept.total.result[0] = 768

# A cell past the world: no face, the one face kept of a single corner,
# which nothing draws.
param cell_x 5
param cell_z 5
frame 0.0
expect chunk.kept.total.result[0] = 0
expect chunk.chunk_faces.result[0].a = 0
expect chunk.chunk_faces.result[0].b = 0
expect chunk.chunk_faces.result[0].c = 0
