// A plane with a pyramid on it built as levels and cut into clusters, and
// a torus joined after it into one library. The plane's points and the
// pyramid's heights are exact in binary, so every backend merges the same
// points into the same cells. And a board with a patch lying two
// millimeters over it (letters on a board), built with the patch in a group
// of its own and with every point in one.
use "raster.entpkg";
use "../kernels/";

node plane: mesh.plane_points@1 { size = vec2(2.0, 2.0); columns = 65; rows = 65; domain = 4225; }
node pyramid: kernel {
    requires { field.read; field.write; }
    input points: Rows<MeshPoint> <- plane.result;
    output result: Rows<MeshPoint>;
    compute {
        let p = sample(points);
        let h = max(0.5 - max(abs(p.position.x), abs(p.position.z)), 0.0);
        return MeshPoint { ..p, position: vec3(p.position.x, h, p.position.z) };
    }
}
node plane_faces: mesh.lattice_faces@1 { columns = 65; rows = 65; domain = 8192; }
node one_group: mesh.cluster_no_groups@1 { points <- pyramid.result; }
node built: graph "../graphs/cluster_grouped.esn" { points <- pyramid.result; faces <- plane_faces.result; groups <- one_group.result; group_bits = 1; }
node torus: mesh.torus_points@1 { columns = 48; rows = 24; domain = 1152; }
node torus_faces: mesh.lattice_faces@1 { columns = 48; rows = 24; wrap_columns = true; wrap_rows = true; domain = 2304; }
node ring: graph "../graphs/cluster.esn" { points <- torus.result; faces <- torus_faces.result; }
node library: graph "../graphs/library.esn" {
    a_points <- built.points; a_up <- built.up; a_faces <- built.faces; a_clusters <- built.clusters; a_meshes <- built.meshes; a_errors <- built.errors; a_sources <- built.sources;
    b_points <- ring.points; b_up <- ring.up; b_faces <- ring.faces; b_clusters <- ring.clusters; b_meshes <- ring.meshes; b_errors <- ring.errors; b_sources <- ring.sources;
}

// The board: 33 by 33 points over two meters (2048 faces), then the patch's 9 by 9 over half a meter (128 faces), its points
// in group 1.
node board_points: kernel {
    requires { field.write; }
    output result: Rows<MeshPoint>;
    domain = 1170;
    compute {
        let e = element();
        let patch = e >= 1089;
        let k = if patch { e - 1089 } else { e };
        let n = if patch { 9 } else { 33 };
        let side = if patch { 0.5 } else { 2.0 };
        let uv = vec2(float(k % n), float(k / n)) / float(n - 1);
        let xz = (uv - 0.5) * side;
        return MeshPoint { position: vec3(xz.x, if patch { 0.001953125 } else { 0.0 }, xz.y), normal: vec3(0.0, 1.0, 0.0), uv: uv };
    }
}
node board_faces: kernel {
    requires { field.write; }
    output result: Rows<Face>;
    domain = 2176;
    compute {
        let e = element();
        let patch = e >= 2048;
        let k = if patch { e - 2048 } else { e };
        let n = if patch { 9 } else { 33 };
        let base = if patch { 1089 } else { 0 };
        let cell = k / 2;
        let i = cell % (n - 1);
        let j = cell / (n - 1);
        let a = base + j * n + i;
        return if k % 2 == 0 { Face { a: a, b: a + n, c: a + 1 } } else { Face { a: a + 1, b: a + n, c: a + n + 1 } };
    }
}
node board_groups: kernel {
    requires { field.write; }
    output result: Rows<Int>;
    domain = 1170;
    compute { return int(element() >= 1089); }
}
node board: graph "../graphs/cluster_grouped.esn" { points <- board_points.result; faces <- board_faces.result; groups <- board_groups.result; }
node board_one: graph "../graphs/cluster.esn" { points <- board_points.result; faces <- board_faces.result; }
/// How many of level 3's faces came from the patch and still lie over the board.
fn patch_over(clusters: Rows<Cluster>, faces: Rows<Face>, sources: Rows<Int>, points: Rows<MeshPoint>) -> Int {
    return loop count(clusters) with n = 0 {
        let c = at(clusters, index());
        if c.level != 3 { n } else {
            n + loop c.count with m = 0 {
                let i = c.first + index();
                let f = at(faces, i);
                let over = min(at(points, f.a).position.y, min(at(points, f.b).position.y, at(points, f.c).position.y)) > 0.001;
                m + int(at(sources, i) >= 2048 && over)
            }
        }
    };
}
node patch_kept: kernel {
    requires { field.read; field.write; }
    input clusters: Rows<Cluster> <- board.clusters;
    input faces: Rows<Face> <- board.faces;
    input sources: Rows<Int> <- board.sources;
    input points: Rows<MeshPoint> <- board.points;
    output result: Rows<Int>;
    domain = 1;
    compute { return patch_over(clusters, faces, sources, points); }
}
node patch_lost: kernel {
    requires { field.read; field.write; }
    input clusters: Rows<Cluster> <- board_one.clusters;
    input faces: Rows<Face> <- board_one.faces;
    input sources: Rows<Int> <- board_one.sources;
    input points: Rows<MeshPoint> <- board_one.points;
    output result: Rows<Int>;
    domain = 1;
    compute { return patch_over(clusters, faces, sources, points); }
}

output result <- library.meshes;
