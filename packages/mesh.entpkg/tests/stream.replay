scene stream.esn

# Before the files are in, no chunk is ready.
frame 0.0
expect library.ready.result[0] = -1

# A frame later all four are, each its own mesh row; every joined index
# lands in the array it points into, and reaches near its end, as only
# indices moved past the earlier chunks do (each alone would stop near a
# quarter of it).
frame 0.1
expect library.ready.result[0] = 0
expect library.ready.result[3] = 3
expect held.result[0] > 0.95
expect held.result[0] < 1.0
expect held.result[1] > 0.95
expect held.result[1] < 1.0
expect held.result[2] > 0.95
expect held.result[2] < 1.0
expect held.result[3] > 0.95
expect held.result[3] < 1.0
expect held.result[4] > 0.95
expect held.result[4] < 1.0
expect held.result[5] > 0.95
expect held.result[5] < 1.0
expect held.result[9] = 3072
