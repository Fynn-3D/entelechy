// A world streamed in chunks: each chunk a clustered library of its own (`graphs/chunk.esn` builds one from a part of a
// mesh), its arrays saved apart, read back by `fields` nodes in the order a scene names them, each array's chunks one
// after another with their ranges (where each chunk's elements start, how many). `graphs/streamed.esn` joins them into
// one library, each chunk's indices moved past the chunks before it in the array they point into (points, faces,
// clusters, brick errors, and each chunk's own faces for `sources`), and says which chunks are in whole: a chunk with any
// of its arrays still on its way is not drawn.
use "parallel.entpkg";
use "raster.entpkg";
use "lattice.ent";
use "cluster.ent";

/// The chunk whose range in `ranges` holds element `e`, -1 for none.
fn mesh_stream_chunk(ranges: Rows<IVec2>, e: Int) -> Int {
    return loop count(ranges) with k = -1 {
        let r = at(ranges, index());
        if k < 0 && r.x >= 0 && e >= r.x && e < r.x + r.y { index() } else { k }
    };
}

/// Where chunk `k`'s elements start in an array whose ranges are `ranges` (0 for a chunk not in).
fn mesh_stream_start(ranges: Rows<IVec2>, k: Int) -> Int {
    if k < 0 || k >= count(ranges) { return 0; }
    return max(at(ranges, k).x, 0);
}

/// Each point's merged point a level up, moved past the chunks' points before its own.
kernel mesh.stream_up@1 {
    requires { field.read; field.write; }
    input up: Rows<Int>;
    input up_ranges: Rows<IVec2>;
    input point_ranges: Rows<IVec2>;
    output result: Rows<Int>;
    compute {
        let u = sample(up);
        let k = mesh_stream_chunk(up_ranges, element());
        return if u < 0 || k < 0 { u } else { u + mesh_stream_start(point_ranges, k) };
    }
}

/// Each face, its corners moved past the chunks' points before its own.
kernel mesh.stream_faces@1 {
    requires { field.read; field.write; }
    input faces: Rows<Face>;
    input face_ranges: Rows<IVec2>;
    input point_ranges: Rows<IVec2>;
    output result: Rows<Face>;
    compute {
        let g = sample(faces);
        let q = mesh_stream_start(point_ranges, mesh_stream_chunk(face_ranges, element()));
        return Face { a: g.a + q, b: g.b + q, c: g.c + q };
    }
}

/// Each cluster, its faces moved past the chunks' faces before its own.
kernel mesh.stream_clusters@1 {
    requires { field.read; field.write; }
    input clusters: Rows<Cluster>;
    input cluster_ranges: Rows<IVec2>;
    input face_ranges: Rows<IVec2>;
    output result: Rows<Cluster>;
    compute {
        let c = sample(clusters);
        return Cluster { ..c, first: c.first + mesh_stream_start(face_ranges, mesh_stream_chunk(cluster_ranges, element())) };
    }
}

/// Each face's own face, moved past the chunks' own faces before its own (`origin_ranges`: the ranges of an array a row a
/// chunk's own face, as its parts).
kernel mesh.stream_sources@1 {
    requires { field.read; field.write; }
    input sources: Rows<Int>;
    input source_ranges: Rows<IVec2>;
    input origin_ranges: Rows<IVec2>;
    output result: Rows<Int>;
    compute { return sample(sources) + mesh_stream_start(origin_ranges, mesh_stream_chunk(source_ranges, element())); }
}

/// Each chunk's mesh row, its clusters and brick errors moved past the chunks' before its own.
kernel mesh.stream_meshes@1 {
    requires { field.read; field.write; }
    input meshes: Rows<ClusterMesh>;
    input mesh_ranges: Rows<IVec2>;
    input cluster_ranges: Rows<IVec2>;
    input error_ranges: Rows<IVec2>;
    output result: Rows<ClusterMesh>;
    compute {
        let m = sample(meshes);
        let k = mesh_stream_chunk(mesh_ranges, element());
        let q = mesh_stream_start(cluster_ranges, k);
        let r = mesh_stream_start(error_ranges, k);
        return ClusterMesh { ..m, levels: [each 9 { m.levels[index()] + q }], grids: [each 8 { m.grids[index()] + r }] };
    }
}

/// Each chunk named (`domain = count(mesh_ranges)`): its mesh row in the joined meshes, -1 while any of its arrays is
/// still on its way.
kernel mesh.stream_ready@1 {
    requires { field.read; field.write; }
    input point_ranges: Rows<IVec2>;
    input up_ranges: Rows<IVec2>;
    input face_ranges: Rows<IVec2>;
    input cluster_ranges: Rows<IVec2>;
    input mesh_ranges: Rows<IVec2>;
    input error_ranges: Rows<IVec2>;
    input source_ranges: Rows<IVec2>;
    input origin_ranges: Rows<IVec2>;
    output result: Rows<Int>;
    compute {
        let k = element();
        let all = at(point_ranges, k).x >= 0 && at(up_ranges, k).x >= 0 && at(face_ranges, k).x >= 0 && at(cluster_ranges, k).x >= 0
            && at(mesh_ranges, k).x >= 0 && at(error_ranges, k).x >= 0 && at(source_ranges, k).x >= 0 && at(origin_ranges, k).x >= 0;
        return if all && at(mesh_ranges, k).y > 0 { at(mesh_ranges, k).x } else { -1 };
    }
}

// ------------------------------------------------------------------ one chunk out of a mesh

/// The cell of the world's lattice a chunk is: its lower corner on x and z, and its far corner.
fn mesh_chunk_box(lo: Vec2, side: Float, cell_x: Int, cell_z: Int) -> Vec4 {
    let a = lo + vec2(float(cell_x), float(cell_z)) * side;
    return vec4(a.x, a.y, a.x + side, a.y + side);
}

/// 1 for each face of the mesh whose box on x and z meets the chunk's cell (`lo`, `side`, `cell_x`, `cell_z`), 0 for the
/// rest: the faces `mesh.chunk_clip` cuts to the cell.
kernel mesh.chunk_flags@1 {
    requires { field.read; field.write; }
    input points: Rows<MeshPoint>;
    input faces: Rows<Face>;
    param lo: Vec2 = vec2(0.0, 0.0);
    param side: Float = 16.0;
    param cell_x: Int = 0;
    param cell_z: Int = 0;
    output result: Rows<Int>;
    compute {
        let f = sample(faces);
        let a = at(points, f.a).position;
        let b = at(points, f.b).position;
        let c = at(points, f.c).position;
        let box = mesh_chunk_box(lo, side, cell_x, cell_z);
        let l = min(min(a, b), c);
        let h = max(max(a, b), c);
        return int(h.x > box.x && l.x < box.z && h.z > box.y && l.z < box.w);
    }
}

/// A convex polygon of mesh points, at most eight corners, `n` of them.
struct MeshPolygon { p: [MeshPoint; 8]; n: Int; }

/// Point `a` taken `t` of the way to `b`, its normal and uv too.
fn mesh_point_between(a: MeshPoint, b: MeshPoint, t: Float) -> MeshPoint {
    return MeshPoint { position: mix(a.position, b.position, t), normal: normalize(mix(a.normal, b.normal, t) + vec3(0.0, 0.0000001, 0.0)), uv: mix(a.uv, b.uv, t) };
}

/// Polygon `g` with point `q` put after its corners.
fn mesh_polygon_put(g: MeshPolygon, q: MeshPoint) -> MeshPolygon {
    return MeshPolygon { p: [each 8 { if index() == g.n { q } else { g.p[index()] } }], n: min(g.n + 1, 8) };
}

/// Polygon `g`'s part on one side of the plane square to x (`axis` 0) or z (2) at `at`, the side above it (`above`) or
/// below (Sutherland and Hodgman's).
fn mesh_polygon_cut(g: MeshPolygon, axis: Int, at: Float, above: Bool) -> MeshPolygon {
    let none = MeshPolygon { p: g.p, n: 0 };
    return loop 8 with h = none until index() >= g.n {
        let a = g.p[index()];
        let b = g.p[(index() + 1) % max(g.n, 1)];
        let da = (if axis == 0 { a.position.x } else { a.position.z }) - at;
        let db = (if axis == 0 { b.position.x } else { b.position.z }) - at;
        let ina = if above { da >= 0.0 } else { da <= 0.0 };
        let inb = if above { db >= 0.0 } else { db <= 0.0 };
        let kept = if ina { mesh_polygon_put(h, a) } else { h };
        if ina != inb { mesh_polygon_put(kept, mesh_point_between(a, b, da / (da - db))) } else { kept }
    };
}

/// Each kept face cut to the chunk's cell (`domain = count(kept) * 5`, five triangle slots a face: what is left of a
/// triangle cut by four planes has seven corners at most), the slot's triangle of the fan over what is left (`a`, `b`,
/// `c`), whether there is one (`valid`), and the face's part (`part`, from `face_parts`) and its first corner's group.
kernel mesh.chunk_clip@1 {
    requires { field.read; field.write; }
    input points: Rows<MeshPoint>;
    input faces: Rows<Face>;
    input face_parts: Rows<Int>;
    input groups: Rows<Int>;
    input kept: Rows<Int>;
    /// How many faces are kept (sizes the node).
    input count: Rows<Int>;
    param lo: Vec2 = vec2(0.0, 0.0);
    param side: Float = 16.0;
    param cell_x: Int = 0;
    param cell_z: Int = 0;
    output a: Rows<MeshPoint>;
    output b: Rows<MeshPoint>;
    output c: Rows<MeshPoint>;
    output valid: Rows<Int>;
    output part: Rows<Int>;
    output group: Rows<Int>;
    compute {
        let e = element();
        let k = e / 5;
        let t = e % 5;
        let zero = MeshPoint { position: vec3(0.0, 0.0, 0.0), normal: vec3(0.0, 1.0, 0.0), uv: vec2(0.0, 0.0) };
        if k >= at(count, 0) { return { a: zero, b: zero, c: zero, valid: 0, part: 0, group: 0 }; }
        let fi = at(kept, k);
        let f = at(faces, fi);
        let box = mesh_chunk_box(lo, side, cell_x, cell_z);
        let start = MeshPolygon { p: [each 8 { if index() == 0 { at(points, f.a) } else if index() == 1 { at(points, f.b) } else { at(points, f.c) } }], n: 3 };
        let cut = mesh_polygon_cut(mesh_polygon_cut(mesh_polygon_cut(mesh_polygon_cut(start, 0, box.x, true), 0, box.z, false), 2, box.y, true), 2, box.w, false);
        let valid = t + 2 < cut.n;
        return { a: cut.p[0], b: cut.p[min(t + 1, 7)], c: cut.p[min(t + 2, 7)], valid: int(valid), part: at(face_parts, fi), group: at(groups, f.a) };
    }
}

/// The chunk's points (`domain = max(value(count), 1) * 3`, three a kept triangle, `kept` the valid slots' rows), each its
/// group (`group`): a point on the edge of the chunk's cell in a group of its own (`mesh_locked_group`: it merges with
/// nothing and keeps its place on every level, so the chunks round it, built apart, meet it where it is), the rest their
/// face's; a chunk with no triangle keeps one at the origin, of one corner, which nothing draws.
kernel mesh.chunk_points@1 {
    requires { field.read; field.write; }
    input a: Rows<MeshPoint>;
    input b: Rows<MeshPoint>;
    input c: Rows<MeshPoint>;
    input groups: Rows<Int>;
    input kept: Rows<Int>;
    /// How many triangles are kept (sizes the node).
    input count: Rows<Int>;
    param lo: Vec2 = vec2(0.0, 0.0);
    param side: Float = 16.0;
    param cell_x: Int = 0;
    param cell_z: Int = 0;
    output result: Rows<MeshPoint>;
    output group: Rows<Int>;
    compute {
        let e = element();
        if e / 3 >= at(count, 0) { return { result: MeshPoint { position: vec3(0.0, 0.0, 0.0), normal: vec3(0.0, 1.0, 0.0), uv: vec2(0.0, 0.0) }, group: 0 }; }
        let s = at(kept, e / 3);
        let k = e % 3;
        let p = if k == 0 { at(a, s) } else if k == 1 { at(b, s) } else { at(c, s) };
        let box = mesh_chunk_box(lo, side, cell_x, cell_z);
        let edge = side * 0.00001;
        let q = p.position;
        let inside = q.x > box.x + edge && q.x < box.z - edge && q.z > box.y + edge && q.z < box.w - edge;
        let g = at(groups, s);
        return { result: p, group: if inside { g } else { mesh_locked_group(e, g) } };
    }
}

/// The chunk's triangles (`domain = max(value(count), 1)`), three points each, and each one's part.
kernel mesh.chunk_faces@1 {
    requires { field.read; field.write; }
    input parts: Rows<Int>;
    input kept: Rows<Int>;
    /// How many triangles are kept (sizes the node).
    input count: Rows<Int>;
    output result: Rows<Face>;
    output part: Rows<Int>;
    compute {
        let e = element();
        if e >= at(count, 0) { return { result: Face { a: 0, b: 0, c: 0 }, part: 0 }; }
        return { result: Face { a: e * 3, b: e * 3 + 1, c: e * 3 + 2 }, part: at(parts, at(kept, e)) };
    }
}

// ------------------------------------------------------------------ a chunk for afar

/// 1 for each cluster a chunk seen from afar still draws: one of the top level, or one whose parent brick lies further
/// than `far_error` meters from the mesh. A cluster is drawn only where its parent is not fine enough, and from as far as
/// the far chunk stands in, `far_error` spans a pixel, so a cluster whose parent lies nearer than that is never drawn
/// there: letters on a board keep their fine levels, the bare board about them only its coarse ones.
kernel mesh.far_flags@1 {
    requires { field.read; field.write; }
    input clusters: Rows<Cluster>;
    input meshes: Rows<ClusterMesh>;
    input errors: Rows<Float>;
    param far_error: Float = 0.01;
    output result: Rows<Int>;
    compute {
        let c = sample(clusters);
        let m = at(meshes, 0);
        if c.parent.w < 0.0 || c.level >= mesh_cluster_levels() - 1 { return 1; }
        return int(mesh_brick_error(m, errors, mesh_brick_at(m, c.parent), c.level + 1) > far_error);
    }
}

/// How many faces each kept cluster holds (`domain = count(kept)`, `kept` the kept clusters' rows).
kernel mesh.far_cluster_faces@1 {
    requires { field.read; field.write; }
    input kept: Rows<Int>;
    input clusters: Rows<Cluster>;
    /// How many clusters are kept (sizes the node).
    input count: Rows<Int>;
    output result: Rows<Int>;
    compute { return if element() < at(count, 0) { at(clusters, at(kept, element())).count } else { 0 }; }
}

/// 1 for each point a kept face reaches (`domain = value(entries)`, the kept faces laid by `ends`): its corners and every
/// point up their chains (a corner is drawn lifted to the levels above), into `blank`, the points'.
kernel mesh.far_point_flags@1 {
    requires { field.read; field.write; }
    input kept: Rows<Int>;
    input clusters: Rows<Cluster>;
    input faces: Rows<Face>;
    input up: Rows<Int>;
    input ends: Rows<Int>;
    input counts: Rows<Int>;
    input blank: Rows<Int>;
    /// How many faces are kept (sizes the node).
    input entries: Rows<Int>;
    output result: Rows<Int>;
    struct Mark { point: Int; used: Int; }
    scatter over kept into blank with max {
        let e = element();
        if e >= at(ends, count(ends) - 1) { return Mark { point: -1, used: 0 }; }
        let k = owner(e, ends);
        let c = at(clusters, at(kept, k));
        let f = at(faces, c.first + e - (at(ends, k) - at(counts, k)));
        let walked = loop 3 with z = 0 {
            let v = if index() == 0 { f.a } else if index() == 1 { f.b } else { f.c };
            let n = loop mesh_cluster_levels() with u = v until u < 0 { emit(Mark { point: u, used: 1 }); at(up, u) };
            z + int(n < 0)
        };
        return Mark { point: -1, used: walked * 0 };
    }
}

/// The far library's points and ups (`domain = value(count)`, the kept points' rows `kept`), each up renumbered among them
/// (`ranks`, an inclusive count of the points kept).
kernel mesh.far_points@1 {
    requires { field.read; field.write; }
    input points: Rows<MeshPoint>;
    input up: Rows<Int>;
    input kept: Rows<Int>;
    input ranks: Rows<Int>;
    /// How many points are kept (sizes the node).
    input count: Rows<Int>;
    output result: Rows<MeshPoint>;
    output lifted: Rows<Int>;
    compute {
        let p = at(kept, element());
        let u = at(up, p);
        return { result: at(points, p), lifted: if u < 0 { u } else { at(ranks, u) - 1 } };
    }
}

/// The far library's faces and their sources (`domain = value(entries)`, the kept clusters' faces laid by `ends`), their
/// corners renumbered among the points kept.
kernel mesh.far_faces@1 {
    requires { field.read; field.write; }
    input kept: Rows<Int>;
    input clusters: Rows<Cluster>;
    input faces: Rows<Face>;
    input sources: Rows<Int>;
    input ranks: Rows<Int>;
    input ends: Rows<Int>;
    input counts: Rows<Int>;
    /// How many faces are kept (sizes the node).
    input entries: Rows<Int>;
    output result: Rows<Face>;
    output source: Rows<Int>;
    compute {
        let e = element();
        if e >= at(ends, count(ends) - 1) { return { result: Face { a: 0, b: 0, c: 0 }, source: 0 }; }
        let k = owner(e, ends);
        let c = at(clusters, at(kept, k));
        let i = c.first + e - (at(ends, k) - at(counts, k));
        let f = at(faces, i);
        return { result: Face { a: at(ranks, f.a) - 1, b: at(ranks, f.b) - 1, c: at(ranks, f.c) - 1 }, source: at(sources, i) };
    }
}

/// The far library's clusters (`domain = value(count)`), each its faces where they now begin.
kernel mesh.far_clusters@1 {
    requires { field.read; field.write; }
    input kept: Rows<Int>;
    input clusters: Rows<Cluster>;
    input ends: Rows<Int>;
    input counts: Rows<Int>;
    /// How many clusters are kept (sizes the node).
    input count: Rows<Int>;
    output result: Rows<Cluster>;
    compute { let k = element(); return Cluster { ..at(clusters, at(kept, k)), first: at(ends, k) - at(counts, k) }; }
}

/// The far library's brick errors: a brick no finer cluster is kept under (its error within `far_error`) none, so it is
/// drawn where it is however near the eye comes before the near chunk is in; the rest as they were.
kernel mesh.far_errors@1 {
    requires { field.read; field.write; }
    input errors: Rows<Float>;
    input meshes: Rows<ClusterMesh>;
    param far_error: Float = 0.01;
    output result: Rows<Float>;
    compute {
        let e = sample(errors);
        let m = at(meshes, 0);
        let level = loop mesh_cluster_levels() with k = 0 { if element() >= m.grids[index()] { index() } else { k } };
        return if level >= 1 && e >= 0.0 && e <= far_error { 0.0 } else { e };
    }
}

/// The far library's mesh row: where each level's kept clusters begin (`ranks`, an inclusive count of the clusters kept,
/// which stay in their levels' order).
kernel mesh.far_meshes@1 {
    requires { field.read; field.write; }
    input meshes: Rows<ClusterMesh>;
    input ranks: Rows<Int>;
    output result: Rows<ClusterMesh>;
    compute {
        let m = sample(meshes);
        return ClusterMesh { ..m, levels: [each 9 { if m.levels[index()] == 0 { 0 } else { at(ranks, m.levels[index()] - 1) } }] };
    }
}

// ------------------------------------------------------------------ the finest faces of a library

/// How many faces each mesh of a library holds at its finest level (`domain = count(meshes)`): a run of its faces, the
/// faces of its finest level's clusters lying one after another (a face in the cluster of each brick its corners lie in,
/// so some more than once).
kernel mesh.finest_counts@1 {
    requires { field.read; field.write; }
    input meshes: Rows<ClusterMesh>;
    input clusters: Rows<Cluster>;
    output result: Rows<Int>;
    compute {
        let m = sample(meshes);
        let k = mesh_cluster_first(m);
        let c0 = m.levels[k];
        let c1 = m.levels[k + 1];
        if c1 <= c0 || c1 > count(clusters) { return 0; }
        let last = at(clusters, c1 - 1);
        return last.first + last.count - at(clusters, c0).first;
    }
}

/// The library's faces at each mesh's finest level, and the face each came from (`domain = value(entries)`, laid by
/// `ends` over `counts`): for what is baked or traced from the mesh as it is, not from its coarser levels.
kernel mesh.finest_faces@1 {
    requires { field.read; field.write; }
    input meshes: Rows<ClusterMesh>;
    input clusters: Rows<Cluster>;
    input faces: Rows<Face>;
    input sources: Rows<Int>;
    input counts: Rows<Int>;
    input ends: Rows<Int>;
    /// How many faces (sizes the node).
    input entries: Rows<Int>;
    output result: Rows<Face>;
    output source: Rows<Int>;
    compute {
        let e = element();
        if e >= at(ends, count(ends) - 1) { return { result: Face { a: 0, b: 0, c: 0 }, source: 0 }; }
        let k = owner(e, ends);
        let m = at(meshes, k);
        let i = at(clusters, m.levels[mesh_cluster_first(m)]).first + e - (at(ends, k) - at(counts, k));
        return { result: at(faces, i), source: at(sources, i) };
    }
}
