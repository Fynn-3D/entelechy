// Clusters: a mesh as levels, each coarser than the one before, cut into
// clusters that a renderer draws each at the level its size on the screen
// asks for, as Nanite does.
//
// Level 0 is the mesh. Level k + 1 is level k's points merged cell by cell
// on a lattice of cells twice as wide (vertex clustering): each cell's
// points become one, placed where the planes of the faces round them meet
// nearest (their error quadrics summed, Garland and Heckbert's) and kept
// inside the cell; a face two of whose corners merge is gone. Each level
// is cut on its lattice into bricks of `mesh_brick_cells()` cells a side,
// a brick's faces a cluster (or several, at most `mesh_cluster_faces()`
// each).
//
// The lattices nest: a cell of level k + 1 holds eight of level k, a
// brick eight bricks, and a merged point lies in its cell. So `up` follows
// a point up the levels, and a cluster knows the brick holding its own a
// level up: a renderer draws a cluster where its own cells are fine enough
// and its parent's are not, which picks one level for every place of the
// mesh, and moves a finer cluster's corners that lie where a coarser level
// is drawn up to that level's points, so the two meet.
//
// `graphs/cluster.esn` builds a mesh's levels and clusters,
// `graphs/library.esn` joins two built meshes into one library.
use "raster.entpkg";
use "lattice.ent";

/// How many levels a mesh is built in, finest first.
fn mesh_cluster_levels() -> Int { return 8; }
/// A brick's side, in cells of its level.
fn mesh_brick_cells() -> Int { return 8; }
/// The most faces a cluster holds.
fn mesh_cluster_faces() -> Int { return 128; }

/// A mesh's box.
struct MeshBox { lo: Vec3; hi: Vec3; }

/// Where a mesh's lattices lie: their lower corner, level 0's cell (level
/// k's is `cell` times 2 to the k), and how many bits each axis of a level
/// 1 cell's index takes (a key packs the three, in at most 28 bits, so a
/// level 0 brick's index takes at most 22).
struct ClusterFrame { lo: Vec3; cell: Float; bits: IVec3; }
type ClusterFrames = Rows<ClusterFrame>;

/// A point's error quadric (Garland and Heckbert's): the planes of the
/// faces round it, each by its area, as ten numbers, xx xy xz yy, yz zz xw
/// yw, zw ww, in meters from its frame's corner, and the areas summed.
struct ErrorQuadric { a: Vec4; b: Vec4; c: Vec3; }

/// A cluster: its faces (`count` of them from `first`), its level, the
/// brick it was cut from (lower corner, side) and the brick a level up
/// holding that one (its side below 0 at the top level), and the sphere
/// its faces lie in.
struct Cluster { first: Int; count: Int; level: Int; brick: Vec4; parent: Vec4; sphere: Vec4; }

/// A built mesh in a library: its frame (`lo`, `cell`, `bits`), the
/// sphere it lies in, where each level's clusters begin in the library's
/// clusters (the ninth where the mesh's end), how far each level lies from
/// the mesh at most (none at level 0, never less than the level below's),
/// and where each level's brick errors begin in the library's errors: a
/// grid of every brick its index can name (`mesh_brick_widths`), each the
/// farthest its level lies from the mesh in it (never nearer than the
/// bricks below it), -1 where it holds nothing.
struct ClusterMesh { lo: Vec3; cell: Float; bits: IVec3; sphere: Vec4; levels: [Int; 9]; errors: [Float; 8]; grids: [Int; 8]; }

/// Level `level`'s cell width.
fn mesh_cluster_cell(f: ClusterFrame, level: Int) -> Float { return f.cell * exp2(float(level)); }

/// The cell of level `level` that `p` falls in.
fn mesh_cluster_coords(f: ClusterFrame, p: Vec3, level: Int) -> IVec3 {
    let c = floor(max(p - f.lo, vec3(0.0, 0.0, 0.0)) / mesh_cluster_cell(f, level));
    return ivec3(int(c.x), int(c.y), int(c.z));
}

/// How many bits each axis of a level's cell index takes.
fn mesh_cluster_widths(f: ClusterFrame, level: Int) -> IVec3 {
    return max(f.bits + 1 - level, 0);
}

/// How many bits each axis of a level's brick index takes.
fn mesh_brick_widths(bits: IVec3, level: Int) -> IVec3 {
    return max(bits + 1 - level - 3, 0);
}

/// A key's three coordinates, `w` bits each (`mesh_cluster_pack`'s).
fn mesh_cluster_unpack(k: Int, w: IVec3) -> IVec3 {
    return ivec3(k >>> (w.y + w.z), (k >>> w.z) & ((1 << w.y) - 1), k & ((1 << w.z) - 1));
}

/// Three coordinates packed in one key, `w` bits each.
fn mesh_cluster_pack(c: IVec3, w: IVec3) -> Int {
    let k = clamp(c, ivec3(0, 0, 0), (ivec3(1, 1, 1) << w) - 1);
    return (k.x << (w.y + w.z)) | (k.y << w.z) | k.z;
}

/// The quadric of the plane through `p` square to `n`, by `w`.
fn mesh_plane_quadric(n: Vec3, p: Vec3, w: Float) -> ErrorQuadric {
    let d = 0.0 - dot(n, p);
    return ErrorQuadric {
        a: vec4(n.x * n.x, n.x * n.y, n.x * n.z, n.y * n.y) * w,
        b: vec4(n.y * n.z, n.z * n.z, n.x * d, n.y * d) * w,
        c: vec3(n.z * d * w, d * d * w, w)
    };
}

fn mesh_quadric_sum(a: ErrorQuadric, b: ErrorQuadric) -> ErrorQuadric {
    return ErrorQuadric { a: a.a + b.a, b: a.b + b.b, c: a.c + b.c };
}

fn mesh_no_quadric() -> ErrorQuadric {
    return ErrorQuadric { a: vec4(0.0, 0.0, 0.0, 0.0), b: vec4(0.0, 0.0, 0.0, 0.0), c: vec3(0.0, 0.0, 0.0) };
}

/// How far `x` lies from the planes `q` keeps: the root of their squared
/// distances' mean by area.
fn mesh_quadric_distance(q: ErrorQuadric, x: Vec3) -> Float {
    let ax = vec3(q.a.x * x.x + q.a.y * x.y + q.a.z * x.z, q.a.y * x.x + q.a.w * x.y + q.b.x * x.z, q.a.z * x.x + q.b.x * x.y + q.b.y * x.z);
    let e = dot(x, ax) + 2.0 * (q.b.z * x.x + q.b.w * x.y + q.c.x * x.z) + q.c.y;
    return sqrt(max(e, 0.0) / max(q.c.z, 0.000000000001));
}

/// The point the planes of `q` are nearest together at, drawn a little
/// toward `mean` so that planes all alike (a flat or a ridge) still give
/// one, and kept inside the cell from `lo`, `side` wide.
fn mesh_quadric_point(q: ErrorQuadric, mean: Vec3, lo: Vec3, side: Float) -> Vec3 {
    let pull = 0.001 * (q.a.x + q.a.w + q.b.y) + 0.000000000001;
    let m = mat3(vec3(q.a.x + pull, q.a.y, q.a.z), vec3(q.a.y, q.a.w + pull, q.b.x), vec3(q.a.z, q.b.x, q.b.y + pull));
    let x = inverse(m) * (vec3(0.0 - q.b.z, 0.0 - q.b.w, 0.0 - q.c.x) + mean * pull);
    let ok = !(isnan(x.x) || isnan(x.y) || isnan(x.z) || isinf(x.x) || isinf(x.y) || isinf(x.z));
    return clamp(if ok { x } else { mean }, lo, lo + side);
}

// ------------------------------------------------------------------ the frame

/// The box the points lie in.
kernel mesh.cluster_box@1 {
    requires { field.read; field.write; }
    input points: Rows<MeshPoint>;
    output result: Rows<MeshBox>;
    compute { let p = sample(points).position; return MeshBox { lo: p, hi: p }; }
    merge(a, b) { return MeshBox { lo: min(a.lo, b.lo), hi: max(a.hi, b.hi) }; }
}

/// The faces' edges: their lengths summed and how many.
kernel mesh.cluster_edges@1 {
    requires { field.read; field.write; }
    input faces: Rows<Face>;
    input points: Rows<MeshPoint>;
    output result: Rows<Vec2>;
    compute {
        let f = sample(faces);
        let a = at(points, f.a).position;
        let b = at(points, f.b).position;
        let c = at(points, f.c).position;
        return vec2(length(b - a) + length(c - b) + length(a - c), 3.0);
    }
    merge(a, b) { return a + b; }
}

/// The mesh's frame: level 0's cell `cell` meters, or (0) its edges'
/// mean length, widened until a level 1 cell's index fits a key.
kernel mesh.cluster_frame@1 {
    requires { field.read; field.write; }
    input box: Rows<MeshBox>;
    input edges: Rows<Vec2>;
    param cell: Float = 0.0;
    output result: ClusterFrames;
    compute {
        let b = at(box, 0);
        let e = at(edges, 0);
        let span = max(b.hi - b.lo, vec3(0.000001, 0.000001, 0.000001));
        let widest = max(span.x, max(span.y, span.z));
        let first = max(if cell > 0.0 { cell } else { e.x / max(e.y, 1.0) }, widest / 65536.0);
        let found = loop 32 with c = vec4(first, 0.0, 0.0, 0.0) {
            let n = span / (c.x * 2.0);
            let bits = vec3(ceil(log2(floor(n.x) + 1.0)), ceil(log2(floor(n.y) + 1.0)), ceil(log2(floor(n.z) + 1.0)));
            if c.y > 0.0 { c } else if bits.x + bits.y + bits.z <= 28.0 { vec4(c.x, 1.0, 0.0, 0.0) } else { vec4(c.x * 2.0, 0.0, 0.0, 0.0) }
        };
        let n = span / (found.x * 2.0);
        let bits = ivec3(int(ceil(log2(floor(n.x) + 1.0))), int(ceil(log2(floor(n.y) + 1.0))), int(ceil(log2(floor(n.z) + 1.0))));
        return ClusterFrame { lo: b.lo, cell: found.x, bits: bits };
    }
}

// ------------------------------------------------------------------ level 0's quadrics

/// Every point's quadric, none yet (the target a scatter sums into).
kernel mesh.cluster_no_quadrics@1 {
    requires { field.read; field.write; }
    input points: Rows<MeshPoint>;
    output result: Rows<ErrorQuadric>;
    compute { return mesh_no_quadric(); }
}

/// Each face's plane, by its area, summed into its three corners'
/// quadrics (`domain = count(faces) * 3`).
kernel mesh.cluster_face_quadrics@1 {
    requires { field.read; field.write; }
    input faces: Rows<Face>;
    input points: Rows<MeshPoint>;
    input frame: ClusterFrames;
    input blank: Rows<ErrorQuadric>;
    output result: Rows<ErrorQuadric>;
    struct Planes { point: Int; quadric: ErrorQuadric; }
    scatter into blank with sum {
        let f = at(faces, element() / 3);
        let lo = at(frame, 0).lo;
        let a = at(points, f.a).position - lo;
        let b = at(points, f.b).position - lo;
        let c = at(points, f.c).position - lo;
        let cr = cross(b - a, c - a);
        let area = length(cr) * 0.5;
        let k = element() % 3;
        let point = if area <= 0.0 { -1 } else if k == 0 { f.a } else if k == 1 { f.b } else { f.c };
        return Planes { point: point, quadric: mesh_plane_quadric(cr / max(area * 2.0, 0.000000000001), a, area) };
    }
}

// ------------------------------------------------------------------ a level up

/// Each point's key: the cell of level `level` it falls in.
kernel mesh.cluster_keys@1 {
    requires { field.read; field.write; }
    input points: Rows<MeshPoint>;
    input frame: ClusterFrames;
    param level: Int = 1;
    output result: Rows<Int>;
    compute {
        let f = at(frame, 0);
        return mesh_cluster_pack(mesh_cluster_coords(f, sample(points).position, level), mesh_cluster_widths(f, level));
    }
}

/// 1 where a run of equal keys begins, in sorted order (over `order`).
kernel mesh.cluster_heads@1 {
    requires { field.read; field.write; }
    input order: Rows<Int>;
    input keys: Rows<Int>;
    output result: Rows<Int>;
    compute {
        let j = element();
        return if j == 0 { 1 } else { int(at(keys, at(order, j)) != at(keys, at(order, j - 1))) };
    }
}

/// Where each run begins in sorted order: the run's rank (`ranks`, an
/// inclusive count of `heads`) says which slot.
kernel mesh.cluster_starts@1 {
    requires { field.read; field.write; }
    input heads: Rows<Int>;
    input ranks: Rows<Int>;
    input slots: Rows<Int>;
    output result: Rows<Int>;
    struct Start { slot: Int; first: Int; }
    scatter into slots with max {
        let j = element();
        return Start { slot: if at(heads, j) != 0 { at(ranks, j) - 1 } else { -1 }, first: j };
    }
}

/// Each cell's points as one point (`domain = count(starts)`): where the
/// planes round them meet nearest, inside the cell of level `level`; their
/// normals and coordinates averaged, their quadrics summed; and how far it
/// lies from those planes.
kernel mesh.cluster_merge@1 {
    requires { field.read; field.write; }
    input points: Rows<MeshPoint>;
    input quadrics: Rows<ErrorQuadric>;
    input order: Rows<Int>;
    input starts: Rows<Int>;
    input frame: ClusterFrames;
    param level: Int = 1;
    output point: Rows<MeshPoint>;
    output quadric: Rows<ErrorQuadric>;
    output deviation: Rows<Float>;
    compute {
        let c = element();
        let f = at(frame, 0);
        let from = at(starts, c);
        let to = if c + 1 < count(starts) { at(starts, c + 1) } else { count(order) };
        let n = to - from;
        let sum = loop n with s = [vec4(0.0, 0.0, 0.0, 0.0), vec4(0.0, 0.0, 0.0, 0.0)] {
            let p = at(points, at(order, from + index()));
            [s[0] + vec4(p.position - f.lo, p.uv.x), s[1] + vec4(p.normal, p.uv.y)]
        };
        let q = loop n with s = mesh_no_quadric() { mesh_quadric_sum(s, at(quadrics, at(order, from + index()))) };
        let first = at(points, at(order, from)).position;
        let side = mesh_cluster_cell(f, level);
        let cell = mesh_cluster_coords(f, first, level);
        let lo = float(cell) * side;
        let mean = sum[0].xyz / float(max(n, 1));
        let x = mesh_quadric_point(q, mean, lo, side);
        let nl = length(sum[1].xyz);
        let normal = if nl > 0.0 { sum[1].xyz / nl } else { vec3(0.0, 1.0, 0.0) };
        let uv = vec2(sum[0].w, sum[1].w) / float(max(n, 1));
        return { point: MeshPoint { position: x + f.lo, normal: normal, uv: uv }, quadric: q, deviation: mesh_quadric_distance(q, x) };
    }
}

/// Each point's merged point a level up: its run's rank.
kernel mesh.cluster_up@1 {
    requires { field.read; field.write; }
    input order: Rows<Int>;
    input ranks: Rows<Int>;
    input slots: Rows<Int>;
    output result: Rows<Int>;
    struct Up { point: Int; up: Int; }
    scatter into slots with max {
        let j = element();
        return Up { point: at(order, j), up: at(ranks, j) - 1 };
    }
}

/// The greatest of a row of deviations: how far a level lies from the
/// mesh at most, its points' or its bricks'.
kernel mesh.cluster_deviation@1 {
    requires { field.read; field.write; }
    input deviation: Rows<Float>;
    output result: Rows<Float>;
    compute { return sample(deviation); }
    merge(a, b) { return max(a, b); }
}

/// A face a level up: its corners' merged points.
fn mesh_face_up(f: Face, up: Rows<Int>) -> Face {
    return Face { a: at(up, f.a), b: at(up, f.b), c: at(up, f.c) };
}

/// 1 for a face whose corners stay apart a level up.
kernel mesh.cluster_face_flags@1 {
    requires { field.read; field.write; }
    input faces: Rows<Face>;
    input up: Rows<Int>;
    output result: Rows<Int>;
    compute {
        let g = mesh_face_up(sample(faces), up);
        return int(g.a != g.b && g.b != g.c && g.a != g.c);
    }
}

/// The faces kept a level up (`domain = max(value(count), 1)`), and the
/// mesh's own face each came from (`source`, as `sources` has it for the
/// level below); where none is kept, one with no area, from face 0.
kernel mesh.cluster_faces_up@1 {
    requires { field.read; field.write; }
    input faces: Rows<Face>;
    input sources: Rows<Int>;
    input up: Rows<Int>;
    input kept: Rows<Int>;
    /// How many are kept (sizes the node).
    input count: Rows<Int>;
    output result: Rows<Face>;
    output source: Rows<Int>;
    compute {
        let i = at(kept, element());
        return if i < 0 { { result: Face { a: 0, b: 0, c: 0 }, source: 0 } } else { { result: mesh_face_up(at(faces, i), up), source: at(sources, i) } };
    }
}

/// Each of the mesh's own faces its own number: level 0's sources.
kernel mesh.cluster_own_faces@1 {
    requires { field.read; field.write; }
    input faces: Rows<Face>;
    output result: Rows<Int>;
    compute { return element(); }
}

// ------------------------------------------------------------------ a level's clusters

/// The brick of level `level` a point lies in.
fn mesh_cluster_brick(f: ClusterFrame, p: Vec3, level: Int) -> IVec3 {
    return mesh_cluster_coords(f, p, level) >> 3;
}

/// Corner `k` of face `g`.
fn mesh_face_corner(g: Face, k: Int) -> Int {
    return if k == 0 { g.a } else if k == 1 { g.b } else { g.c };
}

/// Each face's corners' bricks of level `level` (`domain = count(faces) * 3`): a face is in the cluster of every brick a
/// corner of it lies in, so where two levels are drawn side by side every face touching a brick drawn at its level is there.
/// `key` is the brick's, `flag` 1 for a corner whose brick no corner before it lies in.
kernel mesh.cluster_corner_bricks@1 {
    requires { field.read; field.write; }
    input faces: Rows<Face>;
    input points: Rows<MeshPoint>;
    input frame: ClusterFrames;
    param level: Int = 0;
    output key: Rows<Int>;
    output flag: Rows<Int>;
    compute {
        let f = at(frame, 0);
        let g = at(faces, element() / 3);
        let k = element() % 3;
        let mine = mesh_cluster_brick(f, at(points, mesh_face_corner(g, k)).position, level);
        let ba = mesh_cluster_brick(f, at(points, g.a).position, level);
        let bb = mesh_cluster_brick(f, at(points, g.b).position, level);
        let first = k == 0 || (k == 1 && mine != ba) || (k == 2 && mine != ba && mine != bb);
        return { key: mesh_cluster_pack(mine, max(mesh_cluster_widths(f, level) - 3, 0)), flag: int(first) };
    }
}

/// The kept corners' keys (`domain = max(value(count), 1)`).
kernel mesh.cluster_entry_keys@1 {
    requires { field.read; field.write; }
    input keys: Rows<Int>;
    input entries: Rows<Int>;
    /// How many corners are kept (sizes the node).
    input count: Rows<Int>;
    output result: Rows<Int>;
    compute { let e = at(entries, element()); return if e < 0 { 0 } else { at(keys, e) }; }
}

/// Where each face's run of one brick begins, in sorted order (a prefix
/// of the greatest start so far).
kernel mesh.cluster_run_starts@1 {
    requires { field.read; field.write; }
    input order: Rows<Int>;
    input keys: Rows<Int>;
    output result: Rows<Int>;
    prefix with max {
        let j = element();
        return if j == 0 || at(keys, at(order, j)) != at(keys, at(order, j - 1)) { j } else { 0 };
    }
}

/// 1 where a cluster begins in sorted order: a brick's first face, and
/// every `mesh_cluster_faces()` after it.
kernel mesh.cluster_chunk_heads@1 {
    requires { field.read; field.write; }
    input runs: Rows<Int>;
    output result: Rows<Int>;
    compute { return int((element() - sample(runs)) % mesh_cluster_faces() == 0); }
}

/// The faces of the kept corners in sorted order, and the mesh's own face
/// each came from (`source`).
kernel mesh.cluster_sorted_faces@1 {
    requires { field.read; field.write; }
    input faces: Rows<Face>;
    input sources: Rows<Int>;
    input entries: Rows<Int>;
    input order: Rows<Int>;
    output result: Rows<Face>;
    output source: Rows<Int>;
    compute {
        let f = max(at(entries, at(order, element())), 0) / 3;
        return { result: at(faces, f), source: at(sources, f) };
    }
}

/// Each cluster of level `level` (`domain = count(starts)`): its faces in
/// the sorted faces, its brick (the one its first kept corner lies in,
/// `source` the level's faces) and its parent's, and its sphere.
kernel mesh.cluster_rows@1 {
    requires { field.read; field.write; }
    input faces: Rows<Face>;
    input points: Rows<MeshPoint>;
    input starts: Rows<Int>;
    input entries: Rows<Int>;
    input order: Rows<Int>;
    input source: Rows<Face>;
    input frame: ClusterFrames;
    param level: Int = 0;
    output result: Rows<Cluster>;
    compute {
        let c = element();
        let f = at(frame, 0);
        let first = at(starts, c);
        let n = (if c + 1 < count(starts) { at(starts, c + 1) } else { count(faces) }) - first;
        let side = mesh_cluster_cell(f, level) * float(mesh_brick_cells());
        let e = max(at(entries, at(order, first)), 0);
        let brick = mesh_cluster_brick(f, at(points, mesh_face_corner(at(source, e / 3), e % 3)).position, level);
        let top = level + 1 >= mesh_cluster_levels();
        let parent = brick >> 1;
        let box = loop n * 3 with b = [vec3(1e30, 1e30, 1e30), vec3(-1e30, -1e30, -1e30)] {
            let g = at(faces, first + index() / 3);
            let k = index() % 3;
            let p = at(points, if k == 0 { g.a } else if k == 1 { g.b } else { g.c }).position;
            [min(b[0], p), max(b[1], p)]
        };
        let mid = (box[0] + box[1]) * 0.5;
        let reach = loop n * 3 with r = 0.0 {
            let g = at(faces, first + index() / 3);
            let k = index() % 3;
            max(r, length(at(points, if k == 0 { g.a } else if k == 1 { g.b } else { g.c }).position - mid))
        };
        return Cluster {
            first: first, count: n, level: level,
            brick: vec4(f.lo + float(brick) * side, side),
            parent: if top { vec4(f.lo, -1.0) } else { vec4(f.lo + float(parent) * side * 2.0, side * 2.0) },
            sphere: vec4(mid, reach)
        };
    }
}

// ------------------------------------------------------------------ the bricks' errors

/// How many bricks a level's grid holds: every index its widths can name (`domain = 1`).
kernel mesh.cluster_grid_size@1 {
    requires { field.read; field.write; }
    input frame: ClusterFrames;
    param level: Int = 0;
    output result: Rows<Int>;
    compute { let w = mesh_brick_widths(at(frame, 0).bits, level); return 1 << (w.x + w.y + w.z); }
}

/// A level's grid, every brick empty (`domain = value(size)`).
kernel mesh.cluster_no_errors@1 {
    requires { field.read; field.write; }
    input size: Rows<Int>;
    output result: Rows<Float>;
    compute { return -1.0; }
}

/// Level 0's deviations: none, it is the mesh.
kernel mesh.cluster_exact@1 {
    requires { field.read; field.write; }
    input points: Rows<MeshPoint>;
    output result: Rows<Float>;
    compute { return 0.0; }
}

/// Each brick of level `level` the farthest of its points' deviations.
kernel mesh.cluster_point_errors@1 {
    requires { field.read; field.write; }
    input points: Rows<MeshPoint>;
    input deviation: Rows<Float>;
    input frame: ClusterFrames;
    input blank: Rows<Float>;
    param level: Int = 0;
    output result: Rows<Float>;
    struct Far { brick: Int; error: Float; }
    scatter into blank with max {
        let f = at(frame, 0);
        let b = mesh_cluster_brick(f, sample(points).position, level);
        return Far { brick: mesh_cluster_pack(b, mesh_brick_widths(f.bits, level)), error: at(deviation, element()) };
    }
}

/// A level's grid, every brick's area none yet (`domain = value(size)`).
kernel mesh.cluster_no_areas@1 {
    requires { field.read; field.write; }
    input size: Rows<Int>;
    output result: Rows<Float>;
    compute { return 0.0; }
}

/// The faces' areas summed in the bricks of level `level` their middles fall in (`domain = count(faces)`; the faces of any
/// level, laid over `points`).
kernel mesh.cluster_brick_areas@1 {
    requires { field.read; field.write; }
    input faces: Rows<Face>;
    input points: Rows<MeshPoint>;
    input frame: ClusterFrames;
    input blank: Rows<Float>;
    param level: Int = 0;
    output result: Rows<Float>;
    struct Area { brick: Int; area: Float; }
    scatter into blank with sum {
        let f = at(frame, 0);
        let g = sample(faces);
        let a = at(points, g.a).position;
        let b = at(points, g.b).position;
        let c = at(points, g.c).position;
        let middle = (a + b + c) / 3.0;
        return Area { brick: mesh_cluster_pack(mesh_cluster_brick(f, middle, level), mesh_brick_widths(f.bits, level)), area: length(cross(b - a, c - a)) * 0.5 };
    }
}

/// Level `level`'s brick errors with how much of the mesh's area each brick lost or gained (its faces' area `area` against
/// the mesh's own there, `whole`): a share of it times the level's cells' width, so an edge drawn in or a thin part
/// merged away counts, which the planes alone do not see.
kernel mesh.cluster_area_errors@1 {
    requires { field.read; field.write; }
    input far: Rows<Float>;
    input area: Rows<Float>;
    input whole: Rows<Float>;
    input frame: ClusterFrames;
    param level: Int = 1;
    output result: Rows<Float>;
    compute {
        let e = element();
        let cell = mesh_cluster_cell(at(frame, 0), level);
        let a0 = at(whole, e);
        let ak = at(area, e);
        let lost = if a0 > 0.0 { cell * saturate(abs(1.0 - ak / a0)) } else if ak > 0.0 { cell } else { -1.0 };
        return max(sample(far), lost);
    }
}

/// Level `level`'s brick errors, each never nearer than the eight bricks of the level below it holds (`below`).
kernel mesh.cluster_grid_up@1 {
    requires { field.read; field.write; }
    input own: Rows<Float>;
    input below: Rows<Float>;
    input frame: ClusterFrames;
    param level: Int = 1;
    output result: Rows<Float>;
    compute {
        let f = at(frame, 0);
        let b = mesh_cluster_unpack(element(), mesh_brick_widths(f.bits, level));
        let wb = mesh_brick_widths(f.bits, level - 1);
        let top = (ivec3(1, 1, 1) << wb) - 1;
        return loop 8 with e = sample(own) {
            let c = b * 2 + ivec3(index() & 1, (index() >> 1) & 1, index() >> 2);
            if c.x > top.x || c.y > top.y || c.z > top.z { e } else { max(e, at(below, mesh_cluster_pack(c, wb))) }
        };
    }
}

// ------------------------------------------------------------------ the levels as one mesh

/// The eight levels' points one after another.
kernel mesh.cluster_points8@1 {
    requires { field.read; field.write; }
    input p0: Rows<MeshPoint>;
    input p1: Rows<MeshPoint>;
    input p2: Rows<MeshPoint>;
    input p3: Rows<MeshPoint>;
    input p4: Rows<MeshPoint>;
    input p5: Rows<MeshPoint>;
    input p6: Rows<MeshPoint>;
    input p7: Rows<MeshPoint>;
    output result: Rows<MeshPoint>;
    compute {
        let e = element();
        let o1 = count(p0);
        let o2 = o1 + count(p1);
        let o3 = o2 + count(p2);
        let o4 = o3 + count(p3);
        let o5 = o4 + count(p4);
        let o6 = o5 + count(p5);
        let o7 = o6 + count(p6);
        return if e < o1 { at(p0, e) } else if e < o2 { at(p1, e - o1) } else if e < o3 { at(p2, e - o2) } else if e < o4 { at(p3, e - o3) }
            else if e < o5 { at(p4, e - o4) } else if e < o6 { at(p5, e - o5) } else if e < o7 { at(p6, e - o6) } else { at(p7, e - o7) };
    }
}

/// Each point's merged point a level up, among all the levels' points
/// (the top level's -1).
kernel mesh.cluster_up8@1 {
    requires { field.read; field.write; }
    input p0: Rows<MeshPoint>;
    input p1: Rows<MeshPoint>;
    input p2: Rows<MeshPoint>;
    input p3: Rows<MeshPoint>;
    input p4: Rows<MeshPoint>;
    input p5: Rows<MeshPoint>;
    input p6: Rows<MeshPoint>;
    input p7: Rows<MeshPoint>;
    input u0: Rows<Int>;
    input u1: Rows<Int>;
    input u2: Rows<Int>;
    input u3: Rows<Int>;
    input u4: Rows<Int>;
    input u5: Rows<Int>;
    input u6: Rows<Int>;
    output result: Rows<Int>;
    compute {
        let e = element();
        let o1 = count(p0);
        let o2 = o1 + count(p1);
        let o3 = o2 + count(p2);
        let o4 = o3 + count(p3);
        let o5 = o4 + count(p4);
        let o6 = o5 + count(p5);
        let o7 = o6 + count(p6);
        return if e < o1 { at(u0, e) + o1 } else if e < o2 { at(u1, e - o1) + o2 } else if e < o3 { at(u2, e - o2) + o3 } else if e < o4 { at(u3, e - o3) + o4 }
            else if e < o5 { at(u4, e - o4) + o5 } else if e < o6 { at(u5, e - o5) + o6 } else if e < o7 { at(u6, e - o6) + o7 } else { -1 };
    }
}

/// The eight levels' faces one after another, their corners among all
/// the levels' points.
kernel mesh.cluster_faces8@1 {
    requires { field.read; field.write; }
    input p0: Rows<MeshPoint>;
    input p1: Rows<MeshPoint>;
    input p2: Rows<MeshPoint>;
    input p3: Rows<MeshPoint>;
    input p4: Rows<MeshPoint>;
    input p5: Rows<MeshPoint>;
    input p6: Rows<MeshPoint>;
    input f0: Rows<Face>;
    input f1: Rows<Face>;
    input f2: Rows<Face>;
    input f3: Rows<Face>;
    input f4: Rows<Face>;
    input f5: Rows<Face>;
    input f6: Rows<Face>;
    input f7: Rows<Face>;
    output result: Rows<Face>;
    compute {
        let e = element();
        let o1 = count(f0);
        let o2 = o1 + count(f1);
        let o3 = o2 + count(f2);
        let o4 = o3 + count(f3);
        let o5 = o4 + count(f4);
        let o6 = o5 + count(f5);
        let o7 = o6 + count(f6);
        let q1 = count(p0);
        let q2 = q1 + count(p1);
        let q3 = q2 + count(p2);
        let q4 = q3 + count(p3);
        let q5 = q4 + count(p4);
        let q6 = q5 + count(p5);
        let q7 = q6 + count(p6);
        let g = if e < o1 { at(f0, e) } else if e < o2 { at(f1, e - o1) } else if e < o3 { at(f2, e - o2) } else if e < o4 { at(f3, e - o3) }
            else if e < o5 { at(f4, e - o4) } else if e < o6 { at(f5, e - o5) } else if e < o7 { at(f6, e - o6) } else { at(f7, e - o7) };
        let q = if e < o1 { 0 } else if e < o2 { q1 } else if e < o3 { q2 } else if e < o4 { q3 } else if e < o5 { q4 } else if e < o6 { q5 } else if e < o7 { q6 } else { q7 };
        return Face { a: g.a + q, b: g.b + q, c: g.c + q };
    }
}

/// The eight levels' faces' sources one after another (each the mesh's
/// own face it came from).
kernel mesh.cluster_sources8@1 {
    requires { field.read; field.write; }
    input s0: Rows<Int>;
    input s1: Rows<Int>;
    input s2: Rows<Int>;
    input s3: Rows<Int>;
    input s4: Rows<Int>;
    input s5: Rows<Int>;
    input s6: Rows<Int>;
    input s7: Rows<Int>;
    output result: Rows<Int>;
    compute {
        let e = element();
        let o1 = count(s0);
        let o2 = o1 + count(s1);
        let o3 = o2 + count(s2);
        let o4 = o3 + count(s3);
        let o5 = o4 + count(s4);
        let o6 = o5 + count(s5);
        let o7 = o6 + count(s6);
        return if e < o1 { at(s0, e) } else if e < o2 { at(s1, e - o1) } else if e < o3 { at(s2, e - o2) } else if e < o4 { at(s3, e - o3) }
            else if e < o5 { at(s4, e - o4) } else if e < o6 { at(s5, e - o5) } else if e < o7 { at(s6, e - o6) } else { at(s7, e - o7) };
    }
}

/// The eight levels' clusters one after another, their faces among all
/// the levels' faces.
kernel mesh.cluster_rows8@1 {
    requires { field.read; field.write; }
    input f0: Rows<Face>;
    input f1: Rows<Face>;
    input f2: Rows<Face>;
    input f3: Rows<Face>;
    input f4: Rows<Face>;
    input f5: Rows<Face>;
    input f6: Rows<Face>;
    input c0: Rows<Cluster>;
    input c1: Rows<Cluster>;
    input c2: Rows<Cluster>;
    input c3: Rows<Cluster>;
    input c4: Rows<Cluster>;
    input c5: Rows<Cluster>;
    input c6: Rows<Cluster>;
    input c7: Rows<Cluster>;
    output result: Rows<Cluster>;
    compute {
        let e = element();
        let o1 = count(c0);
        let o2 = o1 + count(c1);
        let o3 = o2 + count(c2);
        let o4 = o3 + count(c3);
        let o5 = o4 + count(c4);
        let o6 = o5 + count(c5);
        let o7 = o6 + count(c6);
        let q1 = count(f0);
        let q2 = q1 + count(f1);
        let q3 = q2 + count(f2);
        let q4 = q3 + count(f3);
        let q5 = q4 + count(f4);
        let q6 = q5 + count(f5);
        let q7 = q6 + count(f6);
        let g = if e < o1 { at(c0, e) } else if e < o2 { at(c1, e - o1) } else if e < o3 { at(c2, e - o2) } else if e < o4 { at(c3, e - o3) }
            else if e < o5 { at(c4, e - o4) } else if e < o6 { at(c5, e - o5) } else if e < o7 { at(c6, e - o6) } else { at(c7, e - o7) };
        let q = if e < o1 { 0 } else if e < o2 { q1 } else if e < o3 { q2 } else if e < o4 { q3 } else if e < o5 { q4 } else if e < o6 { q5 } else if e < o7 { q6 } else { q7 };
        return Cluster { ..g, first: g.first + q };
    }
}

/// The eight levels' brick errors one after another.
kernel mesh.cluster_errors8@1 {
    requires { field.read; field.write; }
    input g0: Rows<Float>;
    input g1: Rows<Float>;
    input g2: Rows<Float>;
    input g3: Rows<Float>;
    input g4: Rows<Float>;
    input g5: Rows<Float>;
    input g6: Rows<Float>;
    input g7: Rows<Float>;
    output result: Rows<Float>;
    compute {
        let e = element();
        let o1 = count(g0);
        let o2 = o1 + count(g1);
        let o3 = o2 + count(g2);
        let o4 = o3 + count(g3);
        let o5 = o4 + count(g4);
        let o6 = o5 + count(g5);
        let o7 = o6 + count(g6);
        return if e < o1 { at(g0, e) } else if e < o2 { at(g1, e - o1) } else if e < o3 { at(g2, e - o2) } else if e < o4 { at(g3, e - o3) }
            else if e < o5 { at(g4, e - o4) } else if e < o6 { at(g5, e - o5) } else if e < o7 { at(g6, e - o6) } else { at(g7, e - o7) };
    }
}

/// The built mesh's row of a library (`domain = 1`), `e1` to `e7` each
/// level's farthest brick error, `g0` to `g7` its brick errors.
kernel mesh.cluster_mesh@1 {
    requires { field.read; field.write; }
    input frame: ClusterFrames;
    input box: Rows<MeshBox>;
    input c0: Rows<Cluster>;
    input c1: Rows<Cluster>;
    input c2: Rows<Cluster>;
    input c3: Rows<Cluster>;
    input c4: Rows<Cluster>;
    input c5: Rows<Cluster>;
    input c6: Rows<Cluster>;
    input c7: Rows<Cluster>;
    input e1: Rows<Float>;
    input e2: Rows<Float>;
    input e3: Rows<Float>;
    input e4: Rows<Float>;
    input e5: Rows<Float>;
    input e6: Rows<Float>;
    input e7: Rows<Float>;
    input g0: Rows<Float>;
    input g1: Rows<Float>;
    input g2: Rows<Float>;
    input g3: Rows<Float>;
    input g4: Rows<Float>;
    input g5: Rows<Float>;
    input g6: Rows<Float>;
    output result: Rows<ClusterMesh>;
    compute {
        let f = at(frame, 0);
        let b = at(box, 0);
        let d1 = at(e1, 0);
        let d2 = max(at(e2, 0), d1);
        let d3 = max(at(e3, 0), d2);
        let d4 = max(at(e4, 0), d3);
        let d5 = max(at(e5, 0), d4);
        let d6 = max(at(e6, 0), d5);
        let d7 = max(at(e7, 0), d6);
        let o1 = count(c0);
        let o2 = o1 + count(c1);
        let o3 = o2 + count(c2);
        let o4 = o3 + count(c3);
        let o5 = o4 + count(c4);
        let o6 = o5 + count(c5);
        let o7 = o6 + count(c6);
        let o8 = o7 + count(c7);
        let mid = (b.lo + b.hi) * 0.5;
        let r1 = count(g0);
        let r2 = r1 + count(g1);
        let r3 = r2 + count(g2);
        let r4 = r3 + count(g3);
        let r5 = r4 + count(g4);
        let r6 = r5 + count(g5);
        let r7 = r6 + count(g6);
        return ClusterMesh { lo: f.lo, cell: f.cell, bits: f.bits, sphere: vec4(mid, length(b.hi - b.lo) * 0.5), levels: [0, o1, o2, o3, o4, o5, o6, o7, o8],
            errors: [0.0, d1, d2, d3, d4, d5, d6, d7], grids: [0, r1, r2, r3, r4, r5, r6, r7] };
    }
}

// ------------------------------------------------------------------ a library

/// Two libraries' points, `b`'s after `a`'s.
kernel mesh.cluster_join_points@1 {
    requires { field.read; field.write; }
    input a: Rows<MeshPoint>;
    input b: Rows<MeshPoint>;
    output result: Rows<MeshPoint>;
    compute { let e = element(); return if e < count(a) { at(a, e) } else { at(b, e - count(a)) }; }
}

/// Two libraries' ups, `b`'s moved past `a`'s points.
kernel mesh.cluster_join_up@1 {
    requires { field.read; field.write; }
    input a: Rows<Int>;
    input b: Rows<Int>;
    output result: Rows<Int>;
    compute {
        let e = element();
        if e < count(a) { return at(a, e); }
        let u = at(b, e - count(a));
        return if u < 0 { u } else { u + count(a) };
    }
}

/// Two libraries' faces, `b`'s corners moved past `a`'s points.
kernel mesh.cluster_join_faces@1 {
    requires { field.read; field.write; }
    input a: Rows<Face>;
    input b: Rows<Face>;
    input a_points: Rows<MeshPoint>;
    output result: Rows<Face>;
    compute {
        let e = element();
        if e < count(a) { return at(a, e); }
        let g = at(b, e - count(a));
        let q = count(a_points);
        return Face { a: g.a + q, b: g.b + q, c: g.c + q };
    }
}

/// Two libraries' clusters, `b`'s faces moved past `a`'s.
kernel mesh.cluster_join_rows@1 {
    requires { field.read; field.write; }
    input a: Rows<Cluster>;
    input b: Rows<Cluster>;
    input a_faces: Rows<Face>;
    output result: Rows<Cluster>;
    compute {
        let e = element();
        if e < count(a) { return at(a, e); }
        let g = at(b, e - count(a));
        return Cluster { ..g, first: g.first + count(a_faces) };
    }
}

/// Two libraries' faces' sources, `b`'s after `a`'s (each the face of its
/// own mesh it came from).
kernel mesh.cluster_join_sources@1 {
    requires { field.read; field.write; }
    input a: Rows<Int>;
    input b: Rows<Int>;
    output result: Rows<Int>;
    compute { let e = element(); return if e < count(a) { at(a, e) } else { at(b, e - count(a)) }; }
}

/// Two libraries' brick errors, `b`'s after `a`'s.
kernel mesh.cluster_join_errors@1 {
    requires { field.read; field.write; }
    input a: Rows<Float>;
    input b: Rows<Float>;
    output result: Rows<Float>;
    compute { let e = element(); return if e < count(a) { at(a, e) } else { at(b, e - count(a)) }; }
}

/// Two libraries' meshes, `b`'s clusters and brick errors moved past `a`'s.
kernel mesh.cluster_join_meshes@1 {
    requires { field.read; field.write; }
    input a: Rows<ClusterMesh>;
    input b: Rows<ClusterMesh>;
    input a_clusters: Rows<Cluster>;
    input a_errors: Rows<Float>;
    output result: Rows<ClusterMesh>;
    compute {
        let e = element();
        if e < count(a) { return at(a, e); }
        let m = at(b, e - count(a));
        let q = count(a_clusters);
        let r = count(a_errors);
        return ClusterMesh { ..m, levels: [each 9 { m.levels[index()] + q }], grids: [each 8 { m.grids[index()] + r }] };
    }
}
