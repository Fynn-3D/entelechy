// A law's template filled with two numbers a world computed, and the
// operation that would write it: `grow = $0; die = $1;`.
input template: Rows<Int> = text "fn grow() -> Float { return $0; }\nfn die() -> Float { return $1; }\n";
input path: Rows<Int> = text "rule.ent";

node values: kernel {
    requires { field.write; }
    output result: Rows<Float>;
    domain = 2;
    compute { return [0.125, -2.5][element()]; }
}
node law: graph "../graphs/law.esn" { template <- template; values <- values.result; path <- path; places = 3; }

output result <- law.text;
