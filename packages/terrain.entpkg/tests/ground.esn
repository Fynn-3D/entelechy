// Ground whose answers are known: a slope rising half a meter a meter
// eastward over 16 by 16 cells 2 meters apart, read between its cells,
// hit by a ray straight down, its highest over blocks of four cells, hit
// again over those blocks as without them, and laid out as a mesh; and a spike worn down
// by erosion, its sum kept.
use "mesh.entpkg";
use "../kernels/";

node slope: kernel {
    requires { field.write; }
    output result: Grid<Float>;
    domain = vec2(16, 16);
    compute { return (coord().x + 0.5) * 2.0 * 0.5; }
}
node spike: kernel {
    requires { field.write; }
    output result: Grid<Float>;
    domain = vec2(8, 8);
    compute { return if int(coord().x) == 4 && int(coord().y) == 4 { 8.0 } else { 0.0 }; }
}
node read: kernel {
    requires { field.read; field.write; }
    input heights: Grid<Float> <- slope.result;
    output result: Rows<Float>;
    domain = 5;
    compute {
        let p = vec2(9.0, 13.0);
        let n = terrain_normal(heights, 2.0, p);
        return [
            terrain_height(heights, 2.0, p),
            n.x,
            n.y,
            terrain_hit(heights, 2.0, vec3(10.0, 20.0, 10.0), vec3(0.0, -1.0, 0.0), -5.0, 40.0),
            terrain_hit(heights, 2.0, vec3(-10.0, 20.0, 10.0), vec3(0.0, -1.0, 0.0), -5.0, 40.0),
        ][element()];
    }
}
node highest: terrain.highest@1 { heights <- slope.result; block = 4; domain = vec2(4, 4); }
node over: kernel {
    requires { field.read; field.write; }
    input heights: Grid<Float> <- slope.result;
    input highest: Grid<Float> <- highest.result;
    output result: Rows<Float>;
    domain = 4;
    compute {
        let slant = normalize(vec3(1.0, -0.6, 0.3));
        let low = normalize(vec3(-1.0, -0.15, 0.2));
        return [
            terrain_hit_over(heights, 2.0, highest, 4, vec3(10.0, 20.0, 10.0), vec3(0.0, -1.0, 0.0), -5.0, 40.0),
            terrain_hit_over(heights, 2.0, highest, 4, vec3(1.0, 20.0, 3.0), slant, -5.0, 40.0) - terrain_hit(heights, 2.0, vec3(1.0, 20.0, 3.0), slant, -5.0, 40.0),
            terrain_hit_over(heights, 2.0, highest, 4, vec3(31.0, 18.0, 5.0), low, -5.0, 40.0) - terrain_hit(heights, 2.0, vec3(31.0, 18.0, 5.0), low, -5.0, 40.0),
            terrain_hit_over(heights, 2.0, highest, 4, vec3(-10.0, 20.0, 10.0), vec3(0.0, -1.0, 0.0), -5.0, 40.0),
        ][element()];
    }
}
node points: terrain.points@1 { heights <- slope.result; cell = 2.0; domain = 256; }
node worn: terrain.erode@1 { previous <- spike.result; talus = 0.5; rate = 1.0; }
node sums: kernel {
    requires { field.read; field.write; }
    input before: Grid<Float> <- spike.result;
    input after: Grid<Float> <- worn.result;
    output result: Rows<Float>;
    domain = 2;
    compute {
        let total = loop 64 with s = 0.0 {
            let c = vec2(float(index() % 8), float(index() / 8));
            s + if element() == 0 { at(before, c) } else { at(after, c) }
        };
        return total;
    }
}

output result <- read.result;
