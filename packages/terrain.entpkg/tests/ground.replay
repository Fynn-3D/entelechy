scene ground.esn

# Between cells the slope reads true: at 9 meters east it stands 4.5; its
# normal leans west, 0.5 over 1; a ray straight down from 20 meters at 10
# east meets it 15 down; one outside the grid meets nothing.
frame 0.0
expect read.result[0] = 4.5 0.0001
expect read.result[1] = -0.4472 0.0001
expect read.result[2] = 0.8944 0.0001
expect read.result[3] = 15 0.01
expect read.result[4] = -1 0

# Laid out as a mesh: the last point at the far corner, at its height.
expect points.result[255].position = 31 15.5 31 0.0001
expect points.result[255].uv = 1 1 0.0001

# Erosion: the spike, 8 over its four neighbors, gives each a quarter of
# what it stands over it beyond the talus, 7.5; the sum is kept.
expect worn.result[36] = 0.5 0.0001
expect worn.result[37] = 1.875 0.0001
expect sums.result[0] = 8 0.0001
expect sums.result[1] = 8 0.0001

# The brush raises the cell 1.41 meters from its middle by its amount
# times its fall there, and the ground past its rim not at all.
expect raised.result[119] = 1.8595 0.0005
expect raised.result[0] = 1 0.0001

# Hills stay between nothing and their height.
expect hills.result[163] >= 0
expect hills.result[163] <= 12
expect hills.result[700] >= 0
expect hills.result[700] <= 12
