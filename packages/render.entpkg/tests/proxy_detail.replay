scene proxy_detail.esn

# The fine block round the eye stands ahead of it toward the ball and down
# from it, on the steps of a quarter of its width. Until it is first made,
# what it holds is the coarse level's: five centimeters off the ball both
# read the way less the coarse half cell; past the block, the coarse alone.
frame 0.0
expect detail.frame[0].lo = 0.48 -0.72 -0.48 0.0001
expect detail.frame[0].cell = 0.03 0.0001
expect detail.frame[1].cell = 0.09375 0.0001
expect probe.result[0] = 0.0031 0.0005
expect probe.result[1] = 0.0031 0.0005
expect probe.result[2] = 0.4496 0.0005
expect probe.result[3] = 0.4496 0.0005
frame 0.1
frame 0.2
frame 0.3
frame 0.4
frame 0.5
frame 0.6
frame 0.7
frame 0.8

# Made: the way less its own half cell, a thing's shell a third as thick.
expect detail.fine.stage.result[0] = 9
expect probe.result[0] = 0.035 0.0005
expect probe.result[1] = 0.0031 0.0005

# The eye steps on: the block in use the last one made, where it was,
# until the new one is, then the new one with its own frame.
param eye 1.5
frame 1.0
expect detail.frame[0].lo = 0.48 -0.72 -0.48 0.0001
expect probe.result[0] = 0.035 0.0005
frame 1.1
frame 1.2
frame 1.3
frame 1.4
frame 1.5
frame 1.6
frame 1.7
expect detail.frame[0].lo = 0.48 -0.72 -0.48 0.0001
frame 1.8
expect detail.frame[0].lo = 0.54 -0.72 -0.48 0.0001
expect probe.result[0] = 0.035 0.0005
