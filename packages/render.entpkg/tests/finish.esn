// The finish's words at points whose answers are known by hand: a grade
// (exposure, contrast, saturation, a drain, white balance, a blend of two,
// one kept to part of the picture by `image.masked`) and outlines (an
// edge's near side, a crease, a mask that holds them back).
use "../kernels/";
use "image.entpkg";

node light: kernel {
    requires { field.write; }
    output result: Image;
    domain = vec2(2, 1);
    compute { return if coord().x < 0.5 { vec4(0.18, 0.18, 0.18, 1.0) } else { vec4(0.5, 0.5, 0.5, 1.0) }; }
}
node graded: kernel {
    requires { field.write; }
    output result: Rows<Vec4>;
    domain = 3;
    compute {
        let k = element();
        let g = grade_none();
        let brighter = Grade { exposure: 1.0, temperature: 0.0, tint: 0.0, saturation: 1.0, contrast: 0.0, gain: vec3(1.0, 1.0, 1.0), drain: 0.0, drain_color: vec3(1.0, 1.0, 1.0) };
        let harder = Grade { exposure: 0.0, temperature: 0.0, tint: 0.0, saturation: 1.0, contrast: 1.0, gain: vec3(1.0, 1.0, 1.0), drain: 0.0, drain_color: vec3(1.0, 1.0, 1.0) };
        let gray = Grade { exposure: 0.0, temperature: 0.0, tint: 0.0, saturation: 0.0, contrast: 0.0, gain: vec3(1.0, 1.0, 1.0), drain: 0.0, drain_color: vec3(1.0, 1.0, 1.0) };
        let drained = Grade { exposure: 0.0, temperature: 0.0, tint: 0.0, saturation: 1.0, contrast: 0.0, gain: vec3(1.0, 1.0, 1.0), drain: 1.0, drain_color: vec3(0.5, 1.0, 2.0) };
        let warm = Grade { exposure: 0.0, temperature: 1.0, tint: 0.0, saturation: 1.0, contrast: 0.0, gain: vec3(1.0, 1.0, 1.0), drain: 0.0, drain_color: vec3(1.0, 1.0, 1.0) };
        return if k == 0 { vec4(grade_color(vec3(0.18, 0.18, 0.18), brighter).x, grade_color(vec3(0.36, 0.36, 0.36), harder).x, grade_color(vec3(0.18, 0.18, 0.18), harder).x,
                grade_color(vec3(1.0, 0.0, 0.0), gray).y) }
            else if k == 1 { vec4(grade_color(vec3(0.5, 0.5, 0.5), drained), grade_mix(g, Grade { exposure: 2.0, temperature: 0.0, tint: 0.0, saturation: 1.0, contrast: 0.0, gain: vec3(1.0, 1.0, 1.0), drain: 0.0, drain_color: vec3(1.0, 1.0, 1.0) }, 0.5).exposure) }
            else { vec4(grade_color(vec3(0.5, 0.5, 0.5), warm), grade_color(vec3(0.3, 0.2, 0.1), g).y) };
    }
}
node looks: render.grade_start@1 { exposure = 1.0; domain = 1; }
node lit: render.grade@1 { hdr <- light.result; grade <- looks.result; domain = size(hdr); }
node down: render.grade_start@1 { exposure = -1.0; domain = 1; }
node darker: render.grade@1 { hdr <- light.result; grade <- down.result; domain = size(hdr); }
node right: kernel {
    requires { field.write; }
    output result: Grid<Float>;
    domain = vec2(2, 1);
    compute { return if coord().x < 0.5 { 0.0 } else { 1.0 }; }
}
node masked: image.masked@1 { base <- light.result; top <- darker.result; mask <- right.result; }

// A row with a nearer block in its middle (5 meters before a wall at 10), and a row at one depth whose surface turns
// a right angle at its middle.
node surface: kernel {
    requires { field.write; }
    output result: Grid<Vec4>;
    domain = vec2(6, 2);
    compute {
        let c = coord();
        return if c.y < 0.5 { vec4(0.0, 0.0, 1.0, if c.x > 1.5 && c.x < 3.5 { 5.0 } else { 10.0 }) }
            else if c.x < 2.5 { vec4(0.0, 0.0, 1.0, 10.0) } else { vec4(1.0, 0.0, 0.0, 10.0) };
    }
}
node white: Grid<Vec4> { domain = vec2(6, 2); value = vec4(1.0, 1.0, 1.0, 1.0); }
node none: Grid<Float> { domain = vec2(1, 1); value = 0.0; }
node inked: render.outline@1 { image <- white.result; surface <- surface.result; }
node held: image.masked@1 { base <- white.result; top <- inked.result; mask <- none.result; }

output result <- inked.result;
