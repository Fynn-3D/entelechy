// A world plane through a lens's clip space (`render.lens_clip_plane`): for points round a tilted lens, the plane's
// distance read from each point's clip coordinates (`lens_clip`) and the world's own. `level` moves the plane.
use "../kernels/";

param level: Float = 0.5;

node lens: kernel {
    requires { field.write; }
    output result: Lenses;
    domain = 1;
    compute {
        let ahead = normalize(vec3(0.3, -0.2, 1.0));
        let right = normalize(cross(ahead, vec3(0.0, 1.0, 0.0)));
        return Lens { eye: vec3(1.0, 2.0, -3.0), ahead: ahead, right: right, up: cross(right, ahead), focal: 1.4 };
    }
}
node canvas: Grid<Long> { domain = vec2(64, 40); value = 9223372036854775807l; }
node plane: render.lens_clip_plane@1 { lens <- lens.result; canvas <- canvas.result; normal = vec3(0.19518, 0.97590, -0.09759); level = level; near = 0.1; far = 500.0; domain = 1; }
node read: kernel {
    requires { field.read; field.write; }
    input lens: Lenses <- lens.result;
    input plane: Rows<Vec4> <- plane.result;
    input canvas: Grid<Long> <- canvas.result;
    param level: Float = level;
    output result: Rows<Vec2>;
    domain = 4;
    compute {
        let p = [vec3(1.5, 0.0, 4.0), vec3(-2.0, 3.0, 9.0), vec3(4.0, -1.0, 30.0), vec3(0.0, 0.6, 1.0)][element()];
        let c = lens_clip(at(lens, 0), size(canvas), p, 0.1, 500.0);
        return vec2(dot(at(plane, 0), c), dot(vec3(0.19518, 0.97590, -0.09759), p) - level);
    }
}

output result <- read.result;
