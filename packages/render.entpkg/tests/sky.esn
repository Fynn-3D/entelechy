// The stand under the sky the air makes, the sun low in the afternoon, its
// shadows from cascaded shadow maps as well as the stand's own: the
// light scattered more than once, the look a renderer lights by, the sky
// round the eye as a table, the daylight renderer lighting the stand by it
// and the sky's pixels painted from the table, with the sun's disc;
// metered and toned.
use "../kernels/";

node stand: graph "stand_scene.esn" { }
node air: graph "../graphs/atmosphere.esn" { elevation = 0.25; bearing = 2.6; air = 0.004; air_from = 30.0; }
// The sun's shadows from two cascades drawn down the sunlight, laid over
// the stand's own (the same shadows, softened as far as the sun's disc makes them).
node sun_views: render.sun_views@1 { lens <- stand.lens; sky <- air.sky; nearest = 8.0; spread = 4.0; reach = 20.0; size = 256.0; domain = 2; }
node sun_depth: stand.sun_depth@1 { views <- sun_views.result; size = 256.0; domain = vec2(512, 256); }
node sunlit: render.sun_shadow@1 { extra <- stand.extra; surface <- stand.surface; lens <- stand.lens; views <- sun_views.result; atlas <- sun_depth.result; domain = size(extra); }
node lit: render.daylight@1 { surface <- stand.surface; paint <- stand.paint; extra <- sunlit.result; layers <- stand.layers; more <- stand.more;
    sky <- air.sky; lens <- stand.lens; proxy <- stand.proxy; frame <- stand.frame; domain = size(surface); }
node skied: render.atmosphere_sky@1 { hdr <- lit.result; surface <- stand.surface; lens <- stand.lens; sky <- air.sky; view <- air.view; domain = size(hdr); }
node exposed: graph "../graphs/exposure.esn" { hdr <- skied.result; highlights = 0.7; shadows = 0.9; }
node glow: graph "../graphs/bloom.esn" { hdr <- exposed.hdr; }
node view: render.view@1 { hdr <- exposed.hdr; bloom <- glow.bloom; exposure = 1.0; domain = window(); }

output result <- view.result;
