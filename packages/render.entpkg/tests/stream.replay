scene stream.esn

# The chunks round the eye wanted, the one under it near and the rest far,
# nearest first; none is in yet, so nothing is drawn.
frame 0.0
expect wanted.result[0] = 0 0 0 1
expect wanted.result[1] = 1 0 1 1
expect wanted.result[4] = 0 0 0 0
expect library.ready.result[0] = -1
expect 31 31 = 0 0 0 0.001

# A frame later they are in: the near chunk's ball under the eye, red by
# its part, the ground grey round it.
frame 0.1
expect library.ready.result[0] = 0
expect library.ready.result[3] = 3
expect 31 31 = 1 0 0 0.001
expect 40 40 = 0.5 0.5 0.5 0.001

# The eye over the far corner's chunk: that one is now wanted near, the
# rest far, and its ball is drawn under the eye.
param eye_x 6.0
param eye_z 6.0
frame 0.2
expect wanted.result[0] = 1 1 0 1
frame 0.3
expect library.ready.result[0] = 0
expect 31 31 = 1 0 0 0.001
