// The package's words said by a scene's own kernels, held to its passes: the air laid over by `hazed` is the haze
// pass's picture; a film's look a story turns from one recipe toward another (`film_preset`, `grade_mix`) is the film
// pass's at its start and its own past it; an outline kept to the right half of the picture by a mask
// (`image.masked`) is the picture on the left and the outline on the right.
use "../kernels/";
use "image.entpkg";

/// How far apart two pictures are over the pixels from `from` to `to` (exclusive): the most any channel differs.
fn apart(a: Image, b: Image, from: Vec2, to: Vec2) -> Float {
    let span = to - from;
    return loop int(span.x * span.y) with most = 0.0 {
        let q = from + vec2(float(index() % int(span.x)), float(index() / int(span.x)));
        let d = abs(at(a, q).xyz - at(b, q).xyz);
        max(most, max(d.x, max(d.y, d.z)))
    };
}

/// A story's film: the cinema's look turned `turn` of the way toward the drained one's.
fn told(turn: Float) -> Film {
    let a = film_preset(1);
    let b = film_preset(3);
    return Film { ..a, grade: grade_mix(a.grade, b.grade, turn), split: mix(a.split, b.split, turn), curve: mix(a.curve, b.curve, turn),
        vignette: mix(a.vignette, b.vignette, turn) };
}

node stand: graph "stand_scene.esn" { }
node lit: render.lit@1 { surface <- stand.surface; paint <- stand.paint; extra <- stand.extra; layers <- stand.layers; more <- stand.more;
    sky <- stand.sky; lens <- stand.lens; proxy <- stand.proxy; frame <- stand.frame; domain = window(); }

// The air thick enough to show across the stand: the pass, and a scene's kernel saying it.
node aired: render.haze@1 { hdr <- lit.result; surface <- stand.surface; lens <- stand.lens; sky <- stand.sky; density = 40.0; }
node own_air: kernel {
    requires { field.read; field.write; }
    input hdr: Image <- lit.result;
    input surface: Grid<Vec4> <- stand.surface;
    input lens: Lenses <- stand.lens;
    input sky: SkyLooks <- stand.sky;
    output result: Image;
    domain = size(hdr);
    compute {
        let c = sample(hdr);
        let su = sample(surface);
        if su.w > no_hit() * 0.5 { return c; }
        let l = at(lens, 0);
        let shown = hazed(c.xyz, l.eye, ray(l, coord(), domain()), su.w, at(sky, 0), Haze { ..haze_default(), density: 40.0 });
        return vec4(shown.x, shown.y, shown.z, c.w);
    }
}

// The picture shown, then filmed: by the cinema's recipe, by a story at its start, and a story half way on.
node seen: graph "../graphs/tonemap.esn" { hdr <- lit.result; }
node cinema: render.film_start@1 { preset = 1; domain = 1; }
node filmed: render.film@1 { image <- seen.result; film <- cinema.result; }
node start: kernel {
    requires { field.write; }
    output result: Rows<Film>;
    domain = 1;
    compute { return told(0.0); }
}
node half: kernel {
    requires { field.write; }
    output result: Rows<Film>;
    domain = 1;
    compute { return told(0.5); }
}
node told_start: render.film@1 { image <- seen.result; film <- start.result; }
node told_half: render.film@1 { image <- seen.result; film <- half.result; }

// Ink kept to the right half.
node inked: render.outline@1 { image <- seen.result; surface <- stand.surface; }
node right: kernel {
    requires { field.write; }
    output result: Grid<Float>;
    domain = floor(window() * vec2(1, 0) + vec2(0, 1));
    compute { return if coord().x >= floor(domain().x * 0.5) { 1.0 } else { 0.0 }; }
}
node half_inked: image.masked@1 { base <- seen.result; top <- inked.result; mask <- right.result; }

/// How far apart: the scene's air from the pass's, and the air from none; the story's start from the recipe, and half
/// way from it; the half inked picture's left from the picture and its right from the outline, and the outline from the
/// picture.
node apart_all: kernel {
    requires { field.read; field.write; }
    input air: Image <- aired.result;
    input own: Image <- own_air.result;
    input light: Image <- lit.result;
    input recipe: Image <- filmed.result;
    input from_start: Image <- told_start.result;
    input half_way: Image <- told_half.result;
    input shown: Image <- seen.result;
    input ink: Image <- inked.result;
    input kept: Image <- half_inked.result;
    output result: Rows<Float>;
    domain = 7;
    compute {
        let n = size(shown);
        let k = element();
        let mid = floor(n.x * 0.5);
        return if k == 0 { apart(own, air, vec2(0.0, 0.0), n) }
            else if k == 1 { apart(air, light, vec2(0.0, 0.0), n) }
            else if k == 2 { apart(from_start, recipe, vec2(0.0, 0.0), n) }
            else if k == 3 { apart(half_way, recipe, vec2(0.0, 0.0), n) }
            else if k == 4 { apart(kept, shown, vec2(0.0, 0.0), vec2(mid, n.y)) }
            else if k == 5 { apart(kept, ink, vec2(mid, 0.0), n) }
            else { apart(ink, shown, vec2(0.0, 0.0), n) };
    }
}

output result <- half_inked.result;
