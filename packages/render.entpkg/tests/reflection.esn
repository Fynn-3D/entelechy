// Reflections on the screen and motion blur over the stand: its floor
// polished and lit by lit, with and without the balls' reflections the
// screen shows; and the picture blurred as the lens moved half a meter
// across in a frame, the balls standing still.
use "../kernels/";

node stand: graph "stand_scene.esn" { }
node polished: kernel {
    requires { field.read; field.write; }
    input paint: Grid<Vec4> <- stand.paint;
    input surface: Grid<Vec4> <- stand.surface;
    output result: Grid<Vec4>;
    domain = size(paint);
    compute { let c = sample(paint); return if sample(surface).y > 0.9 { vec4(c.x, c.y, c.z, 0.05) } else { c }; }
}
node lit: render.lit@1 { surface <- stand.surface; paint <- polished.result; extra <- stand.extra; layers <- stand.layers; more <- stand.more;
    sky <- stand.sky; lens <- stand.lens; proxy <- stand.proxy; frame <- stand.frame; domain = window(); }
node mirrored: render.reflections@1 { hdr <- lit.result; reflection <- lit.reflection; surface <- stand.surface; paint <- polished.result; extra <- stand.extra;
    layers <- stand.layers; more <- stand.more; lens <- stand.lens; sky <- stand.sky; domain = size(hdr); }
/// The picture's change over eight by eight pixels at each place: the floor before the red ball's middle, before the white
/// ball's, and the sky.
node changed: kernel {
    requires { field.read; field.write; }
    input a: Image <- lit.result;
    input b: Image <- mirrored.result;
    output result: Rows<Vec4>;
    domain = 3;
    compute {
        let o = [vec2(140.0, 300.0), vec2(316.0, 300.0), vec2(320.0, 40.0)][element()];
        return loop 64 with s = vec4(0.0, 0.0, 0.0, 0.0) { let q = o + vec2(float(index() % 8), float(index() / 8)); s + (at(b, q) - at(a, q)) / 64.0 };
    }
}

// The lens half a meter to the left a frame before.
node before: kernel {
    requires { field.read; field.write; }
    input lens: Lenses <- stand.lens;
    output result: Lenses;
    domain = 1;
    compute { let l = at(lens, 0); return Lens { ..l, eye: l.eye - l.right * 0.5 }; }
}
node none: Grid<Vec4> { domain = vec2(1, 1); }
node blurred: render.motion_blur@1 { image <- mirrored.result; surface <- stand.surface; lens <- stand.lens; was_lens <- before.result; motion <- none.result; domain = size(image); }
node steady: render.motion_blur@1 { image <- mirrored.result; surface <- stand.surface; lens <- stand.lens; was_lens <- stand.lens; motion <- none.result; domain = size(image); }
/// How much the blurred and the steady pictures part over a row of pixels across the balls' first row, and over the sky.
node parted: kernel {
    requires { field.read; field.write; }
    input a: Image <- mirrored.result;
    input b: Image <- blurred.result;
    input c: Image <- steady.result;
    output result: Rows<Vec2>;
    domain = 2;
    compute {
        let y = if element() == 0 { 262.0 } else { 40.0 };
        return loop 640 with s = vec2(0.0, 0.0) { let q = vec2(float(index()), y); s + vec2(length(at(b, q).xyz - at(a, q).xyz), length(at(c, q).xyz - at(a, q).xyz)) / 640.0 };
    }
}

output result <- blurred.result;
