// Fog volumes in the air (`graphs/volumetrics.esn`): a grey wall `wall`
// meters off, no height fog, and before it a red-tinted ball of fog in the
// middle and a blue-tinted box of it to the right, five meters off, lit by
// the sun and the sky (no proxies, no cascades, no lamps). `thick` is the
// ball's density.
use "../kernels/";

param wall: Float = 10.0;
param thick: Float = 0.5;

node volumes: kernel {
    requires { field.write; }
    param thick: Float = thick;
    output result: FogVolumes;
    domain = 2;
    compute {
        return if element() == 0 { FogVolume { at: vec3(0.0, 0.0, -5.0), size: vec3(1.0, 0.0, 0.0), shape: 1, density: thick, soft: 0.2, color: vec3(1.0, 0.2, 0.2) } }
            else { FogVolume { at: vec3(1.6, 0.0, -5.0), size: vec3(0.4, 0.4, 0.4), shape: 0, density: 1.0, soft: 0.1, color: vec3(0.2, 0.2, 1.0) } };
    }
}
node lens: kernel {
    requires { field.write; }
    output result: Lenses;
    domain = 1;
    compute { return Lens { eye: vec3(0.0, 0.0, 0.0), ahead: vec3(0.0, 0.0, -1.0), right: vec3(1.0, 0.0, 0.0), up: vec3(0.0, 1.0, 0.0), focal: 1.0 }; }
}
node sky: kernel {
    requires { field.write; }
    output result: SkyLooks;
    domain = 1;
    compute {
        return SkyLook { sun: normalize(vec3(0.0, 1.0, 0.2)), sun_color: vec3(1.0, 1.0, 1.0), ambient: vec3(0.2, 0.2, 0.2), horizon: vec3(0.3, 0.3, 0.3),
            zenith: vec3(0.2, 0.2, 0.3), clouds: 0.0, far_land: 0.0, far_color: vec3(0.5, 0.5, 0.5), air: 0.0, air_from: 0.0 };
    }
}
node picture: Image { domain = vec2(64, 64); value = vec4(0.5, 0.5, 0.5, 1.0); }
node surface: kernel {
    requires { field.read; field.write; }
    input lens: Lenses <- lens.result;
    param wall: Float = wall;
    output result: Grid<Vec4>;
    domain = vec2(64, 64);
    compute { let l = at(lens, 0); return vec4(0.0, 0.0, 1.0, wall / max(dot(ray(l, coord(), domain()), l.ahead), 0.001)); }
}
node frame: kernel {
    requires { field.write; }
    output result: Proxies;
    domain = 1;
    compute { return Proxy { lo: vec3(-1.0, -1.0, -1.0), cell: 2.0, cells: vec3(1.0, 1.0, 1.0), land_lo: vec2(-100.0, -100.0), land_cell: 200.0, ground: vec3(0.3, 0.3, 0.3) }; }
}
node empty: Volume<Vec4> { domain = vec3(1, 1, 1); value = vec4(1000.0, 0.0, 0.0, 0.0); }
node land: Grid<Float> { domain = vec2(2, 2); value = -50.0; }
node no_lamps: render.lamps_none@1 { domain = 1; }
node no_sun: render.sun_none@1 { domain = 1; }
node no_atlas: Grid<Float> { domain = vec2(1, 1); value = 1.0; }
node no_lamp_looks: render.lamp_looks_none@1 { domain = vec2(1, 1); }
node aired: graph "../graphs/volumetrics.esn" { hdr <- picture.result; lens <- lens.result; sky <- sky.result; surface <- surface.result; proxy <- empty.result; land <- land.result;
    frame <- frame.result; lamps <- no_lamps.result; lamp_looks <- no_lamp_looks.result; views <- no_sun.result; atlas <- no_atlas.result; volumes <- volumes.result; density = 0.0; columns = 32; rows = 32;
    near = 1.0; far = 20.0; cover = 0.0; }

output result <- aired.hdr;
