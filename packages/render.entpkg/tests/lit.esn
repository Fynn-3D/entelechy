// The stand by the light renderers and through every step of a finish:
// contact shadows laid into the sun's visibility; lit as it is and as a
// painting has it; clay; haze and stylized edges; lit deep inside the
// coarse shape; ray traced, and over a polished floor; the extent a
// renderer draws at; a film's look; depth of field focused on the middle;
// and the stand's G-buffer merged with itself, nearer surface by surface.
node stand: graph "stand_scene.esn" { }
node shadowed: render.contact@1 { surface <- stand.surface; extra <- stand.extra; layers <- stand.layers; lens <- stand.lens; sky <- stand.sky; domain = size(surface); }
node lit: render.lit@1 { surface <- stand.surface; paint <- stand.paint; extra <- shadowed.result; layers <- stand.layers; more <- stand.more;
    sky <- stand.sky; lens <- stand.lens; proxy <- stand.proxy; frame <- stand.frame; painted = 0; domain = window(); }
node painted: render.lit@1 { surface <- stand.surface; paint <- stand.paint; extra <- shadowed.result; layers <- stand.layers; more <- stand.more;
    sky <- stand.sky; lens <- stand.lens; proxy <- stand.proxy; frame <- stand.frame; painted = 1; domain = window(); }
node clay: graph "../graphs/clay.esn" { lens <- stand.lens; surface <- stand.surface; paint <- stand.paint; extra <- stand.extra; }
// Lit with every point deep inside the coarse shape (as a leaf in its
// crown): the light all round kept by `inside_sky` and the baked occlusion.
node deep: kernel {
    requires { field.read; field.write; }
    input proxy: Volume<Vec4> <- stand.proxy;
    output result: Volume<Vec4>;
    domain = size(proxy);
    compute { let p = sample(proxy); return vec4(p.x - 100.0, p.y, p.z, p.w); }
}
node lit_deep: render.lit@1 { surface <- stand.surface; paint <- stand.paint; extra <- shadowed.result; layers <- stand.layers; more <- stand.more;
    sky <- stand.sky; lens <- stand.lens; proxy <- deep.result; frame <- stand.frame; domain = window(); }
node lit_dark: render.lit@1 { surface <- stand.surface; paint <- stand.paint; extra <- shadowed.result; layers <- stand.layers; more <- stand.more;
    sky <- stand.sky; lens <- stand.lens; proxy <- deep.result; frame <- stand.frame; inside_sky = 0.0; domain = window(); }
// Ray traced: the G-buffer's shadow, each thing's own occlusion, smooth
// surfaces' mirror rays traced through the proxies.
node traced: render.raytraced@1 { surface <- stand.surface; paint <- stand.paint; extra <- shadowed.result; layers <- stand.layers; more <- stand.more;
    sky <- stand.sky; lens <- stand.lens; proxy <- stand.proxy; land <- stand.land; frame <- stand.frame; domain = window(); }
// The floor polished: ray traced, its mirror rays leave it clear of the
// ground before they count what they meet.
node polished: kernel {
    requires { field.read; field.write; }
    input paint: Grid<Vec4> <- stand.paint;
    input surface: Grid<Vec4> <- stand.surface;
    output result: Grid<Vec4>;
    domain = size(paint);
    compute { let c = sample(paint); return if sample(surface).y > 0.9 { vec4(c.x, c.y, c.z, 0.05) } else { c }; }
}
node traced_floor: render.raytraced@1 { surface <- stand.surface; paint <- polished.result; extra <- shadowed.result; layers <- stand.layers; more <- stand.more;
    sky <- stand.sky; lens <- stand.lens; proxy <- stand.proxy; land <- stand.land; frame <- stand.frame; domain = window(); }
node aired: render.haze@1 { hdr <- lit.result; surface <- stand.surface; lens <- stand.lens; sky <- stand.sky; on = 1; }
node inked: render.stylized@1 { image <- painted.result; surface <- stand.surface; }

// The extent a renderer draws at, by dynamic resolution.
node dynamic0: render.dynamic_start@1 { domain = 1; }
node dynamic: render.dynamic@1 { previous <~ dynamic.result from dynamic0.result; domain = 1; }
node extent: render.extent@1 { dynamic <- dynamic.result; domain = 2; }
node size: render.extent_size@1 { extent <- extent.result; domain = 1; }
node canvas: render.canvas@1 { extent <- extent.result; domain = vec2(value(extent, 0), value(extent, 1)); }

node seen: graph "../graphs/tonemap.esn" { hdr <- aired.result; exposure = 0.8; sharpen = 0.5; }
node film0: render.film_start@1 { preset = 1; domain = 1; }
node film_choice: render.film_keys@1 { previous <~ film_choice.result from film0.result; domain = 1; }
node filmed: render.film@1 { image <- seen.result; choice <- film_choice.result; grain = 0.0; }
node dof0: render.dof_start@1 { on = 1; aperture = 6.0; domain = 1; }
node dof: render.dof_control@1 { previous <~ dof.result from dof0.result; domain = 1; }
node focus0: Rows<Float> { domain = 1; value = 8.0; }
node focus: render.focus@1 { previous <~ focus.result from focus0.result; surface <- stand.surface; control <- dof.result; domain = 1; }
node focused: render.focused@1 { image <- filmed.result; surface <- stand.surface; focus <- focus.result; control <- dof.result; }

node fit: Rows<Float> { domain = 1; value = 1.0; }
node merged: render.nearer@1 { a_surface <- stand.surface; a_paint <- stand.paint; a_extra <- stand.extra; a_layers <- stand.layers; a_more <- stand.more;
    a_behind_at <- stand.behind_at; a_behind_dir <- stand.behind_dir; a_behind_paint <- stand.behind_paint; a_behind_normal <- stand.behind_normal; a_through <- stand.through;
    b_surface <- stand.surface; b_paint <- stand.paint; b_extra <- stand.extra; b_layers <- stand.layers; b_more <- stand.more; fit <- fit.result; domain = size(a_surface); }
node nothing: render.blank@1 { domain = vec2(4, 4); }
// No cascades of the sun's shadow: one that holds nothing (the fog falls back to the proxies).
node no_sun: render.sun_none@1 { domain = 1; }

output result <- focused.result;
