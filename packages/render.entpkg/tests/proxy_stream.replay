scene proxy_stream.esn

# Baked a pass a frame: the first frame floods once, the proxy in use the
# flood as far as it has come (its far cells still unfilled); at the ninth
# the proxy made, the same to the bit as baked whole; then it rests.
frame 0.0
expect sliced.stage.result[0] = 1
expect apart.result[0] > 100
frame 0.1
frame 0.2
frame 0.3
frame 0.4
frame 0.5
frame 0.6
frame 0.7
frame 0.8
expect sliced.stage.result[0] = 9
expect apart.result[0] = 0
frame 0.9
expect sliced.stage.result[0] = 10
expect apart.result[0] = 0

# The ball moved: baking starts again, the proxy in use the last one made
# (the ball where it was) while the new one floods, then the new one,
# whole, the same as baked whole again.
param shift 0.3
frame 1.0
expect sliced.stage.result[0] = 1
expect sliced.published.result[16912].x = 0.8672 0.001
expect baked.proxy[16912].x = 0.6866 0.001
frame 1.1
frame 1.2
frame 1.3
frame 1.4
frame 1.5
frame 1.6
frame 1.7
expect apart.result[0] = 0.3004 0.001
frame 1.8
expect apart.result[0] = 0
expect sliced.published.result[16912].x = 0.6866 0.001
