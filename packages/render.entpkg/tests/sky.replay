scene sky.esn
window 320 180

# The sky over the stand in the afternoon, the gray ball in the low sun,
# the glowing ball; the sun as the air leaves it (warm), the sky overhead
# (blue), the light scattered more than once on the ground under a sun
# overhead (bluish).
frame 0.0
expect 160 3 = 0.561 0.537 0.502 0.02
expect 45 115 = 0.752 0.674 0.546 0.02
expect 255 117 = 0.947 0.752 0.283 0.02
expect air.look.result[0].sun_color = 3.2087 2.3588 1.4385 0.01
expect air.look.result[0].zenith = 0.01307 0.02661 0.06042 0.001
expect air.spread.result[31] = 0.05318 0.05888 0.07153 1 0.001

# The cascades' shadows: a ball's shadow whole, and an edge the sun's disc
# softens.
expect sunlit.result[37500] = 0 0 0 0 0.01
expect sunlit.result[20560] = 0.477 0 0 0 0.1
