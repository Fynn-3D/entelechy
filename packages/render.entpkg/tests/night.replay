scene night.esn
window 320 180

# The gray ball under the spotlight, the floor in its pool of light, the
# red lamp's glow between the rows, the glowing ball's glow, the floor
# mirroring the balls (and the red lamp's light bounced) under fog, the
# clouds overhead, a ball's side lit by the cyan panel.
frame 0.0
expect 45 115 = 0.926 0.900 0.856 0.02
expect 20 100 = 0.216 0.228 0.289 0.02
expect 155 75 = 1.000 0.704 0.474 0.02
expect 255 117 = 0.970 0.825 0.416 0.02
expect 80 150 = 0.157 0.103 0.132 0.02
expect 160 5 = 0.150 0.104 0.136 0.02
expect 215 85 = 0.690 0.765 0.787 0.02

# The lens reflected in the floor; a tile of sky no lamp reaches, a tile
# the spotlight and the panel reach; the exposure metered (a factor, the
# time it was set), held where the picture holds.
expect mirror_lens.result[0].eye = 0 -3.915964 5.8612556 0.001
expect lit.lamp_tiles.result[0] = 0 0 0 0
expect lit.lamp_tiles.result[100] = 5 0 0 0
expect exposed.meter.result[0].factor = 2.6387 0.02
frame 0.1
expect exposed.meter.result[0].set_at = 0.1 0.001
