// The stand path-traced, the light under its wax ball spread (8 cm, as wax
// carries it), finished at the picture's size and scaled to the window by
// the edge-aware upscale.
node stand: graph "stand_scene.esn" { }
// No lamps beside the sun.
node no_lamps: render.lamps_none@1 { domain = 1; }
node light: graph "../graphs/path_tracer.esn" { lamps <- no_lamps.result; lens <- stand.lens; sky <- stand.sky; surface <- stand.surface; paint <- stand.paint; extra <- stand.extra; layers <- stand.layers; more <- stand.more;
    behind_at <- stand.behind_at; behind_dir <- stand.behind_dir; behind_paint <- stand.behind_paint; behind_normal <- stand.behind_normal; through <- stand.through;
    proxy <- stand.proxy; land <- stand.land; frame <- stand.frame; bounces = 2; }
node skin: graph "../graphs/subsurface.esn" { hdr <- light.hdr; scatter <- light.scatter; surface <- stand.surface; layers <- stand.layers; lens <- stand.lens; reach = 0.08; }
node inner: graph "../graphs/tonemap.esn" { hdr <- skin.hdr; exposure = 0.8; }
node shown: graph "../graphs/upscale.esn" { picture <- inner.result; amount = 0.3; }

output result <- shown.result;
