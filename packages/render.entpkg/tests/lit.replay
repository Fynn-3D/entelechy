scene lit.esn
window 160 90

# Lit as it is, through the finish, the cinema
# film's look and depth of field: the gray ball, the car paint, the
# glowing ball, and its widescreen bars black above and below.
frame 0.0
expect 23 59 = 0.573 0.564 0.554 0.01
expect 40 57 = 0.886 0.462 0.446 0.01
expect 118 59 = 1.011 0.947 0.737 0.01
expect 10 85 = 0.000 0.000 0.000 0.01
expect 80 10 = 0.000 0.000 0.000 0.01

# Dynamic resolution at its most, the window's extent; a sunlit floor
# pixel keeps its visibility through the contact shadow; the focus moves toward the
# middle's distance; two copies of one G-buffer merge into it.
expect extent.result[0] = 160
expect extent.result[1] = 88
expect size.result[0] = 160 88
expect shadowed.result[9140] = 1 0 0 0
expect focus.result[0] = 8.0615 0.001
expect merged.surface[7280] = 0 1 0 9.5043 0.001
expect stand.surface[7280] = 0 1 0 9.5043 0.001
expect nothing.result[0] = 0 0 0 1
expect no_sun.result[0].half = 0
expect 80 45 = 0.176 0.142 0.175 0.01

# Lit deep inside the coarse shape (as a leaf in its crown): a shaded
# floor pixel keeps `inside_sky` of the light all round times its baked
# occlusion, brighter than the coarse scene leaves it; none at 0.
expect lit_deep.result[7280] = 0.0926 0.1003 0.1180 1 0.001
expect lit_dark.result[7280] = 0 0 0 1 0.001

# Ray traced: a smooth metal ball's mirror ray traced through the
# proxies, brighter than lit's sky alone; a matte floor pixel as lit
# has it.
expect traced.result[9539] = 0.3512 0.3745 0.4239 1 0.002
expect traced.result[12880] = 0.2318 0.2365 0.2513 1 0.002

# Lit as a painting has it with stylized edges, and clay: the gray ball.
expect inked.result[9463] = 0.2422 0.2618 0.3218 1 0.002
expect clay.result[9463] = 0.5058 0.5087 0.5150 1 0.002

# Ray traced over a polished floor: the floor's mirror rays leave it clear
# of the ground before they count what they meet, so a floor pixel shows
# what stands round it, not the floor it left.
expect traced_floor.result[11200] = 0.2405 0.2471 0.2655 1 0.0005

# A scene's own look, set in the scene: lit with half the sky's light (a
# shaded floor pixel about half as bright), ray traced with its mirrors
# held at 0.1 (the mirror ball dark), painted with its shade untinted
# (the shaded floor no longer cool).
expect lit_tuned.result[7280] = 0.0098 0.0105 0.0124 1 0.0005
expect traced_tuned.result[9539] = 0.0800 0.0804 0.0804 1 0.001
expect painted_tuned.result[7280] = 0.0208 0.0217 0.0239 1 0.0005
