scene probe_gi.esn
window 160 90

# The gray ball, the car paint, the glowing ball, the floor and the sky.
frame 0.0
expect 23 59 = 0.554 0.552 0.560 0.01
expect 40 57 = 0.849 0.485 0.488 0.01
expect 118 59 = 1.000 0.935 0.727 0.01
expect 10 85 = 0.538 0.542 0.558 0.01
expect 80 10 = 0.732 0.722 0.714 0.01

# The wax ball's matte light, the share that scatters under it, spread
# (a little brighter in green and red there, from round about); the floor
# beside it scatters nothing.
expect light.shade.scatter[9840] = 1.0488 0.8527 0.6105 0 0.01
expect skin.down.result[9840] = 1.0544 0.8665 0.6129 0 0.01
expect light.shade.scatter[9600] = 0 0 0 0 0

# The lens rests: each frame's gathered rays are new and their mean is
# kept (the frames rested and counted in all).
frame 0.0167
frame 0.0333
expect light.count.result[0].n = 2
expect light.count.result[0].total = 3
