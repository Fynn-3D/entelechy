// The lens, and the proxies (the coarse scene a renderer traces shadows and bounces through): a volume of distance and color, and a
// ground height map, both placed where `Proxy` says.
use "geometry.entpkg";

/// The depth of the sky (where a view ray meets nothing).
fn no_hit() -> Float { return 1000000.0; }

// ------------------------------------------------------------------ the lens

struct Lens { eye: Vec3; ahead: Vec3; right: Vec3; up: Vec3; focal: Float; }
type Lenses = Rows<Lens>;
/// The view ray of pixel `q` (in a picture `extent` large).
fn ray(l: Lens, q: Vec2, extent: Vec2) -> Vec3 {
    let uv = ((q + 0.5) / extent - 0.5) * vec2(extent.x / extent.y, -1.0);
    return normalize(l.ahead * l.focal + l.right * uv.x + l.up * uv.y);
}

/// The pixel of a screen `extent` large a world point `p` falls on (xy), and how far from the camera it is (z); behind
/// the camera, z is negative.
fn project(l: Lens, p: Vec3, extent: Vec2) -> Vec3 {
    let d = p - l.eye;
    let ahead = dot(d, l.ahead);
    let uv = vec2(dot(d, l.right), dot(d, l.up)) / max(ahead, 0.0001) * l.focal;
    let px = (uv / vec2(extent.x / extent.y, -1.0) + 0.5) * extent;
    return vec3(px.x, px.y, if ahead > 0.0 { length(d) } else { -1.0 });
}

/// A world point `p`'s clip coordinates for the rasterizer (a picture `extent` large; near and far clipping planes `near` and
/// `far` meters): x, y, depth times w, and w the distance along the lens's facing.
fn lens_clip(l: Lens, extent: Vec2, p: Vec3, near: Float, far: Float) -> Vec4 {
    let d = p - l.eye;
    let ahead = dot(d, l.ahead);
    let aspect = extent.x / max(extent.y, 1.0);
    return vec4(dot(d, l.right) * l.focal * 2.0 / aspect, dot(d, l.up) * l.focal * 2.0, (ahead - near) * far / (far - near), ahead);
}

/// A ray on the screen (for screen-space reflections and reflections close to a surface): from `p` along `dir` for `far` meters, at most 48 steps
/// (`steps` steps, dense near and sparse far, the start jittered by `jitter` steps), projected onto the screen against the G-buffer's depth; where it passes
/// behind the thing in some pixel (no thicker than `thick` meters), it met it. The pixel met (xy) and how far it went
/// (z); z is -1 where it met nothing.
fn screen_march(surface: Grid<Vec4>, l: Lens, extent: Vec2, p: Vec3, dir: Vec3, far: Float, steps: Int, thick: Float, jitter: Float) -> Vec3 {
    return loop 48 with r = vec3(0.0, 0.0, -1.0) until r.z >= 0.0 || index() >= steps {
        // Dense first, then sparse: short steps near, so a reflection close to a surface does not skip it.
        let t = far * pow((float(index()) + jitter) / float(steps), 2.0);
        let x = p + dir * t;
        let d = x - l.eye;
        let ahead = dot(d, l.ahead);
        let uv = vec2(dot(d, l.right), dot(d, l.up)) / max(ahead, 0.001) * l.focal;
        let q = vec2(uv.x * extent.y + extent.x * 0.5 - 0.5, extent.y * 0.5 - uv.y * extent.y - 0.5);
        let inside = ahead > 0.05 && q.x >= 0.0 && q.y >= 0.0 && q.x <= extent.x - 1.0 && q.y <= extent.y - 1.0;
        let o = if inside { at(surface, floor(q + 0.5)) } else { vec4(0.0, 0.0, 0.0, no_hit()) };
        let behind = length(d) - o.w;
        if inside && o.w < no_hit() * 0.5 && behind > 0.02 && behind < thick && t > 0.03 { vec3(floor(q.x + 0.5), floor(q.y + 0.5), t) } else { r }
    };
}


/// The lens: turning round the point it looks at (`target`), `dist` from it; `goal` is the point double-clicked or chosen by F,
/// toward which the lens glides; the last frame's pointer, the buttons held (bits: left, right or middle), the moment the left button
/// last went down; and how many frames the lens has not moved (`still`, for accumulating).
struct Orbit { target: Vec3; goal: Vec3; gliding: Bool; yaw: Float; pitch: Float; dist: Float; pointer_at: Vec2; held: Int; clicked_t: Float; still: Int; }
type Orbits = Rows<Orbit>;
fn orbit_lens(c: Orbit, focal: Float) -> Lens {
    let eye = orbit_eye(c.target, c.yaw, c.pitch, c.dist);
    let ahead = normalize(c.target - eye);
    let right = normalize(cross(ahead, vec3(0.0, 1.0, 0.0)));
    return Lens { eye: eye, ahead: ahead, right: right, up: cross(right, ahead), focal: focal };
}
/// As it begins: looking at (`x`, `y`, `z`) from the direction of `yaw` and `pitch`, `dist` away.
kernel render.cam_start@1 {
    requires { field.write; }
    param x: Float = 0.0;
    param y: Float = 1.0;
    param z: Float = 0.0;
    param yaw: Float = 0.0;
    param pitch: Float = 0.1;
    param dist: Float = 8.0;
    output result: Orbits;
    compute {
        let o = vec3(x, y, z);
        return Orbit { target: o, goal: o, gliding: false, yaw: yaw, pitch: pitch, dist: dist, pointer_at: vec2(0.0, 0.0), held: 0, clicked_t: -1.0, still: 0 };
    }
}
/// The lens worked: the left button drags to turn, the right or middle to pan, the wheel dollies, a double-click or F flies to the point under the pointer
/// (read from the last frame's small depth map `depths`, `render.depths`), W A S D walk, Q E fall and rise, Shift held
/// is fast, R returns to `home`. The lens never goes under the ground (`land`).
kernel render.cam@1 {
    requires { field.read; field.write; input.read; time.read; }
    input previous: Orbits;
    input home: Orbits;
    input depths: Grid<Float>;
    input land: Grid<Float>;
    input frame: Proxies;
    param focal: Float = 1.3;
    /// The furthest the lens may be from the point it looks at (meters).
    param most: Float = 200.0;
    output result: Orbits;
    compute {
        let c = at(previous, 0);
        let t = time();
        let p = pointer();
        let left = button(0) || pointer_down();
        let right = button(1) || button(2);
        let held = int(left) | (int(right) << 1);
        let d = p - c.pointer_at;
        let turning = left && (c.held & 1) != 0 && length(d) > 0.0;
        let panning = right && (c.held & 2) != 0 && length(d) > 0.0;
        let yaw = if turning { c.yaw - d.x * 0.005 } else { c.yaw };
        let l = orbit_lens(c, focal);
        let pan = if panning { (l.right * (0.0 - d.x) + l.up * d.y) * c.dist / max(window().y, 1.0) / focal * 2.0 } else { vec3(0.0, 0.0, 0.0) };
        let fast = if key(16) { 4.0 } else { 1.0 };
        let flat = normalize(vec3(l.ahead.x, 0.0, l.ahead.z));
        let side = normalize(vec3(l.right.x, 0.0, l.right.z));
        let walk = (flat * ((if key(87) { 1.0 } else { 0.0 }) - (if key(83) { 1.0 } else { 0.0 }))
            + side * ((if key(68) { 1.0 } else { 0.0 }) - (if key(65) { 1.0 } else { 0.0 }))
            + vec3(0.0, 1.0, 0.0) * ((if key(69) { 1.0 } else { 0.0 }) - (if key(81) { 1.0 } else { 0.0 }))) * (0.03 + c.dist * 0.012) * fast;
        let fresh = left && (c.held & 1) == 0;
        let pick = (fresh && t - c.clicked_t < 0.3) || key(70);
        // The depth under the pointer: the last frame's small depth map.
        let sz = size(depths);
        let at_p = clamp(floor(p * sz / max(window(), vec2(1.0, 1.0))), vec2(0.0, 0.0), sz - vec2(1.0, 1.0));
        let depth = at(depths, at_p);
        let dir = ray(l, p, window());
        // A depth of 0, or the sky: nothing under the pointer (a scene with no depth map gives one of zeros).
        let picked = pick && depth > 0.0 && depth < no_hit() * 0.5;
        let goal = if picked { l.eye + dir * depth } else { c.goal + pan + walk };
        let gliding = if picked { true } else if turning || panning || length(walk) > 0.0 { false } else { c.gliding && length(c.target - c.goal) > 0.002 };
        let target = if gliding { mix(c.target, goal, 0.15) } else { c.target + pan + walk };
        let dist0 = if picked { min(c.dist, 2.0) } else { c.dist };
        let zoom = wheel().y;
        let dist = clamp(dist0 * pow(0.88, zoom), 0.2, most);
        let low = asin(clamp((land_at(land, frame, target.x, target.z) + 0.15 - target.y) / dist, -1.0, 1.0));
        let pitch = clamp(if turning { c.pitch + d.y * 0.004 } else { c.pitch }, max(low, -1.2), 1.5);
        let moved = turning || panning || length(walk) > 0.0 || gliding || picked || zoom != 0.0 || key(82);
        let next = Orbit { target: target, goal: if gliding { goal } else { target }, gliding: gliding, yaw: yaw, pitch: pitch, dist: dist,
            pointer_at: p, held: held, clicked_t: if fresh { t } else { c.clicked_t }, still: if moved { 0 } else { min(c.still + 1, 100000) } };
        return if key(82) { Orbit { ..at(home, 0), pointer_at: p, held: held } } else { next };
    }
}
/// Whether the lens has stopped: 1 stopped, 0 moving. While the lens rests it does not change, so a node computed only once it has
/// stopped (the full-resolution G-buffer) is computed once.
kernel render.settled@1 {
    requires { field.read; field.write; }
    input cam: Orbits;
    output result: Rows<Int>;
    compute { return if at(cam, 0).still > 0 { 1 } else { 0 }; }
}
/// The small depth map: the middle pixel's depth of each 8 by 8, for picking with the lens (the whole G-buffer
/// is too large to hand the lens each frame).
kernel render.depths@1 {
    requires { field.read; field.write; }
    input surface: Grid<Vec4>;
    output result: Grid<Float>;
    compute { return at(surface, min(coord() * 8.0 + 4.0, size(surface) - vec2(1.0, 1.0))).w; }
}
/// The G-buffer, moving and settled: while the lens moves, the shrunk `rough_*` (one for each `shrink` by `shrink`
/// pixels, the nearest taken, not blended across edges); once it stops, the full-resolution `fine_*`. All five are swapped.
kernel render.settle@1 {
    requires { field.read; field.write; }
    input fine_surface: Grid<Vec4>;
    input fine_paint: Grid<Vec4>;
    input fine_extra: Grid<Vec4>;
    input rough_surface: Grid<Vec4>;
    input rough_paint: Grid<Vec4>;
    input rough_extra: Grid<Vec4>;
    input fine_layers: Grid<Vec4>;
    input fine_more: Grid<Vec4>;
    input rough_layers: Grid<Vec4>;
    input rough_more: Grid<Vec4>;
    input settled: Rows<Int>;
    param shrink: Int = 2;
    output surface: Grid<Vec4>;
    output paint: Grid<Vec4>;
    output extra: Grid<Vec4>;
    output layers: Grid<Vec4>;
    output more: Grid<Vec4>;
    compute {
        let q = coord();
        if at(settled, 0) == 1 { return { surface: at(fine_surface, q), paint: at(fine_paint, q), extra: at(fine_extra, q), layers: at(fine_layers, q), more: at(fine_more, q) }; }
        let r = min(floor(q / float(shrink)), size(rough_surface) - vec2(1.0, 1.0));
        return { surface: at(rough_surface, r), paint: at(rough_paint, r), extra: at(rough_extra, r), layers: at(rough_layers, r), more: at(rough_more, r) };
    }
}
kernel render.lens@1 {
    requires { field.read; field.write; }
    input cam: Orbits;
    param focal: Float = 1.3;
    output result: Lenses;
    compute { return orbit_lens(at(cam, 0), focal); }
}

// ------------------------------------------------------------------ the proxies

/// Where the proxies lie: the distance volume from `lo`, `cell` meters a cell, `cells` cells; the ground height map from
/// (`land_lo`), `land_cell` meters a cell; the ground's color `ground` (linear). A scene's `Proxies` hold one row a level,
/// finest first (one row: one level); its volume holds the levels' cells one after another up its depth, and the first row's
/// ground is every level's.
struct Proxy { lo: Vec3; cell: Float; cells: Vec3; land_lo: Vec2; land_cell: Float; ground: Vec3; }
type Proxies = Rows<Proxy>;

/// How high the ground is at (`x`, `z`); past the map, its edge (the ground map is every level's, the first's frame says where).
fn land_at(land: Grid<Float>, frame: Proxies, x: Float, z: Float) -> Float {
    let fr = at(frame, 0);
    let c = (vec2(x, z) - fr.land_lo) / fr.land_cell;
    return at_linear(land, clamp(c, vec2(0.0, 0.0), size(land) - vec2(1.0, 1.0)));
}
/// The finest level of the proxies holding `p` (x; -1 none) and how deep in the volume its cells start (y): the levels lie up
/// the volume's depth one after another, finest first.
fn proxy_level(frame: Proxies, p: Vec3) -> Vec2 {
    let r = loop 8 with r = vec3(-1.0, 0.0, 0.0) until r.x >= 0.0 || index() >= count(frame) {
        let fr = at(frame, index());
        let c = (p - fr.lo) / fr.cell;
        let n = fr.cells - vec3(1.0, 1.0, 1.0);
        let inside = c.x >= 0.0 && c.y >= 0.0 && c.z >= 0.0 && c.x <= n.x && c.y <= n.y && c.z <= n.z;
        if inside { vec3(float(index()), r.y, 0.0) } else { vec3(-1.0, r.y + fr.cells.z, 0.0) }
    };
    return vec2(r.x, r.y);
}
/// How deep in the volume level `k`'s cells start (the levels before it, one after another).
fn proxy_depth(frame: Proxies, k: Int) -> Float {
    return loop k with z = 0.0 { z + at(frame, index()).cells.z };
}
/// The size of the proxies' cells at `p`: the finest level's holding it, the coarsest's past them all.
fn proxy_cell(frame: Proxies, p: Vec3) -> Float {
    let k = proxy_level(frame, p).x;
    return at(frame, if k >= 0.0 { int(k) } else { count(frame) - 1 }).cell;
}
/// The proxy at `p` (trilinear, in the finest level holding it): the distance to rock (x) and its color (yzw); outside every
/// level, very far (x is `far`).
fn proxy_at(proxy: Volume<Vec4>, frame: Proxies, p: Vec3, far: Float) -> Vec4 {
    let k = proxy_level(frame, p);
    if k.x < 0.0 { return vec4(far, 0.0, 0.0, 0.0); }
    let fr = at(frame, int(k.x));
    let c = (p - fr.lo) / fr.cell;
    return at_linear(proxy, vec3(c.x, c.y, c.z + k.y));
}
/// How far `p` is from things in the coarse scene (x), and what is nearest (y: 0 ground, 1 rock).
fn rough_probe(proxy: Volume<Vec4>, land: Grid<Float>, frame: Proxies, p: Vec3) -> Vec2 {
    let g = (p.y - land_at(land, frame, p.x, p.z) - 0.03) * 0.85;
    let c = proxy_at(proxy, frame, p, 4.0).x;
    return if g < c { vec2(g, 0.0) } else { vec2(c, 1.0) };
}
/// A coarse ray: the distance where it met something (x) and what (y; -1 nothing met). Close to a surface it errs, so a ray
/// counts a hit only once `start` meters from the surface it left.
fn rough_trace(proxy: Volume<Vec4>, land: Grid<Float>, frame: Proxies, o: Vec3, dir: Vec3, start: Float, far: Float, steps: Int) -> Vec2 {
    let m = loop 128 with m = vec3(start, -1.0, 0.0) until m.z > 0.5 || m.x > far || index() >= steps {
        let w = rough_probe(proxy, land, frame, o + dir * m.x);
        if w.x < 0.04 { vec3(m.x, w.y, 1.0) } else { vec3(m.x + max(w.x, 0.05), -1.0, 0.0) }
    };
    return if m.z > 0.5 { vec2(m.x, m.y) } else { vec2(far, -1.0) };
}
/// A coarse ray from a true surface (the G-buffer's), which often lies inside its own coarse shape: it first
/// walks out of the coarse shape it starts in (at most `most` meters), counting hits from there; deeper than that it is truly enclosed,
/// and counts from `start` as ever. Starting outside every coarse shape, it is `start`.
fn rough_leave(proxy: Volume<Vec4>, frame: Proxies, o: Vec3, dir: Vec3, start: Float, most: Float) -> Float {
    let m = loop 24 with m = vec2(start, 0.0) until m.y > 0.5 || m.x > most {
        let c = proxy_at(proxy, frame, o + dir * m.x, 4.0).x;
        if c >= 0.04 { vec2(m.x, 1.0) } else { vec2(m.x + max(0.0 - c, 0.05), 0.0) }
    };
    return if m.y > 0.5 { m.x } else { start };
}
/// The coarse normal: the ground's from the height map's slope, rock's from the volume's gradient (a cell of its level apart).
fn rough_normal(proxy: Volume<Vec4>, land: Grid<Float>, frame: Proxies, p: Vec3, what: Float) -> Vec3 {
    if what < 0.5 {
        let e = at(frame, 0).land_cell * 2.0;
        return normalize(vec3(land_at(land, frame, p.x - e, p.z) - land_at(land, frame, p.x + e, p.z), 2.0 * e, land_at(land, frame, p.x, p.z - e) - land_at(land, frame, p.x, p.z + e)));
    }
    let e = proxy_cell(frame, p);
    return normalize(vec3(proxy_at(proxy, frame, p + vec3(e, 0.0, 0.0), 4.0).x - proxy_at(proxy, frame, p - vec3(e, 0.0, 0.0), 4.0).x,
        proxy_at(proxy, frame, p + vec3(0.0, e, 0.0), 4.0).x - proxy_at(proxy, frame, p - vec3(0.0, e, 0.0), 4.0).x,
        proxy_at(proxy, frame, p + vec3(0.0, 0.0, e), 4.0).x - proxy_at(proxy, frame, p - vec3(0.0, 0.0, e), 4.0).x) + vec3(0.0, 0.0001, 0.0));
}
/// The coarse shadow: how much of the way from `p` along `dir` is blocked (1 lit, 0 blocked, soft at the edges).
fn rough_shadow(proxy: Volume<Vec4>, land: Grid<Float>, frame: Proxies, p: Vec3, dir: Vec3, start: Float, far: Float, steps: Int) -> Float {
    let r = loop 96 with r = vec2(start, 1.0) until r.x > far || r.y < 0.01 || index() >= steps {
        let d = rough_probe(proxy, land, frame, p + dir * r.x).x;
        vec2(r.x + clamp(d, 0.05, 3.0), min(r.y, 10.0 * d / r.x))
    };
    return saturate(r.y);
}
/// The color of what was met: `ground` for the ground, the volume's for rock.
fn rough_albedo(proxy: Volume<Vec4>, frame: Proxies, p: Vec3, what: Float) -> Vec3 {
    if what < 0.5 { return at(frame, 0).ground; }
    let a = proxy_at(proxy, frame, p, 4.0);
    return vec3(a.y, a.z, a.w);
}

/// A direction drawn by cosine from the hemisphere about `n` (`u1` and `u2` random numbers from 0 to 1).
fn cosine_dir(n: Vec3, u1: Float, u2: Float) -> Vec3 {
    let r = sqrt(u1);
    let a = 6.2831853 * u2;
    let t = normalize(if abs(n.y) < 0.9 { cross(n, vec3(0.0, 1.0, 0.0)) } else { cross(n, vec3(1.0, 0.0, 0.0)) });
    let b = cross(n, t);
    return normalize(t * (r * cos(a)) + b * (r * sin(a)) + n * sqrt(max(1.0 - u1, 0.0)));
}
