// Gloss under a pixel: where a glossy surface's normal turns a lot within
// one pixel (water far off, a curved panel, fine relief), a highlight would
// flash from pixel to pixel. Each pixel's roughness is widened by how much
// its normals spread across it (Kaplanyan and Hoffman's), read from the
// G-buffer's neighbors at its own depth: what a pixel shows is the mean of
// what its spread of normals reflects. A G-buffer pass, before a renderer.
use "camera.ent";

/// The G-buffer's `paint` with each pixel's roughness (w) widened by the
/// spread of its normals across the pixel; `most` caps how much rougher the
/// spread alone may make it (as a GGX alpha squared).
kernel render.specular_aa@1 {
    requires { field.read; field.write; }
    input paint: Grid<Vec4>;
    input surface: Grid<Vec4>;
    param most: Float = 0.18;
    output result: Grid<Vec4>;
    compute {
        let c = sample(paint);
        let s = sample(surface);
        if s.w > no_hit() * 0.5 { return c; }
        let q = coord();
        let ext = size(surface) - vec2(1.0, 1.0);
        let right = at(surface, min(q + vec2(1.0, 0.0), ext));
        let down = at(surface, min(q + vec2(0.0, 1.0), ext));
        // A neighbor counts only on the same surface (a near depth).
        let near = s.w * 0.02 + 0.01;
        let dx = if abs(right.w - s.w) < near { right.xyz - s.xyz } else { vec3(0.0, 0.0, 0.0) };
        let dy = if abs(down.w - s.w) < near { down.xyz - s.xyz } else { vec3(0.0, 0.0, 0.0) };
        let spread = min(0.5 * (dot(dx, dx) + dot(dy, dy)), most);
        let a = c.w * c.w;
        return vec4(c.x, c.y, c.z, sqrt(sqrt(a * a + spread)));
    }
}
