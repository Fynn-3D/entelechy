// Standard PBR: metalness and roughness, as glTF's, Unreal's and Blender's Principled BSDF
// agree. Scenes, materials and renderers all use this one: the light a lamp gives (`lit_by`), the light
// round about gives (`ambient_by`), GGX sampling for path tracing (`ggx_sample`,
// `ggx_weight`).
//
// Layers: the base's diffuse (Lambert; with subsurface scattering light wraps into the shade and through thin parts) and specular
// (GGX's distribution of normals, anisotropic if asked; Smith's geometry term with Unreal's k; Schlick's Fresnel, a
// non-metal's reflection head-on by its index of refraction), sheen over the base (Charlie's distribution, bright at grazing angles, velvet and cloth),
// and a clearcoat over all (4% head-on, its own roughness; what it reflects the base loses). The environment's
// specular light is Karis's analytic approximation. Transmission (glass, water) is recorded here, and refracted by the renderer.

/// A surface. Its color (linear; a non-metal's diffuse color, a metal's specular color), roughness
/// (0 a mirror to 1 fully rough, as perceived; GGX takes its square), metalness (0 to 1), emission
/// (HDR), index of refraction (a non-metal's head-on reflection follows it: 1.5 is 4%), how much clearcoat and its roughness,
/// sheen (0 to 1), subsurface scattering (0 to 1, colored by the base), anisotropy (0 to 1, the specular
/// stretched along the tangent), transmission (0 to 1).
struct Pbr { albedo: Vec3; rough: Float; metal: Float; glow: Vec3; ior: Float; clearcoat: Float; coat_rough: Float; sheen: Float; subsurface: Float; anisotropy: Float; transmission: Float; }

/// A surface of color, roughness and metalness alone, the rest by default (index of refraction 1.5, no clearcoat, sheen,
/// subsurface scattering, anisotropy, transmission or emission).
fn pbr(albedo: Vec3, rough: Float, metal: Float) -> Pbr {
    return Pbr { albedo: albedo, rough: rough, metal: metal, glow: vec3(0.0, 0.0, 0.0), ior: 1.5, clearcoat: 0.0, coat_rough: 0.05, sheen: 0.0, subsurface: 0.0, anisotropy: 0.0, transmission: 0.0 };
}

/// How much is reflected head-on: by the index of refraction for a non-metal (1.5 is 4%), its own color for a metal.
fn pbr_f0(m: Pbr) -> Vec3 {
    let f = (m.ior - 1.0) / (m.ior + 1.0);
    return mix(vec3(f * f, f * f, f * f), m.albedo, m.metal);
}
/// GGX's α (the square of roughness; too small, clamped to 0.03 squared, so no pinpoint highlights).
fn pbr_alpha(rough: Float) -> Float { let r = max(rough, 0.03); return r * r; }
/// GGX's distribution of normals.
fn ggx_d(nh: Float, a: Float) -> Float {
    let a2 = a * a;
    let t = nh * nh * (a2 - 1.0) + 1.0;
    return a2 / (3.14159265 * t * t);
}
/// Anisotropic GGX: α along the tangent `t` is `ax`, along the bitangent `b` is `ay`.
fn ggx_d_aniso(h: Vec3, n: Vec3, t: Vec3, b: Vec3, ax: Float, ay: Float) -> Float {
    let x = dot(t, h) / ax;
    let y = dot(b, h) / ay;
    let z = dot(n, h);
    let s = x * x + y * y + z * z;
    return 1.0 / (3.14159265 * ax * ay * s * s);
}
/// A surface's tangent: the direction round the world's vertical axis (brushing runs along it; x for faces up or down).
fn pbr_tangent(n: Vec3) -> Vec3 {
    let t = cross(vec3(0.0, 1.0, 0.0), n);
    return if length(t) < 0.001 { vec3(1.0, 0.0, 0.0) } else { normalize(t) };
}
/// Smith's geometry term (direct light, k = (roughness + 1)² / 8).
fn smith_g(nl: Float, nv: Float, rough: Float) -> Float {
    let k = (rough + 1.0) * (rough + 1.0) / 8.0;
    return nl / (nl * (1.0 - k) + k) * nv / (nv * (1.0 - k) + k);
}
/// Schlick's Fresnel: how much is reflected at an angle whose cosine is `c`.
fn schlick(f0: Vec3, c: Float) -> Vec3 { return f0 + (vec3(1.0, 1.0, 1.0) - f0) * pow(1.0 - saturate(c), 5.0); }
/// Sheen's color: white with half of the base's.
fn sheen_tint(m: Pbr) -> Vec3 { return mix(vec3(1.0, 1.0, 1.0), m.albedo, 0.5) * m.sheen; }
/// Sheen (Charlie's distribution, roughness 0.5, with Neubelt's visibility): bright at grazing angles.
fn sheen_term(nh: Float, nl: Float, nv: Float) -> Float {
    let inv = 2.0;
    let sin2 = max(1.0 - nh * nh, 0.0001);
    let d = (2.0 + inv) * pow(sin2, inv * 0.5) / 6.2831853;
    return d / (4.0 * (nl + nv - nl * nv));
}

/// The light one lamp gives: a surface of normal `n` seen from `v`, light from `l`, its irradiance here
/// `light` (occlusion already multiplied in).
fn lit_by(m: Pbr, n: Vec3, v: Vec3, l: Vec3, light: Vec3) -> Vec3 {
    let nl_raw = dot(n, l);
    let kd = (1.0 - m.metal) * (1.0 - m.transmission);
    // Subsurface scattering: light wraps into the shade (wrapped diffuse) and comes through thin parts (seen against the light).
    let wrap = saturate((nl_raw + 0.5) / 1.5);
    let through = pow(saturate(dot(vec3(0.0, 0.0, 0.0) - l, v)), 4.0) * 0.35;
    let scattered = m.albedo * kd * m.subsurface * (wrap / 3.14159265 * 0.8 + through);
    if nl_raw <= 0.0 { return scattered * light; }
    let nl = nl_raw;
    let nv = max(dot(n, v), 0.001);
    let h = normalize(v + l);
    let nh = max(dot(n, h), 0.0);
    let vh = max(dot(v, h), 0.0);
    let f = schlick(pbr_f0(m), vh);
    let a = pbr_alpha(m.rough);
    let t = pbr_tangent(n);
    let d = if m.anisotropy > 0.0 { ggx_d_aniso(h, n, t, cross(n, t), max(a * (1.0 + m.anisotropy), 0.001), max(a * (1.0 - m.anisotropy * 0.9), 0.001)) } else { ggx_d(nh, a) };
    let spec = f * (d * smith_g(nl, nv, m.rough) / (4.0 * nl * nv));
    let diffuse = (vec3(1.0, 1.0, 1.0) - f) * m.albedo * kd / 3.14159265 * (1.0 - m.subsurface);
    let velvet = sheen_tint(m) * sheen_term(nh, nl, nv) * (1.0 - m.metal);
    let base = (diffuse + spec + velvet) * nl + scattered;
    // Clearcoat: what it reflects (Fresnel), the base loses.
    let fc = schlick(vec3(0.04, 0.04, 0.04), vh).x * m.clearcoat;
    let coat = fc * ggx_d(nh, pbr_alpha(m.coat_rough)) * smith_g(nl, nv, m.coat_rough) / (4.0 * nl * nv) * nl;
    return (base * (1.0 - fc) + vec3(coat, coat, coat)) * light;
}
/// The specular part alone of `lit_by` (the base's GGX lobe and the
/// clearcoat's), for a light whose diffuse share is found apart (an area
/// light's, exactly): a surface of normal `n` seen from `v`, the light from
/// `l`, its irradiance `light`.
fn glossy_by(m: Pbr, n: Vec3, v: Vec3, l: Vec3, light: Vec3) -> Vec3 {
    let nl = dot(n, l);
    if nl <= 0.0 { return vec3(0.0, 0.0, 0.0); }
    let nv = max(dot(n, v), 0.001);
    let h = normalize(v + l);
    let nh = max(dot(n, h), 0.0);
    let vh = max(dot(v, h), 0.0);
    let f = schlick(pbr_f0(m), vh);
    let a = pbr_alpha(m.rough);
    let t = pbr_tangent(n);
    let d = if m.anisotropy > 0.0 { ggx_d_aniso(h, n, t, cross(n, t), max(a * (1.0 + m.anisotropy), 0.001), max(a * (1.0 - m.anisotropy * 0.9), 0.001)) } else { ggx_d(nh, a) };
    let spec = f * (d * smith_g(nl, nv, m.rough) / (4.0 * nl * nv)) * nl;
    let fc = schlick(vec3(0.04, 0.04, 0.04), vh).x * m.clearcoat;
    let coat = fc * ggx_d(nh, pbr_alpha(m.coat_rough)) * smith_g(nl, nv, m.coat_rough) / (4.0 * nl * nv) * nl;
    return (spec * (1.0 - fc) + vec3(coat, coat, coat)) * light;
}
/// The rest of `lit_by` without its specular part (`glossy_by`): the diffuse
/// light, sheen and light wrapped and let through by subsurface scattering
/// — what screen-space subsurface scattering spreads under the skin.
fn matte_by(m: Pbr, n: Vec3, v: Vec3, l: Vec3, light: Vec3) -> Vec3 {
    return lit_by(m, n, v, l, light) - glossy_by(m, n, v, l, light);
}
/// The light that goes under a subsurface surface, to be spread across it
/// (`graphs/subsurface.esn`): its matte light from the sun along `sun`
/// (irradiance `sun_light`) and from round about (`diffuse_light`, the
/// diffuse light reaching it), as much as it scatters; 0 for a surface
/// that does not.
fn scattered_share(m: Pbr, n: Vec3, v: Vec3, sun: Vec3, sun_light: Vec3, diffuse_light: Vec3) -> Vec3 {
    if m.subsurface <= 0.0 { return vec3(0.0, 0.0, 0.0); }
    return (matte_by(m, n, v, sun, sun_light) + m.albedo * ((1.0 - m.metal) * (1.0 - m.transmission)) * diffuse_light) * m.subsurface;
}
/// How much the environment's specular reflects in all (the split-sum BRDF term, Karis's analytic approximation).
fn env_brdf(f0: Vec3, rough: Float, nv: Float) -> Vec3 {
    let r = rough * vec4(-1.0, -0.0275, -0.572, 0.022) + vec4(1.0, 0.0425, 1.04, -0.04);
    let a004 = min(r.x * r.x, exp2(-9.28 * nv)) * r.x + r.y;
    let ab = vec2(-1.04, 1.04) * a004 + vec2(r.z, r.w);
    return f0 * ab.x + vec3(ab.y, ab.y, ab.y);
}
/// The light round about gives: `diffuse_light` the diffuse light reaching here (irradiance over π; times the color it is
/// the diffuse), `spec_light` the light from the base's specular direction (blurred by its roughness, occlusion
/// multiplied in), `coat_light` the light from the clearcoat's reflected direction (by the clearcoat's roughness).
fn ambient_by(m: Pbr, n: Vec3, v: Vec3, diffuse_light: Vec3, spec_light: Vec3, coat_light: Vec3) -> Vec3 {
    let nv = max(dot(n, v), 0.001);
    let e = env_brdf(pbr_f0(m), m.rough, nv);
    let diffuse = m.albedo * (1.0 - m.metal) * (1.0 - m.transmission) * diffuse_light;
    let velvet = sheen_tint(m) * (1.0 - m.metal) * diffuse_light * (0.15 + 0.85 * pow(1.0 - nv, 4.0));
    let ec = env_brdf(vec3(0.04, 0.04, 0.04), m.coat_rough, nv).x * m.clearcoat;
    return (diffuse + spec_light * e + velvet) * (1.0 - ec) + coat_light * ec;
}

/// GGX importance sampling: a microfacet facing drawn near the normal `n` by the distribution of normals (`u1` and `u2` random numbers from 0
/// to 1), and the view ray `v` reflected off it.
fn ggx_sample(n: Vec3, v: Vec3, rough: Float, u1: Float, u2: Float) -> Vec3 {
    let a = pbr_alpha(rough);
    let cos_t = sqrt((1.0 - u1) / (1.0 + (a * a - 1.0) * u1));
    let sin_t = sqrt(max(1.0 - cos_t * cos_t, 0.0));
    let phi = 6.2831853 * u2;
    let t = normalize(if abs(n.y) < 0.9 { cross(n, vec3(0.0, 1.0, 0.0)) } else { cross(n, vec3(1.0, 0.0, 0.0)) });
    let b = cross(n, t);
    let h = normalize(t * (sin_t * cos(phi)) + b * (sin_t * sin(phi)) + n * cos_t);
    return reflect(vec3(0.0, 0.0, 0.0) - v, h);
}
/// What the light brought back along a direction `l` drawn by `ggx_sample` is multiplied by (F G (v·h) / ((n·h)(n·v)));
/// 0 where the direction is below the surface.
fn ggx_weight(m: Pbr, n: Vec3, v: Vec3, l: Vec3) -> Vec3 {
    let nl = dot(n, l);
    if nl <= 0.0 { return vec3(0.0, 0.0, 0.0); }
    let nv = max(dot(n, v), 0.001);
    let h = normalize(v + l);
    let vh = max(dot(v, h), 0.0);
    return schlick(pbr_f0(m), vh) * (smith_g(nl, nv, m.rough) * vh / (max(dot(n, h), 0.001) * nv));
}

/// The occlusion baked into a G-buffer pixel (`extra`'s w; 0 means the scene gave none, taken as 1): ambient occlusion the scene baked
/// from its own geometry, finer than a renderer can find, multiplied into the ambient light.
fn baked_occlusion(extra: Vec4) -> Float { return if extra.w > 0.0 { extra.w } else { 1.0 }; }

/// A G-buffer pixel's material (the contract): `paint` is color and roughness;
/// `extra`'s y is metalness and z emission's strength (emission is the color times it); `layers` are
/// clearcoat, clearcoat roughness, sheen and subsurface scattering; `more` anisotropy, transmission and index of refraction
/// (0 taken as 1.5). All zero is a surface of color, roughness and metalness alone.
fn pbr_of(paint: Vec4, extra: Vec4, layers: Vec4, more: Vec4) -> Pbr {
    return Pbr { albedo: paint.xyz, rough: paint.w, metal: extra.y, glow: paint.xyz * extra.z, ior: if more.z > 1.0 { more.z } else { 1.5 },
        clearcoat: layers.x, coat_rough: if layers.y > 0.0 { layers.y } else { 0.05 }, sheen: layers.z, subsurface: layers.w, anisotropy: more.x, transmission: more.y };
}
