// Clouds: one deck of them (`render.clouds_deck`), walked through for the
// sky's pixels at a small size (`render.clouds_march`), lit by the sun (or
// moon) through the cloud above each point, with light scattered many times
// within (Wrenninge's octaves) and the dark edges of a cloud's sunlit side
// (Beer and powder), the sky light from above and a glow from below (a
// city's at night); `render.fog_apply` lays them over the sky. The same
// deck shades the ground: `render.clouds_shadow` takes the sun it hides
// out of the G-buffer's sun visibility.
use "random.entpkg";
use "camera.ent";
use "phase.ent";
use "sky.ent";

/// A deck of clouds: between `low` and `high` meters, covering `cover` of
/// the sky (0 to 1), `density` thick, billows `scale` meters across, its
/// look drawn from `seed`.
struct CloudDeck { low: Float; high: Float; cover: Float; density: Float; scale: Float; seed: Int; }
type CloudDecks = Rows<CloudDeck>;

/// The deck, from its numbers: what both the clouds drawn and their shadows read.
kernel render.clouds_deck@1 {
    requires { field.write; }
    param low: Float = 1500.0;
    param high: Float = 2600.0;
    param cover: Float = 0.5;
    param density: Float = 0.02;
    param scale: Float = 2400.0;
    param seed: Int = 7;
    output result: CloudDecks;
    compute { return CloudDeck { low: low, high: high, cover: cover, density: density, scale: scale, seed: seed }; }
}

/// How much sunlight the deck lets through to `p` below it, toward `sun`:
/// the cloud along that way walked in `steps` steps (1 clear).
fn cloud_shadow(deck: CloudDeck, p: Vec3, sun: Vec3, steps: Int) -> Float {
    if deck.cover <= 0.0 || sun.y <= 0.02 || p.y >= deck.high { return 1.0; }
    let t_in = max((deck.low - p.y) / sun.y, 0.0);
    let t_out = (deck.high - p.y) / sun.y;
    let dt = min(t_out - t_in, (deck.high - deck.low) * 4.0) / float(max(steps, 1));
    let depth = loop 16 with o = 0.0 until index() >= steps {
        o + cloud_density(deck, p + sun * (t_in + (float(index()) + 0.5) * dt)) * dt
    };
    return exp(0.0 - depth);
}

/// The G-buffer's `extra` with the deck's shadow multiplied into the sun's
/// visibility (x), as `render.contact` is: before a renderer takes it.
kernel render.clouds_shadow@1 {
    requires { field.read; field.write; }
    input extra: Grid<Vec4>;
    input surface: Grid<Vec4>;
    input lens: Lenses;
    input sky: SkyLooks;
    input deck: CloudDecks;
    param steps: Int = 6;
    output result: Grid<Vec4>;
    compute {
        let e = sample(extra);
        let s = sample(surface);
        if e.x <= 0.0 || s.w > no_hit() * 0.5 { return e; }
        let l = at(lens, 0);
        let p = l.eye + ray(l, coord(), size(surface)) * s.w;
        return vec4(e.x * cloud_shadow(at(deck, 0), p, normalize(at(sky, 0).sun), steps), e.y, e.z, e.w);
    }
}

/// The clouds' density at `p`: billows of fbm worn at their edges by finer
/// fbm, thinner toward the deck's bottom and top.
fn cloud_density(deck: CloudDeck, p: Vec3) -> Float {
    let h = saturate((p.y - deck.low) / (deck.high - deck.low));
    let shape = smoothstep(0.0, 0.15, h) * (1.0 - smoothstep(0.55, 1.0, h));
    let base = fbm3(p / deck.scale, 4, deck.seed) * 0.5 + 0.5;
    let worn = fbm3(p / (deck.scale * 0.18), 3, deck.seed + 1) * 0.5 + 0.5;
    return max((base - (1.0 - deck.cover) - worn * 0.18) * shape, 0.0) * deck.density * 6.0;
}

/// How much cloud lies between `p` and the deck's top toward the sun
/// (optical depth), in `steps` steps.
fn cloud_depth_toward(deck: CloudDeck, p: Vec3, sun: Vec3, steps: Int) -> Float {
    let reach = min((deck.high - p.y) / max(sun.y, 0.05), (deck.high - deck.low) * 2.0);
    let dt = reach / float(max(steps, 1));
    return loop 8 with o = 0.0 until index() >= steps {
        o + cloud_density(deck, p + sun * ((float(index()) + 0.5) * dt)) * dt
    };
}

/// The sunlight a point in a cloud passes on toward the eye, `depth` the
/// cloud toward the sun, `cos_angle` between the view and the sun: light
/// scattered once and again (three octaves, each dimmer, less absorbed and
/// less forward), and Beer's law darkened at a cloud's thin sunlit edge
/// (powder).
fn cloud_sunlight(depth: Float, cos_angle: Float) -> Float {
    let powder = 1.0 - exp(0.0 - depth * 2.0);
    let once = exp(0.0 - depth) * cloud_phase(cos_angle, 0.6);
    let twice = 0.5 * exp(0.0 - depth * 0.5) * cloud_phase(cos_angle, 0.3);
    let thrice = 0.25 * exp(0.0 - depth * 0.25) * cloud_phase(cos_angle, 0.15);
    return (once + twice + thrice) * mix(1.0, powder, 0.5) * 4.0;
}
/// A cloud's phase: mostly forward by `g`, some back (a silver lining and a
/// glow away from the sun).
fn cloud_phase(cos_angle: Float, g: Float) -> Float { return mix(air_phase(cos_angle, g), air_phase(cos_angle, -0.2), 0.3); }

/// The clouds over each sky pixel: their light toward the eye (rgb) and how
/// much of the sky behind still shows (w); other pixels (x 0, w 1). Lit by
/// the sun through `light_steps` steps toward it, the sky light from above
/// and `below` from beneath; thinned into the horizon's haze.
kernel render.clouds_march@1 {
    requires { field.read; field.write; }
    input surface: Grid<Vec4>;
    input lens: Lenses;
    input sky: SkyLooks;
    input deck: CloudDecks;
    param below: Vec3 = vec3(0.0, 0.0, 0.0);
    param steps: Int = 32;
    param light_steps: Int = 5;
    output result: Image;
    compute {
        let clear = vec4(0.0, 0.0, 0.0, 1.0);
        let q = coord();
        let ext = domain();
        let l = at(lens, 0);
        let s = at(sky, 0);
        let dir = ray(l, q, ext);
        let ratio = size(surface) / ext;
        let su = at(surface, min(floor((q + 0.5) * ratio), size(surface) - vec2(1.0, 1.0)));
        if su.w < no_hit() * 0.5 || dir.y <= 0.01 { return clear; }
        let cd = at(deck, 0);
        let low = cd.low;
        let high = cd.high;
        if cd.cover <= 0.0 { return clear; }
        let t_in = max((low - l.eye.y) / dir.y, 0.0);
        let t_out = (high - l.eye.y) / dir.y;
        if t_out <= t_in { return clear; }
        // A long slant through the deck is walked no further than this.
        let span = min(t_out - t_in, (high - low) * 4.0);
        let n = max(steps, 1);
        let dt = span / float(n);
        let sun = normalize(s.sun);
        let cos_angle = dot(dir, sun);
        // Every pixel's steps start alike: at an eighth of the size, a
        // pixel's own offset would show as blocks.
        let r = loop 64 with r = vec4(0.0, 0.0, 0.0, 1.0) until index() >= n || r.w < 0.02 {
            let p = l.eye + dir * (t_in + (float(index()) + 0.5) * dt);
            let dens = cloud_density(cd, p);
            if dens <= 0.0 { r } else {
                let h = saturate((p.y - low) / (high - low));
                let light = s.sun_color * cloud_sunlight(cloud_depth_toward(cd, p, sun, light_steps), cos_angle)
                    + s.ambient * (0.3 + 0.7 * h) + below * ((1.0 - h) * 0.6);
                let absorbed = exp(0.0 - dens * dt);
                let scattered = light * ((1.0 - absorbed) * r.w);
                vec4(r.x + scattered.x, r.y + scattered.y, r.z + scattered.z, r.w * absorbed)
            }
        };
        // Toward the horizon the deck thins into the haze.
        let fade = smoothstep(0.01, 0.12, dir.y);
        return vec4(r.x * fade, r.y * fade, r.z * fade, mix(1.0, r.w, fade));
    }
}
