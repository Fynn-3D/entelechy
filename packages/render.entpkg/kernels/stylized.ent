// A stylized look, after any renderer: a pixel much nearer than its neighbor is the edge of the nearer thing,
// drawn with a thin dark line fading with distance; then colors as watercolor: a little more vivid, shadows
// cool, highlights warm. Distance is read from the G-buffer's surface (`surface`'s w), never from the picture's alpha;
// the edges are `outline.ent`'s.
use "outline.ent";

/// The HDR picture `image` with edges drawn and colors graded (the same size); `surface` is its G-buffer surface.
kernel render.stylized@1 {
    requires { field.read; field.write; }
    input image: Image;
    input surface: Grid<Vec4>;
    /// How dark the line is (0 none), and how far it fades out (meters).
    param ink: Float = 0.8;
    param ink_reach: Float = 90.0;
    /// How much color is graded (0 none).
    param tone: Float = 1.0;
    /// 0: the picture passes on as it is.
    param style: Int = 1;
    /// The ink's color, times what lies under it.
    param ink_color: Vec3 = vec3(0.22, 0.2, 0.27);
    /// How vivid the colors are made (1 as they are).
    param vivid: Float = 1.12;
    /// The tint of the lights and of the shadows, and the cool lift laid into the shadows.
    param light_tint: Vec3 = vec3(1.03, 1.0, 0.95);
    param shadow_tint: Vec3 = vec3(0.93, 0.98, 1.08);
    param shadow_lift: Vec3 = vec3(0.012, 0.016, 0.03);
    output result: Image;
    compute {
        let p = coord();
        let c = at(image, p);
        if style != 1 { return c; }
        let line = outline_near(surface, p, ink_reach);
        let inked = mix(c.xyz, c.xyz * ink_color, line * ink);
        // A watercolour's colors, judged on the light as shown (HDR squeezed).
        let gray = dot(inked, vec3(0.299, 0.587, 0.114));
        let seen = gray / (1.0 + gray);
        let soft = mix(vec3(gray, gray, gray), inked, vivid);
        let shade = 1.0 - smoothstep(0.15, 0.55, seen);
        let toned = soft * mix(light_tint, shadow_tint, shade) + shadow_lift * shade * gray;
        let out = mix(inked, toned, tone);
        return vec4(out.x, out.y, out.z, c.w);
    }
}
