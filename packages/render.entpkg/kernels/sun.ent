// The sun's shadows for any scene, as cascaded shadow maps. The view is cut
// into cascades, each a square seen straight down the sunlight, larger with
// distance (`render.sun_views`), its center held to its own texels so the
// shadows do not swim as the lens moves. The scene draws each cascade's
// depth toward the sun into one atlas (a raster scene through `sun_clip`,
// a distance-field scene by marching `sun_ray`); `render.sun_shadow` then
// shades the G-buffer's sun visibility: each pixel in the finest cascade
// holding it, softened as far as the sun's disc makes a shadow soft from its
// caster (percentage-closer soft shadows), cascades blended at their edges.
use "camera.ent";
use "sky.ent";

/// A cascade: its middle, the square's axes across the sunlight (`right`,
/// `up`) and toward the sun (`toward`), its half width and how deep it
/// reaches toward the sun (meters), the size of a texel.
struct SunView { center: Vec3; right: Vec3; up: Vec3; toward: Vec3; half: Float; depth: Float; texel: Float; }
type SunViews = Rows<SunView>;

/// Where `p` falls in cascade `v`: across it (x, y, 0 to 1) and how far
/// toward the sun from its middle (z, meters).
fn sun_at(v: SunView, p: Vec3) -> Vec3 {
    let d = p - v.center;
    return vec3(dot(d, v.right) / (2.0 * v.half) + 0.5, dot(d, v.up) / (2.0 * v.half) + 0.5, dot(d, v.toward));
}
/// A raster's clip coordinates for `p` in cascade `v` (x, y in -1 to 1,
/// depth 0 nearest the sun to 1, w 1): what a raster scene draws its sun
/// depth with.
fn sun_clip(v: SunView, p: Vec3) -> Vec4 {
    let a = sun_at(v, p);
    return vec4(a.x * 2.0 - 1.0, a.y * 2.0 - 1.0, 0.5 - a.z / (2.0 * v.depth), 1.0);
}
/// The ray down the sunlight through texel (`u`, `v`, 0 to 1) of cascade
/// `view`: where it starts, at the cascade's top toward the sun (xyz), and
/// how far it may go (w); its direction is `-toward`. A distance-field
/// scene marches it and gives `sun_depth_of(view, t)` for what it met `t`
/// meters along.
fn sun_ray(view: SunView, u: Float, v: Float) -> Vec4 {
    let o = view.center + view.right * ((u - 0.5) * 2.0 * view.half) + view.up * ((v - 0.5) * 2.0 * view.half) + view.toward * view.depth;
    return vec4(o.x, o.y, o.z, 2.0 * view.depth);
}
/// The depth a cascade's texel holds for what its ray met `t` meters down:
/// how far toward the sun from the cascade's middle.
fn sun_depth_of(view: SunView, t: Float) -> Float { return view.depth - t; }

/// The cascades for `lens` and the sun of `sky`: cascade i a square
/// `nearest` meters across times `spread` to the i, round the point of the
/// view it covers best, `reach` meters deep toward the sun, `size` texels a
/// side. Its middle moves in steps of `hold` of its width (a whole number of
/// its texels: the shadows hold still), so it is drawn again only when the
/// lens has gone that far, not every frame it moves.
kernel render.sun_views@1 {
    requires { field.read; field.write; }
    input lens: Lenses;
    input sky: SkyLooks;
    param nearest: Float = 60.0;
    param spread: Float = 4.0;
    param reach: Float = 1500.0;
    param size: Float = 1024.0;
    param hold: Float = 0.25;
    output result: SunViews;
    compute {
        let l = at(lens, 0);
        let toward = normalize(at(sky, 0).sun);
        let side = if abs(toward.y) > 0.99 { vec3(1.0, 0.0, 0.0) } else { vec3(0.0, 1.0, 0.0) };
        let right = normalize(cross(side, toward));
        let up = cross(toward, right);
        let half = nearest * pow(spread, float(element())) * 0.5;
        // Round the view's middle at the cascade's own reach: most of the
        // view the cascade holds lies in it.
        let middle = l.eye + l.ahead * (half * 0.5);
        let texel = 2.0 * half / size;
        // Held to steps of whole texels across the sunlight (no swimming, and
        // drawn again only a step on), and to coarse steps toward it.
        let step = max(floor(size * hold), 1.0) * texel;
        let x = floor(dot(middle, right) / step) * step;
        let y = floor(dot(middle, up) / step) * step;
        let z = floor(dot(middle, toward) / (reach * 0.25)) * (reach * 0.25);
        return SunView { center: right * x + up * y + toward * z, right: right, up: up, toward: toward, half: half, depth: reach, texel: texel };
    }
}

/// The occluder depths the cascade `i`'s part of the atlas holds round
/// (`a`, in texels of the cascade): the nearest texel's.
fn sun_occluder(atlas: Grid<Float>, i: Int, a: Vec2, res: Float) -> Float {
    let q = clamp(floor(a), vec2(0.0, 0.0), vec2(res - 1.0, res - 1.0));
    return at(atlas, vec2(q.x + float(i) * res, q.y));
}

/// How much sun reaches `p` (facing `n`) by cascade `i`: blockers searched
/// within 8 texels round it, their mean distance above it making the
/// penumbra as wide as the sun's disc (`sun_size`, its angular radius) makes
/// it from there, then that much filtered (16 points of a spiral, turned by
/// the pixel's own angle `turn`): sharp where a shadow meets its caster,
/// soft away from it.
fn sun_pcss(atlas: Grid<Float>, views: SunViews, i: Int, p: Vec3, n: Vec3, sun_size: Float, turn: Float) -> Float {
    let v = at(views, i);
    let res = size(atlas).y;
    // A texel holds one depth, and a surface slanting to the sunlight
    // rises across it by the texel times the slant's tangent: compared that
    // much nearer the sun (and lifted off along its normal by a texel), it
    // does not shadow itself in stripes.
    let c = clamp(abs(dot(n, v.toward)), 0.05, 1.0);
    let rise = v.texel * (1.0 + min(sqrt(1.0 - c * c) / c, 8.0));
    let a0 = sun_at(v, p + n * v.texel);
    let a = vec3(a0.x, a0.y, a0.z + rise);
    let at_t = vec2(a.x, a.y) * res;
    let search = 8.0;
    let blockers = loop 12 with b = vec2(0.0, 0.0) {
        let k = float(index());
        let r = sqrt((k + 0.5) / 12.0) * search;
        let ang = k * 2.3999632 + turn;
        let d = sun_occluder(atlas, i, at_t + vec2(cos(ang), sin(ang)) * r, res);
        if d > a.z { vec2(b.x + (d - a.z), b.y + 1.0) } else { b }
    };
    if blockers.y < 0.5 { return 1.0; }
    let gap = blockers.x / blockers.y;
    let wide = clamp(gap * 2.0 * sun_size / v.texel, 1.0, search * 2.0);
    let lit = loop 16 with l = 0.0 {
        let k = float(index());
        let r = sqrt((k + 0.5) / 16.0) * wide;
        let ang = k * 2.3999632 + turn;
        let d = sun_occluder(atlas, i, at_t + vec2(cos(ang), sin(ang)) * r, res);
        l + if d > a.z { 0.0 } else { 1.0 }
    };
    return lit / 16.0;
}

/// The G-buffer's `extra` with the sun's shadow from the cascades
/// (`views`, their depths side by side in `atlas`) multiplied into the sun's
/// visibility (x), before a renderer: each pixel by the finest cascade that
/// holds it, the next blended in toward its edge. `sun_size` is the sun's
/// angular radius (radians; the real sun's is about 0.0047).
kernel render.sun_shadow@1 {
    requires { field.read; field.write; }
    input extra: Grid<Vec4>;
    input surface: Grid<Vec4>;
    input lens: Lenses;
    input views: SunViews;
    input atlas: Grid<Float>;
    param sun_size: Float = 0.01;
    output result: Grid<Vec4>;
    compute {
        let e = sample(extra);
        let s = sample(surface);
        if e.x <= 0.0 || s.w > no_hit() * 0.5 { return e; }
        let l = at(lens, 0);
        let p = l.eye + ray(l, coord(), size(surface)) * s.w;
        let turn = fract(52.982919 * fract(dot(coord(), vec2(0.06711056, 0.00583715)))) * 6.2831853;
        let n_views = count(views);
        // The finest cascade holding the pixel, and how near its edge.
        let pick = loop 4 with r = vec2(-1.0, 0.0) until r.x >= 0.0 || index() >= n_views {
            let a = sun_at(at(views, index()), p);
            let edge = min(min(a.x, 1.0 - a.x), min(a.y, 1.0 - a.y));
            if edge > 0.02 { vec2(float(index()), edge) } else { r }
        };
        if pick.x < 0.0 { return e; }
        let i = int(pick.x);
        let here = sun_pcss(atlas, views, i, p, s.xyz, sun_size, turn);
        let blend = smoothstep(0.02, 0.1, pick.y);
        let lit = if blend < 1.0 && i + 1 < n_views { mix(sun_pcss(atlas, views, i + 1, p, s.xyz, sun_size, turn), here, blend) } else { here };
        return vec4(e.x * lit, e.y, e.z, e.w);
    }
}
