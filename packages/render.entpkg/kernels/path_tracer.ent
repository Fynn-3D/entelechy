// Path tracing (standard PBR, `brdf.ent`): each pixel each frame sets out from the G-buffer's
// surface along two random paths: one diffuse (cosine-distributed), one specular (GGX-sampled,
// traced for smooth and metal surfaces only). A path then bounces diffusely `bounces` times, tracing a shadow ray toward the sun
// at each thing it meets, and takes the sky's light once it leaves the scene. Its first stretch walks the G-buffer's depth on the screen
// (reflections and occlusion close to the surface, at full precision), the rest and the later bounces walk the proxies. Each records its light without the material
// (the diffuse without its color, the specular without the environment BRDF), accumulated and denoised apart, multiplied back at shading, so denoising
// blurs no texture.
use "random.entpkg";
use "brdf.ent";
use "camera.ent";
use "lamps.ent";
use "sky.ent";
use "transmission.ent";

/// How many frames the lens has rested (`n`, 0 once it moves) and how many in all (`total`, for random numbers); the last frame's
/// lens. Once it has rested `most` frames it counts no more: nothing changes, and tracing, accumulating and denoising rest.
struct Count { eye: Vec3; ahead: Vec3; n: Int; total: Int; }
type Counts = Rows<Count>;
kernel render.path_count_start@1 {
    requires { field.write; }
    output result: Counts;
    compute { return Count { eye: vec3(0.0, 0.0, 0.0), ahead: vec3(0.0, 0.0, 0.0), n: 0, total: 0 }; }
}
kernel render.path_count@1 {
    requires { field.read; field.write; }
    input previous: Counts;
    input lens: Lenses;
    param most: Int = 1024;
    output result: Counts;
    compute {
        let c = at(previous, 0);
        let l = at(lens, 0);
        let same = l.eye.x == c.eye.x && l.eye.y == c.eye.y && l.eye.z == c.eye.z && l.ahead.x == c.ahead.x && l.ahead.y == c.ahead.y && l.ahead.z == c.ahead.z;
        // Enough gathered, or a lens that sees nothing (`focal` 0): it rests.
        if (same && c.n >= most) || l.focal <= 0.0 { return c; }
        return Count { eye: l.eye, ahead: l.ahead, n: if same { min(c.n + 1, 100000) } else { 0 }, total: c.total + 1 };
    }
}

/// Where a path has got to: the light gathered, the color multiplied along the way, where it is and which way it goes, whether it goes on,
/// and from how far from its start the next stretch counts a hit.
struct Path { light: Vec3; weight: Vec3; at_: Vec3; dir: Vec3; alive: Bool; from: Float; }

/// The light seen from `p` (normal `n`) toward `d0`: the first `near` meters walked on the screen, and where they meet something,
/// that pixel as the sun and the lamps light it (its diffuse color times its sun visibility, `lamped` its lamps' light) plus a little
/// sky light; where they meet nothing, the proxies walked (leaving this surface's own coarse shape first, `rough_leave`), then bouncing
/// diffusely up to `bounces` stretches, each place met lit by the sun and the lamps. `h0` is the path's random number.
fn incoming(surface: Grid<Vec4>, paint: Grid<Vec4>, extra: Grid<Vec4>, lamped: Image, lamps: Lamps, proxy: Volume<Vec4>, land: Grid<Float>, frame: Proxies, s: SkyLook, l: Lens, extent: Vec2,
    p: Vec3, n: Vec3, d0: Vec3, h0: Int, near: Float, bounces: Int) -> Vec3 {
    let ss = screen_march(surface, l, extent, p + n * 0.01, d0, near, 10, 0.4, unit_of(hash_int(h0, 2)));
    if ss.z >= 0.0 {
        let o = at(surface, vec2(ss.x, ss.y));
        let ex = at(extra, vec2(ss.x, ss.y));
        let a = at(paint, vec2(ss.x, ss.y)).xyz * (1.0 - ex.y);
        let lit = s.sun_color * max(dot(o.xyz, s.sun), 0.0) * ex.x / 3.14159 + s.horizon * 0.25 * saturate(o.y * 0.5 + 0.5);
        return a * lit + a * ex.z + at(lamped, vec2(ss.x, ss.y)).xyz;
    }
    let path = loop 4 with st = Path { light: vec3(0.0, 0.0, 0.0), weight: vec3(1.0, 1.0, 1.0), at_: p + n * 0.06, dir: d0, alive: true, from: rough_leave(proxy, frame, p + n * 0.06, d0, 0.35, 1.5) } until !st.alive || index() >= bounces {
        let hit = rough_trace(proxy, land, frame, st.at_, st.dir, st.from, 80.0, 72);
        if hit.y < -0.5 {
            Path { light: st.light + st.weight * sky_radiance(st.dir, s, false), weight: st.weight, at_: st.at_, dir: st.dir, alive: false, from: 0.0 }
        } else {
            let hp = st.at_ + st.dir * hit.x;
            let hn = rough_normal(proxy, land, frame, hp, hit.y);
            let ha = rough_albedo(proxy, frame, hp, hit.y);
            let sl = max(dot(hn, s.sun), 0.0);
            let sun_in = if sl > 0.0 { s.sun_color * sl * rough_shadow(proxy, land, frame, hp + hn * 0.1, s.sun, 0.1, 40.0, 24) / 3.14159 } else { vec3(0.0, 0.0, 0.0) };
            let w = st.weight * ha;
            let hk = hash_int(h0, 10 + index());
            let lamps_in = lamps_on_rough(lamps, vec3(1.0, 1.0, 1.0), hp, hn, proxy, land, frame, 4);
            Path { light: st.light + w * (sun_in + lamps_in), weight: w, at_: hp + hn * 0.06, dir: cosine_dir(hn, unit_of(hk), unit_of(hash_int(hk, 1))), alive: true, from: 0.1 }
        }
    };
    return path.light;
}

/// A frame's paths: `diffuse` the diffuse light reaching this point (without color), `specular` the light the specular path
/// brings back over the environment BRDF (w 0: too rough and not metal, so not traced), `coat` the light from the clearcoat's
/// mirror direction (traced only where there is a clearcoat).
kernel render.path_trace@1 {
    requires { field.read; field.write; }
    input surface: Grid<Vec4>;
    input paint: Grid<Vec4>;
    input extra: Grid<Vec4>;
    input layers: Grid<Vec4>;
    input more: Grid<Vec4>;
    input behind_at: Grid<Vec4>;
    input behind_normal: Grid<Vec4>;
    input proxy: Volume<Vec4>;
    input land: Grid<Float>;
    input frame: Proxies;
    input sky: SkyLooks;
    input lens: Lenses;
    input count: Counts;
    input lamps: Lamps;
    /// The lamps' light on each surface (`render.lamps_light`).
    input lamped: Image;
    param bounces: Int = 2;
    output diffuse: Image;
    output specular: Image;
    output coat: Image;
    output beyond: Image;
    compute {
        let q = coord();
        let extent = domain();
        let su = at(surface, q);
        if su.w > no_hit() * 0.5 { return { diffuse: vec4(0.0, 0.0, 0.0, 1.0), specular: vec4(0.0, 0.0, 0.0, 0.0), coat: vec4(0.0, 0.0, 0.0, 0.0), beyond: vec4(0.0, 0.0, 0.0, 0.0) }; }
        let l = at(lens, 0);
        let s = at(sky, 0);
        let k = at(count, 0).total;
        let dir = ray(l, q, extent);
        let p = l.eye + dir * su.w;
        let n = su.xyz;
        let v = vec3(0.0, 0.0, 0.0) - dir;
        let m = pbr_of(at(paint, q), at(extra, q), at(layers, q), at(more, q));
        let h0 = hash_int2(int(q.x) + int(q.y) * 8191, k, 201);
        let d0 = cosine_dir(n, unit_of(h0), unit_of(hash_int(h0, 1)));
        let diffuse = incoming(surface, paint, extra, lamped, lamps, proxy, land, frame, s, l, extent, p, n, d0, h0, 1.0, bounces);
        let glossy = m.metal > 0.01 || m.rough < 0.6;
        let h1 = hash_int(h0, 77);
        let ls = ggx_sample(n, v, m.rough, unit_of(h1), unit_of(hash_int(h1, 1)));
        let w = ggx_weight(m, n, v, ls);
        let env = env_brdf(pbr_f0(m), m.rough, max(dot(n, v), 0.001));
        let spec = if glossy && dot(n, ls) > 0.0 { incoming(surface, paint, extra, lamped, lamps, proxy, land, frame, s, l, extent, p, n, ls, h1, 3.0, max(bounces - 1, 1)) * w / max(env, vec3(0.001, 0.001, 0.001)) } else { vec3(0.0, 0.0, 0.0) };
        // Clearcoat: one ray in the mirror direction (it is smooth; one is accurate enough).
        let coated = m.clearcoat > 0.0;
        let h2 = hash_int(h0, 91);
        let mirror = reflect(dir, n);
        let coat = if coated && dot(n, mirror) > 0.0 { incoming(surface, paint, extra, lamped, lamps, proxy, land, frame, s, l, extent, p, n, mirror, h2, 3.0, 1) } else { vec3(0.0, 0.0, 0.0) };
        // The point seen through: its diffuse light traced along a path too.
        let ba = at(behind_at, q);
        let bn = at(behind_normal, q);
        let bnn = vec3(bn.x, bn.y, bn.z);
        let h3 = hash_int(h0, 133);
        let beyond = if m.transmission > 0.0 && ba.w > 0.5 { incoming(surface, paint, extra, lamped, lamps, proxy, land, frame, s, l, extent, vec3(ba.x, ba.y, ba.z), bnn, cosine_dir(bnn, unit_of(h3), unit_of(hash_int(h3, 1))), h3, 0.0, bounces) } else { vec3(0.0, 0.0, 0.0) };
        return { diffuse: vec4(diffuse, 1.0), specular: vec4(spec, if glossy { 1.0 } else { 0.0 }), coat: vec4(coat, if coated { 1.0 } else { 0.0 }), beyond: vec4(beyond, 1.0) };
    }
}

/// Accumulating: this frame averaged with the earlier ones while the lens rests (at most `most`); where a pixel's depth changes
/// (a new G-buffer, or the lens moved) it starts again from this frame. w keeps the depth.
kernel render.path_blank@1 {
    requires { field.write; }
    output result: Image;
    compute { return vec4(0.0, 0.0, 0.0, -1.0); }
}
kernel render.path_accum@1 {
    requires { field.read; field.write; }
    input previous: Image;
    input current: Image;
    input surface: Grid<Vec4>;
    input count: Counts;
    param most: Int = 1024;
    output result: Image;
    compute {
        let q = coord();
        let now = at(current, q).xyz;
        let depth = at(surface, q).w;
        let n = min(at(count, 0).n, most);
        let old = if size(previous) == domain() { at(previous, q) } else { vec4(0.0, 0.0, 0.0, -1.0) };
        let kept = n > 0 && abs(old.w - depth) <= depth * 0.002 + 0.0001;
        // Enough gathered (`most`): kept as it is, so it rests (the trace
        // gives the same sample again, which would only creep it on).
        if kept && n >= most { return old; }
        return vec4(if kept { mix(old.xyz, now, 1.0 / float(n + 1)) } else { now }, depth);
    }
}

/// One pass of denoising (à-trous): 5 by 5 points `gap` pixels apart, averaged by weights of distance (a B-spline), whether the
/// normals agree, and how far the depths differ (by the slope); unfiltered once `clean` frames are accumulated.
kernel render.path_atrous@1 {
    requires { field.read; field.write; }
    input image: Image;
    input surface: Grid<Vec4>;
    input count: Counts;
    param gap: Int = 1;
    param clean: Int = 96;
    output result: Image;
    compute {
        let q = coord();
        let here = at(image, q);
        let su = at(surface, q);
        let n = at(count, 0).n;
        if su.w > no_hit() * 0.5 || n >= clean { return here; }
        let kern = [0.0625, 0.25, 0.375, 0.25, 0.0625];
        let sum = loop 25 with acc = vec4(0.0, 0.0, 0.0, 0.0) {
            let o = vec2(float(index() % 5 - 2), float(index() / 5 - 2)) * float(gap);
            let sq = clamp(q + o, vec2(0.0, 0.0), domain() - vec2(1.0, 1.0));
            let s2 = at(surface, sq);
            let wn = pow(max(dot(su.xyz, s2.xyz), 0.0), 64.0);
            let wd = exp(-abs(s2.w - su.w) / (su.w * 0.01 * float(gap) + 0.02));
            let w = kern[index() % 5] * kern[index() / 5] * wn * wd * (if s2.w > no_hit() * 0.5 { 0.0 } else { 1.0 });
            acc + vec4(at(image, sq).xyz * w, w)
        };
        let filtered = sum.xyz / max(sum.w, 0.0001);
        // The more samples, the more it trusts itself and the lighter it filters.
        return vec4(mix(filtered, here.xyz, saturate(float(n) / float(clean))), here.w);
    }
}

/// The light at the point seen through (transmissive pixels only): its diffuse light is the accumulated path's.
kernel render.path_behind@1 {
    requires { field.read; field.write; }
    input more: Grid<Vec4>;
    input behind_at: Grid<Vec4>;
    input behind_dir: Grid<Vec4>;
    input behind_paint: Grid<Vec4>;
    input behind_normal: Grid<Vec4>;
    input light: Image;
    input sky: SkyLooks;
    output result: Image;
    compute {
        let q = coord();
        if at(more, q).y <= 0.0 { return vec4(0.0, 0.0, 0.0, 1.0); }
        return vec4(behind_radiance(at(sky, 0), at(behind_at, q), at(behind_dir, q), at(behind_paint, q), at(behind_normal, q), at(light, q).xyz), 1.0);
    }
}

/// Shading (standard PBR): the sky drawn where it is; things: the sun's light (by the scene's visibility), plus the
/// denoised diffuse, specular and clearcoat light multiplied back by the material (`ambient_by`), plus emission and the lamps' light
/// (`lamped`); air laid over distance.
kernel render.path_shade@1 {
    requires { field.read; field.write; }
    input diffuse: Image;
    input specular: Image;
    input coat: Image;
    input surface: Grid<Vec4>;
    input paint: Grid<Vec4>;
    input extra: Grid<Vec4>;
    input layers: Grid<Vec4>;
    input more: Grid<Vec4>;
    input beyond: Image;
    input through: Grid<Vec4>;
    input sky: SkyLooks;
    input lens: Lenses;
    input lamped: Image;
    output result: Image;
    /// The share of `result` that scatters under subsurface surfaces (`graphs/subsurface.esn` spreads it); 0 elsewhere.
    output scatter: Image;
    compute {
        let q = coord();
        let extent = domain();
        let l = at(lens, 0);
        let s = at(sky, 0);
        let dir = ray(l, q, extent);
        let su = at(surface, q);
        if su.w > no_hit() * 0.5 { return { result: vec4(sky_radiance(dir, s, true), 1.0), scatter: vec4(0.0, 0.0, 0.0, 0.0) }; }
        let n = su.xyz;
        let ex = at(extra, q);
        let m = pbr_of(at(paint, q), ex, at(layers, q), at(more, q));
        let v = vec3(0.0, 0.0, 0.0) - dir;
        // The scene's baked fine occlusion (what the coarse proxies cannot trace), multiplied into the ambient light.
        let occ = baked_occlusion(ex);
        let e = at(diffuse, q).xyz * occ;
        // Where no specular path was traced (rough non-metals): the specular light is the diffuse light round it.
        let glossy = m.metal > 0.01 || m.rough < 0.6;
        let spec_light = if glossy { at(specular, q).xyz * occ } else { e };
        let coat_light = if m.clearcoat > 0.0 { at(coat, q).xyz } else { spec_light };
        let clear = if m.transmission > 0.0 { transmitted(m, n, v, at(through, q), frosted(beyond, q, m.rough)) } else { vec3(0.0, 0.0, 0.0) };
        let color = lit_by(m, n, v, s.sun, s.sun_color * ex.x) + ambient_by(m, n, v, e, spec_light, coat_light) + clear + m.glow + at(lamped, q).xyz;
        let shaded = aerial(color, dir, su.w, s);
        // The light under the skin, through the air as the rest (the air's mix is linear).
        let kept = aerial(color - scattered_share(m, n, v, s.sun, s.sun_color * ex.x, e), dir, su.w, s);
        return { result: vec4(shaded, 1.0), scatter: vec4(shaded.x - kept.x, shaded.y - kept.y, shaded.z - kept.z, 0.0) };
    }
}
