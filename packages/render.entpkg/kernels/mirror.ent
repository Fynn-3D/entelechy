// A planar mirror: still water, a polished floor. The lens is reflected in
// the mirror's plane (`render.mirror_lens`); the scene draws its G-buffer
// again through it, from the plane up, and a renderer lights that; where the
// G-buffer's `more` w marks a mirror, the picture takes the reflection
// (`render.mirror_mix`): by Fresnel, moved by the surface's waves and drawn
// out down the water as a rough surface does.
use "brdf.ent";
use "camera.ent";

/// The lens reflected in the level plane at height `level`: the pixel a
/// ray takes through it sees what the ray reflected off the plane sees.
kernel render.mirror_lens@1 {
    requires { field.read; field.write; }
    input lens: Lenses;
    param level: Float = 0.0;
    output result: Lenses;
    compute {
        let l = at(lens, 0);
        let flip = vec3(1.0, -1.0, 1.0);
        return Lens { eye: vec3(l.eye.x, 2.0 * level - l.eye.y, l.eye.z), ahead: l.ahead * flip, right: l.right * flip, up: l.up * flip, focal: l.focal };
    }
}

/// How far along `dir` from `eye` a ray reaches the plane at `level`; a
/// mirrored view starts there (what lies under the plane is not
/// reflected). Negative where the ray never reaches it going up.
fn mirror_start(eye: Vec3, dir: Vec3, level: Float) -> Float {
    if eye.y >= level { return 0.0; }
    return if dir.y > 0.00001 { (level - eye.y) / dir.y } else { -1.0 };
}

/// The picture `hdr` with the mirror pass `mirror` (any size, drawn
/// through `render.mirror_lens`) laid over the pixels whose `more` w marks
/// a mirror (its strength, 0 to 1): Fresnel from the surface's normal, the
/// reflection moved by the normal's tilt (`ripple`, in parts of the
/// picture's height) and drawn out downward by `streak` (in parts of the
/// picture's height, more for a rougher surface).
kernel render.mirror_mix@1 {
    requires { field.read; field.write; }
    input hdr: Image;
    input mirror: Image;
    input surface: Grid<Vec4>;
    input paint: Grid<Vec4>;
    input more: Grid<Vec4>;
    input lens: Lenses;
    param ripple: Float = 0.08;
    param streak: Float = 0.03;
    output result: Image;
    compute {
        let base = sample(hdr);
        let strength = sample(more).w;
        if strength <= 0.0 { return base; }
        let su = sample(surface);
        let l = at(lens, 0);
        let ext = size(surface);
        let q = coord();
        let dir = ray(l, q, ext);
        let n = su.xyz;
        let f = schlick(vec3(0.02, 0.02, 0.02), max(dot(n, vec3(0.0, 0.0, 0.0) - dir), 0.0)).x;
        // The normal's tilt across and along the view moves what is seen in it.
        let uv = (q + 0.5) / ext + vec2(dot(n, l.right), dot(vec3(n.x, 0.0, n.z), l.ahead)) * ripple;
        let rough = sample(paint).w;
        let reach = streak * (0.3 + rough);
        let msize = size(mirror);
        let seen = loop 7 with acc = vec4(0.0, 0.0, 0.0, 0.0) {
            let k = float(index()) - 1.0;
            let w = exp(0.0 - k * k * 0.18);
            let at_uv = clamp(uv + vec2(0.0, k * reach / 5.0), vec2(0.0, 0.0), vec2(1.0, 1.0));
            let c = at_linear(mirror, at_uv * msize);
            vec4(acc.x + c.x * w, acc.y + c.y * w, acc.z + c.z * w, acc.w + w)
        };
        let m = seen.xyz / max(seen.w, 0.0001);
        let k = f * strength;
        return vec4(base.xyz * (1.0 - k) + m * k, base.w);
    }
}
