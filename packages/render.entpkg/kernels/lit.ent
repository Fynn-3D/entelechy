// Lit: a light renderer, each pixel looking only at itself (G-buffer, sky) and the coarse scene (proxies), gathering
// no probes and tracing nothing on the screen, its interface as `graphs/probe_gi.esn`'s and `graphs/path_tracer.esn`'s. The sun lights it,
// with shadows (`extra`'s x); the diffuse light in shade is a half of sky and a half of ground (up-facing takes zenith to
// horizon, down-facing the warm light the sunlit ground throws back), times the baked occlusion, times the sky the coarse scene hides
// (three distances taken up along the normal; deep inside the coarse shape, a leaf in its crown, a share of its own instead); a
// reflection takes the sky in its direction (the ground's light, looking down). Two ways of drawing: standard real-time
// lighting (`lit_by`, `ambient_by`), or light and shade as a painting has them (`toon`).
use "brdf.ent";
use "camera.ent";
use "probe_gi.ent";
use "sky.ent";

/// The color of light the ground throws back (the ground's mean color, warmer).
fn ground_bounce_albedo() -> Vec3 { return vec3(0.34, 0.29, 0.22); }

/// The diffuse light from all round a surface facing `n` receives: the sky's half and the ground's half mixed by its facing.
fn hemisphere(n: Vec3, s: SkyLook) -> Vec3 {
    let up = clamp(n.y, -1.0, 1.0);
    let sky = (mix(s.horizon, s.zenith, smoothstep(0.0, 1.0, up)) * 0.55 + s.ambient * 0.45) * 1.15;
    let ground = ground_bounce_albedo() * s.sun_color * (max(s.sun.y, 0.0) / 3.14159265) * 1.6 + s.ambient * 0.25;
    return mix(ground, sky, smoothstep(-0.6, 0.6, up));
}

/// How much of the light from all round the coarse scene (the proxies' distances) hides from a surface at `p` facing `n` (1 none hidden):
/// how far things are 0.4, 1.2 and 2.5 meters up along the normal (no farther than a quarter of the proxy's width), darker where nearer
/// than the way walked. A point in a crown of leaves lies inside its coarse shape, its distance negative, much darker.
fn proxy_open(proxy: Volume<Vec4>, frame: Proxies, p: Vec3, n: Vec3) -> Float {
    let d = normalize(n + vec3(0.0, 0.6, 0.0));
    // A proxy drawn close round one thing (an asset) is read no farther than a quarter of its width (its coarsest level's).
    let wide = at(frame, count(frame) - 1);
    let reach = max(max(wide.cells.x, wide.cells.y), wide.cells.z) * wide.cell * 0.25;
    let shut = loop 3 with a = 0.0 {
        let k = min(if index() == 0 { 0.4 } else if index() == 1 { 1.2 } else { 2.5 }, reach);
        let near = proxy_near(proxy, frame, p + d * k);
        a + clamp((k - near) / k, 0.0, 1.0) * (if index() == 0 { 0.45 } else if index() == 1 { 0.35 } else { 0.2 })
    };
    return clamp(1.0 - shut * 1.6, 0.1, 1.0);
}

/// About how far `p` is from things in the coarse scene, past its edge too: there, the way to the coarsest level's edge and
/// what the edge holds (what the proxy holds stands inside it), so a proxy drawn close round its thing does not end in a step.
fn proxy_near(proxy: Volume<Vec4>, frame: Proxies, p: Vec3) -> Float {
    let k = proxy_level(frame, p);
    if k.x >= 0.0 { return proxy_at(proxy, frame, p, 0.0).x; }
    let last = count(frame) - 1;
    let fr = at(frame, last);
    let depth = proxy_depth(frame, last);
    let c = (p - fr.lo) / fr.cell;
    let q = clamp(c, vec3(0.0, 0.0, 0.0), fr.cells - vec3(1.0, 1.0, 1.0));
    return length(c - q) * fr.cell + at_linear(proxy, vec3(q.x, q.y, q.z + depth) + 0.5).x;
}

/// What the reflected direction `r` sees: the sky, or looking down, the ground's light.
fn seen_along(r: Vec3, s: SkyLook) -> Vec3 {
    return if r.y > 0.0 { sky_radiance(r, s, false) } else { hemisphere(vec3(0.0, -1.0, 0.0), s) };
}

/// Lit (see the file's head): an HDR picture: the sky drawn where it is; things lit by `painted` (1 as a painting
/// does (`toon`), 0 standard real-time lighting), plus a smooth surface's reflection, plus emission, with air laid over distance. `bounce`
/// 0 leaves out the light from all round, the sun's direct light and emission alone.
kernel render.lit@1 {
    requires { field.read; field.write; }
    input surface: Grid<Vec4>;
    input paint: Grid<Vec4>;
    input extra: Grid<Vec4>;
    input layers: Grid<Vec4>;
    input more: Grid<Vec4>;
    input sky: SkyLooks;
    input lens: Lenses;
    /// The coarse scene: the distance to things, and where it covers.
    input proxy: Volume<Vec4>;
    input frame: Proxies;
    param painted: Int = 0;
    param bounce: Int = 1;
    /// The share of the light all round a surface deep inside the coarse
    /// shape (a leaf in its crown) keeps, times its baked occlusion, in place of
    /// what the coarse scene hides; a translucent surface keeps at least this
    /// times its subsurface share wherever it is.
    param inside_sky: Float = 0.8;
    output result: Image;
    /// The share of `result` that scatters under subsurface surfaces (`graphs/subsurface.esn` spreads it); 0 elsewhere and when painted.
    output scatter: Image;
    compute {
        let q = coord();
        let l = at(lens, 0);
        let s = at(sky, 0);
        let dir = ray(l, q, domain());
        let su = sample(surface);
        if su.w > no_hit() * 0.5 { return { result: vec4(sky_radiance(dir, s, true), 1.0), scatter: vec4(0.0, 0.0, 0.0, 0.0) }; }
        let n = su.xyz;
        let ex = sample(extra);
        let m = pbr_of(sample(paint), ex, sample(layers), sample(more));
        let v = vec3(0.0, 0.0, 0.0) - dir;
        let on = if bounce != 0 { 1.0 } else { 0.0 };
        // Deep inside the coarse shape (a leaf in its crown, more than half a
        // cell in) the coarse scene says nothing of the sky seen through it:
        // the baked occlusion does.
        let at_p = l.eye + dir * su.w + n * 0.05;
        let deep = saturate((0.0 - proxy_at(proxy, frame, at_p, 1.0).x) / proxy_cell(frame, at_p) - 0.5);
        // A translucent thing (a leaf) lets the sky through itself: those round it
        // shut out no more than its subsurface share of `inside_sky` lets in.
        let open = max(mix(proxy_open(proxy, frame, at_p, n), inside_sky, deep), inside_sky * m.subsurface);
        let ao = if bounce != 0 { baked_occlusion(ex) * open } else { 0.0 };
        let e = hemisphere(n, s) * ao;
        let spec_light = mix(seen_along(reflect(dir, n), s), e, sqrt(m.rough)) * ao * on;
        let shown = if painted == 0 { lit_by(m, n, v, s.sun, s.sun_color * ex.x) + ambient_by(m, n, v, e, spec_light, spec_light) }
            else { toon(m, n, v, s, ex.x, e) + spec_light * env_brdf(pbr_f0(m), m.rough, max(dot(n, v), 0.001)) * (1.0 - m.rough) };
        let all = shown + m.glow;
        let shaded = aerial(all, dir, su.w, s);
        // The light under the skin, through the air as the rest (the air's mix is linear).
        let under = if painted == 0 { scattered_share(m, n, v, s.sun, s.sun_color * ex.x, e) } else { vec3(0.0, 0.0, 0.0) };
        let kept = aerial(all - under, dir, su.w, s);
        return { result: vec4(shaded, 1.0), scatter: vec4(shaded.x - kept.x, shaded.y - kept.y, shaded.z - kept.z, 0.0) };
    }
}
