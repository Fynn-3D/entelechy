// Glow as a lens and an eye see it round bright lights: round, with a
// long soft tail. The bright parts are shrunk by halves several times, each
// time blurred by 13 samples (`render.bloom_down`), then grown back, each
// level adding the one below spread by a tent (`render.bloom_up`): a glow of
// every size at once, from a few pixels to a sixth of the picture. What
// `render.tonemap` takes as `bloom`.

/// `hdr` at `p` (pixels of `img`, centers at halves), the edge held.
fn bloom_at(img: Image, p: Vec2) -> Vec3 {
    return at_linear(img, clamp(p, vec2(0.5, 0.5), size(img) - vec2(0.5, 0.5))).xyz;
}

/// A level half the size of `image`: 13 samples weighted as a smooth
/// blur (Jimenez's), the first level keeping only what is brighter than
/// `threshold` (softly, over `knee`), and each sample's share lessened by
/// its own brightness there so one hot pixel does not flicker as a block.
kernel render.bloom_down@1 {
    requires { field.read; field.write; }
    input image: Image;
    /// 1 for the first level, cut from the HDR picture by the threshold.
    param first: Int = 0;
    param threshold: Float = 1.0;
    param knee: Float = 0.5;
    output result: Image;
    compute {
        let ratio = size(image) / domain();
        let c = (coord() + 0.5) * ratio;
        let t = ratio * 0.5;
        let a = bloom_at(image, c + vec2(-2.0, -2.0) * t);
        let b = bloom_at(image, c + vec2(0.0, -2.0) * t);
        let cc = bloom_at(image, c + vec2(2.0, -2.0) * t);
        let d = bloom_at(image, c + vec2(-1.0, -1.0) * t);
        let e = bloom_at(image, c + vec2(1.0, -1.0) * t);
        let f = bloom_at(image, c + vec2(-2.0, 0.0) * t);
        let g = bloom_at(image, c);
        let h = bloom_at(image, c + vec2(2.0, 0.0) * t);
        let i = bloom_at(image, c + vec2(-1.0, 1.0) * t);
        let j = bloom_at(image, c + vec2(1.0, 1.0) * t);
        let k = bloom_at(image, c + vec2(-2.0, 2.0) * t);
        let l = bloom_at(image, c + vec2(0.0, 2.0) * t);
        let m = bloom_at(image, c + vec2(2.0, 2.0) * t);
        let sum = (d + e + i + j) * 0.125 + (a + b + f + g) * 0.03125 + (b + cc + g + h) * 0.03125 + (f + g + k + l) * 0.03125 + (g + h + l + m) * 0.03125;
        if first == 0 { return vec4(sum.x, sum.y, sum.z, 1.0); }
        // The threshold, softly: a quadratic knee below it.
        let bright = max(sum.x, max(sum.y, sum.z));
        let soft = clamp(bright - threshold + knee, 0.0, 2.0 * knee);
        let kept = max(soft * soft / (4.0 * knee + 0.00001), bright - threshold) / max(bright, 0.00001);
        let out = sum * max(kept, 0.0);
        // Fireflies: a level's sample weighed down by its own brightness.
        let calm = out / (1.0 + max(out.x, max(out.y, out.z)) * 0.05);
        return vec4(calm.x, calm.y, calm.z, 1.0);
    }
}

/// A level grown back: this level (`level`) and the one below it
/// (`below`, already grown) spread by a 3 by 3 tent, weighted by `spread`
/// (how much the larger glows count).
kernel render.bloom_up@1 {
    requires { field.read; field.write; }
    input level: Image;
    input below: Image;
    param spread: Float = 0.8;
    output result: Image;
    compute {
        let ratio = size(below) / domain();
        let c = (coord() + 0.5) * ratio;
        let t = ratio;
        let tent = (bloom_at(below, c + vec2(-1.0, -1.0) * t) + bloom_at(below, c + vec2(1.0, -1.0) * t) + bloom_at(below, c + vec2(-1.0, 1.0) * t) + bloom_at(below, c + vec2(1.0, 1.0) * t)) * 0.0625
            + (bloom_at(below, c + vec2(0.0, -1.0) * t) + bloom_at(below, c + vec2(-1.0, 0.0) * t) + bloom_at(below, c + vec2(1.0, 0.0) * t) + bloom_at(below, c + vec2(0.0, 1.0) * t)) * 0.125
            + bloom_at(below, c) * 0.25;
        let own = sample(level).xyz;
        let sum = own + tent * spread;
        return vec4(sum.x, sum.y, sum.z, 1.0);
    }
}
