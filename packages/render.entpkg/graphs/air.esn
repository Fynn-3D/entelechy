//! Fog and clouds over a picture (`kernels/fog.ent`, `kernels/clouds.ent`):
//! height fog the sun, the sky, `glow` and the lamps light, walked at a
//! quarter of the size and smoothed by depth; a deck of clouds over the
//! sky at an eighth; both laid over `hdr`. The deck is given back for the
//! shadows it casts (`render.clouds_shadow`).
use "../kernels/";

input hdr: Image;
input lens: Lenses;
input sky: SkyLooks;
input surface: Grid<Vec4>;
input proxy: Volume<Vec4>;
input land: Grid<Float>;
input frame: Proxies;
input lamps: Lamps;
/// The fog: how thick at `base` and below, thinning by e every `falloff` meters up.
param density: Float = 0.002;
param base: Float = 0.0;
param falloff: Float = 80.0;
/// Light the fog takes from round about (a city's glow at night).
param glow: Vec3 = vec3(0.0, 0.0, 0.0);
/// The lamps' light in the fog, times this.
param lamp_share: Float = 1.0;
/// The steps toward a lamp that cut its beam into shafts (0 none).
param shafts: Int = 8;
/// The clouds: their deck, how much of the sky, and the light from below.
param low: Float = 1500.0;
param high: Float = 2600.0;
param cover: Float = 0.0;
/// How wide a cloud's billows are (meters).
param scale: Float = 2400.0;
param below: Vec3 = vec3(0.0, 0.0, 0.0);

node fog: render.fog_march@1 { surface <- surface; lens <- lens; sky <- sky; lamps <- lamps; proxy <- proxy; land <- land; frame <- frame;
    density = density; base = base; falloff = falloff; glow = glow; lamp_share = lamp_share; shafts = shafts; domain = ceil(size(surface) / 4); }
node across: render.fog_blur@1 { fog <- fog.result; surface <- surface; axis = 0; domain = size(fog); }
node down: render.fog_blur@1 { fog <- across.result; surface <- surface; axis = 1; domain = size(fog); }
// Clouds are soft: an eighth of the size is enough.
node deck: render.clouds_deck@1 { low = low; high = high; cover = cover; scale = scale; domain = 1; }
node clouds: render.clouds_march@1 { surface <- surface; lens <- lens; sky <- sky; deck <- deck.result; below = below; domain = ceil(size(surface) / 8); }
node aired: render.fog_apply@1 { hdr <- hdr; surface <- surface; fog <- down.result; clouds <- clouds.result; domain = size(hdr); }

output hdr <- aired.result;
/// The deck, for its shadows on the ground (`render.clouds_shadow`, before a renderer).
output deck <- deck.result;
