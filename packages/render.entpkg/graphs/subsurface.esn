//! Light under the skin (`kernels/subsurface.ent`): the share of a
//! renderer's picture that scatters under subsurface surfaces (the probes
//! renderer's `scatter`) spread across then down, each color as far as it
//! carries (`reach` meters at full subsurface), and laid back over `hdr`.
use "../kernels/";

input hdr: Image;
input scatter: Image;
input surface: Grid<Vec4>;
input layers: Grid<Vec4>;
input lens: Lenses;
param reach: Float = 0.012;

node across: render.subsurface_blur@1 { scatter <- scatter; surface <- surface; layers <- layers; lens <- lens; axis = 0; reach = reach; domain = size(scatter); }
node down: render.subsurface_blur@1 { scatter <- across.result; surface <- surface; layers <- layers; lens <- lens; axis = 1; reach = reach; domain = size(scatter); }
node spread: render.subsurface_apply@1 { hdr <- hdr; scatter <- scatter; spread <- down.result; domain = size(hdr); }

output hdr <- spread.result;
