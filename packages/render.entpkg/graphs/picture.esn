//! The picture's raster: the backend's own rasterizer (`native.rasterize@3`, the render package's fast path: on a GPU
//! the device's rasterizer, on the processor bit for bit the render package's rule), drawn on a canvas of one pixel a window point
//! times `inner` (a window is that many times larger where a screen has more pixels than points).
//! The corners are the clip coordinates `lens_clip` gives.
use "raster.entpkg";

input vertices: Rows<Corner>;
input triangles: Rows<Face>;
/// The fraction of the window's resolution the picture is drawn at (temporal upscaling makes up the rest).
param inner: Float = 1.0;

// What a pixel holds before anything is drawn on it: the key no fragment gives.
node empty: Grid<Long> { domain = ceil(window() * inner / scale()); value = 9223372036854775807l; }
node drawn: native.rasterize@3 { vertices <- vertices; triangles <- triangles; canvas <- empty.result; domain = size(canvas); }

output surface <- drawn.surface;
