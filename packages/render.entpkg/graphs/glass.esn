//! Glass over a renderer's picture (`kernels/glass.ent`): a mesh of glass (`points`, `faces`) drawn apart from the
//! G-buffer over `canvas`, cut at the near plane (`raster.entpkg`'s `raster.clip_near`), the nearest pane laid over `hdr`
//! where nearer than `surface` shows: what lies behind through it, bent by `refraction` and `tint`ed; what it mirrors (the
//! screen, the bounce's `cache` laid as `cache_frame`, the sky); the sun's and the lamps' highlights. A scene with no bounce
//! hands over a cache of one empty cell.
use "mesh.entpkg";
use "raster.entpkg";
use "../kernels/";

input points: Rows<MeshPoint>;
input faces: Rows<Face>;
input hdr: Image;
input surface: Grid<Vec4>;
input lens: Lenses;
input sky: SkyLooks;
input canvas: Grid<Long>;
input cache: Volume<Vec4>;
input cache_frame: Proxies;
input proxy: Volume<Vec4>;
input frame: Proxies;
input lamps: Lamps;
param near: Float = 0.05;
param far: Float = 2000.0;
param tint: Vec3 = vec3(0.90, 0.95, 0.93);
param rough: Float = 0.02;
param smudge: Float = 0.3;
param refraction: Float = 0.0;

node corners: render.glass_corners@1 { points <- points; lens <- lens; canvas <- canvas; near = near; far = far; }
node cut: raster.clip_near@1 { vertices <- corners.result; triangles <- faces; domain = count(triangles) * 4; }
node cut_faces: raster.clip_faces@1 { triangles <- faces; domain = count(triangles) * 2; }
node raster: native.rasterize@3 { vertices <- cut.result; triangles <- cut_faces.result; canvas <- canvas; domain = size(canvas); }
node glazed: render.glass@1 { hdr <- hdr; glass <- raster.surface; surface <- surface; lens <- lens; sky <- sky; cache <- cache; rframe <- cache_frame; proxy <- proxy;
    frame <- frame; lamps <- lamps; near = near; far = far; tint = tint; rough = rough; smudge = smudge; refraction = refraction; domain = size(hdr); }

output hdr <- glazed.result;
