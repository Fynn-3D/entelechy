//! One level of `field.esn`: its block round the lens (`render.field_frame`), the things standing in it kept, binned and
//! listed, and its cells baked.
use "../kernels/";

input atlas: Volume<Vec4>;
input shapes: Proxies;
input insts: FieldInsts;
input lens: Lenses;
input base: Proxies;
param level: Int = 0;
param nx: Int = 160;
param ny: Int = 48;
param nz: Int = 160;
param cell: Float = 0.5;
param ratio: Float = 4.0;
param hold: Float = 0.25;
param bins: Int = 16;
param band: Float = 8.0;

node frame: render.field_frame@1 { lens <- lens; base <- base; nx = nx; ny = ny; nz = nz; cell = cell; level = level; ratio = ratio; hold = hold; domain = 1; }
node near: render.field_near@1 { insts <- insts; shapes <- shapes; frame <- frame.result; band = band; domain = count(insts); }
node kept: graph "parallel.entpkg/graphs/compact.esn" { flags <- near.result; }
node counts: render.field_bin_counts@1 { insts <- insts; kept <- kept.indices; kept_count <- kept.count; shapes <- shapes; frame <- frame.result; bins = bins; band = band; domain = bins * bins; }
node runs: graph "parallel.entpkg/graphs/runs.esn" { counts <- counts.result; }
node fill: render.field_bin_fill@1 { counts <- counts.result; ends <- runs.ends; insts <- insts; kept <- kept.indices; kept_count <- kept.count; shapes <- shapes; frame <- frame.result; slots <- runs.slots; bins = bins; band = band; domain = count(counts); }
node bake: render.field_bake@1 { atlas <- atlas; shapes <- shapes; insts <- insts; frame <- frame.result; ends <- runs.ends; lists <- fill.result; bins = bins; band = band;
    domain = vec3(nx, ny, nz); }

output proxy <- bake.result;
output frame <- frame.result;
