//! Metered exposure (`kernels/exposure.ent`): the picture's mean brightness
//! metered over tiles, followed as an eye adapts, and `hdr` scaled by it.
use "../kernels/";

input hdr: Image;
param key: Float = 0.18;
param night_key: Float = 0.025;
param bias: Float = 0.0;
param adapt_up: Float = 0.6;
param adapt_down: Float = 2.0;

node tiles: render.exposure_tiles@1 { hdr <- hdr; domain = ceil(size(hdr) / 32); }
node start: render.exposure_start@1 { domain = 1; }
node meter: render.exposure_meter@1 { previous <~ meter.result from start.result; tiles <- tiles.result;
    key = key; night_key = night_key; bias = bias; adapt_up = adapt_up; adapt_down = adapt_down; domain = 1; }
node exposed: render.exposure_apply@1 { hdr <- hdr; exposure <- meter.result; domain = size(hdr); }

output hdr <- exposed.result;
output exposure <- meter.result;
