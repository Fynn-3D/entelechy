//! Glow round bright lights (`kernels/bloom.ent`): the HDR picture's bright
//! parts shrunk by halves six times and grown back, each level adding the
//! larger glow below it. `bloom` is half the picture's size, what
//! `render.tonemap` takes as its `bloom`.
use "../kernels/";

input hdr: Image;
/// From what brightness things glow.
param threshold: Float = 1.0;
/// How much the larger glows count against the smaller.
param spread: Float = 0.8;

node d1: render.bloom_down@1 { image <- hdr; first = 1; threshold = threshold; domain = ceil(size(image) / 2); }
node d2: render.bloom_down@1 { image <- d1.result; domain = ceil(size(image) / 2); }
node d3: render.bloom_down@1 { image <- d2.result; domain = ceil(size(image) / 2); }
node d4: render.bloom_down@1 { image <- d3.result; domain = ceil(size(image) / 2); }
node d5: render.bloom_down@1 { image <- d4.result; domain = ceil(size(image) / 2); }
node d6: render.bloom_down@1 { image <- d5.result; domain = ceil(size(image) / 2); }
node u5: render.bloom_up@1 { level <- d5.result; below <- d6.result; spread = spread; domain = size(level); }
node u4: render.bloom_up@1 { level <- d4.result; below <- u5.result; spread = spread; domain = size(level); }
node u3: render.bloom_up@1 { level <- d3.result; below <- u4.result; spread = spread; domain = size(level); }
node u2: render.bloom_up@1 { level <- d2.result; below <- u3.result; spread = spread; domain = size(level); }
node u1: render.bloom_up@1 { level <- d1.result; below <- u2.result; spread = spread; domain = size(level); }

output bloom <- u1.result;
