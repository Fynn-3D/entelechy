//! The scene's proxy baked from its things' own distances (`kernels/field.ent`): a block round the lens (`nx` by `ny` by `nz` cells of
//! `cell` meters, moved in steps of `hold` of its width), its things binned across the ground (`bins` by `bins`, each widened
//! by `band` meters), each cell the nearest thing's distance and albedo. `atlas` and `shapes` are the things' shapes
//! (`render.field_atlas8`, `render.field_shapes8`), `insts` the things placed, `base` the scene's own frame (its ground).
//! `proxy` and `frame` go to a renderer as the contract's.
use "../kernels/";

input atlas: Volume<Vec4>;
input shapes: Proxies;
input insts: FieldInsts;
input lens: Lenses;
input base: Proxies;
param nx: Int = 160;
param ny: Int = 48;
param nz: Int = 160;
param cell: Float = 0.5;
param hold: Float = 0.25;
param bins: Int = 16;
param band: Float = 4.0;

node frame: render.field_frame@1 { lens <- lens; base <- base; nx = nx; ny = ny; nz = nz; cell = cell; hold = hold; domain = 1; }
node counts: render.field_bin_counts@1 { insts <- insts; shapes <- shapes; frame <- frame.result; bins = bins; band = band; domain = bins * bins; }
node runs: graph "parallel.entpkg/graphs/runs.esn" { counts <- counts.result; }
node fill: render.field_bin_fill@1 { counts <- counts.result; ends <- runs.ends; insts <- insts; shapes <- shapes; frame <- frame.result; slots <- runs.slots; bins = bins; band = band; domain = count(counts); }
node bake: render.field_bake@1 { atlas <- atlas; shapes <- shapes; insts <- insts; frame <- frame.result; ends <- runs.ends; lists <- fill.result; bins = bins; band = band;
    domain = vec3(nx, ny, nz); }

output proxy <- bake.result;
output frame <- frame.result;
