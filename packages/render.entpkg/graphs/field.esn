//! The scene's proxy baked from its things' own distances (`kernels/field.ent`), in three levels round the lens, each `ratio`
//! times coarser and wider than the one before: `nx` by `ny` by `nz` cells, the finest `cell` meters, each moved in steps of
//! `hold` of its width; its things binned across the ground (`bins` by `bins`, each widened by `band` of its cells), each cell
//! the nearest thing's distance and albedo. `atlas` and `shapes` are the things' shapes (`render.field_atlas8`,
//! `render.field_shapes8`), `insts` the things placed, `base` the scene's own frame (its ground). `proxy` (the levels up its
//! depth) and `frame` (a row a level, finest first) go to a renderer as the contract's.
use "../kernels/";

input atlas: Volume<Vec4>;
input shapes: Proxies;
input insts: FieldInsts;
input lens: Lenses;
input base: Proxies;
param nx: Int = 160;
param ny: Int = 48;
param nz: Int = 160;
param cell: Float = 0.5;
param ratio: Float = 4.0;
param hold: Float = 0.25;
param bins: Int = 16;
param band: Float = 8.0;

node near: graph "field_level.esn" { atlas <- atlas; shapes <- shapes; insts <- insts; lens <- lens; base <- base; level = 0;
    nx = nx; ny = ny; nz = nz; cell = cell; ratio = ratio; hold = hold; bins = bins; band = band; }
node mid: graph "field_level.esn" { atlas <- atlas; shapes <- shapes; insts <- insts; lens <- lens; base <- base; level = 1;
    nx = nx; ny = ny; nz = nz; cell = cell; ratio = ratio; hold = hold; bins = bins; band = band; }
node far: graph "field_level.esn" { atlas <- atlas; shapes <- shapes; insts <- insts; lens <- lens; base <- base; level = 2;
    nx = nx; ny = ny; nz = nz; cell = cell; ratio = ratio; hold = hold; bins = bins; band = band; }
node near_mid: render.field_stack@1 { a <- near.proxy; b <- mid.proxy; domain = size(a) + size(b) * vec3(0.0, 0.0, 1.0); }
node all: render.field_stack@1 { a <- near_mid.result; b <- far.proxy; domain = size(a) + size(b) * vec3(0.0, 0.0, 1.0); }
node near_mid_frames: render.field_frames_join@1 { a <- near.frame; b <- mid.frame; domain = count(a) + count(b); }
node frames: render.field_frames_join@1 { a <- near_mid_frames.result; b <- far.frame; domain = count(a) + count(b); }

output proxy <- all.result;
output frame <- frames.result;
