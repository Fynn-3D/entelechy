//! Light bounced between things (`kernels/radiance.ent`), laid over a renderer's picture `hdr`: the cache of the light the
//! sun, the sky and the `lamps` leave on the proxies' surfaces, a level for each of the proxy's, `scale` times coarser, a
//! `parts`th of it lit anew each frame and bounced again from itself (`bounce`); what comes into probes of the screen,
//! one every `probe` pixels a side, `rays` rays each (the screen first, the cache past it), kept as harmonics, smoothed
//! among alike neighbors, read for each pixel's own normal every `every` pixels a side and laid over each pixel by
//! distance (`strength`); and a cone along each mirror direction,
//! as wide as the surface is rough, the things it meets in place of the renderer's `reflection` from all round. For a
//! renderer that takes no bounced light in itself (lit, ray traced); its look as lit's (`Surround`, `Openness`).
use "../kernels/";

input hdr: Image;
input surface: Grid<Vec4>;
input paint: Grid<Vec4>;
input extra: Grid<Vec4>;
input layers: Grid<Vec4>;
input more: Grid<Vec4>;
/// The renderer's reflection from all round, as it shows (lit's and ray traced's `reflection`).
input reflection: Grid<Vec4 as f16>;
input lens: Lenses;
input sky: SkyLooks;
input proxy: Volume<Vec4>;
input land: Grid<Float>;
input frame: Proxies;
input lamps: Lamps;
/// What shapes the lamps' light, their cookies and profiles (`render.lamp_looks_none` for none).
input lamp_looks: LampLooks;
param scale: Float = 2.0;
param parts: Int = 4;
/// The frames the cache goes on lighting after the proxy's block or the sun last moved; then it rests.
param settle: Int = 48;
param bounce: Float = 1.0;
param strength: Float = 1.0;
param spread: Float = 0.6;
param reach: Float = 30.0;
param steps: Int = 10;
/// How far (meters) each gathering cone is first followed on the screen (0 none).
param screen_reach: Float = 1.0;
/// The screen probes: one every `probe` pixels a side, `rays` rays each, their cones `probe_spread` meters a meter wide.
param probe: Int = 8;
param rays: Int = 32;
param probe_spread: Float = 0.6;
/// Surfaces smoother than this trace their mirror ray to what it meets and light it there (0: every one a cone).
param hit_below: Float = 0.35;
/// The bounce is gathered once every this many pixels a side, and spread back over them by distance.
param every: Int = 2;
param ground: Vec3 = vec3(0.34, 0.29, 0.22);
param ground_light: Float = 1.6;
param sky_light: Float = 1.15;
param open_reach: Vec3 = vec3(0.4, 1.2, 2.5);
param open_strength: Float = 1.6;
param open_least: Float = 0.1;

node rframe: render.radiance_frame@1 { frame <- frame; scale = scale; domain = count(frame); }
node cells: render.radiance_size@1 { rframe <- rframe.result; domain = 3; }
node turn0: Rows<Int> { domain = 4; }
node turn: render.radiance_turn@1 { previous <~ turn.result from turn0.result; frame <- frame; sky <- sky; lamps <- lamps; settle = settle; domain = 4; }
node none: Volume<Vec4> { domain = vec3(1, 1, 1); }
node cache: render.radiance@1 { previous <~ cache.result from none.result; previous_frame <~ rframe.result from rframe.result; proxy <- proxy; land <- land; frame <- frame; rframe <- rframe.result;
    sky <- sky; lamps <- lamps; lamp_looks <- lamp_looks; turn <- turn.result; size <- cells.result; parts = parts; bounce = bounce; spread = spread; reach = reach;
    ground = ground; ground_light = ground_light; sky_light = sky_light; open_reach = open_reach; open_strength = open_strength; open_least = open_least;
    domain = vec3(value(size, 0), value(size, 1), value(size, 2)); }
node screen: render.bounce_screen@1 { hdr <- hdr; surface <- surface; domain = ceil(size(surface) / 4); }
node probes: render.bounce_probes@1 { screen <- screen.result; surface <- surface; lens <- lens; radiance <- cache.result; rframe <- rframe.result; proxy <- proxy; frame <- frame;
    probe = probe; rays = rays; spread = probe_spread; reach = reach; steps = steps; screen_reach = screen_reach; domain = ceil(size(surface) / probe); }
node filtered: render.bounce_probe_filter@1 { red <- probes.red; green <- probes.green; blue <- probes.blue; place <- probes.place; domain = size(place); }
node gathered: render.bounce_gather@1 { red <- filtered.r; green <- filtered.g; blue <- filtered.b; place <- probes.place; surface <- surface; paint <- paint; lens <- lens;
    radiance <- cache.result; rframe <- rframe.result; proxy <- proxy; land <- land; frame <- frame; sky <- sky; lamps <- lamps; lamp_looks <- lamp_looks; every = every; probe = probe; reach = reach;
    steps = steps; hit_below = hit_below; ground = ground; ground_light = ground_light; sky_light = sky_light; open_reach = open_reach; open_strength = open_strength;
    open_least = open_least; domain = ceil(size(surface) / every); }
node bounced: render.bounce@1 { hdr <- hdr; gathered <- gathered.result; mirror <- gathered.mirror; reflection <- reflection; surface <- surface; paint <- paint; extra <- extra; layers <- layers; more <- more; lens <- lens; sky <- sky;
    every = every; strength = strength; domain = size(hdr); }

output result <- bounced.result;
/// The reflection from all round as it now shows (the cache's things in place of the renderer's where they shut it), for
/// `render.reflections`.
output reflection <- bounced.reflected;
output cache <- cache.result;
output cache_frame <- rframe.result;
