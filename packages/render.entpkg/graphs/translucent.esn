//! Translucent things over a renderer's picture (`kernels/translucent.ent`): a mesh (`points`, `faces`), each face's look
//! (`face_looks`, into `looks`: glass, smoke, glow), cut at the near plane (`raster.entpkg`'s `raster.clip_near`), every
//! layer in front of `surface` shaded and summed in no order, laid over `hdr`: what lies behind through all the layers,
//! bent and tinted; the layers' light by their nearness; glows. Glass mirrors the screen, the bounce's `cache` laid as
//! `cache_frame` and the sky; smoke is lit by the sun through the proxies, the sky and the lamps. A scene with no bounce
//! hands over a cache of one empty cell.
use "mesh.entpkg";
use "raster.entpkg";
use "parallel.entpkg";
use "../kernels/";

input points: Rows<MeshPoint>;
input faces: Rows<Face>;
input face_looks: Rows<Int>;
input looks: TranslucentLooks;
input hdr: Image;
input surface: Grid<Vec4>;
input lens: Lenses;
input sky: SkyLooks;
input canvas: Grid<Long>;
input cache: Volume<Vec4>;
input cache_frame: Proxies;
input proxy: Volume<Vec4>;
input land: Grid<Float>;
input frame: Proxies;
input lamps: Lamps;
/// What shapes the lamps' light, their cookies and profiles (`render.lamp_looks_none` for none).
input lamp_looks: LampLooks;
param near: Float = 0.05;
param far: Float = 2000.0;
param smudge: Float = 0.3;

node corners: render.translucent_corners@1 { points <- points; lens <- lens; canvas <- canvas; near = near; far = far; }
node cut: raster.clip_near@1 { vertices <- corners.result; triangles <- faces; domain = count(triangles) * 4; }
node cut_faces: raster.clip_faces@1 { triangles <- faces; domain = count(triangles) * 2; }
node tiles: render.translucent_tiles@1 { vertices <- cut.result; faces <- cut_faces.result; canvas <- canvas; }
node runs: graph "parallel.entpkg/graphs/runs.esn" { counts <- tiles.result; }
node blank: render.translucent_blank@1 { canvas <- canvas; domain = size(canvas) * vec2(12, 1); }
node sums: render.translucent_splat@1 { vertices <- cut.result; faces <- cut_faces.result; face_looks <- face_looks; looks <- looks; tiles <- tiles.result; ends <- runs.ends;
    blank <- blank.result; entries <- runs.entries; picture <- hdr; surface <- surface; lens <- lens; sky <- sky; cache <- cache; rframe <- cache_frame;
    proxy <- proxy; land <- land; frame <- frame; lamps <- lamps; lamp_looks <- lamp_looks; near = near; far = far; smudge = smudge; domain = max(value(entries), 1); }
node laid: render.translucent_resolve@1 { hdr <- hdr; sums <- sums.result; domain = size(hdr); }

output hdr <- laid.result;
