//! A finished picture (tone-mapped, sRGB) scaled to the window's size: an edge-aware upscale
//! (`render.upscale`), sharpened once more without overshoot (`render.sharpen`), each frame stable on its own,
//! nothing carried between frames. A picture already the window's size passes through as it is. Placed:
//!   node shown: graph "render.entpkg/graphs/upscale.esn" { picture <- view.result; amount = 0.8; }
use "../kernels/";

input picture: Image;
/// How much it is sharpened: 0 not at all, 1 the most.
param amount: Float = 0.8;
/// 1: nearest-neighbor scaling (pixel art's look; blocks are equal where the inner resolution is a whole fraction of the window's).
param near: Int = 0;

node up: render.upscale@1 { image <- picture; near = near; domain = window(); }
node sharp: render.sharpen@1 { image <- up.result; amount = amount; }

output result <- sharp.result;
