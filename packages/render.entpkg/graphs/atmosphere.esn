//! The sky as the air makes it (`kernels/atmosphere.ent`): light scattered
//! more than once (made once for the air), the `SkyLook` a renderer lights
//! by for a sun at `elevation` and `bearing` (radians), and the sky round
//! the eye as a table, which `render.atmosphere_sky` paints the sky's
//! pixels from. `sun` is the light above the air; `haze` 1 a clear day.
use "../kernels/";

param elevation: Float = 0.6;
param bearing: Float = 0.0;
param sun: Float = 4.0;
param haze: Float = 1.0;
param clouds: Float = 0.0;
param air: Float = 0.0;
param air_from: Float = 1000000.0;

node spread: render.atmosphere_spread@1 { haze = haze; domain = vec2(32, 32); }
node look: render.atmosphere_look@1 { spread <- spread.result; elevation = elevation; bearing = bearing; sun = sun; haze = haze; clouds = clouds; air = air; air_from = air_from; domain = 1; }
node table: render.atmosphere_view@1 { sky <- look.result; spread <- spread.result; sun = sun; haze = haze; domain = vec2(96, 48); }

output sky <- look.result;
output view <- table.result;
