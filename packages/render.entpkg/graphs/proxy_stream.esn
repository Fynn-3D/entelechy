//! A mesh baked into a proxy a pass a frame (`kernels/proxy_bake.ent`), for a world whose geometry changes as it streams:
//! as `graphs/proxy_bake.esn` takes it (`points`, `faces`, each face's `colors`, the `frame`), but when what it is baked
//! from changes the seeds are laid at once and the jump flooding goes on a pass a frame (`render.proxy_stage`,
//! `render.proxy_flood_staged`), the proxy in use the last one made until the new one is (`render.proxy_published`), so no
//! frame bakes it whole: a frame's share of the baking is a pass's, the new proxy in use nine frames on.
use "parallel.entpkg";
use "mesh.entpkg";
use "../kernels/";

input points: Rows<MeshPoint>;
input faces: Rows<Face>;
input colors: Rows<Vec4>;
input frame: Proxies;
param nx: Int = 128;
param ny: Int = 64;
param nz: Int = 128;
param band: Float = 3.0;

node tiles: render.proxy_bake_tiles@1 { faces <- faces; points <- points; frame <- frame; band = band; }
node runs: graph "parallel.entpkg/graphs/runs.esn" { counts <- tiles.result; }
node blank: Volume<Long> { domain = vec3(nx, ny, nz); value = 9223372036854775807l; }
node near: render.proxy_bake_faces@1 { faces <- faces; points <- points; tiles <- tiles.result; ends <- runs.ends; frame <- frame; blank <- blank.result;
    entries <- runs.entries; band = band; domain = value(entries); }
node seeds: render.proxy_seeds@1 { near <- near.result; faces <- faces; points <- points; frame <- frame; domain = size(near); }
node stage0: Rows<Int> { domain = 1; }
node stage: render.proxy_stage@1 { previous <~ stage.result from stage0.result; points <- points; faces <- faces; colors <- colors; frame <- frame; domain = 2; }
node none: Volume<Vec4> { domain = vec3(1, 1, 1); }
node work: render.proxy_flood_staged@1 { seeds <- seeds.result; previous <~ work.result from none.result; stage <- stage.result; frame <- frame; domain = size(seeds); }
node published: render.proxy_published@1 { work <- work.result; previous <~ published.result from none.result; stage <- stage.result; colors <- colors; frame <- frame;
    domain = size(work); }

output proxy <- published.result;
