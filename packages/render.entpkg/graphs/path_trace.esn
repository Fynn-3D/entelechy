//! The path tracer (`kernels/path_trace.ent`): takes the scene's G-buffer, proxies and lamps
//! (the contract) and gives the HDR picture `hdr`, the lamps' light shown and bounced. Each pixel traces one diffuse and one
//! specular path a frame, of `bounces` bounces; accumulated while the camera rests (at most `most` frames); indirect light denoised in three passes,
//! unfiltered once `clean` frames are accumulated.
use "../kernels/";

input lens: Lenses;
input sky: SkyLooks;
input surface: Grid<Vec4>;
input paint: Grid<Vec4>;
input extra: Grid<Vec4>;
input layers: Grid<Vec4>;
input more: Grid<Vec4>;
input behind_at: Grid<Vec4>;
input behind_dir: Grid<Vec4>;
input behind_paint: Grid<Vec4>;
input behind_normal: Grid<Vec4>;
input through: Grid<Vec4>;
input proxy: Volume<Vec4>;
input land: Grid<Float>;
input frame: Proxies;
input lamps: Lamps;
param bounces: Int = 2;
param most: Int = 512;
param clean: Int = 96;

node count0: render.path_count_start@1 { domain = 1; }
node count: render.path_count@1 { previous <~ count.result from count0.result; lens <- lens; most = most; domain = 1; }
// The lamps' light on each surface, from those each tile of the screen keeps.
node lamp_depth: render.lamps_depth@1 { surface <- surface; domain = ceil(size(surface) / 16); }
node lamp_tiles: render.lamps_tiles@1 { depth <- lamp_depth.result; lamps <- lamps; lens <- lens; surface <- surface; domain = size(depth); }
node lamped: render.lamps_light@1 { surface <- surface; paint <- paint; extra <- extra; layers <- layers; more <- more; tiles <- lamp_tiles.result; lamps <- lamps; lens <- lens;
    proxy <- proxy; land <- land; frame <- frame; domain = size(surface); }
node noisy: render.path_trace@1 { lamps <- lamps; lamped <- lamped.result; surface <- surface; paint <- paint; extra <- extra; layers <- layers; more <- more; behind_at <- behind_at; behind_normal <- behind_normal; proxy <- proxy; land <- land; frame <- frame; sky <- sky; lens <- lens;
    count <- count.result; bounces = bounces; domain = size(surface); }
node blank: render.path_blank@1 { domain = window(); }
// Diffuse light: accumulated, denoised in three passes.
node mean: render.path_accum@1 { previous <~ mean.result from blank.result; current <- noisy.diffuse; surface <- surface; count <- count.result; most = most; domain = size(surface); }
node pass1: render.path_atrous@1 { image <- mean.result; surface <- surface; count <- count.result; gap = 1; clean = clean; }
node pass2: render.path_atrous@1 { image <- pass1.result; surface <- surface; count <- count.result; gap = 2; clean = clean; }
node pass3: render.path_atrous@1 { image <- pass2.result; surface <- surface; count <- count.result; gap = 4; clean = clean; }
// Specular light: accumulated, denoised in two narrower passes, so a reflection keeps its outline.
node gloss: render.path_accum@1 { previous <~ gloss.result from blank.result; current <- noisy.specular; surface <- surface; count <- count.result; most = most; domain = size(surface); }
node gloss1: render.path_atrous@1 { image <- gloss.result; surface <- surface; count <- count.result; gap = 1; clean = clean; }
node gloss2: render.path_atrous@1 { image <- gloss1.result; surface <- surface; count <- count.result; gap = 2; clean = clean; }
// Clearcoat: accumulated, denoised once.
node coated: render.path_accum@1 { previous <~ coated.result from blank.result; current <- noisy.coat; surface <- surface; count <- count.result; most = most; domain = size(surface); }
node coat1: render.path_atrous@1 { image <- coated.result; surface <- surface; count <- count.result; gap = 1; clean = clean; }
// The point seen through a transmissive surface: its diffuse light accumulated, denoised once, then lit.
node far_light: render.path_accum@1 { previous <~ far_light.result from blank.result; current <- noisy.beyond; surface <- surface; count <- count.result; most = most; domain = size(surface); }
node far1: render.path_atrous@1 { image <- far_light.result; surface <- surface; count <- count.result; gap = 1; clean = clean; }
node beyond: render.path_behind@1 { more <- more; behind_at <- behind_at; behind_dir <- behind_dir; behind_paint <- behind_paint; behind_normal <- behind_normal; light <- far1.result; sky <- sky; domain = size(more); }
node shade: render.path_shade@1 { lamped <- lamped.result; beyond <- beyond.result; through <- through; diffuse <- pass3.result; specular <- gloss2.result; coat <- coat1.result; surface <- surface; paint <- paint; extra <- extra; layers <- layers; more <- more; sky <- sky; lens <- lens; domain = size(surface); }

output hdr <- shade.result;
