//! The finish at the picture's own size: glow, tone and sRGB, sharpened by `sharpen` (0 not at all),
//! are made at the size the renderer drew, the scene lays more over it at that size, and `upscale.esn`
//! scales it to the window at last. Placed:
//!   node view: graph "render.entpkg/graphs/tonemap.esn" { hdr <- light.result; }
use "../kernels/";

input hdr: Image;
param exposure: Float = 1.0;
param vivid: Float = 1.0;
/// How much it is sharpened (0 not at all; `upscale.esn` sharpens again after scaling).
param sharpen: Float = 0.0;
/// What is bright enough to glow, and how much of the glow is laid in.
param threshold: Float = 2.0;
param glow: Float = 0.6;
/// The tint of the shadows and of the lights, as much as `warmth` lays them on; the corners' darkening.
param warmth: Float = 1.0;
param shadow_tint: Vec3 = vec3(0.97, 1.0, 1.04);
param light_tint: Vec3 = vec3(1.05, 1.0, 0.93);
param vignette: Float = 0.35;
/// The tone curve (`render.tonemap`'s: 0 ACES, 1 none, as Blender's Standard view, 2 AgX).
param curve: Int = 0;

node bright: render.bright@1 { hdr <- hdr; threshold = threshold; domain = ceil(size(hdr) / 8); }
node bloom_x: render.spread@1 { image <- bright.result; axis = 0; }
node bloom: render.spread@1 { image <- bloom_x.result; axis = 1; }
node view: render.tonemap@1 { hdr <- hdr; bloom <- bloom.result; exposure = exposure; vivid = vivid; sharpen = sharpen; glow = glow; warmth = warmth;
    shadow_tint = shadow_tint; light_tint = light_tint; vignette = vignette; curve = curve; domain = size(hdr); }

output result <- view.result;
