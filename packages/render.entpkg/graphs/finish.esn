//! The finish: the blended picture (`hdr`, the window's size) sharpened a little, a glow round what is bright, exposed and graded for display.
use "../kernels/";

input hdr: Image;
param exposure: Float = 1.0;
param vivid: Float = 1.0;
/// How much it is sharpened (0 not at all).
param sharpen: Float = 0.5;

node bright: render.bright@1 { hdr <- hdr; domain = ceil(window() / 8); }
node bloom_x: render.spread@1 { image <- bright.result; axis = 0; }
node bloom: render.spread@1 { image <- bloom_x.result; axis = 1; }
node view: render.view@1 { hdr <- hdr; bloom <- bloom.result; exposure = exposure; vivid = vivid; sharpen = sharpen; domain = window(); }

output result <- view.result;
