// What a song is made of: its mood, its style and the instruments; the
// scales its modes are; the chords on a scale's degrees; a note's pitch.

/// A mood: its mode (`mode_*`), key (semitones above C), pace (beats a
/// minute) and meter (beats a bar); its eight chords (scale degrees, from
/// 0), each `chord_bars` long; how busy its tune is (0 to 1) and how high
/// (octaves above the middle); its arpeggio (`arp_*`), bass (`bass_*`) and
/// drums (`groove_*`); how hard it drives (0 to 1); and whether it is a
/// short tune played once (`jingle_*`, 0 a song that goes round).
struct Mood {
    mode: Int; key: Int; tempo: Float; meter: Int;
    chords: [Int; 8]; chord_bars: Int;
    busy: Float; high: Int; arp: Int; bass: Int; groove: Int; drive: Float;
    jingle: Int;
}
type Moods = Rows<Mood>;

/// A band (a style of playing): the instruments of the tune, the counter-tune, the chords, the
/// arpeggio and the bass (rows of the instruments); its drums (`kit_*`);
/// how much it echoes and swings; how long its notes are held (0 to 1 of
/// the time to the next); how loud each part is.
struct Band {
    tune: Int; counter: Int; chords: Int; arp: Int; bass: Int; kit: Int;
    echo: Float; swing: Float; legato: Float;
    tune_gain: Float; chords_gain: Float; arp_gain: Float; bass_gain: Float; drums_gain: Float;
}
type Bands = Rows<Band>;

/// An instrument: how it sounds (`osc_*`), with how many harmonics falling
/// off how fast; its envelope (attack, decay, sustain level, release, in
/// seconds); its vibrato (depth, a share of the pitch, and rate); how far
/// its two voices are detuned (a chorus); a square's duty; how loud.
struct Instrument {
    osc: Int; harmonics: Int; roll: Float;
    attack: Float; decay: Float; sustain: Float; release: Float;
    vibrato: Float; rate: Float; detune: Float; duty: Float; gain: Float;
}
type Instruments = Rows<Instrument>;

fn osc_additive() -> Int { return 0; }   // strings, choirs, brass, organs: harmonics
fn osc_square() -> Int { return 1; }     // an old console's pulse
fn osc_triangle() -> Int { return 2; }   // an old console's bass
fn osc_bell() -> Int { return 3; }       // bells, music boxes: a tone rung by another
fn osc_pluck() -> Int { return 4; }      // lutes, harps, kotos, pianos: harmonics dying fast
fn osc_breath() -> Int { return 5; }     // flutes: a soft tone and its breath

fn arp_none() -> Int { return 0; }
fn arp_up() -> Int { return 1; }
fn arp_updown() -> Int { return 2; }
fn arp_broken() -> Int { return 3; }

fn bass_none() -> Int { return 0; }
fn bass_roots() -> Int { return 1; }     // the root each bar, held
fn bass_fifths() -> Int { return 2; }    // root and fifth on the beats
fn bass_walk() -> Int { return 3; }      // a note a beat, walking to the next chord
fn bass_drive() -> Int { return 4; }     // eighths on the root, driving
fn bass_waltz() -> Int { return 5; }     // the root on the bar's first beat

fn groove_none() -> Int { return 0; }
fn groove_march() -> Int { return 1; }
fn groove_battle() -> Int { return 2; }
fn groove_waltz() -> Int { return 3; }
fn groove_soft() -> Int { return 4; }    // a heartbeat, a brush
fn groove_ritual() -> Int { return 5; }  // heavy drums far apart

fn kit_orchestra() -> Int { return 0; }  // timpani, snare, cymbal
fn kit_chip() -> Int { return 1; }       // noise drums
fn kit_folk() -> Int { return 2; }       // frame drum, tambourine
fn kit_taiko() -> Int { return 3; }      // great drums, wood
fn kit_none() -> Int { return 4; }

fn mode_major() -> Int { return 0; }
fn mode_dorian() -> Int { return 1; }
fn mode_phrygian() -> Int { return 2; }
fn mode_lydian() -> Int { return 3; }
fn mode_mixolydian() -> Int { return 4; }
fn mode_minor() -> Int { return 5; }
fn mode_harmonic() -> Int { return 6; }
fn mode_pentatonic() -> Int { return 7; }
fn mode_minor_pentatonic() -> Int { return 8; }
fn mode_in() -> Int { return 9; }        // the Japanese in scale
fn mode_hijaz() -> Int { return 10; }    // the phrygian dominant: a desert's

fn jingle_none() -> Int { return 0; }
fn jingle_victory() -> Int { return 1; }
fn jingle_defeat() -> Int { return 2; }
fn jingle_levelup() -> Int { return 3; }
fn jingle_fanfare() -> Int { return 4; }

/// Whether mode `m` has five degrees to an octave.
fn pentatonic(m: Int) -> Bool { return m >= mode_pentatonic() && m <= mode_in(); }

/// Degree `d` (any whole number; seven to an octave, five in the
/// pentatonic ones) of mode `m`, in semitones above its root.
fn scale_step(m: Int, d: Int) -> Int {
    let five = pentatonic(m);
    let per = if five { 5 } else { 7 };
    let oct = if d >= 0 { d / per } else { (d - per + 1) / per };
    let k = d - oct * per;
    let major = [0, 2, 4, 5, 7, 9, 11];
    let dorian = [0, 2, 3, 5, 7, 9, 10];
    let phrygian = [0, 1, 3, 5, 7, 8, 10];
    let lydian = [0, 2, 4, 6, 7, 9, 11];
    let mixolydian = [0, 2, 4, 5, 7, 9, 10];
    let minor = [0, 2, 3, 5, 7, 8, 10];
    let harmonic = [0, 2, 3, 5, 7, 8, 11];
    let penta = [0, 2, 4, 7, 9, 0, 0];
    let mpenta = [0, 3, 5, 7, 10, 0, 0];
    let in_ = [0, 1, 5, 7, 8, 0, 0];
    let hijaz = [0, 1, 4, 5, 7, 8, 10];
    let i = clamp(k, 0, 6);
    let s = if m == mode_major() { major[i] } else if m == mode_dorian() { dorian[i] } else if m == mode_phrygian() { phrygian[i] }
        else if m == mode_lydian() { lydian[i] } else if m == mode_mixolydian() { mixolydian[i] } else if m == mode_minor() { minor[i] }
        else if m == mode_harmonic() { harmonic[i] } else if m == mode_pentatonic() { penta[i] } else if m == mode_minor_pentatonic() { mpenta[i] } else if m == mode_in() { in_[i] } else { hijaz[i] };
    return s + oct * 12;
}

/// How many degrees an octave has in mode `m`.
fn degrees_of(m: Int) -> Int { return if pentatonic(m) { 5 } else { 7 }; }

/// The pitch (Hz) of a note `semis` semitones above the C below middle C.
fn pitch_of(semis: Float) -> Float { return 130.8128 * pow(2.0, semis / 12.0); }

/// Tone `k` (0 root, 1 third, 2 fifth, 3 seventh) of the chord on degree
/// `root` of mode `m`, in degrees: thirds stacked on the scale (in a
/// pentatonic one, every other degree).
fn chord_degree(m: Int, root: Int, k: Int) -> Int {
    let five = pentatonic(m);
    return root + (if five { [0, 1, 3, 4][clamp(k, 0, 3)] } else { k * 2 });
}

/// The degree, of those of chord `root`, nearest degree `d`.
fn nearest_chord_degree(m: Int, root: Int, d: Int) -> Int {
    let per = degrees_of(m);
    return loop 9 with best = d + 1000 {
        let k = index() % 3;
        let octave = index() / 3 - 1;
        let c = chord_degree(m, root, k) + octave * per + ((d - root) / per) * per;
        if abs(c - d) < abs(best - d) { c } else { best }
    };
}
