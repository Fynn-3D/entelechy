// An instrument (`Instrument`: how it sounds, its envelope, its vibrato)
// and its note: its pitch, `t` seconds after it began, held for `held`
// seconds.
use "random.entpkg";
use "audio.entpkg";
use "scale.ent";

/// An instrument: how it sounds (`osc_*`), with how many harmonics falling
/// off how fast; its envelope (attack, decay, sustain level, release, in
/// seconds); its vibrato (depth, a share of the pitch, and rate); how far
/// its two voices are detuned (a chorus); a square's duty; how loud.
struct Instrument {
    osc: Int; harmonics: Int; roll: Float;
    attack: Float; decay: Float; sustain: Float; release: Float;
    vibrato: Float; rate: Float; detune: Float; duty: Float; gain: Float;
}
type Instruments = Rows<Instrument>;

fn osc_additive() -> Int { return 0; }   // strings, choirs, brass, organs: harmonics
fn osc_square() -> Int { return 1; }     // an old console's pulse
fn osc_triangle() -> Int { return 2; }   // an old console's bass
fn osc_bell() -> Int { return 3; }       // bells, music boxes: a tone rung by another
fn osc_pluck() -> Int { return 4; }      // lutes, harps, kotos, pianos: harmonics dying fast
fn osc_breath() -> Int { return 5; }     // flutes: a soft tone and its breath


/// How loud a note is `t` seconds in, held `held`: its attack, its decay to
/// its sustain, its release after it is let go.
fn note_level(ins: Instrument, t: Float, held: Float) -> Float {
    if t < 0.0 { return 0.0; }
    let a = max(ins.attack, 0.002);
    let on = if t < a { t / a } else { ins.sustain + (1.0 - ins.sustain) * exp(0.0 - (t - a) / max(ins.decay, 0.01)) };
    let off = if t > held { exp(0.0 - (t - held) / max(ins.release, 0.01)) } else { 1.0 };
    return on * off;
}

/// How long after it is let go a note is still heard.
fn note_tail(ins: Instrument) -> Float { return ins.release * 5.0 + 0.02; }

/// One voice of an instrument whose pitch has run `p` turns, `t` seconds
/// in (the turns, not the pitch times the time: its vibrato moves it).
fn timbre(ins: Instrument, p: Float, t: Float, seed: Int) -> Float {
    let o = ins.osc;
    if o == osc_square() { return if fract(p) < ins.duty { 0.6 } else { -0.6 }; }
    if o == osc_triangle() { return (4.0 * abs(fract(p) - 0.5) - 1.0) * 0.8; }
    if o == osc_bell() { return sin(tau() * fract(p) + 1.6 * exp(0.0 - t * 3.0) * cycle(p * 2.756)) * 0.7; }
    let h = clamp(ins.harmonics, 1, 10);
    if o == osc_pluck() {
        let sum = loop h with acc = vec2(0.0, 0.0) {
            let k = float(index() + 1);
            let w = exp(0.0 - t * (1.5 + k * k * 0.5 * ins.roll)) / k;
            vec2(acc.x + cycle(p * k) * w, acc.y + 1.0 / k)
        };
        return sum.x / max(sum.y, 0.5) * 1.6;
    }
    if o == osc_breath() {
        let tone_ = cycle(p) + 0.25 * cycle(p * 2.0) + 0.08 * cycle(p * 3.0);
        return tone_ * 0.75 + soft_noise(t * 2600.0, seed) * 0.06;
    }
    // Harmonics, each a little quieter than the one below as `roll` says.
    let sum = loop h with acc = vec2(0.0, 0.0) {
        let k = float(index() + 1);
        let w = 1.0 / pow(k, ins.roll);
        vec2(acc.x + cycle(p * k) * w, acc.y + w)
    };
    return sum.x / max(sum.y, 0.5) * 1.2;
}

/// A note of an instrument at `semis` (semitones above the C below middle
/// C), `t` seconds in, held `held`: its two voices, a little apart, its
/// vibrato coming in after the attack.
fn play_note(ins: Instrument, semis: Float, t: Float, held: Float, seed: Int) -> Float {
    if t < 0.0 || t > held + note_tail(ins) { return 0.0; }
    let f0 = pitch_of(semis);
    // (the turns its wavering pitch has run, the vibrato's depth coming in after the attack)
    let depth = ins.vibrato * smoothstep(0.12, 0.4, t);
    let one = timbre(ins, vibrato_cycles(f0, depth, ins.rate, t), t, seed);
    let two = if ins.detune > 0.0 { timbre(ins, vibrato_cycles(f0 * (1.0 + ins.detune), depth, ins.rate, t + 0.0013), t + 0.0013, seed + 1) } else { one };
    return (one + two) * 0.5 * note_level(ins, t, held) * ins.gain;
}
