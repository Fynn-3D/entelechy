// The words at points whose answers are known by hand: a minor scale's
// third degree, a pentatonic's octave, the A below middle C, the fifth of
// a major chord and of a pentatonic one, the chord tone nearest a degree;
// and a note's envelope through its attack, its sustain and its release.
use "../kernels/";

node probe: kernel {
    requires { field.write; }
    output result: Rows<Vec4>;
    domain = 2;
    compute {
        let ins = Instrument { osc: osc_additive(), harmonics: 4, roll: 1.0, attack: 0.1, decay: 0.2, sustain: 0.5, release: 0.3,
            vibrato: 0.0, rate: 0.0, detune: 0.0, duty: 0.5, gain: 1.0 };
        return if element() == 0 {
            vec4(float(scale_step(mode_minor(), 2)), float(scale_step(mode_pentatonic(), 5)), pitch_of(9.0), float(chord_degree(mode_major(), 0, 2) * 10 + chord_degree(mode_pentatonic(), 0, 2)))
        } else {
            vec4(note_level(ins, 0.05, 1.0), note_level(ins, 5.0, 10.0), note_level(ins, 1.3, 1.0), float(nearest_chord_degree(mode_major(), 0, 1)))
        };
    }
}

output result <- probe.result;
