// The town's song by the second band from seed 1, begun at the first
// sample, faded in from silence; and the same moment a second time,
// from another seed, a theme of its own.
use "../kernels/";
use "audio.entpkg";

input moods: Moods = "data/moods.csv";
input bands: Bands = "data/bands.csv";
input instruments: Instruments = "../data/instruments.csv";

node paced0: audio.paced_start@1 { domain = 1; }
node paced: audio.paced@1 { previous <~ paced.result from paced0.result; domain = 1; }
node clock: audio.paced_clock@1 { paced <- paced.result; domain = 1; }
node block: audio.paced_size@1 { paced <- paced.result; domain = 1; }
node town: kernel {
    requires { field.write; }
    output result: Tracks;
    domain = 1;
    compute { return Track { mood: 1, style: 1, seed: 1, start: 0l, was_mood: -1, was_style: 0, was_seed: 0, was_start: 0l }; }
}
node other: kernel {
    requires { field.write; }
    output result: Tracks;
    domain = 1;
    compute { return Track { mood: 1, style: 1, seed: 2, start: 0l, was_mood: -1, was_style: 0, was_seed: 0, was_start: 0l }; }
}
node music: music.play@1 { track <- town.result; moods <- moods; bands <- bands; instruments <- instruments; clock <- clock.result; block <- block.result; domain = value(block, 0); }
node theme: music.play@1 { track <- other.result; moods <- moods; bands <- bands; instruments <- instruments; clock <- clock.result; block <- block.result; domain = value(block, 0); }

output sound <- music.result;
