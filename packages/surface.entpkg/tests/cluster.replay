scene cluster.esn

# Eight spheres down a line, each drawn where its middle shows at the
# level its size on the screen asks for, at most a pixel off: the sphere's
# second level or about it (a coarser one would shrink it), a few dozen
# clusters in all. (The sphere's points come of sines, so each backend
# builds its levels a little apart: what is asked holds on all.)
window 640 360
frame 0.0
expect drawn.count[0] > 40
expect drawn.count[0] < 110
expect levels.result[0] <= 2
expect levels.result[7] >= 1
expect 600 20 = 0.6 0.7 0.9

# Behind a wall two meters before the lens, only the near spheres' clusters,
# too large on the screen for the occlusion pyramid to judge, are drawn.
expect walled.count[0] = 12

# The hills drawn at a coarse error: four levels side by side (levels 0
# to 3) and no pixel of the lower half showing the sky between them.
expect gaps.result[0] = 0 15
expect land_drawn.count[0] = 12

# Four pixels off allowed: the far spheres coarser than the near ones, and
# fewer clusters.
param error 4.0
frame 0.05
expect levels.result[0] <= 2
expect levels.result[5] >= 3
expect levels.result[7] >= 3
expect drawn.count[0] < 40

# Everything at its finest: level 0 at every sphere's middle, and more
# clusters drawn.
param error 0.0001
frame 0.1
expect levels.result[0] = 0
expect levels.result[7] = 0
expect drawn.count[0] > 110
