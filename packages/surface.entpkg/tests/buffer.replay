scene buffer.esn

# Moving, every pixel takes the rough one's; at rest, its own fine one;
# the layer behind glass alike.
frame 0.0
expect while_moving.surface[3] = 0 1 0 50
expect at_rest.surface[3] = 1 1 1 13
expect at_rest.paint[1] = 1 0 1 11
expect behind.behind_at[2] = 0 1 0 50

# The small depth map: each pixel the distance at the middle of its 8 by
# 8, column 4 and column 12.
expect depths.result[0] = 4
expect depths.result[1] = 12

# Made one: the second's 12 meters where it is nearer (the first's 13),
# the first's 10, 11 and 12 where they are as near or nearer; the sky
# never in front.
expect one.surface[0] = 0 0 1 10
expect one.surface[2] = 0 1 1 12
expect one.surface[3] = 0 1 0 12
expect over_sky.surface[3] = 1 1 1 13
