// Clusters drawn: a fine sphere built as levels (`mesh.entpkg`), placed
// eight times down a line away from the lens, each ten meters past the
// one before, drawn each at the level its size on the screen asks for; and
// hills seen low across, drawn at a coarse `error` so that many levels
// meet on them, which must leave no gap the sky shows through; the spheres
// again behind a wall the last frame showed nearer. A picture
// of the levels drawn, lit from above.
use "mesh.entpkg";
use "geometry.entpkg";
use "raster.entpkg";
use "../kernels/";

param error: Float = 1.0;
param hills_error: Float = 40.0;

node sphere: mesh.sphere_points@1 { columns = 129; rows = 65; domain = 8385; }
node sphere_faces: mesh.lattice_faces@1 { columns = 129; rows = 65; domain = 16384; }
node built: graph "mesh.entpkg/graphs/cluster.esn" { points <- sphere.result; faces <- sphere_faces.result; }
node insts: kernel {
    requires { field.write; }
    output result: FieldInsts;
    domain = 8;
    compute { let i = element(); return FieldInst { at: vec3(float(i % 2) * 3.0 - 1.5, 0.0, -4.0 - 10.0 * float(i)), turn: 0.3 * float(i), size: 1.0, shape: 0 }; }
}
node lens: kernel {
    requires { field.write; }
    output result: Lenses;
    domain = 1;
    compute { return Lens { eye: vec3(0.0, 0.5, 0.0), ahead: vec3(0.0, 0.0, -1.0), right: vec3(1.0, 0.0, 0.0), up: vec3(0.0, 1.0, 0.0), focal: 1.2 }; }
}
node canvas: Grid<Long> { domain = window(); value = 9223372036854775807l; }
node none: Grid<Float> { domain = vec2(1, 1); }
node drawn: graph "../graphs/cluster.esn" { points <- built.points; up <- built.up; faces <- built.faces; clusters <- built.clusters; meshes <- built.meshes; errors <- built.errors;
    insts <- insts.result; lens <- lens.result; canvas <- canvas.result; hzb <- none.result; error = error; }
node raster: native.rasterize@3 { vertices <- drawn.corners; triangles <- drawn.faces; canvas <- canvas.result; domain = size(canvas); }

// A wall two meters before the lens, as a last frame's surface: its occlusion pyramid leaves out the clusters wholly behind it.
node wall: kernel {
    requires { field.write; }
    output result: Grid<Vec4>;
    domain = window();
    compute { return vec4(0.0, 0.0, 1.0, 2.0); }
}
node pyramid: surface.cluster_hzb@1 { surface <- wall.result; domain = ceil(size(surface) / 16.0); }
node walled: graph "../graphs/cluster.esn" { points <- built.points; up <- built.up; faces <- built.faces; clusters <- built.clusters; meshes <- built.meshes; errors <- built.errors;
    insts <- insts.result; lens <- lens.result; canvas <- canvas.result; hzb <- pyramid.result; error = error; }

/// The level drawn at the middle of each sphere on the screen (-1 for the sky).
node levels: kernel {
    requires { field.read; field.write; }
    input surface: Grid<Surface> <- raster.surface;
    input kept: Rows<IVec2> <- drawn.kept;
    input clusters: Rows<Cluster> <- built.clusters;
    input insts: FieldInsts <- insts.result;
    input lens: Lenses <- lens.result;
    output result: Rows<Int>;
    domain = 8;
    compute {
        let q = project(at(lens, 0), at(insts, element()).at, size(surface));
        return cluster_level_of(kept, clusters, at(surface, q.xy).id);
    }
}

// The hills: 128 by 128 cells over 400 meters, seen low from one end.
node plane: mesh.plane_points@1 { size = vec2(400.0, 400.0); columns = 129; rows = 129; domain = 16641; }
node hills: kernel {
    requires { field.read; field.write; }
    input points: Rows<MeshPoint> <- plane.result;
    output result: Rows<MeshPoint>;
    compute {
        let p = sample(points);
        let x = p.position.x;
        let z = p.position.z;
        let h = 12.0 * sin(x * 0.02) * cos(z * 0.017) + 3.0 * sin(x * 0.11 + z * 0.07);
        let dx = 0.24 * cos(x * 0.02) * cos(z * 0.017) + 0.33 * cos(x * 0.11 + z * 0.07);
        let dz = -0.204 * sin(x * 0.02) * sin(z * 0.017) + 0.21 * cos(x * 0.11 + z * 0.07);
        return MeshPoint { position: vec3(x, h, z), normal: normalize(vec3(0.0 - dx, 1.0, 0.0 - dz)), uv: p.uv };
    }
}
node hills_faces: mesh.lattice_faces@1 { columns = 129; rows = 129; domain = 32768; }
node land: graph "mesh.entpkg/graphs/cluster.esn" { points <- hills.result; faces <- hills_faces.result; }
node one: kernel {
    requires { field.write; }
    output result: FieldInsts;
    domain = 1;
    compute { return FieldInst { at: vec3(0.0, 0.0, 0.0), turn: 0.0, size: 1.0, shape: 0 }; }
}
node low: kernel {
    requires { field.write; }
    output result: Lenses;
    domain = 1;
    compute {
        let ahead = normalize(vec3(0.3, -0.12, -1.0));
        let right = normalize(cross(ahead, vec3(0.0, 1.0, 0.0)));
        return Lens { eye: vec3(-30.0, 22.0, 190.0), ahead: ahead, right: right, up: cross(right, ahead), focal: 1.2 };
    }
}
node land_drawn: graph "../graphs/cluster.esn" { points <- land.points; up <- land.up; faces <- land.faces; clusters <- land.clusters; meshes <- land.meshes; errors <- land.errors;
    insts <- one.result; lens <- low.result; canvas <- canvas.result; hzb <- none.result; error = hills_error; }
node land_raster: native.rasterize@3 { vertices <- land_drawn.corners; triangles <- land_drawn.faces; canvas <- canvas.result; domain = size(canvas); }
/// How many pixels of the lower half show the sky (a gap between levels), and how many levels the hills are drawn at.
node gaps: kernel {
    requires { field.read; field.write; }
    input surface: Grid<Surface> <- land_raster.surface;
    input kept: Rows<IVec2> <- land_drawn.kept;
    input clusters: Rows<Cluster> <- land.clusters;
    output result: Rows<IVec2>;
    compute {
        let s = sample(surface);
        let low = coord().y > size(surface).y * 0.55;
        return ivec2(int(low && s.depth >= 1.0), 1 << max(cluster_level_of(kept, clusters, s.id), 0));
    }
    merge(a, b) { return ivec2(a.x + b.x, a.y | b.y); }
}

node seen: kernel {
    requires { field.read; field.write; }
    input surface: Grid<Surface> <- raster.surface;
    input kept: Rows<IVec2> <- drawn.kept;
    input clusters: Rows<Cluster> <- built.clusters;
    output result: Image;
    domain = size(surface);
    compute {
        let s = sample(surface);
        if s.depth >= 1.0 { return vec4(0.6, 0.7, 0.9, 1.0); }
        let k = cluster_level_of(kept, clusters, s.id);
        let tint = [vec3(0.9, 0.3, 0.3), vec3(0.9, 0.7, 0.2), vec3(0.4, 0.8, 0.3), vec3(0.2, 0.7, 0.8), vec3(0.3, 0.4, 0.9), vec3(0.7, 0.3, 0.9), vec3(0.9, 0.9, 0.9), vec3(0.5, 0.5, 0.5)];
        let c = tint[max(k, 0)] * (0.25 + 0.75 * max(dot(normalize(s.normal), normalize(vec3(0.3, 1.0, 0.4))), 0.0));
        return vec4(c.x, c.y, c.z, 1.0);
    }
}

output result <- seen.result;
