scene proxy_bake.esn

# Cells are numbered x first, then y, then z, 32 a side, each a point of
# the lattice 3/32 of a meter apart from -1.5. Every cell knows how far
# the nearest face is, near ones exactly, far ones by the points spread to
# them, less half a cell: the ball's middle (the cell at the origin) its
# inner radius in, the volume's corner (-1.5 all three ways) its way to
# the ball out, the cell half a meter under the ball's bottom pole the way
# to it (blue, the lower half's). A cell at the ball's side a cell above
# its middle lies on a red face, just outside its shell; one a cell below
# it, on a blue face, alike.
frame 0.0
expect baked.proxy[16912].x = 0.9446 0.01
expect baked.proxy[0].x = 1.5528 0.01
expect baked.proxy[0].w = 0.8 0.0001
expect baked.proxy[16400] = 0.4531 0.1 0.1 0.8 0.01
expect baked.proxy[27184] = 0.0059 0.8 0.1 0.1 0.002
expect baked.proxy[27120] = 0.0059 0.1 0.1 0.8 0.002
expect baked.proxy[16560].y = 0.1 0.0001
expect baked.proxy[16560].w = 0.8 0.0001
expect baked.proxy[16560].x < 0.0
