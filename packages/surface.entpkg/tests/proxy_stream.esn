// A mesh baked into a proxy a pass a frame (`graphs/proxy_stream.esn`): the
// ball of `proxy_bake.esn` moved `shift` meters along x, baked whole and a
// pass a frame; how far the two proxies are apart at most (`apart`, the
// distances' and colors'), and the cell at the ball's middle as each has it.
use "mesh.entpkg";
use "raster.entpkg";
use "../kernels/";

param shift: Float = 0.0;

node sphere: mesh.sphere_points@1 { columns = 33; rows = 17; domain = 561; }
node ball: kernel {
    requires { field.read; field.write; }
    input points: Rows<MeshPoint> <- sphere.result;
    param shift: Float = shift;
    output result: Rows<MeshPoint>;
    compute { let p = sample(points); return MeshPoint { ..p, position: p.position + vec3(shift, 0.0, 0.0) }; }
}
node ball_faces: mesh.lattice_faces@1 { columns = 33; rows = 17; domain = 1024; }
node colors: kernel {
    requires { field.read; field.write; }
    input faces: Rows<Face> <- ball_faces.result;
    output result: Rows<Vec4>;
    compute { return if element() >= 512 { vec4(0.8, 0.1, 0.1, 0.0) } else { vec4(0.1, 0.1, 0.8, 0.0) }; }
}
node frame: kernel {
    requires { field.write; }
    output result: Proxies;
    domain = 1;
    compute { return Proxy { lo: vec3(-1.5, -1.5, -1.5), cell: 3.0 / 32.0, cells: vec3(32.0, 32.0, 32.0), land_lo: vec2(-100.0, -100.0), land_cell: 200.0, ground: vec3(0.3, 0.3, 0.3) }; }
}
node baked: graph "../graphs/proxy_bake.esn" { points <- ball.result; faces <- ball_faces.result; colors <- colors.result; frame <- frame.result; nx = 32; ny = 32; nz = 32; }
node sliced: graph "../graphs/proxy_stream.esn" { points <- ball.result; faces <- ball_faces.result; colors <- colors.result; frame <- frame.result; nx = 32; ny = 32; nz = 32; }
node apart: kernel {
    requires { field.read; field.write; }
    input whole: Volume<Vec4> <- baked.proxy;
    input sliced: Volume<Vec4> <- sliced.proxy;
    output result: Rows<Float>;
    domain = 1;
    compute {
        return loop 32768 with m = 0.0 {
            let g = ivec3(index() % 32, (index() / 32) % 32, index() / 1024);
            let d = abs(at(whole, g) - at(sliced, g));
            max(m, max(max(d.x, d.y), max(d.z, d.w)))
        };
    }
}

output result <- apart.result;
