scene decals.esn

# The poster's red half all red and glossy, its blue half halfway over the
# gray; the gold patch at half strength: half gold, half metal, glowing
# half its 3; the bumps tilting the floor's normal across (0.6 of it), its
# paint its own; the decal on its side, and the floor past every decal, as
# they were.
frame 0.0
expect laid.painted.result[1997] = 0.9 0.1 0.1 0.2 0.0001
expect laid.painted.result[2007] = 0.3 0.3 0.7 0.5 0.0001
expect laid.painted.result[2028] = 0.75 0.65 0.35 0.8 0.0001
expect laid.extras.result[2028] = 1 0.5 1.5 0 0.0001
expect laid.bent.result[3039] = 0.6 0.8 0 10.2893915 0.0001
expect laid.painted.result[991] = 0.5 0.5 0.5 0.8 0.0001
expect laid.bent.result[991] = 0 1 0 10.327285 0.0001
expect laid.painted.result[100] = 0.5 0.5 0.5 0.8 0.0001
expect bare.painted.result[1997] = 0.5 0.5 0.5 0.8 0.0001
expect bare.bent.result[3039] = 0 1 0 10.2893915 0.0001

# None laid: the G-buffer as it was.
param laid 0
frame 0.1
expect laid.painted.result[1997] = 0.5 0.5 0.5 0.8 0.0001
expect laid.extras.result[2028] = 1 0 0 0 0.0001
expect laid.bent.result[3039] = 0 1 0 10.2893915 0.0001
