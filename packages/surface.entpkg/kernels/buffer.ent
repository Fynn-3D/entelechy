// The G-buffer as a renderer takes it: the sky's depth (`no_hit`), the small depth map the lens picks with, the
// G-buffer settled from a rough one while the lens moves and a fine one once it rests (the layer seen through glass
// too), a ray walked across it on the screen, and a world plane through the lens's clip space.
use "geometry.entpkg";

/// The depth of the sky (where a view ray meets nothing).
fn no_hit() -> Float { return 1000000.0; }

// ------------------------------------------------------------------ the lens (`geometry.entpkg`'s `Lens`)

/// A world plane (what lies where `dot(normal, p)` is not below `level`) as a plane through `lens_clip`'s clip space, for
/// `raster.entpkg`'s `raster.clip_plane` (`domain = 1`): `dot(result, clip)` is the world plane's distance (times a share
/// of a point's own `w`) for every point drawn through `lens` onto `canvas` between `near` and `far`.
kernel surface.lens_clip_plane@1 {
    requires { field.read; field.write; }
    input lens: Lenses;
    input canvas: Grid<Long>;
    param normal: Vec3 = vec3(0.0, 1.0, 0.0);
    param level: Float = 0.0;
    param near: Float = 0.05;
    param far: Float = 20000.0;
    output result: Rows<Vec4>;
    compute {
        let l = at(lens, 0);
        let ext = size(canvas);
        let aspect = ext.x / max(ext.y, 1.0);
        let sx = l.focal * 2.0 / aspect;
        let sy = l.focal * 2.0;
        let k = far / (far - near);
        // A point's world distance is c0 + (n.right) x + (n.up) y + (n.ahead) z in its view's terms; x, y and z are clip's
        // x / sx, y / sy and w, and 1 is (k w - z) / (k near).
        let c0 = dot(normal, l.eye) - level;
        return vec4(dot(normal, l.right) / sx, dot(normal, l.up) / sy, 0.0 - c0 / (k * near), dot(normal, l.ahead) + c0 / near);
    }
}

/// A ray on the screen (for screen-space reflections and reflections close to a surface): from `p` along `dir` for `far` meters, at most 48 steps
/// (`steps` steps, dense near and sparse far, the start jittered by `jitter` steps), projected onto the screen against the G-buffer's depth; where it passes
/// behind the thing in some pixel (no thicker than `thick` meters), it met it. The pixel met (xy) and how far it went
/// (z); z is -1 where it met nothing.
fn screen_march(surface: Grid<Vec4>, l: Lens, extent: Vec2, p: Vec3, dir: Vec3, far: Float, steps: Int, thick: Float, jitter: Float) -> Vec3 {
    return loop 48 with r = vec3(0.0, 0.0, -1.0) until r.z >= 0.0 || index() >= steps {
        // Dense first, then sparse: short steps near, so a reflection close to a surface does not skip it.
        let t = far * pow((float(index()) + jitter) / float(steps), 2.0);
        let x = p + dir * t;
        let d = x - l.eye;
        let ahead = dot(d, l.ahead);
        let uv = vec2(dot(d, l.right), dot(d, l.up)) / max(ahead, 0.001) * l.focal;
        let q = vec2(uv.x * extent.y + extent.x * 0.5 - 0.5, extent.y * 0.5 - uv.y * extent.y - 0.5);
        let inside = ahead > 0.05 && q.x >= 0.0 && q.y >= 0.0 && q.x <= extent.x - 1.0 && q.y <= extent.y - 1.0;
        let o = if inside { at(surface, floor(q + 0.5)) } else { vec4(0.0, 0.0, 0.0, no_hit()) };
        let behind = length(d) - o.w;
        if inside && o.w < no_hit() * 0.5 && behind > 0.02 && behind < thick && t > 0.03 { vec3(floor(q.x + 0.5), floor(q.y + 0.5), t) } else { r }
    };
}


/// The small depth map: the middle pixel's depth of each 8 by 8, for picking with the lens (the whole G-buffer
/// is too large to hand the lens each frame).
kernel surface.depths@1 {
    requires { field.read; field.write; }
    input surface: Grid<Vec4>;
    output result: Grid<Float>;
    compute { return at(surface, min(coord() * 8.0 + 4.0, size(surface) - vec2(1.0, 1.0))).w; }
}
/// The G-buffer, moving and settled: while the lens moves, the shrunk `rough_*` (one for each `shrink` by `shrink`
/// pixels, the nearest taken, not blended across edges); once it stops, the full-resolution `fine_*`. All five are swapped.
kernel surface.settle@1 {
    requires { field.read; field.write; }
    input fine_surface: Grid<Vec4>;
    input fine_paint: Grid<Vec4>;
    input fine_extra: Grid<Vec4>;
    input rough_surface: Grid<Vec4>;
    input rough_paint: Grid<Vec4>;
    input rough_extra: Grid<Vec4>;
    input fine_layers: Grid<Vec4>;
    input fine_more: Grid<Vec4>;
    input rough_layers: Grid<Vec4>;
    input rough_more: Grid<Vec4>;
    input settled: Rows<Int>;
    param shrink: Int = 2;
    output surface: Grid<Vec4>;
    output paint: Grid<Vec4>;
    output extra: Grid<Vec4>;
    output layers: Grid<Vec4>;
    output more: Grid<Vec4>;
    compute {
        let q = coord();
        if at(settled, 0) == 1 { return { surface: at(fine_surface, q), paint: at(fine_paint, q), extra: at(fine_extra, q), layers: at(fine_layers, q), more: at(fine_more, q) }; }
        let r = min(floor(q / float(shrink)), size(rough_surface) - vec2(1.0, 1.0));
        return { surface: at(rough_surface, r), paint: at(rough_paint, r), extra: at(rough_extra, r), layers: at(rough_layers, r), more: at(rough_more, r) };
    }
}

/// The layer seen through, settled and moving too (as `surface.settle`).
kernel surface.settle_behind@1 {
    requires { field.read; field.write; }
    input fine_at: Grid<Vec4>;
    input fine_dir: Grid<Vec4>;
    input fine_paint: Grid<Vec4>;
    input fine_normal: Grid<Vec4>;
    input fine_through: Grid<Vec4>;
    input rough_at: Grid<Vec4>;
    input rough_dir: Grid<Vec4>;
    input rough_paint: Grid<Vec4>;
    input rough_normal: Grid<Vec4>;
    input rough_through: Grid<Vec4>;
    input settled: Rows<Int>;
    param shrink: Int = 2;
    output behind_at: Grid<Vec4>;
    output behind_dir: Grid<Vec4>;
    output behind_paint: Grid<Vec4>;
    output behind_normal: Grid<Vec4>;
    output through: Grid<Vec4>;
    compute {
        let q = coord();
        if at(settled, 0) == 1 {
            let f = min(q, size(fine_at) - vec2(1.0, 1.0));
            return { behind_at: at(fine_at, f), behind_dir: at(fine_dir, f), behind_paint: at(fine_paint, f), behind_normal: at(fine_normal, f), through: at(fine_through, f) };
        }
        let r = min(floor(q / float(shrink)), size(rough_at) - vec2(1.0, 1.0));
        return { behind_at: at(rough_at, r), behind_dir: at(rough_dir, r), behind_paint: at(rough_paint, r), behind_normal: at(rough_normal, r), through: at(rough_through, r) };
    }
}
