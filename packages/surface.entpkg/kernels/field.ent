// Instanced distance fields: the scene's proxy baked from its things' own distances. Each kind of thing brings its distance
// volume (a shape: an asset's proxy, its `Proxy` frame in the asset's own meters); the shapes are packed into one atlas, side
// by side up its depth (`surface.field_atlas8`, `surface.field_shapes8`; more than eight joined, `surface.field_stack`,
// `surface.field_frames_join`). Each placed thing is a `FieldInst`: where it stands, how far it is turned about the vertical (as
// `turned`: x toward z), how large, which shape. Round the lens a block of the scene (`surface.field_frame`, held to steps so it
// is baked again only a step on) is baked from the things standing in it: its things kept (`surface.field_near`), its columns
// cut into bins across the ground, each bin's things listed (`surface.field_bin_counts`, `graphs/field.esn`'s runs,
// `surface.field_bin_fill`), and each cell of the block the nearest of its bin's things (`surface.field_bake`). What it gives is
// a proxy as the contract has it (`Volume<Vec4>`: distance and albedo, and its `Proxies` frame), so every renderer traces it.
use "geometry.entpkg";
use "buffer.ent";
use "proxy.ent";

/// A placed thing: where its origin stands, its turn about the vertical, its size, and the shape (atlas slot) it is; a shape
/// below 0 is not in the field.
struct FieldInst { at: Vec3; turn: Float; size: Float; shape: Int; }
type FieldInsts = Rows<FieldInst>;

/// Where world point `p` falls in thing `it`'s own meters.
fn field_local(it: FieldInst, p: Vec3) -> Vec3 {
    let d = (p - it.at) / max(it.size, 0.0001);
    let c = cos(it.turn);
    let s = sin(it.turn);
    return vec3(c * d.x + s * d.z, d.y, c * d.z - s * d.x);
}

/// Shape `k`'s distance and albedo at `q` (its own meters), past its box too: the way to the box and what the box holds there.
fn field_shape_at(atlas: Volume<Vec4>, shapes: Proxies, k: Int, q: Vec3) -> Vec4 {
    let fr = at(shapes, k);
    let c = (q - fr.lo) / fr.cell;
    let n = fr.cells - vec3(1.0, 1.0, 1.0);
    let cq = clamp(c, vec3(0.0, 0.0, 0.0), n);
    let v = at_linear(atlas, vec3(cq.x, cq.y, cq.z + float(k) * fr.cells.z) + 0.5);
    return vec4(v.x + length(c - cq) * fr.cell, v.y, v.z, v.w);
}

/// The circle across the ground thing `it` stands within (xy its middle, z its radius), from its shape's box.
fn field_reach(shapes: Proxies, it: FieldInst) -> Vec3 {
    let fr = at(shapes, it.shape);
    let lo = fr.lo;
    let hi = fr.lo + fr.cells * fr.cell;
    let mid = (lo + hi) * 0.5;
    let c = cos(it.turn);
    let s = sin(it.turn);
    let w = vec2(c * mid.x - s * mid.z, s * mid.x + c * mid.z) * it.size;
    return vec3(it.at.x + w.x, it.at.z + w.y, length(vec2(hi.x - lo.x, hi.z - lo.z)) * 0.5 * it.size);
}

/// Bin `b` of `bins` by `bins` across the block `fr`, widened by `band` meters each way: its lower and upper corner.
fn field_bin_box(fr: Proxy, b: Int, bins: Int, band: Float) -> Vec4 {
    let side = vec2(fr.cells.x, fr.cells.z) * fr.cell / float(bins);
    let lo = vec2(fr.lo.x, fr.lo.z) + vec2(float(b % bins), float(b / bins)) * side;
    return vec4(lo.x - band, lo.y - band, lo.x + side.x + band, lo.y + side.y + band);
}
fn field_in_bin(r: Vec3, box: Vec4) -> Bool {
    let near = clamp(vec2(r.x, r.y), vec2(box.x, box.y), vec2(box.z, box.w));
    return length(near - vec2(r.x, r.y)) <= r.z;
}

/// Shapes packed into one atlas, up its depth: `v0` to `v7`, all of one size (the domain `size(v0) * vec3(1.0, 1.0,
/// 8.0)`). A scene with fewer shapes wires a shape twice.
kernel surface.field_atlas8@1 {
    requires { field.read; field.write; }
    input v0: Volume<Vec4>;
    input v1: Volume<Vec4>;
    input v2: Volume<Vec4>;
    input v3: Volume<Vec4>;
    input v4: Volume<Vec4>;
    input v5: Volume<Vec4>;
    input v6: Volume<Vec4>;
    input v7: Volume<Vec4>;
    output result: Volume<Vec4>;
    compute {
        let q = coord();
        let r = size(v0).z;
        let k = int(floor(q.z / r));
        let l = vec3(q.x, q.y, q.z - float(k) * r);
        return if k == 0 { at(v0, l) } else if k == 1 { at(v1, l) } else if k == 2 { at(v2, l) } else if k == 3 { at(v3, l) }
            else if k == 4 { at(v4, l) } else if k == 5 { at(v5, l) } else if k == 6 { at(v6, l) } else { at(v7, l) };
    }
}

/// The frames of the atlas's eight shapes, in its order (`domain = 8`).
kernel surface.field_shapes8@1 {
    requires { field.read; field.write; }
    input f0: Proxies;
    input f1: Proxies;
    input f2: Proxies;
    input f3: Proxies;
    input f4: Proxies;
    input f5: Proxies;
    input f6: Proxies;
    input f7: Proxies;
    output result: Proxies;
    compute {
        let k = element();
        return if k == 0 { at(f0, 0) } else if k == 1 { at(f1, 0) } else if k == 2 { at(f2, 0) } else if k == 3 { at(f3, 0) }
            else if k == 4 { at(f4, 0) } else if k == 5 { at(f5, 0) } else if k == 6 { at(f6, 0) } else { at(f7, 0) };
    }
}

/// Two volumes as one, `b`'s cells up the depth after `a`'s (the domain `size(a) + size(b) * vec3(0.0, 0.0, 1.0)`): two atlases
/// for more than eight shapes, or a field's levels.
kernel surface.field_stack@1 {
    requires { field.read; field.write; }
    input a: Volume<Vec4>;
    input b: Volume<Vec4>;
    output result: Volume<Vec4>;
    compute {
        let q = coord();
        let za = size(a).z;
        return if q.z < za { at(a, q) } else { at(b, vec3(q.x, q.y, q.z - za)) };
    }
}
/// Two tables of frames as one, `b`'s after `a`'s (`domain = count(a) + count(b)`): two atlases' shapes, or a field's levels.
kernel surface.field_frames_join@1 {
    requires { field.read; field.write; }
    input a: Proxies;
    input b: Proxies;
    output result: Proxies;
    compute { let e = element(); return if e < count(a) { at(a, e) } else { at(b, e - count(a)) }; }
}

/// Level `level` of the block of the scene baked round the lens: `nx` by `ny` by `nz` cells of `cell` meters times `ratio` to
/// the `level` (each level coarser and wider than the one before), its foot at the scene's (`base`'s lo y), its middle across
/// the ground where the lens looks, moved in steps of `hold` of its width (baked again only a step on); the ground (`base`'s
/// land) as the scene has it.
kernel surface.field_frame@1 {
    requires { field.read; field.write; }
    input lens: Lenses;
    input base: Proxies;
    param nx: Int = 160;
    param ny: Int = 48;
    param nz: Int = 160;
    param cell: Float = 0.5;
    param level: Int = 0;
    param ratio: Float = 4.0;
    param hold: Float = 0.25;
    output result: Proxies;
    compute {
        let l = at(lens, 0);
        let b = at(base, 0);
        let cells = vec3(float(nx), float(ny), float(nz));
        let size = cell * pow(ratio, float(level));
        let width = vec2(cells.x, cells.z) * size;
        // Toward where the lens looks: most of what it sees near lies ahead.
        let ahead = normalize(vec2(l.ahead.x, l.ahead.z) + vec2(0.0001, 0.0));
        let middle = vec2(l.eye.x, l.eye.z) + ahead * width.x * 0.25;
        let step = max(width.x * hold, size);
        let lo = floor((middle - width * 0.5) / step) * step;
        return Proxy { lo: vec3(lo.x, b.lo.y, lo.y), cell: size, cells: cells, land_lo: b.land_lo, land_cell: b.land_cell, ground: b.ground };
    }
}

/// 1 for each thing standing in the block (widened by `band` of its cells), 0 for the rest: kept (`parallel`'s compact) before
/// the bins look, so each bin walks the block's things alone, not the whole scene's.
kernel surface.field_near@1 {
    requires { field.read; field.write; }
    input insts: FieldInsts;
    input shapes: Proxies;
    input frame: Proxies;
    param band: Float = 8.0;
    output result: Rows<Int>;
    compute {
        let it = sample(insts);
        let fr = at(frame, 0);
        let w = band * fr.cell;
        let box = vec4(fr.lo.x - w, fr.lo.z - w, fr.lo.x + fr.cells.x * fr.cell + w, fr.lo.z + fr.cells.z * fr.cell + w);
        return if it.shape >= 0 && field_in_bin(field_reach(shapes, it), box) { 1 } else { 0 };
    }
}

/// How many of the block's things (`kept`, `kept_count` of them) stand in each bin (`bins` by `bins` across the block, widened
/// by `band` of its cells), for `graphs/field.esn`'s runs.
kernel surface.field_bin_counts@1 {
    requires { field.read; field.write; }
    input insts: FieldInsts;
    input kept: Rows<Int>;
    input kept_count: Rows<Int>;
    input shapes: Proxies;
    input frame: Proxies;
    param bins: Int = 16;
    param band: Float = 8.0;
    output result: Rows<Int>;
    compute {
        let fr = at(frame, 0);
        let box = field_bin_box(fr, element(), bins, band * fr.cell);
        return loop at(kept_count, 0) with n = 0 {
            let it = at(insts, at(kept, index()));
            if field_in_bin(field_reach(shapes, it), box) { n + 1 } else { n }
        };
    }
}

/// Each bin's things, in their order, in its run of the lists.
kernel surface.field_bin_fill@1 {
    requires { field.read; field.write; }
    input counts: Rows<Int>;
    input ends: Rows<Int>;
    input insts: FieldInsts;
    input kept: Rows<Int>;
    input kept_count: Rows<Int>;
    input shapes: Proxies;
    input frame: Proxies;
    input slots: Rows<Int>;
    param bins: Int = 16;
    param band: Float = 8.0;
    output result: Rows<Int>;
    struct Placed { at: Int; value: Int; }
    scatter into slots with max {
        let b = element();
        let fr = at(frame, 0);
        let box = field_bin_box(fr, b, bins, band * fr.cell);
        let start = at(ends, b) - sample(counts);
        loop at(kept_count, 0) with k = 0 {
            let i = at(kept, index());
            if field_in_bin(field_reach(shapes, at(insts, i)), box) {
                emit(Placed { at: start + k, value: i });
                k + 1
            } else { k }
        };
        return Placed { at: -1, value: -1 };
    }
}

/// The block's distances (`domain = frame's cells`): each cell the nearest of the things its bin lists, in meters, and that
/// thing's albedo; `band` cells where none is nearer (what lies past it is at least that far).
kernel surface.field_bake@1 {
    requires { field.read; field.write; }
    input atlas: Volume<Vec4>;
    input shapes: Proxies;
    input insts: FieldInsts;
    input frame: Proxies;
    input ends: Rows<Int>;
    input lists: Rows<Int>;
    param bins: Int = 16;
    param band: Float = 8.0;
    output result: Volume<Vec4>;
    compute {
        let fr = at(frame, 0);
        let p = fr.lo + coord() * fr.cell;
        let g = clamp(floor((vec2(p.x, p.z) - vec2(fr.lo.x, fr.lo.z)) / (vec2(fr.cells.x, fr.cells.z) * fr.cell) * float(bins)), vec2(0.0, 0.0), vec2(float(bins - 1), float(bins - 1)));
        let b = int(g.x) + int(g.y) * bins;
        let start = if b == 0 { 0 } else { at(ends, b - 1) };
        let end = at(ends, b);
        return loop end - start with best = vec4(band * fr.cell, 0.0, 0.0, 0.0) {
            let i = at(lists, start + index());
            if i < 0 { best } else {
                let it = at(insts, i);
                // A thing whose circle across the ground lies farther than the nearest yet is not looked into.
                let r = field_reach(shapes, it);
                if length(vec2(p.x, p.z) - vec2(r.x, r.y)) - r.z >= best.x { best } else {
                    let v = field_shape_at(atlas, shapes, it.shape, field_local(it, p));
                    let d = v.x * it.size;
                    if d < best.x { vec4(d, v.y, v.z, v.w) } else { best }
                }
            }
        };
    }
}
