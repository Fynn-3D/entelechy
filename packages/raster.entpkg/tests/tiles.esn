// A triangle's weights at a point inside it, and a box cut into tiles: the
// fifth tile of a box 40 by 20 cut 16 a side, its corner and its size.
use "../kernels/";

node probe: kernel {
    requires { field.write; }
    output result: Rows<Vec4>;
    domain = 2;
    compute {
        let w = face_weights(vec2(0.0, 0.0), vec2(4.0, 0.0), vec2(0.0, 4.0), vec2(1.0, 1.0), 16.0);
        let t = box_tile(vec4(0.0, 0.0, 40.0, 20.0), 16, 4);
        return if element() == 0 { vec4(w, 0.0) } else { vec4(float(t.x), float(t.y), float(t.z), float(t.w)) };
    }
}

output result <- probe.result;
