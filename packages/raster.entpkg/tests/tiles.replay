scene tiles.esn

# (1, 1) in the triangle (0, 0), (4, 0), (0, 4): half the first corner's,
# a quarter each of the others'. Three tiles across: the fifth is the
# second of the second row, its last row four pixels high.
frame 0.0
expect probe.result[0] = 0.5 0.25 0.25 0
expect probe.result[1] = 16 16 16 4
