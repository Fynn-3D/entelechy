//! Vertex and triangle rows in, the surface out: for every pixel, the
//! nearest triangle's depth, normal and uv, perspective-correct, and its
//! row as `id`. Place it with
//!   node raster: graph "../../packages/raster.entpkg/graphs/raster.esn" {
//!       vertices <- project.result;
//!       triangles <- faces.result;
//!       width = 320;
//!       height = 240;
//!   }
//! and read `raster.surface` where `native.rasterize@1` gave `surface`.
use "../kernels/raster.ent";

input vertices: Rows<Corner>;
input triangles: Rows<Face>;
param width: Int = 320;
param height: Int = 240;

// What a pixel holds before anything is drawn on it: the key no
// fragment gives.
node empty: Grid<Long> { domain = vec2(width, height); value = 9223372036854775807l; }

// Every triangle covers its own box, one invocation each: the fastest
// for meshes of small triangles. `tiled` forms of this preset cut a
// large triangle across many.
node cover: raster.cover@4 {
    triangles <- triangles;
    vertices <- vertices;
    keys <- empty.result;
}
node resolved: raster.resolve@2 {
    keys <- cover.result;
    triangles <- triangles;
    vertices <- vertices;
}

output surface <- resolved.result;
