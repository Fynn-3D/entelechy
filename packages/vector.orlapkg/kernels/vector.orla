// Drawing as Kernels: the shapes `orla import` writes from an SVG,
// filled pixel by pixel. The rule, at a pixel's centre:
//
// - The shapes are drawn in their order, each over what is beneath it.
// - A shape covers the centre by its winding number: a ray to the right
//   crosses its segments, one upward adding one and one downward taking
//   one away. Under the nonzero rule (0) a winding other than zero is
//   inside; under even-odd (1) an odd one.
// - Its edge is smoothed over a pixel: a centre half a pixel inside its
//   nearest segment is covered whole, half a pixel outside not at all.
// - Its paint is a colour (0), or a linear (1) or radial (2) gradient read
//   in the gradient's own space, its stops blended in order and spread by
//   padding (0), reflecting (1) or repeating (2).
//
// A drawing is looked at through a `Look`: the point of the drawing at
// the middle of the picture and how many times larger than fitting the
// drawing to the picture it is shown.
//
// `vector.draw@1` is the rule written plainly: every pixel asks every
// shape and every segment. The tiled form (`graphs/draw.osn`) asks the
// same questions of fewer: the canvas is cut into tiles of 16 pixels,
// each tile keeps the shapes whose boxes reach it, and each shape in a
// tile keeps the segments that reach the tile and, a row at a time, the
// winding of those wholly past it to the right. A segment that could
// change a pixel's winding or its smoothing is always among them, so the
// two forms draw the same words. Shapes and segments are walked in
// chunks, a chunk whose box misses passed over whole, and every loop
// over shapes or segments is two deep, so neither count is bounded by
// one loop's.

// Lists are runs of the `compact` package; an entry finds its owner by
// its `owner`.
use "../../compact.orlapkg";

// A shape as `orla import` writes it, `<stem>.shapes.field`.
struct Shape {
    color: Vec4;
    first: Int;
    count: Int;
    rule: Int;
    paint: Int;
    lo: Vec2;
    hi: Vec2;
    gradient: Vec4;
    inverse: Vec4;
    shift: Vec2;
    stops: Int;
    stop_count: Int;
    spread: Int;
}

// A gradient's stop, `<stem>.stops.field`: where it is, its colour.
struct Stop { offset: Float; color: Vec4; }

// Where the picture looks: the drawing's point at its middle, and the
// zoom over fitting the whole drawing.
struct Look { center: Vec2; zoom: Float; }

// The tiles a shape's box reaches, inclusive; none when `x1 < x0`.
struct Reach { x0: Int; y0: Int; x1: Int; y1: Int; }

// An index written into a list at a slot.
struct Slot { at: Int; value: Int; }

// ---- the rule

// The distance from `p` to the segment from `a` to `b`.
fn to_segment(p: Vec2, a: Vec2, b: Vec2) -> Float {
    let ab = b - a;
    let t = clamp(dot(p - a, ab) / max(dot(ab, ab), 0.0000001), 0.0, 1.0);
    return length(p - (a + ab * t));
}

// Where a gradient is at `t`, spread past its ends.
fn spread_by(t: Float, spread: Int) -> Float {
    if spread == 1 { return 1.0 - abs(fract(t * 0.5) * 2.0 - 1.0); }
    if spread == 2 { return fract(t); }
    return clamp(t, 0.0, 1.0);
}

// A gradient's colour at `t`: the stops about it blended.
fn stops_at(stops: Rows<Stop>, first: Int, n: Int, t: Float) -> Vec4 {
    let start = at(stops, first);
    let found = loop n with pick = vec4(start.color.x, start.color.y, start.color.z, start.color.w) {
        let s = at(stops, first + index());
        let before = at(stops, first + max(index() - 1, 0));
        let span = s.offset - before.offset;
        if t >= s.offset {
            s.color
        } else {
            if index() > 0 && t > before.offset {
                let k = if span > 0.0 { (t - before.offset) / span } else { 1.0 };
                break mix(before.color, s.color, k);
            }
            break pick;
        }
    };
    return found;
}

// A shape's paint at the drawing's point `p`.
fn paint_at(shape: Shape, stops: Rows<Stop>, p: Vec2) -> Vec4 {
    if shape.paint == 0 { return shape.color; }
    let m = shape.inverse;
    let q = vec2(m.x * p.x + m.z * p.y + shape.shift.x, m.y * p.x + m.w * p.y + shape.shift.y);
    let g = shape.gradient;
    let t = if shape.paint == 1 {
        let d = vec2(g.z - g.x, g.w - g.y);
        dot(q - vec2(g.x, g.y), d) / max(dot(d, d), 0.0000001)
    } else {
        length(q - vec2(g.x, g.y)) / max(g.z, 0.0000001)
    };
    let c = stops_at(stops, shape.stops, shape.stop_count, spread_by(t, shape.spread));
    return vec4(c.x, c.y, c.z, c.w * shape.color.w);
}

// One segment's part in a pixel: its crossing of the ray to the right
// and its distance, gathered into `w` (winding, nearest).
fn crossed(w: Vec2, seg: Vec4, p: Vec2) -> Vec2 {
    let a = vec2(seg.x, seg.y);
    let b = vec2(seg.z, seg.w);
    let crosses = (a.y <= p.y) != (b.y <= p.y);
    let x = a.x + (p.y - a.y) * (b.x - a.x) / (b.y - a.y);
    let turn = if crosses && x > p.x { if b.y > a.y { 1.0 } else { -1.0 } } else { 0.0 };
    return vec2(w.x + turn, min(w.y, to_segment(p, a, b)));
}

// Whether a shape's box, grown by a pixel, holds `p`.
fn near(s: Shape, p: Vec2, pixel: Float) -> Bool {
    return p.x >= s.lo.x - pixel && p.x <= s.hi.x + pixel && p.y >= s.lo.y - pixel && p.y <= s.hi.y + pixel;
}

// A shape laid over `below`, given its winding and nearest segment.
fn laid(below: Vec4, s: Shape, stops: Rows<Stop>, p: Vec2, pixel: Float, hit: Vec2) -> Vec4 {
    let winding = int(hit.x);
    let inside = if s.rule == 0 { winding != 0 } else { winding % 2 != 0 };
    let signed = if inside { hit.y } else { -hit.y };
    let cover = clamp(0.5 + signed / pixel, 0.0, 1.0);
    let c = paint_at(s, stops, p);
    let a = c.w * cover;
    return vec4(below.x * (1.0 - a) + c.x * a, below.y * (1.0 - a) + c.y * a, below.z * (1.0 - a) + c.z * a, below.w * (1.0 - a) + a);
}

/// Where the look puts each pixel's centre in the drawing, and a pixel's
/// size there: the x of each of `across`'s columns, then the y of each of
/// `down`'s rows, then the size; `domain = count(across) + count(down) +
/// 1`. Every Kernel that asks where a pixel is reads it here, so they
/// agree to the bit wherever each runs.
kernel vector.frame@1 {
    requires { field.read; field.write; }
    input across: Grid<Int>;
    input down: Grid<Int>;
    input view: Rows<Vec2>;
    input look: Rows<Look>;
    output result: Rows<Float>;
    compute {
        let res = vec2(size(across).x, size(down).y);
        let wide = int(res.x);
        let size = at(view, 0);
        let eye = at(look, 0);
        let pixel = 1.0 / (min(res.x / size.x, res.y / size.y) * eye.zoom);
        let i = element();
        if i < wide { return eye.center.x + (float(i) + 0.5 - res.x * 0.5) * pixel; }
        if i < wide + int(res.y) { return eye.center.y + (float(i - wide) + 0.5 - res.y * 0.5) * pixel; }
        return pixel;
    }
}

// A pixel's centre in the drawing and a pixel's size, from the frame of a
// canvas `wide` pixels across.
fn seen(frame: Rows<Float>, wide: Int, pixel_at: Vec2) -> Vec3 {
    let x = at(frame, int(pixel_at.x));
    let y = at(frame, wide + int(pixel_at.y));
    return vec3(x, y, at(frame, count(frame) - 1));
}

/// A look at the whole drawing: its middle, fitted to the picture.
kernel vector.whole@1 {
    requires { field.read; field.write; }
    input view: Rows<Vec2>;
    output result: Rows<Look>;
    compute { return Look { center: at(view, 0) * 0.5, zoom: 1.0 }; }
}

/// The drawing over `background`, through `frame`, at the node's domain:
/// every pixel asks every shape and segment.
kernel vector.draw@1 {
    requires { field.read; field.write; }
    input shapes: Rows<Shape>;
    input segments: Rows<Vec4>;
    input stops: Rows<Stop>;
    input frame: Rows<Float>;
    param background: Vec4 = vec4(1.0, 1.0, 1.0, 1.0);
    output result: Image;
    compute {
        let v = seen(frame, int(domain().x), coord());
        let p = vec2(v.x, v.y);
        let pixel = v.z;
        let n = count(shapes);
        return loop rounds(n) with over = background {
            let r = index();
            loop round_of(n, r) with below = over {
                let s = at(shapes, r * 65536 + index());
                if !near(s, p, pixel) { below } else {
                    let hit = loop rounds(s.count) with w = vec2(0.0, 1000000000.0) {
                        let q = index();
                        loop round_of(s.count, q) with w2 = w {
                            crossed(w2, at(segments, s.first + q * 65536 + index()), p)
                        }
                    };
                    laid(below, s, stops, p, pixel, hit)
                }
            }
        };
    }
}

// ---- the tiled form

// Pixels a tile is wide and high.
fn tile() -> Float { return 16.0; }
fn tile_columns(res: Vec2) -> Int { return int(ceil(res.x / tile())); }
fn tile_rows(res: Vec2) -> Int { return int(ceil(res.y / tile())); }

// Where the drawing's point `q` is on the canvas, in pixels.
fn on_canvas(q: Vec2, view: Rows<Vec2>, look: Rows<Look>, res: Vec2) -> Vec2 {
    let size = at(view, 0);
    let eye = at(look, 0);
    let fit = min(res.x / size.x, res.y / size.y) * eye.zoom;
    return (q - eye.center) * fit + res * 0.5;
}

/// Each shape's reach: the tiles its box, grown by two pixels, touches on
/// the canvas.
kernel vector.reach@1 {
    requires { field.read; field.write; }
    input shapes: Rows<Shape>;
    input view: Rows<Vec2>;
    input look: Rows<Look>;
    input canvas: Grid<Int>;
    output result: Rows<Reach>;
    compute {
        let s = sample(shapes);
        let res = size(canvas);
        let lo = on_canvas(s.lo, view, look, res) - vec2(2.0, 2.0);
        let hi = on_canvas(s.hi, view, look, res) + vec2(2.0, 2.0);
        let none = Reach { x0: 0, y0: 0, x1: -1, y1: -1 };
        if hi.x < 0.0 || hi.y < 0.0 || lo.x > res.x || lo.y > res.y { return none; }
        return Reach {
            x0: int(floor(max(lo.x, 0.0) / tile())),
            y0: int(floor(max(lo.y, 0.0) / tile())),
            x1: min(int(floor(min(hi.x, res.x) / tile())), tile_columns(res) - 1),
            y1: min(int(floor(min(hi.y, res.y) / tile())), tile_rows(res) - 1),
        };
    }
}

// Whether a reach holds a tile.
fn holds(r: Reach, tx: Int, ty: Int) -> Bool {
    return tx >= r.x0 && tx <= r.x1 && ty >= r.y0 && ty <= r.y1;
}

// Shapes and segments are asked in chunks of this many, in order: a
// chunk whose box misses a tile is passed over whole.
fn chunk() -> Int { return 256; }

/// What each chunk of shapes reaches together.
kernel vector.shape_chunks@1 {
    requires { field.read; field.write; }
    input reach: Rows<Reach>;
    output result: Rows<Reach>;
    compute {
        let n = count(reach);
        let first = element() * chunk();
        return loop chunk() with u = Reach { x0: 1073741824, y0: 1073741824, x1: -1, y1: -1 } {
            let s = first + index();
            let r = at(reach, s);
            if s >= n || r.x1 < r.x0 { u } else {
                Reach { x0: min(u.x0, r.x0), y0: min(u.y0, r.y0), x1: max(u.x1, r.x1), y1: max(u.y1, r.y1) }
            }
        };
    }
}

// Whether shape `s`, in a chunk that reaches the tile, is one to keep.
fn keeps(reach: Rows<Reach>, s: Int, tx: Int, ty: Int) -> Bool {
    return s < count(reach) && holds(at(reach, s), tx, ty);
}

/// How many shapes reach each tile.
kernel vector.tile_counts@1 {
    requires { field.read; field.write; }
    input reach: Rows<Reach>;
    input chunks: Rows<Reach>;
    input tiles: Grid<Int>;
    output result: Rows<Int>;
    compute {
        let columns = int(size(tiles).x);
        let tx = element() % columns;
        let ty = element() / columns;
        let n = count(chunks);
        return loop rounds(n) with total = 0 {
            let r = index();
            loop round_of(n, r) with k = total {
                let c = r * 65536 + index();
                if !holds(at(chunks, c), tx, ty) { k } else {
                    loop chunk() with k2 = k {
                        if keeps(reach, c * chunk() + index(), tx, ty) { k2 + 1 } else { k2 }
                    }
                }
            }
        };
    }
}

/// Each tile's shapes, in their order, into its part of the list: the
/// walk `vector.tile_counts@1` counts, stopped at its count.
kernel vector.tile_fill@1 {
    requires { field.read; field.write; }
    input reach: Rows<Reach>;
    input chunks: Rows<Reach>;
    input counts: Rows<Int>;
    input ends: Rows<Int>;
    input tiles: Grid<Int>;
    input slots: Rows<Int>;
    output result: Rows<Int>;
    scatter into slots with max {
        let columns = int(size(tiles).x);
        let t = element();
        let tx = t % columns;
        let ty = t / columns;
        let room = at(counts, t);
        let start = at(ends, t) - room;
        let n = count(chunks);
        loop rounds(n) with k = 0 {
            let r = index();
            loop round_of(n, r) with k1 = k {
                let c = r * 65536 + index();
                if !holds(at(chunks, c), tx, ty) { k1 } else {
                    loop chunk() with k2 = k1 {
                        let s = c * chunk() + index();
                        if k2 < room && keeps(reach, s, tx, ty) {
                            emit(Slot { at: start + k2, value: s });
                            k2 + 1
                        } else { k2 }
                    }
                }
            }
        };
        return Slot { at: -1, value: 0 };
    }
}

// ---- cells

// A cell is a shape in a tile: an entry of the tiles' shape lists. Its
// shape's segments are walked a chunk to a unit, so no walk is longer
// than a chunk. Of a unit's segments, those that reach the tile, a pixel
// over its edges, are the cell's own and asked by each pixel; those that
// reach its rows wholly to its right cross each row's rays to the right,
// so their turns are summed once a row as the cell's backdrop; the rest
// neither cross a ray from the tile nor come within a pixel of it. The
// winding is a sum of whole turns and the nearest segment a least, so the
// order a cell's segments are asked in changes no word.

// Whether a span of the canvas reaches a tile's rows, or its columns, a
// pixel over their edges, and whether one lies wholly past its columns.
fn in_rows(lo: Float, hi: Float, ty: Int) -> Bool {
    return hi >= float(ty) * tile() - 1.0 && lo <= float(ty + 1) * tile() + 1.0;
}
fn in_columns(lo: Float, hi: Float, tx: Int) -> Bool {
    return hi >= float(tx) * tile() - 1.0 && lo <= float(tx + 1) * tile() + 1.0;
}
fn past(lo: Float, tx: Int) -> Bool { return lo > float(tx + 1) * tile() + 1.0; }

// Whether a segment on the canvas is a cell's own.
fn own(on: Vec4, tx: Int, ty: Int) -> Bool {
    return in_rows(min(on.y, on.w), max(on.y, on.w), ty) && in_columns(min(on.x, on.z), max(on.x, on.z), tx);
}

/// Each segment on the canvas, as its shape's box is.
kernel vector.placed@1 {
    requires { field.read; field.write; }
    input segments: Rows<Vec4>;
    input view: Rows<Vec2>;
    input look: Rows<Look>;
    input canvas: Grid<Int>;
    output result: Rows<Vec4>;
    compute {
        let s = sample(segments);
        let res = size(canvas);
        let a = on_canvas(vec2(s.x, s.y), view, look, res);
        let b = on_canvas(vec2(s.z, s.w), view, look, res);
        return vec4(a.x, a.y, b.x, b.y);
    }
}

/// The box each chunk of segments spans on the canvas: least x and y,
/// most x and y.
kernel vector.segment_chunks@1 {
    requires { field.read; field.write; }
    input placed: Rows<Vec4>;
    output result: Rows<Vec4>;
    compute {
        let n = count(placed);
        let first = element() * chunk();
        return loop chunk() with u = vec4(1000000000.0, 1000000000.0, -1000000000.0, -1000000000.0) {
            let g = first + index();
            let s = at(placed, g);
            if g >= n { u } else {
                vec4(min(u.x, min(s.x, s.z)), min(u.y, min(s.y, s.w)), max(u.z, max(s.x, s.z)), max(u.w, max(s.y, s.w)))
            }
        };
    }
}

// The chunks of segments a shape's lie in: the first, and how many.
fn chunks_of(s: Shape) -> IVec2 {
    let c0 = s.first / chunk();
    return ivec2(c0, if s.count > 0 { (s.first + s.count - 1) / chunk() - c0 + 1 } else { 0 });
}

// The shape's segments in chunk `c`: the first, and how many.
fn part_of(s: Shape, c: Int) -> IVec2 {
    let lo = max(s.first, c * chunk());
    return ivec2(lo, min(s.first + s.count, (c + 1) * chunk()) - lo);
}

/// How many units each cell is: its shape's chunks.
kernel vector.units@1 {
    requires { field.read; field.write; }
    input total: Rows<Int>;
    input tile_shapes: Rows<Int>;
    input shapes: Rows<Shape>;
    output result: Rows<Int>;
    compute {
        let si = at(tile_shapes, element());
        return if si < 0 { 0 } else { chunks_of(at(shapes, si)).y };
    }
}

// What a unit is: its cell, its tile, and the shape's segments it walks.
struct Unit { cell: Int; tx: Int; ty: Int; chunk: Int; first: Int; count: Int; }

fn unit_of(u: Int, units: Rows<Int>, unit_ends: Rows<Int>, tile_ends: Rows<Int>, tile_shapes: Rows<Int>, tiles: Grid<Int>, shapes: Rows<Shape>) -> Unit {
    let e = owner(u, unit_ends);
    let t = owner(e, tile_ends);
    let columns = int(size(tiles).x);
    let s = at(shapes, max(at(tile_shapes, e), 0));
    let c = chunks_of(s).x + u - (at(unit_ends, e) - at(units, e));
    let part = part_of(s, c);
    return Unit { cell: e, tx: t % columns, ty: t / columns, chunk: c, first: part.x, count: part.y };
}

/// How many of its segments each unit gives its cell.
kernel vector.kept@1 {
    requires { field.read; field.write; }
    input total: Rows<Int>;
    input units: Rows<Int>;
    input unit_ends: Rows<Int>;
    input tile_ends: Rows<Int>;
    input tile_shapes: Rows<Int>;
    input tiles: Grid<Int>;
    input shapes: Rows<Shape>;
    input placed: Rows<Vec4>;
    input chunks: Rows<Vec4>;
    output result: Rows<Int>;
    compute {
        let w = unit_of(element(), units, unit_ends, tile_ends, tile_shapes, tiles, shapes);
        let box = at(chunks, w.chunk);
        if !in_rows(box.y, box.w, w.ty) || !in_columns(box.x, box.z, w.tx) { return 0; }
        return loop w.count with k = 0 {
            if own(at(placed, w.first + index()), w.tx, w.ty) { k + 1 } else { k }
        };
    }
}

/// Each unit's segments, in their order, into its part of the cells'
/// list: the walk `vector.kept@1` counts.
kernel vector.keep@1 {
    requires { field.read; field.write; }
    input total: Rows<Int>;
    input kept: Rows<Int>;
    input kept_ends: Rows<Int>;
    input units: Rows<Int>;
    input unit_ends: Rows<Int>;
    input tile_ends: Rows<Int>;
    input tile_shapes: Rows<Int>;
    input tiles: Grid<Int>;
    input shapes: Rows<Shape>;
    input placed: Rows<Vec4>;
    input chunks: Rows<Vec4>;
    input slots: Rows<Int>;
    output result: Rows<Int>;
    scatter into slots with max {
        let u = element();
        let room = at(kept, u);
        let start = at(kept_ends, u) - room;
        let w = unit_of(u, units, unit_ends, tile_ends, tile_shapes, tiles, shapes);
        if room > 0 {
            loop w.count with k = 0 {
                let g = w.first + index();
                if k < room && own(at(placed, g), w.tx, w.ty) {
                    emit(Slot { at: start + k, value: g });
                    k + 1
                } else { k }
            };
        }
        return Slot { at: -1, value: 0 };
    }
}

/// A list of zeros, a row of each cell's tile to each.
kernel vector.zeros@1 {
    requires { field.read; field.write; }
    input total: Rows<Int>;
    output result: Rows<Int>;
    compute { return 0; }
}

/// Each cell's backdrop, a row of its tile to an element. Each of a
/// unit's segments wholly past the tile adds its turn to the rows it may
/// cross, a pixel over its ends, each crossing tested at the row's point
/// in the drawing, read from the frame the drawing reads, as `crossed`
/// tests it.
kernel vector.backdrop@1 {
    requires { field.read; field.write; }
    input total: Rows<Int>;
    input units: Rows<Int>;
    input unit_ends: Rows<Int>;
    input tile_ends: Rows<Int>;
    input tile_shapes: Rows<Int>;
    input tiles: Grid<Int>;
    input shapes: Rows<Shape>;
    input placed: Rows<Vec4>;
    input chunks: Rows<Vec4>;
    input segments: Rows<Vec4>;
    input frame: Rows<Float>;
    input canvas: Grid<Int>;
    input zeros: Rows<Int>;
    output result: Rows<Int>;
    scatter into zeros with sum {
        let w = unit_of(element(), units, unit_ends, tile_ends, tile_shapes, tiles, shapes);
        let box = at(chunks, w.chunk);
        let rows = int(tile());
        let top = w.ty * rows;
        if in_rows(box.y, box.w, w.ty) && box.z > float(w.tx + 1) * tile() + 1.0 {
            loop w.count with k = 0 {
                let g = w.first + index();
                let on = at(placed, g);
                if past(min(on.x, on.z), w.tx) {
                    let seg = at(segments, g);
                    let turn = if seg.w > seg.y { 1 } else { -1 };
                    let low = clamp(int(floor(min(on.y, on.w))) - 1 - top, 0, rows);
                    let high = clamp(int(ceil(max(on.y, on.w))) + 1 - top, 0, rows);
                    loop high - low with k2 = 0 {
                        let row = low + index();
                        let y = at(frame, int(size(canvas).x) + top + row);
                        if (seg.y <= y) != (seg.w <= y) { emit(Slot { at: w.cell * rows + row, value: turn }); }
                        k2
                    };
                }
                k
            };
        }
        return Slot { at: -1, value: 0 };
    }
}

/// The drawing, each pixel asking only its tile's shapes and, of each,
/// the cell's own segments over its row's backdrop: the same words
/// `vector.draw@1` draws.
kernel vector.draw_tiled@1 {
    requires { field.read; field.write; }
    input shapes: Rows<Shape>;
    input segments: Rows<Vec4>;
    input stops: Rows<Stop>;
    input frame: Rows<Float>;
    input tile_counts: Rows<Int>;
    input tile_ends: Rows<Int>;
    input tile_shapes: Rows<Int>;
    input units: Rows<Int>;
    input unit_ends: Rows<Int>;
    input kept: Rows<Int>;
    input kept_ends: Rows<Int>;
    input cell_segments: Rows<Int>;
    input backdrop: Rows<Int>;
    param background: Vec4 = vec4(1.0, 1.0, 1.0, 1.0);
    output result: Image;
    compute {
        let res = domain();
        let v = seen(frame, int(res.x), coord());
        let p = vec2(v.x, v.y);
        let pixel = v.z;
        let rows = int(tile());
        let tx = int(coord().x / tile());
        let ty = int(coord().y / tile());
        let row = int(coord().y) - ty * rows;
        let t = ty * tile_columns(res) + tx;
        let n = at(tile_counts, t);
        let first = at(tile_ends, t) - n;
        return loop rounds(n) with over = background {
            let r = index();
            loop round_of(n, r) with below = over {
                let e = first + r * 65536 + index();
                let si = at(tile_shapes, e);
                let s = at(shapes, max(si, 0));
                if si < 0 || !near(s, p, pixel) { below } else {
                    // The cell's segments: from its first unit's to its last's.
                    let last = at(unit_ends, e) - 1;
                    let u0 = last + 1 - at(units, e);
                    let begin = at(kept_ends, u0) - at(kept, u0);
                    let m = if last >= u0 { at(kept_ends, last) - begin } else { 0 };
                    let hit = loop rounds(m) with w = vec2(float(at(backdrop, e * rows + row)), 1000000000.0) {
                        let q = index();
                        loop round_of(m, q) with w2 = w {
                            let g = at(cell_segments, begin + q * 65536 + index());
                            if g < 0 { w2 } else { crossed(w2, at(segments, g), p) }
                        }
                    };
                    laid(below, s, stops, p, pixel, hit)
                }
            }
        };
    }
}
