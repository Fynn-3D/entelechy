// The tiled form: the canvas cut into tiles of 16 pixels, each keeping
// the shapes whose boxes reach it and, a row at a time, the segments
// that reach it and the winding of those wholly past it.
use "parallel.entpkg";
use "fill.ent";
use "shape.ent";

// Pixels a tile is wide and high.
fn tile() -> Float { return 16.0; }

fn tile_columns(res: Vec2) -> Int { return int(ceil(res.x / tile())); }

fn tile_rows(res: Vec2) -> Int { return int(ceil(res.y / tile())); }

// Where the drawing's point `q` is on the canvas, in pixels.
fn on_canvas(q: Vec2, view: Rows<Vec2>, look: Rows<Look>, res: Vec2) -> Vec2 {
    let eye = at(look, 0);
    return (q - eye.center) * fitted(at(view, 0), eye, res) + res * 0.5;
}

/// Each shape's reach: the tiles its box, grown by two pixels, touches on
/// the canvas.
kernel vector.reach@1 {
    requires { field.read; field.write; }
    input shapes: Rows<Shape>;
    input view: Rows<Vec2>;
    input look: Rows<Look>;
    input canvas: Grid<Int>;
    output result: Rows<Reach>;
    compute {
        let s = sample(shapes);
        let res = size(canvas);
        let lo = on_canvas(s.lo, view, look, res) - 2.0;
        let hi = on_canvas(s.hi, view, look, res) + 2.0;
        let none = Reach { x0: 0, y0: 0, x1: -1, y1: -1 };
        if hi.x < 0.0 || hi.y < 0.0 || lo.x > res.x || lo.y > res.y { return none; }
        let first = int(floor(max(lo, 0.0) / tile()));
        let last = min(int(floor(min(hi, res) / tile())), ivec2(tile_columns(res), tile_rows(res)) - 1);
        return Reach { x0: first.x, y0: first.y, x1: last.x, y1: last.y };
    }
}

// Whether a reach holds a tile.
fn reach_holds(r: Reach, tx: Int, ty: Int) -> Bool {
    return tx >= r.x0 && tx <= r.x1 && ty >= r.y0 && ty <= r.y1;
}

// Shapes and segments are asked in chunks of this many, in order: a
// chunk whose box misses a tile is passed over whole.
fn chunk() -> Int { return 256; }

/// What each chunk of shapes reaches together.
kernel vector.shape_chunks@1 {
    requires { field.read; field.write; }
    input reach: Rows<Reach>;
    output result: Rows<Reach>;
    compute {
        let n = count(reach);
        let first = element() * chunk();
        return loop chunk() with u = Reach { x0: 1073741824, y0: 1073741824, x1: -1, y1: -1 } {
            let s = first + index();
            let r = at(reach, s);
            if s >= n || r.x1 < r.x0 { u } else {
                Reach { x0: min(u.x0, r.x0), y0: min(u.y0, r.y0), x1: max(u.x1, r.x1), y1: max(u.y1, r.y1) }
            }
        };
    }
}

// Whether shape `s`, in a chunk that reaches the tile, is one to keep.
fn keeps(reach: Rows<Reach>, s: Int, tx: Int, ty: Int) -> Bool {
    return s < count(reach) && reach_holds(at(reach, s), tx, ty);
}

/// How many shapes reach each tile.
kernel vector.tile_counts@1 {
    requires { field.read; field.write; }
    input reach: Rows<Reach>;
    input chunks: Rows<Reach>;
    input tiles: Grid<Int>;
    output result: Rows<Int>;
    compute {
        let columns = int(size(tiles).x);
        let tx = element() % columns;
        let ty = element() / columns;
        let n = count(chunks);
        return loop rounds(n) with total = 0 {
            let r = index();
            loop round_of(n, r) with k = total {
                let c = r * 65536 + index();
                if !reach_holds(at(chunks, c), tx, ty) { k } else {
                    loop chunk() with k2 = k {
                        if keeps(reach, c * chunk() + index(), tx, ty) { k2 + 1 } else { k2 }
                    }
                }
            }
        };
    }
}

/// Each tile's shapes, in their order, into its part of the list: the
/// walk `vector.tile_counts@1` counts, stopped at its count.
kernel vector.tile_fill@1 {
    requires { field.read; field.write; }
    input reach: Rows<Reach>;
    input chunks: Rows<Reach>;
    input counts: Rows<Int>;
    input ends: Rows<Int>;
    input tiles: Grid<Int>;
    input slots: Rows<Int>;
    output result: Rows<Int>;
    scatter over reach into slots with max {
        let columns = int(size(tiles).x);
        let t = element();
        let tx = t % columns;
        let ty = t / columns;
        let room = at(counts, t);
        let start = at(ends, t) - room;
        let n = count(chunks);
        loop rounds(n) with k = 0 {
            let r = index();
            loop round_of(n, r) with k1 = k {
                let c = r * 65536 + index();
                if !reach_holds(at(chunks, c), tx, ty) { k1 } else {
                    loop chunk() with k2 = k1 {
                        let s = c * chunk() + index();
                        if k2 < room && keeps(reach, s, tx, ty) {
                            emit(Slot { at: start + k2, value: s });
                            k2 + 1
                        } else { k2 }
                    }
                }
            }
        };
        return Slot { at: -1, value: 0 };
    }
}

// Whether a span of the canvas reaches a tile's rows, or its columns, a
// pixel over their edges, and whether one lies wholly past its columns.
fn in_rows(lo: Float, hi: Float, ty: Int) -> Bool {
    return hi >= float(ty) * tile() - 1.0 && lo <= float(ty + 1) * tile() + 1.0;
}

fn in_columns(lo: Float, hi: Float, tx: Int) -> Bool {
    return hi >= float(tx) * tile() - 1.0 && lo <= float(tx + 1) * tile() + 1.0;
}

fn past(lo: Float, tx: Int) -> Bool { return lo > float(tx + 1) * tile() + 1.0; }

// Whether a segment on the canvas is a cell's own.
fn own(on: Vec4, tx: Int, ty: Int) -> Bool {
    return in_rows(min(on.y, on.w), max(on.y, on.w), ty) && in_columns(min(on.x, on.z), max(on.x, on.z), tx);
}

/// Each segment on the canvas, as its shape's box is.
kernel vector.placed@1 {
    requires { field.read; field.write; }
    input segments: Rows<Vec4>;
    input view: Rows<Vec2>;
    input look: Rows<Look>;
    input canvas: Grid<Int>;
    output result: Rows<Vec4>;
    compute {
        let s = sample(segments);
        let res = size(canvas);
        let a = on_canvas(s.xy, view, look, res);
        let b = on_canvas(s.zw, view, look, res);
        return vec4(a, b);
    }
}

/// The box each chunk of segments spans on the canvas: least x and y,
/// most x and y.
kernel vector.segment_chunks@1 {
    requires { field.read; field.write; }
    input placed: Rows<Vec4>;
    output result: Rows<Vec4>;
    compute {
        let n = count(placed);
        let first = element() * chunk();
        return loop chunk() with u = vec4(1000000000.0, 1000000000.0, -1000000000.0, -1000000000.0) {
            let g = first + index();
            let s = at(placed, g);
            if g >= n { u } else {
                vec4(min(u.xy, min(s.xy, s.zw)), max(u.zw, max(s.xy, s.zw)))
            }
        };
    }
}

// The chunks of segments a shape's lie in: the first, and how many.
fn chunks_of(s: Shape) -> IVec2 {
    let c0 = s.first / chunk();
    return ivec2(c0, if s.count > 0 { (s.first + s.count - 1) / chunk() - c0 + 1 } else { 0 });
}

// The shape's segments in chunk `c`: the first, and how many.
fn part_of(s: Shape, c: Int) -> IVec2 {
    let lo = max(s.first, c * chunk());
    return ivec2(lo, min(s.first + s.count, (c + 1) * chunk()) - lo);
}

/// How many units each cell is: its shape's chunks.
kernel vector.units@1 {
    requires { field.read; field.write; }
    input total: Rows<Int>;
    input tile_shapes: Rows<Int>;
    input shapes: Rows<Shape>;
    output result: Rows<Int>;
    compute {
        let si = at(tile_shapes, element());
        return if si < 0 { 0 } else { chunks_of(at(shapes, si)).y };
    }
}

// What a unit is: its cell, its tile, and the shape's segments it walks.
struct Unit { cell: Int; tx: Int; ty: Int; chunk: Int; first: Int; count: Int; }

fn work_unit_of(u: Int, units: Rows<Int>, unit_ends: Rows<Int>, tile_ends: Rows<Int>, tile_shapes: Rows<Int>, tiles: Grid<Int>, shapes: Rows<Shape>) -> Unit {
    let e = owner(u, unit_ends);
    let t = owner(e, tile_ends);
    let columns = int(size(tiles).x);
    let s = at(shapes, max(at(tile_shapes, e), 0));
    let c = chunks_of(s).x + u - (at(unit_ends, e) - at(units, e));
    let part = part_of(s, c);
    return Unit { cell: e, tx: t % columns, ty: t / columns, chunk: c, first: part.x, count: part.y };
}

/// How many of its segments each unit gives its cell.
kernel vector.kept@1 {
    requires { field.read; field.write; }
    input total: Rows<Int>;
    input units: Rows<Int>;
    input unit_ends: Rows<Int>;
    input tile_ends: Rows<Int>;
    input tile_shapes: Rows<Int>;
    input tiles: Grid<Int>;
    input shapes: Rows<Shape>;
    input placed: Rows<Vec4>;
    input chunks: Rows<Vec4>;
    output result: Rows<Int>;
    compute {
        let w = work_unit_of(element(), units, unit_ends, tile_ends, tile_shapes, tiles, shapes);
        let box = at(chunks, w.chunk);
        if !in_rows(box.y, box.w, w.ty) || !in_columns(box.x, box.z, w.tx) { return 0; }
        return loop w.count with k = 0 {
            if own(at(placed, w.first + index()), w.tx, w.ty) { k + 1 } else { k }
        };
    }
}

/// Each unit's segments, in their order, into its part of the cells'
/// list: the walk `vector.kept@1` counts.
kernel vector.keep@1 {
    requires { field.read; field.write; }
    input total: Rows<Int>;
    input kept: Rows<Int>;
    input kept_ends: Rows<Int>;
    input units: Rows<Int>;
    input unit_ends: Rows<Int>;
    input tile_ends: Rows<Int>;
    input tile_shapes: Rows<Int>;
    input tiles: Grid<Int>;
    input shapes: Rows<Shape>;
    input placed: Rows<Vec4>;
    input chunks: Rows<Vec4>;
    input slots: Rows<Int>;
    output result: Rows<Int>;
    scatter over total into slots with max {
        let u = element();
        let room = at(kept, u);
        let start = at(kept_ends, u) - room;
        let w = work_unit_of(u, units, unit_ends, tile_ends, tile_shapes, tiles, shapes);
        if room > 0 {
            loop w.count with k = 0 {
                let g = w.first + index();
                if k < room && own(at(placed, g), w.tx, w.ty) {
                    emit(Slot { at: start + k, value: g });
                    k + 1
                } else { k }
            };
        }
        return Slot { at: -1, value: 0 };
    }
}

/// A list of zeros, a row of each cell's tile to each.
kernel vector.zeros@1 {
    requires { field.read; field.write; }
    input total: Rows<Int>;
    output result: Rows<Int>;
    compute { return 0; }
}

/// Each cell's backdrop, a row of its tile to an element. Each of a
/// unit's segments wholly past the tile adds its turn to the rows it may
/// cross, a pixel over its ends, each crossing tested at the row's point
/// in the drawing, read from the frame the drawing reads, as `crossed`
/// tests it.
kernel vector.backdrop@1 {
    requires { field.read; field.write; }
    input total: Rows<Int>;
    input units: Rows<Int>;
    input unit_ends: Rows<Int>;
    input tile_ends: Rows<Int>;
    input tile_shapes: Rows<Int>;
    input tiles: Grid<Int>;
    input shapes: Rows<Shape>;
    input placed: Rows<Vec4>;
    input chunks: Rows<Vec4>;
    input segments: Rows<Vec4>;
    input frame: Rows<Float>;
    input canvas: Grid<Int>;
    input zeros: Rows<Int>;
    output result: Rows<Int>;
    scatter over total into zeros with sum {
        let w = work_unit_of(element(), units, unit_ends, tile_ends, tile_shapes, tiles, shapes);
        let box = at(chunks, w.chunk);
        let rows = int(tile());
        let top = w.ty * rows;
        if in_rows(box.y, box.w, w.ty) && box.z > float(w.tx + 1) * tile() + 1.0 {
            loop w.count with k = 0 {
                let g = w.first + index();
                let on = at(placed, g);
                if past(min(on.x, on.z), w.tx) {
                    let seg = at(segments, g);
                    let turn = if seg.w > seg.y { 1 } else { -1 };
                    // The rows it crosses, taken in the tile's before they are
                    // whole numbers, so a segment far off the canvas is none.
                    let low = int(clamp(floor(min(on.y, on.w)) - 1.0 - float(top), 0.0, float(rows)));
                    let high = int(clamp(ceil(max(on.y, on.w)) + 1.0 - float(top), 0.0, float(rows)));
                    loop high - low with k2 = 0 {
                        let row = low + index();
                        let y = at(frame, int(size(canvas).x) + top + row);
                        if (seg.y <= y) != (seg.w <= y) { emit(Slot { at: w.cell * rows + row, value: turn }); }
                        k2
                    };
                }
                k
            };
        }
        return Slot { at: -1, value: 0 };
    }
}

/// The drawing, each pixel asking only its tile's shapes and, of each,
/// the cell's own segments over its row's backdrop: the same words
/// `vector.draw@1` draws.
kernel vector.draw_tiled@1 {
    requires { field.read; field.write; }
    input shapes: Rows<Shape>;
    input segments: Rows<Vec4>;
    input stops: Rows<Stop>;
    input frame: Rows<Float>;
    input tile_counts: Rows<Int>;
    input tile_ends: Rows<Int>;
    input tile_shapes: Rows<Int>;
    input units: Rows<Int>;
    input unit_ends: Rows<Int>;
    input kept: Rows<Int>;
    input kept_ends: Rows<Int>;
    input cell_segments: Rows<Int>;
    input backdrop: Rows<Int>;
    param background: Vec4 = vec4(1.0, 1.0, 1.0, 1.0);
    output result: Image;
    compute {
        let res = domain();
        let v = seen(frame, int(res.x), coord());
        let p = v.xy;
        let pixel = v.z;
        let rows = int(tile());
        let cell = icoord();
        let tx = cell.x / rows;
        let ty = cell.y / rows;
        let row = cell.y % rows;
        let t = ty * tile_columns(res) + tx;
        let n = at(tile_counts, t);
        let first = at(tile_ends, t) - n;
        return loop rounds(n) with over = background {
            let r = index();
            loop round_of(n, r) with below = over {
                let e = first + r * 65536 + index();
                let si = at(tile_shapes, e);
                let s = at(shapes, max(si, 0));
                if si < 0 || !near(s, p, pixel) { below } else {
                    // The cell's segments: from its first unit's to its last's.
                    let last = at(unit_ends, e) - 1;
                    let u0 = last + 1 - at(units, e);
                    let begin = at(kept_ends, u0) - at(kept, u0);
                    let m = if last >= u0 { at(kept_ends, last) - begin } else { 0 };
                    let hit = loop rounds(m) with w = vec2(float(at(backdrop, e * rows + row)), 1000000000.0) {
                        let q = index();
                        loop round_of(m, q) with w2 = w {
                            let g = at(cell_segments, begin + q * 65536 + index());
                            if g < 0 { w2 } else { crossed(w2, at(segments, g), p) }
                        }
                    };
                    laid(below, s, stops, p, pixel, hit)
                }
            }
        };
    }
}
