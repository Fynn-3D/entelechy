//! The vfx package's casts heard: a block of stereo samples a project
//! adds to its sound. A project reads the timbres and the vfx tables and
//! hands in its casts, its eye and its sound's clock:
//!
//!   input sfx_timbres: Timbres = "sound.entpkg/data/timbres.csv";
//!   node sfx: graph "sound.entpkg/graphs/cast.esn" { casts <- casts.result; effects <- vfx_effects;
//!       layers <- vfx_layers; timbres <- sfx_timbres; eye <- eye.result; clock <- audio_clock.result;
//!       block <- block.result; }
//!
//! `sound` is the block, `value(block, 0)` samples long.
use "../kernels/";

input casts: Casts;
input effects: Effects;
input layers: Layers;
input timbres: Timbres;
input eye: Eyes;
input clock: Clocks;
input block: Rows<Float>;
param volume: Float = 1.1;

node voices: sound.voices@1 { casts <- casts; effects <- effects; layers <- layers; domain = count(casts) * 8; }
node sound: sound.sound@1 { voices <- voices.result; timbres <- timbres; eye <- eye; clock <- clock; block <- block; volume = volume; domain = value(block, 0); }

output sound <- sound.result;
