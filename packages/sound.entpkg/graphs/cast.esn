//! The effects package's casts heard: a block of stereo samples a
//! program adds to its sound. A program hands in its own timbres and
//! effect tables, its casts, the lens they are heard from (`geometry`'s
//! `Lens`) and its sound's clock:
//!
//!   input timbres: Timbres = "data/timbres.csv";
//!   node sfx: graph "sound.entpkg/graphs/cast.esn" { casts <- casts.result; effects <- effects;
//!       layers <- layers; timbres <- timbres; eye <- lens.result; clock <- audio_clock.result;
//!       block <- block.result; }
//!
//! `sound` is the block, `value(block, 0)` samples long.
use "../kernels/";
use "geometry.entpkg";

input casts: Casts;
input effects: Effects;
input layers: Layers;
input timbres: Timbres;
input eye: Lenses;
input clock: Clocks;
input block: Rows<Float>;
param volume: Float = 1.1;

node voices: sound.voices@1 { casts <- casts; effects <- effects; layers <- layers; domain = count(casts) * 8; }
node sound: sound.sound@2 { voices <- voices.result; timbres <- timbres; eye <- eye; clock <- clock; block <- block; volume = volume; domain = value(block, 0); }

output sound <- sound.result;
