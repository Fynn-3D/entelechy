// The sounds a voice makes, `s` seconds into it, `len` long, at sample
// `n`, in its element's voice: each made of tones and noise as the synth
// package makes them, the noise brighter as the element is, the low
// heavier as it weighs, rung as it rings, crackling, howling, splashing,
// droning as it does.
use "random.entpkg";
use "audio.entpkg";
use "voice.ent";

/// In over `a` seconds, out over the last `r` of `len`.
fn held(s: Float, len: Float, a: Float, r: Float) -> Float {
    return smoothstep(0.0, max(a, 0.001), s) * (1.0 - smoothstep(len - max(r, 0.001), len, s));
}

/// Grains: `k` small sounds at random moments over `span` seconds, each
/// `t` seconds into its own: the moment of grain `i`.
fn grain_at(i: Int, seed: Int, span: Float) -> Float { return hash1(i, seed + 29) * span; }

/// The crackle of an element: clicks scattered as it crackles.
fn crackles(s: Float, n: Long, tb: Timbre, seed: Int, rate: Float) -> Float {
    let k = 10;
    let span = 0.25;
    let window = s - floor(s / span) * span;
    let block = int(floor(s / span));
    let sum = loop k with acc = 0.0 {
        let i = index();
        let at_ = grain_at(i, seed + block * 37, span);
        let dt = window - at_;
        if hash1(i, seed + block * 41) > rate || dt < 0.0 || dt > 0.03 { acc } else {
            acc + white(n, seed + i) * exp(0.0 - dt * 300.0) + soft_noise(dt * 9000.0, seed + i) * exp(0.0 - dt * 120.0) * 0.5
        }
    };
    return sum;
}

/// A missile's flight: noise rising as it nears, a hum in it.
fn whoosh(s: Float, len: Float, n: Long, tb: Timbre, seed: Int) -> Float {
    let p = clamp(s / max(len, 0.01), 0.0, 1.0);
    let rate = 500.0 + 5000.0 * tb.bright * (0.4 + p);
    let level = held(s, len, 0.05, 0.15) * (0.35 + 0.65 * p);
    let wobble = 1.0 + tb.swirl * 0.5 * sin(s * 23.0);
    let air = soft_noise(s * rate, seed) * (1.0 - tb.ring * 0.4);
    let hum = tone(tb.pitch * (1.6 - 0.4 * p), s) * tb.ring * 0.3 + tone(tb.pitch * 0.5, s) * tb.drone * 0.25;
    return (air * wobble + hum + crackles(s, n, tb, seed, tb.crackle) * 0.5) * level * 0.55;
}

/// A burst: a thud as heavy as the element, a blast of its noise, a tail
/// rolling after; rung, splashed, droning as the element is.
fn boom(s: Float, size: Float, n: Long, tb: Timbre, seed: Int) -> Float {
    if s < 0.0 { return 0.0; }
    let sz = clamp(size * 0.5, 0.3, 2.2);
    let low = thud(s, 32.0 + 40.0 * (1.0 - tb.body)) * (0.55 + 0.6 * tb.body) * sqrt(sz);
    let blast = soft_noise(s * (2500.0 + 7000.0 * tb.bright), seed) * exp(0.0 - s * (20.0 - 9.0 * tb.body));
    let tail = soft_noise(s * (80.0 + 300.0 * tb.bright), seed + 1) * exp(0.0 - s / (0.3 + 0.2 * sz + 0.4 * tb.body)) * 0.9;
    let ring = bell(tb.pitch * 2.0, s) * tb.ring * 0.45;
    let splash = soft_noise(s * 7500.0, seed + 2) * exp(0.0 - s * 6.0) * tb.wet * 0.6;
    let drone = tone(tb.pitch * 0.25, s) * exp(0.0 - s * 1.5) * tb.drone * 0.5;
    let crack = crackles(s, n, tb, seed, tb.crackle) * exp(0.0 - s * 2.0) * 0.6;
    return (low + blast * (0.6 + tb.grit * 0.4) + tail + ring + splash + drone + crack) * 0.55;
}

/// A body held: a band of the element's noise swelling in and out, its
/// low under it, a howl as it turns, a drone as it is dark.
fn roar(s: Float, len: Float, n: Long, tb: Timbre, seed: Int) -> Float {
    let level = held(s, len, 0.15, min(0.4, len * 0.4));
    let band = soft_noise(s * (250.0 + 2600.0 * tb.bright), seed) * 0.7 + soft_noise(s * (70.0 + 250.0 * tb.bright), seed + 3) * (0.25 + 0.6 * tb.body);
    let howl = tone(tb.pitch * (0.5 + 0.12 * sin(s * 2.7 + float(seed % 7))), s) * tb.swirl * 0.25;
    let drone = (tone(tb.pitch * 0.25, s) + tone(tb.pitch * 0.375, s) * 0.5) * tb.drone * 0.3;
    let shimmer = tone(tb.pitch * 3.0 * (1.0 + 0.01 * sin(s * 40.0)), s) * tb.ring * 0.08;
    return (band * (1.0 + tb.grit * soft_noise(s * 60.0, seed + 5) * 0.6) + howl + drone + shimmer + crackles(s, n, tb, seed, tb.crackle) * 0.6) * level * 0.45;
}

/// A circle written, a shell raised, a sign: bells of the element's pitch
/// (a minor chord as it drones), a glitter over them.
fn chime(s: Float, len: Float, tb: Timbre, seed: Int) -> Float {
    let minor = tb.drone > 0.5;
    let f = tb.pitch * 2.0;
    let a = bell(f, s) + bell(f * (if minor { 1.189 } else { 1.26 }), s - 0.09) * 0.8 + bell(f * 1.5, s - 0.18) * 0.65;
    let glitter = soft_noise(s * 9000.0, seed) * 0.05 * held(s, len, 0.1, 0.3);
    return (a * (0.4 + 0.6 * tb.ring) * 0.35 + glitter) * (1.0 - smoothstep(len, len + 0.6, s));
}

/// Motes: tinkles scattered over their life, bubbles as the element is
/// wet.
fn sparkle(s: Float, len: Float, count: Int, tb: Timbre, seed: Int) -> Float {
    let k = clamp(count / 2, 2, 12);
    return loop k with acc = 0.0 {
        let i = index();
        let dt = s - grain_at(i, seed, len);
        if dt < 0.0 || dt > 0.3 { acc } else {
            let f = tb.pitch * (4.0 + 4.0 * hash1(i, seed + 3));
            acc + tone(f, dt) * exp(0.0 - dt * 22.0) * (0.25 + 0.75 * tb.ring) * 0.12
                + tone(tb.pitch * (2.0 + hash1(i, seed + 5)) * (1.0 + dt * 10.0), dt) * exp(0.0 - dt * 30.0) * tb.wet * 0.15
        }
    };
}

/// Sparks: as many small sounds as there are sparks, early in their life:
/// clicks, zaps as the element crackles, small stones as it weighs.
fn sputter(s: Float, len: Float, count: Int, n: Long, tb: Timbre, seed: Int) -> Float {
    let k = clamp(count, 3, 20);
    return loop k with acc = 0.0 {
        let i = index();
        let dt = s - grain_at(i, seed, len * 0.55);
        if dt < 0.0 || dt > 0.12 { acc } else {
            let click = white(n, seed + i) * exp(0.0 - dt * 260.0) * 0.6;
            let zap = tone(tb.pitch * 5.0 * (1.0 - dt * 6.0), dt) * exp(0.0 - dt * 40.0) * tb.crackle * 0.25;
            let stone = thud(dt, 140.0 + 80.0 * hash1(i, seed)) * tb.body * 0.35;
            acc + (click + zap + stone) * 0.18
        }
    };
}

/// Crystals or stones out of the ground: a sharp crack, a crunch or a
/// glassy ring as the element rings, the ground's thud as it weighs; a
/// few more as more come up.
fn crack(s: Float, count: Int, n: Long, tb: Timbre, seed: Int) -> Float {
    let k = clamp(count / 2, 1, 6);
    return loop k with acc = 0.0 {
        let i = index();
        let dt = s - (if i == 0 { 0.0 } else { hash1(i, seed) * 0.3 });
        if dt < 0.0 || dt > 1.5 { acc } else {
            let sharp = white(n, seed + i) * exp(0.0 - dt * 70.0);
            let crunch = soft_noise(dt * 3500.0, seed + i) * exp(0.0 - dt * 12.0) * (1.0 - tb.ring * 0.7);
            let glass = clang(tb.pitch * (3.0 + float(i) * 0.37), 2.71, dt, 0.35) * tb.ring * 0.5;
            let low = thud(dt, 45.0) * tb.body * 0.7;
            acc + (sharp * 0.7 + crunch + glass + low) * (if i == 0 { 0.5 } else { 0.3 })
        }
    };
}

/// Thunder: the stroke's crack, then its roll, long and wavering.
fn thunder_roll(s: Float, n: Long, tb: Timbre, seed: Int) -> Float {
    if s < 0.0 { return 0.0; }
    let strike = white(n, seed) * exp(0.0 - s * 22.0) * 0.9 + soft_noise(s * 6000.0, seed) * exp(0.0 - s * 7.0) * 0.5;
    let roll = (soft_noise(s * 55.0, seed + 1) * 0.8 + soft_noise(s * 32.0, seed + 2) * 0.6 + soft_noise(s * 140.0, seed + 3) * 0.3)
        * smoothstep(0.0, 0.06, s) * exp(0.0 - s / 1.4) * (0.7 + 0.3 * sin(s * 5.0));
    return (strike + roll * (0.6 + 0.6 * tb.body)) * 0.55;
}

/// A blade's sweep: air rising through it, a ring as it is metal.
fn swish(s: Float, len: Float, tb: Timbre, seed: Int) -> Float {
    let p = clamp(s / max(len * 0.5, 0.01), 0.0, 1.0);
    let air = soft_noise(s * (1800.0 + 8000.0 * p), seed) * pow(sin(3.14159 * p), 2.0) * 0.75;
    let shing = clang(tb.pitch * 4.0, 1.41, s - len * 0.25, 0.18) * tb.ring * 0.3;
    return (air + shing) * 0.55;
}

/// A ring running out over the ground: the ground's rumble.
fn rumble(s: Float, size: Float, tb: Timbre, seed: Int) -> Float {
    if s < 0.0 { return 0.0; }
    let tail = 0.4 + size * 0.12 + tb.body * 0.4;
    return (soft_noise(s * (45.0 + 160.0 * tb.bright), seed) * (0.5 + 0.6 * tb.body) * smoothstep(0.0, 0.03, s) * exp(0.0 - s / tail)
        + thud(s, 38.0) * 0.4 + soft_noise(s * 5000.0, seed + 1) * exp(0.0 - s * 10.0) * tb.wet * 0.4) * 0.5;
}

/// The picture lit: a short bright breath.
fn flash_sound(s: Float, tb: Timbre, seed: Int) -> Float {
    if s < 0.0 { return 0.0; }
    return (soft_noise(s * 5000.0, seed) * exp(0.0 - s * 14.0) * 0.4 + tone(tb.pitch * 4.0, s) * exp(0.0 - s * 10.0) * tb.ring * 0.15) * 0.6;
}

/// Darts: each whizzing a little after the one before, striking with a
/// thunk.
fn volley(s: Float, len: Float, count: Int, n: Long, tb: Timbre, seed: Int) -> Float {
    let k = clamp(count, 1, 10);
    let fly = len * 0.4;
    return loop k with acc = 0.0 {
        let i = index();
        let t0 = len * 0.5 * float(i) / float(k);
        let dt = s - t0;
        if dt < 0.0 || dt > fly + 0.3 { acc } else {
            let p = clamp(dt / fly, 0.0, 1.0);
            let whiz = soft_noise(dt * (3000.0 + 5000.0 * p), seed + i) * sin(3.14159 * p) * 0.35 * (if dt < fly { 1.0 } else { 0.0 });
            let thunk = (thud(dt - fly, 110.0) * 0.4 + white(n, seed + i) * exp(0.0 - max(dt - fly, 0.0) * 150.0) * 0.25) * (if dt >= fly { 1.0 } else { 0.0 });
            acc + (whiz + thunk) * 0.5
        }
    };
}

/// A voice's sound `s` seconds in.
fn voice_sound(v: Voice, tb: Timbre, s: Float, n: Long) -> Float {
    let len = v.end - v.start;
    if v.sound == sound_whoosh() { return whoosh(s, len, n, tb, v.seed); }
    if v.sound == sound_boom() { return boom(s, v.size, n, tb, v.seed); }
    if v.sound == sound_roar() { return roar(s, len, n, tb, v.seed); }
    if v.sound == sound_chime() { return chime(s, len, tb, v.seed); }
    if v.sound == sound_sparkle() { return sparkle(s, len, v.count, tb, v.seed); }
    if v.sound == sound_crackle() { return sputter(s, len, v.count, n, tb, v.seed); }
    if v.sound == sound_crack() { return crack(s, v.count, n, tb, v.seed); }
    if v.sound == sound_thunder() { return thunder_roll(s, n, tb, v.seed); }
    if v.sound == sound_swish() { return swish(s, len, tb, v.seed); }
    if v.sound == sound_rumble() { return rumble(s, v.size, tb, v.seed); }
    if v.sound == sound_flash() { return flash_sound(s, tb, v.seed); }
    if v.sound == sound_volley() { return volley(s, len, v.count, n, tb, v.seed); }
    return 0.0;
}

/// How long after its end a voice still sounds (its tail).
fn tail_of(sound: Int) -> Float {
    return if sound == sound_boom() || sound == sound_rumble() { 1.6 } else if sound == sound_thunder() { 3.5 } else if sound == sound_chime() || sound == sound_crack() { 1.2 } else { 0.3 };
}
