// The sounds of a game's events, each a cue (the audio package's) a
// project sets going: steps, the menus, blows and the rest of a fight,
// the world's doors and tools, and the short tunes of what happens. A
// step or a blow sounds as what it is on or what it strikes (a material,
// `data/materials.csv`: grass, stone, wood, dirt, sand, snow, water,
// metal, flesh, armor, bone, slime, cloth, crystal); a menu's sounds as
// the game's style (`data/styles.csv`: wood, metal, crystal, arcane,
// retro, soft). A cue's `param` says which and how: its material or
// style in its low four bits, its gait and weight, or its strength,
// above them (`event_param`).
use "random.entpkg";
use "audio.entpkg";

/// What a step or a blow sounds as: how bright its noise, how heavy its
/// low, how much it crunches, splashes, rings, scatters; the pitch it
/// rings at (Hz); how loud.
struct Material { bright: Float; body: Float; crunch: Float; wet: Float; ring: Float; scatter: Float; pitch: Float; gain: Float; }
type Materials = Rows<Material>;

/// A menu's style: the pitch its notes are about (Hz), how much they
/// ring, weigh, shine; 1 for square waves (an old console's); how loud.
struct Style { pitch: Float; ring: Float; body: Float; bright: Float; square: Float; gain: Float; }
type Styles = Rows<Style>;

// The materials and styles by name, rows of their tables.
fn grass() -> Int { return 0; }
fn stone() -> Int { return 1; }
fn wood() -> Int { return 2; }
fn dirt() -> Int { return 3; }
fn sand() -> Int { return 4; }
fn snow() -> Int { return 5; }
fn water() -> Int { return 6; }
fn metal() -> Int { return 7; }
fn flesh() -> Int { return 8; }
fn armor() -> Int { return 9; }
fn bone() -> Int { return 10; }
fn slime() -> Int { return 11; }
fn cloth() -> Int { return 12; }
fn crystal_() -> Int { return 13; }

fn style_wood() -> Int { return 0; }
fn style_metal() -> Int { return 1; }
fn style_crystal() -> Int { return 2; }
fn style_arcane() -> Int { return 3; }
fn style_retro() -> Int { return 4; }
fn style_soft() -> Int { return 5; }

// The events. Steps: `param` the material, the gait (0 walk, 1 run, 2 a
// landing) and the weight (0 light, 1 middling, 2 heavy).
fn event_step() -> Int { return 1; }
// The menus: `param` the style (-1, or none given, the scene's).
fn event_move() -> Int { return 10; }
fn event_confirm() -> Int { return 11; }
fn event_cancel() -> Int { return 12; }
fn event_error() -> Int { return 13; }
fn event_open() -> Int { return 14; }
fn event_close() -> Int { return 15; }
fn event_page() -> Int { return 16; }
fn event_type() -> Int { return 17; }
fn event_coin() -> Int { return 18; }
fn event_item() -> Int { return 19; }
fn event_equip() -> Int { return 20; }
fn event_buy() -> Int { return 21; }
// A fight: `param` the material struck and the strength (0 to 3).
fn event_hit() -> Int { return 30; }
fn event_crit() -> Int { return 31; }
fn event_miss() -> Int { return 32; }
fn event_block() -> Int { return 33; }
fn event_fall() -> Int { return 34; }
fn event_jump() -> Int { return 35; }
fn event_pickup() -> Int { return 36; }
fn event_swing() -> Int { return 37; }
// The world: `param` the material.
fn event_door() -> Int { return 50; }
fn event_chest() -> Int { return 51; }
fn event_lever() -> Int { return 52; }
fn event_splash() -> Int { return 53; }
fn event_dig() -> Int { return 54; }
fn event_chop() -> Int { return 55; }
fn event_mine() -> Int { return 56; }
fn event_build() -> Int { return 57; }
fn event_bell() -> Int { return 58; }
// What happens: `param` the style.
fn event_levelup() -> Int { return 70; }
fn event_victory() -> Int { return 71; }
fn event_defeat() -> Int { return 72; }
fn event_fled() -> Int { return 73; }
fn event_day() -> Int { return 74; }
fn event_quest() -> Int { return 75; }
fn event_discover() -> Int { return 76; }
fn event_save() -> Int { return 77; }
fn event_encounter() -> Int { return 78; }
fn event_alarm() -> Int { return 79; }

/// A cue's `param`: its material or style (`which`), and its gait,
/// weight or strength (`how`, 0 to 15).
fn event_param(which: Int, how: Int) -> Int { return clamp(which, 0, 15) + 16 * clamp(how, 0, 15); }
fn param_which(p: Int) -> Int { return p % 16; }
fn param_how(p: Int) -> Int { return p / 16; }
/// A step's gait and weight in one `how`.
fn step_how(gait: Int, weight: Int) -> Int { return clamp(gait, 0, 2) + 3 * clamp(weight, 0, 2); }

/// How long an event sounds.
fn event_length(kind: Int) -> Float {
    if kind == event_step() { return 0.35; }
    if kind >= 10 && kind < 18 { return 0.4; }
    if kind == event_coin() || kind == event_equip() { return 0.6; }
    if kind == event_item() || kind == event_buy() { return 0.9; }
    if kind >= 30 && kind < 40 { return if kind == event_crit() || kind == event_fall() { 1.2 } else { 0.7 }; }
    if kind == event_bell() { return 4.0; }
    if kind >= 50 && kind < 60 { return 1.4; }
    if kind == event_victory() || kind == event_defeat() { return 3.4; }
    if kind == event_alarm() { return 2.4; }
    if kind >= 70 { return 2.2; }
    return 0.5;
}

/// A square wave, -1 to 1.
fn square(f: Float, t: Float) -> Float { return if fract(f * t) < 0.5 { 1.0 } else { -1.0 }; }

/// A menu's note: in the style's voice, `f` its pitch, `d` how long it
/// rings.
fn note(sty: Style, f: Float, t: Float, d: Float) -> Float {
    if t < 0.0 { return 0.0; }
    let env = smoothstep(0.0, 0.004, t) * exp(0.0 - t / d);
    let soft = tone(f, t) * (1.0 - sty.square) + square(f, t) * sty.square * 0.5;
    let rung = bell(f, t) * sty.ring * 0.6;
    let warm = tone(f * 0.5, t) * sty.body * 0.3;
    let shine = tone(f * 2.0, t) * sty.bright * 0.25 * exp(0.0 - t * 20.0);
    return (soft + warm + shine) * env + rung * (1.0 - sty.square);
}

/// A run of notes `gap` apart, each `ratio` above the one before.
fn run(sty: Style, f: Float, t: Float, steps: Int, ratios: Vec4, gap: Float, d: Float) -> Float {
    return loop steps with acc = 0.0 {
        let i = index();
        let r = if i == 0 { 1.0 } else if i == 1 { ratios.x } else if i == 2 { ratios.y } else if i == 3 { ratios.z } else { ratios.w };
        acc + note(sty, f * r, t - float(i) * gap, d)
    };
}

/// Crunch: grains of noise scattered over `span` seconds, as many as the
/// material scatters.
fn crunch(t: Float, n: Long, m: Material, seed: Int, span: Float) -> Float {
    let k = 8;
    return loop k with acc = 0.0 {
        let i = index();
        let dt = t - hash1(i, seed) * span;
        if dt < 0.0 || dt > 0.03 || hash1(i, seed + 5) > m.scatter + 0.2 { acc } else {
            acc + soft_noise(dt * (2500.0 + 6000.0 * m.bright), seed + i) * exp(0.0 - dt * 160.0) * 0.5
        }
    };
}

/// Something struck on a material, `hard` 0 to 1 how hard.
fn struck(t: Float, n: Long, m: Material, hard: Float, seed: Int) -> Float {
    if t < 0.0 { return 0.0; }
    let low = thud(t, 40.0 + m.pitch * 0.15) * m.body * (0.5 + hard);
    let snap = soft_noise(t * (1500.0 + 7000.0 * m.bright), seed) * exp(0.0 - t * (60.0 - 30.0 * m.body)) * (0.4 + 0.6 * hard);
    let tick = white(n, seed + 1) * exp(0.0 - t * 400.0) * m.bright * 0.5;
    let rung = clang(m.pitch, 2.41, t, 0.12 + m.ring * 0.5) * m.ring * 0.45 * (0.4 + 0.6 * hard);
    let splat = soft_noise(t * 3200.0, seed + 2) * exp(0.0 - t * 14.0) * m.wet * 0.6;
    return (low + snap + tick + rung + splat + crunch(t, n, m, seed, 0.06) * m.crunch) * m.gain;
}

/// A step: the heel, then the toe a little after, as heavy as the one
/// stepping and as fast as it goes; a landing one heavy blow.
fn step_sound(t: Float, n: Long, m: Material, how: Int, seed: Int) -> Float {
    let gait = how % 3;
    let weight = how / 3;
    let heavy = 0.25 + 0.3 * float(weight) + 0.15 * float(gait);
    if gait == 2 { return struck(t, n, m, min(heavy + 0.3, 1.0), seed) * 0.8 + crunch(t, n, m, seed + 9, 0.15) * m.crunch * 0.6; }
    let toe_at = if gait == 1 { 0.025 } else { 0.045 };
    return (struck(t, n, m, heavy, seed) * 0.6 + struck(t - toe_at, n, m, heavy * 0.6, seed + 3) * 0.35
        + crunch(t, n, m, seed + 7, 0.1) * m.crunch * 0.5) * 0.7;
}

/// The air of a swing or a whiff.
fn air(t: Float, len: Float, rise: Float, seed: Int) -> Float {
    let p = clamp(t / len, 0.0, 1.0);
    return soft_noise(t * (1500.0 + rise * p + 2000.0), seed) * pow(sin(3.14159 * p), 2.0);
}

/// A creak: a rough tone gliding, as a hinge does.
fn creak(t: Float, f: Float, len: Float, seed: Int) -> Float {
    if t < 0.0 || t > len { return 0.0; }
    let g = f * (1.0 + 0.3 * t / len + 0.05 * soft_noise(t * 30.0, seed));
    let rasp = if fract(g * t) < 0.15 { 1.0 } else { 0.0 };
    return (rasp - 0.15) * sin(3.14159 * t / len) * 0.5;
}

/// A horn's tune: notes and their lengths, a pair at a time.
fn fanfare(sty: Style, t: Float, f: Float, notes: [Float; 6], times: [Float; 6], lens: [Float; 6]) -> Float {
    return loop 6 with acc = 0.0 {
        let i = index();
        let dt = t - times[i];
        if dt < 0.0 || dt > lens[i] + 0.3 { acc } else { acc + horn(f * notes[i], dt, lens[i]) * (0.7 + 0.3 * sty.body) + note(sty, f * notes[i] * 2.0, dt, 0.2) * 0.15 }
    };
}

/// An event's sound `t` seconds in, at sample `n`: `m` its material,
/// `sty` its style.
fn event_sound(kind: Int, param: Int, t: Float, n: Long, m: Material, sty: Style) -> Float {
    if t < 0.0 { return 0.0; }
    let how = param_how(param);
    let seed = param * 13 + kind * 7;
    let f = sty.pitch;
    if kind == event_step() { return step_sound(t, n, m, how, seed); }
    // The menus.
    if kind == event_move() { return note(sty, f * 1.5, t, 0.03) * 0.25; }
    if kind == event_confirm() { return (note(sty, f, t, 0.06) + note(sty, f * 1.5, t - 0.06, 0.1)) * 0.25; }
    if kind == event_cancel() { return (note(sty, f * 1.2, t, 0.06) + note(sty, f * 0.8, t - 0.06, 0.1)) * 0.22; }
    if kind == event_error() { return (note(sty, f * 0.5, t, 0.12) + note(sty, f * 0.53, t, 0.12)) * 0.2 * (if t < 0.18 { 1.0 } else { 0.0 }) + (note(sty, f * 0.5, t - 0.2, 0.1) + note(sty, f * 0.53, t - 0.2, 0.1)) * 0.2; }
    if kind == event_open() { return (soft_noise(t * (1500.0 + 4000.0 * t), seed) * envelope(t, 0.08, 0.08) * 0.25 + note(sty, f * (1.0 + t), t, 0.15) * 0.15); }
    if kind == event_close() { return (soft_noise(t * (4000.0 - 3000.0 * min(t * 4.0, 1.0)), seed) * envelope(t, 0.04, 0.06) * 0.25 + note(sty, f * (1.0 - 0.5 * t), t, 0.1) * 0.15); }
    if kind == event_page() { return soft_noise(t * (5000.0 + 3000.0 * t), seed) * envelope(t, 0.015, 0.06) * 0.9 + thud(t - 0.04, 200.0) * 0.2; }
    if kind == event_type() { return note(sty, f * (2.0 + hash1(int((n / 2400l) & 2147483647l), seed)), t, 0.015) * 0.15; }
    if kind == event_coin() { return (bell(f * 3.0, t) * 0.5 + bell(f * 4.0, t - 0.07) * 0.6) * 0.3; }
    if kind == event_item() { return run(sty, f, t, 4, vec4(1.26, 1.5, 2.0, 2.0), 0.08, 0.2) * 0.22 + soft_noise(t * 9000.0, seed) * envelope(t - 0.3, 0.1, 0.3) * 0.04; }
    if kind == event_equip() { return clang(f * 1.4, 2.76, t, 0.2) * 0.25 + soft_noise(t * 3000.0, seed) * envelope(t, 0.02, 0.08) * 0.2; }
    if kind == event_buy() { return (bell(f * 3.0, t) + bell(f * 4.0, t - 0.07) + bell(f * 5.0, t - 0.25) * 0.8) * 0.22 + thud(t - 0.2, 300.0) * 0.1; }
    // A fight.
    let hard = 0.3 + 0.23 * float(how);
    if kind == event_hit() { return struck(t, n, m, hard, seed) * 0.8; }
    if kind == event_crit() { return struck(t, n, m, 1.0, seed) + thud(t, 34.0) * 0.9 + clang(1320.0, 2.76, t, 0.3) * 0.25 + soft_noise(t * 200.0, seed + 4) * exp(0.0 - t * 3.0) * 0.3; }
    if kind == event_miss() { return air(t, 0.25, 6000.0, seed) * 0.4; }
    if kind == event_block() { return clang(m.pitch * 1.2 + 300.0, 2.41, t, 0.2 + m.ring * 0.4) * (0.3 + 0.4 * m.ring) + white(n, seed) * exp(0.0 - t * 150.0) * 0.5 + struck(t, n, m, 0.6, seed) * 0.4; }
    if kind == event_fall() { return struck(t, n, m, 1.0, seed) * 1.3 + thud(t, 45.0) * 0.9 + struck(t - 0.28, n, m, 0.6, seed + 2) * 0.8 + soft_noise(t * 2500.0, seed + 3) * envelope(t, 0.05, 0.2) * 0.25; }
    if kind == event_jump() { return soft_noise(t * 2200.0, seed) * envelope(t, 0.03, 0.08) * 0.2 + step_sound(t, n, m, 0, seed) * 0.4; }
    if kind == event_pickup() { return (pluck(f * 2.0, t) + pluck(f * 3.0, t - 0.05) * 0.7) * 0.3; }
    if kind == event_swing() { return air(t, 0.3, 9000.0 * hard, seed) * (0.3 + 0.3 * hard); }
    // The world.
    if kind == event_door() { return creak(t, 90.0, 0.7, seed) * 0.5 + struck(t - 0.75, n, m, 0.8, seed) * 0.7; }
    if kind == event_chest() { return creak(t, 130.0, 0.5, seed) * 0.4 + white(n, seed) * exp(0.0 - max(t - 0.05, 0.0) * 300.0) * (if t > 0.05 { 0.3 } else { 0.0 }) + run(sty, f * 2.0, t - 0.55, 3, vec4(1.26, 1.5, 2.0, 2.0), 0.07, 0.25) * 0.15; }
    if kind == event_lever() { return struck(t, n, m, 0.7, seed) * 0.6 + clang(f, 1.7, t - 0.12, 0.1) * 0.25 + thud(t - 0.12, 70.0) * 0.4; }
    if kind == event_splash() { return (soft_noise(t * 6000.0, seed) * exp(0.0 - t * 5.0) * 0.5 + thud(t, 60.0) * 0.4 + crunch(t - 0.1, n, m, seed, 0.4) * 0.6) * 0.7; }
    if kind == event_dig() { return struck(t, n, m, 0.6, seed) * 0.5 + crunch(t, n, m, seed + 1, 0.25) * 0.8 + crunch(t - 0.3, n, m, seed + 2, 0.25) * 0.4; }
    if kind == event_chop() { return struck(t, n, m, 0.9, seed) * 0.8 + soft_noise(t * 1800.0, seed + 1) * exp(0.0 - t * 25.0) * 0.4 + struck(t - 0.5, n, m, 0.7, seed + 2) * 0.5; }
    if kind == event_mine() { return struck(t, n, m, 1.0, seed) * 0.7 + clang(m.pitch + 600.0, 2.76, t, 0.15) * 0.3 + crunch(t - 0.05, n, m, seed + 3, 0.4) * 0.7; }
    if kind == event_build() { return loop 3 with acc = 0.0 { acc + struck(t - float(index()) * 0.32, n, m, 0.8, seed + index()) * 0.5 }; }
    if kind == event_bell() { return (bell(220.0, t) + bell(330.0, t) * 0.4 + bell(440.0 * 1.19, t) * 0.25) * 0.5 * exp(0.0 - t * 0.5) / exp(0.0 - t * 4.0); }
    // What happens.
    if kind == event_levelup() { return run(sty, f, t, 5, vec4(1.26, 1.5, 2.0, 2.52), 0.1, 0.35) * 0.2 + soft_noise(t * 9000.0, seed) * envelope(t - 0.4, 0.3, 0.6) * 0.05; }
    if kind == event_victory() { return fanfare(sty, t, f * 0.5, [1.0, 1.0, 1.0, 1.0, 0.794, 1.0], [0.0, 0.14, 0.28, 0.42, 0.9, 1.4], [0.1, 0.1, 0.1, 0.4, 0.4, 1.4]) * 0.4; }
    if kind == event_defeat() { return fanfare(sty, t, f * 0.5, [1.0, 0.944, 0.84, 0.794, 0.749, 0.5], [0.0, 0.45, 0.9, 1.35, 1.8, 2.2], [0.4, 0.4, 0.4, 0.4, 0.4, 1.0]) * 0.35; }
    if kind == event_fled() { return air(t, 0.5, 4000.0, seed) * 0.8 + step_sound(t - 0.3, n, m, 1, seed) * 1.0 + step_sound(t - 0.5, n, m, 1, seed + 1) * 0.9 + step_sound(t - 0.7, n, m, 1, seed + 2) * 0.7; }
    if kind == event_day() { return (bell(f * 2.0, t) + bell(f * 2.52, t - 0.3) * 0.7 + bell(f * 3.0, t - 0.6) * 0.5) * 0.15 + tone(f * 6.0 * (1.0 + 0.2 * sin(t * 40.0)), t - 1.0) * envelope(t - 1.0, 0.02, 0.1) * 0.05; }
    if kind == event_quest() { return (note(sty, f, t, 0.8) + note(sty, f * 1.26, t, 0.8) + note(sty, f * 1.5, t, 0.8) + note(sty, f * 2.0, t - 0.25, 0.9)) * 0.14; }
    if kind == event_discover() { return run(sty, f * 0.75, t, 4, vec4(1.19, 1.5, 1.78, 2.0), 0.15, 0.6) * 0.18; }
    if kind == event_save() { return (note(sty, f * 1.5, t, 0.25) + note(sty, f * 2.0, t - 0.12, 0.4)) * 0.2; }
    if kind == event_encounter() {
        let g = 180.0 + 1200.0 * t * t;
        return (tone(g, t) * 0.18 + soft_noise(t * (2000.0 + 6000.0 * t), seed) * 0.2) * envelope(t, 0.3, 0.2) + clang(980.0, 1.47, t - 0.45, 0.25) * 0.35 + thud(t - 0.45, 40.0) * 0.4;
    }
    if kind == event_alarm() { return loop 4 with acc = 0.0 { acc + bell(f * 2.0, t - float(index()) * 0.5) * 0.3 }; }
    return 0.0;
}

/// How loud an event is beside the others and under a game's music: steps
/// softest, the menus' small sounds next, blows, the world and the tunes.
fn event_level(kind: Int) -> Float {
    if kind == event_step() { return 0.3; }
    if kind >= 10 && kind < 30 { return 0.55; }
    if kind >= 70 { return 0.6; }
    return 0.65;
}

/// A cue heard: its event's sound `t` seconds in, in its material and the
/// style it names (or `style` when it names none), as loud as its kind.
fn heard(c: Cue, t: Float, n: Long, materials: Materials, styles: Styles, style: Int) -> Float {
    if c.kind <= 0 || t < 0.0 || t > event_length(c.kind) { return 0.0; }
    let which = param_which(c.param);
    let m = at(materials, clamp(which, 0, count(materials) - 1));
    let menu = (c.kind >= 10 && c.kind < 30) || c.kind >= 70;
    let sty = at(styles, clamp(if menu && which > 0 { which } else { style }, 0, count(styles) - 1));
    return event_sound(c.kind, c.param, t, n, m, sty) * (if menu { sty.gain } else { 1.0 }) * event_level(c.kind);
}

/// The cues heard, a block of stereo samples: each where its `pan` says.
kernel sound.events@1 {
    requires { field.read; field.write; time.read; }
    /// The style a menu's cue that names none sounds in, and how loud all is.
    param style: Int = 0;
    param volume: Float = 2.0;
    input cues: Cues;
    input clock: Clocks;
    input materials: Materials;
    input styles: Styles;
    /// The block's size (its domain).
    input block: Rows<Float>;
    output result: Rows<Vec2>;
    compute {
        let n = at(clock, 0).n + long(element());
        let sum = loop count(cues) with acc = vec2(0.0, 0.0) {
            let c = at(cues, index());
            let t = float(n - c.start) / hz();
            if c.kind <= 0 || t < 0.0 || t > event_length(c.kind) { acc } else {
                let x = heard(c, t, n, materials, styles, style) * c.gain;
                acc + vec2(x * (1.0 - c.pan), x * (1.0 + c.pan)) * 0.5
            }
        };
        let out = sum * volume;
        return vec2(out.x / (1.0 + abs(out.x)), out.y / (1.0 + abs(out.y)));
    }
}
