// The voices summed into a block of stereo samples: each heard from the
// eye, quieter far off, to the side it is on; louder as its tier is
// higher; the whole softly held under full scale.
use "audio.entpkg";
use "effects.entpkg";
use "voice.ent";
use "cast.ent";

kernel sound.sound@1 {
    requires { field.read; field.write; time.read; }
    /// How loud all of it is.
    param volume: Float = 1.1;
    input voices: Voices;
    input timbres: Timbres;
    input eye: Eyes;
    input clock: Clocks;
    /// The block's size (its domain).
    input block: Rows<Float>;
    output result: Rows<Vec2>;
    compute {
        let j = element();
        let n = at(clock, 0).n + long(j);
        let e = at(eye, 0);
        let k = count(voices);
        let sum = loop k with acc = vec2(0.0, 0.0) {
            let v = at(voices, index());
            if v.sound == 0 { acc } else {
                let since = v.now + float(j) / hz() - v.begin;
                let rel = if v.looped > 0.0 { since - floor(since / v.looped) * v.looped } else { since };
                let s = rel - v.start;
                if since < 0.0 || s < 0.0 || s > v.end - v.start + tail_of(v.sound) { acc } else {
                    let tb = at(timbres, v.element);
                    let p = mix(v.from, v.to, clamp(s / max(v.end - v.start, 0.01), 0.0, 1.0));
                    let d = p - e.from;
                    let far = length(d);
                    let side = clamp(dot(d / max(far, 0.01), e.right), -1.0, 1.0) * 0.75;
                    let loud = tb.gain * tier_shine(v.tier) / (1.0 + far * 0.04);
                    let x = voice_sound(v, tb, s, n) * loud;
                    acc + vec2(x * (1.0 - side), x * (1.0 + side)) * 0.5
                }
            }
        };
        // Held under full scale, softly.
        let out = sum * volume;
        return vec2(out.x / (1.0 + abs(out.x)), out.y / (1.0 + abs(out.y)));
    }
}
