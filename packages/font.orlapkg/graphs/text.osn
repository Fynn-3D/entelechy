//! A row of character codes in a font, over `under` at the window's
//! size: the characters laid out from `origin`, `size` pixels an em, in
//! `color`, a code 10 starting a line `leading` ems below (the font's
//! own when zero). The font is the three Fields `orla import` writes:
//!
//!   node title: graph "font.orlapkg/graphs/text.osn" {
//!       codes <- title; glyphs <- glyphs; outlines <- outlines;
//!       metrics <- metrics; under <- picture.result;
//!       origin = vec2(40.0, 80.0); size = 48.0;
//!   }
use "../kernels/font.orla";

input codes: Rows<Int>;
input glyphs: Rows<Letterform>;
input outlines: Rows<Vec4>;
input metrics: Rows<Metrics>;
input under: Image;
param origin: Vec2 = vec2(0.0, 0.0);
param size: Float = 32.0;
param leading: Float = 0.0;
param color: Vec4 = vec4(0.0, 0.0, 0.0, 1.0);

// The characters laid out.
node advances: font.advances@1 { codes <- codes; glyphs <- glyphs; }
node pens: font.pens@1 { advances <- advances.result; }
node lines: font.lines@1 { codes <- codes; }
node breaks: font.breaks@1 { codes <- codes; }
node layout: font.layout@1 {
    codes <- codes;
    glyphs <- glyphs;
    metrics <- metrics;
    advances <- advances.result;
    pens <- pens.result;
    lines <- lines.result;
    breaks <- breaks.result;
    origin = origin;
    size = size;
    leading = leading;
}

// The glyphs placed, as a drawing in pixels.
node counts: font.counts@1 { placed <- layout.result; glyphs <- glyphs; }
node lists: graph "../../compact.orlapkg/graphs/runs.osn" { counts <- counts.result; }
node shapes: font.shapes@1 { placed <- layout.result; glyphs <- glyphs; counts <- counts.result; ends <- lists.ends; color = color; }
node segments: font.segments@1 {
    total <- lists.entries;
    placed <- layout.result;
    glyphs <- glyphs;
    outlines <- outlines;
    counts <- counts.result;
    ends <- lists.ends;
    domain = value(total);
}
node stops: font.no_stops@1 { domain = 1; }
node canvas: Grid<Int> { domain = window(); }
node page: font.page@1 { canvas <- canvas.result; domain = 1; }
node look: vector.whole@1 { view <- page.result; }
node drawn: graph "../../vector.orlapkg/graphs/draw.osn" {
    shapes <- shapes.result;
    segments <- segments.result;
    stops <- stops.result;
    view <- page.result;
    look <- look.result;
    background = vec4(0.0, 0.0, 0.0, 0.0);
}
node over: font.over@1 { under <- under; ink <- drawn.picture; }

output picture <- over.result;
