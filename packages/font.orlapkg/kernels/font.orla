// Type from a font `orla import` read: a row of character codes laid out
// in lines, each character its font's glyph at its own advance, and the
// glyphs placed turned into the shapes and segments the `vector` package
// draws, so text is as sharp at any size as any drawing.
//
// A font is three Fields: its glyphs in order of code, the first the
// glyph for a character it lacks; their outlines as segments in ems, y
// up; and its measures. A page is in pixels, y down: a line's baseline
// starts at `origin`, a character takes `size` pixels an em, and a line
// is `leading` ems below the one before (the font's own when zero). A
// code 10 starts a line.

// Drawings are the `vector` package's; lists are runs of the `compact`
// package's.
use "vector.orlapkg";
use "compact.orlapkg";

// A glyph as `orla import` writes it: its code, its advance in the
// font's units, its segments, and its box in ems.
struct Letterform { code: Int; advance: Int; first: Int; count: Int; lo: Vec2; hi: Vec2; }

// The font's units in an em, and its ascent, descent and line gap in ems.
struct Metrics { units: Int; ascent: Float; descent: Float; gap: Float; }

// A character placed: the glyph row it draws (-1 for none), where its
// baseline starts on the page, and the pixels of its em.
struct Placed { glyph: Int; origin: Vec2; size: Float; }

fn newline() -> Int { return 10; }

// The row of a code among the glyphs, by bisection; the missing glyph,
// row 0, for a code the font lacks.
fn glyph_of(code: Int, glyphs: Rows<Letterform>) -> Int {
    let found = loop 32 with r = ivec2(0, count(glyphs)) until r.x >= r.y {
        let mid = (r.x + r.y) / 2;
        if at(glyphs, mid).code >= code { ivec2(r.x, mid) } else { ivec2(mid + 1, r.y) }
    };
    return if found.x < count(glyphs) && at(glyphs, found.x).code == code { found.x } else { 0 };
}

/// How far each character moves the pen, in the font's units: none for
/// a new line.
kernel font.advances@1 {
    requires { field.read; field.write; }
    input codes: Rows<Int>;
    input glyphs: Rows<Letterform>;
    output result: Rows<Int>;
    compute {
        let c = sample(codes);
        return if c == newline() { 0 } else { at(glyphs, glyph_of(c, glyphs)).advance };
    }
}

/// Where the pen is after each character: a prefix of the advances.
kernel font.pens@1 {
    requires { field.read; field.write; }
    input advances: Rows<Int>;
    output result: Rows<Int>;
    prefix with sum { return sample(advances); }
}

/// How many lines have started by each character.
kernel font.lines@1 {
    requires { field.read; field.write; }
    input codes: Rows<Int>;
    output result: Rows<Int>;
    prefix with sum { return if sample(codes) == newline() { 1 } else { 0 }; }
}

/// The last new line at or before each character, -1 for none.
kernel font.breaks@1 {
    requires { field.read; field.write; }
    input codes: Rows<Int>;
    output result: Rows<Int>;
    prefix with max { return if sample(codes) == newline() { element() } else { -1 }; }
}

/// Each character placed on the page: the pen where its line started
/// taken from where it is, in pixels, and its line below the first.
kernel font.layout@1 {
    requires { field.read; field.write; }
    input codes: Rows<Int>;
    input glyphs: Rows<Letterform>;
    input metrics: Rows<Metrics>;
    input advances: Rows<Int>;
    input pens: Rows<Int>;
    input lines: Rows<Int>;
    input breaks: Rows<Int>;
    param origin: Vec2 = vec2(0.0, 0.0);
    param size: Float = 32.0;
    param leading: Float = 0.0;
    output result: Rows<Placed>;
    compute {
        let i = element();
        let c = sample(codes);
        let m = at(metrics, 0);
        let k = sample(breaks);
        let start = if k >= 0 { at(pens, k) } else { 0 };
        let pen = sample(pens) - sample(advances) - start;
        let line = if leading > 0.0 { leading } else { m.ascent - m.descent + m.gap };
        let x = float(pen) / float(m.units) * size;
        let y = float(sample(lines)) * line * size;
        return Placed { glyph: if c == newline() { -1 } else { glyph_of(c, glyphs) }, origin: origin + vec2(x, y), size: size };
    }
}

// ---- as a drawing

/// How many segments each placed glyph draws.
kernel font.counts@1 {
    requires { field.read; field.write; }
    input placed: Rows<Placed>;
    input glyphs: Rows<Letterform>;
    output result: Rows<Int>;
    compute { let p = sample(placed); return if p.glyph < 0 { 0 } else { at(glyphs, p.glyph).count }; }
}

// A point of a glyph in ems, y up, on the page.
fn on_page(p: Placed, v: Vec2) -> Vec2 { return p.origin + vec2(v.x, -v.y) * p.size; }

/// Each placed glyph as a shape of `color`, filled by the nonzero rule.
kernel font.shapes@1 {
    requires { field.read; field.write; }
    input placed: Rows<Placed>;
    input glyphs: Rows<Letterform>;
    input counts: Rows<Int>;
    input ends: Rows<Int>;
    param color: Vec4 = vec4(0.0, 0.0, 0.0, 1.0);
    output result: Rows<Shape>;
    compute {
        let p = sample(placed);
        let g = at(glyphs, max(p.glyph, 0));
        let n = sample(counts);
        return Shape {
            color: color, first: sample(ends) - n, count: n, rule: 0, paint: 0,
            lo: on_page(p, vec2(g.lo.x, g.hi.y)), hi: on_page(p, vec2(g.hi.x, g.lo.y)),
            gradient: vec4(0.0, 0.0, 0.0, 0.0), inverse: vec4(1.0, 0.0, 0.0, 1.0), shift: vec2(0.0, 0.0),
            stops: 0, stop_count: 0, spread: 0,
        };
    }
}

/// The segments of the placed glyphs, on the page.
kernel font.segments@1 {
    requires { field.read; field.write; }
    input total: Rows<Int>;
    input placed: Rows<Placed>;
    input glyphs: Rows<Letterform>;
    input outlines: Rows<Vec4>;
    input counts: Rows<Int>;
    input ends: Rows<Int>;
    output result: Rows<Vec4>;
    compute {
        let e = element();
        let i = owner(e, ends);
        let p = at(placed, i);
        let g = at(glyphs, max(p.glyph, 0));
        let s = at(outlines, g.first + e - (at(ends, i) - at(counts, i)));
        let a = on_page(p, vec2(s.x, s.y));
        let b = on_page(p, vec2(s.z, s.w));
        return vec4(a.x, a.y, b.x, b.y);
    }
}

/// No gradient stops: type is drawn in one colour.
kernel font.no_stops@1 {
    requires { field.read; field.write; }
    output result: Rows<Stop>;
    compute { return Stop { offset: 0.0, color: vec4(0.0, 0.0, 0.0, 1.0) }; }
}

/// The page's size, from a Field over it.
kernel font.page@1 {
    requires { field.read; field.write; }
    input canvas: Grid<Int>;
    output result: Rows<Vec2>;
    compute { return size(canvas); }
}

/// Type drawn over nothing laid over a picture: its colour already
/// weighed by its cover, which its alpha is.
kernel font.over@1 {
    requires { field.read; field.write; }
    input under: Image;
    input ink: Image;
    output result: Image;
    compute {
        let u = sample(under);
        let t = sample(ink);
        return vec4(u.x * (1.0 - t.w) + t.x, u.y * (1.0 - t.w) + t.y, u.z * (1.0 - t.w) + t.z, u.w * (1.0 - t.w) + t.w);
    }
}

/// Two rows of codes as one, a new line between: `domain = count(first)
/// + count(second) + 1`.
kernel font.join@1 {
    requires { field.read; field.write; }
    input first: Rows<Int>;
    input second: Rows<Int>;
    output result: Rows<Int>;
    compute {
        let i = element();
        let n = count(first);
        return if i < n { at(first, i) } else { if i == n { newline() } else { at(second, i - n - 1) } };
    }
}
