//! One substep of `step.esn`: gravity, the manifolds solved, the bodies
//! moved, and the manifolds solved once more without pushing apart, the
//! impulses they then hold pushed again to warm the next substep.
use "../kernels/";

input bodies: Rows<Body>;
input manifolds: Rows<Manifold>;
input shared: Rows<Int>;
input zeros: Rows<Vec3>;
param dt: Float = 0.0166667;
param substeps: Int = 8;
param gravity: Vec2 = vec2(0.0, -10.0);
param damping: Float = 0.0;
param hertz: Float = 30.0;
param ratio: Float = 10.0;
param speed: Float = 3.0;

node fall: physics.fall@1 { bodies <- bodies; dt = dt; substeps = substeps; gravity = gravity; damping = damping; }

node solve: physics.solve@1 {
    manifolds <- manifolds;
    bodies <- fall.result;
    shared <- shared;
    dt = dt; substeps = substeps; hertz = hertz; ratio = ratio; speed = speed;
}
node solve_pushes: physics.pushes@1 { manifolds <- solve.result; zeros <- zeros; domain = 2 * count(manifolds); }
node solved: physics.push@1 { bodies <- fall.result; pushes <- solve_pushes.result; }

node move: physics.move@1 { bodies <- solved.result; dt = dt; substeps = substeps; }

node relax: physics.solve@1 {
    manifolds <- solve.result;
    bodies <- move.result;
    shared <- shared;
    dt = dt; substeps = substeps; relax = true; ahead = true; hertz = hertz; ratio = ratio; speed = speed;
}
node relax_pushes: physics.pushes@1 { manifolds <- relax.result; zeros <- zeros; domain = 2 * count(manifolds); }
node relaxed: physics.push@1 { bodies <- move.result; pushes <- relax_pushes.result; }

output moved <- relaxed.result;
output held <- relax.result;
