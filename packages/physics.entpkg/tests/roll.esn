// A ball rolling on the ground, and a ball rolling fast at a thin wall:
// a circle's point of contact stays where it touches however it turns.
use "../kernels/";

node start: kernel {
    requires { field.read; field.write; }
    output result: Rows<Body>;
    compute {
        let i = element();
        if i == 0 { return box(vec2(0.0, -0.5), vec2(30.0, 0.5), 0.0, 0.0); }
        if i == 1 { return box(vec2(-25.1, 5.0), vec2(0.1, 5.0), 0.0, 0.0); }
        if i == 2 { return Body { ..circle(vec2(10.0, 0.2), 0.2, 1.0), velocity: vec2(-5.0, 0.0), spin: 25.0 }; }
        return Body { ..circle(vec2(-20.0, 0.2), 0.2, 1.0), velocity: vec2(-30.0, 0.0), spin: 150.0 };
    }
    domain = 4;
}

node none: physics.no_contacts@1 { domain = 1; }
node world: graph "../graphs/step.esn" {
    bodies <~ world.result from start.result;
    held <~ world.contacts from none.result;
    origin = vec2(-32.0, -2.0);
    columns = 64;
    rows = 16;
    cell = 1.0;
    bits = 10;
}

node now: kernel {
    requires { field.read; field.write; }
    input bodies: Rows<Body> <- world.result;
    output result: Rows<Body>;
    compute { return sample(bodies); }
}

output bodies <- now.result;
