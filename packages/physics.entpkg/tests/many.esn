// Circles of `count` poured into a box, the pairs the grid finds held
// to every pair asked, and the circles counted that got out of the box.
use "../kernels/";

param count: Int = 420;
param steps: Int = 1;

fn scatter_of(i: Int) -> Body {
    let x = -14.5 + float(i % 60) * 0.49;
    let y = 1.0 + float(i / 60) * 0.49;
    let jitter = float((i * 7919) % 101) * 0.0005;
    return Body { ..circle(vec2(x + jitter, y), 0.22, 1.0), restitution: 0.1 };
}

node start: kernel {
    requires { field.read; field.write; }
    param count: Int = count;
    output result: Rows<Body>;
    compute {
        let i = element();
        if i == 0 { return box(vec2(0.0, -0.5), vec2(16.0, 0.5), 0.0, 0.0); }
        if i == 1 { return box(vec2(-15.5, 20.0), vec2(0.5, 20.5), 0.0, 0.0); }
        if i == 2 { return box(vec2(15.5, 20.0), vec2(0.5, 20.5), 0.0, 0.0); }
        return scatter_of(i);
    }
    domain = count + 3;
}

node none: physics.no_contacts@1 { domain = 1; }
node world: graph "../graphs/step.esn" {
    times = steps;
    carry bodies <- result;
    carry held <- contacts;
    bodies <~ world.result from start.result;
    held <~ world.contacts from none.result;
    origin = vec2(-16.0, -1.0);
    columns = 64;
    rows = 64;
    cell = 0.5;
}

// Every pair of the bodies as the first step found them, asked one by one.
node bounds: physics.bounds@1 { bodies <- start.result; }
node every: kernel {
    requires { field.read; field.write; }
    input bounds: Rows<Bounds> <- bounds.result;
    input bodies: Rows<Body> <- start.result;
    output result: Rows<Int>;
    compute over bounds {
        let j = element();
        let bj = sample(bounds);
        return loop j with n = 0 {
            let bi = at(bounds, index());
            let overlap = !(bi.hi.x < bj.lo.x || bj.hi.x < bi.lo.x || bi.hi.y < bj.lo.y || bj.hi.y < bi.lo.y);
            if overlap && meets(at(bodies, index()), at(bodies, j)) { n + 1 } else { n }
        };
    }
    merge(a, b) { return a + b; }
}

// The circles outside the box: below its floor or past its walls.
node out: kernel {
    requires { field.read; field.write; }
    input bodies: Rows<Body> <- world.result;
    output result: Rows<Int>;
    compute over bodies {
        let b = sample(bodies);
        return int(b.shape == 0 && (b.position.y < 0.0 || abs(b.position.x) > 15.0));
    }
    merge(a, b) { return a + b; }
}

output left <- out.result;
