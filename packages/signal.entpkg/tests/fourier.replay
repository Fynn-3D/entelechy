scene fourier.esn

# Half the cube's 512 in wave number 1 and half in its mirror, 7; none
# elsewhere; and the inverse gives the wave back.
frame 0.0
expect spectrum.result[1] = 256 0 0.01
expect spectrum.result[7] = 256 0 0.01
expect spectrum.result[0] = 0 0 0.01
expect spectrum.result[2] = 0 0 0.01
expect real.result[0] = 1 0.0001
expect real.result[2] = 0 0.0001
expect real.result[4] = -1 0.0001
