//! A cube's transform, along z, then y, then x, `1 << bits` a side (at
//! most 256), laid as it came:
//!
//!   node spectrum: graph "signal.entpkg/graphs/fourier_forward.esn" { data <- cube.result; bits = 7; }
use "../kernels/";

input data: Rows<Vec2>;
param bits: Int = 6;

node turns: signal.fourier_turns@1 { bits = bits; domain = 1 << bits; }
node z: signal.fourier_rows@1 { data <- data; turns <- turns.result; bits = bits; sign = -1.0; }
node y: signal.fourier_rows@1 { data <- z.result; turns <- turns.result; bits = bits; sign = -1.0; }
node x: signal.fourier_rows@1 { data <- y.result; turns <- turns.result; bits = bits; sign = -1.0; }

output result <- x.result;
