//! Fast Fourier transforms of a cube of complex numbers, `1 << bits`
//! along each side (at most 256), laid as rows, x fastest: one axis a
//! pass, each a group of lanes running every round of butterflies in
//! place. The inverse divides by the cube's count, so one undoes the
//! other.
package signal@1 { language = 1; ir = 1; }

use "kernels/";
