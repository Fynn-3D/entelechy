//! Fast Fourier transforms of complex numbers in rows `1 << bits` long
//! (at most 256), each row a group of lanes running every round of
//! butterflies in place: rows laid end to end, each transformed alone
//! (blocks of a sound, lines of a picture), or a cube `1 << bits` a
//! side, x fastest, one axis a pass. The inverse divides by the row's
//! length, so one undoes the other.
package signal@1 { language = 1; ir = 1; }

use "kernels/";
