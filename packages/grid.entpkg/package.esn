//! The grid package: ways over a grid of cells, how far each is from a
//! seed by what each costs to enter, relaxed a pass at a time; the step a
//! walk takes toward its seed; the walk drawn as a line with an arrow's
//! head (`kernels/paths.ent`). A project makes the costs and the seed:
//! what stands in the way is its own.
//!
//!   node pass: grid.relax@1 { times = 12; carry previous <- result; previous <- seed.result; cost <- costs.result; }
package grid@1 { language = 1; ir = 1; }

use "kernels/";
