// Pixel effects.

/// Cells of `cell` pixels, each the color at its centre.
kernel pixelfx.pixelate@1 {
    requires { field.read; field.write; }
    input source: Image;
    param cell: Float = 8.0;
    output result: Image;
    compute {
        let centre = floor(coord() / cell) * cell + cell * 0.5;
        return at(source, centre);
    }
}

/// Four colors by brightness, a palette in a table.
kernel pixelfx.palette@1 {
    requires { field.read; field.write; }
    input source: Image;
    output result: Image;
    compute {
        let c = sample(source);
        let shades = [
            vec3(0.06, 0.05, 0.12), vec3(0.55, 0.2, 0.4),
            vec3(0.92, 0.5, 0.2), vec3(1.0, 0.95, 0.7),
        ];
        let luma = dot(c.rgb, vec3(0.299, 0.587, 0.114));
        let k = clamp(int(luma * 4.0), 0, 3);
        return vec4(shades[k], 1.0);
    }
}
