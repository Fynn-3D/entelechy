//! One step of a world of bodies, `dt` long:
//!
//!   node none: physics.no_contacts@1 { domain = 1; }
//!   node world: graph "physics.orlapkg/graphs/step.osn" {
//!       bodies <~ world.result from start.result;
//!       held <~ world.contacts from none.result;
//!   }
//!
//! `result` is the bodies stepped and `contacts` the manifolds that
//! stepped them, whose `touching` says what touches what; a world is
//! given its last step's as `held`, which each step starts from. The grid of
//! `columns` by `rows` cells of side `cell` from `origin` should cover
//! where the bodies are, a cell about the size of a common body; one
//! outside it is entered in the edge cells. `bits` is enough for
//! `columns * rows`. `substeps` are the passes a step takes, more for a
//! pile many bodies deep that lands at once; `hertz` is how stiff a
//! contact is, higher for a deep pile to sink into itself less.
use "../kernels/physics.orla";

input bodies: Rows<Body>;
input held: Rows<Manifold>;
param dt: Float = 0.0166667;
param substeps: Int = 8;
param gravity: Vec2 = vec2(0.0, -10.0);
param damping: Float = 0.0;
param margin: Float = 0.02;
param hertz: Float = 30.0;
param ratio: Float = 10.0;
param speed: Float = 3.0;
param threshold: Float = 1.0;
param origin: Vec2 = vec2(-32.0, -32.0);
param cell: Float = 1.0;
param columns: Int = 64;
param rows: Int = 64;
param bits: Int = 12;

// Each body entered in the cells its box covers, the entries sorted by
// cell, and where each cell's run of them ends.
node bounds: physics.bounds@1 {
    bodies <- bodies;
    dt = dt; margin = margin; origin = origin; cell = cell; columns = columns; rows = rows;
}
node spans: physics.spans@1 { bounds <- bounds.result; }
node span_ends: physics.ends@1 { counts <- spans.result; }
node span_total: physics.total@1 { ends <- span_ends.result; domain = 1; }
node owners: physics.owners@1 { total <- span_total.result; ends <- span_ends.result; domain = value(total); }
node cells: physics.cells@1 {
    owners <- owners.result;
    spans <- spans.result;
    ends <- span_ends.result;
    bounds <- bounds.result;
    columns = columns;
}
node order: graph "../../sort.orlapkg/graphs/sort.osn" { keys <- cells.result; bits = bits; }
node no_cells: physics.no_cells@1 { columns = columns; rows = rows; domain = columns * rows; }
node cell_counts: physics.cell_counts@1 { keys <- cells.result; zeros <- no_cells.result; }
node cell_ends: physics.ends@1 { counts <- cell_counts.result; }
node no_entries: physics.no_entries@1 { order <- order.result; }
node places: physics.places@1 { order <- order.result; zeros <- no_entries.result; }

// The pairs, each taken in the one cell its boxes' overlap begins in, in
// order of their higher body.
node pair_counts: physics.pair_counts@1 {
    bodies <- bodies;
    spans <- spans.result;
    span_ends <- span_ends.result;
    order <- order.result;
    places <- places.result;
    keys <- cells.result;
    owners <- owners.result;
    cell_counts <- cell_counts.result;
    cell_ends <- cell_ends.result;
    bounds <- bounds.result;
    columns = columns;
}
node pair_ends: physics.ends@1 { counts <- pair_counts.result; }
node pair_total: physics.total@1 { ends <- pair_ends.result; domain = 1; }
node no_pairs: physics.no_pairs@1 { total <- pair_total.result; domain = value(total); }
node pairs: physics.pairs@1 {
    bodies <- bodies;
    counts <- pair_counts.result;
    ends <- pair_ends.result;
    spans <- spans.result;
    span_ends <- span_ends.result;
    order <- order.result;
    places <- places.result;
    keys <- cells.result;
    owners <- owners.result;
    cell_counts <- cell_counts.result;
    cell_ends <- cell_ends.result;
    bounds <- bounds.result;
    slots <- no_pairs.result;
    columns = columns;
}

// Each pair's manifold, and how many push each body.
node collide: physics.collide@1 { pairs <- pairs.result; bodies <- bodies; held <- held; dt = dt; margin = margin; }
node no_counts: physics.no_counts@1 { bodies <- bodies; }
node shared: physics.shared@1 { manifolds <- collide.result; zeros <- no_counts.result; domain = 2 * count(manifolds); }
node no_pushes: physics.no_pushes@1 { bodies <- bodies; }

// The first substep warmed with the impulses the manifolds start from;
// each substep warms the next.
node warm: physics.warm@1 { manifolds <- collide.result; bodies <- bodies; shared <- shared.result; }
node warm_pushes: physics.pushes@1 { manifolds <- warm.result; zeros <- no_pushes.result; domain = 2 * count(manifolds); }
node warmed: physics.push@1 { bodies <- bodies; pushes <- warm_pushes.result; }

node sub: graph "substep.osn" {
    times = substeps;
    carry bodies <- moved;
    carry manifolds <- held;
    bodies <- warmed.result;
    manifolds <- collide.result;
    shared <- shared.result;
    zeros <- no_pushes.result;
    dt = dt; substeps = substeps; gravity = gravity; damping = damping;
    hertz = hertz; ratio = ratio; speed = speed;
}

node bounce: physics.bounce@1 { manifolds <- sub.held; bodies <- sub.moved; shared <- shared.result; threshold = threshold; }
node bounce_pushes: physics.pushes@1 { manifolds <- bounce.result; zeros <- no_pushes.result; domain = 2 * count(manifolds); }
node bounced: physics.push@1 { bodies <- sub.moved; pushes <- bounce_pushes.result; }

output result <- bounced.result;
output contacts <- bounce.result;
