scene orbit.esn

# Left alone: where it began, resting from the first frame, the lens its
# pose's.
frame 0.0
expect cam.result[0].target = 0 1 0 0.00001
expect cam.result[0].dist = 8 0.00001
expect cam.result[0].still = 1
expect rests.result[0] = 1
expect same.result[0] < 0.00001
frame 0.1
expect cam.result[0].still = 2

# D held a frame: a step to the right, 0.03 and 0.012 of the distance
# (0.126 meters), and it moves, so it no longer rests.
key 68 down
frame 0.2
expect cam.result[0].target = 0.126 1 0 0.00001
expect rests.result[0] = 0
key 68 up

# R: home again.
key 82 down
frame 0.3
expect cam.result[0].target = 0 1 0 0.00001
key 82 up
