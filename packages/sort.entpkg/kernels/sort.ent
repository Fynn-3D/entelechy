// A permutation that puts a row of integer keys in order.
//
// One pass a bit, least significant first. A pass ranks the elements
// whose bit is zero ahead of the elements whose bit is one and keeps
// the order they were already in, so the passes compose: after the
// last bit the row is sorted, and equal keys are still in the order
// they arrived. Nothing here is a primitive — a rank is
// `prefix with sum` and a placement is a scatter — which is why a sort
// is a package and not an engine feature.
//
// What moves is the permutation, a row of `Int`, never the elements
// themselves: a scene reads its own rows through it.

/// Where every element starts: at its own place. The keys are bound for
/// their extent — a node with no `domain` of its own runs over its first
/// input's — and never read.
kernel sort.identity@1 {
    requires { field.read; field.write; }
    input keys: Rows<Int>;
    output result: Rows<Int>;
    compute { return element(); }
}

/// The row a pass scatters into, as long as the keys.
kernel sort.blank@1 {
    requires { field.read; field.write; }
    input keys: Rows<Int>;
    output result: Rows<Int>;
    compute { return 0; }
}

/// The bit a pass works on. A placement does not know which repetition
/// it is, so the bit rides beside the permutation as a row of one Int.
kernel sort.first_bit@1 {
    requires { field.write; }
    output result: Rows<Int>;
    compute { return 0; }
}

kernel sort.next_bit@1 {
    requires { field.read; field.write; }
    input previous: Rows<Int>;
    output result: Rows<Int>;
    compute { return at(previous, 0) + 1; }
}

/// How many elements with a zero at this bit stand at or before each
/// place. The rank is the whole of what a stable radix pass needs, and
/// an integer sum folds in any grouping, so a device blocks it.
kernel sort.zeros@1 {
    requires { field.read; field.write; }
    input order: Rows<Int>;
    input keys: Rows<Int>;
    input bit: Rows<Int>;
    output result: Rows<Int>;
    prefix with sum {
        let key = at(keys, sample(order));
        return if ((key >>> at(bit, 0)) & 1) == 0 { 1 } else { 0 };
    }
}

/// Every element to its place: a zero at this bit lands at its rank
/// among the zeros, a one behind all of them at its rank among the
/// ones. Each place is written by exactly one element, so the rule is
/// free, and `max` over integers is the one that costs a device a
/// single pass of atomics.
kernel sort.place@1 {
    requires { field.read; field.write; }
    input order: Rows<Int>;
    input keys: Rows<Int>;
    input bit: Rows<Int>;
    input zeros: Rows<Int>;
    input slots: Rows<Int>;
    output result: Rows<Int>;
    struct Placed { slot: Int; index: Int; }
    scatter into slots with max {
        let i = element();
        let index = at(order, i);
        let key = at(keys, index);
        let ahead = at(zeros, i);
        let total = at(zeros, count(zeros) - 1);
        let slot = if ((key >>> at(bit, 0)) & 1) == 0 { ahead - 1 } else { total + (i - ahead) };
        return Placed { slot: slot, index: index };
    }
}
