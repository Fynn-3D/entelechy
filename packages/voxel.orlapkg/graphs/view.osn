//! A volume seen by day at the window's size: voxel `id` the color
//! `colors` holds at `id`, a camera going round the volume's middle, the
//! sun's shadows and haze before the sky. Place it with
//!   node view: graph "../../packages/voxel.orlapkg/graphs/view.osn" {
//!       volume <- world.result;
//!       colors <- palette.result;
//!       yaw = 0.6;
//!   }
//! and read `view.result`. A Kernel that picks what the picture shows
//! asks `voxel_view_camera` and `voxel_view_box` for the same view.
use "../kernels/voxel.orla";

input volume: Voxels;
input colors: Rows<Vec3>;
param yaw: Float = 0.6;
param pitch: Float = 0.45;
param distance: Float = 1.1;
param haze: Float = 0.004;

node look: voxel.view@1 {
    volume <- volume;
    colors <- colors;
    yaw = yaw;
    pitch = pitch;
    distance = distance;
    haze = haze;
    domain = window();
}

output result <- look.result;
