//! Tone mapping as a sub-graph. Place it, by the path `search`
//! gives as its `reach`, with
//!   node display: graph "picture.orlapkg/graphs/display.osn" {
//!       source <- x.result; exposure = 1.2;
//!   }
use "../kernels/tonemap.orla";

input source: Image;
param exposure: Float = 1.0;

node map: image.tonemap@1 {
    source <- source;
    exposure = exposure;
}

output result <- map.result;
