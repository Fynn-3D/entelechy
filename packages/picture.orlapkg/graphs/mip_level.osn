// One halving of a mip strip: the level the counter names is written
// from the level above it, every other texel carried over unchanged.
// `mip.osn` places this `levels` times.
use "../kernels/mip.orla";

input strip: Image;
input step: Rows<Int>;
param side: Int = 256;

node next: mip.next@1 { previous <- step; domain = 1; }
node result: mip.halve@1 { strip <- strip; step <- step; side = side; domain = size(strip); }

output result <- result.result;
output step <- next.result;
