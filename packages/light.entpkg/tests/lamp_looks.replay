scene lamp_looks.esn

# Under the spotlight a pane takes its warm tint and the frame's cross a
# twentieth of the light; under the downlight its photometry: all of it
# straight down, 0.95 at 13 degrees, 0.35 at 33, 0.07 at 44 (the file's
# candela between its angles), of what the bare lamp gives.
frame 0.0
expect 8 24 = 0.287 0.258 0.201 0.005
expect 15 31 = 0.019 0.019 0.019 0.003
expect 47 31 = 0.339 0.339 0.339 0.005
expect 47 36 = 0.299 0.299 0.299 0.005
expect 47 44 = 0.068 0.068 0.068 0.003
expect 47 50 = 0.008 0.008 0.008 0.002

# The looks taken away: the bare lamps.
param looks 0
frame 0.1
expect 15 31 = 0.405 0.405 0.405 0.005
expect 47 36 = 0.314 0.314 0.314 0.005
expect 47 44 = 0.198 0.198 0.198 0.005
expect 47 50 = 0.122 0.122 0.122 0.005
