// Lamps' shadow maps (`graphs/lamp_maps.esn`): a ball half a meter across
// a meter and a half over a ground, a lamp of a small bulb four meters up
// over it, and a second lamp that casts no shadow. What the map says on the
// ground: dark under the ball, its edge where the lamp puts it (0.8 m out:
// the ball's radius times 4 / 2.5), lit past it; and the lamp that casts
// none has no slot. A third lamp, `moved` meters along x, also casts
// shadows, and `bright` makes the second brighter: a slot is drawn again
// only when what it is drawn from changes; `ball_y` moves the ball, which
// both lamps reach.
use "mesh.entpkg";
use "surface.entpkg";
use "raster.entpkg";
use "../kernels/";

param moved: Float = 2.0;
param bright: Float = 1.0;
param ball_y: Float = 1.5;

node ball: mesh.sphere_points@1 { columns = 65; rows = 33; domain = 2145; }
node ball_faces: mesh.lattice_faces@1 { columns = 65; rows = 33; domain = 4096; }
node plane: mesh.plane_points@1 { size = vec2(10.0, 10.0); columns = 17; rows = 17; domain = 289; }
node plane_faces: mesh.lattice_faces@1 { columns = 17; rows = 17; domain = 512; }
node balls: graph "mesh.entpkg/graphs/cluster.esn" { points <- ball.result; faces <- ball_faces.result; }
node ground: graph "mesh.entpkg/graphs/cluster.esn" { points <- plane.result; faces <- plane_faces.result; }
node library: graph "mesh.entpkg/graphs/library.esn" {
    a_points <- balls.points; a_up <- balls.up; a_faces <- balls.faces; a_clusters <- balls.clusters; a_meshes <- balls.meshes; a_errors <- balls.errors; a_sources <- balls.sources;
    b_points <- ground.points; b_up <- ground.up; b_faces <- ground.faces; b_clusters <- ground.clusters; b_meshes <- ground.meshes; b_errors <- ground.errors; b_sources <- ground.sources; }
node insts: kernel {
    requires { field.write; }
    param ball_y: Float = ball_y;
    output result: FieldInsts;
    domain = 2;
    compute {
        return if element() == 0 { FieldInst { at: vec3(0.0, ball_y, 0.0), turn: 0.0, size: 0.5, shape: 0 } } else { FieldInst { at: vec3(0.0, 0.0, 0.0), turn: 0.0, size: 1.0, shape: 1 } };
    }
}
node lamps: kernel {
    requires { field.write; }
    param moved: Float = moved;
    param bright: Float = bright;
    output result: Lamps;
    domain = 3;
    compute {
        let e = element();
        return if e == 0 { point_lamp(vec3(3.0, 3.0, 0.0), 10.0, vec3(1.0, 1.0, 1.0), 0.05, 0) }
            else if e == 1 { point_lamp(vec3(0.0, 4.0, 0.0), 10.0, vec3(1.0, 1.0, 1.0) * bright, 0.02, 1) }
            else { point_lamp(vec3(moved, 3.0, 2.0), 10.0, vec3(1.0, 1.0, 1.0), 0.02, 1) };
    }
}
node maps: graph "../graphs/lamp_maps.esn" { lamps <- lamps.result; points <- library.points; faces <- library.faces; clusters <- library.clusters; meshes <- library.meshes;
    insts <- insts.result; res = 256; level = 0; }
/// The second lamp's light reaching the ground under the ball, half a meter out, 0.7 m, 0.9 m and two meters out; then
/// each lamp's slot.
node seen: kernel {
    requires { field.read; field.write; }
    input maps: Grid<Int> <- maps.maps;
    input lamps: Lamps <- lamps.result;
    output result: Rows<Float>;
    domain = 7;
    compute {
        let e = element();
        if e >= 5 { return float(lamp_map_slot(lamps, maps, e - 5)); }
        let x = if e == 0 { 0.0 } else if e == 1 { 0.5 } else if e == 2 { 0.7 } else if e == 3 { 0.9 } else { 2.0 };
        return lamp_map_seen(maps, lamp_map_slot(lamps, maps, 1), at(lamps, 1), vec3(x, 0.0, 0.3), vec3(0.0, 1.0, 0.0), 0.37);
    }
}

output result <- seen.result;
