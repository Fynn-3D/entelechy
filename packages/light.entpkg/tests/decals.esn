// Decals on a G-buffer (`graphs/decals.esn`): a gray floor ten meters across seen from ten meters straight above, and on
// it a poster on the left (its left half red, its right half blue at half cover, glossy), a gold patch on the right
// laid at half strength (metal, glowing), a patch of bumps in front tilting the floor across, and a decal behind
// standing on its side, which the floor, facing away from it, does not take. `laid` 0 lays none of them; `bare` is
// the floor under no decal.
use "../kernels/";

param laid: Int = 1;

// The looks: the poster in texels 0 to 32 across, 0 to 16 down; the bumps below it, 0 to 16 across.
node atlas: kernel {
    requires { field.write; }
    output result: DecalLooks;
    domain = vec2(32, 32);
    compute {
        let g = coord();
        if g.y < 16.0 { return if g.x < 16.0 { vec4(0.9, 0.1, 0.1, 1.0) } else { vec4(0.1, 0.1, 0.9, 0.5) }; }
        return vec4(0.8, 0.5, 0.0, 1.0);
    }
}
node decals: kernel {
    requires { field.write; }
    param laid: Int = laid;
    output result: Decals;
    domain = 4;
    compute {
        let e = element();
        let up = vec3(0.0, 1.0, 0.0);
        let x = vec3(1.0, 0.0, 0.0);
        let d = if e == 0 { Decal { ..decal_with_look(decal(vec3(-2.0, 0.0, 0.0), up, x, 3.0, 2.0, 1.0, vec3(1.0, 1.0, 1.0)), vec2(0.0, 0.0), vec2(32.0, 16.0)), rough: 0.2 } }
            else if e == 1 { Decal { ..decal(vec3(2.0, 0.0, 0.0), up, x, 2.0, 2.0, 1.0, vec3(1.0, 0.8, 0.2)), metal: 1.0, glow: 3.0, strength: 0.5 } }
            else if e == 2 { decal_with_bumps(decal(vec3(0.0, 0.0, 2.5), up, x, 2.0, 2.0, 1.0, vec3(0.5, 0.5, 0.5)), vec2(0.0, 16.0), vec2(16.0, 32.0)) }
            else { decal(vec3(0.0, 0.0, -2.5), x, vec3(0.0, 0.0, 1.0), 2.0, 2.0, 1.0, vec3(0.0, 1.0, 0.0)) };
        return Decal { ..d, strength: d.strength * float(laid) };
    }
}
node lens: kernel {
    requires { field.write; }
    output result: Lenses;
    domain = 1;
    compute { return Lens { eye: vec3(0.0, 10.0, 0.0), ahead: vec3(0.0, -1.0, 0.0), right: vec3(1.0, 0.0, 0.0), up: vec3(0.0, 0.0, -1.0), focal: 1.0 }; }
}
node surface: kernel {
    requires { field.read; field.write; }
    input lens: Lenses <- lens.result;
    output result: Grid<Vec4>;
    domain = vec2(64, 64);
    compute { let l = at(lens, 0); return vec4(0.0, 1.0, 0.0, 10.0 / max(0.0 - ray(l, coord(), domain()).y, 0.001)); }
}
node paint: Grid<Vec4> { domain = vec2(64, 64); value = vec4(0.5, 0.5, 0.5, 0.8); }
node extra: Grid<Vec4> { domain = vec2(64, 64); value = vec4(1.0, 0.0, 0.0, 0.0); }
node laid: graph "../graphs/decals.esn" { surface <- surface.result; paint <- paint.result; extra <- extra.result; lens <- lens.result; decals <- decals.result;
    decal_looks <- atlas.result; }
// The same G-buffer under no decal at all.
node no_decals: light.decals_none@1 { domain = 1; }
node no_looks: light.decal_looks_none@1 { domain = vec2(1, 1); }
node bare: graph "../graphs/decals.esn" { surface <- surface.result; paint <- paint.result; extra <- extra.result; lens <- lens.result; decals <- no_decals.result;
    decal_looks <- no_looks.result; }

output result <- laid.paint;
