// A fine level of the proxy round the lens (`graphs/proxy_detail.esn`): the ball of `proxy_bake.esn` (a meter round)
// baked coarse (about ten centimeters a cell) over a block three meters a side, and again three centimeters a cell over
// a block a meter a side round the eye, which stands `eye` meters along x looking back at the ball. `probe` reads the
// stacked proxy and the coarse one five centimeters off the ball on the x axis (a corner of the mesh, where it meets the
// round ball), and half a meter past the fine block's far side (beyond it: the coarse level).
use "mesh.entpkg";
use "geometry.entpkg";
use "raster.entpkg";
use "../kernels/";

param eye: Float = 1.2;

node sphere: mesh.sphere_points@1 { columns = 33; rows = 17; domain = 561; }
node ball_faces: mesh.lattice_faces@1 { columns = 33; rows = 17; domain = 1024; }
node colors: kernel {
    requires { field.read; field.write; }
    input faces: Rows<Face> <- ball_faces.result;
    output result: Rows<Vec4>;
    compute { return vec4(0.5, 0.5, 0.5, 0.0); }
}
node frame: kernel {
    requires { field.write; }
    output result: Proxies;
    domain = 1;
    compute { return Proxy { lo: vec3(-1.5, -1.5, -1.5), cell: 3.0 / 32.0, cells: vec3(32.0, 32.0, 32.0), land_lo: vec2(-100.0, -100.0), land_cell: 200.0, ground: vec3(0.3, 0.3, 0.3) }; }
}
node lens: kernel {
    requires { field.write; }
    param eye: Float = eye;
    output result: Lenses;
    domain = 1;
    compute { return Lens { eye: vec3(eye, 0.0, 0.0), ahead: vec3(-1.0, 0.0, 0.0), right: vec3(0.0, 0.0, -1.0), up: vec3(0.0, 1.0, 0.0), focal: 1.0 }; }
}
node coarse: graph "../graphs/proxy_bake.esn" { points <- sphere.result; faces <- ball_faces.result; colors <- colors.result; frame <- frame.result; nx = 32; ny = 32; nz = 32; }
node detail: graph "../graphs/proxy_detail.esn" { points <- sphere.result; faces <- ball_faces.result; colors <- colors.result; lens <- lens.result; proxy <- coarse.proxy;
    frame <- frame.result; nx = 32; ny = 32; nz = 32; cell = 0.03; }
node probe: kernel {
    requires { field.read; field.write; }
    input stacked: Volume<Vec4> <- detail.proxy;
    input frames: Proxies <- detail.frame;
    input coarse: Volume<Vec4> <- coarse.proxy;
    input frame: Proxies <- frame.result;
    output result: Rows<Float>;
    domain = 4;
    compute {
        let e = element();
        let p = if e < 2 { vec3(1.05, 0.0, 0.0) } else { vec3(-0.5, 0.0, 0.0) };
        return if e % 2 == 0 { proxy_at(stacked, frames, p, 1000.0).x } else { proxy_at(coarse, frame, p, 1000.0).x };
    }
}

output result <- probe.result;
