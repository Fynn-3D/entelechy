// Translucent layers over a picture (`graphs/translucent.esn`): a grey wall
// `wall` meters off (a picture of 0.5 at the middle, its red rising to the
// right, and its G-buffer's distances), and before it a red-tinted pane two
// meters off, a blue-tinted pane three meters off over the middle too, a
// glow on the left and smoke on the right. `swap` lists the two panes'
// faces the other way round, which must change nothing: the layers are
// summed in no order. `bend` makes the near pane thick. No bounce (one
// empty cell), a dim sky.
use "mesh.entpkg";
use "raster.entpkg";
use "../kernels/";

param wall: Float = 10.0;
param swap: Int = 0;
param bend: Float = 0.0;

/// Four quads, four corners each: the near pane, the far pane, the glow, the smoke (the panes' faces first or second as
/// `swap` says).
node quads: kernel {
    requires { field.write; }
    param swap: Int = swap;
    output result: Rows<MeshPoint>;
    domain = 16;
    compute {
        let e = element();
        let listed = e / 4;
        let quad = if swap == 1 && listed < 2 { 1 - listed } else { listed };
        let k = e % 4;
        let x = if k == 0 || k == 3 { -0.5 } else { 0.5 };
        let y = if k < 2 { -0.5 } else { 0.5 };
        let at = if quad == 0 { vec3(x, y, -2.0) } else if quad == 1 { vec3(x * 1.5, y * 1.5, -3.0) }
            else if quad == 2 { vec3(x * 0.3 - 0.9, y * 0.3, -2.5) } else { vec3(x * 0.3 + 0.9, y * 0.3, -2.5) };
        let n = if quad == 0 { normalize(vec3(0.3, 0.0, 1.0)) } else { vec3(0.0, 0.0, 1.0) };
        return MeshPoint { position: at, normal: n, uv: vec2(x, y) + 0.5 };
    }
}
node quad_faces: kernel {
    requires { field.write; }
    output result: Rows<Face>;
    domain = 8;
    compute {
        let b = (element() / 2) * 4;
        return if element() % 2 == 0 { Face { a: b, b: b + 1, c: b + 2 } } else { Face { a: b, b: b + 2, c: b + 3 } };
    }
}
node face_looks: kernel {
    requires { field.write; }
    param swap: Int = swap;
    output result: Rows<Int>;
    domain = 8;
    compute { let listed = element() / 2; return if swap == 1 && listed < 2 { 1 - listed } else { listed }; }
}
node looks: kernel {
    requires { field.write; }
    param bend: Float = bend;
    output result: TranslucentLooks;
    domain = 4;
    compute {
        let e = element();
        return if e == 0 { TranslucentLook { kind: translucent_glass(), color: vec3(1.0, 0.5, 0.5), cover: 1.0, rough: 0.02, glow: 0.0, bend: bend } }
            else if e == 1 { TranslucentLook { kind: translucent_glass(), color: vec3(0.5, 0.5, 1.0), cover: 1.0, rough: 0.02, glow: 0.0, bend: 0.0 } }
            else if e == 2 { TranslucentLook { kind: translucent_glow(), color: vec3(1.0, 0.6, 0.2), cover: 1.0, rough: 0.0, glow: 0.5, bend: 0.0 } }
            else { TranslucentLook { kind: translucent_smoke(), color: vec3(0.8, 0.8, 0.8), cover: 0.5, rough: 0.0, glow: 0.0, bend: 0.0 } };
    }
}
node lens: kernel {
    requires { field.write; }
    output result: Lenses;
    domain = 1;
    compute { return Lens { eye: vec3(0.0, 0.0, 0.0), ahead: vec3(0.0, 0.0, -1.0), right: vec3(1.0, 0.0, 0.0), up: vec3(0.0, 1.0, 0.0), focal: 1.0 }; }
}
node sky: kernel {
    requires { field.write; }
    output result: SkyLooks;
    domain = 1;
    compute {
        return SkyLook { sun: normalize(vec3(0.0, 1.0, 0.2)), sun_color: vec3(1.0, 1.0, 1.0), ambient: vec3(0.2, 0.2, 0.2), horizon: vec3(0.3, 0.3, 0.3),
            zenith: vec3(0.2, 0.2, 0.3), clouds: 0.0, far_land: 0.0, far_color: vec3(0.5, 0.5, 0.5), air: 0.0, air_from: 0.0 };
    }
}
node canvas: Grid<Long> { domain = vec2(64, 64); value = 9223372036854775807l; }
node picture: kernel {
    requires { field.write; }
    output result: Image;
    domain = vec2(64, 64);
    compute { return vec4(0.5 + (coord().x - 32.0) / 64.0, 0.5, 0.5, 1.0); }
}
node surface: kernel {
    requires { field.read; field.write; }
    input lens: Lenses <- lens.result;
    param wall: Float = wall;
    output result: Grid<Vec4>;
    domain = vec2(64, 64);
    compute { let l = at(lens, 0); return vec4(0.0, 0.0, 1.0, wall / max(dot(ray(l, coord(), domain()), l.ahead), 0.001)); }
}
node frame: kernel {
    requires { field.write; }
    output result: Proxies;
    domain = 1;
    compute { return Proxy { lo: vec3(-1.0, -1.0, -1.0), cell: 2.0, cells: vec3(1.0, 1.0, 1.0), land_lo: vec2(-100.0, -100.0), land_cell: 200.0, ground: vec3(0.3, 0.3, 0.3) }; }
}
node empty: Volume<Vec4> { domain = vec3(1, 1, 1); value = vec4(1000.0, 0.0, 0.0, 0.0); }
node no_light: Volume<Vec4> { domain = vec3(1, 1, 1); }
node land: Grid<Float> { domain = vec2(2, 2); value = -50.0; }
node no_lamps: light.lamps_none@1 { domain = 1; }
node no_lamp_looks: light.lamp_looks_none@1 { domain = vec2(1, 1); }
node laid: graph "../graphs/translucent.esn" { points <- quads.result; faces <- quad_faces.result; face_looks <- face_looks.result; looks <- looks.result; hdr <- picture.result;
    surface <- surface.result; lens <- lens.result; sky <- sky.result; canvas <- canvas.result; cache <- no_light.result; cache_frame <- frame.result; proxy <- empty.result;
    land <- land.result; frame <- frame.result; lamps <- no_lamps.result; lamp_looks <- no_lamp_looks.result; smudge = 0.0; }

output result <- laid.hdr;
