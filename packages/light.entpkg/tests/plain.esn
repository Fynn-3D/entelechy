// Light as a game without a renderer draws it, at points whose answers are known by hand: the sky and the sun on a
// face turned up and on one shaded side; a light two meters off a face turned to it, half way to its reach; light kept
// to three steps; haze none near and all far; the dark a depth away; a thin thing lit by a sun overhead, looking down
// and looking into the sun.
use "../kernels/";

node probe: kernel {
    requires { field.write; }
    output result: Rows<Vec4>;
    domain = 4;
    compute {
        let k = element();
        let s = plain_sky(vec3(0.0, 1.0, 0.0), vec3(1.0, 1.0, 1.0), vec3(0.2, 0.2, 0.2));
        return if k == 0 { vec4(plain_daylight(vec3(0.0, 1.0, 0.0), vec3(0.0, 1.0, 0.0), false, vec3(0.5, 0.5, 0.5), vec3(1.0, 1.0, 1.0)).x,
                plain_daylight(vec3(1.0, 0.0, 0.0), vec3(1.0, 0.0, 0.0), true, vec3(0.5, 0.5, 0.5), vec3(1.0, 1.0, 1.0)).x,
                plain_light(vec3(2.0, 0.0, 0.0), vec3(-1.0, 0.0, 0.0), PlainLight { at: vec3(0.0, 0.0, 0.0), reach: 4.0, color: vec3(1.0, 1.0, 1.0) }).x,
                light_stepped(vec3(0.33, 0.33, 0.33), 3.0).x) }
            else if k == 1 { vec4(plain_haze(vec3(1.0, 1.0, 1.0), 0.0, 0.5, vec3(0.0, 0.0, 0.0)).x, plain_haze(vec3(1.0, 1.0, 1.0), 1000.0, 0.5, vec3(0.0, 0.0, 0.0)).x,
                plain_dark(vec3(1.0, 1.0, 1.0), 14.0, 14.0).x, flame_flicker(0.0, vec3(0.0, 0.0, 0.0))) }
            else if k == 2 { vec4(thin_lit(vec3(1.0, 1.0, 1.0), vec3(0.0, -1.0, 0.0), s), 0.0) }
            else { vec4(thin_lit(vec3(1.0, 1.0, 1.0), vec3(0.0, 1.0, 0.0), s), 0.0) };
    }
}

output result <- probe.result;
