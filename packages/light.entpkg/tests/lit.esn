use "geometry.entpkg";
use "camera.entpkg";
// The stand by the light renderers and through every step of a finish:
// contact shadows laid into the sun's visibility; lit as it is and as a
// painting has it, and half way between them; clay; haze, ink and a
// watercolor's tone; lit deep inside the
// coarse shape; ray traced, and over a polished floor; the extent a
// renderer draws at; a film's look; depth of field focused on the middle;
// and the stand's G-buffer merged with itself, nearer surface by surface.
node stand: graph "stand_scene.esn" { }
node shadowed: light.contact@1 { surface <- stand.surface; extra <- stand.extra; layers <- stand.layers; lens <- stand.lens; sky <- stand.sky; domain = size(surface); }
node lit_painting: light.painting_start@1 { domain = 1; }
node lit: light.lit@1 { painting <- lit_painting.result; surface <- stand.surface; paint <- stand.paint; extra <- shadowed.result; layers <- stand.layers; more <- stand.more;
    sky <- stand.sky; lens <- stand.lens; proxy <- stand.proxy; frame <- stand.frame; domain = window(); }
node painted_painting: light.painting_start@1 { amount = 1.0; domain = 1; }
node painted: light.lit@1 { painting <- painted_painting.result; surface <- stand.surface; paint <- stand.paint; extra <- shadowed.result; layers <- stand.layers; more <- stand.more;
    sky <- stand.sky; lens <- stand.lens; proxy <- stand.proxy; frame <- stand.frame; domain = window(); }
node half_painting: light.painting_start@1 { amount = 0.5; domain = 1; }
node half: light.lit@1 { painting <- half_painting.result; surface <- stand.surface; paint <- stand.paint; extra <- shadowed.result; layers <- stand.layers; more <- stand.more;
    sky <- stand.sky; lens <- stand.lens; proxy <- stand.proxy; frame <- stand.frame; domain = window(); }
/// How far the half painted picture lies from the mean of the two, its most over every pixel (none: the look blends).
node between: kernel {
    requires { field.read; field.write; }
    input a: Image <- lit.result;
    input b: Image <- painted.result;
    input h: Image <- half.result;
    output result: Rows<Float>;
    domain = 1;
    compute {
        let n = size(a);
        return loop int(n.x * n.y) with most = 0.0 {
            let q = vec2(float(index() % int(n.x)), float(index() / int(n.x)));
            let d = at(h, q).xyz - (at(a, q).xyz + at(b, q).xyz) * 0.5;
            max(most, max(abs(d.x), max(abs(d.y), abs(d.z))))
        };
    }
}
node clay: graph "../graphs/clay.esn" { lens <- stand.lens; surface <- stand.surface; paint <- stand.paint; extra <- stand.extra; }
// Lit with every point deep inside the coarse shape (as a leaf in its
// crown): the light all round kept by `inside_sky` and the baked occlusion.
node deep: kernel {
    requires { field.read; field.write; }
    input proxy: Volume<Vec4> <- stand.proxy;
    output result: Volume<Vec4>;
    domain = size(proxy);
    compute { let p = sample(proxy); return vec4(p.x - 100.0, p.y, p.z, p.w); }
}
node lit_deep: light.lit@1 { painting <- lit_painting.result; surface <- stand.surface; paint <- stand.paint; extra <- shadowed.result; layers <- stand.layers; more <- stand.more;
    sky <- stand.sky; lens <- stand.lens; proxy <- deep.result; frame <- stand.frame; domain = window(); }
node lit_dark: light.lit@1 { painting <- lit_painting.result; surface <- stand.surface; paint <- stand.paint; extra <- shadowed.result; layers <- stand.layers; more <- stand.more;
    sky <- stand.sky; lens <- stand.lens; proxy <- deep.result; frame <- stand.frame; inside_sky = 0.0; domain = window(); }
// Ray traced: the G-buffer's shadow, each thing's own occlusion, smooth
// surfaces' mirror rays traced through the proxies.
node traced: light.raytraced@1 { surface <- stand.surface; paint <- stand.paint; extra <- shadowed.result; layers <- stand.layers; more <- stand.more;
    sky <- stand.sky; lens <- stand.lens; proxy <- stand.proxy; land <- stand.land; frame <- stand.frame; domain = window(); }
// The floor polished: ray traced, its mirror rays leave it clear of the
// ground before they count what they meet.
node polished: kernel {
    requires { field.read; field.write; }
    input paint: Grid<Vec4> <- stand.paint;
    input surface: Grid<Vec4> <- stand.surface;
    output result: Grid<Vec4>;
    domain = size(paint);
    compute { let c = sample(paint); return if sample(surface).y > 0.9 { vec4(c.x, c.y, c.z, 0.05) } else { c }; }
}
node traced_floor: light.raytraced@1 { surface <- stand.surface; paint <- polished.result; extra <- shadowed.result; layers <- stand.layers; more <- stand.more;
    sky <- stand.sky; lens <- stand.lens; proxy <- stand.proxy; land <- stand.land; frame <- stand.frame; domain = window(); }
// A scene's own look: lit with half the sky's light, painted with its
// shade untinted, ray traced with its mirrors held lower.
node lit_tuned: light.lit@1 { painting <- lit_painting.result; surface <- stand.surface; paint <- stand.paint; extra <- shadowed.result; layers <- stand.layers; more <- stand.more;
    sky <- stand.sky; lens <- stand.lens; proxy <- stand.proxy; frame <- stand.frame; sky_light = 0.5; domain = window(); }
node painted_tuned_painting: light.painting_start@1 { amount = 1.0; toon_shade = vec3(1.0, 1.0, 1.0); domain = 1; }
node painted_tuned: light.lit@1 { painting <- painted_tuned_painting.result; surface <- stand.surface; paint <- stand.paint; extra <- shadowed.result; layers <- stand.layers; more <- stand.more;
    sky <- stand.sky; lens <- stand.lens; proxy <- stand.proxy; frame <- stand.frame; domain = window(); }
node traced_tuned: light.raytraced@1 { surface <- stand.surface; paint <- stand.paint; extra <- shadowed.result; layers <- stand.layers; more <- stand.more;
    sky <- stand.sky; lens <- stand.lens; proxy <- stand.proxy; land <- stand.land; frame <- stand.frame; mirror_most = 0.1; domain = window(); }
node aired_air: light.haze_start@1 { domain = 1; }
node aired: light.haze@1 { air <- aired_air.result; hdr <- lit.result; surface <- stand.surface; lens <- stand.lens; sky <- stand.sky; on = 1; }
// A painted look composed: the painted shading, its ink (near sides of edges, no creases), a watercolor's tone.
node lines: surface.outline@1 { image <- painted.result; surface <- stand.surface; crease = 0.0; }
node inked_look: image.watercolor_start@1 { domain = 1; }
node inked: image.watercolor@1 { look <- inked_look.result; image <- lines.result; }

// The extent a renderer draws at, by dynamic resolution.
node dynamic0: camera.dynamic_start@1 { domain = 1; }
node dynamic: camera.dynamic@1 { previous <~ dynamic.result from dynamic0.result; domain = 1; }
node extent: camera.extent@1 { dynamic <- dynamic.result; domain = 2; }
node size: camera.extent_size@1 { extent <- extent.result; domain = 1; }
node canvas: camera.canvas@1 { extent <- extent.result; domain = vec2(value(extent, 0), value(extent, 1)); }

node seen: graph "image.entpkg/graphs/tonemap.esn" { hdr <- aired.result; exposure = 0.8; sharpen = 0.5; }
// The same finish by the other tone curves: the light clipped past 1 (Blender's Standard view), and AgX.
node clipped: graph "image.entpkg/graphs/tonemap.esn" { hdr <- aired.result; exposure = 0.8; glow = 0.0; vignette = 0.0; warmth = 0.0; curve = 1; }
node filmic: graph "image.entpkg/graphs/tonemap.esn" { hdr <- aired.result; exposure = 0.8; glow = 0.0; vignette = 0.0; warmth = 0.0; curve = 2; }
node cinema: image.film_start@1 { preset = 1; domain = 1; }
node filmed: image.film@1 { image <- seen.result; film <- cinema.result; }
node dof: camera.dof_start@1 { aperture = 6.0; domain = 1; }
node focus0: Rows<Float> { domain = 1; value = 8.0; }
node focus: camera.focus@1 { previous <~ focus.result from focus0.result; surface <- stand.surface; control <- dof.result; domain = 1; }
node focused: camera.focused@1 { image <- filmed.result; surface <- stand.surface; focus <- focus.result; control <- dof.result; }

node fit: Rows<Float> { domain = 1; value = 1.0; }
node merged: surface.nearer@1 { a_surface <- stand.surface; a_paint <- stand.paint; a_extra <- stand.extra; a_layers <- stand.layers; a_more <- stand.more;
    a_behind_at <- stand.behind_at; a_behind_dir <- stand.behind_dir; a_behind_paint <- stand.behind_paint; a_behind_normal <- stand.behind_normal; a_through <- stand.through;
    b_surface <- stand.surface; b_paint <- stand.paint; b_extra <- stand.extra; b_layers <- stand.layers; b_more <- stand.more; fit <- fit.result; domain = size(a_surface); }
node nothing: image.blank@1 { domain = vec2(4, 4); }
// No cascades of the sun's shadow: one that holds nothing (the fog falls back to the proxies).
node no_sun: light.sun_none@1 { domain = 1; }

output result <- focused.result;
