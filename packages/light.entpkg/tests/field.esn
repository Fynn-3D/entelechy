// Instanced distance fields: two shapes, a ball and a box, each sixteen
// cells a side, packed into the atlas; three things placed (a ball, a box
// twice its size turned a half, and one in no shape), and the block round
// a lens baked from them in three levels; two atlases joined into one.
use "../kernels/";
use "geometry.entpkg";

node ball: kernel {
    requires { field.write; }
    output result: Volume<Vec4>;
    domain = vec3(16, 16, 16);
    compute {
        let p = vec3(-1.0, 0.0, -1.0) + coord() * (2.0 / 15.0);
        return vec4(length(p - vec3(0.0, 0.8, 0.0)) - 0.8, 0.8, 0.2, 0.1);
    }
}
node box: kernel {
    requires { field.write; }
    output result: Volume<Vec4>;
    domain = vec3(16, 16, 16);
    compute {
        let p = vec3(-1.0, 0.0, -1.0) + coord() * (2.0 / 15.0);
        let d = abs(p - vec3(0.0, 0.5, 0.0)) - vec3(0.5, 0.5, 0.25);
        return vec4(length(max(d, vec3(0.0, 0.0, 0.0))) + min(max(d.x, max(d.y, d.z)), 0.0), 0.1, 0.3, 0.8);
    }
}
node frame16: kernel {
    requires { field.write; }
    output result: Proxies;
    domain = 1;
    compute { return Proxy { lo: vec3(-1.0, 0.0, -1.0), cell: 2.0 / 15.0, cells: vec3(16.0, 16.0, 16.0), land_lo: vec2(0.0, 0.0), land_cell: 1.0, ground: vec3(0.3, 0.3, 0.3) }; }
}
node atlas: light.field_atlas8@1 { v0 <- ball.result; v1 <- box.result; v2 <- ball.result; v3 <- ball.result; v4 <- ball.result; v5 <- ball.result; v6 <- ball.result; v7 <- ball.result;
    domain = size(v0) * vec3(1.0, 1.0, 8.0); }
node shapes: light.field_shapes8@1 { f0 <- frame16.result; f1 <- frame16.result; f2 <- frame16.result; f3 <- frame16.result; f4 <- frame16.result; f5 <- frame16.result; f6 <- frame16.result; f7 <- frame16.result; domain = 8; }
// More than eight shapes: two atlases and their tables joined.
node joined: light.field_stack@1 { a <- atlas.result; b <- atlas.result; domain = size(a) + size(b) * vec3(0.0, 0.0, 1.0); }
node joined_shapes: light.field_frames_join@1 { a <- shapes.result; b <- shapes.result; domain = count(a) + count(b); }
node insts: kernel {
    requires { field.write; }
    output result: FieldInsts;
    domain = 3;
    compute {
        return [FieldInst { at: vec3(2.0, 0.0, 2.0), turn: 0.0, size: 1.0, shape: 0 },
            FieldInst { at: vec3(5.0, 0.0, 3.0), turn: 0.5, size: 2.0, shape: 1 },
            FieldInst { at: vec3(6.0, 0.0, 0.0), turn: 0.0, size: 1.0, shape: -1 }][element()];
    }
}
node lens: kernel {
    requires { field.write; }
    output result: Lenses;
    domain = 1;
    compute { return Lens { eye: vec3(4.0, 1.0, 0.0), ahead: vec3(0.0, 0.0, 1.0), right: vec3(1.0, 0.0, 0.0), up: vec3(0.0, 1.0, 0.0), focal: 1.0 }; }
}
node base: kernel {
    requires { field.write; }
    output result: Proxies;
    domain = 1;
    compute { return Proxy { lo: vec3(-50.0, 0.0, -50.0), cell: 1.0, cells: vec3(4.0, 4.0, 4.0), land_lo: vec2(-50.0, -50.0), land_cell: 100.0, ground: vec3(0.3, 0.3, 0.3) }; }
}
node field: graph "../graphs/field.esn" { atlas <- atlas.result; shapes <- shapes.result; insts <- insts.result; lens <- lens.result; base <- base.result;
    nx = 32; ny = 8; nz = 32; cell = 0.25; bins = 4; band = 8.0; }

// Looked up as a renderer does (`proxy_at`): the ball's middle in the finest
// level, and past it, by the box, in the next.
node looked: kernel {
    requires { field.read; field.write; }
    input proxy: Volume<Vec4> <- field.proxy;
    input frame: Proxies <- field.frame;
    output result: Rows<Vec2>;
    domain = 2;
    compute {
        let p = if element() == 0 { vec3(2.0, 0.8, 2.0) } else { vec3(12.0, 0.5, 3.0) };
        return vec2(proxy_at(proxy, frame, p, 99.0).x, proxy_level(frame, p).x);
    }
}

output result <- field.proxy;
