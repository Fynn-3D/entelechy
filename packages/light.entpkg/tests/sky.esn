// The stand under the sky the air makes, the sun low in the afternoon, its
// shadows from cascaded shadow maps as well as the stand's own: the
// light scattered more than once, the look a renderer lights by, the sky
// round the eye as a table, lit lighting the stand by it
// (the light under its wax ball spread), and the sky's pixels painted from
// the table, with the sun's disc;
// metered and toned.
use "../kernels/";
use "image.entpkg";

node stand: graph "stand_scene.esn" { }
node air: graph "../graphs/atmosphere.esn" { elevation = 0.25; bearing = 2.6; air = 0.004; air_from = 30.0; }
// The sun's shadows from two cascades drawn down the sunlight, laid over
// the stand's own (the same shadows, softened as far as the sun's disc makes them).
node sun_views: light.sun_views@1 { lens <- stand.lens; sky <- air.sky; nearest = 8.0; spread = 4.0; reach = 20.0; size = 256.0; domain = 2; }
node sun_depth: stand.sun_depth@1 { views <- sun_views.result; size = 256.0; domain = vec2(512, 256); }
node sunlit: light.sun_shadow@1 { extra <- stand.extra; surface <- stand.surface; lens <- stand.lens; views <- sun_views.result; atlas <- sun_depth.result; domain = size(extra); }
node lit_painting: light.painting_start@1 { domain = 1; }
node lit: light.lit@1 { painting <- lit_painting.result; surface <- stand.surface; paint <- stand.paint; extra <- sunlit.result; layers <- stand.layers; more <- stand.more;
    sky <- air.sky; lens <- stand.lens; proxy <- stand.proxy; frame <- stand.frame; domain = size(surface); }
node skin: graph "../graphs/subsurface.esn" { hdr <- lit.result; scatter <- lit.scatter; surface <- stand.surface; layers <- stand.layers; lens <- stand.lens; reach = 0.08; }
node skied: light.atmosphere_sky@1 { hdr <- skin.hdr; surface <- stand.surface; lens <- stand.lens; sky <- air.sky; view <- air.view; domain = size(hdr); }
node exposed: graph "image.entpkg/graphs/exposure.esn" { hdr <- skied.result; highlights = 0.7; shadows = 0.9; }
node glow: graph "image.entpkg/graphs/bloom.esn" { hdr <- exposed.hdr; }
node view: image.tonemap@3 { hdr <- exposed.hdr; bloom <- glow.bloom; exposure = 1.0; domain = window(); }
// How much of the light the air lets through: all before the air begins, and a whole e-fold one air length past it.
node kept: kernel {
    requires { field.read; field.write; }
    input s: SkyLooks <- air.sky;
    output result: Rows<Float>;
    domain = 2;
    compute { let k = at(s, 0); return air_kept(if element() == 0 { 10.0 } else { k.air_from + 1.0 / k.air }, k); }
}

output result <- view.result;
