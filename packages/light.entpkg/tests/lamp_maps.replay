scene lamp_maps.esn

# Under the ball dark, to the edge of its shadow (0.8 m out, the points 0.3
# m off the axis: 0.58, 0.76 and 0.95 m from it), lit past it; the lamp
# that casts no shadow has no slot, the other the first.
frame 0.0
expect seen.result[0] = 0 0.02
expect seen.result[1] = 0 0.02
expect seen.result[2] = 0 0.2
expect seen.result[3] = 1 0.02
expect seen.result[4] = 1 0.02
expect seen.result[5] = -1
expect seen.result[6] = 0
expect maps.tile_runs.entries.result[0] > 12000

# Nothing changed: no slot is drawn again.
frame 0.1
expect maps.dirty.result[0] = 0
expect maps.dirty.result[1] = 0

# The third lamp moved: its cube alone is drawn again (about half the
# tiles), and the second lamp's shadow is as it was.
param moved 1.0
frame 0.2
expect maps.dirty.result[0] = 0
expect maps.dirty.result[1] = 1
expect maps.tile_runs.entries.result[0] < 8000
expect seen.result[0] = 0 0.02
expect seen.result[3] = 1 0.02

# The second lamp brighter: its shadow does not change, nothing is drawn.
param bright 2.0
frame 0.3
expect maps.dirty.result[0] = 0
expect maps.dirty.result[1] = 0
expect seen.result[1] = 0 0.02

# The ball lower: both lamps reach it, both cubes are drawn again.
param ball_y 1.4
frame 0.4
expect maps.dirty.result[0] = 1
expect maps.dirty.result[1] = 1
expect maps.tile_runs.entries.result[0] > 12000
