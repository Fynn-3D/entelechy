// The sun's shadow as a virtual shadow map (`graphs/shadow.esn`): a ground
// of 40 meters and three balls on it, each a clustered mesh, seen from a
// lens looking down that `shift` moves; what is drawn of the map each frame, and the
// sun's visibility on the ground in a ball's shadow and beside it.
use "mesh.entpkg";
use "surface.entpkg";
use "geometry.entpkg";
use "raster.entpkg";
use "../kernels/";

param shift: Float = 0.0;

node ball: mesh.sphere_points@1 { columns = 65; rows = 33; domain = 2145; }
node ball_faces: mesh.lattice_faces@1 { columns = 65; rows = 33; domain = 4096; }
node plane: mesh.plane_points@1 { size = vec2(40.0, 40.0); columns = 65; rows = 65; domain = 4225; }
node plane_faces: mesh.lattice_faces@1 { columns = 65; rows = 65; domain = 8192; }
node balls: graph "mesh.entpkg/graphs/cluster.esn" { points <- ball.result; faces <- ball_faces.result; }
node ground: graph "mesh.entpkg/graphs/cluster.esn" { points <- plane.result; faces <- plane_faces.result; }
node library: graph "mesh.entpkg/graphs/library.esn" {
    a_points <- balls.points; a_up <- balls.up; a_faces <- balls.faces; a_clusters <- balls.clusters; a_meshes <- balls.meshes; a_errors <- balls.errors; a_sources <- balls.sources;
    b_points <- ground.points; b_up <- ground.up; b_faces <- ground.faces; b_clusters <- ground.clusters; b_meshes <- ground.meshes; b_errors <- ground.errors; b_sources <- ground.sources; }
node insts: kernel {
    requires { field.write; }
    output result: FieldInsts;
    domain = 4;
    compute {
        let i = element();
        return if i == 3 { FieldInst { at: vec3(0.0, 0.0, 0.0), turn: 0.0, size: 1.0, shape: 1 } }
            else { FieldInst { at: vec3(float(i) * 4.0 - 4.0, 1.0, -2.0 * float(i)), turn: 0.0, size: 1.0, shape: 0 } };
    }
}
node sky: kernel {
    requires { field.write; }
    output result: SkyLooks;
    domain = 1;
    compute {
        return SkyLook { sun: normalize(vec3(0.5, 0.6, 0.3)), sun_color: vec3(3.0, 3.0, 3.0), ambient: vec3(0.3, 0.35, 0.4), horizon: vec3(0.6, 0.65, 0.7),
            zenith: vec3(0.3, 0.4, 0.6), clouds: 0.0, far_land: 0.0, far_color: vec3(0.5, 0.5, 0.5), air: 0.0, air_from: 0.0 };
    }
}
node lens: kernel {
    requires { field.write; }
    param shift: Float = shift;
    output result: Lenses;
    domain = 1;
    compute {
        let ahead = normalize(vec3(0.0, -1.0, -0.45));
        let right = vec3(1.0, 0.0, 0.0);
        return Lens { eye: vec3(shift, 12.0, 4.0), ahead: ahead, right: right, up: cross(right, ahead), focal: 1.0 };
    }
}
node canvas: Grid<Long> { domain = window(); value = 9223372036854775807l; }
node none: Grid<Float> { domain = vec2(1, 1); }
node drawn: graph "surface.entpkg/graphs/cluster.esn" { points <- library.points; up <- library.up; faces <- library.faces; clusters <- library.clusters; meshes <- library.meshes;
    errors <- library.errors; insts <- insts.result; lens <- lens.result; canvas <- canvas.result; hzb <- none.result; near = 0.1; far = 500.0; }
node raster: native.rasterize@3 { vertices <- drawn.corners; triangles <- drawn.faces; canvas <- canvas.result; domain = size(canvas); }
/// The G-buffer's surface (normal, distance), a sun's visibility of 1 before the shadow, and no layers.
node g: kernel {
    requires { field.read; field.write; }
    input raster: Grid<Surface> <- raster.surface;
    input lens: Lenses <- lens.result;
    output surface: Grid<Vec4>;
    output extra: Grid<Vec4>;
    output layers: Grid<Vec4>;
    domain = size(raster);
    compute {
        let s = sample(raster);
        if s.id < 0 { return { surface: vec4(0.0, 1.0, 0.0, no_hit()), extra: vec4(1.0, 0.0, 0.0, 0.0), layers: vec4(0.0, 0.0, 0.0, 0.0) }; }
        let l = at(lens, 0);
        let n = normalize(s.normal);
        return { surface: vec4(n.x, n.y, n.z, lens_distance(l, ray(l, coord(), domain()), s.depth, 0.1, 500.0)), extra: vec4(1.0, 0.0, 0.0, 0.0), layers: vec4(0.0, 0.0, 0.0, 0.0) };
    }
}
node shadow: graph "../graphs/shadow.esn" { extra <- g.extra; surface <- g.surface; layers <- g.layers; lens <- lens.result; sky <- sky.result;
    points <- library.points; up <- library.up; faces <- library.faces; clusters <- library.clusters; meshes <- library.meshes; errors <- library.errors; insts <- insts.result;
    levels = 6; nearest = 8.0; size = 256; page = 32; }
/// The sun's visibility on the ground in the first ball's shadow (its middle moved on away from the sun, past where the
/// ball hides it from the lens) and two meters beside the ball toward the sun; and how many pages are drawn this frame.
node seen: kernel {
    requires { field.read; field.write; }
    input extra: Grid<Vec4> <- shadow.extra;
    input lens: Lenses <- lens.result;
    input sky: SkyLooks <- sky.result;
    input dirty: Rows<Int> <- shadow.dirty;
    output result: Rows<Float>;
    domain = 3;
    compute {
        let l = at(lens, 0);
        let sun = at(sky, 0).sun;
        let c = vec3(-4.0, 1.0, 0.0);
        let away = normalize(vec3(sun.x, 0.0, sun.z));
        let p = if element() == 0 { c - sun * (1.0 / sun.y) - away * 0.8 } else { vec3(c.x + 2.0 * sun.x, 0.0, c.z + 2.0 * sun.z) };
        let q = project(l, p, size(extra));
        return if element() == 2 { float(loop count(dirty) with n = 0 { n + at(dirty, index()) }) } else { at(extra, q.xy).x };
    }
}
node picture: kernel {
    requires { field.read; field.write; }
    input extra: Grid<Vec4> <- shadow.extra;
    input surface: Grid<Vec4> <- g.surface;
    output result: Image;
    domain = size(extra);
    compute { let s = sample(surface); let v = sample(extra).x; return if s.w > no_hit() * 0.5 { vec4(0.5, 0.6, 0.9, 1.0) } else { vec4(v, v, v, 1.0) * (0.3 + 0.7 * max(s.y, 0.0)) }; }
}

output result <- picture.result;
