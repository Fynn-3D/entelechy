scene passes.esn
window 160 90

# A sunlit floor pixel keeps its visibility through the contact shadow;
# the mirror's lens stands under the water at the stand's eye mirrored.
frame 0.0
expect shadowed.result[9140] = 1 0 0 0
expect mirror_lens.result[0].eye = 0 -3.915964 5.8612556 0.001

# The clouds only take sunlight away, and take some; gloss is only
# widened, and is somewhere; the mirror lies between the picture and its
# white, and changes the picture somewhere; no fog volumes are none.
expect held.result[0] = 1
expect held.result[1] = 1
expect held.result[2] = 1
expect held.result[3] = 1
expect held.result[4] = 1
expect held.result[5] = 1
expect no_volumes.result[0].density = 0
