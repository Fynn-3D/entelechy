scene fog_volumes.esn

# Through the ball's middle two meters of fog of 0.5 a meter (and its soft
# edge) let about a third of the wall through, the light it scatters red;
# through the box, blue; past both, the wall as it is.
frame 0.0
expect aired.fog.result[136] = 0.0265 0.0053 0.0053 0.343 0.003
expect aired.fog.result[140] = 0.0050 0.0050 0.0251 0.382 0.003
expect aired.fog.result[17] = 0 0 0 1 0.0001
expect 32 32 = 0.239 0.220 0.220 0.01
expect 4 4 = 0.5 0.5 0.5 0.002

# No density, no fog.
param thick 0.0
frame 0.1
expect aired.fog.result[136] = 0 0 0 1 0.0001
