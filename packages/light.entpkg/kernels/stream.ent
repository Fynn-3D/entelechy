// A world streamed round the camera: a lattice of chunks on x and z (`side` meters a side from `lo`, `cells_x` by
// `cells_z` of them), each saved twice (`mesh.entpkg`'s `graphs/chunk.esn`): near, as built (`n_XXX_ZZZ.field`), and far,
// built with a wider cell (`f_XXX_ZZZ.field`), its every array in a directory of its own. `light.stream_wanted` names
// the chunks within `far` meters of the eye, nearest first in rings round its chunk, at most a node's count of them, those
// within `near` meters near and the rest far; `light.stream_paths` spells their files for a scene's `fields` nodes;
// `light.stream_insts` places each chunk whose arrays are all in (`mesh.entpkg`'s `graphs/streamed.esn` says which) as a
// thing to draw, the rest far out of sight. Chunks are in world space: a chunk's thing stands at the origin. A `fields`
// node reads the paths as last evaluated, so `light.stream_insts` takes the last frame's wanted chunks (`<~`), the ones
// the files in were named for.
use "geometry.entpkg";
use "camera.ent";
use "field.ent";

/// A chunk wanted: its cell (x, z), near (0) or far (1), and 1 where there is one (0 past the chunks wanted).
type StreamChunks = Rows<IVec4>;

/// The `j`-th cell round the one at `c` in rings (ring 0 the cell itself, ring r the 8r cells r away).
fn stream_ring_cell(c: IVec2, j: Int) -> IVec2 {
    if j == 0 { return c; }
    let r = int(floor((sqrt(float(j)) + 1.0) * 0.5));
    let inner = (2 * r - 1) * (2 * r - 1);
    let t = j - inner;
    let side = 2 * r;
    let edge = t / side;
    let along = t % side;
    let o = if edge == 0 { ivec2(along - r, 0 - r) } else if edge == 1 { ivec2(r, along - r) } else if edge == 2 { ivec2(r - along, r) } else { ivec2(0 - r, r - along) };
    return c + o;
}

/// The chunks wanted (`domain` the most to hold): the `e`-th of the cells round the eye's, in rings, that lie in the world
/// and within `far` meters of the eye (their middles, on x and z), near where within `near`.
kernel light.stream_wanted@1 {
    requires { field.read; field.write; }
    input lens: Lenses;
    param lo: Vec2 = vec2(0.0, 0.0);
    param side: Float = 16.0;
    param cells_x: Int = 16;
    param cells_z: Int = 16;
    param near: Float = 24.0;
    param far: Float = 96.0;
    output result: StreamChunks;
    compute {
        let e = element();
        let eye = at(lens, 0).eye;
        let at_eye = vec2(eye.x, eye.z);
        let c = ivec2(int(floor((at_eye.x - lo.x) / side)), int(floor((at_eye.y - lo.y) / side)));
        let rings = int(ceil(far / side)) + 1;
        let cells = (2 * rings + 1) * (2 * rings + 1);
        let found = loop 4096 with a = ivec4(-1, 0, 0, 0) until index() >= cells || a.w > e {
            let g = stream_ring_cell(c, index());
            let middle = lo + (vec2(float(g.x), float(g.y)) + 0.5) * side;
            let d = length(middle - at_eye);
            let inside = g.x >= 0 && g.y >= 0 && g.x < cells_x && g.y < cells_z && d <= far + side * 0.71;
            if !inside { a } else if a.w == e { ivec4(g.x, g.y, if d <= near + side * 0.71 { 0 } else { 1 }, a.w + 1) } else { ivec4(a.x, a.y, a.z, a.w + 1) }
        };
        return if found.w > e { ivec4(found.x, found.y, found.z, 1) } else { ivec4(0, 0, 0, 0) };
    }
}

/// A digit's character.
fn stream_digit(n: Int, place: Int) -> Int { return 48 + (n / place) % 10; }

/// The chunks' files, sixteen bytes each (`domain = count(chunks) * 16`): `n_XXX_ZZZ.field` near or `f_XXX_ZZZ.field` far,
/// the cell's x and z in three digits, ended by a 0; a chunk not wanted an empty path.
kernel light.stream_paths@1 {
    requires { field.read; field.write; }
    input chunks: StreamChunks;
    output result: Rows<Int>;
    compute {
        let b = element();
        let c = at(chunks, b / 16);
        let k = b % 16;
        if c.w == 0 || k == 15 { return 0; }
        return if k == 0 { if c.z == 0 { 110 } else { 102 } } else if k == 1 || k == 5 { 95 }
            else if k == 2 { stream_digit(c.x, 100) } else if k == 3 { stream_digit(c.x, 10) } else if k == 4 { stream_digit(c.x, 1) }
            else if k == 6 { stream_digit(c.y, 100) } else if k == 7 { stream_digit(c.y, 10) } else if k == 8 { stream_digit(c.y, 1) }
            else if k == 9 { 46 } else if k == 10 { 102 } else if k == 11 { 105 } else if k == 12 { 101 } else if k == 13 { 108 } else { 100 };
    }
}

/// Each chunk as a thing to draw (`domain = count(chunks)`): at the origin as its mesh row (`ready`, `graphs/streamed.esn`'s)
/// says, or far out of sight while its arrays are on their way and past the chunks wanted.
kernel light.stream_insts@1 {
    requires { field.read; field.write; }
    input chunks: StreamChunks;
    input ready: Rows<Int>;
    output result: FieldInsts;
    compute {
        let e = element();
        let row = if e < count(ready) { at(ready, e) } else { -1 };
        return if at(chunks, e).w == 1 && row >= 0 { FieldInst { at: vec3(0.0, 0.0, 0.0), turn: 0.0, size: 1.0, shape: row } }
            else { FieldInst { at: vec3(10000000.0, -10000000.0, 10000000.0), turn: 0.0, size: 0.0, shape: 0 } };
    }
}

/// No chunk wanted (`domain` as many as `light.stream_wanted` holds): the last frame's chunks at first.
kernel light.stream_none@1 {
    requires { field.write; }
    output result: StreamChunks;
    compute { return ivec4(0, 0, 0, 0); }
}
