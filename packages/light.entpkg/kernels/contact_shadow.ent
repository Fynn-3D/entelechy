// Contact shadows: the proxies are too coarse to trace the shadows of bumps a few centimeters or millimeters high;
// each pixel walks a short way toward the sun on the screen, and is shadowed where it passes behind something else in the G-buffer.
// A scene's G-buffer passes through it before a renderer takes it (`light.contact`), multiplied into the sun's
// visibility (`extra`'s x).
use "camera.ent";
use "sky.ent";

/// How far a contact shadow reaches, a scene's to tune: `length` of the distance from the eye (at most `longest` meters), and how
/// thick what casts it is taken to be, `thick` of the distance (at most `thickest` meters; a blade of grass is thin, and what lies
/// further behind it is not in its shadow).
struct ContactReach { length: Float; longest: Float; thick: Float; thickest: Float; }

/// From `p` (pixel `q`, `t` meters from the eye) toward `sun` on the screen: how far it walks (`c`, scaled by distance),
/// in how many steps; how much is shadowed (0 none, 1 all), fading at the edges.
fn contact_shadow(surface: Grid<Vec4>, l: Lens, extent: Vec2, p: Vec3, n: Vec3, sun: Vec3, t: Float, steps: Int, jitter: Float, c: ContactReach) -> Float {
    let far = clamp(t * c.length, 0.03, c.longest);
    let bias = t * 0.0015 + 0.0005;
    // Only what is a little behind counts.
    let thick = clamp(t * c.thick, 0.03, c.thickest);
    let start = p + n * bias;
    return loop 32 with hit = 0.0 until hit > 0.9 || index() >= steps {
        let f = (float(index()) + jitter) / float(steps);
        let x = start + sun * far * f * f;
        let d = x - l.eye;
        let ahead = dot(d, l.ahead);
        let uv = vec2(dot(d, l.right), dot(d, l.up)) / max(ahead, 0.001) * l.focal;
        let q = vec2(uv.x * extent.y + extent.x * 0.5 - 0.5, extent.y * 0.5 - uv.y * extent.y - 0.5);
        let inside = ahead > 0.05 && q.x >= 0.0 && q.y >= 0.0 && q.x <= extent.x - 1.0 && q.y <= extent.y - 1.0;
        let o = if inside { at(surface, floor(q + 0.5)) } else { vec4(0.0, 0.0, 0.0, no_hit()) };
        let behind = length(d) - o.w;
        // Fading in just behind and out toward the thickness, so the
        // shadow's edge does not flip from frame to frame.
        let solid = smoothstep(bias, bias * 3.0, behind) * (1.0 - smoothstep(thick * 0.5, thick, behind));
        if inside && o.w < no_hit() * 0.5 && solid > 0.0 { max(hit, (1.0 - f * f * 0.6) * solid) } else { hit }
    };
}

/// The G-buffer's `extra`, the sun's visibility multiplied by the contact shadow.
kernel light.contact@1 {
    requires { field.read; field.write; }
    input surface: Grid<Vec4>;
    input extra: Grid<Vec4>;
    /// The G-buffer's `layers`: w is how thin a leaf is (a thin leaf lets light through and takes no contact shadow,
    /// so a tuft of grass does not darken itself whole).
    input layers: Grid<Vec4>;
    input lens: Lenses;
    input sky: SkyLooks;
    /// The steps walked.
    param steps: Int = 16;
    /// How far it reaches and how thick what casts it is (`ContactReach`).
    param length: Float = 0.025;
    param longest: Float = 0.3;
    param thick: Float = 0.01;
    param thickest: Float = 0.15;
    output result: Grid<Vec4>;
    compute {
        let e = sample(extra);
        let s = sample(surface);
        let l = at(lens, 0);
        if s.w > no_hit() * 0.5 || e.x <= 0.0 || l.focal <= 0.0 || sample(layers).w > 0.5 { return e; }
        let extent = domain();
        let dir = ray(l, coord(), extent);
        let p = l.eye + dir * s.w;
        let sun = normalize(at(sky, 0).sun);
        // A different start each frame (the shifted lens differs), so the
        // temporal blend averages the steps' grain away.
        let frame_seed = fract(dot(l.ahead, vec3(12.9898, 78.233, 37.719)) * 43758.547);
        let jitter = fract(52.982919 * fract(dot(coord(), vec2(0.06711056, 0.00583715))) + frame_seed * 7.0);
        let shade = contact_shadow(surface, l, extent, p, s.xyz, sun, s.w, steps, jitter, ContactReach { length: length, longest: longest, thick: thick, thickest: thickest });
        return vec4(e.x * (1.0 - shade), e.y, e.z, e.w);
    }
}
