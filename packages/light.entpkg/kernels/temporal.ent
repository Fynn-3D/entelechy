// Temporal antialiasing (TAA): each frame the lens is jittered less than a pixel (`light.jitter`), the last frame's
// picture carried to this frame's place by the difference of the two frames' lenses (`light.taa`) and blended with this frame; the
// color carried is held between the colors round this pixel this frame, so moving and newly uncovered things do not smear.
// Once the picture rests (lens and scene unchanged, the scene giving how many frames it has rested, `calm`), after sixteen jittered frames it is
// jittered no more, the picture settled and no longer computed anew each frame.
use "camera.ent";

/// The `i`th Halton number (base `base`), 0 to 1.
fn halton(i: Int, base: Int) -> Float {
    return loop 12 with r = vec3(0.0, 1.0, float(i + 1)) until r.z < 1.0 {
        let f = r.y / float(base);
        let n = r.z;
        vec3(r.x + f * (n - floor(n / float(base)) * float(base)), f, floor(n / float(base)))
    }.x;
}

/// How many frames are jittered once the picture rests.
fn jitter_frames() -> Int { return 16; }

/// Whether two lenses are one: the same eye, the same way, the same focal length.
fn lens_alike(a: Lens, b: Lens) -> Bool {
    return length(a.eye - b.eye) < 0.000001 && length(a.ahead - b.ahead) < 0.000001 && length(a.up - b.up) < 0.000001 && abs(a.focal - b.focal) < 0.000001;
}

/// How far the lens is jittered this frame (pixels, -0.5 to 0.5): by time while moving; once resting, the frame's own
/// in turn, and 0 once enough are jittered.
fn jitter_at(calm: Int, t: Float) -> Vec2 {
    let i = if calm == 0 { int(t * 60.0) % jitter_frames() } else { calm };
    return if calm >= jitter_frames() { vec2(0.0, 0.0) } else { vec2(halton(i % jitter_frames(), 2), halton(i % jitter_frames(), 3)) - 0.5 };
}

/// The jittered lens: turned whole by the angle of `jitter` pixels (for a picture `size` large).
kernel light.jitter@1 {
    requires { field.read; field.write; time.read; }
    input lens: Lenses;
    /// How many frames the picture has rested (lens and scene unchanged): the scene's count, 0 when anything moved.
    input calm: Rows<Int>;
    input size: Rows<Vec2>;
    output result: Lenses;
    compute {
        let l = at(lens, 0);
        let j = jitter_at(at(calm, 0), time());
        let h = max(at(size, 0).y, 1.0);
        // Turned by the angles a pixel subtends (the whole camera, so its
        // rays and its projection move alike).
        let a = j.x / (l.focal * h);
        let b = 0.0 - j.y / (l.focal * h);
        let ahead1 = l.ahead * cos(a) + l.right * sin(a);
        let right1 = l.right * cos(a) - l.ahead * sin(a);
        let ahead2 = ahead1 * cos(b) + l.up * sin(b);
        let up2 = l.up * cos(b) - ahead1 * sin(b);
        return Lens { ..l, ahead: ahead2, right: right1, up: up2 };
    }
}

/// This frame (`hdr`, through the jittered lens `jlens`, possibly smaller than the picture: temporal upscaling) blended with
/// the last frame carried over, at the picture's size. `lens` and `was_lens` are this frame's and the last frame's
/// lens unjittered, `surface`'s w how far each pixel lies along the view ray (the size of `hdr`),
/// `motion` how far the thing there moved this frame (in the world, meters; 1 × 1 when nothing moved): moving
/// things (walking figures) are carried by it, not blurred.
///
/// This frame's color is taken where it truly falls through the jittered lens; the nearer the nearest sample falls
/// to this pixel, the larger its share (a small picture jittered frame by frame builds a large one, without shaking). The last
/// frame is read by Catmull-Rom (not blurred), held within a few standard deviations of the mean of the colors round it this
/// frame, as luma and chroma (moving and newly uncovered things do not smear); once the picture rests unjittered, held as
/// gathered.
kernel light.taa@1 {
    requires { field.read; field.write; }
    input hdr: Image;
    input surface: Grid<Vec4>;
    input lens: Lenses;
    input jlens: Lenses;
    input was_lens: Lenses;
    input history: Image;
    input motion: Grid<Vec4>;
    /// Whether the picture rests unjittered (`light.lens_rests`).
    input rests: Rows<Int>;
    /// The most of each frame this frame takes (when a sample falls right on the pixel).
    param fresh: Float = 0.12;
    /// How far the history may stray from this frame's neighborhood, in its spreads, held still and moving (wider keeps more
    /// detail and smears more; narrower flickers more).
    param clamp_still: Float = 2.0;
    param clamp_moving: Float = 1.5;
    output result: Image;
    compute {
        let q = icoord();
        let ext = domain();
        let small = size(hdr);
        let l = at(lens, 0);
        let sq = clamp(floor((coord() + 0.5) * size(surface) / ext), vec2(0.0, 0.0), size(surface) - 1.0);
        let s = at(surface, sq);
        let far = s.w > no_hit() * 0.5;
        let dir = ray(l, coord(), ext);
        let p = if far { l.eye + dir * 10000.0 } else { l.eye + dir * s.w };
        // This frame's color where this point lay in the shifted frame.
        let pj = project(at(jlens, 0), p, small);
        let at_small = clamp(pj.xy, vec2(0.5, 0.5), small - 0.5);
        let now = at_linear(hdr, at_small);
        if isize(history) != ivec2(int(ext.x), int(ext.y)) { return now; }
        let moved = if isize(motion) == ivec2(1, 1) || far { vec3(0.0, 0.0, 0.0) } else { at(motion, clamp(sq, vec2(0.0, 0.0), size(motion) - 1.0)).xyz };
        let pw = project(at(was_lens, 0), p - moved, ext);
        let pc = project(l, p, ext);
        let back = vec2(float(q.x), float(q.y)) + (pw.xy - pc.xy);
        let inside = pw.z > 0.0 && back.x >= 1.0 && back.y >= 1.0 && back.x <= ext.x - 2.0 && back.y <= ext.y - 2.0;
        if !inside { return now; }
        // How near the nearest sample of this frame fell to this pixel (in
        // the picture's pixels): the nearer, the more it is trusted.
        let off = (floor(at_small) + 0.5 - at_small) * ext / small;
        let near = exp(0.0 - 1.2 * dot(off, off));
        let nearest = at(hdr, clamp(floor(at_small), vec2(0.0, 0.0), small - 1.0)).xyz;
        // Blended with their brightness pressed into 0..1 (and let out
        // again after): a sparkle on the water or a lit leaf then weighs
        // like any color, and does not flash on and off.
        let cur = squeeze(mix(now.xyz, nearest, near * 0.25));
        // The colors about it this frame (as luma and chroma): their mean and spread.
        let center = floor(at_small);
        let m = loop 9 with a = [vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0)] {
            let o = vec2(float(index() % 3 - 1), float(index() / 3 - 1));
            let v = ycocg(squeeze(at(hdr, clamp(center + o, vec2(0.0, 0.0), small - 1.0)).xyz));
            [a[0] + v, a[1] + v * v]
        };
        let mean = m[0] / 9.0;
        // Never narrower than a shade the eye can tell: a flat wall's own grain does not turn its history away.
        let sigma = sqrt(max(m[1] / 9.0 - mean * mean, vec3(0.0, 0.0, 0.0))) + 0.006;
        // Moving across the picture, the history is less to be trusted
        // (each carry softens it, and it smears like motion blur): the
        // further it came, the tighter it is held to this frame's colors
        // and the more of this frame is taken.
        let travel = length(back - vec2(float(q.x), float(q.y)));
        let moving = smoothstep(0.25, 3.0, travel);
        let was = ycocg(squeeze(max(catmull_rom(history, back + 0.5), vec3(0.0, 0.0, 0.0))));
        // At rest and no longer jittered (`light.jitter`), a frame adds nothing the history lacks: it is held (only kept
        // among this frame's colors), and the picture settles as gathered.
        if at(rests, 0) == 1 && length(moved) == 0.0 {
            let kept = clip_toward(was, mean, sigma * 3.0);
            // Within this frame's colors: the history as it is, bit for bit (the picture rests).
            let held = if length(kept - was) == 0.0 { at(history, coord()).xyz } else { unsqueeze(ycocg_rgb(kept)) };
            return vec4(held.x, held.y, held.z, now.w);
        }
        let reach = mix(clamp_still, clamp_moving, moving);
        let kept = ycocg_rgb(clip_toward(was, mean, sigma * reach));
        let share = clamp(fresh * (0.3 + 0.7 * near) + 0.15 * moving, 0.03, 0.5);
        let mixed = unsqueeze(mix(kept, cur, share));
        return vec4(mixed.x, mixed.y, mixed.z, now.w);
    }
}

/// A color's brightness pressed into 0 to 1 (`unsqueeze` gives it back).
fn squeeze(c: Vec3) -> Vec3 { return c / (1.0 + max(c.x, max(c.y, c.z))); }
fn unsqueeze(c: Vec3) -> Vec3 { return c / max(1.0 - max(c.x, max(c.y, c.z)), 0.0001); }

/// A color as luma and two chroma (YCoCg; `ycocg_rgb` gives it back): a history is held among this frame's colors there,
/// where a colored ghost on a gray ground is far off even when its brightness is not.
fn ycocg(c: Vec3) -> Vec3 { return vec3(c.x * 0.25 + c.y * 0.5 + c.z * 0.25, c.x * 0.5 - c.z * 0.5, c.y * 0.5 - c.x * 0.25 - c.z * 0.25); }
fn ycocg_rgb(c: Vec3) -> Vec3 { return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z); }
/// `c` drawn toward `mean` until it lies within `reach` of it on each axis (clipped, not clamped: its hue kept as it
/// comes in).
fn clip_toward(c: Vec3, mean: Vec3, reach: Vec3) -> Vec3 {
    let v = c - mean;
    let u = abs(v) / max(reach, vec3(0.000001, 0.000001, 0.000001));
    let most = max(u.x, max(u.y, u.z));
    return if most > 1.0 { mean + v / most } else { c };
}

/// An image read at `c` (texel centers on half texels) by Catmull-Rom: nine bilinear reads (not blurred, and not blurring more
/// as it is carried frame after frame).
fn catmull_rom(img: Image, c: Vec2) -> Vec3 {
    let t1 = floor(c - 0.5) + 0.5;
    let f = c - t1;
    let w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    let w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    let w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    let w3 = f * f * (-0.5 + 0.5 * f);
    let w12 = w1 + w2;
    let t0 = t1 - 1.0;
    let t3 = t1 + 2.0;
    let t12 = t1 + w2 / w12;
    let r = at_linear(img, vec2(t0.x, t0.y)).xyz * (w0.x * w0.y) + at_linear(img, vec2(t12.x, t0.y)).xyz * (w12.x * w0.y) + at_linear(img, vec2(t3.x, t0.y)).xyz * (w3.x * w0.y)
        + at_linear(img, vec2(t0.x, t12.y)).xyz * (w0.x * w12.y) + at_linear(img, vec2(t12.x, t12.y)).xyz * (w12.x * w12.y) + at_linear(img, vec2(t3.x, t12.y)).xyz * (w3.x * w12.y)
        + at_linear(img, vec2(t0.x, t3.y)).xyz * (w0.x * w3.y) + at_linear(img, vec2(t12.x, t3.y)).xyz * (w12.x * w3.y) + at_linear(img, vec2(t3.x, t3.y)).xyz * (w3.x * w3.y);
    return max(r, vec3(0.0, 0.0, 0.0));
}

/// Whether the picture rests unjittered (`domain = 1`): 1 where the lens is the last frame's (`was_lens`) and its jitter
/// has stopped (`jlens` is it), 0 otherwise. A history taken then gains nothing new and is held.
kernel light.lens_rests@1 {
    requires { field.read; field.write; }
    input lens: Lenses;
    input jlens: Lenses;
    input was_lens: Lenses;
    output result: Rows<Int>;
    compute { let l = at(lens, 0); return if lens_alike(at(jlens, 0), l) && lens_alike(l, at(was_lens, 0)) { 1 } else { 0 }; }
}

/// The lens copied (where a graph must remember the last frame's lens: a graph's inputs remember nothing).
kernel light.same_lens@1 {
    requires { field.read; field.write; }
    input lens: Lenses;
    output result: Lenses;
    compute { return at(lens, 0); }
}
