// A mesh baked into a proxy: for a scene drawn as one mesh (a room, a model) rather than placed things, the distance volume a
// renderer traces through, made from the mesh's own faces. Each face's box, widened by `band` cells, is cut into tiles of
// `proxy_bake_tile()` cells a side (`light.proxy_bake_tiles`, `parallel.entpkg`'s runs), so a wall many cells wide is
// baked by many; each cell of a tile within `band` cells of the face keeps the nearest face's distance and number, the
// least of a 64-bit key, distance above and face below (`light.proxy_bake_faces`); each such cell then keeps the nearest
// point of that face (`light.proxy_seeds`), and the points are spread to every cell by jump flooding, each pass a cell
// taking the nearest of the points its neighbors `step` cells off keep, the step halved pass by pass (`light.proxy_flood`,
// Rong and Tan's), so a cell far from every face knows how far it is and a ray crosses an empty room in long steps. Each
// cell is its point's distance, less half a cell so a face is a shell with an inside, and the point's face's color
// (`light.proxy_baked`). `graphs/proxy_bake.esn` is the whole.
use "geometry.entpkg";
use "parallel.entpkg";
use "mesh.entpkg";
use "raster.entpkg";
use "camera.ent";

/// A tile's side, in cells.
fn proxy_bake_tile() -> Int { return 8; }

/// The point of the triangle `a`, `b`, `c` nearest `p` (Ericson's walk over its regions).
fn proxy_triangle_nearest(p: Vec3, a: Vec3, b: Vec3, c: Vec3) -> Vec3 {
    let ab = b - a;
    let ac = c - a;
    let ap = p - a;
    let d1 = dot(ab, ap);
    let d2 = dot(ac, ap);
    if d1 <= 0.0 && d2 <= 0.0 { return a; }
    let bp = p - b;
    let d3 = dot(ab, bp);
    let d4 = dot(ac, bp);
    if d3 >= 0.0 && d4 <= d3 { return b; }
    let vc = d1 * d4 - d3 * d2;
    if vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0 { return a + ab * (d1 / (d1 - d3)); }
    let cp = p - c;
    let d5 = dot(ab, cp);
    let d6 = dot(ac, cp);
    if d6 >= 0.0 && d5 <= d6 { return c; }
    let vb = d5 * d2 - d1 * d6;
    if vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0 { return a + ac * (d2 / (d2 - d6)); }
    let va = d3 * d6 - d5 * d4;
    if va <= 0.0 && d4 - d3 >= 0.0 && d5 - d6 >= 0.0 { return b + (c - b) * ((d4 - d3) / ((d4 - d3) + (d5 - d6))); }
    let denom = 1.0 / (va + vb + vc);
    return a + ab * (vb * denom) + ac * (vc * denom);
}

/// How far `p` is from the triangle `a`, `b`, `c`.
fn proxy_triangle_distance(p: Vec3, a: Vec3, b: Vec3, c: Vec3) -> Float {
    return length(p - proxy_triangle_nearest(p, a, b, c));
}

/// Where cell `g` of the proxy `fr` holds its distance: its point of the lattice, `cell` meters a step from `lo` (as
/// `proxy_at` reads it).
fn proxy_bake_point(fr: Proxy, g: IVec3) -> Vec3 { return fr.lo + float(g) * fr.cell; }

/// The cells face `f`'s box spans, widened by `band` cells, within the proxy (lower corner xyz, inclusive; upper corner
/// past it, `hi`).
struct ProxyBakeBox { lo: IVec3; hi: IVec3; }
fn proxy_bake_box(fr: Proxy, a: Vec3, b: Vec3, c: Vec3, band: Float) -> ProxyBakeBox {
    let lo = floor((min(min(a, b), c) - fr.lo) / fr.cell - band);
    let hi = ceil((max(max(a, b), c) - fr.lo) / fr.cell + band);
    let top = fr.cells;
    let l = clamp(lo, vec3(0.0, 0.0, 0.0), top);
    let h = clamp(hi, vec3(0.0, 0.0, 0.0), top);
    return ProxyBakeBox { lo: ivec3(int(l.x), int(l.y), int(l.z)), hi: ivec3(int(h.x), int(h.y), int(h.z)) };
}

/// How many tiles each face's widened box spans (0 for one outside the proxy).
kernel light.proxy_bake_tiles@1 {
    requires { field.read; field.write; }
    input faces: Rows<Face>;
    input points: Rows<MeshPoint>;
    input frame: Proxies;
    param band: Float = 3.0;
    output result: Rows<Int>;
    compute {
        let f = sample(faces);
        let fr = at(frame, 0);
        let bx = proxy_bake_box(fr, at(points, f.a).position, at(points, f.b).position, at(points, f.c).position, band);
        let t = proxy_bake_tile();
        let n = max((bx.hi - bx.lo + t - 1) / t, 0);
        return n.x * n.y * n.z;
    }
}

/// Each tile of each face (`domain = value(entries)`, laid by `ends`): every cell of it within `band` cells of the face
/// keeps the least key of the faces near it, the distance's bits above and the face below.
kernel light.proxy_bake_faces@1 {
    requires { field.read; field.write; }
    input faces: Rows<Face>;
    input points: Rows<MeshPoint>;
    input tiles: Rows<Int>;
    input ends: Rows<Int>;
    input frame: Proxies;
    input blank: Volume<Long>;
    /// How many tiles (sizes the node).
    input entries: Rows<Int>;
    param band: Float = 3.0;
    output result: Volume<Long>;
    struct Near { cell: IVec3; key: Long; }
    scatter into blank with min {
        let e = element();
        if e >= at(ends, count(ends) - 1) { return Near { cell: ivec3(-1, -1, -1), key: 0l }; }
        let fi = owner(e, ends);
        let f = at(faces, fi);
        let fr = at(frame, 0);
        let a = at(points, f.a).position;
        let b = at(points, f.b).position;
        let c = at(points, f.c).position;
        let bx = proxy_bake_box(fr, a, b, c, band);
        let t = proxy_bake_tile();
        let n = max((bx.hi - bx.lo + t - 1) / t, 1);
        let k = e - (at(ends, fi) - at(tiles, fi));
        let o = bx.lo + ivec3(k % n.x, (k / n.x) % n.y, k / (n.x * n.y)) * t;
        let span = min(bx.hi - o, ivec3(t, t, t));
        let reach = band * fr.cell;
        let done = loop span.x * span.y * span.z with z = 0 {
            let g = o + ivec3(index() % span.x, (index() / span.x) % span.y, index() / (span.x * span.y));
            let d = proxy_triangle_distance(proxy_bake_point(fr, g), a, b, c);
            if d <= reach { emit(Near { cell: g, key: (long(bits(d)) << 32l) | long(fi) }); }
            z + 1
        };
        return Near { cell: ivec3(-1, -1, -1), key: long(done) * 0l };
    }
}

/// Each cell's nearest point of a face (`domain` the proxy's cells): within `band` cells of one, the nearest point of the
/// nearest face (xyz) and that face (w); none (w -1) elsewhere.
kernel light.proxy_seeds@1 {
    requires { field.read; field.write; }
    input near: Volume<Long>;
    input faces: Rows<Face>;
    input points: Rows<MeshPoint>;
    input frame: Proxies;
    output result: Volume<Vec4>;
    compute {
        let key = sample(near);
        if key == 9223372036854775807l { return vec4(0.0, 0.0, 0.0, -1.0); }
        let fi = int(key & 4294967295l);
        let f = at(faces, fi);
        let q = proxy_triangle_nearest(proxy_bake_point(at(frame, 0), icoord()), at(points, f.a).position, at(points, f.b).position, at(points, f.c).position);
        return vec4(q.x, q.y, q.z, float(fi));
    }
}

/// A pass of jump flooding at cell `g`: the nearest to its point of the points it and its 26 neighbors `step` cells off
/// keep in `seeds`.
fn proxy_flood_at(seeds: Volume<Vec4>, fr: Proxy, g: IVec3, step: Int) -> Vec4 {
    let p = proxy_bake_point(fr, g);
    let top = isize(seeds) - 1;
    return loop 27 with best = at(seeds, g) {
        let o = ivec3(index() % 3, (index() / 3) % 3, index() / 9) - 1;
        let c = g + o * step;
        if c.x < 0 || c.y < 0 || c.z < 0 || c.x > top.x || c.y > top.y || c.z > top.z { best } else {
            let s = at(seeds, c);
            if s.w >= 0.0 && (best.w < 0.0 || length(s.xyz - p) < length(best.xyz - p)) { s } else { best }
        }
    };
}

/// A pass of jump flooding: each cell the nearest to its point of the points it and its 26 neighbors `step` cells off keep.
kernel light.proxy_flood@1 {
    requires { field.read; field.write; }
    input seeds: Volume<Vec4>;
    input frame: Proxies;
    param step: Int = 1;
    output result: Volume<Vec4>;
    compute { return proxy_flood_at(seeds, at(frame, 0), icoord(), step); }
}

// ------------------------------------------------------------------ a pass a frame

/// The baking a frame (`domain = 2`): the stage (x of row 0: 1 to 8 a pass of flooding, 9 the proxy made, 10 done) and a
/// hash of what it is baked from (row 1): when that changes the stage starts again at 1, then goes on a step a frame to 10,
/// where it stays.
kernel light.proxy_stage@1 {
    requires { field.read; field.write; }
    input previous: Rows<Int>;
    input points: Rows<MeshPoint>;
    input faces: Rows<Face>;
    input colors: Rows<Vec4>;
    input frame: Proxies;
    output result: Rows<Int>;
    compute {
        let fr = at(frame, 0);
        let n = count(points);
        let a = at(points, 0).position;
        let b = at(points, n / 2).position;
        let c = at(points, max(n - 1, 0)).position;
        let f = at(faces, max(count(faces) - 1, 0));
        let sign = mul_wrap(count(points), 73856093) ^ mul_wrap(count(faces), 19349663) ^ mul_wrap(count(colors), 83492791) ^ bits(a.x + a.y * 3.0 + a.z * 7.0)
            ^ mul_wrap(bits(b.x + b.y * 3.0 + b.z * 7.0), 31) ^ mul_wrap(bits(c.x + c.y * 3.0 + c.z * 7.0), 37) ^ mul_wrap(f.a + f.b * 3 + f.c * 7, 41)
            ^ bits(fr.lo.x + fr.lo.y * 3.0 + fr.lo.z * 7.0 + fr.cell);
        let held = count(previous) == 2;
        let stage = if !held || at(previous, 1) != sign { 1 } else { min(at(previous, 0) + 1, 10) };
        return if element() == 0 { stage } else { sign };
    }
}

/// The flood a frame (`domain = size(seeds)`): at stage 1 its first pass over the seeds, at stages 2 to 8 the next over the
/// last frame's (`previous`, steps halving from 128), after them as it was.
kernel light.proxy_flood_staged@1 {
    requires { field.read; field.write; }
    input seeds: Volume<Vec4>;
    input previous: Volume<Vec4>;
    input stage: Rows<Int>;
    input frame: Proxies;
    output result: Volume<Vec4>;
    compute {
        let s = at(stage, 0);
        let held = isize(previous) == idomain();
        if s < 1 || s > 8 { return if held { sample(previous) } else { sample(seeds) }; }
        let step = 256 >> s;
        return if s == 1 || !held { proxy_flood_at(seeds, at(frame, 0), icoord(), step) } else { proxy_flood_at(previous, at(frame, 0), icoord(), step) };
    }
}

/// The proxy's cell `g` from the flooded points `seeds`: its nearest point's distance less half a cell, and that point's
/// face's color (`colors`); far and `gray` where no face is.
fn proxy_baked_at(seeds: Volume<Vec4>, colors: Rows<Vec4>, fr: Proxy, g: IVec3, gray: Vec3) -> Vec4 {
    let s = at(seeds, g);
    if s.w < 0.0 { return vec4(1000.0, gray.x, gray.y, gray.z); }
    let c = at(colors, int(s.w));
    return vec4(length(s.xyz - proxy_bake_point(fr, g)) - fr.cell * 0.5, c.x, c.y, c.z);
}

/// The proxy (`domain` its cells): each cell its nearest point's distance less half a cell, and that point's face's color
/// (`colors`, one a face, rgb); far and `gray` where no face is.
kernel light.proxy_baked@1 {
    requires { field.read; field.write; }
    input seeds: Volume<Vec4>;
    input colors: Rows<Vec4>;
    input frame: Proxies;
    param gray: Vec3 = vec3(0.5, 0.5, 0.5);
    output result: Volume<Vec4>;
    compute { return proxy_baked_at(seeds, colors, at(frame, 0), icoord(), gray); }
}

/// The proxy in use (`domain = size(work)`): made from the flood (`work`) at stage 9, the last one made (`previous`) the
/// rest of the time, so what the light is traced through changes once, whole, when the new one is done; before any is
/// made, the flood as far as it has come.
kernel light.proxy_published@1 {
    requires { field.read; field.write; }
    input work: Volume<Vec4>;
    input previous: Volume<Vec4>;
    input stage: Rows<Int>;
    input colors: Rows<Vec4>;
    input frame: Proxies;
    param gray: Vec3 = vec3(0.5, 0.5, 0.5);
    output result: Volume<Vec4>;
    compute {
        let held = isize(previous) == idomain();
        return if at(stage, 0) == 9 || !held { proxy_baked_at(work, colors, at(frame, 0), icoord(), gray) } else { sample(previous) };
    }
}

/// The frame the proxy in use was made over (`domain = 1`): `frame` when the proxy is made (stage 9, or before any is held),
/// the last one (`previous`) the rest of the time, so the proxy and its frame change together.
kernel light.proxy_published_frame@1 {
    requires { field.read; field.write; }
    input frame: Proxies;
    input previous: Proxies;
    input stage: Rows<Int>;
    input work: Volume<Vec4>;
    output result: Proxies;
    compute {
        let held = count(previous) == 1 && isize(work) == ivec3(int(at(frame, 0).cells.x), int(at(frame, 0).cells.y), int(at(frame, 0).cells.z));
        return if at(stage, 0) == 9 || !held { at(frame, 0) } else { at(previous, 0) };
    }
}

/// Whether a proxy has been made whole yet (`domain = 1`): 1 from the first stage 9 on (`previous` the last frame's), 0
/// while the first one floods.
kernel light.proxy_made@1 {
    requires { field.read; field.write; }
    input previous: Rows<Int>;
    input stage: Rows<Int>;
    output result: Rows<Int>;
    compute { return if at(stage, 0) >= 9 || at(previous, 0) == 1 { 1 } else { 0 }; }
}

// ------------------------------------------------------------------ a fine level round the lens

/// A fine level of the proxy round the lens (`domain = 1`): `nx` by `ny` by `nz` cells of `cell` meters, its middle across the
/// ground ahead of the eye (a quarter of its width on), its foot `below` of its height under the eye (most of what is near and
/// lit lies down there: tables, chairs, the floor), held within the scene's own proxy (`frame`'s first level) and moved in
/// steps of `hold` of its width, so it is baked again only a step on; the ground as the scene has it.
kernel light.proxy_detail_frame@1 {
    requires { field.read; field.write; }
    input lens: Lenses;
    input frame: Proxies;
    param nx: Int = 112;
    param ny: Int = 80;
    param nz: Int = 112;
    param cell: Float = 0.025;
    param below: Float = 0.75;
    param hold: Float = 0.25;
    output result: Proxies;
    compute {
        let l = at(lens, 0);
        let b = at(frame, 0);
        let cells = vec3(float(nx), float(ny), float(nz));
        let span = cells * cell;
        let ahead = normalize(vec2(l.ahead.x, l.ahead.z) + vec2(0.0001, 0.0));
        let middle = vec2(l.eye.x, l.eye.z) + ahead * span.x * 0.25;
        let step = max(span.x * hold, cell);
        let want = vec3(middle.x - span.x * 0.5, l.eye.y - span.y * below, middle.y - span.z * 0.5);
        let snapped = floor(want / step) * step;
        let top = b.lo + b.cells * b.cell - span;
        let lo = clamp(snapped, b.lo, max(top, b.lo));
        return Proxy { ..b, lo: lo, cell: cell, cells: cells };
    }
}

/// A level that holds only what lies inside its block, joined with what lies beyond (`domain = size(proxy)`): each cell's
/// distance the nearer of its own and what lies past the block, no nearer than the block's edge (as `beyond`, the next
/// level, `beyond_frame`, has it), so a ray stepping through it never steps past the edge over a thing beyond; its color
/// as it is. Until the level is first made whole (`made`), `beyond`'s distance alone: a level half flooded knows too little.
kernel light.proxy_within@1 {
    requires { field.read; field.write; }
    input proxy: Volume<Vec4>;
    input frame: Proxies;
    input beyond: Volume<Vec4>;
    input beyond_frame: Proxies;
    input made: Rows<Int>;
    output result: Volume<Vec4>;
    compute {
        let v = sample(proxy);
        let fr = at(frame, 0);
        let c = coord();
        let m = min(c, fr.cells - 1.0 - c);
        let edge = min(m.x, min(m.y, m.z)) * fr.cell;
        let far = proxy_at(beyond, beyond_frame, fr.lo + c * fr.cell, 1000.0).x;
        return vec4(if at(made, 0) == 1 { min(v.x, max(far, edge)) } else { far }, v.y, v.z, v.w);
    }
}

/// Two levels of a proxy as one volume, `b`'s cells up the depth after `a`'s, each level as wide and high as its own
/// (`domain = max(size(a), size(b)) * vec3(1.0, 1.0, 0.0) + (size(a) + size(b)) * vec3(0.0, 0.0, 1.0)`): the volume as wide
/// and high as the widest, a level's cells past its own width empty (no level reads them).
kernel light.proxy_stack@1 {
    requires { field.read; field.write; }
    input a: Volume<Vec4>;
    input b: Volume<Vec4>;
    output result: Volume<Vec4>;
    compute {
        let q = coord();
        let za = size(a).z;
        let inside_a = q.x < size(a).x && q.y < size(a).y;
        let inside_b = q.x < size(b).x && q.y < size(b).y;
        return if q.z < za { if inside_a { at(a, q) } else { vec4(1000.0, 0.0, 0.0, 0.0) } }
            else if inside_b { at(b, vec3(q.x, q.y, q.z - za)) } else { vec4(1000.0, 0.0, 0.0, 0.0) };
    }
}
