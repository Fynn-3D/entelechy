// Lamps' shadow maps: for each lamp that casts shadows (the first `slots`), a cube of six faces `res` texels a side, each
// texel the distance from the lamp to the nearest thing along it, so a lamp's shadow is as sharp as its texels where the
// thing casting it stands and as soft as its bulb further off (`lamp_map_seen` in `lamps.ent`), where the proxies' are only
// as fine as their cells. The things are a clustered library's (`mesh.entpkg`'s) at one level, placed (`insts`). Each
// face's part in front of each cube face, cut where it crosses the face's plane, spans a box of tiles of `lamp_map_tile()`
// texels (`light.lamp_map_tiles`); each tile walks its texels and keeps, through each texel's middle, where the ray from
// the lamp meets the face (Möller and Trumbore's), the nearest of all as the least distance's bits
// (`light.lamp_map_draw`). Nothing within `skip` times a lamp's bulb of it casts a shadow, so a shade round a bulb does
// not hide it; nothing past its reach is drawn. Each slot keeps what it was drawn from (`light.lamp_map_held`: its
// lamp's place, bulb and reach, and every thing within that reach where it stands), and only a slot whose own changed is
// cleared and drawn again (`light.lamp_map_dirty`, `light.lamp_map_clear`): a lamp turned brighter draws nothing, a lamp
// moved draws its own cube, a thing moved the cubes of the lamps that reach it. `graphs/lamp_maps.esn` is the whole;
// `light.lamp_maps_none` stands for them in a scene without.
use "parallel.entpkg";
use "mesh.entpkg";
use "raster.entpkg";
use "surface.entpkg";
use "lamps.ent";

/// A tile's side in texels.
fn lamp_map_tile() -> Int { return 16; }

/// A box grown by corner `p` (`d` ahead of the cube face `x`) where it lies in front of the face's plane (`near` ahead).
fn lamp_map_grown(box: Vec4, p: Vec3, d: Float, x: LampCubeAxes, near: Float) -> Vec4 {
    if d < near { return box; }
    let uv = clamp(vec2(dot(p, x.right), dot(p, x.up)) / d, -1.0, 1.0);
    return vec4(min(box.x, uv.x), min(box.y, uv.y), max(box.z, uv.x), max(box.w, uv.y));
}
/// A box grown by where the edge from `p` to `q` crosses the face's plane, if it does.
fn lamp_map_crossed(box: Vec4, p: Vec3, dp: Float, q: Vec3, dq: Float, x: LampCubeAxes, near: Float) -> Vec4 {
    if (dp < near) == (dq < near) { return box; }
    let m = p + (q - p) * ((near - dp) / (dq - dp));
    let uv = clamp(vec2(dot(m, x.right), dot(m, x.up)) / near, -1.0, 1.0);
    return vec4(min(box.x, uv.x), min(box.y, uv.y), max(box.z, uv.x), max(box.w, uv.y));
}

/// The box a face (its corners `a`, `b`, `c` from the lamp) spans on cube face `f`, in texels of `res` a side (x0, y0, x1,
/// y1, the last past it): its part in front of the face's plane, held to the face; empty (x1 <= x0) for none.
fn lamp_map_box(f: Int, a: Vec3, b: Vec3, c: Vec3, res: Int) -> Vec4 {
    let x = lamp_cube_axes(f);
    let near = 0.0001;
    let da = dot(a, x.ahead);
    let db = dot(b, x.ahead);
    let dc = dot(c, x.ahead);
    if da < near && db < near && dc < near { return vec4(0.0, 0.0, 0.0, 0.0); }
    let box = lamp_map_crossed(lamp_map_crossed(lamp_map_crossed(lamp_map_grown(lamp_map_grown(lamp_map_grown(
        vec4(2.0, 2.0, -2.0, -2.0), a, da, x, near), b, db, x, near), c, dc, x, near), a, da, b, db, x, near), b, db, c, dc, x, near), c, dc, a, da, x, near);
    let r = float(res);
    let lo = clamp(floor((vec2(box.x, box.y) * 0.5 + 0.5) * r), 0.0, r);
    let hi = clamp(ceil((vec2(box.z, box.w) * 0.5 + 0.5) * r), 0.0, r);
    return vec4(lo.x, lo.y, hi.x, hi.y);
}

/// How far along `dir` from `o` the ray meets the triangle `a`, `b`, `c` (Möller and Trumbore's); -1 where it does not.
fn lamp_map_hit(o: Vec3, dir: Vec3, a: Vec3, b: Vec3, c: Vec3) -> Float {
    let e1 = b - a;
    let e2 = c - a;
    let h = cross(dir, e2);
    let det = dot(e1, h);
    if abs(det) < 0.0000000001 { return -1.0; }
    let inv = 1.0 / det;
    let s = o - a;
    let u = dot(s, h) * inv;
    if u < 0.0 || u > 1.0 { return -1.0; }
    let qv = cross(s, e1);
    let v = dot(dir, qv) * inv;
    if v < 0.0 || u + v > 1.0 { return -1.0; }
    let t = dot(e2, qv) * inv;
    return if t > 0.0 { t } else { -1.0 };
}

/// A face to draw into a slot's cube face: its corners in the world, the lamp, the cube face and the texels its box spans.
struct LampMapFace { a: Vec3; b: Vec3; c: Vec3; lamp: Lamp; slot: Int; face: Int; box: Vec4; }

/// Pair `e` of face slots by map slots by cube faces: the face (slot `e / (6 * slots)`, `mesh_cluster_faces()` a drawn
/// cluster), the map slot and the cube face, its box empty where nothing is drawn.
fn lamp_map_face(e: Int, slots: Int, chosen: Rows<IVec2>, insts: FieldInsts, points: Rows<MeshPoint>, faces: Rows<Face>,
    clusters: Rows<Cluster>, lamps: Lamps, slot_lamps: Rows<Int>, res: Int, skip: Float) -> LampMapFace {
    let per = 6 * max(slots, 1);
    let fs = e / per;
    let slot = (e % per) / 6;
    let f = e % 6;
    let kc = at(chosen, fs / mesh_cluster_faces());
    let j = fs % mesh_cluster_faces();
    let k = at(slot_lamps, slot);
    let m = at(lamps, max(k, 0));
    let none = LampMapFace { a: vec3(0.0, 0.0, 0.0), b: vec3(0.0, 0.0, 0.0), c: vec3(0.0, 0.0, 0.0), lamp: m, slot: slot, face: f, box: vec4(0.0, 0.0, 0.0, 0.0) };
    if kc.x < 0 || k < 0 { return none; }
    let cl = at(clusters, kc.y);
    if j >= cl.count { return none; }
    let it = at(insts, kc.x);
    let g = at(faces, cl.first + j);
    let a = cluster_placed(it, at(points, g.a).position);
    let b = cluster_placed(it, at(points, g.b).position);
    let c = cluster_placed(it, at(points, g.c).position);
    let nearest = length(proxy_triangle_nearest(m.at, a, b, c) - m.at);
    let farthest = max(length(a - m.at), max(length(b - m.at), length(c - m.at)));
    if nearest > m.reach || farthest < m.size * skip { return none; }
    return LampMapFace { a: a, b: b, c: c, lamp: m, slot: slot, face: f, box: lamp_map_box(f, a - m.at, b - m.at, c - m.at, res) };
}

/// No maps: one texel, which no lamp's slot reads (`domain = vec2(1, 1)`).
kernel light.lamp_maps_none@1 {
    requires { field.write; }
    output result: Grid<Int>;
    compute { return 2147483647; }
}

/// Each map slot's lamp (`domain` the slots the maps hold): the slot-th lamp that casts shadows, -1 past them.
kernel light.lamp_map_lamps@1 {
    requires { field.read; field.write; }
    input lamps: Lamps;
    /// How many slots (`light.lamp_map_count`; sizes the node).
    input slots: Rows<Int>;
    output result: Rows<Int>;
    compute {
        let s = element();
        let n = min(count(lamps), lamps_most());
        let found = loop n with r = ivec2(-1, 0) {
            let shadows = at(lamps, index()).shadow != 0;
            if r.x < 0 && shadows && r.y == s { ivec2(index(), r.y + 1) } else if shadows { ivec2(r.x, r.y + 1) } else { r }
        };
        return found.x;
    }
}

/// How many map slots the lamps fill (`domain = 1`): the lamps that cast shadows, at most `most`.
kernel light.lamp_map_count@1 {
    requires { field.read; field.write; }
    input lamps: Lamps;
    param most: Int = 16;
    output result: Rows<Int>;
    compute { return min(loop min(count(lamps), lamps_most()) with n = 0 { n + int(at(lamps, index()).shadow != 0) }, most); }
}

/// How many clusters each thing draws into the maps (`domain = count(insts)`): its mesh's clusters of level `level`, or of
/// its finest where it holds none so fine (a trimmed mesh).
kernel light.lamp_map_counts@1 {
    requires { field.read; field.write; }
    input insts: FieldInsts;
    input meshes: Rows<ClusterMesh>;
    param level: Int = 1;
    output result: Rows<Int>;
    compute {
        let m = at(meshes, sample(insts).shape);
        let k = clamp(max(level, mesh_cluster_first(m)), 0, mesh_cluster_levels() - 1);
        return m.levels[k + 1] - m.levels[k];
    }
}

/// The clusters drawn (`domain = value(entries)`): each one's thing (x) and cluster (y), laid by `ends`.
kernel light.lamp_map_clusters@1 {
    requires { field.read; field.write; }
    input insts: FieldInsts;
    input meshes: Rows<ClusterMesh>;
    input counts: Rows<Int>;
    input ends: Rows<Int>;
    input entries: Rows<Int>;
    param level: Int = 1;
    output result: Rows<IVec2>;
    compute {
        let e = element();
        if e >= at(ends, count(ends) - 1) { return ivec2(-1, 0); }
        let i = owner(e, ends);
        let m = at(meshes, at(insts, i).shape);
        let k = clamp(max(level, mesh_cluster_first(m)), 0, mesh_cluster_levels() - 1);
        return ivec2(i, m.levels[k] + e - (at(ends, i) - at(counts, i)));
    }
}

/// How many tiles each face spans on each dirty slot's each cube face (`domain = count(chosen) * mesh_cluster_faces() * 6 *
/// slots`, `lamp_map_face`'s pairs); none on a slot drawn already.
kernel light.lamp_map_tiles@1 {
    requires { field.read; field.write; }
    input dirty: Rows<Int>;
    input chosen: Rows<IVec2>;
    input insts: FieldInsts;
    input points: Rows<MeshPoint>;
    input faces: Rows<Face>;
    input clusters: Rows<Cluster>;
    input lamps: Lamps;
    input slot_lamps: Rows<Int>;
    param res: Int = 256;
    param skip: Float = 1.5;
    output result: Rows<Int>;
    compute {
        let e = element();
        if at(dirty, min((e % (6 * count(slot_lamps))) / 6, count(dirty) - 1)) == 0 { return 0; }
        let d = lamp_map_face(e, count(slot_lamps), chosen, insts, points, faces, clusters, lamps, slot_lamps, res, skip);
        let t = float(lamp_map_tile());
        let n = max(ceil((vec2(d.box.z, d.box.w) - vec2(d.box.x, d.box.y)) / t), vec2(0.0, 0.0));
        return int(n.x) * int(n.y);
    }
}

/// A number mixed into a running hash.
fn lamp_map_mixed(h: Int, x: Float) -> Int { return mul_wrap(h ^ bits(x), 16777619); }

/// What each slot is drawn from, as a hash (`domain = count(slot_lamps)`): its lamp's place, bulb, reach and panel, and
/// each thing whose sphere its reach meets, where it stands, how it is turned and sized and what it is; 0 for no lamp.
kernel light.lamp_map_held@1 {
    requires { field.read; field.write; }
    input lamps: Lamps;
    input slot_lamps: Rows<Int>;
    input insts: FieldInsts;
    input meshes: Rows<ClusterMesh>;
    output result: Rows<Int>;
    compute {
        let k = sample(slot_lamps);
        if k < 0 { return 0; }
        let m = at(lamps, k);
        let h0 = lamp_map_mixed(lamp_map_mixed(lamp_map_mixed(lamp_map_mixed(lamp_map_mixed(lamp_map_mixed(-2128831035, m.at.x), m.at.y), m.at.z), m.size), m.reach),
            m.side.x + m.side.y * 3.0 + m.side.z * 7.0 + m.rise.x * 11.0 + m.rise.y * 13.0 + m.rise.z * 17.0);
        let h = loop count(insts) with h = h0 {
            let it = at(insts, index());
            let sp = at(meshes, it.shape).sphere;
            let middle = cluster_placed(it, sp.xyz);
            if length(middle - m.at) - sp.w * it.size > m.reach { h } else {
                lamp_map_mixed(lamp_map_mixed(lamp_map_mixed(lamp_map_mixed(lamp_map_mixed(lamp_map_mixed(h, it.at.x), it.at.y), it.at.z), it.turn), it.size), float(it.shape))
            }
        };
        return h | 1;
    }
}

/// 1 for each slot whose hash is not the last frame's (`previous`; every slot where their number differs), 0 for the rest.
kernel light.lamp_map_dirty@1 {
    requires { field.read; field.write; }
    input now: Rows<Int>;
    input previous: Rows<Int>;
    output result: Rows<Int>;
    compute { return if count(previous) != count(now) { 1 } else { int(sample(now) != at(previous, element())) }; }
}

/// The maps with the dirty slots cleared to the farthest (`domain = vec2(res, res * 6 * max(value(slots), 1))`), the rest
/// as the last frame drew them (`previous`; all cleared where its size is not this one).
kernel light.lamp_map_clear@1 {
    requires { field.read; field.write; }
    input previous: Grid<Int>;
    input dirty: Rows<Int>;
    /// How many slots (sizes the node).
    input slots: Rows<Int>;
    param res: Int = 256;
    output result: Grid<Int>;
    compute {
        let c = icoord();
        let slot = c.y / (res * 6);
        let held = isize(previous) == idomain();
        return if held && at(dirty, min(slot, count(dirty) - 1)) == 0 { at(previous, c) } else { 2147483647 };
    }
}

/// Each tile of each face (`domain = value(entries)`, the pairs' tiles laid end to end by `ends`): every texel of it the
/// face covers keeps the least distance from its lamp, through the texel's middle.
kernel light.lamp_map_draw@1 {
    requires { field.read; field.write; }
    input chosen: Rows<IVec2>;
    input insts: FieldInsts;
    input points: Rows<MeshPoint>;
    input faces: Rows<Face>;
    input clusters: Rows<Cluster>;
    input lamps: Lamps;
    input slot_lamps: Rows<Int>;
    input tiles: Rows<Int>;
    input ends: Rows<Int>;
    input blank: Grid<Int>;
    /// How many tiles (sizes the node).
    input entries: Rows<Int>;
    param res: Int = 256;
    param skip: Float = 1.5;
    output result: Grid<Int>;
    struct Near { cell: IVec2; key: Int; }
    scatter into blank with min {
        let e = element();
        let none = Near { cell: ivec2(-1, -1), key: 0 };
        if e >= at(ends, count(ends) - 1) { return none; }
        let pair = owner(e, ends);
        let d = lamp_map_face(pair, count(slot_lamps), chosen, insts, points, faces, clusters, lamps, slot_lamps, res, skip);
        let tb = box_tile(d.box, lamp_map_tile(), e - (at(ends, pair) - at(tiles, pair)));
        let o = tb.xy;
        let span = tb.zw;
        let x = lamp_cube_axes(d.face);
        let r = float(res);
        let done = loop max(span.x * span.y, 0) with z = 0 {
            let g = o + ivec2(index() % span.x, index() / span.x);
            let uv = (vec2(float(g.x), float(g.y)) + 0.5) / r * 2.0 - 1.0;
            let dir = normalize(x.ahead + x.right * uv.x + x.up * uv.y);
            let hit = lamp_map_hit(d.lamp.at, dir, d.a, d.b, d.c);
            if hit > 0.0 { emit(Near { cell: lamp_map_cell(d.slot, d.face, g, res), key: bits(hit) }); }
            z + 1
        };
        return Near { cell: ivec2(-1, -1), key: done * 0 };
    }
}
