// Lamps: lights of a scene's own beside the sun, point lights, spotlights
// and glowing panels (a screen, a window, a soft box), each with a reach
// past which it gives nothing. A scene hands
// its lamps over as rows (at most 128). The screen is cut into tiles of 16
// by 16 pixels, and each tile keeps the lamps that can reach what it shows
// (`light.lamps_depth`, `light.lamps_tiles`); a pixel adds those alone
// (`light.lamps_light`), each shadowed through the proxies and, close by,
// on the screen. Probe GI takes that light into what it shows
// and bounces; another renderer has it added after (`light.lamps_shade`).
use "random.entpkg";
use "geometry.entpkg";
use "brdf.ent";
use "surface.entpkg";
use "contact_shadow.ent";

/// A lamp: where it is, how far it reaches (meters; nothing past it), its
/// intensity (linear HDR: the irradiance a surface facing it gets one meter
/// away), its size (the bulb's radius: softer shadows and highlights, no
/// infinite peak beside it), where a spotlight aims (`aim`) with the
/// cosines of its full beam (`inner`) and its edge (`outer`; -1 for a point
/// light that shines all round), and whether it casts shadows (1) or not (0).
/// A panel has half its width along `side` and half its height along `rise`
/// (both zero for a point light or a spotlight), shines from the face `aim`
/// points out of, and its `color` is its radiance: what the eye sees of it.
/// A point light or a spotlight may take its light through the scene's
/// lamp looks (`LampLooks`): a cookie (`cookie`, the looks' texels from
/// x, y to z, w; none where z is not past x), the light's filter as it
/// leaves the lamp, laid across a spotlight's beam or, round a point light,
/// by the angle from `aim` down and round from `up`; and a profile
/// (`profile`, a row of texels from x to z on row y; none where z is not
/// past x), the share of its light by the angle from `aim`, 0 to 180
/// degrees along the row, as an IES file gives it (`.ies`).
struct Lamp { at: Vec3; reach: Float; color: Vec3; size: Float; aim: Vec3; inner: Float; outer: Float; shadow: Int; side: Vec3; rise: Vec3;
    up: Vec3; cookie: Vec4; profile: Vec4; }
type Lamps = Rows<Lamp>;
/// What the lamps' light is shaped by: a picture of the scene's own (a kernel draws it, still or moving) holding each
/// lamp's cookie and profile (`Lamp`'s `cookie`, `profile`); `light.lamp_looks_none` where no lamp takes one.
type LampLooks = Grid<Vec4>;

/// A point light at `at` reaching `reach` meters, of intensity `color`.
fn point_lamp(at: Vec3, reach: Float, color: Vec3, size: Float, shadow: Int) -> Lamp {
    return Lamp { at: at, reach: reach, color: color, size: size, aim: vec3(0.0, -1.0, 0.0), inner: -1.0, outer: -1.0, shadow: shadow,
        side: vec3(0.0, 0.0, 0.0), rise: vec3(0.0, 0.0, 0.0), up: vec3(0.0, 0.0, -1.0), cookie: vec4(0.0, 0.0, 0.0, 0.0), profile: vec4(0.0, 0.0, 0.0, 0.0) };
}
/// A spotlight at `at` aimed at `toward`, its beam `beam` radians across at
/// full strength, fading to nothing over `soft` radians more.
fn spot_lamp(at: Vec3, toward: Vec3, reach: Float, color: Vec3, size: Float, beam: Float, soft: Float, shadow: Int) -> Lamp {
    let aim = normalize(toward - at);
    return Lamp { at: at, reach: reach, color: color, size: size, aim: aim, inner: cos(beam * 0.5), outer: cos(beam * 0.5 + soft), shadow: shadow,
        side: vec3(0.0, 0.0, 0.0), rise: vec3(0.0, 0.0, 0.0), up: lamp_up_for(aim), cookie: vec4(0.0, 0.0, 0.0, 0.0), profile: vec4(0.0, 0.0, 0.0, 0.0) };
}
/// A glowing panel centered at `at`, `width` by `height` meters, facing
/// `facing` with its width along `across` (made square to `facing`), of
/// radiance `color`, reaching `reach` meters.
fn panel_lamp(at: Vec3, facing: Vec3, across: Vec3, width: Float, height: Float, reach: Float, color: Vec3, shadow: Int) -> Lamp {
    let aim = normalize(facing);
    let side = normalize(across - aim * dot(across, aim));
    let rise = cross(aim, side);
    return Lamp { at: at, reach: reach, color: color, size: 0.5 * sqrt(width * width + height * height), aim: aim, inner: -1.0, outer: -1.0, shadow: shadow,
        side: side * (width * 0.5), rise: rise * (height * 0.5), up: rise, cookie: vec4(0.0, 0.0, 0.0, 0.0), profile: vec4(0.0, 0.0, 0.0, 0.0) };
}
/// A way square to `aim` for a cookie's up: the world's up as seen along it, or ahead (-z) when it aims straight up or down.
fn lamp_up_for(aim: Vec3) -> Vec3 {
    let up = if abs(aim.y) > 0.999 { vec3(0.0, 0.0, -1.0) } else { vec3(0.0, 1.0, 0.0) };
    return normalize(up - aim * dot(up, aim));
}
/// Lamp `m` with a cookie: the looks' texels from `lo` to `hi`, its up along `up` (made square to its aim).
fn lamp_with_cookie(m: Lamp, lo: Vec2, hi: Vec2, up: Vec3) -> Lamp {
    let u = up - m.aim * dot(up, m.aim);
    return Lamp { ..m, up: if dot(u, u) > 0.000001 { normalize(u) } else { lamp_up_for(m.aim) }, cookie: vec4(lo.x, lo.y, hi.x, hi.y) };
}
/// Lamp `m` with a profile: the looks' texels from `x0` to `x1` on row `y` (0 to 180 degrees from its aim).
fn lamp_with_profile(m: Lamp, x0: Float, x1: Float, y: Float) -> Lamp { return Lamp { ..m, profile: vec4(x0, y, x1, 0.0) }; }
/// The filter lamp `m`'s cookie and profile (`looks`) lay on its light toward `d` (from the lamp; white with neither, and
/// for a panel).
fn lamp_look(m: Lamp, d: Vec3, looks: LampLooks) -> Vec3 {
    if lamp_is_panel(m) || (m.cookie.z <= m.cookie.x && m.profile.z <= m.profile.x) { return vec3(1.0, 1.0, 1.0); }
    let dir = normalize(d);
    let along = clamp(dot(dir, m.aim), -1.0, 1.0);
    let shaped = if m.profile.z <= m.profile.x { 1.0 } else {
        let x = mix(m.profile.x, m.profile.z, acos(along) / 3.14159265);
        at_linear(looks, vec2(clamp(x, m.profile.x, m.profile.z) + 0.5, m.profile.y + 0.5)).x
    };
    if m.cookie.z <= m.cookie.x { return vec3(shaped, shaped, shaped); }
    let right = cross(m.aim, m.up);
    let a = dot(dir, right);
    let b = dot(dir, m.up);
    // A spotlight's cookie lies across its beam (its edge at the corners' middles); a point light's round it, by
    // the turn about its aim and the angle from it.
    let uv = if m.outer > -1.0 {
        let spread = sqrt(max(1.0 - m.outer * m.outer, 0.000001)) / max(m.outer, 0.05);
        if along <= 0.0 { vec2(-1.0, -1.0) } else { vec2(a, 0.0 - b) / (along * spread) * 0.5 + 0.5 }
    } else { vec2(atan2(b, a) / 6.2831853 + 0.5, acos(along) / 3.14159265) };
    if uv.x < 0.0 || uv.y < 0.0 || uv.x > 1.0 || uv.y > 1.0 { return vec3(0.0, 0.0, 0.0); }
    let lo = m.cookie.xy + 0.5;
    let hi = m.cookie.zw - 0.5;
    let c = at_linear(looks, mix(lo, max(hi, lo), uv));
    return c.xyz * shaped;
}
/// Whether lamp `m` is a panel.
fn lamp_is_panel(m: Lamp) -> Bool { return dot(m.side, m.side) > 0.0; }
/// How many lamps a scene may hand over: the bits a tile keeps.
fn lamps_most() -> Int { return 128; }
/// A tile's side in pixels.
fn lamp_tile() -> Float { return 16.0; }

/// How much of lamp `m` reaches a point `d` from it (`d` from the lamp to
/// the point) before distance: its reach's window, smooth to nothing at the
/// reach, times a spotlight's beam; for a panel, times its area as seen from
/// the point (a panel seen from afar is a point light of that intensity).
fn lamp_beam(m: Lamp, d: Vec3) -> Float {
    let x = dot(d, d) / max(m.reach * m.reach, 0.0001);
    let window = saturate(1.0 - x * x);
    let spot = if lamp_is_panel(m) { 4.0 * length(m.side) * length(m.rise) * max(dot(normalize(d), m.aim), 0.0) }
        else if m.outer > -1.0 { smoothstep(m.outer, m.inner, dot(normalize(d), m.aim)) } else { 1.0 };
    return window * window * spot;
}

/// The irradiance a panel of radiance 1 gives a surface at `p` facing `n`,
/// exactly (Lambert's formula for a polygon: the edges' angles as seen from
/// `p`, each along its plane's normal), 0 behind the panel.
fn panel_irradiance(m: Lamp, p: Vec3, n: Vec3) -> Float {
    if dot(p - m.at, m.aim) <= 0.0 { return 0.0; }
    let c0 = normalize(m.at - m.side - m.rise - p);
    let c1 = normalize(m.at + m.side - m.rise - p);
    let c2 = normalize(m.at + m.side + m.rise - p);
    let c3 = normalize(m.at - m.side + m.rise - p);
    let f = panel_edge(c0, c1) + panel_edge(c1, c2) + panel_edge(c2, c3) + panel_edge(c3, c0);
    // The edges' turn decides the sign: the sum points toward the panel.
    let toward = if dot(f, m.at - p) < 0.0 { vec3(0.0, 0.0, 0.0) - f } else { f };
    return max(dot(n, toward), 0.0) * 0.5;
}
/// One edge's share of a polygon's form factor, from `a` to `b` (unit
/// vectors from the point lit to the corners).
fn panel_edge(a: Vec3, b: Vec3) -> Vec3 {
    let c = cross(a, b);
    let l = length(c);
    return if l < 0.000001 { vec3(0.0, 0.0, 0.0) } else { c * (acos(clamp(dot(a, b), -1.0, 1.0)) / l) };
}
/// The point of the panel a mirror ray from `p` along `r` meets, held to
/// the panel's edges (the representative point of its highlight, Karis's).
fn panel_point(m: Lamp, p: Vec3, r: Vec3) -> Vec3 {
    let across = dot(r, m.aim);
    let t = if across < -0.0001 { dot(m.at - p, m.aim) / across } else { -1.0 };
    let q = if t > 0.0 { p + r * t } else { m.at };
    let w = length(m.side);
    let h = length(m.rise);
    let su = clamp(dot(q - m.at, m.side / w), 0.0 - w, w);
    let sr = clamp(dot(q - m.at, m.rise / h), 0.0 - h, h);
    return m.at + m.side * (su / w) + m.rise * (sr / h);
}
/// The light a panel gives a surface of material `m` at `p` facing `n`, seen
/// from `v` (before shadows): diffuse exactly from its irradiance, specular
/// from its representative point, the highlight's energy kept as the panel
/// widens it.
fn panel_light(lamp: Lamp, m: Pbr, p: Vec3, n: Vec3, v: Vec3) -> Vec3 {
    let d = p - lamp.at;
    let x = dot(d, d) / max(lamp.reach * lamp.reach, 0.0001);
    let window = saturate(1.0 - x * x);
    let window2 = window * window;
    if window2 <= 0.0 { return vec3(0.0, 0.0, 0.0); }
    let e = panel_irradiance(lamp, p, n);
    let kd = (1.0 - m.metal) * (1.0 - m.transmission);
    let diffuse = m.albedo * (kd / 3.14159265) * e;
    let pc = panel_point(lamp, p, reflect(vec3(0.0, 0.0, 0.0) - v, n));
    let to = pc - p;
    let dist = max(length(to), 0.01);
    let l = to / dist;
    let area = 4.0 * length(lamp.side) * length(lamp.rise);
    let seen = area * max(dot(vec3(0.0, 0.0, 0.0) - l, lamp.aim), 0.0) / (dist * dist);
    let a = pbr_alpha(m.rough);
    let wide = saturate(a + sqrt(area / 3.14159265) / (2.0 * dist));
    let spec = glossy_by(m, n, v, l, vec3(1.0, 1.0, 1.0)) * (min(seen, 6.28) * (a / wide) * (a / wide));
    return lamp.color * (diffuse + spec) * window2;
}
/// The irradiance lamp `m` gives a point `p` facing it (before shadows): the
/// inverse square from the bulb, softened by its size, through its cookie
/// and profile (`looks`).
fn lamp_irradiance(m: Lamp, p: Vec3, looks: LampLooks) -> Vec3 {
    let d = p - m.at;
    return m.color * lamp_look(m, d, looks) * (lamp_beam(m, d) / (dot(d, d) + m.size * m.size));
}

/// A lamp's cube of shadow maps (`kernels/lamp_map.ent`): a face's axes, the way it looks (`ahead`), its right and its up;
/// faces 0 to 5 look along +x, -x, +y, -y, +z, -z.
struct LampCubeAxes { ahead: Vec3; right: Vec3; up: Vec3; }
fn lamp_cube_axes(f: Int) -> LampCubeAxes {
    return if f == 0 { LampCubeAxes { ahead: vec3(1.0, 0.0, 0.0), right: vec3(0.0, 0.0, -1.0), up: vec3(0.0, 1.0, 0.0) } }
        else if f == 1 { LampCubeAxes { ahead: vec3(-1.0, 0.0, 0.0), right: vec3(0.0, 0.0, 1.0), up: vec3(0.0, 1.0, 0.0) } }
        else if f == 2 { LampCubeAxes { ahead: vec3(0.0, 1.0, 0.0), right: vec3(1.0, 0.0, 0.0), up: vec3(0.0, 0.0, -1.0) } }
        else if f == 3 { LampCubeAxes { ahead: vec3(0.0, -1.0, 0.0), right: vec3(1.0, 0.0, 0.0), up: vec3(0.0, 0.0, 1.0) } }
        else if f == 4 { LampCubeAxes { ahead: vec3(0.0, 0.0, 1.0), right: vec3(1.0, 0.0, 0.0), up: vec3(0.0, 1.0, 0.0) } }
        else { LampCubeAxes { ahead: vec3(0.0, 0.0, -1.0), right: vec3(-1.0, 0.0, 0.0), up: vec3(0.0, 1.0, 0.0) } };
}
/// The cube face a direction `v` from the lamp falls on.
fn lamp_cube_face(v: Vec3) -> Int {
    let a = abs(v);
    return if a.x >= a.y && a.x >= a.z { if v.x >= 0.0 { 0 } else { 1 } } else if a.y >= a.z { if v.y >= 0.0 { 2 } else { 3 } } else { if v.z >= 0.0 { 4 } else { 5 } };
}
/// Where on face `f` (-1 to 1 across it) a direction `v` in front of it falls.
fn lamp_cube_uv(f: Int, v: Vec3) -> Vec2 {
    let x = lamp_cube_axes(f);
    return vec2(dot(v, x.right), dot(v, x.up)) / max(dot(v, x.ahead), 0.000001);
}
/// Texel `g` of map slot `slot`'s face `f` in the maps (faces one above another, slots one above another), `res` a side.
fn lamp_map_cell(slot: Int, f: Int, g: IVec2, res: Int) -> IVec2 {
    return ivec2(clamp(g.x, 0, res - 1), (slot * 6 + f) * res + clamp(g.y, 0, res - 1));
}
/// Lamp `k`'s slot in the maps: its place among the lamps that cast shadows, -1 for one that casts none, one past the
/// slots the maps hold, or no maps at all (`light.lamp_maps_none`'s one texel).
fn lamp_map_slot(lamps: Lamps, maps: Grid<Int>, k: Int) -> Int {
    let res = int(size(maps).x);
    let slots = if res < 8 { 0 } else { int(size(maps).y) / (res * 6) };
    if slots <= 0 || k >= count(lamps) || at(lamps, k).shadow == 0 { return -1; }
    let before = loop k with n = 0 { n + int(at(lamps, index()).shadow != 0) };
    return if before < slots { before } else { -1 };
}
/// The distance map slot `slot` keeps from its lamp along `v`, `res` texels a side, the texel `o` texels across from where
/// `v` falls.
fn lamp_map_distance(maps: Grid<Int>, slot: Int, res: Int, f: Int, g: Vec2, o: Vec2) -> Float {
    let t = g + o;
    return from_bits(at(maps, lamp_map_cell(slot, f, ivec2(int(floor(t.x)), int(floor(t.y))), res)));
}
/// How lit a point `dist` from the lamp is by the four texels round `g + o` (`lamp_map_distance`'s), each compared and the
/// four weighted by where the point falls between them, so an edge between texels is a ramp, not a step.
fn lamp_map_compared(maps: Grid<Int>, slot: Int, res: Int, f: Int, g: Vec2, o: Vec2, dist: Float) -> Float {
    let t = g + o - 0.5;
    let b = floor(t);
    let w = t - b;
    let lit = lamp_map_texels_lit(maps, slot, res, f, b, dist);
    return mix(mix(lit.x, lit.y, w.x), mix(lit.z, lit.w, w.x), w.y);
}

/// How much of lamp `m` reaches `p` (a surface facing `n`) by its shadow map in slot `slot` (1 lit, 0 dark): the point
/// moved off the surface by a texel and a half, blockers looked for over as many texels as the bulb spans from there, their
/// mean distance making the penumbra as wide as the bulb makes it at `p`, that much filtered (twelve points of a spiral
/// turned by `turn`).
fn lamp_map_seen(maps: Grid<Int>, slot: Int, m: Lamp, p: Vec3, n: Vec3, turn: Float) -> Float {
    let res = int(size(maps).x);
    let r = float(res);
    let texel = length(p - m.at) * 2.0 / r;
    let v = p + n * (texel * 1.5) - m.at;
    let dist = length(v);
    let f = lamp_cube_face(v);
    let g = (lamp_cube_uv(f, v) * 0.5 + 0.5) * r;
    let bias = texel * 1.5;
    let search = clamp(m.size * r / (2.0 * max(dist, 0.01)), 1.0, 16.0);
    let a = turn * 6.2831853;
    let found = loop 8 with b = vec2(0.0, 0.0) {
        let o = vogel_point(index(), 8, a, search);
        let d = lamp_map_distance(maps, slot, res, f, g, o);
        if d < dist - bias { vec2(b.x + d, b.y + 1.0) } else { b }
    };
    if found.y < 0.5 { return 1.0; }
    let blocker = found.x / found.y;
    let wide = clamp(m.size * (dist - blocker) / max(blocker, 0.01) / max(texel, 0.000001), 0.75, 16.0);
    let lit = loop 12 with sum = 0.0 {
        let o = vogel_point(index(), 12, a, wide);
        sum + lamp_map_compared(maps, slot, res, f, g, o, dist - bias)
    };
    return lit / 12.0;
}
/// The four texels from `b` (its corner, texels) lit (1) or not for a point `dist` from the lamp: x, y the lower row, z, w
/// the upper.
fn lamp_map_texels_lit(maps: Grid<Int>, slot: Int, res: Int, f: Int, b: Vec2, dist: Float) -> Vec4 {
    let at00 = from_bits(at(maps, lamp_map_cell(slot, f, ivec2(int(b.x), int(b.y)), res)));
    let at10 = from_bits(at(maps, lamp_map_cell(slot, f, ivec2(int(b.x) + 1, int(b.y)), res)));
    let at01 = from_bits(at(maps, lamp_map_cell(slot, f, ivec2(int(b.x), int(b.y) + 1), res)));
    let at11 = from_bits(at(maps, lamp_map_cell(slot, f, ivec2(int(b.x) + 1, int(b.y) + 1), res)));
    return vec4(step(dist, at00), step(dist, at10), step(dist, at01), step(dist, at11));
}

/// The shadow toward point `at` of lamp `m` from `p` (a surface facing `n`) through the proxies, walked from just off the
/// surface to the lamp, its steps set on by `jitter` of a cell (0 to 1): 1 lit, 0 dark, the penumbra wider for a larger bulb.
fn lamp_shadow_to(m: Lamp, at: Vec3, proxy: Volume<Vec4>, land: Grid<Float>, frame: Proxies, p: Vec3, n: Vec3, jitter: Float) -> Float {
    let d = at - p;
    let dist = length(d);
    let dir = d / max(dist, 0.0001);
    let c = proxy_cell_at(frame, p);
    let o = p + n * (c * 0.6);
    let start = rough_leave(proxy, frame, o, dir, c * 0.5, c * 3.0) + jitter * c;
    let far = dist - m.size - c;
    if far <= start { return 1.0; }
    let sharp = clamp(dist / max(m.size * 4.0, 0.05), 4.0, 24.0);
    // The penumbra by the nearest the ray passes to what it walks by, found from two steps' distances (Aaltonen's), not
    // each step's alone: a step's own distance bands the shadow along the field's level sets.
    let r = loop 96 with r = vec3(start, 1.0, 1000000.0) until r.x > far || r.y < 0.01 {
        let h = rough_probe(proxy, land, frame, o + dir * r.x).x;
        let y = if r.z > 999999.0 { 0.0 } else { h * h / (2.0 * r.z) };
        let side = sqrt(max(h * h - y * y, 0.0));
        vec3(r.x + clamp(h * 0.6, c * 0.3, 12.0), min(r.y, sharp * side / max(r.x - y, 0.0001)), h)
    };
    return smoothstep(0.0, 1.0, saturate(r.y));
}

/// The shadow toward lamp `m` from `p` (a surface facing `n`) through the proxies: toward its bulb; toward four points
/// across a panel (half its width and height out from its middle), their mean, so a wide window's shadow is as soft as it is
/// wide, not one ray's. Each ray's steps are set on by a share of a cell that `jitter` (0 to 1, the pixel's own) and the
/// point turn, so what the steps meet does not line up from pixel to pixel into bands.
fn lamp_shadow(m: Lamp, proxy: Volume<Vec4>, land: Grid<Float>, frame: Proxies, p: Vec3, n: Vec3, jitter: Float) -> Float {
    if !lamp_is_panel(m) { return lamp_shadow_to(m, m.at, proxy, land, frame, p, n, jitter); }
    let small = Lamp { ..m, size: m.size * 0.5 };
    return (lamp_shadow_to(small, m.at + m.side * 0.5 + m.rise * 0.5, proxy, land, frame, p, n, jitter)
        + lamp_shadow_to(small, m.at - m.side * 0.5 + m.rise * 0.5, proxy, land, frame, p, n, fract(jitter + 0.25))
        + lamp_shadow_to(small, m.at + m.side * 0.5 - m.rise * 0.5, proxy, land, frame, p, n, fract(jitter + 0.5))
        + lamp_shadow_to(small, m.at - m.side * 0.5 - m.rise * 0.5, proxy, land, frame, p, n, fract(jitter + 0.75))) * 0.25;
}

/// How much of lamp `m` reaches `x` through the proxies, by a short walk of
/// `steps` steps toward it, soft (1 all, 0 none): for points the coarse
/// scene stands for (light in the air, light bounced off the proxies).
fn lamp_rough_shadow(m: Lamp, proxy: Volume<Vec4>, land: Grid<Float>, frame: Proxies, x: Vec3, steps: Int) -> Float {
    let c = proxy_cell_at(frame, x);
    let d = m.at - x;
    let dist = length(d);
    let dir = d / max(dist, 0.0001);
    let far = dist - m.size - c;
    let r = loop 32 with r = vec2(c, 1.0) until r.x > far || r.y < 0.02 || index() >= steps {
        let h = rough_probe(proxy, land, frame, x + dir * r.x).x;
        vec2(r.x + max(h, far / float(max(steps, 1))), min(r.y, 6.0 * h / r.x))
    };
    return saturate(r.y);
}

/// The light every lamp gives a point of the coarse scene at `p` facing
/// `n`, of color `albedo`, diffusely reflected (what a bounce off the
/// proxies brings back), each lamp that casts shadows walked toward in
/// `steps` steps (0: unshadowed).
fn lamps_on_rough(lamps: Lamps, lamp_looks: LampLooks, albedo: Vec3, p: Vec3, n: Vec3, proxy: Volume<Vec4>, land: Grid<Float>, frame: Proxies, steps: Int) -> Vec3 {
    let k = min(count(lamps), lamps_most());
    let e = loop 128 with sum = vec3(0.0, 0.0, 0.0) until index() >= k {
        let m = at(lamps, index());
        let d = m.at - p;
        let facing = dot(n, d);
        if m.reach <= 0.0 || facing <= 0.0 || dot(d, d) > m.reach * m.reach { sum } else {
            let cut = if m.shadow != 0 && steps > 0 { lamp_rough_shadow(m, proxy, land, frame, p + n * (proxy_cell_at(frame, p) * 0.6), steps) } else { 1.0 };
            sum + lamp_irradiance(m, p, lamp_looks) * (facing / length(d) * cut)
        }
    };
    return albedo * e / 3.14159265;
}

/// The light every lamp gives a surface of the coarse scene at `p` facing `n`, of color `albedo`, diffusely reflected, each
/// lamp that casts shadows walked toward in full (`lamp_shadow`, its steps set on by `jitter`, 0 to 1), so a thin thing (a
/// desk's board) shadows what lies under it as it does on the screen: what a cache of the light leaving surfaces keeps.
fn lamps_on_surface(lamps: Lamps, lamp_looks: LampLooks, albedo: Vec3, p: Vec3, n: Vec3, proxy: Volume<Vec4>, land: Grid<Float>, frame: Proxies, jitter: Float) -> Vec3 {
    let k = min(count(lamps), lamps_most());
    let e = loop 128 with sum = vec3(0.0, 0.0, 0.0) until index() >= k {
        let m = at(lamps, index());
        let d = m.at - p;
        let facing = dot(n, d);
        if m.reach <= 0.0 || facing <= 0.0 || dot(d, d) > m.reach * m.reach { sum } else {
            let cut = if m.shadow != 0 { lamp_shadow(m, proxy, land, frame, p, n, jitter) } else { 1.0 };
            sum + lamp_irradiance(m, p, lamp_looks) * (facing / length(d) * cut)
        }
    };
    return albedo * e / 3.14159265;
}

/// The lowest lamp a tile's bits keep (-1 none).
fn lamp_first(bits: IVec4) -> Int {
    return if bits.x != 0 { ctz(bits.x) } else if bits.y != 0 { 32 + ctz(bits.y) } else if bits.z != 0 { 64 + ctz(bits.z) } else if bits.w != 0 { 96 + ctz(bits.w) } else { -1 };
}
/// The bits with lamp `k`'s cleared.
fn lamp_cleared(bits: IVec4, k: Int) -> IVec4 {
    let off = (1 << (k % 32)) ^ -1;
    return if k < 32 { ivec4(bits.x & off, bits.y, bits.z, bits.w) } else if k < 64 { ivec4(bits.x, bits.y & off, bits.z, bits.w) }
        else if k < 96 { ivec4(bits.x, bits.y, bits.z & off, bits.w) } else { ivec4(bits.x, bits.y, bits.z, bits.w & off) };
}
/// A walk over a tile's lamps: those left, and the light so far.
struct LampWalk { left: IVec4; light: Vec3; }

/// The light the lamps a tile keeps (`bits`) give a surface of material `m`
/// at `p` facing `n`, seen from `v` (`t` meters from the eye, pixel `q`):
/// each as the sun would light it (`lit_by`), its bulb's size widening the
/// highlight; a lamp that casts shadows shadowed through the proxies and,
/// within `contact` meters, on the screen (as far as `reach` says).
fn lamps_at(lamps: Lamps, lamp_looks: LampLooks, bits: IVec4, m: Pbr, p: Vec3, n: Vec3, v: Vec3, t: Float, q: Vec2,
    surface: Grid<Vec4>, l: Lens, proxy: Volume<Vec4>, land: Grid<Float>, frame: Proxies, maps: Grid<Int>, contact: Float, reach: ContactReach) -> Vec3 {
    let walked = loop 128 with w = LampWalk { left: bits, light: vec3(0.0, 0.0, 0.0) } until lamp_first(w.left) < 0 {
        let k = lamp_first(w.left);
        let left = lamp_cleared(w.left, k);
        // A bit past the rows handed over is none (the tiles never set one).
        let lamp = at(lamps, min(k, count(lamps) - 1));
        let light = if k < count(lamps) { lamp_irradiance(lamp, p, lamp_looks) } else { vec3(0.0, 0.0, 0.0) };
        if max(light.x, max(light.y, light.z)) < 0.00001 { LampWalk { left: left, light: w.light } } else {
            let d = lamp.at - p;
            let dist = length(d);
            let to = d / max(dist, 0.0001);
            let facing = dot(n, to) > -0.2 || m.subsurface > 0.0;
            if !facing { LampWalk { left: left, light: w.light } } else {
                // A sphere light: the highlight widened by the bulb as seen from here (Karis).
                let widened = sqrt(saturate(pbr_alpha(m.rough) + lamp.size / (2.0 * max(dist, 0.01))));
                let shade = if lamp.shadow == 0 { 1.0 } else {
                    let turn = interleaved_noise(q);
                    let slot = lamp_map_slot(lamps, maps, k);
                    let far = if slot >= 0 { lamp_map_seen(maps, slot, lamp, p, n, turn) } else { lamp_shadow(lamp, proxy, land, frame, p, n, turn) };
                    let near = if dist < contact { 1.0 - contact_shadow(surface, l, size(surface), p, n, to, t, 8, 0.5, reach) } else { 1.0 };
                    far * near
                };
                let given = if lamp_is_panel(lamp) { panel_light(lamp, m, p, n, v) } else { lit_by(Pbr { ..m, rough: max(m.rough, widened) }, n, v, to, light) };
                LampWalk { left: left, light: w.light + given * shade }
            }
        }
    };
    return walked.light;
}

/// No lamps: one that reaches nowhere, for a scene that hands over none.
kernel light.lamps_none@1 {
    requires { field.write; }
    output result: Lamps;
    compute { return point_lamp(vec3(0.0, 0.0, 0.0), 0.0, vec3(0.0, 0.0, 0.0), 0.0, 0); }
}

/// No lamp looks: one white texel (`domain = vec2(1, 1)`), for lamps that take none.
kernel light.lamp_looks_none@1 {
    requires { field.write; }
    output result: LampLooks;
    compute { return vec4(1.0, 1.0, 1.0, 1.0); }
}

/// The nearest and furthest each tile of 16 by 16 pixels shows (meters along
/// the view ray; x `no_hit` where it is all sky).
kernel light.lamps_depth@1 {
    requires { field.read; field.write; }
    input surface: Grid<Vec4>;
    output result: Grid<Vec2>;
    compute {
        let lo = coord() * lamp_tile();
        let ext = size(surface);
        return loop 256 with r = vec2(no_hit(), 0.0) {
            let q = lo + vec2(float(index() % 16), float(index() / 16));
            let w = if q.x < ext.x && q.y < ext.y { at(surface, q).w } else { no_hit() };
            if w < no_hit() * 0.5 { vec2(min(r.x, w), max(r.y, w)) } else { r }
        };
    }
}

/// Which lamps reach what each tile shows: 128 bits, lamp k's bit k % 32 of
/// component k / 32. A lamp is kept where its sphere of reach falls on the
/// tile on the screen and overlaps the distances the tile shows; with
/// `through` meters given (above 0), every distance from the eye to that
/// far, as the air along the view rays is lit (fog).
kernel light.lamps_tiles@1 {
    requires { field.read; field.write; }
    input depth: Grid<Vec2>;
    input lamps: Lamps;
    input lens: Lenses;
    /// The G-buffer the tiles cut (its size).
    input surface: Grid<Vec4>;
    param through: Float = 0.0;
    output result: Grid<IVec4>;
    compute {
        let seen = sample(depth);
        let span = if through > 0.0 { vec2(0.0, through) } else { seen };
        if span.x > no_hit() * 0.5 { return ivec4(0, 0, 0, 0); }
        let l = at(lens, 0);
        let ext = size(surface);
        let lo = coord() * lamp_tile();
        let hi = min(lo + lamp_tile(), ext);
        let n = min(count(lamps), lamps_most());
        return loop 128 with bits = ivec4(0, 0, 0, 0) until index() >= n {
            let m = at(lamps, index());
            let toward = m.at - l.eye;
            let far = length(toward);
            let ahead = dot(toward, l.ahead);
            // The distances along the view rays the lamp's sphere covers.
            let near_enough = m.reach > 0.0 && far - m.reach <= span.y && far + m.reach >= span.x;
            // On the screen: the eye inside the sphere, or the projected
            // circle (widened for the lens's slant) meeting the tile.
            let px = project(l, m.at, ext);
            let r = m.reach * l.focal * ext.y / max(ahead, 0.001) * 1.25;
            let gap = max(max(lo - vec2(px.x, px.y), vec2(px.x, px.y) - hi), vec2(0.0, 0.0));
            let seen = far <= m.reach * 1.05 || (ahead > 0.0 - m.reach && (ahead <= 0.0 || length(gap) <= r));
            let b = lamp_bit(index());
            if near_enough && seen { ivec4(bits.x | b.x, bits.y | b.y, bits.z | b.z, bits.w | b.w) } else { bits }
        };
    }
}
/// Lamp `k`'s bit alone.
fn lamp_bit(k: Int) -> IVec4 {
    let b = 1 << (k % 32);
    return if k < 32 { ivec4(b, 0, 0, 0) } else if k < 64 { ivec4(0, b, 0, 0) } else if k < 96 { ivec4(0, 0, b, 0) } else { ivec4(0, 0, 0, b) };
}

/// The lamps' light on each pixel's surface (rgb; the sky none), from the
/// lamps its tile keeps: what `light.lamps_shade` adds and the probes
/// renderer takes in. Contact shadows reach `contact` meters from a lamp.
kernel light.lamps_light@1 {
    requires { field.read; field.write; }
    input surface: Grid<Vec4>;
    input paint: Grid<Vec4>;
    input extra: Grid<Vec4>;
    input layers: Grid<Vec4>;
    input more: Grid<Vec4>;
    input tiles: Grid<IVec4>;
    input lamps: Lamps;
    input lamp_looks: LampLooks;
    input lens: Lenses;
    input proxy: Volume<Vec4>;
    input land: Grid<Float>;
    input frame: Proxies;
    /// The lamps' shadow maps (`graphs/lamp_maps.esn`; `light.lamp_maps_none` for none: each lamp's shadow through the
    /// proxies).
    input maps: Grid<Int>;
    param contact: Float = 30.0;
    /// How far a lamp's contact shadow reaches and how thick what casts it is (`ContactReach`, as `light.contact`'s).
    param contact_length: Float = 0.025;
    param contact_longest: Float = 0.3;
    param contact_thick: Float = 0.01;
    param contact_thickest: Float = 0.15;
    output result: Image;
    compute {
        let s = sample(surface);
        if s.w > no_hit() * 0.5 { return vec4(0.0, 0.0, 0.0, 1.0); }
        let q = coord();
        let l = at(lens, 0);
        let dir = ray(l, q, size(surface));
        let bits = at(tiles, min(floor(q / lamp_tile()), size(tiles) - vec2(1.0, 1.0)));
        if lamp_first(bits) < 0 { return vec4(0.0, 0.0, 0.0, 1.0); }
        let m = pbr_of(sample(paint), sample(extra), sample(layers), sample(more));
        let light = lamps_at(lamps, lamp_looks, bits, m, l.eye + dir * s.w, s.xyz, vec3(0.0, 0.0, 0.0) - dir, s.w, q,
            surface, l, proxy, land, frame, maps, contact, ContactReach { length: contact_length, longest: contact_longest, thick: contact_thick, thickest: contact_thickest });
        return vec4(light.x, light.y, light.z, 1.0);
    }
}

/// A renderer's picture `hdr` with the lamps' light (`light.lamps_light`)
/// added: for a renderer that does not take the lamps in itself.
kernel light.lamps_shade@1 {
    requires { field.read; field.write; }
    input hdr: Image;
    input light: Image;
    output result: Image;
    compute {
        let c = sample(hdr);
        let add = sample(light);
        return vec4(c.x + add.x, c.y + add.y, c.z + add.z, c.w);
    }
}
