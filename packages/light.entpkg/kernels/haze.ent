// Haze: aerial perspective after the real atmosphere: air thins with height (Rayleigh's molecules by e every eight kilometers, Mie's haze
// every twelve hundred meters), and the air passed along a view ray is integrated; molecules scatter blue the most (far things
// turn blue and lose contrast), haze scatters forward (a bright ring toward the sun). The sun and the sky round it light the air
// passed, scattered once.
use "geometry.entpkg";
use "surface.entpkg";
use "sky.ent";

// How much air of the ground's density a ray from height `h` (meters above
// the ground) going `dy` up a meter passes through in `d` meters, the air
// thinning by e every `scale` meters up.
fn haze_through(h: Float, dy: Float, d: Float, scale: Float) -> Float {
    let at_eye = exp(0.0 - clamp(h / scale, -20.0, 20.0));
    if abs(dy) < 0.0001 { return d * at_eye; }
    let k = clamp(d * dy / scale, -20.0, 20.0);
    return at_eye * scale / dy * (1.0 - exp(0.0 - k));
}

/// How the air looks, a scene's to tune: `density` scales the air's density (1 is a clear day's atmosphere made visible
/// across a scene of a few kilometers), `haze` scales the haze, `ground` is the ground's height (meters), `air_height`
/// and `haze_height` how high the molecules and the haze thin by e (meters), `forward` how strongly the haze scatters
/// toward the sun (0 evenly, toward 1 all into the sun's glow), `sun_glow` and `sky_glow` how bright the sun's light and
/// the sky's scattered in the air are.
struct Haze { density: Float; haze: Float; ground: Float; air_height: Float; haze_height: Float; forward: Float; sun_glow: Float; sky_glow: Float; }

/// The air as the package ships it.
fn haze_default() -> Haze {
    return Haze { density: 1.0, haze: 1.0, ground: 0.0, air_height: 8000.0, haze_height: 1200.0, forward: 0.76, sun_glow: 1.2, sky_glow: 0.45 };
}

/// Light `c` seen from `eye` along `dir` across `t` meters of the air `h`, under the sky `s`: dimmed by the air passed,
/// and the light the air scattered toward the eye laid in.
fn hazed(c: Vec3, eye: Vec3, dir: Vec3, t: Float, s: SkyLook, h: Haze) -> Vec3 {
    let height = eye.y - h.ground;
    let rayleigh = haze_through(height, dir.y, t, h.air_height);
    let mie = haze_through(height, dir.y, t, h.haze_height);
    let beta_r = vec3(5.8, 13.5, 33.1) * (0.000006 * h.density);
    let beta_m = vec3(21.0, 21.0, 21.0) * (0.000006 * h.density * h.haze);
    let spent = beta_r * rayleigh + beta_m * (mie * 1.1);
    let kept = vec3(exp(0.0 - spent.x), exp(0.0 - spent.y), exp(0.0 - spent.z));
    // Phase: Rayleigh's, and Mie's forward lobe (Henyey-Greenstein).
    let mu = dot(dir, normalize(s.sun));
    let phase_r = 0.0597 * (1.0 + mu * mu);
    let g = h.forward;
    let phase_m = 0.0796 * (1.0 - g * g) / pow(max(1.0 + g * g - 2.0 * g * mu, 0.0001), 1.5);
    let lit = beta_r * (rayleigh * phase_r) + beta_m * (mie * phase_m);
    let share = lit / max(spent, vec3(0.000001, 0.000001, 0.000001));
    let scattered = s.sun_color * share * h.sun_glow + (s.horizon * 0.75 + s.zenith * 0.25) * h.sky_glow;
    return c * kept + scattered * (vec3(1.0, 1.0, 1.0) - kept);
}

type Hazes = Rows<Haze>;

/// One air made from these parameters (`domain = 1`), for a node to hand on or a scene's kernel to start from (a weather
/// thickening it, a story clearing it).
kernel light.haze_start@1 {
    requires { field.write; }
    param density: Float = 1.0;
    param haze: Float = 1.0;
    param ground: Float = 0.0;
    param air_height: Float = 8000.0;
    param haze_height: Float = 1200.0;
    param forward: Float = 0.76;
    param sun_glow: Float = 1.2;
    param sky_glow: Float = 0.45;
    output result: Hazes;
    compute {
        return Haze { density: density, haze: haze, ground: ground, air_height: air_height, haze_height: haze_height, forward: forward,
            sun_glow: sun_glow, sky_glow: sky_glow };
    }
}

/// Aerial perspective (see the file's head, `hazed`) over a picture (`hdr`, HDR) through the air `air`'s first row, the
/// sky left as it is (it has its own look); `on` 0 leaves it all as it is.
kernel light.haze@1 {
    requires { field.read; field.write; }
    input hdr: Image;
    input surface: Grid<Vec4>;
    input lens: Lenses;
    input sky: SkyLooks;
    input air: Hazes;
    param on: Int = 1;
    output result: Image;
    compute {
        let c = sample(hdr);
        if on == 0 { return c; }
        let su = sample(surface);
        if su.w > no_hit() * 0.5 || su.w <= 0.0 { return c; }
        let l = at(lens, 0);
        let shown = hazed(c.xyz, l.eye, ray(l, coord(), domain()), su.w, at(sky, 0), at(air, 0));
        return vec4(shown.x, shown.y, shown.z, c.w);
    }
}
