// Light kept on the proxies, as Lumen keeps its surface cache: a volume laid as the proxy is, a level for each of its levels
// at a coarser cell (`light.radiance_frame`), each cell near a surface holding the light leaving that surface: its color times
// the sun and the lamps through the proxies (`lamps_on_surface`), the sky the proxies leave open (as lit has it, `hemisphere` and `proxy_open`), and the light
// the cache itself gathers from the things round it, so it bounces again frame after frame (`light.radiance`). A share of
// its cells is lit anew each frame, the rest kept from the last frame's, found by where they lie, so a block moved on keeps
// what it held. A renderer's picture then takes the light bounced off the things round each pixel: cones traced through the
// proxy, each step read in the level whose cells are as wide as the cone there, what the cache holds laid nearer first over
// what lies past it (`radiance_cone`, `light.bounce`). `graphs/bounce.esn` is the whole.
use "random.entpkg";
use "geometry.entpkg";
use "brdf.ent";
use "surface.entpkg";
use "lamps.ent";
use "ambient.ent";
use "sky.ent";

/// A frame's levels held at hand (at most eight): each level's row, how deep in the volume its cells start, how many levels.
struct ProxyLevels { rows: [Proxy; 8]; depth: [Float; 8]; n: Int; }

fn proxy_levels(frame: Proxies) -> ProxyLevels {
    let n = min(count(frame), 8);
    let rows = [each 8 { at(frame, min(index(), n - 1)) }];
    let depth = [each 8 { loop index() with z = 0.0 { z + rows[index()].cells.z } }];
    return ProxyLevels { rows: rows, depth: depth, n: n };
}

/// The finest of levels `v` from level `first` up holding `p`; -1 none.
fn proxy_levels_find(v: ProxyLevels, p: Vec3, first: Int) -> Int {
    return loop v.n with k = -1 {
        let fr = v.rows[index()];
        let c = (p - fr.lo) / fr.cell;
        let n = fr.cells - vec3(1.0, 1.0, 1.0);
        let inside = c.x >= 0.0 && c.y >= 0.0 && c.z >= 0.0 && c.x <= n.x && c.y <= n.y && c.z <= n.z;
        if k < 0 && index() >= first && inside { index() } else { k }
    };
}

/// The cell of the finest of levels `v` holding `p` (the coarsest's past them all): how far a ray or a cone leaving a
/// surface there must go before what it meets is not the surface's own shell.
fn proxy_levels_cell(v: ProxyLevels, p: Vec3) -> Float {
    let k = proxy_levels_find(v, p, 0);
    return v.rows[if k < 0 { v.n - 1 } else { k }].cell;
}

/// Volume `vol`, laid as levels `v` are, at `p` in level `k` (trilinear).
fn proxy_levels_at(vol: Volume<Vec4>, v: ProxyLevels, p: Vec3, k: Int) -> Vec4 {
    let fr = v.rows[k];
    let c = (p - fr.lo) / fr.cell;
    return at_linear(vol, vec3(c.x, c.y, c.z + v.depth[k]) + 0.5);
}

/// The light a cone from `o` along `dir` meets in the cache (`radiance`, laid as levels `rv` are; the proxy's levels `pv`),
/// its radius growing `spread` meters a meter: each step read in the first level whose cells are as wide as the cone there,
/// shut by how near the proxy's things are against the cone's width, what the cache holds there laid behind what is nearer
/// (rgb), and how much the cone is shut in all (w), from `start` out to `far` in at most `steps`. Light is taken only from
/// a surface that faces back along the cone (the proxy's slope there), so what a thin wall's far side holds, or the
/// surface the cone leaves from, is not taken for light coming toward `o`.
fn radiance_cone(radiance: Volume<Vec4>, rv: ProxyLevels, proxy: Volume<Vec4>, pv: ProxyLevels, land: Grid<Float>, o: Vec3, dir: Vec3, spread: Float, start: Float, far: Float, steps: Int) -> Vec4 {
    let fine = proxy_levels_cell(pv, o);
    let r = loop steps with a = [vec4(0.0, 0.0, 0.0, 0.0), vec4(start, 0.0, 0.0, 0.0)] {
        let t = a[1].x;
        let p = o + dir * t;
        let w = max(t * spread, fine * 0.5);
        let wide = loop pv.n with k = -1 { if k < 0 && pv.rows[index()].cell >= w * 0.75 { index() } else { k } };
        let k = proxy_levels_find(pv, p, if wide < 0 { pv.n - 1 } else { wide });
        if k < 0 || a[0].w > 0.97 || t > far { break a; }
        let rock = proxy_levels_at(proxy, pv, p, k).x;
        // The ground (the height map, as `rough_probe` takes it) where it is nearer than the things.
        let ground = (p.y - land_at_row(land, pv.rows[0], p.x, p.z) - 0.03) * 0.85;
        let on_ground = ground < rock;
        let d = min(rock, ground);
        let shut = saturate(1.0 - d / w);
        let held = if k < rv.n { proxy_levels_at(radiance, rv, p, k) } else { vec4(0.0, 0.0, 0.0, 0.0) };
        let lit = held.w > 0.001 && shut > 0.0;
        let e = pv.rows[k].cell;
        let facing = if lit && on_ground { saturate(0.5 - dir.y) } else if lit {
            let slope = vec3(proxy_levels_at(proxy, pv, p + vec3(e, 0.0, 0.0), k).x - rock, proxy_levels_at(proxy, pv, p + vec3(0.0, e, 0.0), k).x - rock,
                proxy_levels_at(proxy, pv, p + vec3(0.0, 0.0, e), k).x - rock);
            saturate(0.5 - dot(slope, dir) / max(length(slope), 0.000001))
        } else { 0.0 };
        let light = held.xyz / max(held.w, 0.05) * (saturate(held.w * 4.0) * facing);
        let left = 1.0 - a[0].w;
        [vec4(a[0].xyz + light * (left * shut), a[0].w + left * shut), vec4(t + max(max(d * 0.8, w * 0.7), fine * 0.5), 0.0, 0.0, 0.0)]
    };
    return r[0];
}

/// The cache's frame: the proxy's levels, each `scale` times coarser over the same block, its cells no finer than `least`
/// meters (a fine level of the proxy near the eye, for the thin things a ray meets, needs no cache as fine: the light held
/// there is the bounce's, which is soft).
kernel light.radiance_frame@1 {
    requires { field.read; field.write; }
    input frame: Proxies;
    param scale: Float = 2.0;
    param least: Float = 0.0;
    output result: Proxies;
    compute {
        let fr = sample(frame);
        let cell = max(fr.cell * scale, least);
        return Proxy { ..fr, cell: cell, cells: if least > fr.cell * scale { ceil(fr.cells * fr.cell / cell) } else { ceil(fr.cells / scale) } };
    }
}

/// How many cells the cache holds a side (`domain = 3`): its levels' widest across and up, and their depths summed.
kernel light.radiance_size@1 {
    requires { field.read; field.write; }
    input rframe: Proxies;
    output result: Rows<Int>;
    compute {
        let c = loop count(rframe) with c = vec3(0.0, 0.0, 0.0) { let n = at(rframe, index()).cells; vec3(max(c.x, n.x), max(c.y, n.y), c.z + n.z) };
        let k = element();
        return int(if k == 0 { c.x } else if k == 1 { c.y } else { c.z });
    }
}

/// A level's corner and cell, as a hash.
fn radiance_level_sign(fr: Proxy) -> Int {
    return mul_wrap(bits(fr.lo.x), 73856093) ^ mul_wrap(bits(fr.lo.y), 19349663) ^ mul_wrap(bits(fr.lo.z), 83492791) ^ mul_wrap(bits(fr.cell), 0x9E3779B1);
}
/// How many frames level `i` of `frame` has held still, by the turn before (`previous`, `held` when it is one), no more than
/// `settle` and one.
fn radiance_level_quiet(previous: Rows<Int>, frame: Proxies, i: Int, held: Bool, settle: Int) -> Int {
    return if held && radiance_level_sign(at(frame, i)) == at(previous, 12 + i) { min(at(previous, 4 + i) + 1, settle + 1) } else { 0 };
}

/// The cache's turn (`domain = 20`): how many frames it has been lit (row 0); how many since the sun or the lamps last moved
/// (1, no more than `settle` and one) and what they were (2, a hash); 1 once it rests (3); and for each of up to eight
/// levels of the proxy's frame, how many frames since its block last moved (4 to 11, as row 1) and where it was (12 to 19,
/// `radiance_level_sign`). A level is lit while the light or its own block moved within `settle` frames, so a fine level
/// moving with the eye is lit again alone while the scene's own levels rest; once none is lit the cache rests and gives
/// what it held, so what reads it rests too.
kernel light.radiance_turn@1 {
    requires { field.read; field.write; }
    input previous: Rows<Int>;
    input frame: Proxies;
    input sky: SkyLooks;
    input lamps: Lamps;
    param settle: Int = 32;
    output result: Rows<Int>;
    compute {
        let k = element();
        let held = count(previous) == 20;
        let sun = at(sky, 0).sun;
        let light = mul_wrap(bits(sun.x), 40503) ^ mul_wrap(bits(sun.y), 9973) ^ mul_wrap(bits(sun.z), 31)
            ^ loop min(count(lamps), lamps_most()) with h = 17 {
                let m = at(lamps, index());
                mul_wrap(h, 31) ^ bits(m.at.x) ^ mul_wrap(bits(m.at.y), 7) ^ mul_wrap(bits(m.at.z), 13) ^ mul_wrap(bits(m.color.x + m.color.y + m.color.z), 101) ^ bits(m.reach)
            };
        let light_quiet = if held && light == at(previous, 2) { min(at(previous, 1) + 1, settle + 1) } else { 0 };
        let levels = min(count(frame), 8);
        let busiest = loop levels with b = settle + 1 { min(b, radiance_level_quiet(previous, frame, index(), held, settle)) };
        let lit = light_quiet <= settle || busiest <= settle;
        return if k == 0 { if !held { 1 } else if lit { at(previous, 0) + 1 } else { at(previous, 0) } }
            else if k == 1 { light_quiet } else if k == 2 { light } else if k == 3 { if lit { 0 } else { 1 } }
            else if k < 12 { if k - 4 < levels { radiance_level_quiet(previous, frame, k - 4, held, settle) } else { settle + 1 } }
            else if k - 12 < levels { radiance_level_sign(at(frame, k - 12)) } else { 0 };
    }
}

/// The level of the cache's blocks (`rframe`, nested and laid one after another along z) cell layer `z` lies in: its place
/// (x) and the layers before it (y).
fn radiance_level_of(rframe: Proxies, z: Float) -> Vec2 {
    return loop 8 with k = vec2(0.0, 0.0) until index() >= count(rframe) - 1 {
        let depth = k.y + at(rframe, int(k.x)).cells.z;
        if z < depth || int(k.x) >= count(rframe) - 1 { k } else { vec2(k.x + 1.0, depth) }
    };
}

/// The light coming to a surface at `on` facing `n` from all round it: four cones through the cache (`radiance`, its blocks
/// `rv`; `proxy` and `land` stopping them), leaning off the normal and turned `spin` about it, each `spread` wide, starting
/// `start` out and reaching `reach` in `steps`, averaged.
fn radiance_round(radiance: Volume<Vec4>, rv: ProxyLevels, proxy: Volume<Vec4>, pv: ProxyLevels, land: Grid<Float>, on: Vec3, n: Vec3,
        spin: Float, spread: Float, start: Float, reach: Float, steps: Int) -> Vec3 {
    let t = tangent_of(n);
    let b = cross(n, t);
    return loop 4 with g = vec3(0.0, 0.0, 0.0) {
        let a = float(index()) * 1.5707963 + spin;
        let dir = normalize(n + (t * cos(a) + b * sin(a)) * 0.9);
        g + radiance_cone(radiance, rv, proxy, pv, land, on, dir, spread, start, reach, steps).xyz * 0.25
    };
}

/// The cache, cell by cell (`domain` the cache's frame's cells, its levels up its depth): a cell within `band` of its cells
/// of a surface the light leaving it (rgb, w 1), the rest none; one in `parts` lit anew each frame (by `turn`), the others
/// kept from `previous` (laid as `previous_frame` says) where they lie; a level at rest (its light and its block still past
/// `settle` frames, `turn`'s), and the whole at rest, `previous` as it is. The light: the surface's color times the sun through
/// the proxies (`sun_steps` steps), the lamps (each walked toward in full), the sky open over it (`Surround`, `Openness` as lit's), and `bounce` times what four
/// cones gather from the last frame's cache, so light bounces once more each time a cell is lit; the cones turned anew
/// each time, and a cell lit again `blend` of the way from what it held to what it gathers now while the light it is lit by
/// and its block keep still, so the few cones' guesses average out rather than lying in blotches.
kernel light.radiance@1 {
    requires { field.read; field.write; }
    input previous: Volume<Vec4>;
    input previous_frame: Proxies;
    input proxy: Volume<Vec4>;
    input land: Grid<Float>;
    input frame: Proxies;
    input rframe: Proxies;
    input sky: SkyLooks;
    input lamps: Lamps;
    input lamp_looks: LampLooks;
    input turn: Rows<Int>;
    /// How many cells the cache holds a side (`light.radiance_size`; sizes the node).
    input size: Rows<Int>;
    param parts: Int = 4;
    param band: Float = 1.5;
    param sun_steps: Int = 32;
    param bounce: Float = 1.0;
    param spread: Float = 0.6;
    param reach: Float = 24.0;
    param cone_steps: Int = 8;
    param ground: Vec3 = vec3(0.34, 0.29, 0.22);
    param ground_light: Float = 1.6;
    param sky_light: Float = 1.15;
    param open_reach: Vec3 = vec3(0.4, 1.2, 2.5);
    param open_strength: Float = 1.6;
    param open_least: Float = 0.1;
    param blend: Float = 0.25;
    /// As the turn's (`light.radiance_turn`): a level lit while its light or its block moved within this many frames.
    param settle: Int = 32;
    output result: Volume<Vec4>;
    compute {
        let c = coord();
        let lv = radiance_level_of(rframe, c.z);
        let fr = at(rframe, int(lv.x));
        let p = fr.lo + vec3(c.x, c.y, c.z - lv.y) * fr.cell;
        let held = if isize(previous) == idomain() { at(previous, icoord()) } else { vec4(0.0, 0.0, 0.0, 0.0) };
        if at(turn, 3) == 1 { return held; }
        // A level whose block and whose light have held still past settling is as it was (its block unmoved: its cells
        // where they were).
        let quiet = min(at(turn, 1), at(turn, 4 + min(int(lv.x), 7)));
        if quiet > settle { return held; }
        // The nearest surface, a thing's or the ground's.
        let near = rough_probe(proxy, land, frame, p);
        let d = near.x;
        if abs(d) > band * fr.cell { return vec4(0.0, 0.0, 0.0, 0.0); }
        let old = proxy_at(previous, previous_frame, p, 0.0);
        let ci = ivec3(int(c.x), int(c.y), int(c.z));
        let mine = (ci.x + ci.y * 2 + ci.z * 3 + at(turn, 0)) % max(parts, 1) == 0;
        if !mine && old.w > 0.5 { return old; }
        let s = at(sky, 0);
        let n = rough_normal(proxy, land, frame, p, near.y);
        let on = p - n * d;
        let albedo = rough_albedo(proxy, frame, on, near.y);
        let ndl = max(dot(n, s.sun), 0.0);
        let lit = if ndl > 0.0 { rough_shadow(proxy, land, frame, on + n * fr.cell * 0.5, s.sun, fr.cell * 0.5, 400.0, sun_steps) } else { 0.0 };
        let look = Surround { ground: ground, ground_light: ground_light, sky_light: sky_light };
        let open = proxy_open(proxy, frame, on + n * 0.1, n, Openness { reach: open_reach, strength: open_strength, least: open_least });
        let spin = fract(float(at(turn, 0) / max(parts, 1)) * 0.618034) * 6.2831853;
        let gathered = radiance_round(previous, proxy_levels(previous_frame), proxy, proxy_levels(frame), land, on, n, spin, spread, fr.cell * 1.5,
            reach, cone_steps);
        let lamped = lamps_on_surface(lamps, lamp_looks, albedo, on, n, proxy, land, frame, fract(float(ci.x * 7 + ci.y * 13 + ci.z * 29) * 0.618034));
        let light = albedo * (s.sun_color * (ndl * lit / 3.14159265) + hemisphere(n, s, look) * open + gathered * bounce) + lamped;
        let still = quiet > 1 && old.w > 0.5;
        let kept = if still { mix(old.xyz, light, blend) } else { light };
        return vec4(kept.x, kept.y, kept.z, 1.0);
    }
}

/// The light coming to `p` (facing `n`) from the half round it, as three colors' first harmonics (red, green, blue): `rays` rays
/// spread evenly over the half and turned by `own`, each traced on the screen (`screen` lit, `surface` its G-buffer, `l` its
/// lens; `screen_reach` far in `screen_steps`, 0 none) and else through the cache (`radiance`, its blocks `rv`), as the cones of
/// `radiance_cone` (`spread`, `start`, `reach`, `steps`).
fn probe_harmonics(screen: Image, surface: Grid<Vec4>, l: Lens, radiance: Volume<Vec4>, rv: ProxyLevels, proxy: Volume<Vec4>, pv: ProxyLevels,
        land: Grid<Float>, p: Vec3, n: Vec3, own: Float, rays: Int, spread: Float, start: Float, reach: Float, steps: Int, screen_reach: Float,
        screen_steps: Int) -> [Vec4; 3] {
    let none = vec4(0.0, 0.0, 0.0, 0.0);
    let t = tangent_of(n);
    let b = cross(n, t);
    let k = max(rays, 1);
    let share = 6.2831853 / float(k);
    return loop 64 with a = [none, none, none] until index() >= k {
        let c = 1.0 - (float(index()) + 0.5) / float(k);
        let s = sqrt(max(1.0 - c * c, 0.0));
        let phi = float(index()) * 2.3999632 + own * 6.2831853;
        let way = normalize(t * (s * cos(phi)) + b * (s * sin(phi)) + n * c);
        let hit = if screen_reach > 0.0 { screen_march(surface, l, size(surface), p, way, screen_reach, screen_steps, 0.3, own) } else { vec3(0.0, 0.0, -1.0) };
        let seen = if hit.z >= 0.0 { at_linear(screen, (hit.xy + 0.5) * size(screen) / size(surface)).xyz } else { radiance_cone(radiance, rv, proxy, pv, land, p, way, spread, start, reach, steps).xyz };
        let y = vec4(0.282095, way.x * 0.488603, way.y * 0.488603, way.z * 0.488603) * share;
        [a[0] + y * seen.x, a[1] + y * seen.y, a[2] + y * seen.z]
    };
}

/// The light coming into each probe of the screen (`domain = ceil(size(surface) / probe)`, a probe in the middle of each
/// `probe` by `probe` pixels; Lumen's screen probes): `rays` rays over the hemisphere about the surface it stands on, laid
/// evenly (a Fibonacci spiral in the cosine, uniform over the hemisphere, turned by the probe's own hash so neighbors do not
/// line up), each first followed on the screen `screen_reach` meters (where it meets what the screen shows, the light
/// leaving that, `screen`'s, comes back along it), then through the cache as a cone `spread` meters a meter wide; what comes
/// in kept as first-order spherical harmonics, a color each (`red`, `green`, `blue`: the constant x, the linear yzw along
/// world x, y, z), and where the probe stands (`place`: its normal xyz, its distance w; the sky's for none).
kernel light.bounce_probes@1 {
    requires { field.read; field.write; }
    input screen: Image;
    input surface: Grid<Vec4>;
    input lens: Lenses;
    input radiance: Volume<Vec4>;
    input rframe: Proxies;
    input proxy: Volume<Vec4>;
    input frame: Proxies;
    input land: Grid<Float>;
    param probe: Int = 8;
    param rays: Int = 32;
    param spread: Float = 0.35;
    param reach: Float = 30.0;
    param steps: Int = 10;
    param screen_reach: Float = 1.0;
    param screen_steps: Int = 12;
    output red: Image;
    output green: Image;
    output blue: Image;
    output place: Image;
    compute {
        let none = vec4(0.0, 0.0, 0.0, 0.0);
        let q = min(floor(coord()) * float(probe) + float(probe / 2), size(surface) - 1.0);
        let su = at(surface, q);
        if su.w > no_hit() * 0.5 { return { red: none, green: none, blue: none, place: vec4(0.0, 1.0, 0.0, no_hit()) }; }
        let l = at(lens, 0);
        let dir = ray(l, q, size(surface));
        let n = su.xyz;
        let p = l.eye + dir * su.w + n * 0.05;
        let pv = proxy_levels(frame);
        let rv = proxy_levels(rframe);
        let own = interleaved_noise(coord());
        let start = proxy_levels_cell(pv, p) * (1.0 + own);
        let sums = probe_harmonics(screen, surface, l, radiance, rv, proxy, pv, land, p, n, own, rays, spread, start, reach, steps, screen_reach, screen_steps);
        return { red: sums[0], green: sums[1], blue: sums[2], place: vec4(n.x, n.y, n.z, su.w) };
    }
}

/// How much a probe standing at `pl` (its normal, its distance) speaks for a surface facing `n` at distance `d`: alike in
/// distance and in facing.
fn bounce_probe_alike(pl: Vec4, n: Vec3, d: Float) -> Float {
    if pl.w > no_hit() * 0.5 { return 0.0; }
    let near = exp(0.0 - abs(pl.w - d) / (d * 0.03 + 0.05));
    let facing = pow(saturate(dot(pl.xyz, n)), 4.0);
    return near * facing;
}

/// The cosine-weighted mean of the light a probe's harmonics `r`, `g`, `b` hold, for a surface facing `n` (the
/// irradiance over pi: first-order harmonics convolved with the cosine, Ramamoorthi and Hanrahan's).
fn bounce_probe_light(r: Vec4, g: Vec4, b: Vec4, n: Vec3) -> Vec3 {
    let y = vec4(0.282095, n.x * 0.325735, n.y * 0.325735, n.z * 0.325735);
    return vec3(dot(r, y), dot(g, y), dot(b, y));
}

/// The probes smoothed (`domain` the probes'): each the mean of the three by three round it, each by how alike it stands
/// (`bounce_probe_alike`), so a probe's few rays are helped by its neighbors' on the same surface and not by another's.
kernel light.bounce_probe_filter@1 {
    requires { field.read; field.write; }
    input red: Image;
    input green: Image;
    input blue: Image;
    input place: Image;
    output r: Image;
    output g: Image;
    output b: Image;
    compute {
        let c = coord();
        let me = sample(place);
        if me.w > no_hit() * 0.5 { return { r: sample(red), g: sample(green), b: sample(blue) }; }
        let top = size(place) - 1.0;
        let sum = loop 9 with a = [vec4(0.0, 0.0, 0.0, 0.0), vec4(0.0, 0.0, 0.0, 0.0), vec4(0.0, 0.0, 0.0, 0.0), vec4(0.0, 0.0, 0.0, 0.0)] {
            let o = clamp(c + vec2(float(index() % 3) - 1.0, float(index() / 3) - 1.0), vec2(0.0, 0.0), top);
            let w = bounce_probe_alike(at(place, o), me.xyz, me.w) * (if index() == 4 { 2.0 } else { 1.0 });
            [a[0] + at(red, o) * w, a[1] + at(green, o) * w, a[2] + at(blue, o) * w, a[3] + vec4(w, 0.0, 0.0, 0.0)]
        };
        let w = max(sum[3].x, 0.000001);
        return { r: sum[0] / w, g: sum[1] / w, b: sum[2] / w };
    }
}

/// What a mirror ray from `p` along `r` meets, lit where it meets it (Lumen's hit lighting): marched through the proxies
/// (`rough_trace`, `steps` steps out to `reach` meters), the thing there its proxy's color and slope, lit by the sun through
/// the proxies, the lamps, the sky open over it (`look`, `open`) and what one cone gathers from the bounce's cache along its
/// slope (rgb), wholly shutting the ray (w 1); a ray meeting nothing shuts none of it (w 0), the renderer's reflection of
/// the sky kept. Off the screen a smooth thing then mirrors the room as sharp as the proxies hold it and as lit as the
/// light there is, not as the cache's wide cells average it.
fn bounce_hit_light(radiance: Volume<Vec4>, rv: ProxyLevels, proxy: Volume<Vec4>, pv: ProxyLevels, land: Grid<Float>, frame: Proxies, s: SkyLook,
    lamps: Lamps, lamp_looks: LampLooks, p: Vec3, r: Vec3, start: Float, reach: Float, steps: Int, cone_steps: Int, look: Surround, open: Openness) -> Vec4 {
    let hit = rough_trace(proxy, land, frame, p, r, start, reach, steps);
    if hit.y < 0.0 { return vec4(0.0, 0.0, 0.0, 0.0); }
    let h = p + r * hit.x;
    let n = rough_normal(proxy, land, frame, h, hit.y);
    let albedo = rough_albedo(proxy, frame, h, hit.y);
    let cell = proxy_cell_at(frame, h);
    let off = h + n * cell;
    let ndl = max(dot(n, s.sun), 0.0);
    let sun = if ndl > 0.0 { rough_shadow(proxy, land, frame, off, s.sun, cell * 0.5, 300.0, 16) * ndl } else { 0.0 };
    let opened = proxy_open(proxy, frame, off, n, open);
    let bounced = radiance_cone(radiance, rv, proxy, pv, land, off, n, 0.6, cell * 1.5, reach, cone_steps).xyz;
    let light = albedo * (s.sun_color * (sun / 3.14159265) + hemisphere(n, s, look) * opened + bounced) + lamps_on_rough(lamps, lamp_looks, albedo, off, n, proxy, land, frame, 8);
    return vec4(light.x, light.y, light.z, 1.0);
}

/// The light the probes (`light.bounce_probe_filter`'s harmonics `red`, `green`, `blue`, their `place`, laid every `probe`
/// pixels) give pixel `q`, facing `n` at distance `d`: the four round it, each by how near and how alike it stands; the
/// nearest alike of the nine round it where none of the four is; none where none is.
fn bounce_probes_at(red: Image, green: Image, blue: Image, place: Image, q: Vec2, probe: Int, n: Vec3, d: Float) -> Vec3 {
    // The probes round q: their grid's coordinates, the probe in each cell standing at its middle.
    let g = (q + 0.5) / float(probe) - 0.5;
    let base = floor(g);
    let f = g - base;
    let top = size(place) - 1.0;
    let four = loop 4 with a = vec4(0.0, 0.0, 0.0, 0.0) {
        let o = vec2(float(index() % 2), float(index() / 2));
        let cell = clamp(base + o, vec2(0.0, 0.0), top);
        let near = (if o.x > 0.5 { f.x } else { 1.0 - f.x }) * (if o.y > 0.5 { f.y } else { 1.0 - f.y });
        let w = (near + 0.001) * bounce_probe_alike(at(place, cell), n, d);
        let light = bounce_probe_light(at(red, cell), at(green, cell), at(blue, cell), n);
        vec4(a.x + light.x * w, a.y + light.y * w, a.z + light.z * w, a.w + w)
    };
    let nine = if four.w > 0.0001 { four } else {
        loop 9 with a = vec4(0.0, 0.0, 0.0, 0.0) {
            let cell = clamp(floor(g + 0.5) + vec2(float(index() % 3) - 1.0, float(index() / 3) - 1.0), vec2(0.0, 0.0), top);
            let w = bounce_probe_alike(at(place, cell), n, d);
            if w > a.w { let light = bounce_probe_light(at(red, cell), at(green, cell), at(blue, cell), n); vec4(light.x * w, light.y * w, light.z * w, w) } else { a }
        }
    };
    return if nine.w > 0.0 { max(nine.xyz / nine.w, vec3(0.0, 0.0, 0.0)) } else { vec3(0.0, 0.0, 0.0) };
}

/// The light bounced off the things round each pixel, at a coarser grid (`domain = ceil(size(surface) / every)`): the
/// probes round a cell's middle pixel (`light.bounce_probe_filter`'s, laid every `probe` pixels), each by how near and how
/// alike it stands, their harmonics read for the cell's own normal (rgb; the nearest alike probe where none of the four is,
/// none where no probe of the nine round it is), and its distance (w; the sky's for none); and `mirror`, one cone along
/// its mirror direction through the cache, as wide as its roughness makes it (rgb), and how much of it the cache's things
/// shut (w).
kernel light.bounce_gather@1 {
    requires { field.read; field.write; }
    input red: Image;
    input green: Image;
    input blue: Image;
    input place: Image;
    input surface: Grid<Vec4>;
    input paint: Grid<Vec4>;
    input lens: Lenses;
    input radiance: Volume<Vec4>;
    input rframe: Proxies;
    input proxy: Volume<Vec4>;
    input land: Grid<Float>;
    input frame: Proxies;
    input sky: SkyLooks;
    input lamps: Lamps;
    input lamp_looks: LampLooks;
    param every: Int = 2;
    param probe: Int = 8;
    /// Surfaces smoother than this trace their mirror ray to what it meets and light it there (0: every one a cone).
    param hit_below: Float = 0.35;
    param hit_steps: Int = 48;
    param ground: Vec3 = vec3(0.34, 0.29, 0.22);
    param ground_light: Float = 1.6;
    param sky_light: Float = 1.15;
    param open_reach: Vec3 = vec3(0.4, 1.2, 2.5);
    param open_strength: Float = 1.6;
    param open_least: Float = 0.1;
    param reach: Float = 30.0;
    param steps: Int = 10;
    output result: Image;
    output mirror: Image;
    compute {
        let q = min(floor(coord() * float(every)) + float(every / 2), size(surface) - 1.0);
        let su = at(surface, q);
        if su.w > no_hit() * 0.5 { return { result: vec4(0.0, 0.0, 0.0, no_hit()), mirror: vec4(0.0, 0.0, 0.0, 0.0) }; }
        let l = at(lens, 0);
        let dir = ray(l, q, size(surface));
        let n = su.xyz;
        let gathered = bounce_probes_at(red, green, blue, place, q, probe, n, su.w);
        let pv = proxy_levels(frame);
        let rv = proxy_levels(rframe);
        let p = l.eye + dir * su.w + n * 0.05;
        let jitter = interleaved_noise(coord());
        let start = proxy_levels_cell(pv, p) * (1.0 + jitter);
        let rough = at(paint, q).w;
        let r = reflect(dir, n);
        let seen = if rough < hit_below {
            bounce_hit_light(radiance, rv, proxy, pv, land, frame, at(sky, 0), lamps, lamp_looks, p, r, start, reach, hit_steps, steps,
                Surround { ground: ground, ground_light: ground_light, sky_light: sky_light }, Openness { reach: open_reach, strength: open_strength, least: open_least })
        } else { radiance_cone(radiance, rv, proxy, pv, land, p, r, 0.05 + rough * 0.9, start, reach, steps) };
        return { result: vec4(gathered.x, gathered.y, gathered.z, su.w), mirror: seen };
    }
}

/// The picture lit before the bounce as the bounce's screen traces read it (`domain = ceil(size(surface) / 4)`): each
/// cell the mean of the four by four pixels it covers that show something, the sky left out, so a trace meets the light
/// of a patch as wide as a near cone, not one sunlit pixel's.
kernel light.bounce_screen@1 {
    requires { field.read; field.write; }
    input hdr: Image;
    input surface: Grid<Vec4>;
    output result: Image;
    compute {
        let o = floor(coord()) * 4.0;
        let top = size(surface) - 1.0;
        let sum = loop 16 with a = vec4(0.0, 0.0, 0.0, 0.0) {
            let q = min(o + vec2(float(index() % 4), float(index() / 4)), top);
            if at(surface, q).w > no_hit() * 0.5 { a } else { a + vec4(at(hdr, q).xyz, 1.0) }
        };
        let c = sum.xyz / max(sum.w, 1.0);
        return vec4(c.x, c.y, c.z, 1.0);
    }
}

/// The gathered bounce (`gathered`, `every` pixels a cell) and the mirror cones (`mirror`) at pixel `q`, at distance `d`: the
/// sixteen cells round it, each by how near (a tent two cells wide) and how alike in distance it is, averaged (the first's rgb
/// the light; the second the mirror's light and how much it shut).
fn bounce_cells(gathered: Image, mirror: Image, q: Vec2, every: Int, d: Float) -> [Vec4; 2] {
    let g = (q + 0.5) / float(every) - 0.5;
    let base = floor(g) - 1.0;
    let top = size(gathered) - 1.0;
    let sum = loop 16 with acc = [vec4(0.0, 0.0, 0.0, 0.0), vec4(0.0, 0.0, 0.0, 0.0)] {
        let o = vec2(float(index() % 4), float(index() / 4));
        let cell = clamp(base + o, vec2(0.0, 0.0), top);
        let c = at(gathered, cell);
        let off = abs(g - (base + o)) * 0.5;
        let near = max(1.0 - off.x, 0.0) * max(1.0 - off.y, 0.0);
        let alike = exp(0.0 - abs(c.w - d) / (d * 0.03 + 0.05));
        let w = near * alike + 0.0001;
        [vec4(acc[0].xyz + c.xyz * w, acc[0].w + w), acc[1] + at(mirror, cell) * w]
    };
    return [sum[0] / sum[0].w, sum[1] / sum[0].w];
}

/// The gathered bounce (`light.bounce_gather`, `every` pixels a cell) laid over a renderer's picture `hdr`: each pixel takes
/// the sixteen cells round it, each by how near (a tent two cells wide) and how alike in distance it is, times the surface's diffuse color, its baked
/// occlusion and `strength`, through the air as the rest; and the things its mirror cone met (`mirror`) in place of the
/// renderer's reflection from all round (`reflection`), as much as they shut it, by the standard share the surface
/// reflects (`env_reflectance`). `reflection` comes out as it now shows, for reflections on the screen to take the place of.
kernel light.bounce@1 {
    requires { field.read; field.write; }
    input hdr: Image;
    input gathered: Image;
    input mirror: Image;
    input reflection: Grid<Vec4 as f16>;
    input surface: Grid<Vec4>;
    input paint: Grid<Vec4>;
    input extra: Grid<Vec4>;
    input layers: Grid<Vec4>;
    input more: Grid<Vec4>;
    input lens: Lenses;
    input sky: SkyLooks;
    param every: Int = 2;
    param strength: Float = 1.0;
    output result: Image;
    output reflected: Grid<Vec4 as f16>;
    compute {
        let q = coord();
        let picture = sample(hdr);
        let before = sample(reflection);
        let su = sample(surface);
        if su.w > no_hit() * 0.5 || strength <= 0.0 { return { result: picture, reflected: before }; }
        let cells = bounce_cells(gathered, mirror, q, every, su.w);
        let light = cells[0].xyz;
        let met = cells[1];
        let ex = sample(extra);
        let m = pbr_of(sample(paint), ex, sample(layers), sample(more));
        let added = m.albedo * ((1.0 - m.metal) * (1.0 - m.transmission)) * light * baked_occlusion(ex) * strength;
        let l = at(lens, 0);
        let dir = ray(l, q, domain());
        let s = at(sky, 0);
        let shown = added * air_kept(su.w, s);
        let mine = env_reflectance(m, su.xyz, vec3(0.0, 0.0, 0.0) - dir);
        let mirrored = met.xyz * mine * air_kept(su.w, s);
        let swap = (mirrored - before.xyz) * (saturate(met.w) * strength);
        let after = before.xyz + swap;
        return { result: vec4(picture.xyz + shown + swap, picture.w), reflected: vec4(after.x, after.y, after.z, 0.0) };
    }
}
