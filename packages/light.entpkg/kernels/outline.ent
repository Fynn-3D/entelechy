// Outlines from the G-buffer, after any renderer: where a pixel is much nearer than a neighbor (the nearer thing's
// edge against what is behind it) and where the surface turns sharply between neighbors (a crease, a box's edge), a
// thin dark line, fading with distance. Distance is read from the G-buffer's surface
// (`surface`'s w), never from the picture's alpha.
use "camera.ent";

/// How far `surface` lies along the view ray at pixel `p` (the sky very far).
fn outline_depth(surface: Grid<Vec4>, p: Vec2) -> Float {
    let n = size(surface);
    return min(at(surface, clamp(p, vec2(0.0, 0.0), n - 1.0)).w, 100000.0);
}

/// How much pixel `p` is the near side of an edge: a neighbor behind it by a share of its distance; fading out from
/// half of `reach` to `reach` meters away.
fn outline_near(surface: Grid<Vec4>, p: Vec2, reach: Float) -> Float {
    let d = outline_depth(surface, p);
    let behind = max(max(outline_depth(surface, p + vec2(1.0, 0.0)), outline_depth(surface, p - vec2(1.0, 0.0))),
        max(outline_depth(surface, p + vec2(0.0, 1.0)), outline_depth(surface, p - vec2(0.0, 1.0))));
    let gap = (behind - d) / (d * 0.06 + 0.12);
    return smoothstep(1.0, 2.0, gap) * (1.0 - smoothstep(reach * 0.5, reach, d));
}

/// How sharply the surface at pixel `p` turns against its neighbors: the most its normal turns from one of theirs
/// (1 less the cosine), from `from` none to `to` all; the sky and a neighbor in it none.
fn outline_crease(surface: Grid<Vec4>, p: Vec2, from: Float, to: Float) -> Float {
    let n = size(surface);
    let s0 = at(surface, clamp(p, vec2(0.0, 0.0), n - 1.0));
    if s0.w >= no_hit() * 0.5 { return 0.0; }
    let turn = loop 4 with t = 0.0 {
        let o = [vec2(1.0, 0.0), vec2(-1.0, 0.0), vec2(0.0, 1.0), vec2(0.0, -1.0)][index()];
        let s1 = at(surface, clamp(p + o, vec2(0.0, 0.0), n - 1.0));
        if s1.w >= no_hit() * 0.5 { t } else { max(t, 1.0 - dot(s0.xyz, s1.xyz)) }
    };
    return smoothstep(from, to, turn);
}

/// The picture `image` with its outlines drawn (`domain = size(image)`): the near sides of edges, and its creases
/// `crease` strong (0 none), turning from `crease_from` to `crease_to`; `ink` dark in `color` (times what lies under
/// it), fading out by `reach` meters (`image.masked` keeps it to part of a picture).
kernel light.outline@1 {
    requires { field.read; field.write; }
    input image: Image;
    input surface: Grid<Vec4>;
    param ink: Float = 0.8;
    param reach: Float = 90.0;
    param crease: Float = 1.0;
    param crease_from: Float = 0.1;
    param crease_to: Float = 0.3;
    param color: Vec3 = vec3(0.22, 0.2, 0.27);
    output result: Image;
    compute {
        let p = coord();
        let c = at(image, p);
        let fade = 1.0 - smoothstep(reach * 0.5, reach, outline_depth(surface, p));
        let line = max(outline_near(surface, p, reach), outline_crease(surface, p, crease_from, crease_to) * crease * fade);
        let inked = mix(c.xyz, c.xyz * color, line * ink);
        return vec4(inked.x, inked.y, inked.z, c.w);
    }
}
