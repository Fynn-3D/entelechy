// The sky: the sun, the sky's colors, cumulus, far silhouettes on the horizon, and the air laid over distance. A scene gives
// a `SkyLook`, and a renderer draws the sky and lights by it.
use "random.entpkg";

/// The sky's look: the sun's direction (toward it) and color (HDR), the mean sky light from all round (for where one
/// number is wanted, as smoke or fog), the horizon's and zenith's colors, how cloudy (0 clear to 1 overcast), how high the far
/// silhouettes on the horizon are (an elevation, 0 none) and their color, how dense the air is (a meter) and from how far it begins.
struct SkyLook { sun: Vec3; sun_color: Vec3; ambient: Vec3; horizon: Vec3; zenith: Vec3; clouds: Float; far_land: Float; far_color: Vec3; air: Float; air_from: Float; }
type SkyLooks = Rows<SkyLook>;

/// A sky of one main light and a mean sky light alone (night, indoors): horizon and zenith take the sky light's
/// color, with no clouds, silhouettes or air.
fn plain_sky(sun: Vec3, sun_color: Vec3, ambient: Vec3) -> SkyLook {
    return SkyLook { sun: sun, sun_color: sun_color, ambient: ambient, horizon: ambient * 1.2, zenith: ambient * 0.6, clouds: 0.0,
        far_land: 0.0, far_color: ambient, air: 0.0, air_from: 1000000.0 };
}

/// Cumulus: a layer overhead (the view ray carried to the layer for its look, with no seam), billowing in heaps; the
/// shaded bellies dark, the lit tops bright, thin edges bright against the sun. Its color, and how opaque it is (w).
fn cloud_layer(dir: Vec3, s: SkyLook) -> Vec4 {
    let el = asin(clamp(dir.y, -1.0, 1.0));
    if el < 0.02 || s.clouds <= 0.0 { return vec4(0.0, 0.0, 0.0, 0.0); }
    // A deck of cloud overhead: the ray carried up to it (no seam round
    // the horizon, and smaller toward it).
    let p = vec2(dir.x, dir.z) / max(dir.y, 0.05) * 1.6;
    let warp = vec2(fbm2(p * 0.8, 3, 91), fbm2(p * 0.8 + vec2(5.2, 1.3), 3, 92)) * 0.25;
    let q = p + warp;
    let cut = 0.9 - s.clouds * 0.5;
    let dens = (fbm2(q * 0.6, 3, 93) * 0.5 + 0.5) * 0.9 + (1.0 - abs(fbm2(q * 2.2, 5, 94))) * 0.35 - cut;
    let cover = smoothstep(0.0, 0.12, dens) * smoothstep(0.08, 0.2, el) * (1.0 - smoothstep(0.8, 1.2, el));
    let sun_p = vec2(s.sun.x, s.sun.z) / max(s.sun.y, 0.05) * 1.6;
    let q2 = q + normalize(sun_p - p + vec2(0.0001, 0.0)) * 0.12;
    let dens2 = (fbm2(q2 * 0.6, 3, 93) * 0.5 + 0.5) * 0.9 + (1.0 - abs(fbm2(q2 * 2.2, 5, 94))) * 0.35 - cut;
    let lightness = exp(-max(dens2, 0.0) * 9.0);
    let c = max(dot(dir, s.sun), 0.0);
    let body = mix(vec3(0.4, 0.43, 0.52), vec3(1.6, 1.5, 1.38), lightness) * mix(0.85, 1.1, smoothstep(0.1, 0.5, el));
    let rim = s.sun_color * pow(c, 4.0) * (1.0 - smoothstep(0.0, 0.08, dens)) * 1.4;
    return vec4(body + rim * cover, cover);
}
/// How high the far silhouette is at bearing `a` (an elevation): flat-topped mesas.
fn far_line(a: Float, seed: Int, tall: Float) -> Float {
    let n = fbm2(vec2(a * 3.0, 0.0), 4, seed) * 0.5 + 0.5;
    let top = smoothstep(0.42, 0.5, n) * 0.6 + smoothstep(0.6, 0.66, n) * 0.4;
    return tall * (top + fbm2(vec2(a * 40.0, 0.0), 3, seed + 1) * 0.08) + 0.002;
}
/// The sky seen toward `dir` (HDR). `seen`, as the eye sees it: the sun's bright disc, the far silhouettes;
/// otherwise the sky light that lights things (no disc, the sun counted apart; no silhouettes).
fn sky_radiance(dir: Vec3, s: SkyLook, seen: Bool) -> Vec3 {
    let y = max(dir.y, 0.0);
    let c = max(dot(dir, s.sun), 0.0);
    let base = mix(s.horizon, s.zenith, pow(saturate(y * 1.6), 0.4));
    let halo = s.sun_color * (pow(c, 16.0) * 0.07 + pow(c, 128.0) * 0.4) + s.sun_color * 0.05 * pow(c, 3.0) * (1.0 - pow(y, 0.3));
    let air = base + halo;
    let cl = cloud_layer(dir, s);
    if !seen { return if dir.y < 0.0 { s.horizon * 0.45 } else { mix(air, cl.xyz, cl.w) }; }
    let disk = s.sun_color * smoothstep(0.99985, 0.99995, c) * 20.0 * (1.0 - cl.w);
    let skyed = mix(air, cl.xyz + halo * 0.4, cl.w) + disk;
    let a = atan2(dir.x, -dir.z);
    let haze = s.horizon + halo * 0.6;
    let with_far = if s.far_land > 0.0 && dir.y < far_line(a, 101, s.far_land) { mix(s.far_color, haze, 0.7) } else { skyed };
    let with_near = if s.far_land > 0.0 && dir.y < far_line(a + 1.7, 103, s.far_land * 0.7) { mix(s.far_color * 0.68, haze, 0.45) } else { with_far };
    return if dir.y < 0.0 { mix(s.far_color, s.horizon, 0.5) } else { with_near };
}
/// The air laid over distance: `color` seen `d` meters away, fading to the horizon's color past `air_from` meters,
/// a little brighter toward the sun.
fn aerial(color: Vec3, dir: Vec3, d: Float, s: SkyLook) -> Vec3 {
    let c = max(dot(dir, s.sun), 0.0);
    let haze = s.horizon * 0.7 + s.sun_color * pow(c, 8.0) * 0.08;
    return mix(color, haze, 1.0 - exp(-max(d - s.air_from, 0.0) * s.air));
}
