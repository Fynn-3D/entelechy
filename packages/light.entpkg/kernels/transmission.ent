// Transmission (glass, water, ice): the refracted path is the scene's (it knows the shape and thickness); the scene hands over
// the layer seen through it (the contract: `behind_at`, `behind_dir`,
// `behind_paint`, `behind_normal`, `through`); lighting it and laying it under is the renderer's, in
// two steps here: the light at the point behind first (`behind_radiance`), blurred on the screen by the glass's roughness,
// then the part Fresnel lets through, times the absorbed color, laid under the glass's reflection.
// (`transmitted`).
use "sky.ent";
use "brdf.ent";

/// The light at the point seen through: where it met something (`at`'s w 1), the sun's light (its visibility in
/// `dir`'s w) plus the diffuse light `diffuse_light` (the renderer's) plus the sky's reflection; where it met nothing, the sky
/// in the leaving direction. `dir` is the direction it leaves in, `paint` the point's color and roughness, `normal` its
/// normal and metalness.
fn behind_radiance(s: SkyLook, at_: Vec4, dir: Vec4, paint: Vec4, normal: Vec4, diffuse_light: Vec3) -> Vec3 {
    let d = vec3(dir.x, dir.y, dir.z);
    if at_.w < 0.5 { return sky_radiance(d, s, true); }
    let n = vec3(normal.x, normal.y, normal.z);
    let m = pbr(paint.xyz, paint.w, normal.w);
    let v = vec3(0.0, 0.0, 0.0) - d;
    let mirrored = sky_radiance(reflect(d, n), s, false);
    let spec_light = mix(mirrored, diffuse_light, sqrt(m.rough));
    return lit_by(m, n, v, s.sun, s.sun_color * dir.w) + ambient_by(m, n, v, diffuse_light, spec_light, spec_light);
}
/// The light let through: the transmitted part (what Fresnel does not reflect) times the absorbed color (`through`) times
/// the light behind (already blurred by roughness).
fn transmitted(m: Pbr, n: Vec3, v: Vec3, through: Vec4, behind: Vec3) -> Vec3 {
    let f = schlick(pbr_f0(m), max(dot(n, v), 0.0));
    return (vec3(1.0, 1.0, 1.0) - f) * m.transmission * through.xyz * behind;
}
/// Frosting: the light behind blurred on the screen by the glass's roughness `rough` (smooth glass takes it as it is; at most a radius
/// of 24 pixels, a disc of twelve points).
fn frosted(image: Image, q: Vec2, rough: Float) -> Vec3 {
    let here = at(image, q).xyz;
    if rough < 0.02 { return here; }
    let r = rough * 24.0;
    let sum = loop 12 with acc = vec4(here.x, here.y, here.z, 1.0) {
        let a = float(index()) * 2.39996;
        let o = vec2(cos(a), sin(a)) * r * sqrt((float(index()) + 0.5) / 12.0);
        let c = at(image, clamp(q + o, vec2(0.0, 0.0), size(image) - vec2(1.0, 1.0))).xyz;
        acc + vec4(c.x, c.y, c.z, 1.0)
    };
    return sum.xyz / sum.w;
}
