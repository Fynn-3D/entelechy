//! The lamps added to a renderer's picture (`kernels/lamps.ent`), for a
//! renderer that does not take them in itself (probe GI does):
//! each tile of the screen keeps the lamps that reach it, each pixel adds
//! theirs, shadowed: by its shadow map where `maps` holds one for it (`graphs/lamp_maps.esn`; `light.lamp_maps_none`
//! for none), through the proxies otherwise.
use "../kernels/";

input hdr: Image;
input lens: Lenses;
input surface: Grid<Vec4>;
input paint: Grid<Vec4>;
input extra: Grid<Vec4>;
input layers: Grid<Vec4>;
input more: Grid<Vec4>;
input proxy: Volume<Vec4>;
input land: Grid<Float>;
input frame: Proxies;
input lamps: Lamps;
/// What shapes the lamps' light, their cookies and profiles (`light.lamp_looks_none` for none).
input lamp_looks: LampLooks;
input maps: Grid<Int>;
/// How near (meters) a lamp's shadow is looked for on the screen too, and how far that contact shadow reaches (`ContactReach`).
param contact: Float = 30.0;
param contact_length: Float = 0.025;
param contact_longest: Float = 0.3;
param contact_thick: Float = 0.01;
param contact_thickest: Float = 0.15;

node depth: light.lamps_depth@1 { surface <- surface; domain = ceil(size(surface) / 16); }
node tiles: light.lamps_tiles@1 { depth <- depth.result; lamps <- lamps; lens <- lens; surface <- surface; domain = size(depth); }
node light: light.lamps_light@1 { surface <- surface; paint <- paint; extra <- extra; layers <- layers; more <- more; tiles <- tiles.result; lamps <- lamps; lamp_looks <- lamp_looks; lens <- lens;
    proxy <- proxy; land <- land; frame <- frame; maps <- maps; contact = contact; contact_length = contact_length; contact_longest = contact_longest;
    contact_thick = contact_thick; contact_thickest = contact_thickest; domain = size(surface); }
node shaded: light.lamps_shade@1 { hdr <- hdr; light <- light.result; }

output hdr <- shaded.result;
