//! One deck of clouds over the view (`kernels/clouds.ent`): the deck (`deck`, for the fog lit beneath it and for its
//! shadows on the ground, `light.clouds_shadow`), and the clouds marched over each sky pixel at one in `every` pixels
//! across and down (`result`: their light, and how much of the sky behind still shows).
use "../kernels/";

input lens: Lenses;
input sky: SkyLooks;
input surface: Grid<Vec4>;
/// The deck: from `low` to `high` meters, how much of the sky it covers, how wide its billows are (meters), how dense,
/// and its pattern (`seed`).
param low: Float = 1500.0;
param high: Float = 2600.0;
param cover: Float = 0.0;
param scale: Float = 2400.0;
param density: Float = 0.02;
param seed: Int = 7;
/// The light from below; how bright a sunlit cloud is, how dark its sunlit edge (`powder`), and the sky's light in it.
param below: Vec3 = vec3(0.0, 0.0, 0.0);
param bright: Float = 4.0;
param powder: Float = 0.5;
param sky_light: Float = 1.0;
/// Marched at one in this many pixels across and down (soft: an eighth is enough; fewer, a crisper edge).
param every: Float = 8.0;

node deck: light.clouds_deck@1 { low = low; high = high; cover = cover; scale = scale; density = density; seed = seed; domain = 1; }
node clouds: light.clouds_march@1 { surface <- surface; lens <- lens; sky <- sky; deck <- deck.result; below = below; bright = bright; powder = powder;
    sky_light = sky_light; domain = ceil(size(surface) / every); }

output result <- clouds.result;
output deck <- deck.result;
