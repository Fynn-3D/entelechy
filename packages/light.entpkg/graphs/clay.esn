//! Clay (`light.clay`) on a scene's G-buffer (the contract, its first
//! three maps): its picture, as shown.
use "../kernels/";

input lens: Lenses;
input surface: Grid<Vec4>;
input paint: Grid<Vec4>;
input extra: Grid<Vec4>;
param light: Int = 0;
param color: Int = 0;
param cavity: Float = 1.0;
param outline: Float = 1.0;
param grid: Bool = true;
param sky_outline: Bool = true;
/// The studio's lights and soft light, the backdrop, the floor's lines and axes, clay's own color, the occlusion shown and the
/// outline's color (as `light.clay` has them).
param key: Float = 1.5;
param fill: Float = 0.45;
param rim: Float = 0.6;
param studio_ground: Vec3 = vec3(0.16, 0.15, 0.14);
param studio_sky: Vec3 = vec3(0.42, 0.44, 0.48);
param backdrop_top: Vec3 = vec3(0.24, 0.245, 0.26);
param backdrop_bottom: Vec3 = vec3(0.15, 0.155, 0.165);
param grid_line: Vec3 = vec3(0.42, 0.42, 0.42);
param x_axis: Vec3 = vec3(0.85, 0.25, 0.28);
param z_axis: Vec3 = vec3(0.45, 0.75, 0.2);
param clay_color: Vec3 = vec3(0.62, 0.6, 0.57);
param clay_rough: Float = 0.55;
param occlusion: Float = 0.6;
param outline_color: Vec3 = vec3(0.03, 0.03, 0.035);

node shade: light.clay@1 { lens <- lens; surface <- surface; paint <- paint; extra <- extra;
    light = light; color = color; cavity = cavity; outline = outline; grid = grid; sky_outline = sky_outline;
    key = key; fill = fill; rim = rim; studio_ground = studio_ground; studio_sky = studio_sky; backdrop_top = backdrop_top; backdrop_bottom = backdrop_bottom;
    grid_line = grid_line; x_axis = x_axis; z_axis = z_axis; clay_color = clay_color; clay_rough = clay_rough; occlusion = occlusion; outline_color = outline_color;
    domain = size(surface); }

output result <- shade.result;
