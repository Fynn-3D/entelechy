//! Temporal antialiasing and upscaling: this frame (`hdr`, drawn through the jittered camera `jlens`, possibly
//! smaller than the window) blended with the last frame carried over, at the window's size (`light.taa`). `surface` is the G-buffer's
//! surface (w the distance along the view ray), `lens` the camera unjittered. Small moving things (particles) are drawn after
//! it, or they smear; walking figures are carried by `motion`.
use "../kernels/";

input hdr: Image;
input surface: Grid<Vec4>;
input lens: Lenses;
input jlens: Lenses;
/// How far each pixel's thing moved this frame (in the world; 1 × 1 when nothing moved).
input motion: Grid<Vec4>;

/// The most of each frame taken, and how far the history may stray from this frame's neighborhood, held still and moving
/// (`light.taa`).
param fresh: Float = 0.12;
param clamp_still: Float = 2.0;
param clamp_moving: Float = 1.5;

node blank_hdr: Image { domain = vec2(1, 1); }
node now: light.same_lens@1 { lens <- lens; domain = 1; }
node rests: light.lens_rests@1 { lens <- lens; jlens <- jlens; was_lens <~ now.result from now.result; domain = 1; }
node taa: light.taa@1 { hdr <- hdr; surface <- surface; lens <- lens; jlens <- jlens; motion <- motion; rests <- rests.result; was_lens <~ now.result from now.result;
    history <~ taa.result from blank_hdr.result; fresh = fresh; clamp_still = clamp_still; clamp_moving = clamp_moving; domain = window(); }

output result <- taa.result;
