//! Fog in a grid of cells over the view (`kernels/fog.ent`): height fog and the scene's fog volumes, lit by the sun
//! (through its cascades, or the proxies where none holds a point, under the clouds' deck), the sky and the lamps (their
//! beams cut into shafts); each cell where its column shows, summed from the eye, read at each quarter pixel's depth
//! (`seen`) and blurred among alike depths (`result`, what `light.fog_apply` lays over a picture).
use "../kernels/";

input lens: Lenses;
input sky: SkyLooks;
input surface: Grid<Vec4>;
input proxy: Volume<Vec4>;
input land: Grid<Float>;
input frame: Proxies;
input lamps: Lamps;
input lamp_looks: LampLooks;
input views: SunViews;
input atlas: Grid<Float>;
input volumes: FogVolumes;
input deck: CloudDecks;
/// How thick at `base` and below, thinning by e every `falloff` meters up; the light it takes from round about; the
/// lamps' and the sky's light in it, times these; how strongly it scatters forward.
param density: Float = 0.002;
param base: Float = 0.0;
param falloff: Float = 80.0;
param glow: Vec3 = vec3(0.0, 0.0, 0.0);
param lamp_share: Float = 1.0;
param sky_share: Float = 1.0;
param forward: Float = 0.6;
/// The grid: `columns` across and `rows` down the picture, `slices` deep (at most 64) from `near` to `far` meters.
param columns: Int = 160;
param rows: Int = 90;
param slices: Int = 64;
param near: Float = 0.2;
param far: Float = 2000.0;
/// The steps toward the sun through the proxies, toward a lamp for its shafts (0 none), and the pieces a lamp's light is
/// taken in through a cell; the lamps are those reaching two kilometers past each tile's surface.
param sun_steps: Int = 8;
param shafts: Int = 8;
param lamp_steps: Int = 4;

node lamp_tiles: graph "lamp_tiles.esn" { lamps <- lamps; lens <- lens; surface <- surface; through = 2000.0; }
node furthest: light.froxel_furthest@1 { surface <- surface; far = far; domain = vec2(columns, rows); }
node air: light.froxel_light@1 { tiles <- lamp_tiles.result; views <- views; atlas <- atlas; surface <- surface; lens <- lens; sky <- sky; lamps <- lamps; lamp_looks <- lamp_looks; proxy <- proxy; land <- land; frame <- frame;
    deck <- deck; volumes <- volumes; furthest <- furthest.result; density = density; base = base; falloff = falloff; forward = forward; glow = glow; lamp_share = lamp_share;
    sky_share = sky_share; sun_steps = sun_steps; shafts = shafts; lamp_steps = lamp_steps; near = near; far = far; domain = vec3(columns, rows, slices); }
node within: light.froxel_scan@1 { air <- air.result; step = 1; domain = size(air); }
node summed: light.froxel_scan@1 { air <- within.result; step = 8; domain = size(air); }
node seen: light.froxel_view@1 { summed <- summed.result; air <- air.result; surface <- surface; lens <- lens; near = near; far = far; domain = ceil(size(surface) / 4); }
node across: light.fog_blur@1 { fog <- seen.result; surface <- surface; axis = 0; domain = size(fog); }
node down: light.fog_blur@1 { fog <- across.result; surface <- surface; axis = 1; domain = size(fog); }

output result <- down.result;
output seen <- seen.result;
