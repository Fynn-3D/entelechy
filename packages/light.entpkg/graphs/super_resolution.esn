//! Temporal super-resolution (`light.tsr`): this frame (`hdr`, drawn through the jittered camera `jlens`, possibly
//! smaller than the window) blended with the history carried over, at the window's size. `surface` is the G-buffer's surface (w the
//! distance along the view ray), `lens` the camera unjittered, `motion` how far each pixel's thing moved in the world
//! this frame (1 × 1 when nothing moved). A pixel just uncovered takes this frame antialiased on its own (`image.fxaa`)
//! first.
use "../kernels/";
use "image.entpkg";

input hdr: Image;
input surface: Grid<Vec4>;
input lens: Lenses;
input jlens: Lenses;
input motion: Grid<Vec4>;
/// How narrow the bell this frame's samples are weighed by is (`light.tsr`).
param filter: Float = 6.0;
/// The most frames a pixel gathers, still and moving fast (`light.tsr`).
param most: Float = 32.0;
param least: Float = 10.0;

node aa: image.fxaa@1 { image <- hdr; }
node blank_hdr: Image { domain = vec2(1, 1); }
node blank_meta: Grid<Vec4> { domain = vec2(1, 1); }
node shown: light.keep_surface@1 { surface <- surface; }
node shown_motion: light.keep_surface@1 { surface <- motion; }
node now: light.same_lens@1 { lens <- lens; domain = 1; }
node rests: light.lens_rests@1 { lens <- lens; jlens <- jlens; was_lens <~ now.result from now.result; domain = 1; }
node tsr: light.tsr@1 { hdr <- hdr; aa <- aa.result; surface <- surface; was_surface <~ shown.result from shown.result; lens <- lens; jlens <- jlens;
    was_lens <~ now.result from now.result; motion <- motion; rests <- rests.result; was_motion <~ shown_motion.result from shown_motion.result;
    history <~ tsr.result from blank_hdr.result; meta <~ tsr.meta_out from blank_meta.result; filter = filter; most = most; least = least; domain = window(); }

output result <- tsr.result;
