//! Probe GI, light bounced between things by light probes (`kernels/probe_gi.ent`): takes the scene's G-buffer, proxies and lamps
//! (the contract) and gives the HDR picture `hdr`; the lamps' light is shown, reflected and bounced. `nx` by `ny` by `nz` probes,
//! one every `spacing` meters from the proxy's `lo`, covering the proxy; each face traces `rays` rays a frame,
//! and stops after `most`.
use "../kernels/";
use "camera.entpkg";

input lens: Lenses;
input sky: SkyLooks;
input surface: Grid<Vec4>;
input paint: Grid<Vec4>;
input extra: Grid<Vec4>;
input layers: Grid<Vec4>;
input more: Grid<Vec4>;
input behind_at: Grid<Vec4>;
input behind_dir: Grid<Vec4>;
input behind_paint: Grid<Vec4>;
input behind_normal: Grid<Vec4>;
input through: Grid<Vec4>;
input proxy: Volume<Vec4>;
input land: Grid<Float>;
input frame: Proxies;
input lamps: Lamps;
/// What shapes the lamps' light, their cookies and profiles (`light.lamp_looks_none` for none).
input lamp_looks: LampLooks;
/// How far toward a painting's its light is taken, and the painting's look (`light.painting_start`).
input painting: Paintings;
param spacing: Float = 1.2;
param nx: Int = 32;
param ny: Int = 16;
param nz: Int = 32;
param rays: Int = 2;
param most: Int = 256;
/// The rays each pixel traces on the screen (fewer is noisier, smoothed by temporal antialiasing and denoising; 0 uses the probes alone, without noise).
param screen_rays: Int = 4;
/// Screen rays are traced every this many pixels a side (1 every pixel; 2 one in four, filled in by denoising).
param gather_every: Int = 1;
/// Only surfaces smoother than this look for reflections on the screen.
param mirror_below: Float = 0.6;
/// The frames the gathered light is averaged over while the lens rests; then it rests too.
param settle_frames: Int = 64;
/// How far (meters) the screen's occlusion looks round a surface, and how strongly it darkens.
param ao_reach: Float = 0.7;
param ao_strength: Float = 1.6;

node blank: Volume<Vec4> { domain = vec3(nx * 6, ny, nz); }
// The probes' signatures, and those of their last gathering: where the scene changed, light is gathered again.
node sign: light.probes_sign@1 { proxy <- proxy; land <- land; frame <- frame; sky <- sky; lamps <- lamps; lamp_looks <- lamp_looks; spacing = spacing; domain = vec3(nx, ny, nz); }
node seen: light.probes_seen@1 { previous <~ seen.result from sign.result; sign <- sign.result; surface <- surface; }
node light: light.probes_gather@1 { previous <~ light.result from blank.result; surface <- surface; sign <- sign.result; seen <~ seen.result from sign.result; proxy <- proxy; land <- land; frame <- frame; sky <- sky; lamps <- lamps; lamp_looks <- lamp_looks;
    spacing = spacing; rays = rays; most = most; domain = vec3(nx * 6, ny, nz); }
node beyond: light.probes_behind@1 { more <- more; behind_at <- behind_at; behind_dir <- behind_dir; behind_paint <- behind_paint; behind_normal <- behind_normal;
    probes <- light.result; frame <- frame; sky <- sky; spacing = spacing; domain = size(more); }
// The picture without reflections, which screen-space reflections read.
// The lamps' light on each surface, from those each tile of the screen keeps.
node lamp_tiles: graph "lamp_tiles.esn" { lamps <- lamps; lens <- lens; surface <- surface; }
node no_maps: light.lamp_maps_none@1 { domain = vec2(1, 1); }
node lamped: light.lamps_light@1 { surface <- surface; paint <- paint; extra <- extra; layers <- layers; more <- more; tiles <- lamp_tiles.result; lamps <- lamps; lamp_looks <- lamp_looks; lens <- lens;
    proxy <- proxy; land <- land; frame <- frame; maps <- no_maps.result; domain = size(surface); }
node lit: light.probes_lit@1 { surface <- surface; paint <- paint; extra <- extra; layers <- layers; more <- more; probes <- light.result; frame <- frame; sky <- sky; lens <- lens;
    lamped <- lamped.result; spacing = spacing; reach = ao_reach; strength = ao_strength; domain = size(surface); }
// The frames the lens has rested: each frame's rays new, averaged while it rests.
node count0: light.path_count_start@1 { domain = 1; }
node count: light.path_count@1 { previous <~ count.result from count0.result; lens <- lens; most = settle_frames; domain = 1; }
// Each pixel's diffuse light: traced on the screen, the probes where a ray finds nothing; denoised.
node gather: light.probes_screen_gather@1 { surface <- surface; lit <- lit.result; probes <- light.result; proxy <- proxy; land <- land; frame <- frame; sky <- sky; lens <- lens; lamps <- lamps; lamp_looks <- lamp_looks; count <- count.result; spacing = spacing; rays = screen_rays; domain = ceil(size(surface) / gather_every); }
node gathered: light.probes_gather_blur@1 { gathered <- gather.result; surface <- surface; domain = size(surface); }
// ... gathered frame by frame (the last frame's moved to where it is now).
node now_lens: camera.same_lens@1 { lens <- lens; domain = 1; }
node blank_kept: Image { domain = vec2(1, 1); }
node kept: light.probes_gather_keep@1 { gathered <- gathered.result; surface <- surface; previous <~ kept.result from blank_kept.result; lens <- lens; was_lens <~ now_lens.result from now_lens.result; count <- count.result; domain = size(surface); }
node shade: light.probes_shade@1 { surface <- surface; paint <- paint; extra <- extra; layers <- layers; more <- more; beyond <- beyond.result; through <- through; lit <- lit.result; gathered <- kept.result; proxy <- proxy; land <- land; probes <- light.result; frame <- frame; sky <- sky; lens <- lens;
    lamps <- lamps; lamp_looks <- lamp_looks; lamped <- lamped.result; spacing = spacing; mirror_below = mirror_below; painting <- painting;
    domain = size(surface); }

output hdr <- shade.result;
/// The share of `hdr` that scatters under subsurface surfaces (`graphs/subsurface.esn` spreads it).
output scatter <- shade.scatter;
