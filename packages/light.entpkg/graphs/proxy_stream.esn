//! A mesh baked into a proxy a pass a frame (`kernels/proxy_bake.ent`), for a world whose geometry changes as it streams:
//! as `graphs/proxy_bake.esn` takes it (`points`, `faces`, each face's `colors`, the `frame`), but when what it is baked
//! from changes the seeds are laid at once and the jump flooding goes on a pass a frame (`light.proxy_stage`,
//! `light.proxy_flood_staged`), the proxy in use the last one made until the new one is (`light.proxy_published`), so no
//! frame bakes it whole: a frame's share of the baking is a pass's, the new proxy in use nine frames on. `frame` is the
//! frame the proxy in use was made over (a moving frame's: the proxy and its frame change together).
use "parallel.entpkg";
use "mesh.entpkg";
use "../kernels/";

input points: Rows<MeshPoint>;
input faces: Rows<Face>;
input colors: Rows<Vec4>;
input frame: Proxies;
param nx: Int = 128;
param ny: Int = 64;
param nz: Int = 128;
param band: Float = 3.0;

node tiles: light.proxy_bake_tiles@1 { faces <- faces; points <- points; frame <- frame; band = band; }
node runs: graph "parallel.entpkg/graphs/runs.esn" { counts <- tiles.result; }
node blank: Volume<Long> { domain = vec3(nx, ny, nz); value = 9223372036854775807l; }
node near: light.proxy_bake_faces@1 { faces <- faces; points <- points; tiles <- tiles.result; ends <- runs.ends; frame <- frame; blank <- blank.result;
    entries <- runs.entries; band = band; domain = value(entries); }
node seeds: light.proxy_seeds@1 { near <- near.result; faces <- faces; points <- points; frame <- frame; domain = size(near); }
node stage0: Rows<Int> { domain = 1; }
node stage: light.proxy_stage@1 { previous <~ stage.result from stage0.result; points <- points; faces <- faces; colors <- colors; frame <- frame; domain = 2; }
node none: Volume<Vec4> { domain = vec3(1, 1, 1); }
node work: light.proxy_flood_staged@1 { seeds <- seeds.result; previous <~ work.result from none.result; stage <- stage.result; frame <- frame; domain = size(seeds); }
node published: light.proxy_published@1 { work <- work.result; previous <~ published.result from none.result; stage <- stage.result; colors <- colors; frame <- frame;
    domain = size(work); }

node published_frame: light.proxy_published_frame@1 { frame <- frame; previous <~ published_frame.result from frame; stage <- stage.result; work <- work.result;
    domain = 1; }

node made0: Rows<Int> { domain = 1; }
node made: light.proxy_made@1 { previous <~ made.result from made0.result; stage <- stage.result; domain = 1; }

output proxy <- published.result;
output frame <- published_frame.result;
/// 1 once a proxy has been made whole (before it, the proxy in use is the first flood as far as it has come).
output made <- made.result;
