// The delay lines' test stand, in one memory: the first four places a
// line the count is pushed into and read four samples late; the next four
// an echo of a single click, coming back every four samples half as loud;
// the last eight a string plucked on the first sample and stepped on every
// one.
use "../kernels/";

kernel lines.run@1 {
    requires { field.read; field.write; }
    input block: Rows<Int>;           // one element a sample: what the scan walks
    memory line: Rows<Float>;
    memory head: Rows<Int>;
    output result: Rows<Vec3>;
    scan over block with out = vec3(0.0, 0.0, 0.0) {
        let i = index();
        let h = at(head, 0);
        let next = delay_push(line, 0, 4, h % 4, float(i));
        let late = delay_tap(line, 0, 4, next, 4);
        let echo = delay_echo(line, 4, 4, h % 4, if i == 0 { 1.0 } else { 0.0 }, 0.5);
        let _ = if i == 0 { string_pluck(line, 8, 8, 3) } else { 0 };
        let string = string_step(line, 8, 8, h % 8, 0.99);
        put(head, 0, h + 1);
        return vec3(late, echo, string);
    }
}
