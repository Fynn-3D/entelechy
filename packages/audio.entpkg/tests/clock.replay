scene clock.esn

# 48000 samples a second, no device. The first block starts a first
# block's length (1600) behind the time; the counting clock has played
# nothing yet; no cue sounds; a cue set going at full gain.
frame 0.0167
expect clock.result[0].n = 0
expect block.result[0] = 1600
expect counted.result[0].n = 0
expect cues.result[0].kind = 0
expect set.result[0].kind = 18
expect set.result[0].param = 3
expect set.result[0].gain = 1 0.0001

# A tone under its envelope, with noise, at a moment, the same on every
# backend; the envelope itself.
expect voices.result[0] = 0.2143 0.8752 0 0 0.001
expect voices.result[1] = 0.5908 0.6271 0 0 0.001

# Thirteen hours in, more samples than an Int holds: after the stall the
# clock takes up the time again, a first block behind it.
frame 46800
expect clock.result[0].n = 2246398400

# The next frame counts on by the block it played.
frame 46800.0167
expect clock.result[0].n = 2246400000
expect counted.result[0].n = 1600
