// Value and gradient noise in two and three dimensions, interpolated
// between hashed corners, and their fractal sums.
use "hash.ent";

/// Perlin's quintic: 0 at 0, 1 at 1, flat at both.
fn fade(t: Float) -> Float { return t * t * t * (t * (t * 6.0 - 15.0) + 10.0); }

/// A lattice value, -1 to 1.
fn corner2(x: Int, y: Int, seed: Int) -> Float { return unit_of(hash_int2(x, y, seed)) * 2.0 - 1.0; }

fn corner3(x: Int, y: Int, z: Int, seed: Int) -> Float { return unit_of(hash_int3(x, y, z, seed)) * 2.0 - 1.0; }

/// Value noise, -1 to 1: random values at the whole numbers, blended.
fn value2(p: Vec2, seed: Int) -> Float {
    let i = floor(p);
    let { x, y } = int(i);
    let u = fade(p.x - i.x);
    let v = fade(p.y - i.y);
    return mix(mix(corner2(x, y, seed), corner2(x + 1, y, seed), u),
               mix(corner2(x, y + 1, seed), corner2(x + 1, y + 1, seed), u), v);
}

fn value3(p: Vec3, seed: Int) -> Float {
    let i = floor(p);
    let { x, y, z } = int(i);
    let u = fade(p.x - i.x);
    let v = fade(p.y - i.y);
    let w = fade(p.z - i.z);
    let near = mix(mix(corner3(x, y, z, seed), corner3(x + 1, y, z, seed), u),
                   mix(corner3(x, y + 1, z, seed), corner3(x + 1, y + 1, z, seed), u), v);
    let far = mix(mix(corner3(x, y, z + 1, seed), corner3(x + 1, y, z + 1, seed), u),
                  mix(corner3(x, y + 1, z + 1, seed), corner3(x + 1, y + 1, z + 1, seed), u), v);
    return mix(near, far, w);
}

/// A lattice point's gradient dotted with the offset to `d`: one of the
/// twelve edge directions of a cube, as Perlin's improved noise picks.
fn slope3(x: Int, y: Int, z: Int, seed: Int, d: Vec3) -> Float {
    let h = hash_int3(x, y, z, seed) & 15;
    let u = if h < 8 { d.x } else { d.y };
    let v = if h < 4 { d.y } else if h == 12 || h == 14 { d.x } else { d.z };
    return (if (h & 1) == 0 { u } else { -u }) + (if (h & 2) == 0 { v } else { -v });
}

/// Gradient (Perlin) noise, about -1 to 1: smoother than value noise,
/// without its grid-aligned blocks.
fn gradient3(p: Vec3, seed: Int) -> Float {
    let i = floor(p);
    let f = p - i;
    let { x, y, z } = int(i);
    let u = fade(f.x);
    let v = fade(f.y);
    let w = fade(f.z);
    let near = mix(mix(slope3(x, y, z, seed, f), slope3(x + 1, y, z, seed, f - vec3(1.0, 0.0, 0.0)), u),
                   mix(slope3(x, y + 1, z, seed, f - vec3(0.0, 1.0, 0.0)), slope3(x + 1, y + 1, z, seed, f - vec3(1.0, 1.0, 0.0)), u), v);
    let far = mix(mix(slope3(x, y, z + 1, seed, f - vec3(0.0, 0.0, 1.0)), slope3(x + 1, y, z + 1, seed, f - vec3(1.0, 0.0, 1.0)), u),
                  mix(slope3(x, y + 1, z + 1, seed, f - vec3(0.0, 1.0, 1.0)), slope3(x + 1, y + 1, z + 1, seed, f - 1.0), u), v);
    return mix(near, far, w);
}

/// A fractal sum: `octaves` layers of noise, each twice as fine and half
/// as strong as the last; about -1 to 1.
fn fbm2(p: Vec2, octaves: Int, seed: Int) -> Float {
    let sum = loop octaves with s = vec4(0.0, 1.0, 0.0, 1.0) {
        vec4(s.x + value2(p * s.w, seed + index()) * s.y, s.y * 0.5, s.z + s.y, s.w * 2.03)
    };
    return sum.x / max(sum.z, 0.0001);
}

fn fbm3(p: Vec3, octaves: Int, seed: Int) -> Float {
    let sum = loop octaves with s = vec4(0.0, 1.0, 0.0, 1.0) {
        vec4(s.x + gradient3(p * s.w, seed + index()) * s.y, s.y * 0.5, s.z + s.y, s.w * 2.03)
    };
    return sum.x / max(sum.z, 0.0001);
}

/// Ridged noise, 0 to 1: sharp crests where the noise crosses zero, for
/// cracks, veins and mountain ridges.
fn ridged3(p: Vec3, octaves: Int, seed: Int) -> Float {
    let sum = loop octaves with s = vec4(0.0, 1.0, 0.0, 1.0) {
        let crest = 1.0 - abs(gradient3(p * s.w, seed + index()));
        vec4(s.x + crest * crest * s.y, s.y * 0.5, s.z + s.y, s.w * 2.03)
    };
    return sum.x / max(sum.z, 0.0001);
}
