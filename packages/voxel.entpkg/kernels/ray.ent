// Worlds of voxels: walking a ray through a volume, meeting boxes of
// voxels placed in the world, lighting what is met, and the camera the
// rays leave from. A voxel holds an Int, 0 empty; what a voxel's number
// means (a palette's color, a material) is the caller's.

/// A volume of voxels.
type Voxels = Volume<Int>;

/// A ray's walk through a box of voxels [0, n): the cell it stands in,
/// the distances to the cells' next sides, the distance walked, the face
/// it entered by (pointing back along the ray), and the voxel found: 0
/// while walking, its number once found, -1 once out of the box.
struct VoxelStep { cell: Vec3; side: Vec3; t: Float; face: Vec3; id: Int; }

fn voxel_over(d: Float) -> Float {
    return if abs(d) < 0.000001 { if d < 0.0 { -1000000.0 } else { 1000000.0 } } else { 1.0 / d };
}

fn voxel_within(c: Vec3, n: Vec3) -> Bool {
    return c.x >= 0.0 && c.x < n.x && c.y >= 0.0 && c.y < n.y && c.z >= 0.0 && c.z < n.z;
}

/// A ray from `from` along `dir`, in voxels, walked (Amanatides and Woo)
/// through the box of `n` voxels at `base` in the volume `vox` (a walk
/// takes at most 1024 steps: boxes of a few hundred voxels a side), to the
/// first voxel neither empty nor numbered from `pass.x` to `pass.y` (water
/// a ray sees through, say; `ivec2(1, 0)` passes nothing); id 0 for none.
/// Its distance `t` is in voxels along `dir`.
fn voxel_walk_past(vox: Voxels, from: Vec3, dir: Vec3, base: Vec3, n: Vec3, pass: IVec2) -> VoxelStep {
    // The distances along the ray to the box's low and high sides, each
    // axis; the ray is inside from the last entry to the first exit.
    let over = vec3(voxel_over(dir.x), voxel_over(dir.y), voxel_over(dir.z));
    let lows = -from * over;
    let highs = (n - from) * over;
    let enter = min(lows, highs);
    let leave = max(lows, highs);
    let tnear = max(max(enter.x, enter.y), max(enter.z, 0.0));
    let tfar = min(min(leave.x, leave.y), leave.z);
    let p = from + dir * (tnear + 0.0005);
    let cell = clamp(floor(p), vec3(0.0, 0.0, 0.0), n - 1.0);
    let step = vec3(if dir.x < 0.0 { -1.0 } else { 1.0 }, if dir.y < 0.0 { -1.0 } else { 1.0 }, if dir.z < 0.0 { -1.0 } else { 1.0 });
    let delta = abs(over);
    let side = (cell + max(step, 0.0) - from) * over;
    let entry = if tnear == enter.x { vec3(-step.x, 0.0, 0.0) } else if tnear == enter.y { vec3(0.0, -step.y, 0.0) } else { vec3(0.0, 0.0, -step.z) };
    let start = VoxelStep { cell: cell, side: side, t: tnear, face: entry, id: if tfar > tnear { 0 } else { -1 } };
    let found = loop 1024 with w = start until w.id != 0 {
        let id = at(vox, w.cell + base);
        if id > 0 && !(id >= pass.x && id <= pass.y) { VoxelStep { ..w, id: id } } else {
            let x_first = w.side.x < w.side.y && w.side.x < w.side.z;
            let y_first = !x_first && w.side.y < w.side.z;
            let next = if x_first { w.cell + vec3(step.x, 0.0, 0.0) } else if y_first { w.cell + vec3(0.0, step.y, 0.0) } else { w.cell + vec3(0.0, 0.0, step.z) };
            let t = if x_first { w.side.x } else if y_first { w.side.y } else { w.side.z };
            let side_next = if x_first { w.side + vec3(delta.x, 0.0, 0.0) } else if y_first { w.side + vec3(0.0, delta.y, 0.0) } else { w.side + vec3(0.0, 0.0, delta.z) };
            let face = if x_first { vec3(-step.x, 0.0, 0.0) } else if y_first { vec3(0.0, -step.y, 0.0) } else { vec3(0.0, 0.0, -step.z) };
            VoxelStep { cell: next, side: side_next, t: t, face: face, id: if voxel_within(next, n) { 0 } else { -1 } }
        }
    };
    return if found.id > 0 { found } else { VoxelStep { ..found, id: 0 } };
}

/// The first voxel that is not empty, as `voxel_walk_past` passing none.
fn voxel_walk(vox: Voxels, from: Vec3, dir: Vec3, base: Vec3, n: Vec3) -> VoxelStep {
    return voxel_walk_past(vox, from, dir, base, n, ivec2(1, 0));
}

/// A box of voxels standing in the world: its `n` voxels at `base` in its
/// volume, each `size` world units wide, the middle of its floor at
/// `foot`, turned by `turn` about the up axis (y). A still world is a box
/// too, its floor's middle where it stands and its turn 0.
struct VoxelBox { base: Vec3; n: Vec3; size: Float; foot: Vec3; turn: Float; }

/// What a ray met: how far along it in world units, the voxel's number
/// (0 nothing), and the face met, in the world.
struct VoxelMeet { t: Float; id: Int; face: Vec3; }

fn voxel_nothing() -> VoxelMeet { return VoxelMeet { t: 1000000.0, id: 0, face: vec3(0.0, 1.0, 0.0) }; }

/// The nearer of two meetings.
fn voxel_nearer(a: VoxelMeet, b: VoxelMeet) -> VoxelMeet { return if b.t < a.t { b } else { a }; }

/// A world point in a box's own frame, in its voxels, its floor's middle
/// at the origin.
fn voxel_local(m: Vec3, foot: Vec3, turn: Float, size: Float) -> Vec3 {
    let d = m - foot;
    let c = cos(turn);
    let s = sin(turn);
    return vec3(d.x * c - d.z * s, d.y, d.x * s + d.z * c) / size;
}

/// A direction in a box's own frame turned back into the world.
fn voxel_unturned(v: Vec3, turn: Float) -> Vec3 {
    let c = cos(turn);
    let s = sin(turn);
    return vec3(v.x * c + v.z * s, v.y, -v.x * s + v.z * c);
}

/// The first voxel of box `b` a ray from `eye` along the unit `dir` (the
/// world's) meets, its voxels within `near` world units of the eye left
/// out (so a box beside the camera never fills the picture), and those
/// numbered `pass.x` to `pass.y` seen through.
fn voxel_meet_past(vox: Voxels, b: VoxelBox, eye: Vec3, dir: Vec3, near: Float, pass: IVec2) -> VoxelMeet {
    let middle = b.foot + vec3(0.0, b.n.y * 0.5 * b.size, 0.0);
    let to = middle - eye;
    let across = length(to - dir * dot(to, dir));
    let half = length(b.n) * 0.5 * b.size;
    if across > half || dot(to, dir) < -half { return voxel_nothing(); }
    let e = voxel_local(eye, b.foot, b.turn, b.size) + vec3(b.n.x * 0.5, 0.0, b.n.z * 0.5);
    let d = voxel_local(dir, vec3(0.0, 0.0, 0.0), b.turn, 1.0);
    let skip = near / b.size;
    let w = voxel_walk_past(vox, e + d * skip, d, b.base, b.n, pass);
    return if w.id > 0 { VoxelMeet { t: (w.t + skip) * b.size, id: w.id, face: voxel_unturned(w.face, b.turn) } } else { voxel_nothing() };
}

/// The cell of box `b` a ray from `eye` along `dir` met, in the box's
/// voxels: the one behind the face `met` found.
fn voxel_cell(b: VoxelBox, eye: Vec3, dir: Vec3, met: VoxelMeet) -> Vec3 {
    let inside = eye + dir * met.t - met.face * (b.size * 0.5);
    return floor(voxel_local(inside, b.foot, b.turn, b.size) + vec3(b.n.x * 0.5, 0.0, b.n.z * 0.5));
}

/// The first voxel of box `b` a ray meets, as `voxel_meet_past` seeing
/// through none.
fn voxel_meet(vox: Voxels, b: VoxelBox, eye: Vec3, dir: Vec3, near: Float) -> VoxelMeet {
    return voxel_meet_past(vox, b, eye, dir, near, ivec2(1, 0));
}
