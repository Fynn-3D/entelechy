scene world.esn

# Stone where the block was baked, grass in the sphere above it, and the
# stroke's sphere carved out of the block's corner.
frame 0.0
expect baked.result[8272] = 1
expect baked.result[8528] = 2
expect dug.result[4328] = 0
expect baked.result[4328] = 1

# Beside the block on the ground: shaded from a sun across it, lit by one
# overhead.
expect shade.result[0] = 1
expect shade.result[1] = 0

# The body's lower half where it stood, its upper half carried two
# voxels along x by its joint.
expect posed.result[399] = 0
expect posed.result[402] = 1
expect posed.result[462] = 0
expect posed.result[464] = 1
