// A small world of voxel shapes: a stone block with a sphere of grass on
// it, a pit carved by a later stroke, seen by the view preset; and a body
// of two joints posed by turning its upper joint a quarter about up.
use "../kernels/";

node shapes: kernel {
    requires { field.write; }
    output result: Rows<VoxelShape>;
    domain = 2;
    compute {
        return if element() == 0 { voxel_cuboid(vec3(16.0, 4.0, 16.0), vec3(12.0, 4.0, 12.0), 1.0, 1) }
            else { voxel_sphere(vec3(16.0, 10.0, 16.0), 5.0, 2) };
    }
}
node stroke: kernel {
    requires { field.write; }
    output result: Rows<VoxelShape>;
    domain = 1;
    compute { return voxel_sphere(vec3(8.0, 8.0, 8.0), 3.0, 0); }
}
node colors: kernel {
    requires { field.write; }
    output result: Rows<Vec3>;
    domain = 3;
    compute { return [vec3(0.0, 0.0, 0.0), vec3(0.5, 0.5, 0.55), vec3(0.3, 0.6, 0.25)][element()]; }
}
node baked: voxel.shapes@1 { shapes <- shapes.result; domain = vec3(32, 16, 32); }
node dug: voxel.paint@1 { volume <- baked.result; shapes <- stroke.result; }
node look: graph "../graphs/view.esn" { volume <- dug.result; colors <- colors.result; }

// A body of two joints: a column of 1s at rest, its top half on joint 1.
node rest: kernel {
    requires { field.write; }
    output result: Volume<Int>;
    domain = vec3(8, 8, 8);
    compute { let c = icoord(); return if c.x == 4 && c.z == 4 { voxel_body(1, if c.y >= 4 { 1 } else { 0 }) } else { 0 }; }
}
node palette: kernel {
    requires { field.write; }
    output result: Rows<Mat4>;
    domain = 2;
    compute {
        let id = mat4(vec4(1.0, 0.0, 0.0, 0.0), vec4(0.0, 1.0, 0.0, 0.0), vec4(0.0, 0.0, 1.0, 0.0), vec4(0.0, 0.0, 0.0, 1.0));
        let tilt = mat4(vec4(1.0, 0.0, 0.0, 0.0), vec4(0.0, 1.0, 0.0, 0.0), vec4(0.0, 0.0, 1.0, 0.0), vec4(2.0, 0.0, 0.0, 1.0));
        return if element() == 0 { id } else { tilt };
    }
}
node unposing: voxel.unposing@1 { palette <- palette.result; }
node posed: voxel.posed@1 { rest <- rest.result; unposing <- unposing.result; domain = vec3(12, 8, 8); }

output result <- look.result;
