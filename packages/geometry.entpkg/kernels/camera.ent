// A camera's matrices and the ways between the world, the clip space a
// rasterizer takes and the picture. The camera looks down its -z; clip
// space is the one `raster` takes: after the divide by w, x and y span
// [-1, 1] with y up and z spans [0, 1], near to far; w is the distance
// in front of the camera.

/// A perspective projection: `fov_y` radians from the bottom of the
/// picture to its top, `aspect` its width over its height, the near and
/// far planes at those distances.
fn perspective(fov_y: Float, aspect: Float, near: Float, far: Float) -> Mat4 {
    return perspective_focal(1.0 / tan(fov_y * 0.5), aspect, near, far);
}

/// A perspective projection by its focal length `f`, how far the picture
/// is from the eye in half heights of it (`1 / tan(fov_y / 2)`).
fn perspective_focal(f: Float, aspect: Float, near: Float, far: Float) -> Mat4 {
    let depth = far / (near - far);
    return mat4(
        vec4(f / aspect, 0.0, 0.0, 0.0),
        vec4(0.0, f, 0.0, 0.0),
        vec4(0.0, 0.0, depth, -1.0),
        vec4(0.0, 0.0, near * depth, 0.0));
}

/// The view from `eye` toward `target`, `up` the way that stays up in the
/// picture: a matrix taking the world into the camera's space.
fn look_at(eye: Vec3, target: Vec3, up: Vec3) -> Mat4 {
    let f = normalize(target - eye);
    let s = normalize(cross(f, up));
    let u = cross(s, f);
    return mat4(
        vec4(s.x, u.x, -f.x, 0.0),
        vec4(s.y, u.y, -f.y, 0.0),
        vec4(s.z, u.z, -f.z, 0.0),
        vec4(-dot(s, eye), -dot(u, eye), dot(f, eye), 1.0));
}

/// Where a camera orbiting `target` stands: `distance` away, turned `yaw`
/// radians about up from +z and raised `pitch` radians above the horizon.
fn orbit_eye(target: Vec3, yaw: Float, pitch: Float, distance: Float) -> Vec3 {
    return target + vec3(sin(yaw) * cos(pitch), sin(pitch), cos(yaw) * cos(pitch)) * distance;
}

/// The view of a camera orbiting `target` (see `orbit_eye`), up kept up.
fn orbit_view(target: Vec3, yaw: Float, pitch: Float, distance: Float) -> Mat4 {
    return look_at(orbit_eye(target, yaw, pitch, distance), target, vec3(0.0, 1.0, 0.0));
}

/// A point carried by a matrix into clip space.
fn clip_point(m: Mat4, p: Vec3) -> Vec4 {
    return m * vec4(p.x, p.y, p.z, 1.0);
}

/// Where a point in clip space lands on a picture `size` large: its pixel
/// (x right, y down) and its depth, 0 at the near plane to 1 at the far.
fn screen_point(clip: Vec4, size: Vec2) -> Vec3 {
    let ndc = clip.xyz / clip.w;
    return vec3((ndc.x + 1.0) * 0.5 * size.x, (1.0 - ndc.y) * 0.5 * size.y, ndc.z);
}

/// The direction in the world through pixel `pixel` of a picture `size`
/// large, seen by a camera of view `view` and field `fov_y`.
fn pixel_ray(view: Mat4, fov_y: Float, pixel: Vec2, size: Vec2) -> Vec3 {
    let t = tan(fov_y * 0.5);
    let ndc = vec2(pixel.x / size.x * 2.0 - 1.0, 1.0 - pixel.y / size.y * 2.0);
    let inside = vec3(ndc.x * t * size.x / size.y, ndc.y * t, -1.0);
    let world = transpose(view) * vec4(inside.x, inside.y, inside.z, 0.0);
    return normalize(world.xyz);
}

/// Where the camera of view `view` stands in the world.
fn view_eye(view: Mat4) -> Vec3 {
    let at = inverse(view) * vec4(0.0, 0.0, 0.0, 1.0);
    return at.xyz;
}

// ------------------------------------------------------------------ a lens

/// A pinhole lens as a picture is taken through it: where it stands, its facing, right and up, and its focal length (the
/// picture's height is 1).
struct Lens { eye: Vec3; ahead: Vec3; right: Vec3; up: Vec3; focal: Float; }
type Lenses = Rows<Lens>;
/// The view ray of pixel `q` (in a picture `extent` large).
fn ray(l: Lens, q: Vec2, extent: Vec2) -> Vec3 {
    let uv = ((q + 0.5) / extent - 0.5) * vec2(extent.x / extent.y, -1.0);
    return normalize(l.ahead * l.focal + l.right * uv.x + l.up * uv.y);
}

/// The pixel of a screen `extent` large a world point `p` falls on (xy), and how far from the camera it is (z); behind
/// the camera, z is negative.
fn project(l: Lens, p: Vec3, extent: Vec2) -> Vec3 {
    let d = p - l.eye;
    let ahead = dot(d, l.ahead);
    let uv = vec2(dot(d, l.right), dot(d, l.up)) / max(ahead, 0.0001) * l.focal;
    let px = (uv / vec2(extent.x / extent.y, -1.0) + 0.5) * extent;
    return vec3(px.x, px.y, if ahead > 0.0 { length(d) } else { -1.0 });
}

/// A world point `p`'s clip coordinates for the rasterizer (a picture `extent` large; near and far clipping planes `near` and
/// `far` meters): x, y, depth times w, and w the distance along the lens's facing.
fn lens_clip(l: Lens, extent: Vec2, p: Vec3, near: Float, far: Float) -> Vec4 {
    let d = p - l.eye;
    let ahead = dot(d, l.ahead);
    let aspect = extent.x / max(extent.y, 1.0);
    return vec4(dot(d, l.right) * l.focal * 2.0 / aspect, dot(d, l.up) * l.focal * 2.0, (ahead - near) * far / (far - near), ahead);
}

/// How far along view ray `dir` a depth the rasterizer drew lies, the depth of a point `lens_clip` placed between `near` and
/// `far`.
fn lens_distance(l: Lens, dir: Vec3, depth: Float, near: Float, far: Float) -> Float {
    let ahead = near * far / max(far - depth * (far - near), 0.000001);
    return ahead / max(dot(dir, l.ahead), 0.000001);
}

/// How wide in the world one pixel of a picture `height` pixels tall is at `distance` from the lens.
fn lens_pixel(l: Lens, distance: Float, height: Float) -> Float {
    return max(distance, 0.0) / max(l.focal * height, 0.000001);
}

/// How wide across a surface of unit `normal` one pixel of a picture `height` pixels tall reaches along unit ray `dir` at
/// `distance` (widened up to sixteenfold at grazing angles, as `texture`'s `pix` takes).
fn lens_footprint(l: Lens, dir: Vec3, normal: Vec3, distance: Float, height: Float) -> Float {
    return lens_pixel(l, distance, height) / max(abs(dot(dir, normal)), 0.0625);
}

/// A lens at `eye` looking at `target`, the world's up kept up.
fn lens_looking(eye: Vec3, target: Vec3, focal: Float) -> Lens {
    let ahead = normalize(target - eye);
    let right = normalize(cross(ahead, vec3(0.0, 1.0, 0.0)));
    return Lens { eye: eye, ahead: ahead, right: right, up: cross(right, ahead), focal: focal };
}

/// A lens orbiting `target` (see `orbit_eye`), up kept up, `focal` long.
fn lens_orbiting(target: Vec3, yaw: Float, pitch: Float, distance: Float, focal: Float) -> Lens {
    return lens_looking(orbit_eye(target, yaw, pitch, distance), target, focal);
}
