// Triangle-mesh ray tracing as Kernels. The rule is the one `native.trace@1`
// and `native.trace@2` accelerate with hardware ray tracing (BLAS / TLAS) or
// BVH traversal, written out so every backend agrees:
//
// - A ray is `origin: Vec3; tmin: Float; dir: Vec3; tmax: Float;`. Rays with
//   non-finite origin/direction/tmin, `tmin < 0`, `NaN` tmax, or `tmax <= tmin`
//   miss without touching any triangle.
// - A triangle is three vertex indices `(a, b, c)` clamped into the mesh's
//   vertex range. Triangles with non-finite corners or zero area are skipped.
// - Front faces wind counter-clockwise when viewed against `dir` (so
//   `dot(dir, cross(v1 - v0, v2 - v0)) < 0`). Under a negative-determinant
//   instance transform, world-space winding reverses accordingly.
// - `flags` bit 0 (`1`) terminates on first hit, bit 1 (`2`) culls back faces,
//   and bit 2 (`4`) culls front faces.

/// A ray segment from `origin + dir * tmin` to `origin + dir * tmax`.
struct TraceRay { origin: Vec3; tmin: Float; dir: Vec3; tmax: Float; }

/// The result of tracing a ray (`triangle == -1` and `t == -1.0` on miss).
struct TraceHit { t: Float; bary: Vec2; triangle: Int; instance: Int; custom: Int; front: Bool; }

/// Three vertex row indices forming one triangle.
struct TraceTriangle { a: Int; b: Int; c: Int; }

/// A mesh slice within shared `vertices` and `triangles` buffers.
struct TraceMesh { vertex_offset: Int; vertex_count: Int; triangle_offset: Int; triangle_count: Int; }

/// One instanced mesh transform (`row0..row2` row-major 3x4 affine object-to-world).
struct TraceInstance { row0: Vec4; row1: Vec4; row2: Vec4; mesh: Int; custom: Int; mask: Int; }

/// A miss hit record (`t = -1.0`, `triangle = -1`, `instance = -1`).
fn trace_miss() -> TraceHit {
    return TraceHit {
        t: -1.0,
        bary: vec2(0.0, 0.0),
        triangle: -1,
        instance: -1,
        custom: 0,
        front: false
    };
}

fn trace_finite(x: Float) -> Bool { return !(isnan(x) || isinf(x)); }

fn trace_finite3(v: Vec3) -> Bool {
    return trace_finite(v.x) && trace_finite(v.y) && trace_finite(v.z);
}

fn trace_ray_valid(r: TraceRay) -> Bool {
    return trace_finite3(r.origin)
        && trace_finite3(r.dir)
        && trace_finite(r.tmin)
        && r.tmin >= 0.0
        && !isnan(r.tmax)
        && r.tmax > r.tmin;
}

/// Moller-Trumbore ray-triangle intersection against `(v0, v1, v2)`.
/// Returns `vec4(t, u, v, det)` on hit (`det > 0` for a CCW front face), or
/// `vec4(-1.0, 0.0, 0.0, 0.0)` on miss.
fn ray_triangle(origin: Vec3, dir: Vec3, tmin: Float, tmax: Float, v0: Vec3, v1: Vec3, v2: Vec3) -> Vec4 {
    let miss = vec4(-1.0, 0.0, 0.0, 0.0);
    if !trace_finite3(v0) || !trace_finite3(v1) || !trace_finite3(v2) { return miss; }
    let e1 = v1 - v0;
    let e2 = v2 - v0;
    let h = cross(dir, e2);
    let det = dot(e1, h);
    if det == 0.0 || !trace_finite(det) { return miss; }
    let inv_det = 1.0 / det;
    let s = origin - v0;
    let u = dot(s, h) * inv_det;
    if u < 0.0 || u > 1.0 { return miss; }
    let q = cross(s, e1);
    let v = dot(dir, q) * inv_det;
    if v < 0.0 || u + v > 1.0 { return miss; }
    let t = dot(e2, q) * inv_det;
    return if t >= tmin && t <= tmax { vec4(t, u, v, det) } else { miss };
}

fn trace_mesh_slice(
    vertices: Rows<Vec3>,
    triangles: Rows<TraceTriangle>,
    v_off: Int,
    v_cnt: Int,
    t_off: Int,
    t_cnt: Int,
    origin: Vec3,
    dir: Vec3,
    tmin: Float,
    tmax: Float,
    inst_row: Int,
    custom: Int,
    flip_winding: Bool,
    flags: Int,
    best_in: TraceHit
) -> TraceHit {
    let any_hit = (flags & 1) != 0;
    let cull_back = (flags & 2) != 0;
    let cull_front = (flags & 4) != 0;
    if v_cnt <= 0 || t_cnt <= 0 || (cull_back && cull_front) { return best_in; }
    let max_v = v_cnt - 1;
    return loop t_cnt with best = best_in until (any_hit && best.triangle >= 0) {
        let local_t = index();
        let tri = at(triangles, t_off + local_t);
        let v0 = at(vertices, v_off + clamp(tri.a, 0, max_v));
        let v1 = at(vertices, v_off + clamp(tri.b, 0, max_v));
        let v2 = at(vertices, v_off + clamp(tri.c, 0, max_v));
        let cur_tmax = if best.triangle >= 0 { best.t } else { tmax };
        let res = ray_triangle(origin, dir, tmin, cur_tmax, v0, v1, v2);
        let hit_front = if flip_winding { res.w <= 0.0 } else { res.w > 0.0 };
        let culled = (cull_back && !hit_front) || (cull_front && hit_front);
        let valid = res.x >= 0.0 && !culled;
        let closer = best.triangle < 0
            || res.x < best.t
            || (res.x == best.t && (inst_row < best.instance || (inst_row == best.instance && local_t < best.triangle)));
        if valid && closer {
            TraceHit {
                t: res.x,
                bary: vec2(res.y, res.z),
                triangle: local_t,
                instance: inst_row,
                custom: custom,
                front: hit_front
            }
        } else {
            best
        }
    };
}

/// Reference single-mesh ray tracer matching `native.trace@1`.
kernel geometry.trace@1 {
    requires { field.read; field.write; }
    input rays: Rows<TraceRay>;
    input vertices: Rows<Vec3>;
    input triangles: Rows<TraceTriangle>;
    param flags: Int = 0;
    output hits: Rows<TraceHit>;
    compute {
        let r = sample(rays);
        let miss = trace_miss();
        if !trace_ray_valid(r) { return miss; }
        return trace_mesh_slice(
            vertices,
            triangles,
            0,
            count(vertices),
            0,
            count(triangles),
            r.origin,
            r.dir,
            r.tmin,
            r.tmax,
            0,
            0,
            false,
            flags,
            miss
        );
    }
}

/// Reference instanced multi-mesh ray tracer matching `native.trace@2`.
kernel geometry.trace_instances@1 {
    requires { field.read; field.write; }
    input rays: Rows<TraceRay>;
    input vertices: Rows<Vec3>;
    input triangles: Rows<TraceTriangle>;
    input meshes: Rows<TraceMesh>;
    input instances: Rows<TraceInstance>;
    param flags: Int = 0;
    param mask: Int = 255;
    output hits: Rows<TraceHit>;
    compute {
        let r = sample(rays);
        let miss = trace_miss();
        let ray_mask = mask & 255;
        if !trace_ray_valid(r) || ray_mask == 0 { return miss; }
        let total_v = count(vertices);
        let total_t = count(triangles);
        let mesh_n = count(meshes);
        let inst_n = count(instances);
        let any_hit = (flags & 1) != 0;
        return loop inst_n with best = miss until (any_hit && best.triangle >= 0) {
            let inst_row = index();
            let inst = at(instances, inst_row);
            let imask = inst.mask & 255;
            let in_range = (imask & ray_mask) != 0 && inst.mesh >= 0 && inst.mesh < mesh_n;
            let m = at(meshes, clamp(inst.mesh, 0, max(mesh_n - 1, 0)));
            let v_off = clamp(m.vertex_offset, 0, total_v);
            let v_cnt = clamp(m.vertex_count, 0, total_v - v_off);
            let t_off = clamp(m.triangle_offset, 0, total_t);
            let t_cnt = clamp(m.triangle_count, 0, total_t - t_off);
            let mesh_ok = in_range
                && m.vertex_offset >= 0 && m.vertex_count > 0
                && m.triangle_offset >= 0 && m.triangle_count > 0
                && v_cnt > 0 && t_cnt > 0;
            let c0 = inst.row0.xyz;
            let c1 = inst.row1.xyz;
            let c2 = inst.row2.xyz;
            let det = dot(c0, cross(c1, c2));
            let ok = mesh_ok && trace_finite(det) && abs(det) >= 0.000000000001
                && trace_finite(inst.row0.w) && trace_finite(inst.row1.w) && trace_finite(inst.row2.w);
            let safe_det = if ok { det } else { 1.0 };
            let inv_det = 1.0 / safe_det;
            let i00 = (inst.row1.y * inst.row2.z - inst.row1.z * inst.row2.y) * inv_det;
            let i01 = (inst.row0.z * inst.row2.y - inst.row0.y * inst.row2.z) * inv_det;
            let i02 = (inst.row0.y * inst.row1.z - inst.row0.z * inst.row1.y) * inv_det;
            let i10 = (inst.row1.z * inst.row2.x - inst.row1.x * inst.row2.z) * inv_det;
            let i11 = (inst.row0.x * inst.row2.z - inst.row0.z * inst.row2.x) * inv_det;
            let i12 = (inst.row0.z * inst.row1.x - inst.row0.x * inst.row1.z) * inv_det;
            let i20 = (inst.row1.x * inst.row2.y - inst.row1.y * inst.row2.x) * inv_det;
            let i21 = (inst.row0.y * inst.row2.x - inst.row0.x * inst.row2.y) * inv_det;
            let i22 = (inst.row0.x * inst.row1.y - inst.row0.y * inst.row1.x) * inv_det;
            let t_w = vec3(inst.row0.w, inst.row1.w, inst.row2.w);
            let rel = r.origin - t_w;
            let obj_o = vec3(
                i00 * rel.x + i01 * rel.y + i02 * rel.z,
                i10 * rel.x + i11 * rel.y + i12 * rel.z,
                i20 * rel.x + i21 * rel.y + i22 * rel.z
            );
            let obj_d = vec3(
                i00 * r.dir.x + i01 * r.dir.y + i02 * r.dir.z,
                i10 * r.dir.x + i11 * r.dir.y + i12 * r.dir.z,
                i20 * r.dir.x + i21 * r.dir.y + i22 * r.dir.z
            );
            if ok {
                trace_mesh_slice(
                    vertices,
                    triangles,
                    v_off,
                    v_cnt,
                    t_off,
                    t_cnt,
                    obj_o,
                    obj_d,
                    r.tmin,
                    r.tmax,
                    inst_row,
                    inst.custom,
                    det < 0.0,
                    flags,
                    best
                )
            } else {
                best
            }
        };
    }
}
