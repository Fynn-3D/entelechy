scene lens.esn

# Where the lens stands and how it faces; the middle ray is its facing.
frame 0.0
expect probe.result[0] = 0 1 5 1.3 0.00001
expect probe.result[1] = -1 1 1 0 0.00001
expect probe.result[2] = 0 0 -1 0 0.00001

# The target at the middle, five meters off; (1, 1.5, 0) a fifth of the
# focal length across (0.26 of the height) and a tenth up: pixel (126,
# 37), root 26.25 meters off; the ray back is the way to it, and its
# clipped depth leads back to that distance.
expect probe.result[3] = 100 50 5 0 0.0001
expect probe.result[4] = 126 37 5.123475 0 0.0001
expect probe.result[5] = 0 0 0 5.123475 0.0001

# Looking from (0, 1, 5) at the target is the orbiting lens; a tangent,
# straight up or slanting, is square to its normal and one long.
expect probe.result[6] = 0 0 1.3 0 0.00001
expect probe.result[7] = 0 1 0 1 0.00001

# At five meters, twenty-six pixels span one meter; across a surface the
# footprint is one pixel head-on, twice at sixty degrees, and sixteenfold
# at the silhouette.
expect probe.result[8] = 1 1 2 16 0.0001
