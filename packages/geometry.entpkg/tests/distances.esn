// Signed distances at points whose answers are known by hand, and the
// turns of a vector.
use "../kernels/";

node solids: kernel {
    requires { field.write; }
    output result: Rows<Vec4>;
    domain = 3;
    compute {
        let k = element();
        let p = [vec3(2.0, 0.0, 0.0), vec3(0.0, 0.5, 0.0), vec3(3.0, 4.0, 0.0)][k];
        return vec4(sd_sphere(p, 1.0), sd_box(p, vec3(1.0, 1.0, 1.0)), sd_capsule(p, vec3(0.0, -1.0, 0.0), vec3(0.0, 1.0, 0.0), 0.5), sd_torus(p, 2.0, 0.5));
    }
}
node more: kernel {
    requires { field.write; }
    output result: Rows<Vec4>;
    domain = 2;
    compute {
        let p = [vec3(2.0, 3.0, 0.0), vec3(0.0, 0.0, 0.0)][element()];
        return vec4(sd_round_box(p, vec3(1.0, 1.0, 1.0), 0.25), sd_cylinder(p, 1.0, 1.0), sd_plane(p, vec3(0.0, 1.0, 0.0), 1.0), 0.0);
    }
}
node flats: kernel {
    requires { field.write; }
    output result: Rows<Vec4>;
    domain = 2;
    compute {
        let p = [vec2(3.0, 0.0), vec2(2.0, 2.0)][element()];
        return vec4(sd_circle(p, 1.0), sd_rect(p, vec2(1.0, 1.0)), sd_round_rect(p, vec2(1.0, 1.0), 0.5), sd_segment(p, vec2(0.0, 0.0), vec2(1.0, 0.0)));
    }
}
node joins: kernel {
    requires { field.write; }
    output result: Rows<Vec4>;
    domain = 1;
    compute { return vec4(smooth_union(0.2, 0.3, 0.0), smooth_union(0.2, 0.2, 0.4), smooth_subtract(0.5, -0.2, 0.0), smooth_intersect(0.5, 0.1, 0.0)); }
}
node turns: kernel {
    requires { field.write; }
    output result: Rows<Vec4>;
    domain = 3;
    compute {
        let k = element();
        return if k == 0 { vec4(rotated(vec3(1.0, 0.0, 0.0), vec3(0.0, 0.0, 3.0), 1.5707963), 0.0) }
            else if k == 1 { vec4(rotated_yaw(vec3(0.0, 0.0, 1.0), 1.5707963), 0.0) }
            else { vec4(rotated2(vec2(1.0, 0.0), 1.5707963), rotated(vec3(1.0, 2.0, 3.0), vec3(0.0, 0.0, 0.0), 1.0).yz) };
    }
}

output result <- solids.result;
