// Space bent at points whose answers are known by hand, and the shapes
// added for it: a chamfered box, a cut cone, a lattice of cubes.
use "../kernels/";

node repeats: kernel {
    requires { field.write; }
    output result: Rows<Vec4>;
    domain = 3;
    compute {
        let k = element();
        return if k == 0 { vec4(warp_repeat(vec3(7.0, -3.0, 0.4), vec3(4.0, 4.0, 4.0)), warp_repeat_wall(warp_repeat(vec3(7.0, -3.0, 0.4), vec3(4.0, 4.0, 4.0)), vec3(4.0, 4.0, 4.0))) }
            else if k == 1 { vec4(warp_repeat_cell(vec3(7.0, -3.0, 0.4), vec3(4.0, 4.0, 4.0)), 0.0) }
            else { vec4(warp_repeat_limited(vec3(30.0, 0.0, 0.0), vec3(4.0, 4.0, 4.0), vec3(-2.0, 0.0, 0.0), vec3(2.0, 0.0, 0.0)), 0.0) };
    }
}
node flats: kernel {
    requires { field.write; }
    output result: Rows<Vec4>;
    domain = 2;
    compute {
        return if element() == 0 { vec4(warp_repeat2(vec2(5.0, -1.0), vec2(4.0, 4.0)), warp_repeat_cell2(vec2(5.0, -1.0), vec2(4.0, 4.0))) }
            else { vec4(warp_sectors(vec2(0.0, 2.0), 4, 0.0), warp_fold(vec2(-0.3472964, -1.9696155), 6, 0.0)) };
    }
}
node bends: kernel {
    requires { field.write; }
    output result: Rows<Vec4>;
    domain = 4;
    compute {
        let k = element();
        return if k == 0 { vec4(warp_mirror(vec3(-3.0, 1.0, 2.0), vec3(1.0, 0.0, 0.0), 1.0), warp_twist_stretch(2.0, 0.5)) }
            else if k == 1 { vec4(warp_twist(vec3(1.0, 1.5707963, 0.0), 1.0), warp_bend_stretch(0.0, 3.0)) }
            else if k == 2 { vec4(warp_bend(vec3(1.5707963, 0.0, 0.5), 1.0), 0.0) }
            else { vec4(warp_scale(vec3(5.0, 5.0, 5.0), vec3(1.0, 1.0, 1.0), vec3(2.0, 4.0, 1.0)), 0.0) };
    }
}
node rolls: kernel {
    requires { field.write; }
    output result: Rows<Vec4>;
    domain = 3;
    compute {
        let k = element();
        // Before the roll, as it is; on the wall a quarter round the cylinder of radius 10; half way to its axis.
        let p = [vec3(1.0, 0.0, 3.0), vec3(0.0, 10.0, 20.0), vec3(0.0, 10.0, 15.0)][k];
        return vec4(warp_roll(p, 10.0, 10.0), warp_roll_stretch(p, 10.0, 10.0, 8.0));
    }
}
node shapes: kernel {
    requires { field.write; }
    output result: Rows<Vec4>;
    domain = 2;
    compute {
        let p = [vec3(3.0, 0.0, 3.0), vec3(0.0, 2.0, 0.0)][element()];
        let c = sd_lattice_cube(vec3(0.0, 0.0, 0.9), 2.0, 0.5);
        return vec4(sd_chamfer_box(p, vec3(2.0, 1.0, 2.0), 1.0), sd_cone(p, 2.0, 1.0, 1.0), c.x, c.y);
    }
}

output result <- repeats.result;
