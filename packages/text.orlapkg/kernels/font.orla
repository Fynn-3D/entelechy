/// The font: a 5x7 bitmap face for the printable ASCII codes, 32 to 126,
/// written as its rows and baked into an atlas the text library reads.
/// The atlas is a Grid<Float> of 96 by 48 texels: sixteen cells of 6 by 8
/// per row, six rows, the glyph in the top-left 5 by 7 of its cell and a
/// blank column and row beside it, so cell (code - 32) % 16, (code - 32)
/// / 16 holds a code. Bake it with
///   orla run examples/text/bake.osn --save font=examples/shared/font.png
/// Each glyph is its seven rows, top first, each row five bits with the
/// leftmost pixel highest: `rows(14, 17, 17, 31, 17, 17, 17)` is an A.
kernel text.font@1 {
    requires { field.write; }
    output result: Grid<Float>;

    // Seven five-bit rows packed into two words: the top four in `hi`,
    // the bottom three in `lo`.
    struct Bitmap { hi: Int; lo: Int; }

    fn rows(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int) -> Bitmap {
        return Bitmap { hi: a * 32768 + b * 1024 + c * 32 + d, lo: e * 1024 + f * 32 + g };
    }

    fn row_of(b: Bitmap, y: Int) -> Int {
        return if y == 0 { b.hi / 32768 } else if y == 1 { b.hi / 1024 % 32 }
            else if y == 2 { b.hi / 32 % 32 } else if y == 3 { b.hi % 32 }
            else if y == 4 { b.lo / 1024 } else if y == 5 { b.lo / 32 % 32 } else { b.lo % 32 };
    }

    // Space, punctuation, and the digits.
    fn low(c: Int) -> Bitmap {
        return
        if c == 32 { rows(0, 0, 0, 0, 0, 0, 0) }   // space
        else if c == 33 { rows(4, 4, 4, 4, 4, 0, 4) }   // !
        else if c == 34 { rows(10, 10, 10, 0, 0, 0, 0) }   // "
        else if c == 35 { rows(10, 10, 31, 10, 31, 10, 10) }   // #
        else if c == 36 { rows(4, 15, 20, 14, 5, 30, 4) }   // $
        else if c == 37 { rows(24, 25, 2, 4, 8, 19, 3) }   // %
        else if c == 38 { rows(12, 18, 20, 8, 21, 18, 13) }   // &
        else if c == 39 { rows(4, 4, 4, 0, 0, 0, 0) }   // '
        else if c == 40 { rows(2, 4, 8, 8, 8, 4, 2) }   // (
        else if c == 41 { rows(8, 4, 2, 2, 2, 4, 8) }   // )
        else if c == 42 { rows(0, 4, 21, 14, 21, 4, 0) }   // *
        else if c == 43 { rows(0, 4, 4, 31, 4, 4, 0) }   // +
        else if c == 44 { rows(0, 0, 0, 0, 12, 4, 8) }   // ,
        else if c == 45 { rows(0, 0, 0, 31, 0, 0, 0) }   // -
        else if c == 46 { rows(0, 0, 0, 0, 0, 12, 12) }   // .
        else if c == 47 { rows(0, 1, 2, 4, 8, 16, 0) }   // /
        else if c == 48 { rows(14, 17, 19, 21, 25, 17, 14) }   // 0
        else if c == 49 { rows(4, 12, 4, 4, 4, 4, 14) }   // 1
        else if c == 50 { rows(14, 17, 1, 2, 4, 8, 31) }   // 2
        else if c == 51 { rows(31, 2, 4, 2, 1, 17, 14) }   // 3
        else if c == 52 { rows(2, 6, 10, 18, 31, 2, 2) }   // 4
        else if c == 53 { rows(31, 16, 30, 1, 1, 17, 14) }   // 5
        else if c == 54 { rows(6, 8, 16, 30, 17, 17, 14) }   // 6
        else if c == 55 { rows(31, 1, 2, 4, 8, 8, 8) }   // 7
        else if c == 56 { rows(14, 17, 17, 14, 17, 17, 14) }   // 8
        else if c == 57 { rows(14, 17, 17, 15, 1, 2, 12) }   // 9
        else if c == 58 { rows(0, 12, 12, 0, 12, 12, 0) }   // :
        else if c == 59 { rows(0, 12, 12, 0, 12, 4, 8) }   // ;
        else if c == 60 { rows(2, 4, 8, 16, 8, 4, 2) }   // <
        else if c == 61 { rows(0, 0, 31, 0, 31, 0, 0) }   // =
        else if c == 62 { rows(8, 4, 2, 1, 2, 4, 8) }   // >
        else if c == 63 { rows(14, 17, 1, 2, 4, 0, 4) }   // ?
        else { rows(0, 0, 0, 0, 0, 0, 0) };
    }

    // @ and the capitals, with the brackets after them.
    fn mid(c: Int) -> Bitmap {
        return
        if c == 64 { rows(14, 17, 1, 13, 21, 21, 14) }   // @
        else if c == 65 { rows(14, 17, 17, 31, 17, 17, 17) }   // A
        else if c == 66 { rows(30, 17, 17, 30, 17, 17, 30) }   // B
        else if c == 67 { rows(14, 17, 16, 16, 16, 17, 14) }   // C
        else if c == 68 { rows(28, 18, 17, 17, 17, 18, 28) }   // D
        else if c == 69 { rows(31, 16, 16, 30, 16, 16, 31) }   // E
        else if c == 70 { rows(31, 16, 16, 30, 16, 16, 16) }   // F
        else if c == 71 { rows(14, 17, 16, 23, 17, 17, 15) }   // G
        else if c == 72 { rows(17, 17, 17, 31, 17, 17, 17) }   // H
        else if c == 73 { rows(14, 4, 4, 4, 4, 4, 14) }   // I
        else if c == 74 { rows(7, 2, 2, 2, 2, 18, 12) }   // J
        else if c == 75 { rows(17, 18, 20, 24, 20, 18, 17) }   // K
        else if c == 76 { rows(16, 16, 16, 16, 16, 16, 31) }   // L
        else if c == 77 { rows(17, 27, 21, 21, 17, 17, 17) }   // M
        else if c == 78 { rows(17, 17, 25, 21, 19, 17, 17) }   // N
        else if c == 79 { rows(14, 17, 17, 17, 17, 17, 14) }   // O
        else if c == 80 { rows(30, 17, 17, 30, 16, 16, 16) }   // P
        else if c == 81 { rows(14, 17, 17, 17, 21, 18, 13) }   // Q
        else if c == 82 { rows(30, 17, 17, 30, 20, 18, 17) }   // R
        else if c == 83 { rows(15, 16, 16, 14, 1, 1, 30) }   // S
        else if c == 84 { rows(31, 4, 4, 4, 4, 4, 4) }   // T
        else if c == 85 { rows(17, 17, 17, 17, 17, 17, 14) }   // U
        else if c == 86 { rows(17, 17, 17, 17, 17, 10, 4) }   // V
        else if c == 87 { rows(17, 17, 17, 21, 21, 27, 17) }   // W
        else if c == 88 { rows(17, 17, 10, 4, 10, 17, 17) }   // X
        else if c == 89 { rows(17, 17, 17, 10, 4, 4, 4) }   // Y
        else if c == 90 { rows(31, 1, 2, 4, 8, 16, 31) }   // Z
        else if c == 91 { rows(14, 8, 8, 8, 8, 8, 14) }   // [
        else if c == 92 { rows(0, 16, 8, 4, 2, 1, 0) }   // \
        else if c == 93 { rows(14, 2, 2, 2, 2, 2, 14) }   // ]
        else if c == 94 { rows(4, 10, 17, 0, 0, 0, 0) }   // ^
        else if c == 95 { rows(0, 0, 0, 0, 0, 0, 31) }   // _
        else { rows(0, 0, 0, 0, 0, 0, 0) };
    }

    // The backtick, the small letters, and the braces.
    fn high(c: Int) -> Bitmap {
        return
        if c == 96 { rows(8, 4, 2, 0, 0, 0, 0) }   // `
        else if c == 97 { rows(0, 0, 14, 1, 15, 17, 15) }   // a
        else if c == 98 { rows(16, 16, 22, 25, 17, 17, 30) }   // b
        else if c == 99 { rows(0, 0, 14, 16, 16, 17, 14) }   // c
        else if c == 100 { rows(1, 1, 13, 19, 17, 17, 15) }   // d
        else if c == 101 { rows(0, 0, 14, 17, 31, 16, 14) }   // e
        else if c == 102 { rows(6, 9, 8, 28, 8, 8, 8) }   // f
        else if c == 103 { rows(0, 15, 17, 17, 15, 1, 14) }   // g
        else if c == 104 { rows(16, 16, 22, 25, 17, 17, 17) }   // h
        else if c == 105 { rows(4, 0, 12, 4, 4, 4, 14) }   // i
        else if c == 106 { rows(2, 0, 6, 2, 2, 18, 12) }   // j
        else if c == 107 { rows(16, 16, 18, 20, 24, 20, 18) }   // k
        else if c == 108 { rows(12, 4, 4, 4, 4, 4, 14) }   // l
        else if c == 109 { rows(0, 0, 26, 21, 21, 17, 17) }   // m
        else if c == 110 { rows(0, 0, 22, 25, 17, 17, 17) }   // n
        else if c == 111 { rows(0, 0, 14, 17, 17, 17, 14) }   // o
        else if c == 112 { rows(0, 0, 30, 17, 30, 16, 16) }   // p
        else if c == 113 { rows(0, 0, 15, 17, 15, 1, 1) }   // q
        else if c == 114 { rows(0, 0, 22, 25, 16, 16, 16) }   // r
        else if c == 115 { rows(0, 0, 15, 16, 14, 1, 30) }   // s
        else if c == 116 { rows(8, 8, 28, 8, 8, 9, 6) }   // t
        else if c == 117 { rows(0, 0, 17, 17, 17, 19, 13) }   // u
        else if c == 118 { rows(0, 0, 17, 17, 17, 10, 4) }   // v
        else if c == 119 { rows(0, 0, 17, 17, 21, 21, 10) }   // w
        else if c == 120 { rows(0, 0, 17, 10, 4, 10, 17) }   // x
        else if c == 121 { rows(0, 0, 17, 17, 15, 1, 14) }   // y
        else if c == 122 { rows(0, 0, 31, 2, 4, 8, 31) }   // z
        else if c == 123 { rows(2, 4, 4, 8, 4, 4, 2) }   // {
        else if c == 124 { rows(4, 4, 4, 4, 4, 4, 4) }   // |
        else if c == 125 { rows(8, 4, 4, 2, 4, 4, 8) }   // }
        else if c == 126 { rows(0, 0, 9, 21, 18, 0, 0) }   // ~
        else { rows(0, 0, 0, 0, 0, 0, 0) };
    }

    compute {
        let p = coord();
        let col = int(floor(p.x / 6.0));
        let row = int(floor(p.y / 8.0));
        let code = 32 + row * 16 + col;
        let x = int(p.x) - col * 6;
        let y = int(p.y) - row * 8;
        let b = if code < 64 { low(code) } else if code < 96 { mid(code) } else { high(code) };
        let place = if x == 0 { 16 } else if x == 1 { 8 } else if x == 2 { 4 } else if x == 3 { 2 } else { 1 };
        let on = x < 5 && y < 7 && code <= 126 && row_of(b, y) / place % 2 == 1;
        return if on { 1.0 } else { 0.0 };
    }
}
