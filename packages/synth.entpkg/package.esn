//! The synth package: sound made from tones and noise, a block of 800
//! stereo samples a frame, the clock counting them (or one kept to the
//! time, `synth.paced`), the cues a program's events set going on eight
//! voices, and the tones, noises and envelopes they sound with
//! (`kernels/synth.ent`).
//!
//!   node clock0: synth.clock_start@1 { domain = 1; }
//!   node audio_clock: synth.clock@1 { previous <~ audio_clock.result from clock0.result; domain = 1; }
//!   node quiet: synth.cues_start@1 { domain = 8; }
package synth@1 { language = 1; ir = 1; }

use "kernels/";
