// Rasterization as Kernels. The rule is the one `native.rasterize@1`
// keeps, written out so every backend runs it the same:
//
// - A vertex is `clip: Vec4, normal: Vec3, uv: Vec2`, a clip-space
//   position as a vertex shader would emit it; after the divide by `w`,
//   `x` and `y` span `[-1, 1]` (y up) and `z` spans `[0, 1]`.
// - A triangle is three vertex rows, clamped into range. One with a
//   corner at `w <= 0`, a component that is not finite, or no area is
//   skipped whole: nothing is clipped at the near plane here.
// - A pixel is covered where its centre is inside the triangle's box and
//   on or inside all three edges, and holds the nearest covered fragment
//   whose depth is in `[0, 1)`; of two at one depth, the earlier triangle.
// - Attributes are interpolated perspective-correct, by `1 / w`.
//
// It goes in two steps. Each triangle walks the pixels of its box and
// emits, for each one it covers, a key of the fragment's depth above and
// its own row below: a pixel keeps the least key, which is the nearest
// depth and, of two at it, the earlier triangle, one 64-bit atomic
// apiece on a device. The surface is read back from the keys.

struct Corner { clip: Vec4; normal: Vec3; uv: Vec2; }
struct Face { a: Int; b: Int; c: Int; }

// A triangle in pixels: its corners as `x, y, z, 1/w` and the rows they
// came from, wound so the inside is on every edge's left, and the area
// (twice it); `usable` false for one that is skipped.
struct Corners {
    a: Vec4; b: Vec4; c: Vec4;
    ia: Int; ib: Int; ic: Int;
    area: Float;
    usable: Bool;
}

// What a pixel shows: the layout `native.rasterize@1` writes.
struct Surface { depth: Float; normal: Vec3; uv: Vec2; id: Int; }

// Where `p` is against the edge from `a` to `b`: positive to its left.
fn edge(a: Vec2, b: Vec2, p: Vec2) -> Float {
    return (b.x - a.x) * (p.y - a.y) - (b.y - a.y) * (p.x - a.x);
}

// A corner in pixels: `x` and `y` from the top left, `z` after the
// divide, and `1 / w`.
fn screen(v: Corner, size: Vec2) -> Vec4 {
    let inv_w = 1.0 / v.clip.w;
    return vec4(
        (v.clip.x * inv_w * 0.5 + 0.5) * size.x,
        (0.5 - v.clip.y * inv_w * 0.5) * size.y,
        v.clip.z * inv_w,
        inv_w
    );
}

// Whether a corner can be drawn: every clip component finite, `w` above
// zero.
fn usable(v: Corner) -> Bool {
    let c = v.clip;
    let finite = !(isnan(c.x) || isnan(c.y) || isnan(c.z) || isnan(c.w)
        || isinf(c.x) || isinf(c.y) || isinf(c.z) || isinf(c.w));
    return finite && c.w > 0.0;
}

// A triangle in pixels over a canvas of `size`: its corners from the
// vertex rows, clamped, wound so the inside is on every edge's left.
// Covering and reading a surface back both come here, so both see the
// same corners to the last bit.
fn corners(face: Face, vertices: Rows<Corner>, size: Vec2) -> Corners {
    let last = count(vertices) - 1;
    let ia = clamp(face.a, 0, last);
    let ib = clamp(face.b, 0, last);
    let ic = clamp(face.c, 0, last);
    let va = at(vertices, ia);
    let vb = at(vertices, ib);
    let vc = at(vertices, ic);
    let a = screen(va, size);
    let b = screen(vb, size);
    let c = screen(vc, size);
    let flip = edge(a.xy, b.xy, c.xy) < 0.0;
    let wound_b = if flip { c } else { b };
    let wound_c = if flip { b } else { c };
    let area = edge(a.xy, wound_b.xy, wound_c.xy);
    return Corners {
        a: a, b: wound_b, c: wound_c,
        ia: ia, ib: if flip { ic } else { ib }, ic: if flip { ib } else { ic },
        area: area,
        usable: usable(va) && usable(vb) && usable(vc) && area > 0.0
    };
}

// The pixels whose centres, at `x + 0.5`, are inside a triangle's box and
// the canvas, and so may be inside the triangle: from `x0, y0`, `w` wide
// and `h` high, none (`w` zero) for a triangle that is skipped.
struct Box { x0: Int; y0: Int; w: Int; h: Int; }

fn boxed(k: Corners, size: Vec2) -> Box {
    let none = Box { x0: 0, y0: 0, w: 0, h: 0 };
    if !k.usable { return none; }
    let x0 = max(ceil(min(min(k.a.x, k.b.x), k.c.x) - 0.5), 0.0);
    let y0 = max(ceil(min(min(k.a.y, k.b.y), k.c.y) - 0.5), 0.0);
    let x1 = min(floor(max(max(k.a.x, k.b.x), k.c.x) - 0.5), size.x - 1.0);
    let y1 = min(floor(max(max(k.a.y, k.b.y), k.c.y) - 0.5), size.y - 1.0);
    if x1 < x0 || y1 < y0 { return none; }
    return Box { x0: int(x0), y0: int(y0), w: int(x1 - x0) + 1, h: int(y1 - y0) + 1 };
}

// The depth of the fragment a triangle leaves at a pixel's centre, or -1
// where it leaves none: the centre outside an edge, or the depth outside
// `[0, 1)`.
fn depth_at(k: Corners, px: Int, py: Int) -> Float {
    let p = vec2(float(px) + 0.5, float(py) + 0.5);
    let w0 = edge(k.b.xy, k.c.xy, p);
    let w1 = edge(k.c.xy, k.a.xy, p);
    let w2 = edge(k.a.xy, k.b.xy, p);
    let z = w0 / k.area * k.a.z + w1 / k.area * k.b.z + w2 / k.area * k.c.z;
    return if w0 >= 0.0 && w1 >= 0.0 && w2 >= 0.0 && z >= 0.0 && z < 1.0 { z } else { -1.0 };
}

// The uv a triangle's fragment at a pixel's centre has, perspective-
// correct by `1 / w`, in the order the surface reads it back.
fn uv_at(k: Corners, va: Corner, vb: Corner, vc: Corner, px: Int, py: Int) -> Vec2 {
    let p = vec2(float(px) + 0.5, float(py) + 0.5);
    let l0 = edge(k.b.xy, k.c.xy, p) / k.area;
    let l1 = edge(k.c.xy, k.a.xy, p) / k.area;
    let l2 = edge(k.a.xy, k.b.xy, p) / k.area;
    let inv_w = l0 * k.a.w + l1 * k.b.w + l2 * k.c.w;
    return (l0 * va.uv * k.a.w + l1 * vb.uv * k.b.w + l2 * vc.uv * k.c.w) / inv_w;
}

// A fragment's key: the bits of its depth (a Float of no sign orders as
// its bits do) above, the triangle's row below, so the least key is the
// nearest depth and the earliest row at it.
fn key_of(z: Float, t: Int) -> Long {
    return (long(bits(z)) << 32) | long(t);
}

// Whether a box is more than one tile: such a triangle's pixels are
// covered by `raster.cover_tiles@1`, a tile to an invocation, rather
// than all by its own. A tile of zero is no tiling: every triangle
// covers its own box.
fn large(b: Box, tile: Int) -> Bool {
    return tile > 0 && (b.w > tile || b.h > tile);
}

/// Every pixel's nearest fragment as one key: each triangle walks its box
/// and emits a key a pixel it covers. With a `tile`, only the triangles
/// whose box is one tile or less; the larger ones are left to
/// `raster.cover_tiles@1`, which takes these keys as its own start, so the
/// least of both is kept.
kernel raster.cover@2 {
    requires { field.read; field.write; }
    input triangles: Rows<Face>;
    input vertices: Rows<Corner>;
    input keys: Grid<Long>;
    param tile: Int = 0;
    output result: Grid<Long>;
    struct Hit { pixel: Vec2; key: Long; }
    scatter into keys with min {
        let t = element();
        let k = corners(sample(triangles), vertices, size(keys));
        let b = boxed(k, size(keys));
        let none = Hit { pixel: vec2(-1.0, -1.0), key: 0l };
        if b.w == 0 || large(b, tile) { return none; }
        loop b.h with dy = 0 {
            loop b.w with dx = 0 {
                let z = depth_at(k, b.x0 + dx, b.y0 + dy);
                if z >= 0.0 {
                    emit(Hit { pixel: vec2(float(b.x0 + dx), float(b.y0 + dy)), key: key_of(z, t) });
                }
                dx + 1
            };
            dy + 1
        };
        return none;
    }
}

/// How many tiles each triangle's box is cut into: none for one of a
/// tile or less, which `raster.cover@2` covers whole.
kernel raster.tiles@1 {
    requires { field.read; field.write; }
    input triangles: Rows<Face>;
    input vertices: Rows<Corner>;
    input canvas: Grid<Long>;
    param tile: Int = 16;
    output result: Rows<Int>;
    compute {
        let b = boxed(corners(sample(triangles), vertices, size(canvas)), size(canvas));
        if !large(b, tile) { return 0; }
        return ((b.w + tile - 1) / tile) * ((b.h + tile - 1) / tile);
    }
}

/// Where each triangle's tiles begin: an inclusive prefix of the counts,
/// so triangle `t`'s tiles end before `offsets[t]`.
kernel raster.offsets@1 {
    requires { field.read; field.write; }
    input counts: Rows<Int>;
    output result: Rows<Int>;
    prefix with sum { return sample(counts); }
}

/// How many tiles there are, which sizes the next node: the last offset.
kernel raster.total@1 {
    requires { field.read; field.write; }
    input offsets: Rows<Int>;
    output result: Rows<Int>;
    compute { return at(offsets, count(offsets) - 1); }
}

// The triangle and the tile of its box an element covers: the first
// triangle whose offset passes it, by bisection, and its place among
// that triangle's tiles.
struct Place { t: Int; x0: Int; y0: Int; w: Int; h: Int; }

fn place(e: Int, counts: Rows<Int>, offsets: Rows<Int>, triangles: Rows<Face>, vertices: Rows<Corner>, size: Vec2, tile: Int) -> Place {
    let span = loop 32 with r = ivec2(0, count(offsets)) until r.x >= r.y {
        let mid = (r.x + r.y) / 2;
        if at(offsets, mid) > e { ivec2(r.x, mid) } else { ivec2(mid + 1, r.y) }
    };
    let t = span.x;
    let b = boxed(corners(at(triangles, t), vertices, size), size);
    let local = e - (at(offsets, t) - at(counts, t));
    let across = (b.w + tile - 1) / tile;
    let x0 = b.x0 + local % across * tile;
    let y0 = b.y0 + local / across * tile;
    return Place {
        t: t, x0: x0, y0: y0,
        w: min(tile, b.x0 + b.w - x0),
        h: min(tile, b.y0 + b.h - y0),
    };
}

/// Every pixel's nearest fragment as one key, of the large triangles, a
/// tile of one's box at a time, so a triangle that fills the canvas is
/// covered by as many invocations as it has tiles rather than by one. The
/// node's domain is a pool of invocations sized by the canvas, each taking
/// every `n`th tile, so how many tiles there are this frame is read on the
/// device and never waited for. It starts from the keys `raster.cover@2`
/// left, and keeps the least.
kernel raster.cover_tiles@1 {
    requires { field.read; field.write; }
    input triangles: Rows<Face>;
    input vertices: Rows<Corner>;
    input counts: Rows<Int>;
    input offsets: Rows<Int>;
    input total: Rows<Int>;
    input keys: Grid<Long>;
    param tile: Int = 16;
    output result: Grid<Long>;
    struct Hit { pixel: Vec2; key: Long; }
    scatter into keys with min {
        let none = Hit { pixel: vec2(-1.0, -1.0), key: 0l };
        let size = size(keys);
        // A pool of invocations, the node's own domain, each taking every
        // `n`th tile from its own.
        let n = idomain();
        let e = element();
        let total = at(total, 0);
        let rounds = if e < total { (total - e + n - 1) / n } else { 0 };
        loop rounds with j = 0 {
            let at_ = place(e + j * n, counts, offsets, triangles, vertices, size, tile);
            let k = corners(at(triangles, at_.t), vertices, size);
            loop at_.h with dy = 0 {
                loop at_.w with dx = 0 {
                    let z = depth_at(k, at_.x0 + dx, at_.y0 + dy);
                    if z >= 0.0 {
                        emit(Hit { pixel: vec2(float(at_.x0 + dx), float(at_.y0 + dy)), key: key_of(z, at_.t) });
                    }
                    dx + 1
                };
                dy + 1
            };
            j + 1
        };
        return none;
    }
}

/// The same pair with a cutout: a fragment whose alpha in `mask`, read at
/// its own uv as `at_linear(mask, uv * size(mask))` reads it, is below
/// `cutout` is not drawn — it emits no key, so it settles no depth and
/// what is behind a leaf's edge is seen through it.
kernel raster.cover_cutout@2 {
    requires { field.read; field.write; }
    input triangles: Rows<Face>;
    input vertices: Rows<Corner>;
    input mask: Image;
    input keys: Grid<Long>;
    param cutout: Float = 0.5;
    param tile: Int = 0;
    output result: Grid<Long>;
    struct Hit { pixel: Vec2; key: Long; }
    scatter into keys with min {
        let t = element();
        let k = corners(sample(triangles), vertices, size(keys));
        let b = boxed(k, size(keys));
        let none = Hit { pixel: vec2(-1.0, -1.0), key: 0l };
        if b.w == 0 || large(b, tile) { return none; }
        let va = at(vertices, k.ia);
        let vb = at(vertices, k.ib);
        let vc = at(vertices, k.ic);
        let texels = size(mask);
        loop b.h with dy = 0 {
            loop b.w with dx = 0 {
                let px = b.x0 + dx;
                let py = b.y0 + dy;
                let z = depth_at(k, px, py);
                if z >= 0.0 && at_linear(mask, uv_at(k, va, vb, vc, px, py) * texels).a >= cutout {
                    emit(Hit { pixel: vec2(float(px), float(py)), key: key_of(z, t) });
                }
                dx + 1
            };
            dy + 1
        };
        return none;
    }
}

kernel raster.cover_cutout_tiles@1 {
    requires { field.read; field.write; }
    input triangles: Rows<Face>;
    input vertices: Rows<Corner>;
    input counts: Rows<Int>;
    input offsets: Rows<Int>;
    input total: Rows<Int>;
    input mask: Image;
    input keys: Grid<Long>;
    param cutout: Float = 0.5;
    param tile: Int = 16;
    output result: Grid<Long>;
    struct Hit { pixel: Vec2; key: Long; }
    scatter into keys with min {
        let none = Hit { pixel: vec2(-1.0, -1.0), key: 0l };
        let size = size(keys);
        let texels = size(mask);
        let n = idomain();
        let e = element();
        let total = at(total, 0);
        let rounds = if e < total { (total - e + n - 1) / n } else { 0 };
        loop rounds with j = 0 {
            let at_ = place(e + j * n, counts, offsets, triangles, vertices, size, tile);
            let k = corners(at(triangles, at_.t), vertices, size);
            let va = at(vertices, k.ia);
            let vb = at(vertices, k.ib);
            let vc = at(vertices, k.ic);
            loop at_.h with dy = 0 {
                loop at_.w with dx = 0 {
                    let px = at_.x0 + dx;
                    let py = at_.y0 + dy;
                    let z = depth_at(k, px, py);
                    if z >= 0.0 && at_linear(mask, uv_at(k, va, vb, vc, px, py) * texels).a >= cutout {
                        emit(Hit { pixel: vec2(float(px), float(py)), key: key_of(z, at_.t) });
                    }
                    dx + 1
                };
                dy + 1
            };
            j + 1
        };
        return none;
    }
}

/// The surface: at each covered pixel, the depth its key holds and the
/// winner's attributes interpolated at the pixel's centre,
/// perspective-correct.
kernel raster.resolve@2 {
    requires { field.read; field.write; }
    input keys: Grid<Long>;
    input triangles: Rows<Face>;
    input vertices: Rows<Corner>;
    output result: Grid<Surface>;
    compute {
        let key = sample(keys);
        if key == 9223372036854775807l {
            return Surface { depth: 1.0, normal: vec3(0.0, 0.0, 0.0), uv: vec2(0.0, 0.0), id: -1 };
        }
        let t = int(key & 0xFFFFFFFFl);
        let k = corners(at(triangles, t), vertices, size(keys));
        let p = coord() + vec2(0.5, 0.5);
        let w0 = edge(k.b.xy, k.c.xy, p);
        let w1 = edge(k.c.xy, k.a.xy, p);
        let w2 = edge(k.a.xy, k.b.xy, p);
        let l0 = w0 / k.area;
        let l1 = w1 / k.area;
        let l2 = w2 / k.area;
        let inv_w = l0 * k.a.w + l1 * k.b.w + l2 * k.c.w;
        let va = at(vertices, k.ia);
        let vb = at(vertices, k.ib);
        let vc = at(vertices, k.ic);
        let normal = (l0 * va.normal * k.a.w + l1 * vb.normal * k.b.w + l2 * vc.normal * k.c.w) / inv_w;
        let uv = (l0 * va.uv * k.a.w + l1 * vb.uv * k.b.w + l2 * vc.uv * k.c.w) / inv_w;
        return Surface { depth: from_bits(int(key >> 32)), normal: normal, uv: uv, id: t };
    }
}
