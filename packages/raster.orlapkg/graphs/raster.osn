// Vertex and triangle rows in, the surface out: for every pixel, the
// nearest triangle's depth, normal and uv, perspective-correct, and its
// row as `id`. Place it with
//   node raster: graph "../../packages/raster.orlapkg/graphs/raster.osn" {
//       vertices <- project.result;
//       triangles <- faces.result;
//       width = 320;
//       height = 240;
//   }
// and read `raster.surface` where `native.rasterize@1` gave `surface`.
use "../kernels/raster.orla";

input vertices: Rows<Corner>;
input triangles: Rows<Face>;
param width: Int = 320;
param height: Int = 240;

// What a pixel holds before anything is drawn on it.
node far: Grid<Float> { domain = vec2(width, height); value = 1.0; }
node nobody: Grid<Int> { domain = vec2(width, height); value = 2147483647; }

node setup: raster.setup@1 {
    triangles <- triangles;
    vertices <- vertices;
    canvas <- far.result;
}
node offsets: raster.offsets@1 { counts <- setup.counts; }
node total: raster.total@1 {
    offsets <- offsets.result;
    domain = 1;
}

node fragments: raster.fragments@1 {
    setup <- setup.result;
    offsets <- offsets.result;
    total <- total.result;
    domain = max(value(total), 1);
}
node nearest: raster.nearest@1 {
    fragments <- fragments.result;
    canvas <- far.result;
}
node owner: raster.owner@1 {
    fragments <- fragments.result;
    depth <- nearest.result;
    owners <- nobody.result;
}
node resolved: raster.resolve@1 {
    owners <- owner.result;
    depth <- nearest.result;
    triangles <- triangles;
    vertices <- vertices;
}

output surface <- resolved.result;
