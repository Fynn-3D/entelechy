// The raster preset at the window's size: the surface is the window's
// extent in pixels, and follows it when it is resized, as a node of
// `domain = window();` does. Place it with
//   node raster: graph "../../packages/raster.orlapkg/graphs/window.osn" {
//       vertices <- project.result;
//       triangles <- faces.result;
//   }
// and read `raster.surface`.
use "../kernels/raster.orla";

input vertices: Rows<Corner>;
input triangles: Rows<Face>;
// What a pixel holds before anything is drawn on it: the key no
// fragment gives.
node empty: Grid<Long> { domain = window(); value = 9223372036854775807l; }

node cover: raster.cover@1 {
    triangles <- triangles;
    vertices <- vertices;
    keys <- empty.result;
}
node resolved: raster.resolve@2 {
    keys <- cover.result;
    triangles <- triangles;
    vertices <- vertices;
}

output surface <- resolved.result;
