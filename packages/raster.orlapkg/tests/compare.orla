// Two surfaces held to each other: how many pixels differ in their owner,
// and how far the attributes of the ones that agree on it are apart.
use "../kernels/raster.orla";

struct Difference { owners: Int; attributes: Float; }

kernel raster_test.difference@1 {
    requires { field.read; field.write; }
    input one: Grid<Surface>;
    input other: Grid<Surface>;
    output result: Rows<Difference>;
    compute {
        let a = sample(one);
        let b = sample(other);
        if a.id != b.id { return Difference { owners: 1, attributes: 0.0 }; }
        let apart = abs(a.depth - b.depth) + length(a.normal - b.normal) + length(a.uv - b.uv);
        return Difference { owners: 0, attributes: apart };
    }
    merge(x, y) {
        return Difference { owners: x.owners + y.owners, attributes: max(x.attributes, y.attributes) };
    }
}
