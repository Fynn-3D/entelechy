//! Runs: from each owner's count of entries, where each owner's run ends,
//! how many entries there are, and the row of -1 they are laid in. Place
//! it with
//!   node lists: graph "compact.entpkg/graphs/runs.esn" {
//!       counts <- counted.result;
//!   }
//! and fill `lists.slots` with a scatter over the owners that walks what
//! the count walked, `emit`ting each entry at `ends[i] - counts[i]` plus
//! its rank; size what reads the entries with `domain = value(entries)`
//! and find an entry's owner with `owner(e, ends)`.
use "../kernels/runs.ent";

input counts: Rows<Int>;

node ends: compact.ends@1 { counts <- counts; }
node entries: compact.entries@1 { ends <- ends.result; domain = 1; }
node slots: compact.slots@1 { entries <- entries.result; domain = value(entries); }

output ends <- ends.result;
output entries <- entries.result;
output slots <- slots.result;
