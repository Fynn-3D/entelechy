// Noise as functions. Every value comes from hashing whole numbers with
// integer arithmetic, so a point's hash is the same bits on every
// backend; the smooth kinds interpolate those values, and differ between
// backends only as their floating point rounds. `seed` picks one of many
// fields of each kind.

/// A whole number's bits stirred (Wellons' lowbias32): every input bit
/// reaches every output bit.
fn scramble(v: Int) -> Int {
    let a = v ^ (v >>> 16);
    let b = mul_wrap(a, 0x7feb352d);
    let c = b ^ (b >>> 15);
    let d = mul_wrap(c, 0x846ca68b);
    return d ^ (d >>> 16);
}

/// A hash of one, two or three whole numbers and a seed: each number
/// multiplied by its own odd constant, so no two share a direction, and
/// the sum of their bits stirred once.
fn hash_int(x: Int, seed: Int) -> Int { return scramble(x ^ mul_wrap(seed, 0x9e3779b9)); }
fn hash_int2(x: Int, y: Int, seed: Int) -> Int {
    return scramble(mul_wrap(x, 0x8da6b343) ^ mul_wrap(y, 0xd8163841) ^ mul_wrap(seed, 0x9e3779b9));
}
fn hash_int3(x: Int, y: Int, z: Int, seed: Int) -> Int {
    return scramble(mul_wrap(x, 0x8da6b343) ^ mul_wrap(y, 0xd8163841) ^ mul_wrap(z, 0xcb1ab31f) ^ mul_wrap(seed, 0x9e3779b9));
}

/// A hash as a number from 0 up to 1: its top 24 bits.
fn unit_of(h: Int) -> Float { return float(h >>> 8) / 16777216.0; }

/// A hash as a whole number from 0 below `n` (at least 1): the high word
/// of the hash, read as unsigned, times `n`. Never below zero, as `h % n`
/// is for a hash with its top bit set, and drawn from its high bits.
fn below_of(h: Int, n: Int) -> Int { return umulhi(h, max(n, 1)); }

/// A random number from 0 up to 1 for a whole number, a grid cell of a
/// plane, or a cell of space.
fn hash1(x: Int, seed: Int) -> Float { return unit_of(hash_int(x, seed)); }
fn hash2(c: Vec2, seed: Int) -> Float { let i = int(floor(c)); return unit_of(hash_int2(i.x, i.y, seed)); }
fn hash3(c: Vec3, seed: Int) -> Float { let i = int(floor(c)); return unit_of(hash_int3(i.x, i.y, i.z, seed)); }

/// Perlin's quintic: 0 at 0, 1 at 1, flat at both.
fn fade(t: Float) -> Float { return t * t * t * (t * (t * 6.0 - 15.0) + 10.0); }

/// A lattice value, -1 to 1.
fn corner2(x: Int, y: Int, seed: Int) -> Float { return unit_of(hash_int2(x, y, seed)) * 2.0 - 1.0; }
fn corner3(x: Int, y: Int, z: Int, seed: Int) -> Float { return unit_of(hash_int3(x, y, z, seed)) * 2.0 - 1.0; }

/// Value noise, -1 to 1: random values at the whole numbers, blended.
fn value2(p: Vec2, seed: Int) -> Float {
    let i = floor(p);
    let { x, y } = int(i);
    let u = fade(p.x - i.x);
    let v = fade(p.y - i.y);
    return mix(mix(corner2(x, y, seed), corner2(x + 1, y, seed), u),
               mix(corner2(x, y + 1, seed), corner2(x + 1, y + 1, seed), u), v);
}

fn value3(p: Vec3, seed: Int) -> Float {
    let i = floor(p);
    let { x, y, z } = int(i);
    let u = fade(p.x - i.x);
    let v = fade(p.y - i.y);
    let w = fade(p.z - i.z);
    let near = mix(mix(corner3(x, y, z, seed), corner3(x + 1, y, z, seed), u),
                   mix(corner3(x, y + 1, z, seed), corner3(x + 1, y + 1, z, seed), u), v);
    let far = mix(mix(corner3(x, y, z + 1, seed), corner3(x + 1, y, z + 1, seed), u),
                  mix(corner3(x, y + 1, z + 1, seed), corner3(x + 1, y + 1, z + 1, seed), u), v);
    return mix(near, far, w);
}

/// A lattice point's gradient dotted with the offset to `d`: one of the
/// twelve edge directions of a cube, as Perlin's improved noise picks.
fn slope3(x: Int, y: Int, z: Int, seed: Int, d: Vec3) -> Float {
    let h = hash_int3(x, y, z, seed) & 15;
    let u = if h < 8 { d.x } else { d.y };
    let v = if h < 4 { d.y } else if h == 12 || h == 14 { d.x } else { d.z };
    return (if (h & 1) == 0 { u } else { -u }) + (if (h & 2) == 0 { v } else { -v });
}

/// Gradient (Perlin) noise, about -1 to 1: smoother than value noise,
/// without its grid-aligned blocks.
fn gradient3(p: Vec3, seed: Int) -> Float {
    let i = floor(p);
    let f = p - i;
    let { x, y, z } = int(i);
    let u = fade(f.x);
    let v = fade(f.y);
    let w = fade(f.z);
    let near = mix(mix(slope3(x, y, z, seed, f), slope3(x + 1, y, z, seed, f - vec3(1.0, 0.0, 0.0)), u),
                   mix(slope3(x, y + 1, z, seed, f - vec3(0.0, 1.0, 0.0)), slope3(x + 1, y + 1, z, seed, f - vec3(1.0, 1.0, 0.0)), u), v);
    let far = mix(mix(slope3(x, y, z + 1, seed, f - vec3(0.0, 0.0, 1.0)), slope3(x + 1, y, z + 1, seed, f - vec3(1.0, 0.0, 1.0)), u),
                  mix(slope3(x, y + 1, z + 1, seed, f - vec3(0.0, 1.0, 1.0)), slope3(x + 1, y + 1, z + 1, seed, f - 1.0), u), v);
    return mix(near, far, w);
}

/// A fractal sum: `octaves` layers of noise, each twice as fine and half
/// as strong as the last; about -1 to 1.
fn fbm2(p: Vec2, octaves: Int, seed: Int) -> Float {
    let sum = loop octaves with s = vec3(0.0, 1.0, 0.0) {
        let scale = pow(2.03, float(index()));
        vec3(s.x + value2(p * scale, seed + index()) * s.y, s.y * 0.5, s.z + s.y)
    };
    return sum.x / max(sum.z, 0.0001);
}

fn fbm3(p: Vec3, octaves: Int, seed: Int) -> Float {
    let sum = loop octaves with s = vec3(0.0, 1.0, 0.0) {
        let scale = pow(2.03, float(index()));
        vec3(s.x + gradient3(p * scale, seed + index()) * s.y, s.y * 0.5, s.z + s.y)
    };
    return sum.x / max(sum.z, 0.0001);
}

/// Ridged noise, 0 to 1: sharp crests where the noise crosses zero, for
/// cracks, veins and mountain ridges.
fn ridged3(p: Vec3, octaves: Int, seed: Int) -> Float {
    let sum = loop octaves with s = vec3(0.0, 1.0, 0.0) {
        let scale = pow(2.03, float(index()));
        let crest = 1.0 - abs(gradient3(p * scale, seed + index()));
        vec3(s.x + crest * crest * s.y, s.y * 0.5, s.z + s.y)
    };
    return sum.x / max(sum.z, 0.0001);
}

/// Worley's cells: a random point in each cell of space; how far `p` is
/// from the nearest (x) and the next nearest (y), and the nearest's hash
/// (z), 0 to 1.
fn worley3(p: Vec3, seed: Int) -> Vec3 {
    let i = floor(p);
    return loop 27 with best = vec3(10.0, 10.0, 0.0) {
        let k = index();
        let cell = i + float(ivec3(k % 3, (k / 3) % 3, k / 9) - 1);
        let { x, y, z } = int(cell);
        let at_point = cell + vec3(unit_of(hash_int3(x, y, z, seed)), unit_of(hash_int3(x, y, z, seed + 1)), unit_of(hash_int3(x, y, z, seed + 2)));
        let d = length(p - at_point);
        if d < best.x { vec3(d, best.x, unit_of(hash_int3(x, y, z, seed + 3))) }
        else if d < best.y { vec3(best.x, d, best.z) } else { best }
    };
}

/// Curl noise: the curl of three gradient noises, a swirling field with
/// no sources and no sinks; carried by it, smoke keeps its volume.
fn curl3(p: Vec3, seed: Int) -> Vec3 {
    let e = 0.1;
    let dx = vec3(e, 0.0, 0.0);
    let dy = vec3(0.0, e, 0.0);
    let dz = vec3(0.0, 0.0, e);
    let a = seed;
    let b = seed + 101;
    let c = seed + 202;
    let dcy = gradient3(p + dy, c) - gradient3(p - dy, c);
    let dbz = gradient3(p + dz, b) - gradient3(p - dz, b);
    let daz = gradient3(p + dz, a) - gradient3(p - dz, a);
    let dcx = gradient3(p + dx, c) - gradient3(p - dx, c);
    let dbx = gradient3(p + dx, b) - gradient3(p - dx, b);
    let day = gradient3(p + dy, a) - gradient3(p - dy, a);
    return vec3(dcy - dbz, daz - dcx, dbx - day) / (2.0 * e);
}
