// Command search: a tool has no buttons or panels, only commands (a text file, one a line) and hotkeys.
// Space opens it; what is typed filters (`controls.typing`, letters folded to lower case), Backspace deletes; the commands whose names hold what is typed are listed,
// those whose whole name it is first; Up and Down choose, the wheel scrolls, the line under the pointer is chosen; Enter or
// a click runs the chosen one (a number typed after it is its argument) and closes it; Esc or a click outside closes it.
// A row of its own state (`Search`); what a command does when it runs is the tool's (`run`, `arg`).
// While it is open (and the frame a command runs) letters and digits are typed to it, and the tool's hotkeys must not count
// (`command_typing`). Each step of the search is a node, which `graphs/command_search.esn` wires together:
// the names read once by line, every line compared at once, ordered, then chosen.
use "text.entpkg";
use "controls.entpkg";
use "layout.ent";
use "paint.ent";
use "widget.ent";

/// The search: whether it is open, what is typed (code points), the
/// commands found and the one chosen, the wheel's scrolling kept between
/// rows, and the command run this frame (-1 none) with its number (-1
/// none).
struct Search {
    open: Int;
    typed: [Int; 24];
    typed_n: Int;
    /// The rows shown, from the `first` found; how many are shown, how
    /// many are found in all; the chosen of all.
    found: [Int; 12];
    found_n: Int;
    total: Int;
    first: Int;
    choice: Int;
    run: Int;
    arg: Int;
    scroll: Float;
}

/// The search's place and size, in the picture's points: the text's
/// size (a font texel), a row's height, the rows shown at most, its box.
fn command_text_size() -> Float { return 1.0; }
fn command_row_height() -> Float { return 13.0; }
fn command_rows_shown() -> Int { return 12; }
fn search_lo(win: Vec2) -> Vec2 { return vec2(win.x * 0.5 - 130.0, 60.0); }
fn search_hi(win: Vec2, rows: Int) -> Vec2 { return vec2(win.x * 0.5 + 130.0, 60.0 + 34.0 + float(rows) * command_row_height()); }
/// The first row's top.
fn command_rows_top(win: Vec2) -> Float { return search_lo(win).y + 28.0; }
/// The row shown under point `q` (-1 none).
fn command_row_under(win: Vec2, rows: Int, q: Vec2) -> Int {
    let lo = search_lo(win);
    let hi = search_hi(win, rows);
    if q.x < lo.x || q.x > hi.x { return -1; }
    let k = int(floor((q.y - command_rows_top(win)) / command_row_height()));
    return if k >= 0 && k < rows { k } else { -1 };
}

kernel ui.command_start@1 {
    requires { field.write; }
    output result: Rows<Search>;
    compute {
        return Search { open: 0, typed: [each 24 { 0 }], typed_n: 0, found: [each 12 { -1 }], found_n: 0, total: 0, first: 0, choice: 0, run: -1, arg: -1,
            scroll: 0.0 };
    }
}

/// The actions of `ui.command_keys`, by their place in its table.
fn command_delete() -> Int { return 0; }
fn command_enter() -> Int { return 1; }
fn command_escape() -> Int { return 2; }

/// The actions the search answers, for `controls.read` (`domain = 3`):
/// Backspace deletes, Enter or a pad's south runs, Esc or its east
/// closes. Up and Down are the arrows' and the left stick's steps.
kernel ui.command_keys@1 {
    requires { field.write; }
    output result: Rows<ActionBinding>;
    compute {
        let e = element();
        return if e == command_delete() { ActionBinding { key: 8, key2: -1, pad: -1 } }
            else if e == command_enter() { ActionBinding { key: 13, key2: -1, pad: 8 } }
            else { ActionBinding { key: 27, key2: -1, pad: 9 } };
    }
}

/// A character as the search holds it: a letter in lower case; -1 for
/// what is not written (a control character).
fn command_char(c: Int) -> Int {
    return if c >= 65 && c <= 90 { c + 32 } else if c < 32 || c == 127 { -1 } else { c };
}

/// The typed text's part before a number ending it, and that number (-1
/// none).
fn command_typed_parts(t: Search) -> IVec2 {
    let n = t.typed_n;
    let digits = loop n with d = ivec2(0, 1) {
        let c = t.typed[n - 1 - index()];
        if d.y == 1 && c >= 48 && c <= 57 { ivec2(d.x + 1, 1) } else { ivec2(d.x, 0) }
    };
    let has_number = digits.x > 0 && digits.x < n && t.typed[n - 1 - digits.x] == 32;
    if !has_number { return ivec2(n, -1); }
    let value = loop digits.x with v = 0 { v * 10 + t.typed[n - digits.x + index()] - 48 };
    return ivec2(n - digits.x - 1, value);
}

/// What this frame's hands do to the search the last frame left: the row
/// before anything is found (`now`: the typed text), whether it opens or
/// the typing changed, and the steps, keys and click pressed.
struct SearchHands {
    now: Search;
    shut: Int;
    opening: Int;
    changed: Int;
    up: Int;
    down: Int;
    enter: Int;
    escape: Int;
    clicked: Int;
    moved: Int;
    pointer: Vec2;
    window: Vec2;
}
fn search_hands(w: Search, h: ActionControls, p: PointerControls, ty: Typing) -> SearchHands {
    let base = Search { ..w, run: -1, arg: -1 };
    let opening = w.open == 0;
    let space_typed = loop ty.n with f = false { f || typed_at(ty, index()) == 32 };
    let shut = opening && !space_typed;
    let back = action_pressed(h, command_delete());
    // Opening, the Space that opens it is not typed; open, every character typed this frame is.
    let n0 = if opening { 0 } else { w.typed_n };
    let kept = if back { max(n0 - 1, 0) } else { n0 };
    let added = if opening || back { 0 } else { loop ty.n with k = 0 { if command_char(typed_at(ty, index())) >= 0 { k + 1 } else { k } } };
    let n1 = min(kept + added, 24);
    let typed = [each 24 {
        let i = index();
        if i < kept { if opening { 0 } else { w.typed[i] } }
        else if i < n1 {
            // The (i - kept)th written character of this frame's.
            let want = i - kept;
            let found = loop ty.n with r = ivec2(0, 0) { let c = command_char(typed_at(ty, index())); if c >= 0 && r.x == want && r.y == 0 { ivec2(r.x, c) } else if c >= 0 && r.y == 0 { ivec2(r.x + 1, 0) } else { r } };
            found.y
        } else { 0 }
    }];
    return SearchHands {
        now: if shut { base } else { Search { ..base, open: 1, typed: typed, typed_n: n1 } },
        shut: int(shut),
        opening: int(opening),
        changed: int(added > 0 || back || opening),
        up: int(action_stick_stepped(h, 1)),
        down: int(action_stick_stepped(h, 2)),
        enter: int(action_pressed(h, command_enter())),
        escape: int(action_pressed(h, command_escape())),
        clicked: int(pointer_pressed(p, 0)),
        moved: int(p.moved),
        pointer: pointer_points(p),
        window: window() / max(scale(), 1.0),
    };
}

// ------------------------------------------------------------ the names' lines
// The names are read as lines once, a node each step: where each line
// ends (`ui.command_newlines`, `ui.command_line_count`, `ui.command_line_ends`);
// which lines hold what is typed, all lines at once (`ui.command_matched`);
// their order, those whose name is all of it first (`ui.command_ranks`,
// `ui.command_ordered`). `graphs/search.esn` wires them.

/// Each character's count of new lines up to it and with it.
kernel ui.command_newlines@1 {
    requires { field.read; field.write; }
    input names: Rows<Int>;
    output result: Rows<Int>;
    prefix with sum {
        return if sample(names) == 10 { 1 } else { 0 };
    }
}

/// Whether the character at `i` ends a line: a new line, or the last
/// character of names whose last line has none.
fn command_ends_line(names: Rows<Int>, i: Int) -> Bool {
    return at(names, i) == 10 || i == count(names) - 1;
}

/// How many lines the names hold: their new lines, and a last line
/// without one.
kernel ui.command_line_count@1 {
    requires { field.read; field.write; }
    input names: Rows<Int>;
    output result: Rows<Int>;
    compute { return if command_ends_line(names, element()) { 1 } else { 0 }; }
    merge(a, b) { return a + b; }
}

/// A row a line, each -1: what the lines' ends and order are written into
/// (its domain `max(value(count), 1)`).
kernel ui.command_no_lines@1 {
    requires { field.read; field.write; }
    input count: Rows<Int>;
    output result: Rows<Int>;
    compute { return -1; }
}

struct NameEnd { at: Int; end: Int; }
/// Where each line ends, before its new line: each new line writes its
/// place at its line's number, and a last line without one ends after its
/// last character (`blank` holds a row a line).
kernel ui.command_line_ends@1 {
    requires { field.read; field.write; }
    input names: Rows<Int>;
    input newlines: Rows<Int>;
    input blank: Rows<Int>;
    output result: Rows<Int>;
    scatter into blank with last {
        let i = element();
        let unended = sample(names) != 10 && i == count(names) - 1;
        let line = if sample(names) == 10 { sample(newlines) - 1 } else if unended { sample(newlines) } else { -1 };
        return NameEnd { at: line, end: if unended { i + 1 } else { i } };
    }
}

/// Where line `k` begins (x) and ends (y, before its new line).
fn command_name_span(ends: Rows<Int>, k: Int) -> IVec2 {
    return ivec2(if k == 0 { 0 } else { at(ends, k - 1) + 1 }, at(ends, k));
}

/// Whether the first `q` typed letters appear in `names` from `from` to
/// before `to`.
fn command_span_matches(names: Rows<Int>, from: Int, to: Int, t: Search, q: Int) -> Bool {
    let len = to - from;
    if q == 0 { return true; }
    if q > len { return false; }
    let found = loop len - q + 1 with f = 0 until f == 1 {
        let start = from + index();
        let all = loop q with a = 1 { if at(names, start + index()) == t.typed[index()] { a } else { 0 } };
        all
    };
    return found == 1;
}

/// This frame's typed search: the row the hands leave, before anything
/// is found.
kernel ui.command_query@2 {
    requires { field.read; field.write; input.read; }
    input previous: Rows<Search>;
    input hands: Rows<ActionControls>;
    input pointer: Rows<PointerControls>;
    input typing: Rows<Typing>;
    output result: Rows<Search>;
    compute { return search_hands(sample(previous), at(hands, 0), at(pointer, 0), at(typing, 0)).now; }
}

/// Whether each line holds the typed search: 1 its name is all of it,
/// 2 its name holds it, 0 not.
kernel ui.command_matched@1 {
    requires { field.read; field.write; }
    input ends: Rows<Int>;
    input names: Rows<Int>;
    input query: Rows<Search>;
    output result: Rows<Int>;
    compute {
        let t = at(query, 0);
        let q = command_typed_parts(t).x;
        let line = command_name_span(ends, element());
        if !command_span_matches(names, line.x, line.y, t, q) { return 0; }
        return if line.y - line.x == q { 1 } else { 2 };
    }
}

/// Each line's count of whole matches (x) and other matches (y) up to it
/// and with it: the last row is how many of each there are.
kernel ui.command_ranks@1 {
    requires { field.read; field.write; }
    input matched: Rows<Int>;
    output result: Rows<IVec2>;
    prefix with sum {
        let m = sample(matched);
        return ivec2(if m == 1 { 1 } else { 0 }, if m == 2 { 1 } else { 0 });
    }
}

struct FoundAt { at: Int; line: Int; }
/// The lines holding the typed search in order, whole matches first,
/// each its line's number (`blank` a row a line; the rows past the found
/// stay as `blank` holds them).
kernel ui.command_ordered@1 {
    requires { field.read; field.write; }
    input matched: Rows<Int>;
    input ranks: Rows<IVec2>;
    input blank: Rows<Int>;
    output result: Rows<Int>;
    scatter into blank with last {
        let m = sample(matched);
        let r = sample(ranks);
        let wholes = at(ranks, count(ranks) - 1).x;
        let place = if m == 1 { r.x - 1 } else if m == 2 { wholes + r.y - 1 } else { -1 };
        return FoundAt { at: place, line: element() };
    }
}

/// The `i`th line found, -1 past them.
fn command_found_line(ordered: Rows<Int>, total: Int, i: Int) -> Int {
    return if i >= 0 && i < total { at(ordered, i) } else { -1 };
}

/// The search after this frame's hands, the lines found (`ranks`,
/// `ordered`) in it: the rows shown, the choice, scrolling, and the
/// command run.
kernel ui.command_search@3 {
    requires { field.read; field.write; input.read; }
    input previous: Rows<Search>;
    input hands: Rows<ActionControls>;
    input pointer: Rows<PointerControls>;
    input typing: Rows<Typing>;
    input ranks: Rows<IVec2>;
    input ordered: Rows<Int>;
    output result: Rows<Search>;
    compute {
        let w = sample(previous);
        let pt = at(pointer, 0);
        let h = search_hands(w, at(hands, 0), pt, at(typing, 0));
        if h.shut == 1 { return h.now; }
        let t = h.now;
        let changed = h.changed == 1;
        let qp = command_typed_parts(t);
        let last = at(ranks, count(ranks) - 1);
        let total = last.x + last.y;
        let rows = min(total, command_rows_shown());
        let most_first = max(total - rows, 0);
        let win = h.window;
        let q = h.pointer;
        // The wheel scrolls; Up and Down move the choice, the list after it.
        let scroll0 = if changed { 0.0 } else { clamp(w.scroll - pt.wheel.y, 0.0, float(most_first)) };
        let up = h.up == 1;
        let down = h.down == 1;
        let keyed = clamp(if changed { 0 } else if up { w.choice - 1 } else if down { w.choice + 1 } else { w.choice }, 0, max(total - 1, 0));
        let first0 = int(floor(scroll0 + 0.5));
        let first = if up || down { if keyed < first0 { keyed } else if keyed >= first0 + rows { keyed - rows + 1 } else { first0 } } else { first0 };
        let scroll = if up || down { float(first) } else { scroll0 };
        // The pointer, moved over a row, chooses it.
        let under = command_row_under(win, rows, q);
        let moved = h.moved == 1;
        let clicked = h.clicked == 1;
        // Scrolled, the choice stays among the rows shown.
        let kept = if up || down { keyed } else { clamp(keyed, first, max(first + rows - 1, first)) };
        let choice = if under >= 0 && (moved || clicked) && !changed { first + under } else { kept };
        let picks = [each 12 { command_found_line(ordered, total, first + index()) }];
        let outside = clicked && h.opening == 0 && (q.x < search_lo(win).x || q.x > search_hi(win, rows).x || q.y < search_lo(win).y || q.y > search_hi(win, rows).y);
        if h.escape == 1 || outside { return Search { ..t, open: 0, typed_n: 0 }; }
        let run_now = (h.enter == 1 || (clicked && under >= 0)) && total > 0;
        if run_now { return Search { ..t, open: 0, typed_n: 0, run: command_found_line(ordered, total, choice), arg: qp.y }; }
        return Search { ..t, found: picks, found_n: rows, total: total, first: first, choice: choice, scroll: scroll };
    }
}

/// The command search is open, or a command ran this frame: keys are typed to it, and the tool's hotkeys must not count.
fn command_typing(s: Search) -> Bool { return s.open == 1 || s.run >= 0; }

// ------------------------------------------------------------------ drawn

/// Where line `k` of `text` begins (x) and ends (y, before its new line),
/// counted from the start.
fn command_line_of(text: Rows<Int>, k: Int) -> IVec2 {
    let n = count(text);
    let s = loop n with r = ivec3(0, 0, -1) until r.z >= 0 {
        let c = at(text, index());
        if c == 10 { if r.y == k { ivec3(r.x, r.y, index()) } else { ivec3(index() + 1, r.y + 1, -1) } } else { r }
    };
    return ivec2(s.x, if s.z >= 0 { s.z } else { n });
}

/// How much of `text`'s `line` span (start, end) covers `q` (written from `origin`,
/// `size` points a texel of the font).
fn command_span_cover(font: Grid<Float>, text: Rows<Int>, line: IVec2, origin: Vec2, size: Float, q: Vec2) -> Float {
    let local = (q - origin) / size;
    if local.y < 0.0 || local.y >= 8.0 || local.x < 0.0 { return 0.0; }
    let i = int(floor(local.x / 6.0));
    if i >= line.y - line.x { return 0.0; }
    return letter_cover(font, at(text, line.x + i), local - vec2(float(i) * 6.0, 0.0));
}
/// How much of line `k` of `text` covers `q`, counting lines from the start.
fn command_line_cover(font: Grid<Float>, text: Rows<Int>, k: Int, origin: Vec2, size: Float, q: Vec2) -> Float {
    return command_span_cover(font, text, command_line_of(text, k), origin, size, q);
}
/// How much of line `k` of the commands' names (`ends` the lines' ends) covers `q`.
fn command_name_cover(font: Grid<Float>, names: Rows<Int>, ends: Rows<Int>, k: Int, origin: Vec2, size: Float, q: Vec2) -> Float {
    if k < 0 || k >= count(ends) { return 0.0; }
    return command_span_cover(font, names, command_name_span(ends, k), origin, size, q);
}
/// How much of what is typed covers `q`, a cursor after it.
fn command_typed_cover(font: Grid<Float>, t: Search, origin: Vec2, size: Float, q: Vec2) -> Float {
    let local = (q - origin) / size;
    if local.y < -1.0 || local.y >= 9.0 || local.x < 0.0 { return 0.0; }
    let i = int(floor(local.x / 6.0));
    if i == t.typed_n { return if local.x - float(i) * 6.0 < 1.0 { 1.0 } else { 0.0 }; }
    if i > t.typed_n || local.y < 0.0 || local.y >= 8.0 { return 0.0; }
    return letter_cover(font, t.typed[i], local - vec2(float(i) * 6.0, 0.0));
}

/// The search `sr` drawn over the color `under` at point `q` of a window `win` large (both in points): its panel, the
/// typed text, the rows found in the font `font` (`names`, their `lines`), the chosen one lit, and a scroll bar when more are
/// found than shown.
fn command_panel(font: Grid<Float>, names: Rows<Int>, lines: Rows<Int>, sr: Search, win: Vec2, q: Vec2, under: Vec3) -> Vec3 {
    let ink = vec3(0.86, 0.87, 0.9);
    let ts = command_text_size();
    let rows = sr.found_n;
    let lo = search_lo(win);
    let hi = search_hi(win, max(rows, 1));
    let box_ = Rect { lo: lo, hi: hi };
    let back = fill(box_, 8.0, vec4(0.1, 0.105, 0.115, 0.94), q);
    let edge = outline(box_, 8.0, 1.0, vec4(0.35, 0.36, 0.4, 1.0), q);
    let field = fill(Rect { lo: lo + vec2(6.0, 6.0), hi: vec2(hi.x - 6.0, lo.y + 22.0) }, 4.0, vec4(0.05, 0.05, 0.06, 1.0), q);
    let typed = command_typed_cover(font, sr, lo + vec2(12.0, 10.0), ts, q);
    let top = command_rows_top(win);
    let k = int(floor((q.y - top) / command_row_height()));
    let row_lo = top + float(k) * command_row_height();
    let lit = if k >= 0 && k < rows && sr.first + k == sr.choice { fill(Rect { lo: vec2(lo.x + 6.0, row_lo), hi: vec2(hi.x - 14.0, row_lo + command_row_height() - 1.0) }, 4.0, vec4(0.85, 0.45, 0.12, 0.85), q) } else { clear() };
    let name = if k >= 0 && k < rows { command_name_cover(font, names, lines, sr.found[k], vec2(lo.x + 12.0, row_lo + 0.5 * (command_row_height() - 8.0 * ts)), ts, q) } else { 0.0 };
    let list_h = float(max(rows, 1)) * command_row_height();
    let bar = if sr.total > rows && rows > 0 {
        let span = list_h * float(rows) / float(sr.total);
        let from = top + list_h * float(sr.first) / float(sr.total);
        fill(Rect { lo: vec2(hi.x - 10.0, from), hi: vec2(hi.x - 6.0, from + span) }, 2.0, vec4(0.6, 0.62, 0.68, 0.8), q)
    } else { clear() };
    let painted = onto(onto(onto(onto(onto(under, back), edge), field), lit), bar);
    return mix(painted, ink, clamp(typed + name, 0.0, 1.0));
}

/// The picture filling the window, the command search drawn over it while open: a box at the top, what is typed, the lines found,
/// the chosen line lit, a scroll bar when more are found than listed.
kernel ui.command_overlay@1 {
    requires { field.read; field.write; input.read; }
    input picture: Image;
    input search: Rows<Search>;
    /// The commands' names, one a line, and the lines' ends (the search's `lines`).
    input names: Rows<Int>;
    input lines: Rows<Int>;
    input font: Grid<Float>;
    output result: Image;
    compute {
        let seen = at_linear(picture, (coord() + 0.5) * size(picture) / domain());
        let sr = at(search, 0);
        if sr.open == 0 { return vec4(seen.x, seen.y, seen.z, 1.0); }
        let s = max(scale(), 1.0);
        let text = command_panel(font, names, lines, sr, domain() / s, (coord() + 0.5) / s, seen.xyz);
        return vec4(text.x, text.y, text.z, 1.0);
    }
}
