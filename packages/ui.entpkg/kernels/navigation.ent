// Moving through a list of rows by a person's hands as `controls` reads
// them: which row is lit, and what was asked of it this frame. The
// arrows or a pad's left stick step (held, they repeat), the wheel
// steps; the confirm and back actions are `ui.navigation_keys`' (Enter
// or Space or a pad's south, Esc or Backspace or its east); the pointer
// lights the row it moves onto, a click confirms it. The navigation is
// state a node keeps (`previous <~ result from start`); what it asks is
// the scene's to do: change a value by `by`, act on `confirm`, leave on
// `back`.
use "controls.entpkg";
use "layout.ent";

/// The navigation after a frame: the row lit (`rows` of them); the
/// change asked of it this frame, left -1 and right 1 (`by`); confirm
/// and back pressed this frame; the row under the pointer (-1 none) and
/// how far across it (0 to 1).
struct Nav { row: Int; by: Int; confirm: Bool; back: Bool; pointed: Int; along: Float; }

/// The actions of `ui.navigation_keys`, by their place in its table.
fn nav_confirm() -> Int { return 0; }
fn nav_back() -> Int { return 1; }

/// The navigation before any frame, row `row` lit.
kernel ui.navigation_start@1 {
    requires { field.write; }
    param row: Int = 0;
    output result: Rows<Nav>;
    compute { return Nav { row: row, by: 0, confirm: false, back: false, pointed: -1, along: 0.0 }; }
}

/// The actions a list confirms and goes back by, for `controls.read`
/// (`domain = 2`): Enter, Space or a pad's south; Esc, Backspace or its
/// east.
kernel ui.navigation_keys@1 {
    requires { field.write; }
    output result: Rows<ActionBinding>;
    compute {
        return if element() == nav_confirm() { ActionBinding { key: 13, key2: 32, pad: 8 } } else { ActionBinding { key: 27, key2: 8, pad: 9 } };
    }
}

/// The navigation after a frame through `rows` rows, round when `wrap`
/// is 1, by `hands` (`controls.read` over `ui.navigation_keys`) and the
/// `pointer` (`controls.pointer`). The list lies where its row `list`
/// says, in the output's pixels (its left, top, width, and the rows'
/// height), the rows `gap` apart, for the pointer: a scene's layout
/// works it out, the window's size and scale known. `active` 0 holds it
/// still, its row kept and nothing asked.
kernel ui.navigate@2 {
    requires { field.read; field.write; }
    param rows: Int = 1;
    param wrap: Int = 1;
    param active: Int = 1;
    param gap: Float = 0.0;
    input previous: Rows<Nav>;
    input list: Rows<Vec4>;
    input hands: Rows<ActionControls>;
    input pointer: Rows<PointerControls>;
    output result: Rows<Nav>;
    compute {
        let o = at(previous, 0);
        let h = at(hands, 0);
        let pt = at(pointer, 0);
        if active == 0 { return Nav { ..o, by: 0, confirm: false, back: false }; }
        let step = int(action_stick_stepped(h, 2)) - int(action_stick_stepped(h, 1)) + int(-sign(pt.wheel.y));
        let by = int(action_stick_stepped(h, 8)) - int(action_stick_stepped(h, 4));
        let n = max(rows, 1);
        let stepped_row = if wrap == 1 { ((o.row + step) % n + n) % n } else { clamp(o.row + step, 0, n - 1) };
        // The pointer: the row under it, lit when it moves onto it.
        let l = at(list, 0);
        let area = Rect { lo: l.xy, hi: vec2(l.x + l.z, l.y + float(n) * (l.w + gap)) };
        let pointed = list_row_at(area, pt.at, l.w, gap, n);
        let clicked = pointer_pressed(pt, 0);
        let row = if pointed >= 0 && (pt.moved || clicked) { pointed } else { stepped_row };
        let along = if pointed >= 0 { saturate((pt.at.x - l.x) / max(l.z, 1.0)) } else { 0.0 };
        return Nav { row: row, by: by, confirm: action_pressed(h, nav_confirm()) || (clicked && pointed >= 0),
            back: action_pressed(h, nav_back()), pointed: pointed, along: along };
    }
}

/// What a widget in row `k` is with the navigation at `nav`: focused when
/// lit, else idle; disabled when not `enabled`.
fn row_state(nav: Nav, k: Int, enabled: Bool) -> Int {
    return if !enabled { WidgetState.Disabled } else if nav.row == k { WidgetState.Focused } else { WidgetState.Idle };
}

/// A count changed by `by` within `lo` to `hi`; round among `n`.
fn stepped(v: Int, by: Int, lo: Int, hi: Int) -> Int { return clamp(v + by, lo, hi); }
fn cycled(v: Int, by: Int, n: Int) -> Int { return ((v + by) % max(n, 1) + max(n, 1)) % max(n, 1); }

/// A level (0 to 1) changed by `by` steps of `step`.
fn slid(v: Float, by: Int, step: Float) -> Float { return saturate(v + float(by) * step); }
