// Letters: what a screen's text is made of. A text is decoded once into
// rows of letters of a fixed width, a cell each, and drawn a cell at a
// time (`write.ent`). A letter is a printable ASCII code, drawn from the
// text package's 5 by 7 bitmap font in a cell 6 texels by 8, or a wide
// one, 256 and its slot in an atlas the scene draws, over two cells, the
// second cell -1. A space is 32; a character neither the bitmap font nor
// the atlas holds is a `?`.
//
// The letters' grid (`ui.letters`) is the bitmap font in its top 48
// rows, then a row whose first texel is the side of the atlas's glyphs
// in pixels, then the atlas: square glyphs that side, as many a row as
// fit in 96 texels, slot 0 at the top left, one slot a character of a
// row of codes in order of code. How the atlas is drawn, from which
// font, is the scene's: the package draws no font. A wide glyph stands
// in the middle of its two cells, as tall as its side, so glyphs of 10
// pixels stand a pixel over and under a line of the bitmap font. The
// bitmap font alone is a letters' grid with no atlas.

fn letters_atlas_top() -> Int { return 49; }

/// The side of the atlas's glyphs, as the grid holds it.
fn glyph_side(letters: Grid<Float>) -> Float { return at(letters, vec2(0.0, 48.0)); }

/// The slot of a code in the atlas's codes, in order of code, by
/// bisection; -1 for one it does not hold.
fn atlas_slot(code: Int, codes: Rows<Int>) -> Int {
    let found = loop 32 with r = ivec2(0, count(codes)) until r.x >= r.y {
        let mid = (r.x + r.y) / 2;
        if at(codes, mid) >= code { ivec2(r.x, mid) } else { ivec2(mid + 1, r.y) }
    };
    return if found.x < count(codes) && at(codes, found.x) == code { found.x } else { -1 };
}

/// The atlas for no wide letters: its codes, none of them a character.
kernel ui.no_codes@1 {
    requires { field.write; }
    output result: Rows<Int>;
    compute { return -1; }
}

/// The letters' grid: the bitmap font, the side of the atlas's glyphs,
/// and the atlas, a grid 96 texels across the scene draws. A node sets
/// `domain = vec2(96.0, 49.0) + size(atlas) * vec2(0.0, 1.0)`
/// (`graphs/letters.esn`).
kernel ui.letters@1 {
    requires { field.read; field.write; }
    param side: Int = 10;
    input font: Grid<Float>;
    input atlas: Grid<Float>;
    output result: Grid<Float>;
    compute {
        let p = icoord();
        if p.y < 48 { return if p.x < 96 { at(font, vec2(float(p.x), float(p.y))) } else { 0.0 }; }
        if p.y == 48 { return if p.x == 0 { float(side) } else { 0.0 }; }
        return at(atlas, vec2(float(p.x), float(p.y - letters_atlas_top())));
    }
}

/// The cover of a letter at `local`, in texels from its first cell's top
/// left: of the bitmap font in 0..6 by 0..8, of a wide one in its glyph's
/// square over the middle of 0..12 by 0..8.
fn letter_cover(letters: Grid<Float>, code: Int, local: Vec2) -> Float {
    if code >= 256 {
        let side = glyph_side(letters);
        let n = int(side);
        let g = floor(local - vec2((12.0 - side) * 0.5, (8.0 - side) * 0.5));
        if g.x < 0.0 || g.y < 0.0 || g.x >= side || g.y >= side { return 0.0; }
        let k = code - 256;
        let columns = 96 / max(n, 1);
        return at(letters, vec2(float(k % columns * n) + g.x, float(letters_atlas_top() + k / columns * n) + g.y));
    }
    if code <= 32 || local.x < 0.0 || local.y < 0.0 || local.x >= 6.0 || local.y >= 8.0 { return 0.0; }
    let c = if code > 126 { 63 } else { code };
    let cell = c - 32;
    return at(letters, vec2(float(cell % 16 * 6) + floor(local.x), float(cell / 16 * 8) + floor(local.y)));
}

/// The letter a character's code is: itself if printable ASCII, a
/// space for another below 128, 256 and its slot if the atlas holds it,
/// else a `?`.
fn letter_of(code: Int, codes: Rows<Int>) -> Int {
    if code >= 32 && code < 127 { return code; }
    if code < 128 { return 32; }
    let slot = atlas_slot(code, codes);
    return if slot >= 0 { 256 + slot } else { 63 };
}

/// Whether a letter is wide, two cells.
fn wide_letter(letter: Int) -> Bool { return letter >= 256; }

// ---------------------------------------------------------------- texts

/// How many rows a text has: its lines, each ended by a new line, and a
/// last one not ended. A text is UTF-8 bytes (`bytes "file.txt"`).
kernel ui.text_rows@1 {
    requires { field.read; field.write; }
    input text: Rows<Int>;
    output result: Rows<Int>;
    compute {
        let n = count(text);
        let breaks = loop n with b = 0 { if at(text, index()) == 10 { b + 1 } else { b } };
        return if n > 0 && at(text, n - 1) != 10 { breaks + 1 } else { breaks };
    }
}

/// Where each row of a text begins: after as many new lines as its
/// number. A node sets `domain = value(rows, 0)` from `ui.text_rows`.
kernel ui.text_starts@1 {
    requires { field.read; field.write; }
    input text: Rows<Int>;
    /// How many rows: the extent.
    input rows: Rows<Int>;
    output result: Rows<Int>;
    compute {
        let row = element();
        let n = count(text);
        if row == 0 { return 0; }
        let found = loop n with s = ivec2(0, -1) until s.y >= 0 {
            let lines = if at(text, index()) == 10 { s.x + 1 } else { s.x };
            ivec2(lines, if lines == row { index() + 1 } else { -1 })
        };
        return if found.y >= 0 { found.y } else { n };
    }
}

/// A character of a text at `i`: its code and how many of the text's
/// elements it takes, from UTF-8 bytes (`utf8`) or from codes one an
/// element (`text "..."`).
fn char_at(text: Rows<Int>, i: Int, utf8: Bool) -> IVec2 {
    let b0 = at(text, i);
    if !utf8 || b0 < 128 { return ivec2(b0, 1); }
    let n = if b0 >= 240 { 4 } else if b0 >= 224 { 3 } else { 2 };
    let lead = if n == 4 { b0 & 7 } else if n == 3 { b0 & 15 } else { b0 & 31 };
    let code = loop n - 1 with c = lead { (c << 6) | (at(text, i + 1 + index()) & 63) };
    return ivec2(code, n);
}

/// A text's rows as letters, `width` cells a row: its characters a cell
/// each, a wide one two, the second -1; one that would cross the row's
/// end, and the row past its end, spaces. The text is UTF-8 bytes, or
/// codes with `utf8 = 0` (`text "..."`, whose rows are one, `starts` a
/// single 0); its wide letters those of the atlas's `codes`. A node sets
/// `domain = width * count(starts)`.
kernel ui.lettered@1 {
    requires { field.read; field.write; }
    param width: Int = 12;
    param utf8: Int = 1;
    input text: Rows<Int>;
    input starts: Rows<Int>;
    input codes: Rows<Int>;
    output result: Rows<Int>;
    compute {
        let row = element() / width;
        let cell = element() % width;
        let n = count(text);
        let decoding = utf8 == 1;
        // Walked from the row's start: the element, the cell, the letter
        // in the cell asked for (-2 not reached yet).
        let walked = loop width with w = ivec3(at(starts, row), 0, -2) until w.z != -2 {
            let ended = w.x >= n || at(text, w.x) == 10;
            let c = if ended { ivec2(32, 1) } else { char_at(text, w.x, decoding) };
            let letter = letter_of(c.x, codes);
            let cells = if wide_letter(letter) { 2 } else { 1 };
            if ended || w.y + cells > width { ivec3(w.x, w.y, 32) }
            else if w.y == cell { ivec3(w.x, w.y, letter) }
            else if cells == 2 && w.y + 1 == cell { ivec3(w.x, w.y, -1) }
            else { ivec3(w.x + c.y, w.y + cells, -2) }
        };
        return if walked.z == -2 { 32 } else { walked.z };
    }
}

/// One of two texts' letters, element by element: `second` while the
/// chosen number is `when`, else `first`. Two languages are one either;
/// more, eithers one after another, each its own `when`.
kernel ui.either@1 {
    requires { field.read; field.write; }
    param when: Int = 1;
    input first: Rows<Int>;
    input second: Rows<Int>;
    input chosen: Rows<Int>;
    output result: Rows<Int>;
    compute {
        let i = element();
        return if at(chosen, 0) == when { at(second, i) } else { at(first, i) };
    }
}
