// The command search (`ui.command_search`) over `names`, a command a line:
// the names read as lines once, the hands read by `controls`, the lines
// holding what is typed found all at once and put in order, then chosen
// from. `result` is the search's row
// (`Search`); `lines`, where each line ends, is what `ui.command_overlay`
// draws the names by; `first`, the row before any frame, starts what reads
// the search `<~`.
use "../kernels/";
use "controls.entpkg";

input names: Rows<Int>;

node newlines: ui.command_newlines@1 { names <- names; }
node line_count: ui.command_line_count@1 { names <- names; }
node blank: ui.command_no_lines@1 { count <- line_count.result; domain = max(value(count), 1); }
node lines: ui.command_line_ends@1 { names <- names; newlines <- newlines.result; blank <- blank.result; }
node keys: ui.command_keys@1 { domain = 3; }
node hands_start: controls.start@1 { domain = 1; }
node hands: controls.read@1 { previous <~ hands.result from hands_start.result; actions <- keys.result; }
node pointer_start: controls.pointer_start@1 { domain = 1; }
node pointer: controls.pointer@1 { previous <~ pointer.result from pointer_start.result; }
node typing: controls.typing@1 { domain = 1; }
node start: ui.command_start@1 { domain = 1; }
node query: ui.command_query@2 { previous <~ search.result from start.result; hands <- hands.result; pointer <- pointer.result; typing <- typing.result; }
node matched: ui.command_matched@1 { ends <- lines.result; names <- names; query <- query.result; domain = count(ends); }
node ranks: ui.command_ranks@1 { matched <- matched.result; }
node ordered: ui.command_ordered@1 { matched <- matched.result; ranks <- ranks.result; blank <- blank.result; }
node search: ui.command_search@3 { previous <~ search.result from start.result; hands <- hands.result; pointer <- pointer.result; typing <- typing.result; ranks <- ranks.result; ordered <- ordered.result; }

output result <- search.result;
output lines <- lines.result;
output first <- start.result;
