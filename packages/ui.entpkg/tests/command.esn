// The ui package's command search over four commands, the last line
// with a new line after it or without: Space opens it,
// typing filters, Enter runs the chosen one, drawn over a dark picture.
use "../kernels/";
use "text.entpkg";

input font: Grid<Float> = "data/font.png";
input names: Rows<Int> = text "open file\nsave file\nquit\nsave all";
input ended: Rows<Int> = text "open file\nsave file\nquit\nsave all\n";

node commands: graph "../graphs/command_search.esn" { names <- names; }
node listed: graph "../graphs/command_search.esn" { names <- ended; }
node dark: kernel {
    requires { field.write; }
    output result: Image;
    domain = vec2(320, 180);
    compute { return vec4(0.05, 0.05, 0.06, 1.0); }
}
node shown: ui.command_overlay@1 { picture <- dark.result; search <- commands.result; names <- names; lines <- commands.lines; font <- font; domain = vec2(320, 180); }

output result <- shown.result;
