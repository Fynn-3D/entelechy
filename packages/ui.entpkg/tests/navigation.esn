// A list of four rows moved through by the hands `controls` reads: keys,
// a pad and the pointer.
use "../kernels/";
use "controls.entpkg";

// The list: its top left, its width and a row's height, rows 4 apart.
node rows: kernel {
    requires { field.write; }
    output result: Rows<Vec4>;
    domain = 1;
    compute { return vec4(10.0, 10.0, 100.0, 16.0); }
}
node start: ui.navigation_start@1 { row = 0; domain = 1; }
node keys: ui.navigation_keys@1 { domain = 2; }
node hands_start: controls.start@1 { domain = 1; }
node hands: controls.read@1 { previous <~ hands.result from hands_start.result; actions <- keys.result; }
node pointer_start: controls.pointer_start@1 { domain = 1; }
node pointer: controls.pointer@1 { previous <~ pointer.result from pointer_start.result; }
node nav: ui.navigate@2 { previous <~ nav.result from start.result; list <- rows.result; hands <- hands.result; pointer <- pointer.result; rows = 4; gap = 4.0; domain = 1; }

node inside: kernel {
    requires { field.write; }
    output result: Rows<Int>;
    domain = 3;
    compute {
        let r = Rect { lo: vec2(10.0, 10.0), hi: vec2(20.0, 20.0) };
        return int(contains(r, [vec2(10.0, 10.0), vec2(20.0, 15.0), vec2(15.0, 15.0)][element()]));
    }
}

output result <- nav.result;
