// A camera's finish, as Kernels over a picture of light (rgb, which may be far
// brighter than white) that keeps in w how far away what each pixel
// shows is.
use "tonemap.orla";
use "filter.orla";
use "../../noise.orlapkg";

/// The picture smaller, each pixel the mean of four samples: all its
/// light (`over` 0), or only what is past `over`. w, the depth, is kept.
kernel image.bright@1 {
    requires { field.read; field.write; }
    input source: Grid<Vec4>;
    param over: Float = 0.8;
    output result: Grid<Vec4>;
    compute {
        let scale = size(source) / domain();
        let p = (coord() + vec2(0.5, 0.5)) * scale;
        let q = scale * 0.25;
        let c = (at_linear(source, p + vec2(q.x, q.y)) + at_linear(source, p - vec2(q.x, q.y))
               + at_linear(source, p + vec2(q.x, 0.0 - q.y)) + at_linear(source, p - vec2(q.x, 0.0 - q.y))) * 0.25;
        let light = max(vec3(c.x, c.y, c.z) - vec3(over, over, over), vec3(0.0, 0.0, 0.0));
        return vec4(light.x, light.y, light.z, c.w);
    }
}

/// The finished picture: depth of field between the sharp picture and
/// its soft copy, by how far each pixel's depth is from `focus` (the
/// first row); the glow added; then exposure, ACES, colour fringing
/// toward the edges (`fringe`), darkened corners (`vignette`) and grain
/// (`grain`), new every frame.
kernel image.grade@1 {
    requires { field.read; field.write; time.read; }
    input source: Grid<Vec4>;
    input soft: Grid<Vec4>;
    input near_glow: Grid<Vec4>;
    input far_glow: Grid<Vec4>;
    input focus: Rows<Float>;
    param exposure: Float = 1.0;
    param depth: Float = 1.4;
    param fringe: Float = 0.003;
    param vignette: Float = 1.1;
    param grain: Float = 0.03;
    output result: Image;
    compute {
        let uv = (coord() + vec2(0.5, 0.5)) / domain();
        let fs = size(source);
        let off = (uv - vec2(0.5, 0.5)) * fringe * fs.x;
        let sharp = vec3(at_linear(source, uv * fs + off).x, at_linear(source, uv * fs).y, at_linear(source, uv * fs - off).z);
        let here = at_linear(source, uv * fs);
        let blurred = at_linear(soft, uv * size(soft));
        let focused = max(at(focus, 0), 0.0001);
        let blur = clamp(abs(here.w - focused) / focused * depth - 0.12, 0.0, 0.6);
        let seen = mix(sharp, vec3(blurred.x, blurred.y, blurred.z), blur);
        let bloom = at_linear(near_glow, uv * size(near_glow)) * 0.55 + at_linear(far_glow, uv * size(far_glow)) * 0.45;
        let toned = aces((seen + vec3(bloom.x, bloom.y, bloom.z)) * exposure);
        let d = uv - vec2(0.5, 0.5);
        let shown = pow(toned, vec3(1.0 / 2.2, 1.0 / 2.2, 1.0 / 2.2)) * (1.0 - vignette * dot(d, d));
        let frame = int(time() * 60.0);
        let g = (unit_of(hash_int3(int(coord().x), int(coord().y), frame, 71)) - 0.5) * grain;
        return vec4(shown.x + g, shown.y + g, shown.z + g, 1.0);
    }
}
