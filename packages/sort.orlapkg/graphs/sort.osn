//! The permutation that orders `keys`, least significant bit first.
//! Place it with
//!   node order: graph "sort.orlapkg/graphs/sort.osn" {
//!       keys <- cell.result; bits = 12;
//!   }
//! and read a row through it: `at(bodies, at(order, slot))`.
//!
//! `bits` is how many bits of the key matter; the keys must be
//! non-negative and below `2^bits`.
use "../kernels/sort.orla";

input keys: Rows<Int>;
param bits: Int = 16;

node start: sort.identity@1 { keys <- keys; }
node zero: sort.first_bit@1 { domain = 1; }
node slots: sort.blank@1 { keys <- keys; }

node sorted: graph "sort_pass.osn" {
    times = bits;
    carry order <- result;
    carry bit <- step;
    order <- start.result;
    bit <- zero.result;
    keys <- keys;
    slots <- slots.result;
}

output result <- sorted.result;
