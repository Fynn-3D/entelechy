// Particles are rows of `Particle`, each frame made from the last (wired in a scene as `<~`).
use "random.entpkg";
use "geometry.entpkg";
use "render.entpkg";

/// A particle: where it is, how fast, how long it has lived, how long it may live (0 not yet born), how large (meters),
/// its look (`kind`), its own number, how far it has turned (radians).
struct Particle { at: Vec3; vel: Vec3; age: Float; life: Float; size: Float; kind: Int; seed: Int; spin: Float; }
type Particles = Rows<Particle>;

/// An emitter: a center and half size (particles are born in this box), the `count` slots from `first` it keeps,
/// how long they live (seconds, from and to), the speed they are born with and how much it varies, how large (from and to), their look, the vertical
/// acceleration (negative falls, positive floats up), and how fast they follow the wind (a second).
struct Emitter { at: Vec3; half: Vec3; first: Int; count: Int; life: Vec2; speed: Vec3; jitter: Float; size: Vec2; kind: Int; lift: Float; drag: Float; }
type Emitters = Rows<Emitter>;

/// Particles not yet born (the state's first frame).
kernel particles.none@1 {
    requires { field.write; }
    output result: Rows<Particle>;
    compute { return Particle { at: vec3(0.0, -100000.0, 0.0), vel: vec3(0.0, 0.0, 0.0), age: 0.0, life: 0.0, size: 0.0, kind: 0, seed: 0, spin: 0.0 }; }
}

/// The particles' looks.
fn kind_mote() -> Int { return 0; }
fn kind_seed() -> Int { return 1; }
fn kind_petal() -> Int { return 2; }
fn kind_firefly() -> Int { return 3; }
fn kind_butterfly() -> Int { return 4; }

/// The wind at `p` at time `t`: the base wind (`wind`'s xyz), plus turbulence (three noises drifting slowly by, as strong
/// as `wind`'s w).
fn wind_at(wind: Vec4, p: Vec3, t: Float) -> Vec3 {
    let q = p * 0.25 - vec3(wind.x, wind.y, wind.z) * t * 0.25;
    let tu = vec3(fbm3(q, 3, 501), fbm3(q + vec3(5.1, 1.7, 3.3), 3, 502) * 0.6, fbm3(q + vec3(2.3, 7.9, 1.1), 3, 503));
    return vec3(wind.x, wind.y, wind.z) + tu * wind.w;
}

/// The particles a frame on (`step` seconds later). The ground's height map covers `ground_side` meters from (`ground_x`, `ground_z`).
///
kernel particles.step@1 {
    requires { field.read; field.write; time.read; }
    input previous: Rows<Particle>;
    input emitters: Rows<Emitter>;
    /// The wind: the base wind (xyz, meters a second) and how strong the turbulence is (w).
    input wind: Rows<Vec4>;
    input ground: Grid<Float>;
    param step: Float = 0.016667;
    param ground_x: Float = -100.0;
    param ground_z: Float = -100.0;
    param ground_side: Float = 200.0;
    output result: Rows<Particle>;
    compute {
        let i = element();
        let t = time();
        let found = loop 16 with f = -1 until index() >= count(emitters) || f >= 0 {
            let em = at(emitters, index());
            if i >= em.first && i < em.first + em.count { index() } else { f }
        };
        let dead = Particle { at: vec3(0.0, -100000.0, 0.0), vel: vec3(0.0, 0.0, 0.0), age: 0.0, life: 0.0, size: 0.0, kind: 0, seed: 0, spin: 0.0 };
        if found < 0 { return dead; }
        let em = at(emitters, found);
        let p = at(previous, i);
        let age = p.age + step;
        if p.life <= 0.0 || age >= p.life {
            // Born (again): somewhere in the box; the first time at any age,
            // so they do not all start together.
            let h = hash_int2(i, int(t * 60.0) + 7, 601);
            let r3 = vec3(unit_of(hash_int(h, 1)), unit_of(hash_int(h, 2)), unit_of(hash_int(h, 3))) * 2.0 - 1.0;
            let life = mix(em.life.x, em.life.y, unit_of(hash_int(h, 4)));
            let v3 = vec3(unit_of(hash_int(h, 5)), unit_of(hash_int(h, 6)), unit_of(hash_int(h, 7))) * 2.0 - 1.0;
            return Particle { at: em.at + r3 * em.half, vel: em.speed + v3 * em.jitter, age: if p.life <= 0.0 { unit_of(hash_int(h, 8)) * life } else { 0.0 },
                life: life, size: mix(em.size.x, em.size.y, unit_of(hash_int(h, 9))), kind: em.kind, seed: h & 0xffff, spin: unit_of(hash_int(h, 10)) * 6.2831853 };
        }
        // The wind carries it (the lighter, the sooner), it rises or falls.
        let lo = vec2(ground_x, ground_z);
        let n = size(ground);
        let gy = at_linear(ground, clamp((vec2(p.at.x, p.at.z) - lo) / ground_side * n, vec2(0.5, 0.5), n - 0.5));
        let landed = p.at.y <= gy + 0.012 && p.vel.y <= 0.0 && em.lift < 0.0;
        let w = wind_at(at(wind, 0), p.at, t);
        let follow = 1.0 - exp(0.0 - em.drag * step);
        let v1 = p.vel + (w - p.vel) * follow + vec3(0.0, em.lift * step, 0.0);
        let v = if landed { vec3(0.0, 0.0, 0.0) } else { v1 };
        let next = p.at + v * step;
        let at_ = vec3(next.x, max(next.y, gy + 0.01), next.z);
        let spin_rate = (unit_of(hash_int(p.seed, 11)) - 0.5) * 6.0;
        return Particle { ..p, at: at_, vel: v, age: age, spin: p.spin + spin_rate * step * (if landed { 0.0 } else { 1.0 }) };
    }
}

/// How large a bin of the picture is (pixels), and the most it holds (in groups of four).
fn bin_tile() -> Int { return 16; }
fn bin_groups() -> Int { return 4; }
/// A particle on a picture `ext` large: its center (xy), how far from the eye (z, negative behind it), its radius (w, pixels).
fn on_screen(l: Lens, p: Particle, ext: Vec2) -> Vec4 {
    let s = project(l, p.at, ext);
    let r = if s.z > 0.0 { p.size * l.focal * ext.y / s.z } else { 0.0 };
    return vec4(s.x, s.y, s.z, r);
}

/// Each bin gathers the particles falling on it: cell (x, y) is group `x % bin_groups()` of four of bin
/// (`x / bin_groups()`, y) (their numbers, -1 for none). A scene gives it `domain =
/// ceil(picture / 16) * vec2(4, 1)`.
kernel particles.bin@1 {
    requires { field.read; field.write; }
    input particles: Rows<Particle>;
    input lens: Lenses;
    /// How large the picture is (pixels).
    input size: Rows<Vec2>;
    output result: Grid<IVec4>;
    compute {
        let c = icoord();
        let ext = at(size, 0);
        let l = at(lens, 0);
        let g = c.x % bin_groups();
        let lo = vec2(float(c.x / bin_groups()), float(c.y)) * float(bin_tile());
        let hi = lo + float(bin_tile());
        let r = loop 4096 with a = [ivec4(-1, -1, -1, -1), ivec4(0, 0, 0, 0)] until index() >= count(particles) || a[1].x >= (g + 1) * 4 {
            let p = at(particles, index());
            let s = on_screen(l, p, ext);
            let hit = p.size > 0.0 && s.z > 0.05 && s.w > 0.3 && s.x + s.w > lo.x && s.x - s.w < hi.x && s.y + s.w > lo.y && s.y - s.w < hi.y;
            if !hit { a } else {
                let k = a[1].x - g * 4;
                let b = a[0];
                let b2 = if k == 0 { ivec4(index(), b.y, b.z, b.w) } else if k == 1 { ivec4(b.x, index(), b.z, b.w) } else if k == 2 { ivec4(b.x, b.y, index(), b.w) } else if k == 3 { ivec4(b.x, b.y, b.z, index()) } else { b };
                [b2, ivec4(a[1].x + 1, 0, 0, 0)]
            }
        };
        return r[0];
    }
}

/// Particle `p`'s look at `q` in its own coordinates (-1 to 1, turned): its color (rgb, before
/// light) and opacity (w); its own glow is counted apart (`glow`).
fn particle_look(p: Particle, q: Vec2, t: Float) -> Vec4 {
    let r = length(q);
    let h = p.seed;
    if p.kind == kind_seed() {
        // A dandelion's parachute: fine hairs out from the top of its
        // stalk, and the seed hanging below.
        let top = q - vec2(0.0, 0.25);
        let a = atan2(top.y, top.x);
        let hair = pow(abs(cos(a * 7.0)), 30.0) * (1.0 - smoothstep(0.35, 0.75, length(top))) * step(0.0, top.y + 0.1);
        let crown = (1.0 - smoothstep(0.0, 0.7, length(top))) * 0.18;
        let stalk = (1.0 - smoothstep(0.0, 0.035, abs(q.x))) * step(-0.55, q.y) * step(q.y, 0.25);
        let seed = 1.0 - smoothstep(0.06, 0.1, length((q - vec2(0.0, -0.62)) * vec2(2.2, 1.0)));
        let w = max(max(hair * 0.75, crown), max(stalk * 0.6, seed));
        return vec4(mix(0.92, 0.35, seed), mix(0.92, 0.3, seed), mix(0.88, 0.22, seed), w);
    }
    if p.kind == kind_petal() {
        let e = length(q * vec2(1.0, 1.9));
        let c = if (h & 1) == 0 { vec3(0.9, 0.85, 0.8) } else { vec3(0.85, 0.75, 0.15) };
        return vec4(c.x, c.y, c.z, 1.0 - smoothstep(0.85, 1.0, e));
    }
    if p.kind == kind_butterfly() {
        // Two wings beating, a body between.
        let beat = 0.25 + 0.75 * abs(sin(t * 14.0 + float(h)));
        let wx = abs(q.x) / max(beat, 0.05);
        let wing = 1.0 - smoothstep(0.9, 1.0, length(vec2(wx - 0.5, q.y * 1.3 + (if q.y > 0.0 { 0.0 } else { 0.25 }))) * 2.0);
        let body = 1.0 - smoothstep(0.05, 0.09, abs(q.x)) * 1.0;
        let tone = unit_of(hash_int(h, 3));
        let c = if tone < 0.4 { vec3(0.9, 0.45, 0.08) } else if tone < 0.75 { vec3(0.92, 0.9, 0.85) } else { vec3(0.25, 0.35, 0.85) };
        let rim = smoothstep(0.55, 0.9, length(vec2(wx - 0.5, q.y * 1.3)) * 2.0);
        let col = mix(c, vec3(0.05, 0.04, 0.03), rim * 0.8);
        let a = max(wing, body * step(abs(q.y), 0.5));
        return vec4(col.x, col.y, col.z, a * step(r, 1.2));
    }
    // A mote of pollen (or a firefly): a soft dot.
    let w = exp(0.0 - r * r * 5.0);
    return vec4(1.0, 0.95, 0.75, w * 0.55);
}
/// How much light it gives itself (a firefly).
fn particle_glow(p: Particle, t: Float) -> Float {
    return if p.kind == kind_firefly() { 6.0 * max(sin(t * 2.3 + float(p.seed)), 0.0) } else { 0.0 };
}

/// The particles blended into the picture `hdr` (`surface`'s w is how far each pixel lies along the view ray; it may be smaller than
/// the picture, read to scale). Moving particles are drawn after temporal antialiasing (or they smear).
/// Particles are lit by the sun (thin ones glow seen against it) and the sky light; blended in any order alike (weighted).
kernel particles.draw@1 {
    requires { field.read; field.write; time.read; }
    input hdr: Image;
    input surface: Grid<Vec4>;
    input bins: Grid<IVec4>;
    input particles: Rows<Particle>;
    input lens: Lenses;
    input sky: SkyLooks;
    output result: Image;
    compute {
        let q = coord();
        let ext = domain();
        let l = at(lens, 0);
        let s = at(sky, 0);
        let t = time();
        let here = at(hdr, q);
        // The surface may be drawn smaller than the picture.
        let depth = at(surface, min(floor((q + 0.5) * size(surface) / ext), size(surface) - 1.0)).w;
        let dir = ray(l, q, ext);
        let tile = ivec2(int(q.x) / bin_tile(), int(q.y) / bin_tile());
        // (sum of color × alpha × weight, sum of alpha × weight, what is let through)
        let r = loop 16 with a = [vec4(0.0, 0.0, 0.0, 0.0), vec4(1.0, 0.0, 0.0, 0.0)] {
            let g = at(bins, ivec2(tile.x * bin_groups() + index() / 4, tile.y));
            let k = index() % 4;
            let id = if k == 0 { g.x } else if k == 1 { g.y } else if k == 2 { g.z } else { g.w };
            if id < 0 { a } else {
                let p = at(particles, id);
                let sc = on_screen(l, p, ext);
                let d = (q + 0.5 - sc.xy) / max(sc.w, 0.001);
                let c = cos(p.spin);
                let sn = sin(p.spin);
                let local = vec2(c * d.x - sn * d.y, sn * d.x + c * d.y) * vec2(1.0, -1.0);
                let look = particle_look(p, if p.kind == kind_seed() || p.kind == kind_butterfly() { d * vec2(1.0, -1.0) } else { local }, t);
                // Behind what is there: hidden; just in front: fading in.
                let fade = saturate((depth - sc.z) / max(p.size * 2.0, 0.02));
                let alpha = saturate(look.w * fade);
                if alpha <= 0.002 { a } else {
                    let back = pow(max(dot(dir, normalize(s.sun)), 0.0), 6.0);
                    let lit = vec3(look.x, look.y, look.z) * (s.sun_color * (0.25 + 1.2 * back) + s.ambient) + vec3(1.0, 0.9, 0.4) * particle_glow(p, t);
                    let w = alpha * clamp(10.0 / (1.0 + sc.z * 0.1), 0.05, 10.0);
                    [vec4(a[0].x + lit.x * w, a[0].y + lit.y * w, a[0].z + lit.z * w, a[0].w + w), vec4(a[1].x * (1.0 - alpha), 0.0, 0.0, 0.0)]
                }
            }
        };
        let through = r[1].x;
        let mixed = vec3(r[0].x, r[0].y, r[0].z) / max(r[0].w, 0.00001);
        let out = vec3(here.x, here.y, here.z) * through + mixed * (1.0 - through);
        return vec4(out.x, out.y, out.z, here.w);
    }
}
