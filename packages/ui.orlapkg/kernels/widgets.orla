// The widgets: each a function of its rectangle, its state, a theme and
// the pixel asked for, nothing outside its rectangle but its shadow. A
// widget's words are a row of a text's letters, `width` cells a row
// (`write.orla`). A screen lays them over one another (`over`).
use "layout.orla";
use "paint.orla";
use "write.orla";

/// How a screen's widgets look: the panels' fill and rim, the words'
/// ink and the dimmed, the accent of what is lit, a track's empty, the
/// warning, the corners' radius, the pixels a texel of text.
struct Theme {
    panel: Vec4; rim: Vec4; ink: Vec4; dim: Vec4; accent: Vec4; lit: Vec4; track: Vec4; warn: Vec4;
    radius: Float; scale: Float;
}

/// A dark theme with a rim of gold, a texel a pixel.
fn theme_dusk() -> Theme {
    return Theme {
        panel: vec4(0.06, 0.06, 0.08, 0.88), rim: vec4(0.78, 0.64, 0.36, 1.0),
        ink: vec4(0.9, 0.88, 0.82, 1.0), dim: vec4(0.55, 0.53, 0.5, 1.0),
        accent: vec4(1.0, 0.84, 0.5, 1.0), lit: vec4(0.85, 0.62, 0.25, 0.32),
        track: vec4(0.2, 0.2, 0.23, 1.0), warn: vec4(1.0, 0.4, 0.35, 1.0),
        radius: 3.0, scale: 1.0 };
}

/// A light theme: paper, ink, a blue accent.
fn theme_paper() -> Theme {
    return Theme {
        panel: vec4(0.95, 0.94, 0.91, 0.97), rim: vec4(0.55, 0.53, 0.5, 1.0),
        ink: vec4(0.12, 0.12, 0.14, 1.0), dim: vec4(0.5, 0.5, 0.52, 1.0),
        accent: vec4(0.16, 0.42, 0.85, 1.0), lit: vec4(0.16, 0.42, 0.85, 0.16),
        track: vec4(0.8, 0.79, 0.76, 1.0), warn: vec4(0.8, 0.2, 0.15, 1.0),
        radius: 4.0, scale: 1.0 };
}

/// What a widget is now: at rest, focused (lit by the navigation or
/// under the pointer), pressed, or not to be used.
fn idle() -> Int { return 0; }
fn focused() -> Int { return 1; }
fn pressed() -> Int { return 2; }
fn disabled() -> Int { return 3; }

/// A list's row's state: focused when `lit`, disabled unless `enabled`.
fn state_of(lit: Bool, enabled: Bool) -> Int {
    return if !enabled { disabled() } else if lit { focused() } else { idle() };
}

/// The ink of a widget's words in a state: dim when disabled, the accent
/// when focused or pressed.
fn state_ink(t: Theme, state: Int) -> Vec4 {
    return if state == disabled() { t.dim } else if state == idle() { t.ink } else { t.accent };
}

/// A panel: its shadow, its fill, its rim.
fn panel(t: Theme, r: Rect, q: Vec2) -> Vec4 {
    if !near_rect(r, q, 6.0) { return clear(); }
    let cast = shadow(r, t.radius, vec2(2.0, 3.0), 4.0, 0.45, q);
    return over(over(cast, fill(r, t.radius, t.panel, q)), outline(r, t.radius, 1.0, t.rim, q));
}

/// A panel with a title in its top, `scale` times the theme's, and a
/// rule under it.
fn titled_panel(t: Theme, letters: Grid<Float>, cells: Rows<Int>, title: Int, width: Int, r: Rect, scale: Float, q: Vec2) -> Vec4 {
    let base = panel(t, r, q);
    if !holds(r, q) { return base; }
    let s = t.scale * scale;
    let band = top_of(inset(r, 8.0), 8.0 * s + 6.0);
    let name = label(letters, cells, title, width, band, vec2(0.0, 0.5), s, t.accent, q);
    let rule = fill(Rect { lo: vec2(band.lo.x, band.hi.y + 2.0), hi: vec2(band.hi.x, band.hi.y + 3.0) }, 0.0, faded(t.rim, 0.5), q);
    return over(over(base, rule), name);
}

/// A row lit as the one chosen: a band of the accent and a mark at its
/// left.
fn highlight(t: Theme, r: Rect, q: Vec2) -> Vec4 {
    if !near_rect(r, q, 10.0) { return clear(); }
    let band = fill(r, t.radius, t.lit, q);
    return over(band, arrow(vec2(r.lo.x - 5.0, rect_middle(r).y), 7.0, 1, t.accent, q));
}

/// A button with its word in the middle.
fn push_button(t: Theme, letters: Grid<Float>, cells: Rows<Int>, row: Int, width: Int, r: Rect, state: Int, q: Vec2) -> Vec4 {
    if !near_rect(r, q, 6.0) { return clear(); }
    let down = if state == pressed() { vec2(0.0, 1.0) } else { vec2(0.0, 0.0) };
    let body = moved(r, down);
    let face = if state == pressed() { mix(t.panel, t.accent, 0.35) } else if state == focused() { mix(t.panel, t.accent, 0.2) } else { t.panel };
    let rim = if state == disabled() { t.dim } else if state == idle() { t.rim } else { t.accent };
    let cast = if state == pressed() { clear() } else { shadow(r, t.radius, vec2(0.0, 2.0), 2.0, 0.4, q) };
    let ink = if state == disabled() { t.dim } else if state == idle() { t.ink } else { t.accent };
    let word = label(letters, cells, row, width, body, vec2(0.5, 0.5), t.scale, ink, q);
    return over(over(over(cast, fill(body, t.radius, vec4(face.x, face.y, face.z, max(face.w, 0.9)), q)), outline(body, t.radius, 1.0, rim, q)), word);
}

/// A switch: a pill with its knob at the right and lit when on.
fn toggle(t: Theme, r: Rect, on: Bool, state: Int, q: Vec2) -> Vec4 {
    if !near_rect(r, q, 2.0) { return clear(); }
    let h = r.hi.y - r.lo.y;
    let body = fill(r, h * 0.5, if on { t.accent } else { t.track }, q);
    let rim = outline(r, h * 0.5, 1.0, if state == focused() { t.accent } else { t.rim }, q);
    let knob_at = if on { vec2(r.hi.x - h * 0.5, rect_middle(r).y) } else { vec2(r.lo.x + h * 0.5, rect_middle(r).y) };
    let knob = disc(knob_at, h * 0.5 - 2.0, if state == disabled() { t.dim } else { t.ink }, q);
    return over(over(body, rim), knob);
}

/// A box ticked when `checked`.
fn checkbox(t: Theme, r: Rect, checked: Bool, state: Int, q: Vec2) -> Vec4 {
    if !near_rect(r, q, 2.0) { return clear(); }
    let rim = outline(r, 2.0, 1.0, if state == focused() { t.accent } else { t.rim }, q);
    let inside = fill(inset(r, 1.0), 1.0, t.track, q);
    let mark = if checked { tick(r.lo, r.hi.x - r.lo.x, 2.0, t.accent, q) } else { clear() };
    return over(over(inside, rim), mark);
}

/// A slider at `value` (0 to 1): its track, filled to the value, and its
/// knob.
fn slider(t: Theme, r: Rect, value: Float, state: Int, q: Vec2) -> Vec4 {
    let h = r.hi.y - r.lo.y;
    if !near_rect(r, q, h) { return clear(); }
    let v = clamp(value, 0.0, 1.0);
    let mid = rect_middle(r).y;
    let track = Rect { lo: vec2(r.lo.x, mid - 2.0), hi: vec2(r.hi.x, mid + 2.0) };
    let x = r.lo.x + (r.hi.x - r.lo.x) * v;
    let filled = Rect { lo: track.lo, hi: vec2(x, track.hi.y) };
    let lit = state == focused() || state == pressed();
    let knob = over(disc(vec2(x, mid), h * 0.5, if lit { t.accent } else { t.ink }, q), ring(vec2(x, mid), h * 0.5, 1.0, t.rim, q));
    return over(over(fill(track, 2.0, t.track, q), fill(filled, 2.0, if state == disabled() { t.dim } else { t.accent }, q)), knob);
}

/// A bar filled to `full` (0 to 1) in `color`, and a paler stretch to
/// `trail` in `trail_color` where it has just fallen from: health, a
/// load, progress.
fn meter(t: Theme, r: Rect, full: Float, trail: Float, color: Vec4, trail_color: Vec4, q: Vec2) -> Vec4 {
    if !near_rect(r, q, 1.0) { return clear(); }
    let w = r.hi.x - r.lo.x;
    let inner = inset(r, 1.0);
    let case_ = fill(r, 1.0, vec4(0.0, 0.0, 0.0, 0.6), q);
    let lost = fill(Rect { lo: inner.lo, hi: vec2(inner.lo.x + (w - 2.0) * clamp(max(trail, full), 0.0, 1.0), inner.hi.y) }, 0.0, trail_color, q);
    let kept = fill(Rect { lo: inner.lo, hi: vec2(inner.lo.x + (w - 2.0) * clamp(full, 0.0, 1.0), inner.hi.y) }, 0.0, color, q);
    return over(over(over(case_, lost), kept), outline(r, 1.0, 1.0, faded(t.rim, 0.6), q));
}

/// A list's item: its word at the left, `scale` times the theme's,
/// banded and marked when focused, dim when disabled.
fn list_item(t: Theme, letters: Grid<Float>, cells: Rows<Int>, row: Int, width: Int, r: Rect, scale: Float, state: Int, q: Vec2) -> Vec4 {
    if !near_rect(r, q, 12.0) { return clear(); }
    let band = if state == focused() { highlight(t, r, q) } else { clear() };
    let named = label(letters, cells, row, width, inset2(r, vec2(6.0, 0.0)), vec2(0.0, 0.5), t.scale * scale, state_ink(t, state), q);
    return over(band, named);
}

/// Where an option's value stands in its row: the right 55%, room left
/// each side for the arrows.
fn option_value(r: Rect) -> Rect { return inset2(right_of(r, (r.hi.x - r.lo.x) * 0.55), vec2(14.0, 0.0)); }

/// An option's row but its value: the row banded and marked when
/// focused, and its name at the left. A screen draws a control of its
/// own in `option_value`.
fn option_name(t: Theme, letters: Grid<Float>, cells: Rows<Int>, name: Int, width: Int, r: Rect, state: Int, q: Vec2) -> Vec4 {
    let band = if state == focused() { highlight(t, r, q) } else { clear() };
    let left = inset2(left_of(r, (r.hi.x - r.lo.x) * 0.45), vec2(6.0, 0.0));
    return over(band, label(letters, cells, name, width, left, vec2(0.0, 0.5), t.scale, state_ink(t, state), q));
}

/// Arrows each side of an option's value, when focused.
fn option_arrows(t: Theme, r: Rect, state: Int, q: Vec2) -> Vec4 {
    if state != focused() { return clear(); }
    let right = option_value(r);
    return over(arrow(vec2(right.lo.x - 6.0, rect_middle(r).y), 7.0, 0, t.accent, q), arrow(vec2(right.hi.x + 6.0, rect_middle(r).y), 7.0, 1, t.accent, q));
}

/// An option: its name at the left, its value in the right 55%, and,
/// focused, arrows each side of the value to change it.
fn choice(t: Theme, letters: Grid<Float>, cells: Rows<Int>, name: Int, value: Int, width: Int, r: Rect, state: Int, q: Vec2) -> Vec4 {
    if !near_rect(r, q, 12.0) { return clear(); }
    let valued = label(letters, cells, value, width, option_value(r), vec2(0.5, 0.5), t.scale, state_ink(t, state), q);
    return over(over(option_name(t, letters, cells, name, width, r, state, q), valued), option_arrows(t, r, state, q));
}

/// An option whose value is a number.
fn choice_number(t: Theme, letters: Grid<Float>, cells: Rows<Int>, name: Int, value: Int, width: Int, r: Rect, state: Int, q: Vec2) -> Vec4 {
    if !near_rect(r, q, 12.0) { return clear(); }
    let valued = number(letters, value, option_value(r), vec2(0.5, 0.5), t.scale, state_ink(t, state), q);
    return over(over(option_name(t, letters, cells, name, width, r, state, q), valued), option_arrows(t, r, state, q));
}

/// An option that is on or off: its name, and a switch at the left of
/// the value's place.
fn switch_choice(t: Theme, letters: Grid<Float>, cells: Rows<Int>, name: Int, width: Int, on: Bool, r: Rect, state: Int, q: Vec2) -> Vec4 {
    if !near_rect(r, q, 12.0) { return clear(); }
    let pill = placed(option_value(r), vec2(22.0, 10.0), vec2(0.0, 0.5));
    return over(option_name(t, letters, cells, name, width, r, state, q), toggle(t, pill, on, state, q));
}

/// A scroll bar down `r`: `shown` rows of `total` from `first`.
fn scrollbar(t: Theme, r: Rect, first: Int, shown: Int, total: Int, q: Vec2) -> Vec4 {
    if !holds(r, q) || total <= shown { return clear(); }
    let h = r.hi.y - r.lo.y;
    let n = float(max(total, 1));
    let thumb = Rect { lo: vec2(r.lo.x, r.lo.y + h * float(first) / n), hi: vec2(r.hi.x, r.lo.y + h * float(min(first + shown, total)) / n) };
    let w = (r.hi.x - r.lo.x) * 0.5;
    return over(fill(r, w, t.track, q), fill(thumb, w, t.dim, q));
}

/// A line across `r`'s middle.
fn rule(t: Theme, r: Rect, q: Vec2) -> Vec4 {
    let y = floor(rect_middle(r).y);
    return if holds(r, q) && floor(q.y) == y { faded(t.rim, 0.5) } else { clear() };
}

// ---------------------------------------------------------------- prompts

/// How wide a key's cap is for its word.
fn cap_width(cells: Rows<Int>, row: Int, width: Int, scale: Float) -> Float { return row_width(cells, row, width, scale) + 8.0 * scale; }

/// A key's cap with its word, its left middle at `origin`: a key's pale,
/// square; a pad's other buttons' dark and round (`key` false).
fn key_cap(t: Theme, letters: Grid<Float>, cells: Rows<Int>, row: Int, width: Int, key: Bool, origin: Vec2, q: Vec2) -> Vec4 {
    let s = t.scale;
    let r = Rect { lo: origin - vec2(0.0, 6.0 * s), hi: origin + vec2(cap_width(cells, row, width, s), 6.0 * s) };
    if !near_rect(r, q, 2.0) { return clear(); }
    let body = if key { vec4(0.86, 0.84, 0.78, 1.0) } else { vec4(0.1, 0.1, 0.12, 1.0) };
    let edge = if key { vec4(0.45, 0.43, 0.4, 1.0) } else { vec4(0.7, 0.62, 0.42, 1.0) };
    let ink = if key { vec4(0.1, 0.1, 0.12, 1.0) } else { vec4(0.95, 0.93, 0.88, 1.0) };
    let word = written(letters, cells, row, width, q, origin + vec2(4.0 * s, -4.0 * s), s, ink);
    return over(over(fill(r, if key { 2.0 } else { 6.0 * s }, body, q), outline(r, if key { 2.0 } else { 6.0 * s }, 1.0, edge, q)), word);
}

/// A pad's face button, round, in its colour with its letter: 0 south
/// (A, green), 1 east (B, red), 2 west (X, blue), 3 north (Y, yellow).
fn face_button(letters: Grid<Float>, face: Int, middle: Vec2, radius: Float, q: Vec2) -> Vec4 {
    if length(q - middle) > radius + 1.0 { return clear(); }
    let hue = match face { 0 => vec3(0.42, 0.8, 0.3), 1 => vec3(0.92, 0.3, 0.25), 2 => vec3(0.3, 0.56, 0.98), _ => vec3(0.98, 0.8, 0.25) };
    let code = match face { 0 => 65, 1 => 66, 2 => 88, _ => 89 };
    let ink = letter_cover(letters, code, floor(q - middle) + vec2(3.0, 4.0));
    let body = over(disc(middle, radius, vec4(0.09, 0.09, 0.11, 1.0), q), ring(middle, radius, 1.5, paint(hue * 0.9, 1.0), q));
    return over(body, paint(hue * 1.1, ink));
}

/// A face button and its word at its right: what a button does now.
fn prompt(t: Theme, letters: Grid<Float>, cells: Rows<Int>, row: Int, width: Int, face: Int, origin: Vec2, q: Vec2) -> Vec4 {
    let s = t.scale;
    let button_ = face_button(letters, face, origin + vec2(6.0, 0.0), 6.0, q);
    let word = shadowed(letters, cells, row, width, q, origin + vec2(16.0, -4.0 * s), s, t.ink, 0.7);
    return over(button_, word);
}
