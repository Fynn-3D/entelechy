//! Filters a row, stream compaction: flags in (non-zero keeps an
//! element), the kept elements' indices gathered to the front and their
//! count out. Place it with
//!   node kept: graph "parallel.entpkg/graphs/compact.esn" {
//!       flags <- visible.result;
//!   }
//! and size what does the work with
//!   domain = value(count) * per_thing;
//! reading `kept.indices` to know which thing each element belongs to.
use "../kernels/compact.ent";

input flags: Rows<Int>;

node blank: parallel.compact_blank@1 { flags <- flags; }
node offsets: parallel.compact_offsets@1 { flags <- flags; }
node gathered: parallel.compact_gather@1 {
    flags <- flags;
    offsets <- offsets.result;
    slots <- blank.result;
}
node total: parallel.compact_total@1 { flags <- flags; }

output indices <- gathered.result;
output count <- total.result;
