// Runs: a list of entries for each of a row of owners, laid in one row
// owner after owner. A Kernel counts each owner's entries; a prefix sum
// says where each owner's run ends; the last end is how many entries
// there are, which sizes the row; and a scatter fills each owner's run,
// walking what it counted, `emit`ting each entry at the run's start plus
// its rank. A Kernel reading an entry finds its owner by `owner`.
//
// `graphs/runs.esn` is the three steps after the count.

/// Where each owner's run ends: an inclusive prefix sum of the counts, so
/// owner `i`'s run is `ends[i] - counts[i]` up to `ends[i]`.
kernel parallel.runs_ends@1 {
    requires { field.read; field.write; }
    input counts: Rows<Int>;
    output result: Rows<Int>;
    prefix with sum { return sample(counts); }
}

/// How many entries the runs hold, as a row of one that a `domain` reads
/// (`domain = value(entries)`): at least one, so the row they are laid
/// in is never empty.
kernel parallel.runs_entries@1 {
    requires { field.read; field.write; }
    input ends: Rows<Int>;
    output result: Rows<Int>;
    compute { return max(at(ends, count(ends) - 1), 1); }
}

/// The row the runs are laid in, every slot -1 until a scatter fills it
/// with `max`: an entry is never negative, so a slot is what landed in it
/// or the -1 that says nothing did.
kernel parallel.runs_slots@1 {
    requires { field.read; field.write; }
    input entries: Rows<Int>;
    output result: Rows<Int>;
    compute { return -1; }
}

// The owner whose run holds entry `e`: the first whose end is past it, by
// bisection over the ends.
fn owner(e: Int, ends: Rows<Int>) -> Int {
    let found = loop 32 with r = ivec2(0, count(ends)) until r.x >= r.y {
        let mid = (r.x + r.y) / 2;
        if at(ends, mid) > e { ivec2(r.x, mid) } else { ivec2(mid + 1, r.y) }
    };
    return found.x;
}

// A walk over `n` things, more than one loop counts, in two loops: the
// outer runs `rounds(n)` times, and its round `r` runs `round_of(n, r)`
// of 65536, thing `r * 65536 + index()`.
fn rounds(n: Int) -> Int { return (n + 65535) / 65536; }
fn round_of(n: Int, r: Int) -> Int { return clamp(n - r * 65536, 0, 65536); }
