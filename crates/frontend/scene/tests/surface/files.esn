// Inputs the Host reads for the scene: a file it watches, text, bytes,
// and a directory frame by frame.
input atlas: Image = "atlas.ppm";
input narrow: Grid<Vec4 as unorm8> = "photo.png";
input song: Rows<Float> = "song.wav";
input title: Rows<Int> = text "ENTELECHY";
input level: Rows<Int> = bytes "level.bin";
input clip: Image = frames "clip/" at 30;

node show: image.show@1 {
    atlas <- atlas;
    title <- title;
    level <- level;
    clip <- clip;
}

output result <- show.result;
