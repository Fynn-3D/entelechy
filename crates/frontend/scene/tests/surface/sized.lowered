language 3
// sized
param size: Int = 16;

node literal.blank: tile.blank@1 {
    value = 0.5;
    domain = vec2(4, 8);
}

node passed.blank: tile.blank@1 {
    value = 1.0;
    domain = vec2(size, size * 2);
}

node defaulted.blank: tile.blank@1 {
    value = 1.0;
    domain = vec2(8, 16);
}

output result <- literal.blank.result;
