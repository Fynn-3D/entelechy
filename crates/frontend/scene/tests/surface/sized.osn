// A placed graph sized by its own parameters: given a number, given the
// parent's parameter, and left at its default.
param size: Int = 16;

node literal: graph "parts/tile.osn" {
    side = 4;
    fill = 0.5;
}

node passed: graph "parts/tile.osn" {
    side = size;
}

node defaulted: graph "parts/tile.osn" { }

output result <- literal.result;
