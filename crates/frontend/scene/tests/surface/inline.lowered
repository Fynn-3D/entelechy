language 2
// inline
param decay: Float = 0.9;

node source: image.gradient@1 {
    domain = vec2(16, 16);
}

node trail: inline.trail@1 {
    current <- source.result;
    previous <~ trail.result from source.result;
    fade = decay;
}

node glow: fx.glow@1 {
    source <- trail.result;
}

node lit: fx.glow@1 {
    source <- glow.result;
}

output result <- lit.result;
