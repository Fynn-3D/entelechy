language 1
// wiring
input photo: Image;
param amount: Float = 1.0;
param origin: Vec2 = vec2(0.5, -0.25);
param count: Int = 3;
param on: Bool = true;
param exact: Double = 500000.123456789;

node gray: image.grayscale@1 {
    source <- photo;
    amount = amount;
}

node shaped: image.shape@1 {
    source <- gray.result;
    corner = vec4(0.0, 0.0, 1.0, 1.0);
    enabled = false;
    gain = 2;
    offset = -0.5;
    record = [vec3(0.0, 1.0, 0.0), 2];
    steps = count;
    tint = vec3(1.0, 0.5, 0.25);
}

node scan: image.blur@1 {
    source <- shaped.result;
}

output result <- scan.result;
output gray <- gray.result;
// use kernels directory
// use ../shared/tonemap.ent
