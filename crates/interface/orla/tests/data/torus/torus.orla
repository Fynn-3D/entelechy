// A torus as rows of vertices and triangles, subdivided, projected and
// shaded: what the Blender bridge's session pulls and watches.
struct Vertex { clip: Vec4; normal: Vec3; uv: Vec2; }
struct Tri { a: Int; b: Int; c: Int; }
struct Surface { depth: Float; normal: Vec3; uv: Vec2; id: Int; }
type Vertices = Rows<Vertex>;
type Triangles = Rows<Tri>;
type GBuffer = Grid<Surface>;

/// One vertex per element over a segments x rings lattice, in the xz
/// plane (`clip.w` is 1 until projection).
kernel torus.vertices@1 {
    requires { field.write; }
    param segments: Int = 48;
    param rings: Int = 24;
    output result: Vertices;
    compute {
        let i = element();
        let ring = i / segments;
        let seg = i - ring * segments;
        let u = float(seg) / float(segments);
        let v = float(ring) / float(rings);
        let a = u * 6.2831853;
        let b = v * 6.2831853;
        let radial = vec3(cos(a) * cos(b), sin(b), sin(a) * cos(b));
        let p = vec3(cos(a), 0.0, sin(a)) + radial * 0.4;
        return Vertex { clip: vec4(p.x, p.y, p.z, 1.0), normal: radial, uv: vec2(u, v) };
    }
}

/// Two triangles per lattice cell, wrapping in both directions.
kernel torus.faces@1 {
    requires { field.write; }
    param segments: Int = 48;
    param rings: Int = 24;
    output result: Triangles;
    compute {
        let cell = element() / 2;
        let ring = cell / segments;
        let seg = cell - ring * segments;
        let seg1 = if seg + 1 == segments { 0 } else { seg + 1 };
        let ring1 = if ring + 1 == rings { 0 } else { ring + 1 };
        let v00 = ring * segments + seg;
        let v10 = ring * segments + seg1;
        let v01 = ring1 * segments + seg;
        let v11 = ring1 * segments + seg1;
        return if element() == cell * 2 {
            Tri { a: v00, b: v10, c: v11 }
        } else {
            Tri { a: v00, b: v11, c: v01 }
        };
    }
}

/// The originals, then three edge midpoints a triangle.
kernel torus.split_vertices@1 {
    requires { field.read; field.write; }
    input mesh: Vertices;
    input faces: Triangles;
    output result: Vertices;

    fn midpoint(a: Vertex, b: Vertex) -> Vertex {
        return Vertex {
            clip: (a.clip + b.clip) * 0.5,
            normal: normalize(a.normal + b.normal),
            uv: (a.uv + b.uv) * 0.5
        };
    }

    compute {
        let i = element();
        let originals = count(mesh);
        return if i < originals {
            at(mesh, i)
        } else {
            let k = i - originals;
            let t = at(faces, k / 3);
            let edge = k - (k / 3) * 3;
            if edge == 0 { midpoint(at(mesh, t.a), at(mesh, t.b)) }
            else if edge == 1 { midpoint(at(mesh, t.b), at(mesh, t.c)) }
            else { midpoint(at(mesh, t.c), at(mesh, t.a)) }
        };
    }
}

kernel torus.split_faces@1 {
    requires { field.read; field.write; }
    input mesh: Vertices;
    input faces: Triangles;
    output result: Triangles;
    compute {
        let i = element();
        let t = at(faces, i / 4);
        let corner = i - (i / 4) * 4;
        let base = count(mesh) + (i / 4) * 3;
        return if corner == 0 { Tri { a: t.a, b: base, c: base + 2 } }
            else if corner == 1 { Tri { a: base, b: t.b, c: base + 1 } }
            else if corner == 2 { Tri { a: base + 2, b: base + 1, c: t.c } }
            else { Tri { a: base, b: base + 1, c: base + 2 } };
    }
}

/// Tilted towards the eye and projected, depth over [0, 1].
kernel torus.project@1 {
    requires { field.read; field.write; }
    input mesh: Vertices;
    param tilt: Float = 0.55;
    output result: Vertices;
    compute {
        let v = sample(mesh);
        let p = vec3(v.clip.x, v.clip.y * cos(tilt) - v.clip.z * sin(tilt),
                     v.clip.y * sin(tilt) + v.clip.z * cos(tilt));
        let n = vec3(v.normal.x, v.normal.y * cos(tilt) - v.normal.z * sin(tilt),
                     v.normal.y * sin(tilt) + v.normal.z * cos(tilt));
        let z = p.z - 3.2;
        let f = 2.1445;
        let near = 0.1;
        let far = 10.0;
        let clip = vec4(p.x * f / 1.3333, p.y * f,
                        z * far / (near - far) + near * far / (near - far), 0.0 - z);
        return Vertex { clip: clip, normal: n, uv: v.uv };
    }
}

/// Lambert where a triangle landed, a flat sky elsewhere.
kernel torus.shade@1 {
    requires { field.read; field.write; }
    input surface: GBuffer;
    output result: Image;
    compute {
        let s = sample(surface);
        let lit = 0.15 + 0.85 * max(dot(normalize(s.normal), normalize(vec3(0.4, 0.8, 0.5))), 0.0);
        let color = if s.id < 0 { vec3(0.1, 0.1, 0.15) } else { vec3(0.9, 0.55, 0.25) * lit };
        return vec4(color.x, color.y, color.z, 1.0);
    }
}
