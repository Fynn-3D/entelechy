// One level of midpoint subdivision: every triangle becomes four.
use "torus.orla";

input mesh: Vertices;
input faces: Triangles;

node vertices: torus.split_vertices@1 { mesh <- mesh; faces <- faces; domain = count(mesh) + 3 * count(faces); }
node triangles: torus.split_faces@1 { mesh <- mesh; faces <- faces; domain = 4 * count(faces); }

output vertices <- vertices.result;
output triangles <- triangles.result;
