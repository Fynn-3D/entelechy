//! A graph placed as a node: its input wired by the scene that places
//! it, its param set there, its output read as `node.output`.
use "step.orla";
input value: Rows<Float>;
param by: Float = 1.0;
node once: steps.inc@1 { value <- value; }
node scaled: kernel {
    requires { field.read; field.write; }
    input counted: Rows<Float> <- once.result;
    param by: Float = by;
    output result: Rows<Float>;
    compute { return sample(counted) * by; }
}
output result <- scaled.result;
