// The session the Blender bridge talks to: a torus and its faces, a
// placed sub-graph subdividing them `level` times, and a 320 x 240
// picture of the result.
use "torus.ent";

param level: Int = 1;

node torus: torus.vertices@1 { domain = 1152; }  // 48 segments x 24 rings
node faces: torus.faces@1 { domain = 2304; }     // two triangles per cell
node subdivided: graph "level.esn" {
    times = level;
    carry mesh <- vertices;
    carry faces <- triangles;
    mesh <- torus.result;
    faces <- faces.result;
}
node project: torus.project@1 { mesh <- subdivided.vertices; }
node raster: native.rasterize@1 {
    vertices <- project.result;
    triangles <- subdivided.triangles;
    domain = vec2(320, 240);
}
node view: torus.shade@1 { surface <- raster.surface; }

output result <- view.result;
