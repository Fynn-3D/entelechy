scene ../parts/exposure/scene.esn

# At time 0 the sun sits at the top center. Auto-exposure pulls the frame
# to a mean luma of 0.3 before the roll-off, so the sun's core tone-maps
# to about 0.8 and the ground stays dark. Both backends agree exactly.
frame 0.0
expect 160 84 = 0.8 0.792 0.765 0.02
expect 300 20 = 0.125 0.153 0.196 0.02
expect 20 220 = 0.024 0.039 0.082 0.02
expect 160 200 = 0.035 0.051 0.098 0.02
