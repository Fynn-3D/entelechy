scene skirmish.osn

# Sixty frames a second. The cursor starts on unit 0 at (1, 4); unit 1 at
# (2, 5) stands next to enemy 0 at (3, 5). Keys are held for one frame.
frame 0.0167
expect game.result[0].phase = 0
expect units.result[4].x = 3
expect units.result[4].y = 5

# Down and right put the cursor on unit 1; Z selects it, Z again keeps it in place.
key 40 down
frame 0.0333
key 40 up
frame 0.0500
key 39 down
frame 0.0667
key 39 up
frame 0.0833
key 90 down
frame 0.1000
key 90 up
frame 0.1167
expect game.result[0].phase = 1
expect game.result[0].selected = 1
key 90 down
frame 0.1333
key 90 up
frame 0.1500
expect game.result[0].phase = 2

# Right puts the cursor on enemy 0; Z strikes: 5 attack against 2 defense.
key 39 down
frame 0.1667
key 39 up
frame 0.1833
key 90 down
frame 0.2000
key 90 up
frame 0.2167
expect game.result[0].phase = 0
expect units.result[4].hp = 7
expect units.result[1].moved = true
expect music.result[0].hit = 0.8957 0.002    # the strike started the hit last frame; one block later it has decayed by 800/7680
expect music.result[799].count = 10399       # thirteen blocks of 800 frames, none skipped

# Enter ends the turn; the enemies act one by one on timers and strike back.
