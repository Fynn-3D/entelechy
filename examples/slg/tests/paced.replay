scene paced.esn

# 48000 samples a second, no device. The first block starts a first
# block's length (1600) behind the time.
frame 0.0167
expect clock.result[0].n = 0

# Thirteen hours in, more samples than an Int holds: after the stall the
# clock takes up the time again, a first block behind it.
frame 46800
expect clock.result[0].n = 2246398400

# The next frame counts on by the block it played.
frame 46800.0167
expect clock.result[0].n = 2246400000
