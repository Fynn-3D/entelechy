// Six relaxation passes over a seeded range, one node placed six times,
// each pass carrying the range on: placed once for how far the acting
// unit can go, twice more for how far every cell is from the prey.
use "kernels/";

input start: Grid<Int>;
input map: Grid<Tile>;
input units: Rows<Unit>;
input game: Rows<Game>;

node pass: slg.relax@1 {
    times = 6;
    carry previous <- result;
    previous <- start; map <- map; units <- units; game <- game;
}

output result <- pass.result;
