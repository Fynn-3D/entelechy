// Six of the math package's relaxation passes over a seeded range, one
// node placed six times, each pass carrying the range on, over what each
// cell costs this frame: placed once for how far the acting unit can go,
// twice more for how far every cell is from the prey.
use "kernels/";
use "../../packages/navigation.entpkg";

input start: Grid<Int>;
input map: Grid<Tile>;
input units: Rows<Unit>;
input game: Rows<Game>;

node cost: slg.costs@1 { map <- map; units <- units; game <- game; }
node pass: navigation.relax@1 {
    times = 6;
    blocked = 999;
    carry previous <- result;
    previous <- start; cost <- cost.result;
}

output result <- pass.result;
