// The music: a chiptune loop and a hit sound, as one row of stereo frames
// per evaluation. The sequencer's step comes from the synth package's
// clock, carried across blocks through Graph state, so the tune never
// skips; the hit sound starts when the rules issue a strike, so the sound
// follows the game rather than the picture.
// The game's state row is declared once, in slg.ent; `use` brings the
// declaration here so `order` is read from the same layout.
use "slg.ent";
use "../../../packages/synth.entpkg";

struct Tone { left: Float; right: Float; count: Long; lead: Float; bass: Float; hit: Float; }
type Music = Rows<Tone>;

kernel bgm.silence@1 {
    requires { field.write; }
    output result: Music;
    compute { return Tone { left: 0.0, right: 0.0, count: -1l, lead: 0.0, bass: 0.0, hit: 0.0 }; }
}

kernel bgm.play@1 {
    requires { field.read; field.write; time.read; }
    input previous: Music;
    input clock: Clocks;
    input game: Rows<Game>;
    param tempo: Float = 8.0;      // steps per second
    param gain: Float = 0.12;
    output result: Music;

    // A sixteen-step melody in semitones above A3, and a bass line under it.
    fn lead_note(step: Int) -> Float {
        return [0.0, 4.0, 7.0, 12.0, 7.0, 4.0, 0.0, 2.0, 4.0, 7.0, 9.0, 12.0, 9.0, 7.0, 4.0, 2.0][step % 16];
    }

    // A bar each of A2, C#3, E3 and D3.
    fn bass_note(step: Int) -> Float {
        return [-12.0, -8.0, -5.0, -7.0][(step / 4) % 4];
    }

    fn pitch(semitones: Float) -> Float {
        return 220.0 * pow(2.0, semitones / 12.0);
    }

    compute {
        let last = at(previous, count(previous) - 1);
        let n = at(clock, 0).n + long(element());
        let t = float(n) / hz();
        let step = int(floor(t * tempo));
        let within = fract(t * tempo);
        // Phases advance from the last block's, so notes carry across blocks.
        let lead = fract(last.lead + float(element() + 1) * pitch(lead_note(step)) / hz());
        let bass = fract(last.bass + float(element() + 1) * pitch(bass_note(step)) / hz());
        let square = if lead < 0.5 { 1.0 } else { -1.0 };
        let triangle = abs(bass * 4.0 - 2.0) - 1.0;
        let envelope = 1.0 - within * 0.6;
        // A strike this frame starts the hit: noise that dies in a sixth of a second.
        let g = at(game, 0);
        let hit_start = if g.order == Order.Attack { 1.0 } else { last.hit };
        let hit = max(hit_start - float(element() + 1) / (hz() * 0.16), 0.0);
        let noise = white(n, 3) * hit * hit;
        let mixed = (square * envelope * 0.5 + triangle * 0.4) * gain + noise * 0.25;
        return Tone { left: mixed, right: mixed * 0.9 + noise * 0.05, count: n, lead: lead, bass: bass, hit: hit };
    }
}

/// The stereo frames the sound card takes.
kernel bgm.stereo@1 {
    requires { field.read; field.write; }
    input music: Music;
    output result: Rows<Vec2>;
    compute { let m = sample(music); return vec2(m.left, m.right); }
}
