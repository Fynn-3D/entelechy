// A small tactics game in the NES manner. One row of state holds the turn
// machine, one row of units holds the armies, a grid holds the terrain,
// and the movement range is six of the grid package's passes over it. The
// rules only issue orders; the unit row applies them; the picture is the
// last node. Arrows move the cursor, Z confirms, X cancels, Enter ends
// the turn.
type Terrain = enum { Grass, Forest, Mountain, Water, Fort };
type Team = enum { Player, Enemy };
// The turn: the player picks a unit, its destination and its target;
// then each enemy is chosen, moves and strikes; until one side is gone.
type Phase = enum { Pick, Destination, Target, Choose, Moving, Striking, Won, Lost };
// What the unit row applies this frame.
type Order = enum { None, Move, Attack, Wait, NewTurn };
struct Tile { kind: Terrain; cost: Int; }
struct Unit {
    x: Int; y: Int;
    team: Team;
    hp: Int; attack: Int; defense: Int; move: Int;
    moved: Bool; alive: Bool;
}
struct Game {
    phase: Phase;
    cx: Int; cy: Int;  // cursor
    selected: Int;     // acting unit, or -1
    order: Order;
    ox: Int; oy: Int;  // move destination
    target: Int;       // attack target
    turn: Int;
    timer: Int;        // frames left in an enemy animation
    held: Int;         // key bits held last frame, for edges
    prey: Int;         // the player unit the acting enemy walks toward
}
type Map = Grid<Tile>;
type Units = Rows<Unit>;
type State = Rows<Game>;
type Range = Grid<Int>;

/// Terrain: a river down the middle with two fords, forests and peaks
/// scattered by a hash, forts at both camps.
kernel slg.map@1 {
    requires { field.write; }
    output result: Map;

    fn hash(p: Vec2) -> Float {
        let q = fract(p * vec2(0.1031, 0.1030));
        let d = dot(q, q.yx + 33.33);
        let r = q + d;
        return fract((r.x + r.y) * (r.x - r.y + 1.0));
    }

    compute {
        let c = coord();
        let x = int(c.x);
        let y = int(c.y);
        let h = hash(c);
        let river = x == 8 && y != 3 && y != 8;
        let fort = (x == 1 && y == 5) || (x == 14 && y == 6);
        let kind = if river { Terrain.Water } else if fort { Terrain.Fort }
            else if h < 0.12 { Terrain.Mountain } else if h < 0.35 { Terrain.Forest } else { Terrain.Grass };
        let cost = match kind { Terrain.Water => 99, Terrain.Mountain => 3, Terrain.Forest => 2, _ => 1 };
        return Tile { kind: kind, cost: cost };
    }
}

/// Two armies of four: the player on the left, the enemy on the right.
kernel slg.spawn@1 {
    requires { field.write; }
    param enemy_x: Int = 13;
    output result: Units;
    compute {
        let i = element();
        let player = i < 4;
        let k = i % 4;
        return Unit {
            x: if player { 1 + k % 2 } else { enemy_x + k % 2 },
            y: 4 + k + int(!player),
            team: if player { Team.Player } else { Team.Enemy },
            hp: 10,
            attack: if k == 0 { 7 } else { 5 },
            defense: if k == 3 { 3 } else { 2 },
            move: if k == 1 { 5 } else { 4 },
            moved: false,
            alive: true
        };
    }
}

/// Where a game begins: the cursor on the first unit, turn one.
kernel slg.begin@1 {
    requires { field.write; }
    output result: State;
    compute {
        return Game { phase: Phase.Pick, cx: 1, cy: 4, selected: -1, order: Order.None, ox: 0, oy: 0, target: -1, turn: 1, timer: 0, held: 0, prey: -1 };
    }
}

/// A range's first pass: zero at one unit, unreachable elsewhere. `who`
/// picks the unit: 0 the acting unit, 1 the enemy's prey, so the same
/// passes measure both how far a unit can go and how far the prey is.
kernel slg.seed@1 {
    requires { field.read; field.write; }
    input game: State;
    input units: Units;
    param who: Int = 0;
    output result: Range;
    compute {
        let g = at(game, 0);
        let index = if who == 0 { g.selected } else { g.prey };
        let c = coord();
        let here = vec2(int(c.x), int(c.y));
        return if index >= 0 {
            let u = at(units, index);
            if here == vec2(u.x, u.y) { 0 } else { 999 }
        } else { 999 };
    }
}

/// What each cell costs to enter, for the grid package's passes: its
/// tile's cost, or 999, not entered, where a unit of the other team
/// stands; friends may be passed through. Water costs 99, so a walk to the
/// prey crosses a river where it has to.
kernel slg.costs@1 {
    requires { field.read; field.write; }
    input map: Map;
    input units: Units;
    input game: State;
    output result: Range;

    fn blocked(x: Int, y: Int, team: Team) -> Bool {
        return loop 16 with hit = false until index() >= count(units) {
            let u = at(units, index());
            hit || (u.alive && u.team != team && u.x == x && u.y == y)
        };
    }

    compute {
        let g = at(game, 0);
        let c = coord();
        let team = if g.selected >= 0 { at(units, g.selected).team } else { Team.Player };
        return if blocked(int(c.x), int(c.y), team) { 999 } else { sample(map).cost };
    }
}

/// Nothing reachable: what the rules read before any range exists.
kernel slg.blank@1 {
    requires { field.write; }
    output result: Range;
    compute { return 999; }
}

/// The turn machine. It reads last frame's units and range, the keys and
/// the clock, and writes an order for the unit row to apply this frame.
kernel slg.game@1 {
    requires { field.read; field.write; input.read; }
    input previous: State;
    input units: Units;
    input range: Range;
    input hunt: Range;
    input map: Map;
    output result: State;

    fn bit(mask: Int, k: Int) -> Bool {
        return (mask >> k) & 1 == 1;
    }

    fn unit_at(x: Int, y: Int) -> Int {
        return loop 16 with found = -1 until index() >= count(units) {
            let u = at(units, index());
            if found < 0 && u.alive && u.x == x && u.y == y { index() } else { found }
        };
    }

    fn alive_of(team: Team) -> Int {
        return loop 16 with n = 0 until index() >= count(units) {
            let u = at(units, index());
            if u.alive && u.team == team { n + 1 } else { n }
        };
    }

    fn next_ready(team: Team) -> Int {
        return loop 16 with found = -1 until index() >= count(units) {
            let u = at(units, index());
            if found < 0 && u.alive && u.team == team && !u.moved { index() } else { found }
        };
    }

    fn nearest_foe(x: Int, y: Int, team: Team) -> Int {
        return loop 16 with best = -1 until index() >= count(units) {
            let u = at(units, index());
            let d = abs(u.x - x) + abs(u.y - y);
            let bd = if best < 0 { 999 } else { abs(at(units, best).x - x) + abs(at(units, best).y - y) };
            if u.alive && u.team != team && d < bd { index() } else { best }
        };
    }

    fn adjacent_foe(x: Int, y: Int, team: Team) -> Int {
        let a = unit_at(x - 1, y);
        let b = unit_at(x + 1, y);
        let c = unit_at(x, y - 1);
        let d = unit_at(x, y + 1);
        let foe = if a >= 0 && at(units, a).team != team { a }
            else if b >= 0 && at(units, b).team != team { b }
            else if c >= 0 && at(units, c).team != team { c }
            else if d >= 0 && at(units, d).team != team { d }
            else { -1 };
        return foe;
    }

    compute {
        let g = sample(previous);
        let extent = size(map);
        let w = int(extent.x);
        let h = int(extent.y);
        // Keys as bits: left, up, right, down, Z, X, Enter. An edge is a
        // key held now that was not held last frame.
        let keys = [37, 38, 39, 40, 90, 88, 13];
        let now = loop 7 with m = 0 { m | int(key(keys[index()])) << index() };
        let left = bit(now, 0) && !bit(g.held, 0);
        let up = bit(now, 1) && !bit(g.held, 1);
        let right = bit(now, 2) && !bit(g.held, 2);
        let down = bit(now, 3) && !bit(g.held, 3);
        let confirm = bit(now, 4) && !bit(g.held, 4);
        let cancel = bit(now, 5) && !bit(g.held, 5);
        let end_turn = bit(now, 6) && !bit(g.held, 6);
        let cx = clamp(g.cx + int(right) - int(left), 0, w - 1);
        let cy = clamp(g.cy + int(down) - int(up), 0, h - 1);
        // An order names `selected` for the unit row this frame; the
        // selection clears on the next quiet frame of picking.
        let base = Game { ..g, cx: cx, cy: cy, order: Order.None, held: now, selected: if g.phase == Phase.Pick && g.order != Order.None { -1 } else { g.selected } };
        let players = alive_of(Team.Player);
        let enemies = alive_of(Team.Enemy);
        // A game that is over stays over; one side gone ends it.
        if g.phase == Phase.Won || g.phase == Phase.Lost { return base; }
        if enemies == 0 { return Game { ..base, phase: Phase.Won }; }
        if players == 0 { return Game { ..base, phase: Phase.Lost }; }
        return match g.phase {
            Phase.Pick => {
                let under = unit_at(cx, cy);
                if end_turn {
                    Game { ..base, phase: Phase.Choose, selected: -1 }
                } else if confirm && under >= 0 && at(units, under).team == Team.Player && !at(units, under).moved {
                    Game { ..base, phase: Phase.Destination, selected: under }
                } else { base }
            },
            Phase.Destination => {
                let u = at(units, g.selected);
                let reach = at(range, vec2(cx, cy));
                let occupant = unit_at(cx, cy);
                if cancel {
                    Game { ..base, phase: Phase.Pick, selected: -1 }
                } else if confirm && reach <= u.move && (occupant < 0 || occupant == g.selected) {
                    Game { ..base, phase: Phase.Target, order: Order.Move, ox: cx, oy: cy }
                } else { base }
            },
            Phase.Target => {
                let u = at(units, g.selected);
                let foe = unit_at(cx, cy);
                let adjacent = abs(u.x - cx) + abs(u.y - cy) == 1;
                if confirm && foe >= 0 && at(units, foe).team == Team.Enemy && adjacent {
                    Game { ..base, phase: Phase.Pick, order: Order.Attack, target: foe }
                } else if confirm || cancel {
                    Game { ..base, phase: Phase.Pick, order: Order.Wait }
                } else { base }
            },
            Phase.Choose => {
                let who = next_ready(Team.Enemy);
                if who < 0 {
                    Game { ..base, phase: Phase.Pick, order: Order.NewTurn, selected: -1, turn: g.turn + 1 }
                } else {
                    let u = at(units, who);
                    Game { ..base, phase: Phase.Moving, selected: who, prey: nearest_foe(u.x, u.y, Team.Enemy), timer: 12, cx: u.x, cy: u.y }
                }
            },
            Phase.Moving => {
                // Both ranges were seeded last frame; give the passes a
                // moment, then step to the reachable cell with the shortest
                // walk to the prey, rivers and all.
                let u = at(units, g.selected);
                if g.timer > 0 {
                    Game { ..base, timer: g.timer - 1 }
                } else {
                    let best = loop 256 with pick = u.y * w + u.x until index() >= w * h {
                        let x = index() % w;
                        let y = index() / w;
                        let reach = at(range, vec2(x, y));
                        let free = unit_at(x, y) < 0 || (x == u.x && y == u.y);
                        let walk = at(hunt, vec2(x, y));
                        let best_walk = at(hunt, vec2(pick % w, pick / w));
                        if reach <= u.move && free && walk < best_walk { index() } else { pick }
                    };
                    Game { ..base, phase: Phase.Striking, order: Order.Move, ox: best % w, oy: best / w, cx: best % w, cy: best / w, timer: 12 }
                }
            },
            Phase.Striking => {
                let u = at(units, g.selected);
                if g.timer > 0 {
                    Game { ..base, timer: g.timer - 1 }
                } else {
                    let foe = adjacent_foe(u.x, u.y, Team.Enemy);
                    if foe >= 0 {
                        Game { ..base, phase: Phase.Choose, order: Order.Attack, target: foe, cx: at(units, foe).x, cy: at(units, foe).y }
                    } else {
                        Game { ..base, phase: Phase.Choose, order: Order.Wait }
                    }
                }
            },
            _ => base,
        };
    }
}

/// The unit row applies this frame's order. Damage is attack less
/// defense, never below one; a unit that acted is spent until the turn ends.
kernel slg.units@1 {
    requires { field.read; field.write; }
    input previous: Units;
    input game: State;
    output result: Units;
    compute {
        let u = sample(previous);
        let g = at(game, 0);
        let i = element();
        return match g.order {
            Order.Move => if i == g.selected { Unit { ..u, x: g.ox, y: g.oy } } else { u },
            Order.Attack => if i == g.target {
                let a = at(previous, g.selected);
                let hp = u.hp - max(a.attack - u.defense, 1);
                Unit { ..u, hp: max(hp, 0), alive: hp > 0 }
            } else if i == g.selected { Unit { ..u, moved: true } } else { u },
            Order.Wait => if i == g.selected { Unit { ..u, moved: true } } else { u },
            Order.NewTurn => Unit { ..u, moved: false },
            _ => u,
        };
    }
}

/// Sixteen-pixel tiles, sprites drawn from arithmetic, a cursor that
/// blinks with the clock, a bar at the bottom for the turn and the phase.
kernel slg.draw@1 {
    requires { field.read; field.write; time.read; }
    input map: Map;
    input units: Units;
    input game: State;
    input range: Range;
    output result: Image;

    fn terrain(kind: Terrain, px: Int, py: Int) -> Vec3 {
        let dot = (px * 7 + py * 3) % 5 == 0;
        return match kind {
            // A round tree in each cell.
            Terrain.Forest => if (px % 8 - 4) * (px % 8 - 4) + (py % 8 - 4) * (py % 8 - 4) < 9 { vec3(0.1, 0.45, 0.15) } else { vec3(0.25, 0.65, 0.25) },
            // A peak, shaded on one side.
            Terrain.Mountain => if py > 14 - (px - 8) * (if px < 8 { -1 } else { 1 }) { vec3(0.45, 0.4, 0.35) } else { vec3(0.6, 0.55, 0.5) },
            // Ripples.
            Terrain.Water => if (px + py) % 8 < 2 { vec3(0.55, 0.75, 1.0) } else { vec3(0.2, 0.4, 0.9) },
            // Courses of stone.
            Terrain.Fort => if px % 8 < 1 || py % 4 < 1 { vec3(0.5, 0.45, 0.45) } else { vec3(0.7, 0.6, 0.55) },
            // Grass, a dot here and there.
            _ => if dot { vec3(0.4, 0.8, 0.35) } else { vec3(0.35, 0.7, 0.3) },
        };
    }

    fn sprite(u: Unit, px: Int, py: Int) -> Vec4 {
        let body = if u.team == Team.Player { vec3(0.3, 0.45, 1.0) } else { vec3(1.0, 0.35, 0.3) };
        let skin = vec3(1.0, 0.85, 0.7);
        let dark = vec3(0.1, 0.1, 0.15);
        let helmet = py >= 2 && py <= 5 && px >= 5 && px <= 10;
        let face = py >= 6 && py <= 8 && px >= 6 && px <= 9;
        let eye = py == 7 && (px == 6 || px == 9);
        let torso = py >= 9 && py <= 12 && px >= 4 && px <= 11;
        let legs = py >= 13 && py <= 14 && (px == 5 || px == 6 || px == 9 || px == 10);
        let weapon = px == 12 && py >= 4 && py <= 12;
        let color = if eye { dark } else if face { skin } else if helmet || torso { body } else if legs { dark } else if weapon { vec3(0.85, 0.85, 0.9) } else { vec3(0.0, 0.0, 0.0) };
        let solid = eye || face || helmet || torso || legs || weapon;
        let shaded = if u.moved { mix(color, vec3(0.3, 0.3, 0.3), 0.5) } else { color };
        return vec4(shaded, float(solid));
    }

    compute {
        let g = at(game, 0);
        let c = coord();
        let x = int(c.x);
        let y = int(c.y);
        let tx = x / 16;
        let ty = y / 16;
        let px = x % 16;
        let py = y % 16;
        let extent = size(map);
        let on_map = ty < int(extent.y);
        let tile = if on_map { at(map, vec2(tx, ty)) } else { Tile { kind: Terrain.Grass, cost: 1 } };
        let ground = terrain(tile.kind, px, py);
        // Reachable cells glow while a destination is being chosen.
        let reach = if on_map && (g.phase == Phase.Destination || g.phase == Phase.Moving) && g.selected >= 0 { at(range, vec2(tx, ty)) <= at(units, g.selected).move } else { false };
        let lit = if reach { mix(ground, vec3(0.5, 0.7, 1.0), 0.45) } else { ground };
        // Units, with a health bar underneath.
        let here = loop 16 with drawn = vec4(0.0, 0.0, 0.0, 0.0) until index() >= count(units) {
            let u = at(units, index());
            if u.alive && u.x == tx && u.y == ty && on_map {
                let s = sprite(u, px, py);
                let bar = py == 15 && px >= 2 && px < 2 + (u.hp * 12) / 10;
                if bar { vec4(0.2, 1.0, 0.3, 1.0) } else if s.a > 0.5 { s } else { drawn }
            } else { drawn }
        };
        let with_units = if here.a > 0.5 { here.xyz } else { lit };
        // The cursor: a blinking frame.
        let blink = int(floor(time() * 6.0)) % 2 == 0;
        let frame = on_map && tx == g.cx && ty == g.cy && (px == 0 || px == 15 || py == 0 || py == 15) && blink && g.phase < Phase.Choose;
        let enemy_mark = on_map && tx == g.cx && ty == g.cy && (px == 0 || px == 15 || py == 0 || py == 15) && g.phase >= Phase.Choose && g.phase <= Phase.Striking;
        let scene = if frame { vec3(1.0, 1.0, 1.0) } else if enemy_mark { vec3(1.0, 0.5, 0.2) } else { with_units };
        // The status bar: turn as ticks, phase as a color block, ends as a tint.
        let bar = if ty >= int(extent.y) {
            let ticks = (x - 8) / 8 < g.turn && (x - 8) % 8 < 5 && x >= 8 && y >= 200 && y < 208;
            let phase_color = if g.phase < Phase.Choose { vec3(0.3, 0.45, 1.0) } else { vec3(1.0, 0.35, 0.3) };
            let block = x >= 200 && x < 248 && y >= 200 && y < 208;
            if ticks { vec3(1.0, 1.0, 1.0) } else if block { phase_color } else { vec3(0.05, 0.05, 0.08) }
        } else { scene };
        let ended = if g.phase == Phase.Won { mix(bar, vec3(1.0, 0.9, 0.3), 0.4) } else if g.phase == Phase.Lost { mix(bar, vec3(0.5, 0.1, 0.1), 0.5) } else { bar };
        return vec4(ended, 1.0);
    }
}
