// The balls path-traced by the render package: one diffuse and one
// specular path a pixel a frame, accumulated while the lens rests.
use "../../../packages/render.entpkg";

node scene: graph "../graphs/balls.esn" { }
node light: graph "../../../packages/render.entpkg/graphs/path_trace.esn" { lens <- scene.lens; sky <- scene.sky; surface <- scene.surface; paint <- scene.paint; extra <- scene.extra; layers <- scene.layers; more <- scene.more;
    behind_at <- scene.behind_at; behind_dir <- scene.behind_dir; behind_paint <- scene.behind_paint; behind_normal <- scene.behind_normal; through <- scene.through;
    proxy <- scene.proxy; land <- scene.land; frame <- scene.frame; bounces = 2; }
node bright: render.bright@1 { hdr <- light.hdr; domain = ceil(window() / 8); }
node bloom_x: render.spread@1 { image <- bright.result; axis = 0; }
node bloom: render.spread@1 { image <- bloom_x.result; axis = 1; }
node view: render.view@1 { hdr <- light.hdr; bloom <- bloom.result; exposure = 0.8; vivid = 1.0; domain = window(); }

output result <- view.result;
