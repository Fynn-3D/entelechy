// The balls path-traced by the render package: one diffuse and one
// specular path a pixel a frame, accumulated while the lens rests.
use "../../../packages/light.entpkg";
use "../../../packages/image.entpkg";

node scene: graph "../graphs/balls.esn" { }
// No lamps beside the sun.
node no_lamps: light.lamps_none@1 { domain = 1; }
node no_lamp_looks: light.lamp_looks_none@1 { domain = vec2(1, 1); }
node light: graph "../graphs/path_tracer.esn" { lamps <- no_lamps.result; lamp_looks <- no_lamp_looks.result; lens <- scene.lens; sky <- scene.sky; surface <- scene.surface; paint <- scene.paint; extra <- scene.extra; layers <- scene.layers; more <- scene.more;
    behind_at <- scene.behind_at; behind_dir <- scene.behind_dir; behind_paint <- scene.behind_paint; behind_normal <- scene.behind_normal; through <- scene.through;
    proxy <- scene.proxy; land <- scene.land; frame <- scene.frame; bounces = 2; }
node bright: image.bright@2 { hdr <- light.hdr; domain = ceil(window() / 8); }
node bloom_x: image.spread@1 { image <- bright.result; axis = 0; }
node bloom: image.spread@1 { image <- bloom_x.result; axis = 1; }
node view: image.tonemap@3 { hdr <- light.hdr; bloom <- bloom.result; exposure = 0.8; vivid = 1.0; domain = window(); }

output result <- view.result;
