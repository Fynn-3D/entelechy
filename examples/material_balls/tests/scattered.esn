// Pebbles and tufts scattered by the scatter package round a center
// on flat ground: two layers, the pebbles in patches, the tufts even.
use "../../../packages/scatter.entpkg";

node center: kernel {
    requires { field.write; }
    output result: Rows<Vec3>;
    domain = 1;
    compute { return vec3(0.0, 0.0, 0.0); }
}
node layers: kernel {
    requires { field.write; }
    output result: Rows<ScatterLayer>;
    domain = 2;
    compute {
        return if element() == 0 { ScatterLayer { item: 0, density: 2.0, size: vec2(0.05, 0.12), patch: 3.0, cover: 0.5, steep: 1.0, seed: 7 } }
            else { ScatterLayer { item: 1, density: 4.0, size: vec2(0.2, 0.4), patch: 0.0, cover: 1.0, steep: 1.0, seed: 11 } };
    }
}
node flat: Grid<Float> { domain = vec2(2, 2); }
node everywhere: Grid<Float> { domain = vec2(1, 1); value = 1.0; }
node scatter: scatter.around@1 { center <- center.result; layers <- layers.result; ground <- flat.result; mask <- everywhere.result;
    cell = 2.0; cells = 8; slots = 16; full = 4.0; far = 8.0; domain = 8 * 8 * 16; }
node kept: kernel {
    requires { field.read; field.write; }
    input placed: Rows<Placed> <- scatter.result;
    output result: Rows<Int>;
    domain = 2;
    compute { return loop count(placed) with n = 0 { if at(placed, index()).item == element() { n + 1 } else { n } }; }
}

output result <- kept.result;
