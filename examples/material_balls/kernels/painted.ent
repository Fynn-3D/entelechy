// The painted look: light and shade as a painting has them, a renderer's shading taken toward it as far as a scene
// asks (`painted`, 0 as it is, 1 all painted, between them blended: a look turned into another as a story goes).
// The sunward side and the shade split on one soft step, the shade only the light from all round, flat and cool; a
// rim of light on the edge against the light; a small hard highlight on smooth surfaces.
use "../../../packages/light.entpkg";

/// The painted look, a scene's to tune: where light turns to shade across the surface (`terminator`, from and to, the
/// cosine to the sun) and across the shadow (`shadow`), the sun's share of its light, how much of the light all round's
/// color the shade keeps (`flat`) and its tint (`shade`), the rim's strength, the highlight's patch (`highlight`, from
/// and to) and its strength (`glint`).
struct Toon { terminator: Vec2; shadow: Vec2; sun: Float; flat: Float; shade: Vec3; rim: Float; highlight: Vec2; glint: Float; }

/// How far a renderer's light is taken toward a painting's (`amount`, 0 none, 1 all) and the painting's look: what a
/// node makes and a renderer reads, so a scene turns one look into another as it goes.
struct Painting { amount: Float; toon: Toon; }
type Paintings = Rows<Painting>;

/// The painted look as the package ships it.
fn toon_default() -> Toon {
    return Toon { terminator: vec2(-0.03, 0.16), shadow: vec2(0.2, 0.55), sun: 0.75, flat: 0.6, shade: vec3(0.85, 0.95, 1.2), rim: 0.012,
        highlight: vec2(0.965, 0.985), glint: 0.03 };
}

/// A surface `m` facing `n`, seen from `v`, lit as a painting has it: the sun `shadow` of the way through (its
/// visibility), the light from all round `e`.
fn toon(m: Pbr, n: Vec3, v: Vec3, s: SkyLook, shadow: Float, e: Vec3, t: Toon) -> Vec3 {
    let kd = (1.0 - m.metal) * (1.0 - m.transmission);
    let lightness = smoothstep(t.terminator.x, t.terminator.y, dot(n, s.sun)) * smoothstep(t.shadow.x, t.shadow.y, shadow);
    let sun = m.albedo * kd * s.sun_color * (t.sun / 3.14159265 * lightness);
    let gray = dot(e, vec3(0.2126, 0.7152, 0.0722));
    let flat_ = mix(vec3(gray, gray, gray), e, t.flat) * t.shade;
    let ambient = m.albedo * kd * flat_;
    let edge = pow(1.0 - clamp(dot(n, v), 0.0, 1.0), 4.0);
    let rim = s.sun_color * (edge * (0.25 + 0.75 * lightness) * t.rim);
    let h = normalize(s.sun + v);
    let blob = smoothstep(t.highlight.x, t.highlight.y, max(dot(n, h), 0.0)) * (1.0 - m.rough) * lightness;
    return sun + ambient + rim + s.sun_color * (blob * t.glint);
}

/// What a painted surface reflects of the light along its mirror direction `spec_light`: smooth ones alone.
fn painted_gloss(m: Pbr, n: Vec3, v: Vec3, spec_light: Vec3) -> Vec3 {
    return spec_light * env_brdf(pbr_f0(m), m.rough, max(dot(n, v), 0.001)) * (1.0 - m.rough);
}

/// A surface's light, `painted` of the way from the standard shading (the sun's `lit_by`, the light all round's
/// `ambient_by`) to the painted one (`toon` and its gloss): the sun of `sun_light` (its color times its visibility, which
/// is `shadow`), the diffuse light all round `e`, the light along the mirror direction for the base (`spec_light`) and
/// for a clearcoat (`coat_light`).
fn shaded_as(m: Pbr, n: Vec3, v: Vec3, s: SkyLook, shadow: Float, e: Vec3, spec_light: Vec3, coat_light: Vec3, painted: Float, t: Toon) -> Vec3 {
    let real = if painted < 1.0 { lit_by(m, n, v, s.sun, s.sun_color * shadow) + ambient_by(m, n, v, e, spec_light, coat_light) } else { vec3(0.0, 0.0, 0.0) };
    let drawn = if painted > 0.0 { toon(m, n, v, s, shadow, e, t) + painted_gloss(m, n, v, spec_light) } else { vec3(0.0, 0.0, 0.0) };
    return mix(real, drawn, saturate(painted));
}

/// The share of a surface's light that goes under its skin (`scattered_share`), as much as it is not painted.
fn scattered_as(m: Pbr, n: Vec3, v: Vec3, s: SkyLook, shadow: Float, e: Vec3, painted: Float) -> Vec3 {
    return if painted >= 1.0 { vec3(0.0, 0.0, 0.0) } else { scattered_share(m, n, v, s.sun, s.sun_color * shadow, e) * (1.0 - saturate(painted)) };
}

/// What a surface reflects from all round of `spec_light`, `painted` of the way to the painted gloss.
fn mirrored_as(m: Pbr, n: Vec3, v: Vec3, spec_light: Vec3, painted: Float) -> Vec3 {
    return mix(spec_light * env_reflectance(m, n, v), painted_gloss(m, n, v, spec_light), saturate(painted));
}

/// No painting: the renderer's light as it is.
fn painting_none() -> Painting { return Painting { amount: 0.0, toon: toon_default() }; }

/// One painting made from these parameters (`domain = 1`): how far, and the look (`Toon`'s).
kernel balls.painting_start@1 {
    requires { field.write; }
    param amount: Float = 0.0;
    param toon_terminator: Vec2 = vec2(-0.03, 0.16);
    param toon_shadow: Vec2 = vec2(0.2, 0.55);
    param toon_sun: Float = 0.75;
    param toon_flat: Float = 0.6;
    param toon_shade: Vec3 = vec3(0.85, 0.95, 1.2);
    param toon_rim: Float = 0.012;
    param toon_highlight: Vec2 = vec2(0.965, 0.985);
    param toon_glint: Float = 0.03;
    output result: Paintings;
    compute {
        return Painting { amount: amount, toon: Toon { terminator: toon_terminator, shadow: toon_shadow, sun: toon_sun, flat: toon_flat,
            shade: toon_shade, rim: toon_rim, highlight: toon_highlight, glint: toon_glint } };
    }
}
