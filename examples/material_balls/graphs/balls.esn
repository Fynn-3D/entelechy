//! The balls on their floor, as the render package's contract asks
//! (`../kernels/balls.ent`): the lens a person drives, the sky, the
//! G-buffer and the proxies. The renderer the scene places lights them.
use "../kernels/";
use "../../../packages/surface.entpkg";
use "../../../packages/light.entpkg";

node sky: material_balls.sky@1 { domain = 1; }
node frame: material_balls.frame@1 { domain = 1; }
node land: Grid<Float> { domain = vec2(2, 2); }
node shape: material_balls.bake@1 { domain = vec3(100, 25, 60); }

node home: balls.orbit_start@1 { x = 0.0; y = 0.45; z = -1.9; yaw = 0.0; pitch = 0.42; dist = 8.5; domain = 1; }
node depths0: Grid<Float> { domain = ceil(window() / 8); }
node cam: balls.orbit@1 { previous <~ cam.result from home.result; home <- home.result; depths <~ depths.result from depths0.result;
    land <- land.result; frame <- frame.result; domain = 1; }
node lens: balls.orbit_lens@1 { cam <- cam.result; domain = 1; }

node g: material_balls.gbuffer@1 { lens <- lens.result; sky <- sky.result; domain = window(); }
node depths: surface.depths@1 { surface <- g.surface; domain = ceil(window() / 8); }

output lens <- lens.result;
output sky <- sky.result;
output surface <- g.surface;
output paint <- g.paint;
output extra <- g.extra;
output layers <- g.layers;
output more <- g.more;
output behind_at <- g.behind_at;
output behind_dir <- g.behind_dir;
output behind_paint <- g.behind_paint;
output behind_normal <- g.behind_normal;
output through <- g.through;
output proxy <- shape.result;
output land <- land.result;
output frame <- frame.result;
