// What the skin package leaves to the scene: where to stand, what to
// blend, and how to light it. The posing itself is the package.
use "../../../packages/skin.orlapkg/kernels/skin.orla";

struct Vertex { clip: Vec4; normal: Vec3; uv: Vec2; }
struct Tri { a: Int; b: Int; c: Int; }
struct Surface { depth: Float; normal: Vec3; uv: Vec2; id: Int; }
type Vertices = Rows<Vertex>;
type Triangles = Rows<Tri>;
type GBuffer = Grid<Surface>;

fn rotate_y(a: Float) -> Mat3 {
    return mat3(vec3(cos(a), 0.0, -sin(a)), vec3(0.0, 1.0, 0.0), vec3(sin(a), 0.0, cos(a)));
}

fn rotate_x(a: Float) -> Mat3 {
    return mat3(vec3(1.0, 0.0, 0.0), vec3(0.0, cos(a), sin(a)), vec3(0.0, -sin(a), cos(a)));
}

// The clock the clips are read at, and how much of the second one to
// take: the pointer's height, so a hand blends the two live. With no
// hand on it the blend sweeps on its own, which is what the replay
// pins.
kernel arm.hand@1 {
    requires { field.write; time.read; input.read; }
    param speed: Float = 1.0;
    output result: Rows<Float>;
    compute {
        if element() == 0 { return time() * speed; }
        let p = pointer();
        return if pointer_down() { clamp(p.y, 0.0, 1.0) } else { 0.5 + 0.5 * sin(time() * 0.9) };
    }
}

kernel arm.clock@1 {
    requires { field.read; field.write; }
    input hand: Rows<Float>;
    output result: Rows<Float>;
    compute { return at(hand, 0); }
}

kernel arm.mix@1 {
    requires { field.read; field.write; }
    input hand: Rows<Float>;
    output result: Rows<Float>;
    compute { return at(hand, 1); }
}

kernel arm.project@1 {
    requires { field.read; field.write; time.read; }
    input mesh: Rows<Point>;
    param aspect: Float = 1.7778;
    param focus: Vec3 = vec3(0.0, 0.35, -0.9);
    param distance: Float = 4.0;
    param tilt: Float = 0.25;
    param spin: Float = 0.35;
    // Where the orbit starts: side on, so the chain bends across the
    // window rather than towards it.
    param turn: Float = 1.5708;
    output result: Vertices;
    compute {
        let v = sample(mesh);
        let orbit = rotate_x(tilt) * rotate_y(turn + time() * spin);
        let p = orbit * (v.position - focus);
        let n = orbit * v.normal;
        let view = vec3(p.x, p.y, p.z - distance);
        let f = 2.1445;
        let near = 0.1;
        let far = 20.0;
        return Vertex {
            clip: vec4(view.x * f / aspect, view.y * f,
                       view.z * far / (near - far) + near * far / (near - far), 0.0 - view.z),
            normal: n,
            uv: v.uv,
        };
    }
}

kernel arm.shade@1 {
    requires { field.read; field.write; }
    input surface: GBuffer;
    param light: Vec3 = vec3(0.4, 0.8, 0.5);
    output result: Image;
    compute {
        let s = sample(surface);
        let up = coord().y / domain().y;
        let sky = mix(vec3(0.10, 0.12, 0.17), vec3(0.04, 0.05, 0.07), up);
        let n = normalize(s.normal);
        let l = normalize(light);
        let lit = max(dot(n, l), 0.0);
        let rim = pow(1.0 - abs(n.z), 3.0) * 0.3;
        let body = vec3(0.72, 0.58, 0.44) * (0.25 + 0.75 * lit) + vec3(rim, rim, rim);
        return vec4(if s.id < 0 { sky } else { body }, 1.0);
    }
}
