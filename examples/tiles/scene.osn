// generate -> flood (fed back) -> render, with the atlas read from a file
// the Host watches: edit assets/atlas.ppm and the tiles change.
use "kernels/";

input atlas: Image = "assets/atlas.ppm";

node map: tiles.generate@1 {
    domain = vec2(20, 15);
    source = vec2(3.0, 7.0);
}

node flood: tiles.flood@1 {
    previous <~ flood.result from map.result;
}

node view: tiles.render@1 {
    map <- flood.result;
    atlas <- atlas;
    domain = size(map) * tile;     // 20x15 tiles at 16 pixels: 320x240
}

output result <- view.result;
