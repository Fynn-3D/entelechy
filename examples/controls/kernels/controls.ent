// A dot walked by the keyboard or a pad alike, through the controls
// package: W A S D or the arrows or the left stick move it, the actions
// in `assets/actions.csv` (jump on Space or a pad's south, fire on F, J or
// west, menu on Esc or start) light their lamps, the stick's flicks and
// the arrows step a cursor down a list of four, and a corner shows which
// was touched last, the pad or the keyboard.
use "../../../packages/controls.entpkg";

/// Where the dot is, the list's cursor, the time.
struct Walker { at: Vec2; row: Int; t: Float; }

kernel walk.start@1 {
    requires { field.write; }
    output result: Rows<Walker>;
    compute { return Walker { at: vec2(80.0, 60.0), row: 0, t: 0.0 }; }
}

/// The dot moved by the controls' way, sixty pixels a second, y ahead
/// (up the picture); the cursor stepped by the flicks.
kernel walk.step@1 {
    requires { field.read; field.write; time.read; }
    input previous: Rows<Walker>;
    input controls: Rows<ActionControls>;
    output result: Rows<Walker>;
    compute {
        let w = sample(previous);
        let c = at(controls, 0);
        let t = time();
        let dt = clamp(t - w.t, 0.0, 0.1);
        let at_ = clamp(w.at + vec2(c.move.x, -c.move.y) * 60.0 * dt, vec2(4.0, 4.0), vec2(156.0, 116.0));
        let row = if action_stick_stepped(c, 2) { min(w.row + 1, 3) } else if action_stick_stepped(c, 1) { max(w.row - 1, 0) } else { w.row };
        return Walker { at: at_, row: row, t: t };
    }
}

/// The picture: the dot, a lamp an action lit while it is held, the list
/// with its cursor, and the corner lit for the pad.
kernel walk.view@1 {
    requires { field.read; field.write; }
    input walker: Rows<Walker>;
    input controls: Rows<ActionControls>;
    output result: Image;
    compute {
        let q = coord() + vec2(0.5, 0.5);
        let w = at(walker, 0);
        let c = at(controls, 0);
        let back = vec4(0.08, 0.09, 0.11, 1.0);
        if length(q - w.at) < 4.0 { return vec4(0.95, 0.8, 0.3, 1.0); }
        if q.y < 10.0 && q.x >= 4.0 && q.x < 40.0 {
            let k = int((q.x - 4.0) / 12.0);
            return if action_held(c, k) { vec4(0.3, 0.9, 0.4, 1.0) } else { vec4(0.2, 0.22, 0.25, 1.0) };
        }
        if q.x >= 140.0 && q.y >= 20.0 && q.y < 60.0 {
            let row = int((q.y - 20.0) / 10.0);
            return if row == w.row { vec4(0.4, 0.6, 0.95, 1.0) } else { vec4(0.15, 0.17, 0.2, 1.0) };
        }
        if q.x >= 150.0 && q.y < 10.0 { return if c.pad == 1 { vec4(0.9, 0.3, 0.3, 1.0) } else { vec4(0.2, 0.22, 0.25, 1.0) }; }
        return back;
    }
}
