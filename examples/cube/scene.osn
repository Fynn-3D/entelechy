// One Kernel: a cube marched in its own space and outlined by its edges.
use "kernels/";

param spin: Float = 0.6;
// The camera, whole: a perspective of focal length 2.2.
param lens: Mat4 = mat4(vec4(2.2, 0.0, 0.0, 0.0), vec4(0.0, 2.2, 0.0, 0.0), vec4(0.0, 0.0, 1.0, -1.0), vec4(0.0, 0.0, 0.0, 0.0));
// How it is drawn, a struct the Kernel's document declares.
param style: Style = Style { ground: vec3(0.06, 0.07, 0.1), edge: vec3(1.0, 0.95, 0.8), width: 1.0 };

node cube: cube.draw@1 {
    domain = vec2(320, 240);
    spin = spin;
    lens = lens;
    style = style;
}

output result <- cube.result;
