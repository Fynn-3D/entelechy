// A product showcase: a gamepad modelled as a signed-distance field,
// shaded with a physically based model, on a reflective floor, with a
// minimal toolbar. One row of state (the camera, the choices, the
// pointer's last position) and one image. Drag to orbit; the bar at the
// bottom cycles the colour and the finish, toggles the turntable, and
// resets the view; keys or a pad light the buttons they press.
struct Show {
    yaw: Float; pitch: Float;
    dragging: Bool; px: Float; py: Float;   // pointer, last frame
    down: Bool;                             // button, last frame
    scheme: Int; finish: Int;               // colour scheme, surface finish
    spin: Bool; hover: Int;                 // turntable on, toolbar item under the pointer
    spun: Float;                            // accumulated turntable angle
}
type State = Rows<Show>;
struct Mat { albedo: Vec3; rough: Float; metal: Float; glow: Vec3; }
struct Hit { t: Float; id: Float; }

/// The toolbar: four items of 64 pixels with 12 between, centred at the
/// bottom of a 1280-wide frame.
kernel show.begin@1 {
    requires { field.write; }
    output result: State;
    compute {
        return Show { yaw: 0.6, pitch: 0.42, dragging: false, px: 0.0, py: 0.0, down: false, scheme: 0, finish: 0, spin: true, hover: -1, spun: 0.0 };
    }
}

kernel show.state@1 {
    requires { field.read; field.write; input.read; time.read; }
    input previous: State;
    output result: State;

    // The bar is laid out in logical pixels: the window's scale factor is
    // the unit, so it keeps its size on screen whatever the window's.
    fn item_at(px: Float, py: Float, width: Float, height: Float, unit: Float) -> Int {
        let x = px / unit;
        let y = py / unit;
        let bottom = height / unit;
        let left = width / unit * 0.5 - 146.0;
        let inside = y >= bottom - 56.0 && y <= bottom - 8.0 && x >= left && x <= left + 292.0;
        let slot = int(floor((x - left) / 76.0));
        let within = (x - left) - float(slot) * 76.0 <= 64.0;
        return if inside && within && slot >= 0 && slot < 4 { slot } else { -1 };
    }

    compute {
        let s = sample(previous);
        let p = pointer();
        let down = pointer_down();
        let pressed = down && !s.down;
        let released = !down && s.down;
        let win = window();
        let unit = scale();
        let hover = item_at(p.x, p.y, win.x, win.y, unit);
        let clicked = if released && !s.dragging { item_at(s.px, s.py, win.x, win.y, unit) } else { -1 };
        let dragging = if pressed && hover < 0 { true } else if released { false } else { s.dragging };
        let dx = if s.dragging && down { p.x - s.px } else { 0.0 };
        let dy = if s.dragging && down { p.y - s.py } else { 0.0 };
        let yaw = s.yaw + dx * 0.008;
        let pitch = clamp(s.pitch + dy * 0.008, 0.05, 1.4);
        let spin = if clicked == 2 { !s.spin } else { s.spin };
        let reset = clicked == 3;
        return Show {
            yaw: if reset { 0.6 } else { yaw },
            pitch: if reset { 0.42 } else { pitch },
            dragging: dragging,
            px: p.x, py: p.y,
            down: down,
            scheme: if clicked == 0 { (s.scheme + 1) % 4 } else { s.scheme },
            finish: if clicked == 1 { (s.finish + 1) % 3 } else { s.finish },
            spin: spin,
            hover: hover,
            spun: if reset { 0.0 } else if spin && !s.dragging { s.spun + 0.35 / 60.0 } else { s.spun }
        };
    }
}

kernel show.render@1 {
    requires { field.read; field.write; input.read; time.read; }
    input state: State;
    param exposure: Float = 1.1;
    output result: Image;

    // ---- geometry: a gamepad as distances, with a part id in y ----
    fn box(p: Vec3, b: Vec3, r: Float) -> Float {
        let q = abs(p) - b;
        return length(max(q, vec3(0.0, 0.0, 0.0))) + min(max(q.x, max(q.y, q.z)), 0.0) - r;
    }

    fn capsule(p: Vec3, a: Vec3, b: Vec3, r: Float) -> Float {
        let pa = p - a;
        let ba = b - a;
        let h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
        return length(pa - ba * h) - r;
    }

    fn cylinder(p: Vec3, c: Vec3, r: Float, h: Float) -> Float {
        let q = p - c;
        let d = vec2(length(vec2(q.x, q.z)) - r, abs(q.y) - h);
        return min(max(d.x, d.y), 0.0) + length(max(d, vec2(0.0, 0.0)));
    }

    fn smin(a: Float, b: Float, k: Float) -> Float {
        let h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
        return mix(b, a, h) - k * h * (1.0 - h);
    }

    fn nearer(a: Vec2, b: Vec2) -> Vec2 {
        return if a.x < b.x { a } else { b };
    }

    // Button ids 10..17 press in when held: A B X Y up down left right, start 18.
    fn depth(id: Int) -> Float {
        let held = if id == 10 { key(90) } else if id == 11 { key(88) } else if id == 12 { key(67) } else if id == 13 { key(86) }
            else if id == 14 { key(38) } else if id == 15 { key(40) } else if id == 16 { key(37) } else if id == 17 { key(39) }
            else if id == 18 { key(13) } else { false };
        return if held { 0.03 } else { 0.0 };
    }

    // The pad alone: the floor is added by scene(), and left out when a
    // floor reflection is traced, so a grazing bounce does not spend its
    // steps creeping along the floor it started from.
    fn pad(p: Vec3) -> Vec2 {
        // Body: a rounded slab with two grips flowing out of it.
        let body = box(p, vec3(0.78, 0.09, 0.32), 0.14);
        let left_grip = capsule(p, vec3(-0.62, 0.0, 0.05), vec3(-0.86, -0.2, -0.78), 0.2);
        let right_grip = capsule(p, vec3(0.62, 0.0, 0.05), vec3(0.86, -0.2, -0.78), 0.2);
        let shell = smin(smin(body, left_grip, 0.16), right_grip, 0.16);
        let top = 0.23;
        // Sticks: a ring, a stalk, a rubber cap.
        let ls = vec3(-0.5, top, 0.12);
        let rs = vec3(0.3, top, -0.28);
        let ring = min(cylinder(p, ls, 0.17, 0.02), cylinder(p, rs, 0.17, 0.02));
        let stalk = min(cylinder(p, ls + vec3(0.0, 0.1, 0.0), 0.06, 0.1), cylinder(p, rs + vec3(0.0, 0.1, 0.0), 0.06, 0.1));
        let cap = min(length(p - ls - vec3(0.0, 0.24, 0.0)) - 0.13, length(p - rs - vec3(0.0, 0.24, 0.0)) - 0.13);
        // Face buttons in a diamond, pressed ones sunk.
        let fc = vec3(0.55, top, 0.14);
        let a = cylinder(p - vec3(0.0, -depth(10), 0.0), fc + vec3(0.0, 0.0, -0.14), 0.07, 0.035);
        let b = cylinder(p - vec3(0.0, -depth(11), 0.0), fc + vec3(0.14, 0.0, 0.0), 0.07, 0.035);
        let x = cylinder(p - vec3(0.0, -depth(12), 0.0), fc + vec3(-0.14, 0.0, 0.0), 0.07, 0.035);
        let y = cylinder(p - vec3(0.0, -depth(13), 0.0), fc + vec3(0.0, 0.0, 0.14), 0.07, 0.035);
        // The pad: a cross, each arm sinking when held.
        let dc = vec3(-0.3, top, -0.3);
        let arm_ns = box(p - dc - vec3(0.0, -max(depth(14), depth(15)), 0.0), vec3(0.055, 0.02, 0.19), 0.015);
        let arm_ew = box(p - dc - vec3(0.0, -max(depth(16), depth(17)), 0.0), vec3(0.19, 0.02, 0.055), 0.015);
        // Start and select pills, and two bumpers on the far edge.
        let start = capsule(p - vec3(0.0, -depth(18), 0.0), vec3(0.1, top, -0.04), vec3(0.16, top, -0.04), 0.03);
        let select = capsule(p, vec3(-0.16, top, -0.04), vec3(-0.1, top, -0.04), 0.03);
        // Shoulder bumpers on the far edge, standing a little proud of the shell.
        let bumpers = min(box(p - vec3(-0.5, 0.17, -0.44), vec3(0.18, 0.03, 0.05), 0.03), box(p - vec3(0.5, 0.17, -0.44), vec3(0.18, 0.03, 0.05), 0.03));
        let d = nearer(vec2(shell, 1.0), vec2(ring, 2.0));
        let d2 = nearer(d, nearer(vec2(stalk, 3.0), vec2(cap, 3.0)));
        let d3 = nearer(d2, nearer(nearer(vec2(a, 10.0), vec2(b, 11.0)), nearer(vec2(x, 12.0), vec2(y, 13.0))));
        let d4 = nearer(d3, nearer(vec2(min(arm_ns, arm_ew), 14.0), nearer(vec2(start, 18.0), vec2(select, 19.0))));
        return nearer(d4, vec2(bumpers, 4.0));
    }

    fn scene(p: Vec3) -> Vec2 {
        return nearer(pad(p), vec2(p.y + 0.62, 0.0));
    }

    fn normal(p: Vec3) -> Vec3 {
        let e = 0.0015;
        let dx = scene(p + vec3(e, 0.0, 0.0)).x - scene(p - vec3(e, 0.0, 0.0)).x;
        let dy = scene(p + vec3(0.0, e, 0.0)).x - scene(p - vec3(0.0, e, 0.0)).x;
        let dz = scene(p + vec3(0.0, 0.0, e)).x - scene(p - vec3(0.0, 0.0, e)).x;
        return normalize(vec3(dx, dy, dz));
    }

    fn march(origin: Vec3, dir: Vec3) -> Hit {
        return loop 128 with h = Hit { t: 0.02, id: -1.0 } until h.t > 20.0 || h.id >= 0.0 {
            let s = scene(origin + dir * h.t);
            if s.x < 0.0006 * h.t { Hit { t: h.t, id: s.y } } else { Hit { t: h.t + s.x * 0.85, id: -1.0 } }
        };
    }

    fn march_pad(origin: Vec3, dir: Vec3) -> Hit {
        return loop 96 with h = Hit { t: 0.02, id: -1.0 } until h.t > 8.0 || h.id >= 0.0 {
            let s = pad(origin + dir * h.t);
            if s.x < 0.001 * h.t { Hit { t: h.t, id: s.y } } else { Hit { t: h.t + s.x * 0.9, id: -1.0 } }
        };
    }

    // A soft shadow that estimates the closest approach between two
    // samples from both distances, which keeps the penumbra free of the
    // rings a plain distance-over-travel estimate leaves at large steps.
    fn shadow(origin: Vec3, dir: Vec3) -> Float {
        return loop 64 with s = vec3(0.03, 1.0, 100.0) until s.x > 6.0 || s.y < 0.005 {
            let d = scene(origin + dir * s.x).x;
            let y = d * d / (2.0 * s.z);
            let across = sqrt(max(d * d - y * y, 0.0));
            let res = min(s.y, 12.0 * across / max(s.x - y, 0.0001));
            vec3(s.x + clamp(d, 0.01, 0.15), res, d)
        }.y;
    }

    fn occlusion(p: Vec3, n: Vec3) -> Float {
        let o = loop 5 with acc = vec2(0.0, 1.0) {
            let h = 0.02 + 0.06 * float(index());
            let d = scene(p + n * h).x;
            vec2(acc.x + (h - d) * acc.y, acc.y * 0.72)
        };
        return clamp(1.0 - 2.2 * o.x, 0.0, 1.0);
    }

    // ---- materials by part and by the chosen scheme and finish ----
    fn accent(scheme: Int) -> Vec3 {
        return if scheme == 0 { vec3(0.92, 0.92, 0.9) } else if scheme == 1 { vec3(0.1, 0.45, 0.95) }
            else if scheme == 2 { vec3(0.9, 0.25, 0.2) } else { vec3(0.95, 0.75, 0.2) };
    }

    fn material(id: Int, scheme: Int, finish: Int, p: Vec3) -> Mat {
        let shell = if scheme == 0 { vec3(0.05, 0.05, 0.06) } else { accent(scheme) * 0.85 };
        let rough_shell = if finish == 0 { 0.55 } else if finish == 1 { 0.22 } else { 0.35 };
        let metal_shell = if finish == 2 { 1.0 } else { 0.0 };
        let button_color = if id == 10 { vec3(0.2, 0.75, 0.3) } else if id == 11 { vec3(0.9, 0.2, 0.2) }
            else if id == 12 { vec3(0.2, 0.45, 0.95) } else { vec3(0.95, 0.8, 0.2) };
        let lit = depth(id) > 0.0;
        return if id == 0 {
            // The floor: dark, glossy, with a faint grid.
            let grid = if abs(fract(p.x * 2.0) - 0.5) < 0.01 || abs(fract(p.z * 2.0) - 0.5) < 0.01 { 0.03 } else { 0.0 };
            Mat { albedo: vec3(0.03, 0.03, 0.035) + vec3(grid, grid, grid), rough: 0.2, metal: 0.0, glow: vec3(0.0, 0.0, 0.0) }
        } else if id == 1 || id == 4 {
            Mat { albedo: shell, rough: rough_shell, metal: metal_shell, glow: vec3(0.0, 0.0, 0.0) }
        } else if id == 2 {
            Mat { albedo: vec3(0.9, 0.9, 0.92), rough: 0.2, metal: 1.0, glow: vec3(0.0, 0.0, 0.0) }
        } else if id == 3 {
            Mat { albedo: vec3(0.08, 0.08, 0.09), rough: 0.8, metal: 0.0, glow: vec3(0.0, 0.0, 0.0) }
        } else if id >= 10 && id <= 13 {
            Mat { albedo: button_color, rough: 0.25, metal: 0.0, glow: if lit { button_color * 2.5 } else { vec3(0.0, 0.0, 0.0) } }
        } else if id == 14 {
            let held = depth(14) + depth(15) + depth(16) + depth(17) > 0.0;
            Mat { albedo: vec3(0.12, 0.12, 0.13), rough: 0.5, metal: 0.0, glow: if held { accent(scheme) * 1.5 } else { vec3(0.0, 0.0, 0.0) } }
        } else {
            let held = id == 18 && depth(18) > 0.0;
            Mat { albedo: vec3(0.15, 0.15, 0.16), rough: 0.4, metal: 0.0, glow: if held { accent(scheme) * 1.5 } else { vec3(0.0, 0.0, 0.0) } }
        };
    }

    // ---- lighting: a warm key, a cool fill, a sky, GGX specular ----
    fn sky(dir: Vec3) -> Vec3 {
        let up = clamp(dir.y, 0.0, 1.0);
        let horizon = mix(vec3(0.12, 0.13, 0.16), vec3(0.35, 0.42, 0.55), up);
        let window = pow(clamp(dot(dir, normalize(vec3(-0.4, 0.5, 0.75))), 0.0, 1.0), 40.0) * 6.0;
        return horizon + vec3(window, window, window) * vec3(1.0, 0.97, 0.9);
    }

    fn ggx(n: Vec3, v: Vec3, l: Vec3, rough: Float, f0: Vec3) -> Vec3 {
        let h = normalize(v + l);
        let a = max(rough * rough, 0.002);
        let ndh = clamp(dot(n, h), 0.0, 1.0);
        let ndv = clamp(dot(n, v), 0.001, 1.0);
        let ndl = clamp(dot(n, l), 0.0, 1.0);
        let d = a * a / (3.14159 * pow(ndh * ndh * (a * a - 1.0) + 1.0, 2.0));
        let k = (rough + 1.0) * (rough + 1.0) / 8.0;
        let g = (ndv / (ndv * (1.0 - k) + k)) * (ndl / (ndl * (1.0 - k) + k));
        let f = f0 + (vec3(1.0, 1.0, 1.0) - f0) * pow(1.0 - clamp(dot(h, v), 0.0, 1.0), 5.0);
        return f * (d * g / max(4.0 * ndv * ndl, 0.001)) * ndl;
    }

    fn shade(p: Vec3, n: Vec3, v: Vec3, m: Mat, reflection: Vec3) -> Vec3 {
        let key_dir = normalize(vec3(-0.5, 0.9, 0.6));
        let fill_dir = normalize(vec3(0.7, 0.4, -0.5));
        let f0 = mix(vec3(0.04, 0.04, 0.04), m.albedo, m.metal);
        let diffuse_color = m.albedo * (1.0 - m.metal);
        let shadowed = shadow(p + n * 0.02, key_dir);
        let key = vec3(1.0, 0.95, 0.88) * 3.2 * clamp(dot(n, key_dir), 0.0, 1.0) * shadowed;
        let fill = vec3(0.6, 0.7, 0.9) * 0.6 * clamp(dot(n, fill_dir), 0.0, 1.0);
        let ao = occlusion(p, n);
        let ambient = sky(n) * 0.35 * ao;
        let spec = ggx(n, v, key_dir, m.rough, f0) * vec3(1.0, 0.95, 0.88) * 3.2 * shadowed
            + ggx(n, v, fill_dir, m.rough, f0) * vec3(0.6, 0.7, 0.9) * 0.6;
        let fresnel = f0 + (vec3(1.0, 1.0, 1.0) - f0) * pow(1.0 - clamp(dot(n, v), 0.0, 1.0), 5.0);
        let gloss = (1.0 - m.rough) * (1.0 - m.rough);
        return diffuse_color * (key + fill + ambient) + spec + reflection * fresnel * gloss * ao + m.glow;
    }

    // ---- the toolbar: a translucent bar with four icons ----
    fn icon(item: Int, u: Vec2, scheme: Int, finish: Int, spin: Bool) -> Float {
        // `u` is the pixel within the 64x48 item, centred on zero.
        let r = length(u);
        return if item == 0 { if r < 9.0 { 1.0 } else { 0.0 } }
            else if item == 1 { if r < 10.0 { 0.35 + 0.65 * pow(clamp(1.0 - length(u - vec2(-3.0, -3.0)) / (4.0 + float(finish) * 4.0), 0.0, 1.0), 2.0) } else { 0.0 } }
            else if item == 2 { if abs(r - 9.0) < 1.5 && !(u.y > 4.0 && u.x > 0.0) { if spin { 1.0 } else { 0.5 } } else { 0.0 } }
            else { if abs(u.x) < 1.2 && abs(u.y) < 9.0 || abs(u.y) < 1.2 && abs(u.x) < 9.0 { 0.8 } else { 0.0 } };
    }

    compute {
        let s = at(state, 0);
        let c = coord();
        let extent = domain();
        // Camera on an orbit, looking at the pad.
        let yaw = s.yaw + s.spun;
        let eye = vec3(sin(yaw) * cos(s.pitch), sin(s.pitch), cos(yaw) * cos(s.pitch)) * 3.1;
        let target = vec3(0.0, -0.05, -0.1);
        let fwd = normalize(target - eye);
        let right = normalize(cross(fwd, vec3(0.0, 1.0, 0.0)));
        let upv = cross(right, fwd);
        let uv = (c - extent * 0.5) / extent.y;
        let dir = normalize(fwd * 1.7 + right * uv.x - upv * uv.y);
        let hit = march(eye, dir);
        let color = if hit.id >= 0.0 {
            let p = eye + dir * hit.t;
            let n = normal(p);
            let m = material(int(hit.id), s.scheme, s.finish, p);
            // One bounce for the reflections: what the mirror direction sees.
            let rd = reflect(dir, n);
            let bounce = march_pad(p + n * 0.03, rd);
            let reflection = if bounce.id >= 0.0 {
                let bp = p + n * 0.03 + rd * bounce.t;
                let bn = normal(bp);
                let bm = material(int(bounce.id), s.scheme, s.finish, bp);
                let key_dir = normalize(vec3(-0.5, 0.9, 0.6));
                let seen = bm.albedo * (1.0 - bm.metal) * (vec3(1.0, 0.95, 0.88) * 3.2 * clamp(dot(bn, key_dir), 0.0, 1.0) * 0.6 + sky(bn) * 0.35) + bm.glow;
                // Farther reflections blur into the sky, as a glossy floor's do.
                mix(seen, sky(rd), clamp(bounce.t * 0.25, 0.0, 0.8))
            } else { sky(rd) };
            shade(p, n, -dir, m, reflection)
        } else { sky(dir) * 0.6 };
        // Tone map (an ACES fit), then gamma.
        let e = color * exposure;
        let mapped = clamp((e * (e * 2.51 + vec3(0.03, 0.03, 0.03))) / (e * (e * 2.43 + vec3(0.59, 0.59, 0.59)) + vec3(0.14, 0.14, 0.14)), vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0));
        let srgb = pow(mapped, vec3(1.0 / 2.2, 1.0 / 2.2, 1.0 / 2.2));
        // The toolbar over everything, centred at the bottom; laid out in
        // logical pixels, the window's scale factor being the unit.
        let unit = scale();
        let q = (c + vec2(0.5, 0.5)) / unit;
        let left = extent.x / unit * 0.5 - 146.0;
        let bottom = extent.y / unit;
        let bar_top = bottom - 56.0;
        let in_bar = q.y >= bar_top && q.y <= bottom - 8.0 && q.x >= left - 12.0 && q.x <= left + 304.0;
        let slot = int(floor((q.x - left) / 76.0));
        let u = vec2(q.x - left - float(slot) * 76.0 - 32.0, q.y - bar_top - 24.0);
        let in_item = in_bar && slot >= 0 && slot < 4 && u.x >= -32.0 && u.x <= 32.0;
        let hovered = in_item && slot == s.hover;
        let glyph = if in_item { icon(slot, u, s.scheme, s.finish, s.spin) } else { 0.0 };
        let tint = if slot == 0 { accent(s.scheme) } else { vec3(0.92, 0.92, 0.95) };
        let bar = if in_bar { mix(srgb, vec3(0.06, 0.06, 0.08), 0.75) } else { srgb };
        let item_bg = if hovered { mix(bar, vec3(0.2, 0.2, 0.24), 0.6) } else { bar };
        let final_color = mix(item_bg, tint, glyph);
        return vec4(final_color.x, final_color.y, final_color.z, 1.0);
    }
}
