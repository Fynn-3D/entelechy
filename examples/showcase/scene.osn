// begin seeds the state; state feeds back; render is the picture.
use "kernels/";

node begin: show.begin@1 { domain = 1; }
node state: show.state@1 { previous <~ state.result from begin.result; }
node view: show.render@1 { state <- state.result; domain = vec2(1280, 720); }

output result <- view.result;
