// The showcase at a sixteenth of the pixels, so the CPU can replay it.
use "../kernels/";

node begin: show.begin@1 { domain = 1; }
node state: show.state@1 { previous <~ state.result from begin.result; width = 320.0; height = 180.0; }
node view: show.render@1 { state <- state.result; domain = vec2(320, 180); }

output result <- view.result;
