// The showcase as the replay sees it: the window is the replay's, a
// sixty-fourth of the pixels at an eighth of the scale, so the CPU can
// replay it.
use "../kernels/";

node begin: show.begin@1 { domain = 1; }
node state: show.state@1 { previous <~ state.result from begin.result; }
node view: show.render@1 { state <- state.result; domain = window(); }

output result <- view.result;
