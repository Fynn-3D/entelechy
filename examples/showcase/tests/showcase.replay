scene showcase.esn

# A 160 by 90 window at an eighth of the scale: a sixty-fourth of the
# pixels, the toolbar laid out at an eighth size, so its items are centered
# at x 65.75, 75.25, 84.75, 94.25 and y 86.
window 160 90 0.125
frame 0.0
expect state.result[0].scheme = 0
expect state.result[0].spin = true
expect 4 4 = 0.484 0.492 0.539 0.02          # the sky behind, top-left

# A click on the first item cycles the color; on the third stops the turntable.
pointer 65.75 86 down
frame 0.02
pointer up
frame 0.03
expect state.result[0].scheme = 1
pointer 84.75 86 down
frame 0.05
pointer up
frame 0.07
expect state.result[0].spin = false
expect state.result[0].hover = 2

# A drag on the picture orbits the camera: forty pixels are 0.32 of yaw.
pointer 100 60 down
frame 0.08
pointer 140 60 down
frame 0.1
pointer up
frame 0.12
expect state.result[0].yaw = 0.92 0.001
expect state.result[0].dragging = false

# The last item resets the view.
pointer 94.25 86 down
frame 0.13
pointer up
frame 0.15
expect state.result[0].yaw = 0.6 0.001
expect state.result[0].spun = 0.0 0.001
