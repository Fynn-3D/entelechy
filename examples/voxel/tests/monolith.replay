frame 15.8
button middle down
frame 15.9
pointer 355 295 up
frame 16.0
pointer 410 290 up
frame 16.1
button middle up
frame 16.2
expect state.result[0].yaw = 1.580 0.001
expect state.result[0].pitch = 0.620 0.001
pointer 900 60 up
frame 16.3

# The picture: the crown red, the spire gold, a lantern white, the step
# blue, where the camera puts them.
expect 342 60 = 0.851 0.431 0.381 0.03    # the ruby crown
expect 340 184 = 0.542 0.493 0.258 0.03    # the golden spire
expect 413 320 = 0.889 0.878 0.856 0.03    # a lantern
expect 360 360 = 0.223 0.310 0.441 0.03    # the blue step
