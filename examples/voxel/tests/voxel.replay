scene voxel.osn

# A quarter of the pixels: the bar's items are centred at x 50, 126,
# 202, 278, 354, 430 and y 238; the middle of the picture, (240, 157),
# looks down on the top of the tree, voxel (27, 11, 27).
frame 0.0
pointer 240 157 up
frame 0.02
expect state.result[0].found = true
expect state.result[0].hit = 27 11 27
expect state.result[0].face = 0 1 0
expect state.result[0].tool = 0
expect 4 4 = 0.205 0.213 0.237 0.02          # the sky is dark

# The left button places a white voxel on that face at once, (27, 12,
# 27) at 62811, and again every fourth frame while held: the pointer
# then sees the new voxel's near face, so (27, 12, 28) at 65115 follows.
pointer 240 157 down
frame 0.03
expect state.result[0].apply = true
expect state.result[0].begin = true
expect world.result[62811] = 1
frame 0.05
frame 0.07
frame 0.08
expect world.result[65115] = 0
frame 0.1
expect state.result[0].apply = true
expect state.result[0].begin = false
expect world.result[65115] = 1
pointer up
frame 0.12

# Z undoes the whole stroke, and Z again brings it back.
key 90 down
frame 0.13
expect world.result[62811] = 0
expect world.result[65115] = 0
key 90 up
frame 0.15
key 90 down
frame 0.17
expect world.result[62811] = 1
expect world.result[65115] = 1
key 90 up
frame 0.18
key 90 down
frame 0.2
key 90 up
frame 0.22
expect world.result[62811] = 0

# The middle button orbits: sixty pixels are 0.48 of yaw.
pointer 100 100 up
frame 0.23
button middle down
frame 0.25
pointer 130 100 up
frame 0.27
pointer 160 100 up
frame 0.28
button middle up
frame 0.3
expect state.result[0].yaw = 1.18 0.001
expect state.result[0].pitch = 0.5 0.001

# With Shift the middle button pans, by what the pointer covers.
pointer 100 100 up
key 16 down
frame 0.32
button middle down
frame 0.33
pointer 130 120 up
frame 0.35
button middle up
frame 0.37
key 16 up
frame 0.38
expect state.result[0].pan = -2.5013 2.1634 2.9688 0.002
expect state.result[0].yaw = 1.18 0.001

# The wheel zooms in.
wheel 0 1
frame 0.4
expect state.result[0].zoom = 0.72 0.001

# The right button erases whatever the tool, and holding it keeps
# erasing; the voxel first under the pointer here is (24, 12, 28), 65112.
pointer 240 157 up
frame 0.42
expect state.result[0].hit = 24 12 28
button right down
frame 0.43
expect state.result[0].act = 1
expect world.result[65112] = 0
frame 0.45
frame 0.47
frame 0.48
frame 0.5
button right up
frame 0.52
key 90 down
frame 0.53
expect world.result[65112] = 3                # undo restores the stroke
key 90 up
frame 0.55

# The last item resets the model and the view.
pointer 430 238 down
frame 0.57
pointer up
frame 0.58
expect state.result[0].yaw = 0.7 0.001
expect state.result[0].pan = 0 0 0
expect state.result[0].zoom = 0.8 0.001
