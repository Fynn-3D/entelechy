scene voxel.osn

# A 240 by 135 window at a quarter of the scale: a sixteenth of the
# pixels, the bar laid out at a quarter size, so its items are centred
# at x 72.5, 91.5, 110.5, 129.5, 148.5, 167.5 and y 127; the middle of
# the picture, (120, 78), looks down on the top of the tree, voxel
# (27, 11, 27).
window 240 135 0.25
frame 0.0
pointer 120 78 up
frame 0.02
expect state.result[0].found = true
expect state.result[0].hit = 27 11 27
expect state.result[0].face = 0 1 0
expect state.result[0].tool = 0
expect 4 4 = 0.205 0.213 0.237 0.02          # the sky is dark

# The label at the top left reads "place  27 11 27": at a quarter of the
# scale its glyphs are one texel per pixel from (3, 3), so the p's bowl
# is ink at (3, 5), the 2's top row at (46, 3), the 7's at (51, 3).
expect label.result[0].code = 112
expect label.result[7].code = 50
expect label.result[8].code = 55
expect label.result[10].code = 49
expect 3 5 = 0.972 0.972 0.983 0.02
expect 46 3 = 0.972 0.972 0.983 0.02
expect 51 3 = 0.972 0.972 0.983 0.02

# Over the second item the label names it, "erase", and the voxel under
# the pointer is gone, so the numbers are dashes; an e's bowl starts one
# pixel to the right of a p's.
pointer 91.5 127 up
frame 0.025
expect label.result[0].code = 101
expect label.result[7].code = 45
expect 4 5 = 0.972 0.972 0.983 0.02

# The left button places a white voxel on that face at once, (27, 12,
# 27) at 62811, and again every fourth frame while held: the pointer
# then sees the new voxel's near face, so (27, 12, 28) at 65115 follows.
pointer 120 78 down
frame 0.03
expect state.result[0].apply = true
expect state.result[0].begin = true
expect world.result[62811] = 1
frame 0.05
frame 0.07
frame 0.08
expect world.result[65115] = 0
frame 0.1
expect state.result[0].apply = true
expect state.result[0].begin = false
expect world.result[65115] = 1
pointer up
frame 0.12

# Z undoes the whole stroke, and Z again brings it back.
key 90 down
frame 0.13
expect world.result[62811] = 0
expect world.result[65115] = 0
key 90 up
frame 0.15
key 90 down
frame 0.17
expect world.result[62811] = 1
expect world.result[65115] = 1
key 90 up
frame 0.18
key 90 down
frame 0.2
key 90 up
frame 0.22
expect world.result[62811] = 0

# The middle button orbits: sixty pixels are 0.48 of yaw.
pointer 100 100 up
frame 0.23
button middle down
frame 0.25
pointer 130 100 up
frame 0.27
pointer 160 100 up
frame 0.28
button middle up
frame 0.3
expect state.result[0].yaw = 1.18 0.001
expect state.result[0].pitch = 0.5 0.001

# With Shift the middle button pans, by what the pointer covers.
pointer 100 100 up
key 16 down
frame 0.32
button middle down
frame 0.33
pointer 130 120 up
frame 0.35
button middle up
frame 0.37
key 16 up
frame 0.38
expect state.result[0].pan = -5.0027 4.3268 5.9376 0.003
expect state.result[0].yaw = 1.18 0.001

# The wheel zooms in.
wheel 0 1
frame 0.4
expect state.result[0].zoom = 0.72 0.001

# The right button erases whatever the tool, and holding it keeps
# erasing; after the pan the pointer is over the ground, (0, 0, 22), 50688.
pointer 120 78 up
frame 0.42
expect state.result[0].hit = 0 0 22
button right down
frame 0.43
expect state.result[0].act = 1
expect world.result[50688] = 0
frame 0.45
frame 0.47
frame 0.48
frame 0.5
button right up
frame 0.52
key 90 down
frame 0.53
expect world.result[50688] = 8                # undo restores the stroke
key 90 up
frame 0.55

# The last item resets the model and the view.
pointer 167.5 127 down
frame 0.57
pointer up
frame 0.58
expect state.result[0].yaw = 0.7 0.001
expect state.result[0].pan = 0 0 0
expect state.result[0].zoom = 0.8 0.001
