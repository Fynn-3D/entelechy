// seed is the starting model; state feeds back and reads last frame's
// world to find the voxel under the pointer; world applies the edit;
// backup keeps the version before it; view is the picture, which fills
// the window at the window's resolution.
use "kernels/";

input font: Grid<Float> = "../shared/font.png";
input names: Rows<Int> = text "place erase paint colourundo  reset ";

node seed: voxel.seed@1 { domain = vec3(48, 48, 48); }
node begin: voxel.begin@1 { domain = 1; }

node state: voxel.state@1 {
    previous <~ state.result from begin.result;
    voxels <~ world.result from seed.result;
}
node world: voxel.edit@1 {
    previous <~ world.result from seed.result;
    backup <~ backup.result from seed.result;
    origin <- seed.result;
    state <- state.result;
}
node backup: voxel.keep@1 {
    previous <~ backup.result from seed.result;
    world <~ world.result from seed.result;
    state <- state.result;
}
node label: voxel.label@1 { state <- state.result; names <- names; domain = 15; }
node view: voxel.draw@1 { voxels <- world.result; state <- state.result; label <- label.result; font <- font; domain = window(); }

output result <- view.result;
