// A crypt drawn with the voxel package: a chamber of 48 by 24 by 48
// voxels of a quarter meter, baked once (flagstones, brick walls, four
// pillars, a vault, torches on the walls, a pool of water in a corner),
// and a statue in a box of its own at the middle, turning. A ray a pixel
// walks the chamber and the statue's box; by firelight (the torches and
// a lantern going round) the far is swallowed by the dark, by daylight
// (the vault open to the sky) the sun casts shadows, the water is seen
// through to the pool's floor, and the far fades into haze.
use "../../../../../packages/voxel.entpkg";
use "../../../../../packages/geometry.entpkg";

// Light as a game without a renderer draws it: the sky and a sun on a face, lights of
// its own, kept to few tones, swallowed by haze or the dark.
/// The light of a sky and a sun on a face: the sky's light `sky` by the
/// share of the sky the face sees, all of it facing up, half facing
/// sideways, none facing down; the sun's light `sun` by how square the
/// face turns to it (`toward` a unit direction toward it), unless
/// `shaded`. A look keeps it to steps (`light_stepped`) as it chooses.
fn plain_daylight(face: Vec3, toward: Vec3, shaded: Bool, sky: Vec3, sun: Vec3) -> Vec3 {
    let direct = if shaded { 0.0 } else { max(dot(face, toward), 0.0) };
    return sky * (0.5 + 0.5 * face.y) + sun * direct;
}

/// A light at `at`, of `color`, reaching `reach` world units, falling off
/// with the square of the share of that it has come.
struct PlainLight { at: Vec3; reach: Float; color: Vec3; }

/// A light's color on a face at `p`: falling off with distance, brighter
/// on faces turned to it.
fn plain_light(p: Vec3, face: Vec3, l: PlainLight) -> Vec3 {
    let to = l.at - p;
    let d = length(to);
    let fall = saturate(1.0 - d / l.reach);
    let facing = 0.35 + 0.65 * max(dot(face, to / max(d, 0.001)), 0.0);
    return l.color * fall * fall * facing;
}

/// A flame's flicker at a place and time, 0.8 to 1.
fn flame_flicker(time: Float, p: Vec3) -> Float { return 0.9 + 0.1 * sin(time * 13.0 + p.x) * sin(time * 7.0 + p.z); }

/// Light kept to `steps` steps a channel, as pixel art keeps it.
fn light_stepped(light: Vec3, steps: Float) -> Vec3 { return floor(light * steps + 0.5) / steps; }

/// A color seen through haze to `color_of_haze`, the more the farther
/// (`thickness` a world unit).
fn plain_haze(color: Vec3, distance: Float, thickness: Float, color_of_haze: Vec3) -> Vec3 {
    return mix(color, color_of_haze, saturate(1.0 - exp(-distance * thickness)));
}

/// A color swallowed by the dark: kept by e to the minus `distance` over
/// `depth`, so at `depth` world units a little over a third is left.
fn plain_dark(color: Vec3, distance: Float, depth: Float) -> Vec3 { return color * exp(-distance / depth); }

type Stone = enum { Air, Flagstone, Brick, Rock, Water, Torch, Iron, Marble, Gold };

fn crypt_color(id: Stone) -> Vec3 {
    return match id {
        Stone.Flagstone => vec3(0.36, 0.34, 0.33),
        Stone.Brick => vec3(0.52, 0.3, 0.22),
        Stone.Rock => vec3(0.45, 0.45, 0.48),
        Stone.Water => vec3(0.2, 0.35, 0.5),
        Stone.Torch => vec3(1.0, 0.75, 0.3),
        Stone.Iron => vec3(0.2, 0.2, 0.22),
        Stone.Marble => vec3(0.85, 0.84, 0.8),
        _ => vec3(0.95, 0.75, 0.25),
    };
}
fn glows(id: Stone) -> Bool { return id == Stone.Torch; }

/// The chamber's measures: voxels a side, meters a voxel.
fn chamber() -> Vec3 { return vec3(48.0, 24.0, 48.0); }
fn grain() -> Float { return 0.25; }

/// The torches, k 0 to 3, on the walls' middles, 2 m up, in meters from
/// the chamber's floor middle.
fn torch_at(k: Int) -> Vec3 {
    return match k { 0 => vec3(5.6, 2.0, 0.0), 1 => vec3(-5.6, 2.0, 0.0), 2 => vec3(0.0, 2.0, 5.6), _ => vec3(0.0, 2.0, -5.6) };
}

/// The chamber at a voxel: `open` its vault open to the sky.
fn chamber_at(c: IVec3, open: Bool) -> Stone {
    let m = (float(c) + 0.5) * grain() - vec3(6.0, 0.0, 6.0);
    let pool = m.x > 2.5 && m.z > 2.5 && m.x < 5.0 && m.z < 5.0;
    if m.y < 0.5 {
        return if pool && m.y >= 0.25 { Stone.Air } else if fract(m.x * 0.8) < 0.08 || fract(m.z * 0.8) < 0.08 { Stone.Rock } else { Stone.Flagstone };
    }
    if pool && m.y < 0.75 { return Stone.Water; }
    let wall = abs(m.x) > 5.75 || abs(m.z) > 5.75;
    let vault = 5.5 - 0.06 * (m.x * m.x + m.z * m.z) * 0.25;
    if wall { return if fract(m.y * 2.0) < 0.15 { Stone.Rock } else { Stone.Brick }; }
    if !open && m.y > vault { return Stone.Rock; }
    let torch = loop 4 with hit = Stone.Air until hit != Stone.Air {
        let t = torch_at(index());
        let d = m - t;
        if length(d) < 0.2 { Stone.Torch } else if abs(d.x) < 0.1 && abs(d.z) < 0.1 && d.y < -0.1 && d.y > -0.5 { Stone.Iron } else { Stone.Air }
    };
    if torch != Stone.Air { return torch; }
    let pillar = length(abs(m.xz) - 3.0) < 0.45 && !(m.x > 2.0 && m.z > 2.0);
    return if pillar { Stone.Rock } else { Stone.Air };
}

kernel crypt.bake@1 {
    requires { field.write; }
    param open: Int = 0;
    output result: Voxels;
    compute { return chamber_at(icoord(), open != 0); }
}

/// The statue: a figure on a plinth in a box of 16 by 24 by 16 voxels, a
/// gold crown, its arm held out (so its turning shows).
fn statue_at(c: IVec3) -> Stone {
    let q = float(c) + 0.5 - vec3(8.0, 0.0, 8.0);
    if q.y < 3.0 { return if abs(q.x) < 4.0 && abs(q.z) < 4.0 { Stone.Rock } else { Stone.Air }; }
    let body = length(q.xz / vec2(2.2, 1.6)) < 1.0 && q.y < 15.0;
    let head = length(q - vec3(0.0, 17.0, 0.0)) < 2.2;
    let crown = q.y > 18.5 && q.y < 20.0 && abs(length(q.xz) - 1.6) < 0.5;
    let arm = q.y > 11.0 && q.y < 12.5 && q.x > 1.5 && q.x < 7.0 && abs(q.z) < 0.8;
    return if crown { Stone.Gold } else if body || head || arm { Stone.Marble } else { Stone.Air };
}

kernel crypt.statue@1 {
    requires { field.write; }
    output result: Voxels;
    compute { return statue_at(icoord()); }
}

/// The picture: the camera going round the chamber's middle; by
/// firelight or (`open`) by day.
kernel crypt.draw@1 {
    requires { field.read; field.write; time.read; }
    input chamber: Voxels;
    input statue: Voxels;
    param open: Int = 0;
    output result: Image;
    compute {
        let t = time();
        let dims = domain();
        let cam = lens_orbiting(vec3(0.0, 1.5, 0.0), t * 0.3 + 0.6, 0.35, 6.0, 0.9);
        let dir = ray(cam, coord(), dims);
        let room = VoxelBox { base: vec3(0.0, 0.0, 0.0), n: chamber(), size: grain(), foot: vec3(0.0, 0.0, 0.0), turn: 0.0 };
        let figure = VoxelBox { base: vec3(0.0, 0.0, 0.0), n: vec3(16.0, 24.0, 16.0), size: 0.1, foot: vec3(0.0, 0.5, 0.0), turn: t * 0.8 };
        // By day the water is seen through.
        let pass = if open != 0 { ivec2(4, 4) } else { ivec2(1, 0) };
        let met = voxel_nearer(voxel_meet_past(chamber, room, cam.eye, dir, 0.3, pass), voxel_meet(statue, figure, cam.eye, dir, 0.0));
        if met.id == Stone.Air {
            let sky = mix(vec3(0.75, 0.82, 0.92), vec3(0.35, 0.5, 0.8), saturate(dir.y));
            return if open != 0 { vec4(sky, 1.0) } else { vec4(0.0, 0.0, 0.0, 1.0) };
        }
        let p = cam.eye + dir * met.t;
        if glows(met.id) { let g = crypt_color(met.id) * 1.1; return vec4(g, 1.0); }
        if open != 0 {
            let sun = normalize(vec3(0.4, 0.8, 0.3));
            let at = voxel_local(p + met.face * 0.01, vec3(0.0, 0.0, 0.0), 0.0, grain()) + vec3(24.0, 0.0, 24.0);
            let shaded = voxel_shaded(chamber, at, sun, vec3(0.0, 0.0, 0.0), chamber(), pass);
            let day = plain_daylight(met.face, sun, shaded, vec3(0.4, 0.46, 0.6), vec3(0.95, 0.85, 0.65));
            let lit = crypt_color(met.id) * light_stepped(day, 7.0);
            let far = plain_haze(lit, met.t, 0.05, vec3(0.75, 0.8, 0.88));
            return vec4(far, 1.0);
        }
        let flicker = flame_flicker(t, p);
        let torches = loop 4 with sum = vec3(0.0, 0.0, 0.0) { sum + plain_light(p, met.face, PlainLight { at: torch_at(index()), reach: 7.0, color: vec3(1.0, 0.62, 0.3) }) * flicker };
        let lantern = plain_light(p, met.face, PlainLight { at: vec3(cos(t) * 3.5, 1.2, sin(t) * 3.5), reach: 6.0, color: vec3(0.9, 0.85, 0.7) });
        let light = light_stepped(vec3(0.04, 0.045, 0.07) + torches + lantern, 7.0);
        let seen = plain_dark(crypt_color(met.id) * light, met.t, 14.0);
        return vec4(seen, 1.0);
    }
}
