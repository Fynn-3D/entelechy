// The packed part on its own: its picture and tile map read from files
// beside it, stored as narrow as the graph's inputs say.
input albedo: Grid<Vec4 as unorm8> = "albedo.png";
input tiles: Rows<Int as u8> = bytes "tiles.bin";

param turn: Float = 0.0;

node packed: graph "packed.osn" { albedo <- albedo; tiles <- tiles; turn = turn; }

output result <- packed.result;
