// A tile map: a Grid<Tile> of exact integers and booleans, flooded a step
// per frame through Graph state, and drawn through an atlas image. Two
// grids of different element types meet in `render`.
// A kind is also its sprite's place in the atlas.
type Kind = enum { Grass, Sand, Rock, Water };
struct Tile { kind: Kind; height: Float; passable: Bool; }
type Map = Grid<Tile>;

/// Rock lies on a fixed lattice so the map is deterministic; the spring
/// is at `source`.
kernel tiles.generate@1 {
    requires { field.write; }
    param source: Vec2 = vec2(0.0, 0.0);
    output result: Map;

    fn hash(p: Vec2) -> Float {
        // Sin-free so the CPU and GPU agree on every tile.
        let q = fract(p * vec2(0.1031, 0.1030));
        let d = dot(q, q.yx + 33.33);
        let r = q + d;
        return fract((r.x + r.y) * (r.x - r.y + 1.0));
    }

    compute {
        let c = coord();
        let lattice = fract((c.x * 3.0 + c.y * 5.0) / 7.0);
        let rock = lattice > 0.1 && lattice < 0.2;
        let h = hash(c);
        let kind = if c == source { Kind.Water } else if rock { Kind.Rock } else if h < 0.7 { Kind.Grass } else { Kind.Sand };
        return Tile { kind: kind, height: h, passable: kind != Kind.Rock };
    }
}

/// Water spreads to the four passable neighbours every frame.
kernel tiles.flood@1 {
    requires { field.read; field.write; }
    input previous: Map;
    output result: Map;

    fn wet(p: Vec2) -> Bool {
        return at(previous, p).kind == Kind.Water;
    }

    compute {
        let c = coord();
        let me = sample(previous);
        let neighbour = wet(c - vec2(1.0, 0.0)) || wet(c + vec2(1.0, 0.0)) || wet(c - vec2(0.0, 1.0)) || wet(c + vec2(0.0, 1.0));
        return if me.passable && neighbour { Tile { ..me, kind: Kind.Water } } else { me };
    }
}

/// The atlas: one 16x16 sprite per kind, side by side. Flat in the middle,
/// darker at the edge, so the map reads as tiles.
kernel tiles.atlas@1 {
    requires { field.write; }
    output result: Image;

    compute {
        let c = coord();
        let column = floor(c.x / 16.0);
        let u = c.x - column * 16.0;
        let base = match int(column) {
            Kind.Grass => vec3(0.35, 0.65, 0.3),
            Kind.Sand => vec3(0.85, 0.75, 0.5),
            Kind.Rock => vec3(0.45, 0.45, 0.5),
            _ => vec3(0.2, 0.45, 0.85),
        };
        let edge = u < 1.0 || u > 14.0 || c.y < 1.0 || c.y > 14.0;
        let color = if edge { base * 0.7 } else { base };
        return vec4(color, 1.0);
    }
}

/// Every pixel finds its tile, then its sprite pixel in the atlas.
kernel tiles.render@1 {
    requires { field.read; field.write; }
    input map: Map;
    input atlas: Image;
    param tile: Float = 16.0;
    output result: Image;

    compute {
        let px = coord();
        let cell = floor(px / tile);
        let t = at(map, cell);
        let local = floor((px - cell * tile) / tile * 16.0);
        let sprite = at(atlas, vec2(float(t.kind) * 16.0 + local.x, local.y));
        let shade = 0.85 + 0.15 * t.height;
        return vec4(sprite.rgb * shade, 1.0);
    }
}
