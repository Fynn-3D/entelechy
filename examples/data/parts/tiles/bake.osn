// Bakes the atlas the render reads: the sprites are arithmetic in
// tiles.atlas, and this scene saves them as the file the part scene uses.
//   orla run examples/data/parts/tiles/bake.osn \
//     --save atlas=examples/data/parts/tiles/assets/atlas.png
use "kernels/";

node atlas: tiles.atlas@1 { domain = vec2(64, 16); }

output result <- atlas.result;
