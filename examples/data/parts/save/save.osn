// Press space to count. The tally starts from `saved`, which whoever
// places this graph supplies: `scene.osn` reads it from the file the
// count was last written to.
use "kernels/";

input saved: Rows<Tally>;

node tally: save.tally@1 { last <~ tally.result from saved; }
node show: save.show@1 { tally <- tally.result; domain = vec2(160, 160); }

output picture <- show.result;
output kept <- tally.result;
