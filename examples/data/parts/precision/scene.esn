use "kernels/";

// Where the part sits, in meters for the drawing and in nanometers for
// the geometry; the ring is drawn around the one, the part measured at
// the other.
param origin: DVec2 = dvec2(500000.123456789, 4000000.987654321);

node ring: precision.ring@1 { origin = origin; domain = vec2(160, 90); }
node corners: precision.corners@1 { domain = 4; }
node edges: precision.edges@1 { corners <- corners.result; domain = 4; }

output result <- ring.result;
