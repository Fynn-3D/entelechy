scene ../scene.osn

# Four panels of 304 x 184 pixels, eight in from each quarter of a
# 640 x 400 window, each part's picture as large as fits: packed and
# precision at 1.9 window pixels a pixel, tiles at 0.7667, save at 1.15.
window 640 400
frame 0.0

# The border between panels.
expect 0 0 = 0.03 0.03 0.04
expect 320 200 = 0.03 0.03 0.04

# Top left, packed: its pixel (80, 45), as its own replay sees it.
expect 161 101 = 0.299 0.270 0.253

# Top right, precision: floats find every pixel inside the ring, at its
# (5, 5); doubles find the centre inside, at (85, 45), and the corner
# outside, at (155, 5).
expect 338 25 = 1.0 0.55 0.1
expect 490 101 = 1.0 0.55 0.1
expect 623 25 = 0.08 0.1 0.14

# Bottom left, tiles: the spring at tile (3, 7) is water, the tile (5, 0)
# rock.
expect 80 301 = 0.2 0.45 0.85 0.15
expect 105 214 = 0.45 0.45 0.5 0.1

# Bottom right, save: the tally starts from nothing; a press of space
# lights the first cell and not the second.
expect 397 217 = 0.12 0.13 0.18
key 32 down
frame 0.1
expect 397 217 = 0.95 0.75 0.3
expect 416 217 = 0.12 0.13 0.18
