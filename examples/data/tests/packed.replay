scene ../parts/packed/scene.esn

# The first frame: a height kept in 16 bits, a normal in three signed
# bytes (each a whole number of 127ths), the light in half floats, a
# quarter of the way from dark. A device's sine may land one step of
# the encoding away, which is what the tolerances allow and no more.
frame 0.0
expect count packed.normal.result = 14400
expect packed.height.result[4880] = 0.32680246 0.0001
expect packed.normal.result[4880] = -0.4094488 -0.28346455 0.86614174 0.0081
expect packed.light.result[4880] = 0.24536133 0.24536133 0.26342773 0.25 0.001
expect 80 45 = 0.299 0.270 0.253

# Two frames later the half floats have carried the light on.
frame 0.5
frame 1.0
expect packed.light.result[4880] = 0.5229492 0.5229492 0.56103516 0.578125 0.002
expect 80 45 = 0.519 0.483 0.460
expect 20 70 = 0.508 0.462 0.429

# The ground turns under the same light.
param turn 1.5
frame 1.5
expect packed.height.result[4880] = 0.5761654 0.0001
expect 80 45 = 0.559 0.523 0.501
