scene ../scene.osn
window 800 460

# Four lines joined by new lines: 18, 18, 23 and 18 characters and three
# breaks between them.
frame 0
expect count four.result = 80
expect four.result[18] = 10
expect lines.layout.result[18].glyph = -1

# Each line starts again at x 46, the font's line below the one before:
# ascent 1.069 less descent -0.293 plus gap 0, of 28 pixels an em.
expect lines.layout.result[0].origin = 46.0 200.0 0.001
expect lines.layout.result[19].origin = 46.0 238.136 0.001
expect lines.layout.result[38].origin = 46.0 276.272 0.001
expect lines.layout.result[62].origin = 46.0 314.408 0.001

# The Chinese line is its font's glyphs, each an em wide.
expect written.layout.result[0].glyph >= 1
expect written.layout.result[1].origin = 74.0 400.0 0.001
