scene type.osn
window 600 300

# Each character is placed at the pen, which moves by its advance: from
# x 20, "I" moves it 339 of the font's 1000 units an em and "o" 605, at
# 200 pixels an em.
frame 0
expect latin_type.layout.result[0].origin = 20.0 220.0 0.0001
expect latin_type.layout.result[1].origin = 87.8 220.0 0.001
expect latin_type.layout.result[2].origin = 208.8 220.0 0.001

# Worked out from the glyphs' boxes, y up in ems below the baseline at
# y 220: the middle of the stem of "I" (0.04 to 0.298 across, 0 to
# 0.714 up) and of "l" (0.085 to 0.173, 0 to 0.76) are ink; the middle of
# "o" (0.055 to 0.551, -0.01 to 0.546) is its hole; so is the middle of
# "。" (0.042 to 0.347, -0.061 to 0.244), whose ring is ink just inside
# its top.
expect 53 148 = 0.0 0.0 0.0
expect 234 144 = 0.0 0.0 0.0
expect 148 166 = 1.0 1.0 1.0
expect 418 201 = 1.0 1.0 1.0
expect 418 173 = 0.0 0.0 0.0
# Beside the text the paper is untouched.
expect 560 40 = 1.0 1.0 1.0

# A character the font lacks is its missing glyph, the first, and moves
# the pen by that glyph's 600 units.
expect lack.layout.result[0].glyph = 0
expect lack.layout.result[1].origin = 60.0 100.0 0.001
