// Type drawn by the font and vector packages from two fonts `orla import`
// read: a title, four lines in a Latin font, and a line in a Chinese one
// of which only the characters used were imported.
//
//   orla import source/NotoSans-Regular.ttf --out assets --chars "<printable ASCII>"
//   orla import NotoSansSC-Regular.otf --out assets --chars "宿主是世界，内核是法则，图是结构，智能是创造者。"
use "../../packages/font.orlapkg";

input latin: Rows<Glyph> = "assets/NotoSans-Regular.glyphs.field";
input latin_outlines: Rows<Vec4> = "assets/NotoSans-Regular.segments.field";
input latin_metrics: Rows<Metrics> = "assets/NotoSans-Regular.metrics.field";
input chinese: Rows<Glyph> = "assets/NotoSansSC-Regular.glyphs.field";
input chinese_outlines: Rows<Vec4> = "assets/NotoSansSC-Regular.segments.field";
input chinese_metrics: Rows<Metrics> = "assets/NotoSansSC-Regular.metrics.field";

input title: Rows<Int> = text "Orla";
input host: Rows<Int> = text "Host is the world.";
input kernel_: Rows<Int> = text "Kernel is the law.";
input graph_: Rows<Int> = text "Graph is the structure.";
input ai: Rows<Int> = text "AI is the creator.";
input motto: Rows<Int> = text "宿主是世界，内核是法则，图是结构，智能是创造者。";

node paper: kernel {
    requires { field.write; }
    output result: Image;
    domain = window();
    compute {
        let t = coord().y / max(domain().y, 1.0);
        return vec4(mix(vec3(0.98, 0.97, 0.94), vec3(0.93, 0.91, 0.87), t), 1.0);
    }
}

node two: font.join@1 { first <- host; second <- kernel_; domain = count(first) + count(second) + 1; }
node three: font.join@1 { first <- two.result; second <- graph_; domain = count(first) + count(second) + 1; }
node four: font.join@1 { first <- three.result; second <- ai; domain = count(first) + count(second) + 1; }

node titled: graph "../../packages/font.orlapkg/graphs/text.osn" {
    codes <- title; glyphs <- latin; outlines <- latin_outlines; metrics <- latin_metrics;
    under <- paper.result;
    origin = vec2(40.0, 130.0); size = 128.0; color = vec4(0.12, 0.14, 0.2, 1.0);
}
node lines: graph "../../packages/font.orlapkg/graphs/text.osn" {
    codes <- four.result; glyphs <- latin; outlines <- latin_outlines; metrics <- latin_metrics;
    under <- titled.picture;
    origin = vec2(46.0, 200.0); size = 28.0; color = vec4(0.25, 0.27, 0.32, 1.0);
}
node written: graph "../../packages/font.orlapkg/graphs/text.osn" {
    codes <- motto; glyphs <- chinese; outlines <- chinese_outlines; metrics <- chinese_metrics;
    under <- lines.picture;
    origin = vec2(44.0, 400.0); size = 30.0; color = vec4(0.62, 0.18, 0.16, 1.0);
}

output picture <- written.picture;
