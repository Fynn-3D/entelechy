// One generation of Conway's Life. `previous` is this node's own output from
// the last frame, so the Kernel stays pure while the Graph carries the state.
// Hold the pointer to paint live cells; hold C to clear.
kernel life.step@1 {
    requires { image.read; image.write; input.read; }
    input previous: Image;
    param brush: Float = 2.0;
    output result: Image;

    fn alive_at(x: Float, y: Float) -> Float {
        return step(0.5, fetch(previous, vec2(x, y)).r);
    }

    compute {
        let c = coord();
        let me = alive_at(c.x, c.y);
        let n = alive_at(c.x - 1.0, c.y - 1.0) + alive_at(c.x, c.y - 1.0) + alive_at(c.x + 1.0, c.y - 1.0)
              + alive_at(c.x - 1.0, c.y) + alive_at(c.x + 1.0, c.y)
              + alive_at(c.x - 1.0, c.y + 1.0) + alive_at(c.x, c.y + 1.0) + alive_at(c.x + 1.0, c.y + 1.0);
        let survives = me > 0.5 && (n == 2.0 || n == 3.0);
        let born = me < 0.5 && n == 3.0;
        let painted = pointer_down() && length(c - pointer()) <= brush;
        let alive = (survives || born || painted) && !key(67);
        // Age in green: how long the cell has been alive, for the display.
        let age = if alive { min(fetch(previous, c).g + 1.0, 60.0) } else { 0.0 };
        return vec4(float(alive), age, 0.0, 1.0);
    }
}
