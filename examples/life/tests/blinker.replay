scene blinker.osn

# The seed holds a horizontal blinker at (10..12, 10). The first frame steps it
# once, so it stands vertical; the second frame lays it flat again. Live cells
# shift slightly toward the "old" color as they age, hence the tolerance.
frame 0.0
expect 11 9  = 1.0 0.85 0.45 0.06
expect 11 10 = 1.0 0.85 0.45 0.06
expect 11 11 = 1.0 0.85 0.45 0.06
expect 10 10 = 0.07 0.09 0.14
expect 12 10 = 0.07 0.09 0.14
frame 0.1
expect 10 10 = 1.0 0.85 0.45 0.06
expect 12 10 = 1.0 0.85 0.45 0.06
expect 11 9  = 0.07 0.09 0.14

# Painting with the pointer makes cells live at the pointer.
pointer 20 15 down
frame 0.2
expect 20 15 = 1.0 0.85 0.45 0.06
expect 21 16 = 1.0 0.85 0.45 0.06
pointer up

# With the brush parameter at zero the pointer paints only its own pixel,
# so the neighbour that a brush of 2 would reach stays dead.
param brush 0.0
pointer 25 5 down
frame 0.25
expect 26 6 = 0.07 0.09 0.14
pointer up
param brush 2.0

# Holding C clears everything.
key 67 down
frame 0.3
expect 20 15 = 0.07 0.09 0.14
expect 11 10 = 0.07 0.09 0.14
key 67 up

# Reset restarts from the seed: the blinker stands vertical again.
reset
frame 0.4
expect 11 9  = 1.0 0.85 0.45 0.06
expect 10 10 = 0.07 0.09 0.14
