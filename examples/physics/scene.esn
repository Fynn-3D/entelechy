// Boxes and balls stepped by the physics package: a pyramid, balls
// rolling down a ramp, a sensor on the floor that lights while something
// is on it, and a ray from the corner toward the pointer that stops at
// the first body it meets. A click drops a heavy ball where it is.
use "../../packages/physics.entpkg";
use "kernels/";

// Steps of a sixtieth of a second each evaluation takes.
param steps: Int = 1;

node start: world.start@1 { domain = 67; }
node none: physics.no_contacts@1 { domain = 1; }
node rest: world.rest@1 { domain = 1; }

node hand: world.hand@1 { previous <~ hand.result from rest.result; }
node dropped: world.drop@1 {
    bodies <~ world.result from start.result;
    hand <~ hand.result from rest.result;
}

node world: graph "../../packages/physics.entpkg/graphs/step.esn" {
    times = steps;
    carry bodies <- result;
    carry held <- contacts;
    bodies <- dropped.result;
    held <~ world.contacts from none.result;
    origin = vec2(-18.0, -2.0);
    columns = 36;
    rows = 24;
    bits = 10;
    // A pyramid eight high settles in four; the package's eight are for
    // piles many bodies deep landing at once.
    substeps = 4;
}

node no_felt: physics.no_counts@1 { bodies <- world.result; }
node felt: world.felt@1 { contacts <- world.contacts; zeros <- no_felt.result; domain = 2 * count(contacts); }
node aim: world.aim@1 { domain = 1; }
node hits: physics.ray@1 { rays <- aim.result; bodies <- world.result; }

node marks: world.marks@1 { bodies <- world.result; }
// The bodies each tile of the picture walks.
node tiles: world.tiles@1 { domain = 1; }
node reach: world.reach@1 { tiles <- tiles.result; marks <- marks.result; domain = value(tiles); }
node lists: graph "../../packages/compact.entpkg/graphs/runs.esn" { counts <- reach.result; }
node binned: world.binned@1 {
    counts <- reach.result;
    ends <- lists.ends;
    marks <- marks.result;
    slots <- lists.slots;
}
node view: world.view@1 {
    bodies <- world.result;
    marks <- marks.result;
    felt <- felt.result;
    rays <- aim.result;
    hits <- hits.result;
    counts <- reach.result;
    ends <- lists.ends;
    lists <- binned.result;
    domain = window();
}

output picture <- view.result;
