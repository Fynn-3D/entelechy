use "../../../packages/physics.entpkg";


// A small world for the physics package: a ground between two walls, a
// ramp, a pyramid of boxes, balls rolling down the ramp, a sensor on the
// floor, and balls dropped where the pointer clicks. It is seen fitted to
// the window, `WIDE` by `HIGH` units about `MIDDLE`.

struct Hand { down: Bool; shots: Int; }

fn wide() -> Float { return 34.0; }
fn high() -> Float { return 20.0; }
fn middle() -> Vec2 { return vec2(0.0, 9.5); }

// World units a pixel of a `res` window is.
fn unit(res: Vec2) -> Float { return max(wide() / res.x, high() / res.y); }

// The world's point at a pixel, y up.
fn world_at(pixel: Vec2, res: Vec2) -> Vec2 {
    let d = (pixel - res * 0.5) * unit(res);
    return middle() + vec2(d.x, -d.y);
}

// The bodies: 0 ground, 1 and 2 walls, 3 ramp, 4 sensor, 5 to 40 the
// pyramid, 41 to 50 balls, 51 to 66 the pointer's balls, parked apart.
fn rows_of_pyramid() -> Int { return 8; }
fn first_shot() -> Int { return 51; }
fn shots() -> Int { return 16; }

fn parked(i: Int) -> Body {
    return Body { ..circle(vec2(-100.0 - float(i) * 2.0, -50.0), 0.35, 0.0), layer: 0 };
}

fn pyramid(k: Int) -> Body {
    // Row r holds 8 - r boxes; k counts along the rows from the bottom.
    let r = loop rows_of_pyramid() with found = ivec2(0, k) until found.y < rows_of_pyramid() - found.x {
        ivec2(found.x + 1, found.y - (rows_of_pyramid() - found.x))
    };
    let across = rows_of_pyramid() - r.x;
    let x = 9.0 + (float(r.y) - 0.5 * float(across - 1)) * 1.0;
    return box(vec2(x, 0.5 + float(r.x)), vec2(0.5, 0.5), 0.0, 1.0);
}

kernel world.start@1 {
    requires { field.read; field.write; }
    output result: Rows<Body>;
    compute {
        let i = element();
        return match i {
            0 => box(vec2(0.0, -0.5), vec2(17.0, 0.5), 0.0, 0.0),
            1 => box(vec2(-16.5, 10.0), vec2(0.5, 10.5), 0.0, 0.0),
            2 => box(vec2(16.5, 10.0), vec2(0.5, 10.5), 0.0, 0.0),
            3 => box(vec2(-9.5, 4.0), vec2(5.0, 0.25), -0.35, 0.0),
            4 => Body { ..box(vec2(-1.5, 1.0), vec2(1.5, 1.0), 0.0, 0.0), sensor: 1 },
            5..41 => pyramid(i - 5),
            41..51 => {
                let k = i - 41;
                Body { ..circle(vec2(-13.5 + float(k % 5) * 1.0, 9.0 + float(k / 5) * 1.2), 0.4, 1.0), restitution: 0.3 }
            },
            _ => parked(i),
        };
    }
}

kernel world.rest@1 {
    requires { field.read; field.write; }
    output result: Rows<Hand>;
    compute { return Hand { down: false, shots: 0 }; }
}

// A press drops a ball where the pointer is, into the next of the
// pointer's slots.
kernel world.hand@1 {
    requires { field.read; field.write; input.read; }
    input previous: Rows<Hand>;
    output result: Rows<Hand>;
    compute {
        let h = sample(previous);
        let down = pointer_down();
        return Hand { down: down, shots: if down && !h.down { h.shots + 1 } else { h.shots } };
    }
}

kernel world.drop@1 {
    requires { field.read; field.write; input.read; }
    input bodies: Rows<Body>;
    input hand: Rows<Hand>;
    output result: Rows<Body>;
    compute {
        let b = sample(bodies);
        let h = at(hand, 0);
        let pressed = pointer_down() && !h.down;
        let slot = first_shot() + h.shots % shots();
        if !pressed || element() != slot { return b; }
        return Body { ..circle(world_at(pointer(), max(window(), 1.0)), 0.35, 3.0), restitution: 0.2 };
    }
}

// A ray from the upper left corner toward the pointer.
kernel world.aim@1 {
    requires { field.read; field.write; input.read; }
    output result: Rows<Ray>;
    compute {
        let corner = vec2(-15.5, 18.5);
        let to = world_at(pointer(), max(window(), 1.0));
        let d = to - corner;
        let n = if length(d) > 0.0001 { d / length(d) } else { vec2(1.0, 0.0) };
        return Ray { origin: corner, direction: n, length: 60.0, mask: -1 };
    }
}

/// How many sensor touches each body is in.
kernel world.felt@1 {
    requires { field.read; field.write; }
    input contacts: Rows<Manifold>;
    input zeros: Rows<Int>;
    output result: Rows<Int>;
    struct Felt { at: Int; value: Int; }
    scatter over contacts into zeros with sum {
        let m = at(contacts, element() / 2);
        let body = if element() % 2 == 0 { m.a } else { m.b };
        return Felt { at: if m.sensor != 0 && touching(m, 0.0) { body } else { -1 }, value: 1 };
    }
}

// How far `p` is outside a body, negative inside.
fn outside(b: Body, p: Vec2) -> Float {
    let q = unturn(p - b.position, b.angle);
    if b.shape == 0 { return length(q) - b.size.x; }
    let d = abs(q) - b.size;
    return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0);
}

fn hue(i: Int, body: Body) -> Vec3 {
    if body.inverse_mass == 0.0 { return vec3(0.32, 0.34, 0.38); }
    if body.shape == 1 {
        let t = float(i % 5) / 5.0;
        return mix(vec3(0.93, 0.55, 0.25), vec3(0.85, 0.35, 0.3), t);
    }
    if i >= first_shot() { return vec3(0.9, 0.25, 0.3); }
    return vec3(0.25, 0.55, 0.9);
}

fn to_segment(p: Vec2, a: Vec2, b: Vec2) -> Float {
    let ab = b - a;
    let t = saturate(dot(p - a, ab) / max(dot(ab, ab), 0.0000001));
    return length(p - (a + ab * t));
}

/// Each body's center and reach, the little a pixel reads of it to pass
/// it by.
kernel world.marks@1 {
    requires { field.read; field.write; }
    input bodies: Rows<Body>;
    output result: Rows<Vec4>;
    compute { let b = sample(bodies); return vec4(b.position, extent(b), 0.0); }
}

// The picture is drawn a tile of `tile()` pixels at a time, each tile
// walking only the bodies whose box reaches a pixel of it, in body order,
// so a pixel paints what it would walking every body.
fn tile() -> Float { return 32.0; }
fn tile_columns(res: Vec2) -> Int { return int(ceil(res.x / tile())); }
fn tile_rows(res: Vec2) -> Int { return int(ceil(res.y / tile())); }

// The world box of tile `t`'s pixel centers in a `res` window, least
// and most corners, a pixel wider on every side than a pixel's own test
// and grown by the pixel's reach, so a body a pixel of it paints reaches
// the box.
fn tile_box(t: Int, res: Vec2) -> Vec4 {
    let columns = tile_columns(res);
    let first = vec2(float(t % columns), float(t / columns)) * tile() + 0.5;
    let last = min(first + (tile() - 1.0), res - 0.5);
    let a = world_at(first, res);
    let b = world_at(last, res);
    let grown = 3.0 * unit(res);
    let lo = min(a, b) - grown;
    let hi = max(a, b) + grown;
    return vec4(lo, hi);
}

// Whether the box of mark `m` reaches a tile's box.
fn reaches(m: Vec4, box: Vec4) -> Bool {
    return m.x + m.z >= box.x && m.x - m.z <= box.z && m.y + m.z >= box.y && m.y - m.z <= box.w;
}

/// How many tiles the window is cut into, as a row of one a `domain`
/// reads.
kernel world.tiles@1 {
    requires { field.write; input.read; }
    output result: Rows<Int>;
    compute { let res = window(); return tile_columns(res) * tile_rows(res); }
}

/// How many bodies reach each tile.
kernel world.reach@1 {
    requires { field.read; field.write; input.read; }
    input tiles: Rows<Int>;
    input marks: Rows<Vec4>;
    output result: Rows<Int>;
    compute {
        let box = tile_box(element(), window());
        return loop count(marks) with n = 0 {
            if reaches(at(marks, index()), box) { n + 1 } else { n }
        };
    }
}

/// Each tile's bodies, in body order, in its run of the lists.
kernel world.binned@1 {
    requires { field.read; field.write; input.read; }
    input counts: Rows<Int>;
    input ends: Rows<Int>;
    input marks: Rows<Vec4>;
    input slots: Rows<Int>;
    output result: Rows<Int>;
    struct Placed { at: Int; value: Int; }
    scatter over counts into slots with max {
        let t = element();
        let box = tile_box(t, window());
        let start = at(ends, t) - sample(counts);
        loop count(marks) with k = 0 {
            if reaches(at(marks, index()), box) {
                emit(Placed { at: start + k, value: index() });
                k + 1
            } else { k }
        };
        return Placed { at: -1, value: -1 };
    }
}

kernel world.view@1 {
    requires { field.read; field.write; }
    input bodies: Rows<Body>;
    input marks: Rows<Vec4>;
    input felt: Rows<Int>;
    input rays: Rows<Ray>;
    input hits: Rows<Hit>;
    input counts: Rows<Int>;
    input ends: Rows<Int>;
    input lists: Rows<Int>;
    output result: Image;
    compute {
        let res = domain();
        let u = unit(res);
        let p = world_at(coord() + 0.5, res);
        let sky = mix(vec3(0.95, 0.96, 0.98), vec3(0.78, 0.85, 0.93), saturate(p.y / 20.0));
        let cell = floor(coord() / tile());
        let t = int(cell.y) * tile_columns(res) + int(cell.x);
        let n = at(counts, t);
        let start = at(ends, t) - n;
        let painted = loop n with c = sky {
            let i = at(lists, start + index());
            let mark = at(marks, i);
            let far = abs(p - mark.xy) - (mark.z + u);
            if max(far.x, far.y) > 0.0 { c } else {
                let b = at(bodies, i);
                let d = outside(b, p);
                if d > u { c } else {
                    let cover = saturate(0.5 - d / u);
                    let lit = at(felt, i) > 0;
                    let fill = if b.sensor != 0 {
                        mix(c, if lit { vec3(0.3, 0.85, 0.4) } else { vec3(0.55, 0.8, 0.6) }, if lit { 0.55 } else { 0.25 })
                    } else {
                        let base = hue(i, b);
                        let rim = saturate(-d / (2.5 * u));
                        let glow = if lit { vec3(0.2, 0.25, 0.0) } else { vec3(0.0, 0.0, 0.0) };
                        mix(base * 0.55, base, rim) + glow
                    };
                    mix(c, fill, cover)
                }
            }
        };
        let ray = at(rays, 0);
        let hit = at(hits, 0);
        let beam = saturate(1.0 - to_segment(p, ray.origin, hit.point) / u) * 0.6;
        let dot_ = saturate(1.0 - (length(p - hit.point) - 3.0 * u) / u) * float(hit.body >= 0);
        let lined = mix(painted, vec3(0.9, 0.2, 0.2), beam);
        return vec4(mix(lined, vec3(0.95, 0.15, 0.15), dot_), 1.0);
    }
}
