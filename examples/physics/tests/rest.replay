# A ray down onto the ball meets its top, one down onto the column meets
# the top box's.
expect hits.result[0].body = 1
expect hits.result[0].point = -5.0 1.0 0.005
expect hits.result[0].normal = 0.0 1.0 0.001
expect hits.result[1].body = 6
expect hits.result[1].point = 0.2 5.0 0.02
expect hits.result[1].normal = 0.0 1.0 0.005
