scene rest.esn

# A step a sixtieth of a second, ten a frame. After a second a ball
# dropped on the ground rests on it, a column of five boxes stands
# straight, a box on the ground stays where it was set.
frame 1
frame 2
frame 3
frame 4
frame 5
frame 6
expect now.result[1].position = -5.0 0.5 0.005
expect now.result[1].velocity = 0.0 0.0 0.01
expect now.result[2].position = 0.0 0.5 0.01
expect now.result[4].position = 0.0 2.5 0.02
expect now.result[6].position = 0.0 4.5 0.02
expect now.result[6].angle = 0.0 0.002
expect now.result[7].position = 6.0 0.5 0.005

