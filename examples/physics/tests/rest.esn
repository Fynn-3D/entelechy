// A ball dropped on the ground, a column of five boxes on it, and a
// box on a slope; `steps` steps a frame.
use "../../../packages/physics.entpkg";

param steps: Int = 10;

node start: kernel {
    requires { field.read; field.write; }
    output result: Rows<Body>;
    compute {
        let i = element();
        if i == 0 { return box(vec2(0.0, -0.5), vec2(20.0, 0.5), 0.0, 0.0); }
        if i == 1 { return circle(vec2(-5.0, 4.0), 0.5, 1.0); }
        if i < 7 { return box(vec2(0.0, 0.5 + float(i - 2) * 1.0), vec2(0.5, 0.5), 0.0, 1.0); }
        return box(vec2(6.0, 1.0), vec2(0.5, 0.5), 0.0, 1.0);
    }
    domain = 8;
}

node none: physics.no_contacts@1 { domain = 1; }
node world: graph "../../../packages/physics.entpkg/graphs/step.esn" {
    times = steps;
    carry bodies <- result;
    carry held <- contacts;
    bodies <~ world.result from start.result;
    held <~ world.contacts from none.result;
}

node now: kernel {
    requires { field.read; field.write; }
    input bodies: Rows<Body> <- world.result;
    output result: Rows<Body>;
    compute { return sample(bodies); }
}

output bodies <- now.result;

// Rays down onto the ball and onto the column.
node rays: kernel {
    requires { field.read; field.write; }
    output result: Rows<Ray>;
    compute {
        let x = if element() == 0 { -5.0 } else { 0.2 };
        return Ray { origin: vec2(x, 10.0), direction: vec2(0.0, -1.0), length: 20.0, mask: -1 };
    }
    domain = 2;
}
node hits: physics.ray@1 { rays <- rays.result; bodies <- now.result; }
