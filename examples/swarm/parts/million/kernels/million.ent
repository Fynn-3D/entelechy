// A million bodies, each with its own place, speed and color, stepped
// every frame and drawn every frame. The step is a map over a
// `Rows<Body>` carried frame to frame; the drawing is a scatter, every
// body writing into the cell it lands on, which is the one place in
// this scene where a million writers meet.

struct Body { at: Vec2; v: Vec2; tint: Float; }
type Bodies = Rows<Body>;

fn mix32(n: Int) -> Int {
    let a = mul_wrap(n ^ 0x27D4EB2D, 0x85EBCA6B);
    let b = a ^ (a >>> 13);
    let c = mul_wrap(b, 0xC2B2AE35);
    return c ^ (c >>> 16);
}

// A number between 0 and 1 from a whole one.
fn unit(n: Int) -> Float { return float(mix32(n) >>> 8) / 16777216.0; }

// The speed that holds a circle at this distance from the middle,
// under a pull that falls off with the square of it.
fn orbit(pull: Float, away: Float) -> Float { return sqrt(pull / max(away, 0.02)); }

// Where a body belongs when it is made and when it is made again: a
// place on a disc, going the way round, with a little of its own so
// the disc has a width and the arms something to wind.
fn placed(i: Int, pull: Float) -> Body {
    let angle = unit(i * 3 + 1) * 6.2831853;
    let away = 0.06 + sqrt(unit(i * 3 + 2)) * 0.30;
    let out = vec2(cos(angle), sin(angle));
    let round = vec2(-out.y, out.x);
    let wobble = 0.94 + unit(i * 7 + 5) * 0.12;
    return Body {
        at: vec2(0.5, 0.5) + out * away,
        v: round * orbit(pull, away) * wobble,
        tint: unit(i * 13 + 7),
    };
}

/// Where they start.
kernel million.spawn@1 {
    requires { field.write; }
    param pull: Float = 0.06;
    output result: Bodies;
    compute { return placed(element(), pull); }
}

/// One step: pulled towards the middle by an inverse square, which the
/// inside answers faster than the outside, so what starts as a disc
/// winds into arms. A map, one body an element, and no body reads
/// another: a million of them is a million independent sums.
kernel million.step@1 {
    requires { field.read; field.write; }
    input previous: Bodies;
    param pull: Float = 0.06;
    param step: Float = 0.0166667;        // a sixtieth, so a frame is a frame
    output result: Bodies;
    compute {
        let body = sample(previous);
        let from_middle = body.at - 0.5;
        let away = max(length(from_middle), 0.03);
        let towards = from_middle / away;
        let v = body.v - towards * (pull / (away * away)) * step;
        let at = body.at + v * step;
        // One that has left the picture is made again on the disc, so
        // a scene left running stays a scene.
        if away > 0.9 { return placed(element() * 2 + 1, pull); }
        return Body { ..body, at: at, v: v };
    }
}

/// Every body into the cell it lands on, counted: what the picture
/// shows is how many are there, which is the only thing a million of
/// anything can show.
kernel million.splat@1 {
    requires { field.read; field.write; }
    input bodies: Bodies;
    input canvas: Grid<Int>;
    output result: Grid<Int>;
    struct Mark { cell: Vec2; value: Int; }
    scatter over bodies into canvas with sum {
        let body = sample(bodies);
        // The unit square over the middle of the window, square
        // whatever the window is; a body outside it lands outside the
        // canvas, and a scatter drops what falls outside.
        let extent = size(canvas);
        let across = min(extent.x, extent.y);
        let cell = floor((body.at - 0.5) * across + extent * 0.5);
        // A count is an Int, and integers add in any order: a million
        // writers meet in one atomic each. A Float sum would have to be
        // added up in element order to give the same word every time,
        // which is what the interpreter does and what a GPU would have
        // to sort a million pairs to copy.
        return Mark { cell: cell, value: 1 };
    }
}

/// What the canvas holds, as a picture.
kernel million.draw@1 {
    requires { field.read; field.write; }
    input heat: Grid<Int>;
    output result: Image;
    param scale: Float = 0.10;            // how many bodies read as bright
    compute {
        // Counts run from none to hundreds, so the picture is of their
        // logarithm; a linear one is a white disc on black.
        let count = float(sample(heat));
        let lit = saturate(log(1.0 + count * scale) * 0.55);
        let ground = vec3(0.04, 0.05, 0.08);
        let warm = mix(vec3(0.20, 0.45, 0.95), vec3(0.99, 0.80, 0.42), lit);
        let color = mix(ground, warm, lit);
        return vec4(color, 1.0);
    }
}
