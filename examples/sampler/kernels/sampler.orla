// A sampler: a sound read from a WAV file is rows of floats; a state row
// holds the playhead in the file's own frames; each evaluation writes one
// block of the device's frames by reading the file with at_linear at the
// ratio of the two rates, so the pitch is right whatever the device runs
// at. The clock retriggers the sound every `every` seconds; Space too.
struct Play { head: Float; beat: Int; space: Bool; }
type State = Rows<Play>;
type Clip = Rows<Float>;
type Stereo = Rows<Vec2>;

// The sound itself, baked to assets/kick.wav by bake.osn: a sine whose
// pitch falls and whose loudness decays, half a second at 48 kHz.
kernel sampler.kick@1 {
    requires { field.write; }
    output result: Clip;
    compute {
        let t = float(element()) / 48000.0;
        let pitch = 40.0 + 110.0 * exp(-t * 18.0);
        let phase = 6.2831853 * (40.0 * t + 110.0 / 18.0 * (1.0 - exp(-t * 18.0)));
        return sin(phase) * exp(-t * 7.0) * 0.9 + 0.0 * pitch;
    }
}

kernel sampler.begin@1 {
    requires { field.write; }
    output result: State;
    compute { return Play { head: 0.0, beat: -1, space: false }; }
}

// The playhead, in the clip's frames: it advances by a block of the
// device's frames scaled by the rates, and returns to zero on a beat
// or a press of Space.
kernel sampler.state@1 {
    requires { field.read; field.write; time.read; input.read; }
    input previous: State;
    input clip: Clip;
    param clip_rate: Float = 48000.0;
    param block: Float = 800.0;
    param every: Float = 1.0;
    output result: State;
    compute {
        let s = sample(previous);
        let device = if rate() > 0.0 { rate() } else { 48000.0 };
        let beat = int(floor(time() / every));
        let space = key(32);
        let retrigger = beat != s.beat || (space && !s.space);
        let head = if retrigger { 0.0 } else { s.head + block * clip_rate / device };
        return Play { head: head, beat: beat, space: space };
    }
}

// One block of stereo frames from the clip at the playhead.
kernel sampler.block@1 {
    requires { field.read; field.write; time.read; }
    input state: State;
    input clip: Clip;
    param clip_rate: Float = 48000.0;
    output result: Stereo;
    compute {
        let s = at(state, 0);
        let device = if rate() > 0.0 { rate() } else { 48000.0 };
        let pos = s.head + float(element()) * clip_rate / device;
        let v = if pos < float(count(clip)) { at_linear(clip, pos) } else { 0.0 };
        return vec2(v, v);
    }
}

kernel sampler.scope@1 {
    requires { field.read; field.write; }
    input block: Stereo;
    param amplitude: Float = 90.0;
    output result: Image;
    compute {
        let c = coord();
        let d = domain();
        let frame = at(block, int(floor(c.x / d.x * float(count(block)))));
        let y = d.y * 0.5 - (frame.x + frame.y) * amplitude;
        let on_trace = abs(c.y - y) < 1.5;
        let on_axis = abs(c.y - d.y * 0.5) < 0.5;
        let color = if on_trace { vec3(1.0, 0.7, 0.4) }
            else if on_axis { vec3(0.2, 0.25, 0.3) }
            else { vec3(0.05, 0.06, 0.09) };
        return vec4(color.x, color.y, color.z, 1.0);
    }
}
