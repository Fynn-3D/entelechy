scene ../scene.esn
window 320 180
param cols 48
param side 12

# A world of 2304 chunks, of which the eye sees 808. The graph places
# 808 chunks' worth of vertices and triangles and no more: the counts
# are what `value(count)` resolved to.
frame 0.0
expect kept.total.result[0] = 808
expect count ground.result = 116352
expect count faces.result = 195536
expect 160 150 = 0.200 0.266 0.161 0.02
expect 160 120 = 0.224 0.298 0.228 0.02
expect 60 170 = 0.183 0.245 0.155 0.02
expect 160 20 = 0.460 0.573 0.731 0.02

# The same frame with the culling turned off: every chunk placed, three
# times the geometry, and the same picture to the last pixel. That is
# the whole claim — the frame drew what it would have drawn, having
# built a third of it.
reset
param culling false
frame 0.0
expect kept.total.result[0] = 2304
expect count ground.result = 331776
expect count faces.result = 557568
expect 160 150 = 0.200 0.266 0.161 0.02
expect 160 120 = 0.224 0.298 0.228 0.02
expect 60 170 = 0.183 0.245 0.155 0.02
expect 160 20 = 0.460 0.573 0.731 0.02

# Further along, the camera has turned: a different part of the world,
# a different count, and the graph resized to it.
reset
param culling true
frame 0.0
frame 1.5
expect kept.total.result[0] = 758
expect count ground.result = 109152
