scene ../scene.osn
window 320 180

# The clip travels 1.2 along -z a loop, a second a loop, and plays in
# place: the scene carries the travel. Frames far apart and uneven, the
# body stands where the clip says — 1.2 a second — loops and all.
frame 0.0
expect stand.result[0].at = 0 0 0 0.0001

# Early in the first loop: the shoulder has bobbed and rocked (its
# matrix has no travel in it), and the forearm is curling.
frame 0.4
expect palette.result[0] = 1 0 0 0  0 0.98449 0.17542 0  0 -0.17542 0.98449 0  0 0.10854 0 1 0.0005
expect palette.result[1] = 1 0 0 0  0 0.21686 0.97620 0  0 -0.97620 0.21686 0  0 -0.69224 -0.76763 1 0.0005

frame 1.7
expect stand.result[0].at = 0 0 -2.04 0.0001

# Two and a half loops in: the body has moved on three units, and the
# pose, half way through its loop, has the root back over the body's
# place, raised by the bob and nothing else.
frame 2.5
expect stand.result[0].at = 0 0 -3.0 0.0001
expect poses.result[0].at = 0 0.12 0 0.0001
expect palette.result[1] = 1 0 0 0  0 0.26750 0.96356 0  0 -0.96356 0.26750 0  0 -0.84356 -0.73250 1 0.0005

# The same two and a half seconds in fifty steps: where the body stands
# does not depend on how often the scene is evaluated.
reset
frame 0.0
frame 0.05
frame 0.1
frame 0.15
frame 0.2
frame 0.25
frame 0.3
frame 0.35
frame 0.4
frame 0.45
frame 0.5
frame 0.55
frame 0.6
frame 0.65
frame 0.7
frame 0.75
frame 0.8
frame 0.85
frame 0.9
frame 0.95
frame 1.0
frame 1.05
frame 1.1
frame 1.15
frame 1.2
frame 1.25
frame 1.3
frame 1.35
frame 1.4
frame 1.45
frame 1.5
frame 1.55
frame 1.6
frame 1.65
frame 1.7
frame 1.75
frame 1.8
frame 1.85
frame 1.9
frame 1.95
frame 2.0
frame 2.05
frame 2.1
frame 2.15
frame 2.2
frame 2.25
frame 2.3
frame 2.35
frame 2.4
frame 2.45
frame 2.5
expect stand.result[0].at = 0 0 -3.0 0.0001
