// Root motion: a clip whose root travels, played in place, and the
// travel carried by the scene. The arm crawls; the clip's shoulder moves
// on a stride a loop, `skin.stride@1` plays it with that travel taken
// out, `skin.travel@1` says how far it went since the last evaluation,
// and `stand` adds that to where the body stood — state the scene keeps
// through `<~`, so the body moves on through the world instead of being
// dragged back each time the clip loops.
use "kernels/";
use "../../packages/skin.orlapkg/kernels/skin.orla";

input mesh: Rows<Point> = "../skin/assets/arm.vertices.field";
input faces: Triangles = "../skin/assets/arm.triangles.field";
input weights: Rows<Bound> = "../skin/assets/arm.weights.field";
input skeleton: Skeleton = "../skin/assets/arm.skeleton.field";

param rate: Float = 30.0;
param frames: Int = 31;        // the clip's frames: thirty steps, the last closing the loop
param stride: Float = 1.2;     // how far one loop travels

node crawl: stride.clip@1 { skeleton <- skeleton; frames = frames; stride = stride; domain = frames * count(skeleton); }
node clock: skin.clock@1 { domain = 1; }

node poses: skin.stride@1 { skeleton <- skeleton; clip <- crawl.result; at <- clock.result; rate = rate; }
node travel: skin.travel@1 {
    skeleton <- skeleton;
    clip <- crawl.result;
    at <- clock.result;
    was <~ clock.result from clock.result;
    rate = rate;
}
node origin: stride.origin@1 { domain = 1; }
node stand: stride.stand@1 { previous <~ stand.result from origin.result; travel <- travel.result; }

node palette: skin.palette@1 { poses <- poses.result; skeleton <- skeleton; }
node posed: skin.apply@1 { mesh <- mesh; weights <- weights; palette <- palette.result; skeleton <- skeleton; }
node placed: skin.place@1 { mesh <- posed.result; places <- stand.result; one <- mesh; }

node project: stride.project@1 { mesh <- placed.result; stand <- stand.result; }
node raster: graph "../../packages/raster.orlapkg/graphs/window.osn" {
    vertices <- project.result;
    triangles <- faces;
}
node view: stride.shade@1 { surface <- raster.surface; stand <- stand.result; domain = window(); }

output result <- view.result;
