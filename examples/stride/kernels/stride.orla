// What the stride scene decides for itself: the travelling clip, where
// the body starts and how it carries its travel, and the camera that
// follows it over a striped floor. The posing is the `skin` package.
use "../../../packages/skin.orlapkg/kernels/skin.orla";

struct Vertex { clip: Vec4; normal: Vec3; uv: Vec2; }
struct Tri { a: Int; b: Int; c: Int; }
struct Surface { depth: Float; normal: Vec3; uv: Vec2; id: Int; }
type Vertices = Rows<Vertex>;
type Triangles = Rows<Tri>;
type GBuffer = Grid<Surface>;

// A turn of `angle` about x, as a quaternion.
fn about_x(angle: Float) -> Vec4 {
    return vec4(sin(angle * 0.5), 0.0, 0.0, cos(angle * 0.5));
}

// An inchworm's stride for the arm's two joints: the forearm curls and
// straightens while the whole arm rocks and moves on along -z by
// `stride` a loop. Its last frame is its first moved on by that stride,
// which is what makes a clip travel: frame `k` of `frames`, joint `j`.
kernel stride.clip@1 {
    requires { field.read; field.write; }
    input skeleton: Skeleton;
    param frames: Int = 31;
    param stride: Float = 1.2;
    output result: Rows<Pose>;
    compute {
        let joints = count(skeleton);
        let k = element() / joints;
        let phase = float(k) / float(frames - 1);
        let wave = sin(phase * 6.2831853);
        if element() % joints == 0 {
            // The shoulder: lying along -z at rest, bobbing and rocking,
            // and travelling.
            return Pose {
                at: vec3(0.0, 0.06 * (1.0 - cos(phase * 6.2831853)), 0.0 - stride * phase),
                turn: about_x(-1.5707963 + 0.3 * wave),
                grow: vec3(1.0, 1.0, 1.0),
            };
        }
        let curl = 1.3 * sin(phase * 3.1415927) * sin(phase * 3.1415927);
        return Pose { at: vec3(0.0, 1.0, 0.0), turn: about_x(curl), grow: vec3(1.0, 1.0, 1.0) };
    }
}

// Where the body starts: at the origin, facing as the rig does.
kernel stride.origin@1 {
    requires { field.write; }
    output result: Rows<Pose>;
    compute { return Pose { at: vec3(0.0, 0.0, 0.0), turn: vec4(0.0, 0.0, 0.0, 1.0), grow: vec3(1.0, 1.0, 1.0) }; }
}

// Where the body stands now: where it stood, moved on by what the clip
// travelled since. The scene's own state, fed back.
kernel stride.stand@1 {
    requires { field.read; field.write; }
    input previous: Rows<Pose>;
    input travel: Rows<Vec3>;
    output result: Rows<Pose>;
    compute {
        let p = sample(previous);
        return Pose { at: p.at + sample(travel), turn: p.turn, grow: p.grow };
    }
}

// The camera: side on, from +x, following the body along z, so the arm
// crawls to the right across a floor that slides under it.
fn eye_of(stand: Vec3) -> Vec3 {
    return vec3(stand.x + 5.0, 0.9, stand.z - 0.9);
}

fn view_of(p: Vec3, eye: Vec3, aspect: Float) -> Vec4 {
    let v = p - eye;
    let f = 1.7321;
    let near = 0.1;
    let far = 30.0;
    // Right is -z, up is y, and the camera looks down -x.
    let depth = v.x;
    return vec4((0.0 - v.z) * f / aspect, v.y * f,
                depth * far / (near - far) + near * far / (near - far), 0.0 - depth);
}

kernel stride.project@1 {
    requires { field.read; field.write; }
    input mesh: Rows<Point>;
    input stand: Rows<Pose>;
    param aspect: Float = 1.7778;
    output result: Vertices;
    compute {
        let v = sample(mesh);
        let eye = eye_of(at(stand, 0).at);
        return Vertex { clip: view_of(v.position, eye, aspect), normal: v.normal, uv: v.uv };
    }
}

// The arm lit, and below the horizon a floor striped across the way it
// travels, every 0.4 of a unit, so the crawl shows while the camera
// keeps up with it.
kernel stride.shade@1 {
    requires { field.read; field.write; }
    input surface: GBuffer;
    input stand: Rows<Pose>;
    param aspect: Float = 1.7778;
    param light: Vec3 = vec3(0.5, 0.8, 0.3);
    param floor: Float = -0.6;
    output result: Image;
    compute {
        let s = sample(surface);
        if s.id >= 0 {
            let n = normalize(s.normal);
            let lit = max(dot(n, normalize(light)), 0.0);
            return vec4(vec3(0.72, 0.58, 0.44) * (0.3 + 0.7 * lit), 1.0);
        }
        let size = domain();
        let ndc = vec2((coord().x + 0.5) / size.x * 2.0 - 1.0, 1.0 - (coord().y + 0.5) / size.y * 2.0);
        let dx = ndc.x * aspect / 1.7321;
        let dy = ndc.y / 1.7321;
        let eye = eye_of(at(stand, 0).at);
        let sky = mix(vec3(0.16, 0.19, 0.25), vec3(0.06, 0.07, 0.10), coord().y / size.y);
        if dy >= 0.0 { return vec4(sky, 1.0); }
        let t = (floor - eye.y) / dy;
        let hit = eye + vec3(-1.0, dy, 0.0 - dx) * t;
        let band = fract(hit.z / 0.4) < 0.5;
        let ground = if band { vec3(0.30, 0.32, 0.28) } else { vec3(0.22, 0.24, 0.21) };
        let fade = clamp(t / 25.0, 0.0, 1.0);
        return vec4(mix(ground, sky, fade), 1.0);
    }
}
