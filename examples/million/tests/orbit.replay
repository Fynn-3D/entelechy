scene ../scene.esn

# Twenty thousand bodies instead of a million, so the test is quick;
# the arithmetic is the one the million does. The step is a fixed
# sixtieth, so a frame is a step whatever the clock says, and the same
# body is in the same place on every backend. The counts are what the
# scatter left in two cells a little out from the middle.
param count 20000
window 96 64 1
frame 0.0
expect bodies.result[0].at = 0.5711836 0.3297270 0.000001
frame 0.0167
expect bodies.result[0].at = 0.5796153 0.3337986 0.000001
frame 1.0
expect bodies.result[0].at = 0.5878350 0.3383127 0.000001
expect heat.result[3130] = 11
expect heat.result[3134] = 14
