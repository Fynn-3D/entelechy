// A Rubik's cube in three dimensions, turned by the keys and orbited by
// the pointer. The state is 54 stickers, a Rows<Int> of face colours
// (0 white up, 1 red right, 2 green front, 3 yellow down, 4 orange
// left, 5 blue back), and a move is a permutation of them: `perm(m, i)`
// says which sticker lands at i. The picture is two boxes cast per
// pixel, the cube and the layer that is turning, in the layer's own
// turned frame.

struct Game {
    yaw: Float; pitch: Float;            // the orbit
    drag: Vec2; dragging: Bool;          // the pointer, last frame
    held: Int;                           // the keys, last frame
    move: Int; t: Float;                 // the turn in progress (-1 none), how far
    apply: Bool; reset: Bool;            // this frame: the turn lands; the cube resets
    count: Int;                          // turns since solved
    queue: Int;                          // scramble turns still to make
    last: Float;                         // time, last frame
}
type Games = Rows<Game>;
type Stickers = Rows<Int>;
struct Hit { t: Float; n: Vec3; p: Vec3; }
use "moves.orla";

// The sticker at cubelet centre c (each coordinate -1, 0 or 1) under
// the face whose normal is n: 9 per face, rows by the second free axis.
fn sticker(c: Vec3, n: Vec3) -> Int {
    let face = if n.y > 0.5 { 0 } else if n.x > 0.5 { 1 } else if n.z > 0.5 { 2 }
        else if n.y < -0.5 { 3 } else if n.x < -0.5 { 4 } else { 5 };
    let u = if abs(n.x) > 0.5 { c.y } else { c.x };
    let v = if abs(n.z) > 0.5 { c.y } else { c.z };
    return face * 9 + (int(v) + 1) * 3 + (int(u) + 1);
}

fn axis_of(face: Int) -> Int { return if face == 0 || face == 3 { 1 } else if face == 1 || face == 4 { 0 } else { 2 }; }
fn sign_of(face: Int) -> Float { return if face < 3 { 1.0 } else { -1.0 }; }

// v turned by `a` radians about the axis (0 x, 1 y, 2 z).
fn spin(axis: Int, a: Float, v: Vec3) -> Vec3 {
    let c = cos(a);
    let s = sin(a);
    return if axis == 0 { vec3(v.x, c * v.y - s * v.z, s * v.y + c * v.z) }
        else if axis == 1 { vec3(c * v.x + s * v.z, v.y, -s * v.x + c * v.z) }
        else { vec3(c * v.x - s * v.y, s * v.x + c * v.y, v.z) };
}

fn palette(colour: Int) -> Vec3 {
    let colours = [vec3(0.95, 0.95, 0.95), vec3(0.85, 0.1, 0.1), vec3(0.1, 0.65, 0.2),
                   vec3(0.95, 0.85, 0.1), vec3(0.95, 0.5, 0.1), vec3(0.1, 0.3, 0.85)];
    return colours[colour];
}

// A ray against a box, the nearest face hit: t below zero for a miss.
fn slab(ro: Vec3, rd: Vec3, lo: Vec3, hi: Vec3) -> Hit {
    let safe = vec3(if abs(rd.x) < 0.00001 { 0.00001 } else { rd.x },
                    if abs(rd.y) < 0.00001 { 0.00001 } else { rd.y },
                    if abs(rd.z) < 0.00001 { 0.00001 } else { rd.z });
    let t1 = (lo - ro) / safe;
    let t2 = (hi - ro) / safe;
    let tmin = min(t1, t2);
    let tmax = max(t1, t2);
    let near = max(tmin.x, max(tmin.y, tmin.z));
    let far = min(tmax.x, min(tmax.y, tmax.z));
    let n = if near == tmin.x { vec3(-sign(safe.x), 0.0, 0.0) }
        else if near == tmin.y { vec3(0.0, -sign(safe.y), 0.0) }
        else { vec3(0.0, 0.0, -sign(safe.z)) };
    let t = if far >= max(near, 0.0) { near } else { -1.0 };
    return Hit { t: t, n: n, p: ro + rd * t };
}

// The solved cube: each face its own colour.
kernel cube.solved@1 {
    requires { field.write; }
    output result: Stickers;
    compute { return element() / 9; }
}

kernel cube.begin@1 {
    requires { field.write; }
    output result: Games;
    compute {
        return Game { yaw: -0.6, pitch: 0.45, drag: vec2(0.0, 0.0), dragging: false, held: 0,
                      move: -1, t: 0.0, apply: false, reset: false, count: 0, queue: 0, last: 0.0 };
    }
}

// The rules, once a frame: drag the pointer to orbit; U R F D L B turn
// a face (with shift, the other way); space scrambles ten turns; enter
// resets. A turn takes a quarter second, and lands as a permutation.
kernel cube.game@1 {
    requires { field.read; field.write; time.read; input.read; }
    input previous: Games;
    param speed: Float = 4.0;              // turns a second
    output result: Games;
    compute {
        let g = sample(previous);
        // A turn that landed last frame is over.
        let current = if g.apply { -1 } else { g.move };
        let dt = clamp(time() - g.last, 0.0, 0.1);
        let p = pointer();
        let down = pointer_down();
        let delta = if down && g.dragging { p - g.drag } else { vec2(0.0, 0.0) };
        let yaw = g.yaw + delta.x * 0.01;
        let pitch = clamp(g.pitch + delta.y * 0.01, -1.4, 1.4);
        let codes = [85, 82, 70, 68, 76, 66, 32, 13];
        let now = loop 8 with bits = 0 { bits | (int(key(codes[index()])) << index()) };
        let pressed = now & (g.held ^ 255);
        let shift = key(16);
        let wanted = loop 6 with m = -1 { if (pressed & (1 << index())) != 0 { index() * 2 + int(shift) } else { m } };
        let scramble = (pressed & 64) != 0;
        let reset = (pressed & 128) != 0;
        let queue = if reset { 0 } else if scramble { g.queue + 10 } else { g.queue };
        // A queued scramble turn, random, starts when nothing is turning.
        let seed = fract(sin(time() * 12.9898 + float(g.count) * 78.233) * 43758.5453);
        let start = if current >= 0 || reset { -1 } else if wanted >= 0 { wanted } else if queue > 0 { int(seed * 12.0) % 12 } else { -1 };
        let queue_left = if start >= 0 && wanted < 0 && queue > 0 { queue - 1 } else { queue };
        let t = if current >= 0 { g.t + dt * speed } else { 0.0 };
        let lands = current >= 0 && t >= 1.0;
        let move = if reset { -1 } else if current >= 0 { current } else { start };
        let count = if reset { 0 } else if lands { g.count + 1 } else { g.count };
        return Game { yaw: yaw, pitch: pitch, drag: p, dragging: down, held: now,
                      move: move, t: if lands { 1.0 } else { t },
                      apply: lands, reset: reset, count: count, queue: queue_left, last: time() };
    }
}

// The stickers after this frame's rules: reset to solved, permuted by
// the turn that landed, or as they were.
kernel cube.stickers@1 {
    requires { field.read; field.write; }
    input previous: Stickers;
    input game: Games;
    output result: Stickers;
    compute {
        let g = at(game, 0);
        let i = element();
        return if g.reset { i / 9 } else if g.apply { at(previous, perm(g.move, i)) } else { at(previous, i) };
    }
}

// The picture: the cube less the turning layer, and the layer in its
// turned frame, each a box; the nearer hit paints its sticker.
kernel cube.draw@1 {
    requires { field.read; field.write; }
    input game: Games;
    input stickers: Stickers;
    output result: Image;
    struct Seen { hit: Hit; c: Vec3; n: Vec3; }

    // What a hit on a box of the cube shows: the sticker under it, and
    // a dark border around every cubelet face.
    fn colour_at(hit: Hit, stickers: Stickers, shade: Vec3) -> Vec3 {
        let { p, n } = hit;
        let c = vec3(clamp(floor(p.x + 1.5), 0.0, 2.0) - 1.0, clamp(floor(p.y + 1.5), 0.0, 2.0) - 1.0, clamp(floor(p.z + 1.5), 0.0, 2.0) - 1.0);
        let centre = vec3(if abs(n.x) > 0.5 { n.x } else { c.x }, if abs(n.y) > 0.5 { n.y } else { c.y }, if abs(n.z) > 0.5 { n.z } else { c.z });
        let local = abs(p - centre) * (vec3(1.0, 1.0, 1.0) - abs(n));
        let edge = max(local.x, max(local.y, local.z)) > 0.43;
        let base = palette(at(stickers, sticker(centre, n)));
        let lit = 0.55 + 0.45 * max(dot(shade, vec3(0.4, 0.8, 0.45)), 0.0);
        return if edge { vec3(0.05, 0.05, 0.06) } else { base * lit };
    }

    compute {
        let g = at(game, 0);
        let res = domain();
        let half = res * 0.5;
        let px = coord() + vec2(0.5, 0.5);
        let f = 2.4;
        let rd_world = normalize(vec3((px.x - half.x) / half.y, (half.y - px.y) / half.y, -f));
        let ro_world = vec3(0.0, 0.0, 7.5);
        // Into the cube's frame: the orbit undone.
        let rd = spin(1, -g.yaw, spin(0, -g.pitch, rd_world));
        let ro = spin(1, -g.yaw, spin(0, -g.pitch, ro_world));
        let turning = g.move >= 0 && !g.apply;
        let face = max(g.move, 0) / 2;
        let axis = axis_of(face);
        let s = sign_of(face);
        // The still part: the whole cube, or the cube less the layer.
        let lo = vec3(-1.5, -1.5, -1.5);
        let hi = vec3(1.5, 1.5, 1.5);
        let cut_lo = vec3(if turning && axis == 0 && s < 0.0 { -0.5 } else { lo.x }, if turning && axis == 1 && s < 0.0 { -0.5 } else { lo.y }, if turning && axis == 2 && s < 0.0 { -0.5 } else { lo.z });
        let cut_hi = vec3(if turning && axis == 0 && s > 0.0 { 0.5 } else { hi.x }, if turning && axis == 1 && s > 0.0 { 0.5 } else { hi.y }, if turning && axis == 2 && s > 0.0 { 0.5 } else { hi.z });
        let still = slab(ro, rd, cut_lo, cut_hi);
        // The turning layer, in its own frame: the ray turned back.
        let angle = (if g.move % 2 == 0 { -1.0 } else { 1.0 }) * s * g.t * 1.5707963;
        let ro_l = spin(axis, -angle, ro);
        let rd_l = spin(axis, -angle, rd);
        let layer_lo = vec3(if axis == 0 { if s > 0.0 { 0.5 } else { -1.5 } } else { -1.5 }, if axis == 1 { if s > 0.0 { 0.5 } else { -1.5 } } else { -1.5 }, if axis == 2 { if s > 0.0 { 0.5 } else { -1.5 } } else { -1.5 });
        let layer_hi = vec3(if axis == 0 { if s > 0.0 { 1.5 } else { -0.5 } } else { 1.5 }, if axis == 1 { if s > 0.0 { 1.5 } else { -0.5 } } else { 1.5 }, if axis == 2 { if s > 0.0 { 1.5 } else { -0.5 } } else { 1.5 });
        let layer = if turning { slab(ro_l, rd_l, layer_lo, layer_hi) } else { Hit { t: -1.0, n: vec3(0.0, 1.0, 0.0), p: ro } };
        let layer_first = layer.t >= 0.0 && (still.t < 0.0 || layer.t < still.t);
        let background = vec3(0.12, 0.13, 0.17) + vec3(0.06, 0.06, 0.08) * (1.0 - px.y / res.y);
        let colour = if layer_first {
            // Lit by the normal as it is now, coloured by the sticker as it was.
            colour_at(layer, stickers, spin(1, g.yaw, spin(0, g.pitch, spin(axis, angle, layer.n))))
        } else if still.t >= 0.0 {
            colour_at(still, stickers, spin(1, g.yaw, spin(0, g.pitch, still.n)))
        } else { background };
        return vec4(colour.x, colour.y, colour.z, 1.0);
    }
}

// The line under the cube: what the network thinks the cube is from
// solved, in turns; how many turns were made; the training loss.
kernel cube.readout@1 {
    requires { field.read; field.write; input.read; }
    input game: Games;
    input guess: Rows<Float>;
    input loss: Losses;
    output result: Text;
    compute {
        let g = at(game, 0);
        let i = element();
        let l = at(loss, 0);
        let err = l.sum / float(max(l.count, 1));
        let think = int(round(clamp(at(guess, 0), 0.0, 99.0)));
        let cents = int(round(clamp(err, 0.0, 99.99) * 100.0));
        // "net NN  you NN  err NN.NN"
        let code = if i == 0 { 110 } else if i == 1 { 101 } else if i == 2 { 116 }
            else if i == 4 { 48 + think / 10 } else if i == 5 { 48 + think % 10 }
            else if i == 8 { 121 } else if i == 9 { 111 } else if i == 10 { 117 }
            else if i == 12 { 48 + (g.count / 10) % 10 } else if i == 13 { 48 + g.count % 10 }
            else if i == 16 { 101 } else if i == 17 { 114 } else if i == 18 { 114 }
            else if i == 20 { if cents >= 1000 { 48 + cents / 1000 } else { 32 } }
            else if i == 21 { 48 + (cents / 100) % 10 } else if i == 22 { 46 }
            else if i == 23 { 48 + (cents / 10) % 10 } else if i == 24 { 48 + cents % 10 }
            else { 32 };
        let unit = max(1.0, round(scale()));
        let glyph = unit * 2.0;
        return Glyph { code: code, origin: vec2(12.0, 12.0) * unit + vec2(float(i) * 6.0 * glyph, 0.0), scale: glyph };
    }
}
