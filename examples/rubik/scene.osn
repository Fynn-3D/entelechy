// begin and solved seed the game and the stickers; game reads the
// input and runs the rules; stickers apply a landed turn; the network's
// batch of scrambles is made, run, and stepped every frame; view draws
// the cube, readout the numbers, shown the text over the picture.
use "kernels/";
use "../shared/text.orla";

input font: Grid<Float> = "../shared/font.png";
param rate: Float = 0.05;

node begin: cube.begin@1 { domain = 1; }
node solved: cube.solved@1 { domain = 54; }
node game: cube.game@1 { previous <~ game.result from begin.result; }
node stickers: cube.stickers@1 { previous <~ stickers.result from solved.result; game <- game.result; }

node init: train.init@1 { domain = 1793; }
node zeros: train.zeros@1 { domain = 1793; }
node samples: train.samples@1 { domain = 3456; }    // 64 cubes times 54 stickers
node labels: train.labels@1 { domain = 64; }
node act: train.act@1 { samples <- samples.result; weights <~ step.result from init.result; domain = 2048; }
node delta: train.delta@1 { act <- act.result; labels <- labels.result; weights <~ step.result from init.result; domain = 64; }
node grads: train.grads@1 {
    samples <- samples.result; act <- act.result; delta <- delta.result;
    weights <~ step.result from init.result; zeros <- zeros.result;
    domain = 114752;                 // 64 cubes times 1793 weights
}
node step: train.step@1 { weights <~ step.result from init.result; grads <- grads.result; rate = rate; }
node loss: train.loss@1 { delta <- delta.result; }
node guess: train.guess@1 { stickers <- stickers.result; weights <- step.result; domain = 1; }

node view: cube.draw@1 { game <- game.result; stickers <- stickers.result; domain = window(); }
node readout: cube.readout@1 { game <- game.result; guess <- guess.result; loss <- loss.result; domain = 25; }
node shown: text.draw@1 { under <- view.result; glyphs <- readout.result; font <- font; }

output result <- shown.result;
output loss <- loss.result;
