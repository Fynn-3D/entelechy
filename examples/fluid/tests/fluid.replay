scene fluid.osn

# Thirty frames of the plume alone on a 64 by 64 grid. The projection
# removes most of the divergence the forces and the advection put in:
# the two totals are sums of |divergence| over the grid, before and after.
frame 0.0
frame 0.0167
frame 0.0333
frame 0.05
frame 0.0667
frame 0.0833
