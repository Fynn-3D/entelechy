frame 0.4833
expect before.result[0] = 161.2 4.0
expect after.result[0] = 35.0 3.0
expect smoke.result[3424] = 0.245 0.02       # cell (32, 53), over the plume: smoke arrived
expect project.result[3424] = 1.78 -2.47 0.1  # and it is rising, leaning with the sway
expect smoke.result[650] = 0.0 0.001          # cell (10, 10): none yet
expect 32 55 = 0.223 0.259 0.307 0.03        # the plume's foot: smoke, tinted blue by its speed
expect 2 2 = 0.02 0.022 0.03 0.01             # the ground is dark

# The hand: down at (20, 20), then two pixels to the right each frame.
pointer 20 20 down
