// still, clear, rest seed the fields; hand tracks the pointer; advect
// carries last frame's projected velocity, the solve relaxes pressure
// from last frame's, project makes the velocity divergence-free, smoke
// rides it, and view paints it. Drag the pointer to stir.
use "../kernels/";

node still: Flow { domain = vec2(64, 64); }
node clear: Amount { domain = vec2(64, 64); }
node rest: fluid.rest@1 { domain = 1; }

node hand: fluid.hand@1 { previous <~ hand.result from rest.result; }
node advect: fluid.advect@1 {
    velocity <~ project.result from still.result;
    smoke <~ smoke.result from clear.result;
    hand <- hand.result;
}
node divergence: fluid.divergence@1 { velocity <- advect.result; }
// Forty Jacobi steps: eight per time, five times, each time carrying the
// pressure on, the first from last frame's.
node solve: graph "../solve.osn" {
    times = 5;
    carry pressure <- result;
    pressure <~ solve.result from clear.result;
    divergence <- divergence.result;
}
node project: fluid.project@1 { velocity <- advect.result; pressure <- solve.result; }
node smoke: fluid.smoke@1 {
    previous <~ smoke.result from clear.result;
    velocity <- project.result;
    hand <- hand.result;
}
node view: fluid.draw@1 { smoke <- smoke.result; velocity <- project.result; }

output result <- view.result;

// The divergence before and after projection, summed for the replay.
node residual: fluid.divergence@1 { velocity <- project.result; }
node before: fluid.total@1 { field <- divergence.result; }
node after: fluid.total@1 { field <- residual.result; }
