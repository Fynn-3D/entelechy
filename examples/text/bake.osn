// Bakes the font atlas the text library reads: the glyphs are rows of
// bits in font.orla, and this scene saves them as the file every scene
// that draws text names.
//   orla run examples/text/bake.osn --save font=examples/shared/font.png
use "../shared/font.orla";

node font: text.font@1 { domain = vec2(96, 48); }

output result <- font.result;
