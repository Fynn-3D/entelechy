// Bakes this example's font atlas: the glyphs are rows of bits in
// kernels/font.ent, and this scene saves them as the file the example's
// scene reads.
//   entelechy run examples/text/bake.esn --save font=examples/text/assets/font.png
use "kernels/";

node font: demo.font@1 { domain = vec2(96, 48); }

output result <- font.result;
