/// A glyph: its seven five-bit rows packed into two words, the top four in `hi`, the bottom three in `lo`.
struct FontBits { hi: Int; lo: Int; }

/// A glyph from its seven rows, top first, each five bits, the leftmost pixel highest.
fn font_bits(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int) -> FontBits {
    return FontBits { hi: a << 15 | b << 10 | c << 5 | d, lo: e << 10 | f << 5 | g };
}

/// Row `y` of glyph `b` (0 the top), its leftmost pixel the highest of five bits.
fn font_row(b: FontBits, y: Int) -> Int {
    return if y < 4 { (b.hi >> (5 * (3 - y))) & 31 } else { (b.lo >> (5 * (6 - y))) & 31 };
}

// Space, punctuation, and the digits.
fn font_low(c: Int) -> FontBits {
    return match c {
        32 => font_bits(0, 0, 0, 0, 0, 0, 0),   // space
        33 => font_bits(4, 4, 4, 4, 4, 0, 4),   // !
        34 => font_bits(10, 10, 10, 0, 0, 0, 0),   // "
        35 => font_bits(10, 10, 31, 10, 31, 10, 10),   // #
        36 => font_bits(4, 15, 20, 14, 5, 30, 4),   // $
        37 => font_bits(24, 25, 2, 4, 8, 19, 3),   // %
        38 => font_bits(12, 18, 20, 8, 21, 18, 13),   // &
        39 => font_bits(4, 4, 4, 0, 0, 0, 0),   // '
        40 => font_bits(2, 4, 8, 8, 8, 4, 2),   // (
        41 => font_bits(8, 4, 2, 2, 2, 4, 8),   // )
        42 => font_bits(0, 4, 21, 14, 21, 4, 0),   // *
        43 => font_bits(0, 4, 4, 31, 4, 4, 0),   // +
        44 => font_bits(0, 0, 0, 0, 12, 4, 8),   // ,
        45 => font_bits(0, 0, 0, 31, 0, 0, 0),   // -
        46 => font_bits(0, 0, 0, 0, 0, 12, 12),   // .
        47 => font_bits(0, 1, 2, 4, 8, 16, 0),   // /
        48 => font_bits(14, 17, 19, 21, 25, 17, 14),   // 0
        49 => font_bits(4, 12, 4, 4, 4, 4, 14),   // 1
        50 => font_bits(14, 17, 1, 2, 4, 8, 31),   // 2
        51 => font_bits(31, 2, 4, 2, 1, 17, 14),   // 3
        52 => font_bits(2, 6, 10, 18, 31, 2, 2),   // 4
        53 => font_bits(31, 16, 30, 1, 1, 17, 14),   // 5
        54 => font_bits(6, 8, 16, 30, 17, 17, 14),   // 6
        55 => font_bits(31, 1, 2, 4, 8, 8, 8),   // 7
        56 => font_bits(14, 17, 17, 14, 17, 17, 14),   // 8
        57 => font_bits(14, 17, 17, 15, 1, 2, 12),   // 9
        58 => font_bits(0, 12, 12, 0, 12, 12, 0),   // :
        59 => font_bits(0, 12, 12, 0, 12, 4, 8),   // ;
        60 => font_bits(2, 4, 8, 16, 8, 4, 2),   // <
        61 => font_bits(0, 0, 31, 0, 31, 0, 0),   // =
        62 => font_bits(8, 4, 2, 1, 2, 4, 8),   // >
        63 => font_bits(14, 17, 1, 2, 4, 0, 4),   // ?
        _ => font_bits(0, 0, 0, 0, 0, 0, 0),
    };
}

// @ and the capitals, with the brackets after them.
fn font_mid(c: Int) -> FontBits {
    return match c {
        64 => font_bits(14, 17, 1, 13, 21, 21, 14),   // @
        65 => font_bits(14, 17, 17, 31, 17, 17, 17),   // A
        66 => font_bits(30, 17, 17, 30, 17, 17, 30),   // B
        67 => font_bits(14, 17, 16, 16, 16, 17, 14),   // C
        68 => font_bits(28, 18, 17, 17, 17, 18, 28),   // D
        69 => font_bits(31, 16, 16, 30, 16, 16, 31),   // E
        70 => font_bits(31, 16, 16, 30, 16, 16, 16),   // F
        71 => font_bits(14, 17, 16, 23, 17, 17, 15),   // G
        72 => font_bits(17, 17, 17, 31, 17, 17, 17),   // H
        73 => font_bits(14, 4, 4, 4, 4, 4, 14),   // I
        74 => font_bits(7, 2, 2, 2, 2, 18, 12),   // J
        75 => font_bits(17, 18, 20, 24, 20, 18, 17),   // K
        76 => font_bits(16, 16, 16, 16, 16, 16, 31),   // L
        77 => font_bits(17, 27, 21, 21, 17, 17, 17),   // M
        78 => font_bits(17, 17, 25, 21, 19, 17, 17),   // N
        79 => font_bits(14, 17, 17, 17, 17, 17, 14),   // O
        80 => font_bits(30, 17, 17, 30, 16, 16, 16),   // P
        81 => font_bits(14, 17, 17, 17, 21, 18, 13),   // Q
        82 => font_bits(30, 17, 17, 30, 20, 18, 17),   // R
        83 => font_bits(15, 16, 16, 14, 1, 1, 30),   // S
        84 => font_bits(31, 4, 4, 4, 4, 4, 4),   // T
        85 => font_bits(17, 17, 17, 17, 17, 17, 14),   // U
        86 => font_bits(17, 17, 17, 17, 17, 10, 4),   // V
        87 => font_bits(17, 17, 17, 21, 21, 27, 17),   // W
        88 => font_bits(17, 17, 10, 4, 10, 17, 17),   // X
        89 => font_bits(17, 17, 17, 10, 4, 4, 4),   // Y
        90 => font_bits(31, 1, 2, 4, 8, 16, 31),   // Z
        91 => font_bits(14, 8, 8, 8, 8, 8, 14),   // [
        92 => font_bits(0, 16, 8, 4, 2, 1, 0),   // \
        93 => font_bits(14, 2, 2, 2, 2, 2, 14),   // ]
        94 => font_bits(4, 10, 17, 0, 0, 0, 0),   // ^
        95 => font_bits(0, 0, 0, 0, 0, 0, 31),   // _
        _ => font_bits(0, 0, 0, 0, 0, 0, 0),
    };
}

// The backtick, the small letters, and the braces.
fn font_high(c: Int) -> FontBits {
    return match c {
        96 => font_bits(8, 4, 2, 0, 0, 0, 0),   // `
        97 => font_bits(0, 0, 14, 1, 15, 17, 15),   // a
        98 => font_bits(16, 16, 22, 25, 17, 17, 30),   // b
        99 => font_bits(0, 0, 14, 16, 16, 17, 14),   // c
        100 => font_bits(1, 1, 13, 19, 17, 17, 15),   // d
        101 => font_bits(0, 0, 14, 17, 31, 16, 14),   // e
        102 => font_bits(6, 9, 8, 28, 8, 8, 8),   // f
        103 => font_bits(0, 15, 17, 17, 15, 1, 14),   // g
        104 => font_bits(16, 16, 22, 25, 17, 17, 17),   // h
        105 => font_bits(4, 0, 12, 4, 4, 4, 14),   // i
        106 => font_bits(2, 0, 6, 2, 2, 18, 12),   // j
        107 => font_bits(16, 16, 18, 20, 24, 20, 18),   // k
        108 => font_bits(12, 4, 4, 4, 4, 4, 14),   // l
        109 => font_bits(0, 0, 26, 21, 21, 17, 17),   // m
        110 => font_bits(0, 0, 22, 25, 17, 17, 17),   // n
        111 => font_bits(0, 0, 14, 17, 17, 17, 14),   // o
        112 => font_bits(0, 0, 30, 17, 30, 16, 16),   // p
        113 => font_bits(0, 0, 15, 17, 15, 1, 1),   // q
        114 => font_bits(0, 0, 22, 25, 16, 16, 16),   // r
        115 => font_bits(0, 0, 15, 16, 14, 1, 30),   // s
        116 => font_bits(8, 8, 28, 8, 8, 9, 6),   // t
        117 => font_bits(0, 0, 17, 17, 17, 19, 13),   // u
        118 => font_bits(0, 0, 17, 17, 17, 10, 4),   // v
        119 => font_bits(0, 0, 17, 17, 21, 21, 10),   // w
        120 => font_bits(0, 0, 17, 10, 4, 10, 17),   // x
        121 => font_bits(0, 0, 17, 17, 15, 1, 14),   // y
        122 => font_bits(0, 0, 31, 2, 4, 8, 31),   // z
        123 => font_bits(2, 4, 4, 8, 4, 4, 2),   // {
        124 => font_bits(4, 4, 4, 4, 4, 4, 4),   // |
        125 => font_bits(8, 4, 4, 2, 4, 4, 8),   // }
        126 => font_bits(0, 0, 9, 21, 18, 0, 0),   // ~
        _ => font_bits(0, 0, 0, 0, 0, 0, 0),
    };
}

/// The glyph of printable ASCII code `code` (32 to 126; blank otherwise).
fn font_glyph(code: Int) -> FontBits { return if code < 64 { font_low(code) } else if code < 96 { font_mid(code) } else { font_high(code) }; }

/// Whether pixel `x`, `y` (from the top left) of the 5 by 7 glyph of `code` is lit; none outside it or past 126.
fn font_pixel(code: Int, x: Int, y: Int) -> Bool {
    return x >= 0 && y >= 0 && x < 5 && y < 7 && code <= 126 && (font_row(font_glyph(code), y) >> (4 - x)) & 1 == 1;
}

/// The font: a 5x7 bitmap face for the printable ASCII codes, 32 to 126,
/// written as its rows and baked into an atlas the text library reads.
/// The atlas is a Grid<Float> of 96 by 48 texels: sixteen cells of 6 by 8
/// per row, six rows, the glyph in the top-left 5 by 7 of its cell and a
/// blank column and row beside it, so cell (code - 32) % 16, (code - 32)
/// / 16 holds a code. A node running it sets `domain = vec2(96, 48);`;
/// this example's `assets/font.png` is this atlas, baked, for a scene to
/// read as an input. Each glyph is its seven rows, top first, each row five bits with the
/// leftmost pixel highest: `font_bits(14, 17, 17, 31, 17, 17, 17)` is an A.
kernel demo.font@1 {
    requires { field.write; }
    output result: Grid<Float>;
    compute {
        let p = coord();
        let col = int(floor(p.x / 6.0));
        let row = int(floor(p.y / 8.0));
        return float(font_pixel(32 + row * 16 + col, int(p.x) - col * 6, int(p.y) - row * 8));
    }
}
