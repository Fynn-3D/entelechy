// The stage a spell is shown on: a dark floor ruled in meters, a caster
// and a target standing on it.
use "../../../packages/effects.entpkg";

/// Where the caster and the target stand.
fn caster_at() -> Vec3 { return vec3(-3.5, 0.0, 0.0); }
fn target_at() -> Vec3 { return vec3(3.5, 0.0, 0.0); }

/// Name `i` of the names (16 bytes each, spaces after): its byte `j`.
fn name_byte(names: Rows<Int>, i: Int, j: Int) -> Int { return at(names, clamp(i * 16 + j, 0, count(names) - 1)); }

/// How long a spell is shown before it is cast again.
fn shown_for(e: Effect) -> Float { return e.length + 0.6; }

/// A body standing at `c`: a capsule `h` tall, how far along the ray it
/// is met, or -1.
fn standing(from: Vec3, dir: Vec3, c: Vec3, h: Float, r: Float) -> Float {
    let a = c + vec3(0.0, r, 0.0);
    let b = c + vec3(0.0, h - r, 0.0);
    // March the capsule's distance a few steps from where the ray passes nearest.
    let span = sphere_span(from, dir, mix(a, b, 0.5), h * 0.5 + r);
    if span.y < span.x { return -1.0; }
    let hit = loop 24 with t = vec2(span.x, -1.0) {
        if t.y >= 0.0 { t } else {
            let p = from + dir * t.x;
            let ab = b - a;
            let s = clamp(dot(p - a, ab) / dot(ab, ab), 0.0, 1.0);
            let d = length(p - a - ab * s) - r;
            if d < 0.002 { vec2(t.x, t.x) } else if t.x > span.y { vec2(t.x, -2.0) } else { vec2(t.x + d, -1.0) }
        }
    };
    return if hit.y >= 0.0 { hit.y } else { -1.0 };
}

/// What the stage shows, a bit each (`show`'s first element): the caster
/// and the target (2), the floor's lines (4). Black under them: the floor
/// is there only as how far it is, so marks on the ground still lie on it.
fn show_bodies() -> Int { return 2; }
fn show_grid() -> Int { return 4; }
fn show_cel() -> Int { return 8; }

kernel stage.view@1 {
    requires { field.read; field.write; }
    input eye: Eyes;
    input show: Rows<Int>;
    output result: Image;
    compute {
        let e = at(eye, 0);
        let shown = at(show, 0);
        let dir = eye_ray(e, coord() + 0.5, domain());
        let sky = vec3(0.0, 0.0, 0.0);
        let floor_t = if dir.y < -0.0001 { (0.0 - e.from.y) / dir.y } else { -1.0 };
        let bodies = (shown & show_bodies()) != 0;
        let body_a = if bodies { standing(e.from, dir, caster_at(), 1.8, 0.32) } else { -1.0 };
        let body_b = if bodies { standing(e.from, dir, target_at(), 1.8, 0.32) } else { -1.0 };
        let near_body = if body_a >= 0.0 && (body_b < 0.0 || body_a < body_b) { body_a } else { body_b };
        let is_a = near_body == body_a && body_a >= 0.0;
        if near_body >= 0.0 && (floor_t < 0.0 || near_body < floor_t) {
            let p = e.from + dir * near_body;
            let c = if is_a { caster_at() } else { target_at() };
            let n = normalize(vec3(p.x - c.x, 0.0, p.z - c.z));
            let soft = 0.25 + 0.6 * max(dot(n, normalize(vec3(-0.4, 0.3, 0.7))), 0.0);
            // A cartoon's bodies in two tones.
            let lit = if (shown & show_cel()) != 0 { if soft > 0.5 { 0.85 } else { 0.4 } } else { soft };
            let base = if is_a { vec3(0.32, 0.36, 0.5) } else { vec3(0.5, 0.33, 0.3) };
            return vec4(base.x * lit, base.y * lit, base.z * lit, 1.0 + near_body);
        }
        if floor_t > 0.0 {
            let p = e.from + dir * floor_t;
            let cell = abs(fract(p.xz + 0.5) - 0.5);
            let line = 1.0 - smoothstep(0.0, 0.02 * (1.0 + floor_t * 0.05), min(cell.x, cell.y));
            let fog = exp(0.0 - floor_t * 0.03);
            let lines = if (shown & show_grid()) != 0 { line * 0.06 * fog } else { 0.0 };
            let shade = vec3(lines, lines, lines * 1.1);
            return vec4(shade.x, shade.y, shade.z, 1.0 + floor_t);
        }
        return vec4(sky.x, sky.y, sky.z, 0.0);
    }
}
