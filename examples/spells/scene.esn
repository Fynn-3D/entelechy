// The spells: every spell of the effects package at once, each on its
// own ground, cast again each time it ends, its name over it
// (`kernels/gallery.ent` has the keys), thirty to a page. `element` and `tier` draw them
// all in one element or at one tier.
use "kernels/gallery.ent";
use "../../packages/effects.entpkg";
use "../../packages/audio.entpkg";
use "../../packages/sound.entpkg";

param element: Int = -1;
param tier: Int = 0;

input vfx_elements: Elements = "../../packages/effects.entpkg/data/elements.csv";
input vfx_effects: Effects = "../../packages/effects.entpkg/data/effects.csv";
input vfx_layers: Layers = "../../packages/effects.entpkg/data/layers.csv";
input vfx_spells: Spells = "../../packages/effects.entpkg/data/spells.csv";
input names: Rows<Int> = bytes "../../packages/effects.entpkg/data/names.bin";
input sfx_timbres: Timbres = "../../packages/sound.entpkg/data/timbres.csv";
input font: Grid<Float> = "../../packages/text.entpkg/assets/font.png";

node look0: gallery.start@1 { domain = 1; }
node look: gallery.look@1 { previous <~ look.result from look0.result; spells <- vfx_spells; domain = 1; }
node eye: gallery.eye@1 { look <- look.result; }
node casts: gallery.casts@1 { spells <- vfx_spells; effects <- vfx_effects; look <- look.result; domain = 30; }
node view: gallery.view@1 { eye <- eye.result; look <- look.result; all <- vfx_spells; spells = 30; domain = window(); }
node fx: graph "../../packages/effects.entpkg/graphs/draw.esn" { picture <- view.result; eye <- eye.result; casts <- casts.result;
    elements <- vfx_elements; effects <- vfx_effects; layers <- vfx_layers; }
node named: gallery.names@1 { picture <- fx.result; eye <- eye.result; names <- names; font <- font; look <- look.result; spells <- vfx_spells; }

// The spells heard, in blocks as long as the frames are.
node paced0: audio.paced_start@1 { domain = 1; }
node paced: audio.paced@1 { previous <~ paced.result from paced0.result; domain = 1; }
node audio_clock: audio.paced_clock@1 { paced <- paced.result; domain = 1; }
node block: audio.paced_size@1 { paced <- paced.result; domain = 1; }
node heard: graph "../../packages/sound.entpkg/graphs/cast.esn" { casts <- casts.result; effects <- vfx_effects; layers <- vfx_layers;
    timbres <- sfx_timbres; eye <- eye.result; clock <- audio_clock.result; block <- block.result; }

output result <- named.result;
output sound <- heard.sound;
