// The ground, baked once into a Field: the hashes and their octaves
// are paid for at load and read back per step as four words and a
// blend. A frame marches the Field, not the noise.
kernel land.bake@1 {
    requires { field.write; }
    param span: Float = 2600.0;         // the world the Field covers
    param water: Float = 0.0;
    output result: Grid<Float>;

    struct Fbm { sum: Float; amp: Float; freq: Float; }

    // A hash of a cell, exact on every backend: two odd multipliers, a
    // xor-shift, and the low bits taken as a fraction.
    fn hash(x: Int, y: Int) -> Float {
        let n = add_wrap(mul_wrap(x, 374761393), mul_wrap(y, 668265263));
        let m = mul_wrap(n ^ (n >>> 13), 1274126177);
        return float((m ^ (m >>> 16)) & 0xFFFF) * 0.0000152587890625;
    }

    // Value noise: the four corners of the cell, smoothed between.
    fn noise(p: Vec2) -> Float {
        let i = floor(p);
        let f = p - i;
        let u = f * f * (vec2(3.0, 3.0) - f * 2.0);
        let ix = int(i.x);
        let iy = int(i.y);
        let a = hash(ix, iy);
        let b = hash(ix + 1, iy);
        let c = hash(ix, iy + 1);
        let d = hash(ix + 1, iy + 1);
        return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
    }

    // Octaves of it, as many as the distance is worth. The count is a
    // Float and the last octave fades in over its own width: a count
    // that stepped would draw the step on the hillside, where two
    // distances meet and the surface is not the same one.
    fn fbm(p: Vec2, octaves: Float) -> Float {
        let f = loop 8 with a = Fbm { sum: 0.0, amp: 0.5, freq: 1.0 } until float(index()) >= octaves {
            let w = clamp(octaves - float(index()), 0.0, 1.0);
            Fbm {
                sum: a.sum + noise(p * a.freq) * a.amp * w,
                amp: a.amp * 0.5,
                freq: a.freq * 2.03,
            }
        };
        return f.sum;
    }

    // Octaves of ridges: the same noise folded at zero, which leaves a
    // crease where it turns. Mountains are made of these.
    fn ridged(p: Vec2, octaves: Float) -> Float {
        let f = loop 8 with a = Fbm { sum: 0.0, amp: 0.5, freq: 1.0 } until float(index()) >= octaves {
            let w = clamp(octaves - float(index()), 0.0, 1.0);
            let n = 1.0 - abs(noise(p * a.freq) * 2.0 - 1.0);
            Fbm { sum: a.sum + n * n * a.amp * w, amp: a.amp * 0.52, freq: a.freq * 2.07 }
        };
        return f.sum;
    }

    // The ground: a basin for the lake, hills around it, and mountains
    // where the basin has been left behind.
    fn ground(p: Vec2, octaves: Float) -> Float {
        let r = length(p);
        let basin = 0.0 - 46.0 * exp(0.0 - r * r * 0.0000115);
        let rolling = (fbm(p * 0.0034, octaves) * 2.0 - 1.0) * 26.0;
        let far = smoothstep(210.0, 620.0, r);
        let peaks = ridged(p * 0.0055, min(octaves, 6.0)) * 165.0 * far;
        return basin + rolling * (0.35 + 0.65 * far) + peaks;
    }

    // How thick the trees stand: not on rock, not in the water, thinning
    // with height, and in patches.
    fn forest(p: Vec2, h: Float, octaves: Float) -> Float {
        let patch = noise(p * 0.0155) * 0.72 + noise(p * 0.0042) * 0.28;
        let shore = smoothstep(0.5, 6.0, h - water);
        let line = 1.0 - smoothstep(52.0, 88.0, h);
        return clamp(patch * 2.5 - 0.62, 0.0, 1.0) * shore * line;
    }

    // What a ray meets: the ground with the canopy standing on it.
    fn height(p: Vec2, octaves: Float) -> Float {
        let g = ground(p, octaves);
        let trees = forest(p, g, octaves);
        let crowns = 0.40 + 0.60 * noise(p * 0.055);
        return g + trees * crowns * 4.5;
    }


    compute {
        let uv = (coord() + vec2(0.5, 0.5)) / domain();
        let p = (uv - vec2(0.5, 0.5)) * span;
        return height(p, 9.0);
    }
}

// A landscape with no geometry in it: the hills, the forest on them and
// the lake between them are a function of where you are, marched once
// per pixel. What the lake shows is the same function marched again
// along the reflected ray, so the mountains in the water are the
// mountains, not a trick.
//
// The noise is hashed with integers, which every backend computes the
// same way; a hash of a float's sine would drift between them.

kernel land.view@1 {
    requires { field.read; field.write; time.read; }
    input terrain: Grid<Float>;
    param span: Float = 2600.0;
    param steps: Int = 90;              // primary march
    param reflect_steps: Int = 64;      // the march the lake sees
    param shade_steps: Int = 20;        // the march the sun is blocked by
    param water: Float = 0.0;           // the lake's level
    param sun_turn: Float = 0.62;       // where the sun stands, from the left
    param far: Float = 900.0;           // how far the world goes
    output result: Image;

    struct Fbm { sum: Float; amp: Float; freq: Float; }
    struct March { t: Float; h: Float; prev_t: Float; prev_h: Float; hit: Bool; }
    struct Shade { t: Float; light: Float; }

    // A hash of a cell, exact on every backend: two odd multipliers, a
    // xor-shift, and the low bits taken as a fraction.
    fn hash(x: Int, y: Int) -> Float {
        let n = add_wrap(mul_wrap(x, 374761393), mul_wrap(y, 668265263));
        let m = mul_wrap(n ^ (n >>> 13), 1274126177);
        return float((m ^ (m >>> 16)) & 0xFFFF) * 0.0000152587890625;
    }

    // Value noise: the four corners of the cell, smoothed between.
    fn noise(p: Vec2) -> Float {
        let i = floor(p);
        let f = p - i;
        let u = f * f * (vec2(3.0, 3.0) - f * 2.0);
        let ix = int(i.x);
        let iy = int(i.y);
        let a = hash(ix, iy);
        let b = hash(ix + 1, iy);
        let c = hash(ix, iy + 1);
        let d = hash(ix + 1, iy + 1);
        return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
    }

    // Octaves of it, as many as the distance is worth. The count is a
    // Float and the last octave fades in over its own width: a count
    // that stepped would draw the step on the hillside, where two
    // distances meet and the surface is not the same one.
    fn fbm(p: Vec2, octaves: Float) -> Float {
        let f = loop 8 with a = Fbm { sum: 0.0, amp: 0.5, freq: 1.0 } until float(index()) >= octaves {
            let w = clamp(octaves - float(index()), 0.0, 1.0);
            Fbm {
                sum: a.sum + noise(p * a.freq) * a.amp * w,
                amp: a.amp * 0.5,
                freq: a.freq * 2.03,
            }
        };
        return f.sum;
    }

    // How thick the trees stand: not on rock, not in the water, thinning
    // with height, and in patches.
    fn forest(p: Vec2, h: Float, octaves: Float) -> Float {
        let patch = noise(p * 0.0155) * 0.72 + noise(p * 0.0042) * 0.28;
        let shore = smoothstep(0.5, 6.0, h - water);
        let line = 1.0 - smoothstep(52.0, 88.0, h);
        return clamp(patch * 2.5 - 0.62, 0.0, 1.0) * shore * line;
    }

    // What a ray meets, read out of the baked Field: the four texels
    // around the place, blended. Outside it the Field clamps, which is
    // the flat plain beyond the mountains.
    fn height(p: Vec2, octaves: Float) -> Float {
        let uv = p / span + vec2(0.5, 0.5);
        return at_linear(terrain, uv * size(terrain) - vec2(0.5, 0.5));
    }

    // Far away a few octaves are the whole of it.
    fn octaves_at(t: Float) -> Float {
        return clamp(5.5 - t * 0.008, 3.0, 5.5);
    }

    // Walks a ray over the heightfield, carrying the sample it took and
    // the one before it: on a hit the surface is between the two, which
    // is what `settle` then halves. Carrying only the step taken would
    // put every shaded point a step beyond the ground.
    fn walk(ro: Vec3, rd: Vec3, limit: Int, far: Float, coarse: Float, stride: Float) -> March {
        let first = 1.0;
        let p0 = ro + rd * first;
        let h0 = p0.y - height(vec2(p0.x, p0.z), min(octaves_at(first), coarse));
        let start = March { t: first, h: h0, prev_t: first, prev_h: h0, hit: h0 < 0.0 };
        // A ray climbing over the highest ground it could meet is a ray
        // that meets nothing: the sky costs a few steps, not all of them.
        let ceiling = 215.0;
        return loop 48 with m = start
            until m.hit
                || m.t > far
                || (rd.y > 0.0 && ro.y + rd.y * m.t > ceiling)
                || index() >= limit
        {
            let step = max(m.h * 0.55, 0.45 + m.t * 0.008) * stride;
            let t = m.t + step;
            let p = ro + rd * t;
            let h = p.y - height(vec2(p.x, p.z), min(octaves_at(t), coarse));
            March { t: t, h: h, prev_t: m.t, prev_h: m.h, hit: h < 0.0 }
        };
    }

    // Where the surface is, between the last sample above it and the
    // first below: the span halved a few times.
    fn settle(m: March, ro: Vec3, rd: Vec3, coarse: Float) -> Float {
        let s = loop 4 with span = vec2(m.prev_t, m.t) {
            let mid = (span.x + span.y) * 0.5;
            let q = ro + rd * mid;
            let above = q.y - height(vec2(q.x, q.z), min(octaves_at(mid), coarse)) > 0.0;
            if above { vec2(mid, span.y) } else { vec2(span.x, mid) }
        };
        return s.y;
    }

    fn ground_normal(p: Vec2, t: Float) -> Vec3 {
        // Never finer than the Field's own step: a difference taken
        // inside one texel is that texel's flat face, and the hillside
        // comes out in plates.
        let e = max(span / size(terrain).x * 1.6, 0.12 + t * 0.004);
        let oct = octaves_at(t);
        let hx = height(p + vec2(e, 0.0), oct) - height(p - vec2(e, 0.0), oct);
        let hz = height(p + vec2(0.0, e), oct) - height(p - vec2(0.0, e), oct);
        return normalize(vec3(0.0 - hx, 2.0 * e, 0.0 - hz));
    }

    // How much of the sun reaches a point: the ray towards it walked a
    // few coarse steps, the closest approach taken as a soft edge.
    fn sunlight(p: Vec3, sun: Vec3) -> Float {
        // From well clear of the surface: a ray that starts on it is
        // blocked by it, and a landscape all in shadow is flat.
        let s = loop 28 with st = Shade { t: 6.0, light: 1.0 } until st.t > 460.0 || st.light < 0.04 || index() >= shade_steps {
            let q = p + sun * st.t;
            let h = q.y - height(vec2(q.x, q.z), 3.5);
            Shade { t: st.t + max(st.t * 0.3, 5.0), light: min(st.light, 7.0 * h / st.t) }
        };
        return clamp(s.light, 0.0, 1.0);
    }

    fn sky(rd: Vec3, sun: Vec3, t: Float) -> Vec3 {
        let up = clamp(rd.y * 0.5 + 0.5, 0.0, 1.0);
        let blue = mix(vec3(0.56, 0.68, 0.84), vec3(0.09, 0.26, 0.66), up);
        let towards = clamp(dot(rd, sun), 0.0, 1.0);
        let glow = pow(towards, 12.0);
        let disc = pow(towards, 2200.0);
        // Cloud deck: the ray put on a plane far overhead, so the cover
        // gathers towards the horizon as a sky does.
        let deck = vec2(rd.x, rd.z) / max(rd.y, 0.035);
        let drift = vec2(t * 1.4, t * 0.6);
        let cover = fbm(deck * 1.15 + drift * 0.02, 5.0);
        let body = clamp(cover * 3.1 - 1.35, 0.0, 1.0);
        let lit_edge = clamp(cover * 3.4 - 1.5, 0.0, 1.0);
        let cloud = mix(vec3(0.62, 0.66, 0.74), vec3(1.05, 1.02, 0.98), lit_edge)
            * (0.85 + 0.35 * glow);
        let deep = blue + vec3(1.0, 0.72, 0.42) * glow * 0.4 + vec3(1.0, 0.95, 0.85) * disc * 9.0;
        let sheet = body * clamp(rd.y * 7.0, 0.0, 1.0);
        return mix(deep, cloud, sheet * 0.92);
    }

    // The ground's own colour: rock where it is steep, sand at the water,
    // grass above that, and the forest over the grass.
    fn coat(p: Vec3, n: Vec3, d: Float) -> Vec3 {
        let flat = clamp(n.y, 0.0, 1.0);
        let rock = mix(vec3(0.30, 0.27, 0.24), vec3(0.47, 0.44, 0.40), noise(vec2(p.x, p.z) * 0.35));
        let sand = vec3(0.74, 0.66, 0.47);
        let grass = mix(vec3(0.28, 0.44, 0.14), vec3(0.46, 0.55, 0.19), noise(vec2(p.x, p.z) * 0.08));
        let trees = mix(vec3(0.045, 0.135, 0.05), vec3(0.10, 0.25, 0.08), noise(vec2(p.x, p.z) * 1.7));
        let base = mix(rock, grass, smoothstep(0.55, 0.82, flat));
        let snow_line = smoothstep(96.0, 150.0, p.y) * smoothstep(0.52, 0.78, flat);
        let capped = mix(base, vec3(0.92, 0.94, 0.97), snow_line);
        let shore = mix(sand, capped, smoothstep(0.6, 3.2, p.y - water));
        return mix(shore, trees, clamp(d * 2.2, 0.0, 1.0) * smoothstep(0.30, 0.65, flat));
    }

    // Two drifting sheets of noise stand for the swell and the chop; the
    // surface tilts by their slope, gently enough to keep a reflection.
    fn swell(p: Vec2, t: Float) -> Float {
        let a = noise(p * 0.085 + vec2(t * 0.09, t * 0.05));
        let b = noise(p * 0.31 - vec2(t * 0.21, t * 0.13));
        return a * 0.75 + b * 0.25;
    }

    fn ripple(p: Vec2, t: Float, tilt: Float) -> Vec3 {
        let e = 0.9;
        let dx = swell(p + vec2(e, 0.0), t) - swell(p - vec2(e, 0.0), t);
        let dz = swell(p + vec2(0.0, e), t) - swell(p - vec2(0.0, e), t);
        return normalize(vec3(0.0 - dx * tilt, 1.0, 0.0 - dz * tilt));
    }

    // The bark-and-crown grain of a canopy: too fine to march, fine to
    // tilt the surface by where the trees stand.
    fn grain(p: Vec3, n: Vec3, t: Float, d: Float) -> Vec3 {
        let e = 0.35 + t * 0.0025;
        let s = 1.6;
        let gx = noise(vec2(p.x + e, p.z) * s) - noise(vec2(p.x - e, p.z) * s);
        let gz = noise(vec2(p.x, p.z + e) * s) - noise(vec2(p.x, p.z - e) * s);
        let bump = 2.6 * d / (1.0 + t * 0.012);
        return normalize(n + vec3(0.0 - gx * bump, 0.0, 0.0 - gz * bump));
    }

    fn shade_ground(p: Vec3, n: Vec3, rd: Vec3, sun: Vec3, t: Float, lit: Float) -> Vec3 {
        // How thick the trees stand here, asked once: the grain, the
        // colour and the shade between the crowns all want it.
        let d = forest(vec2(p.x, p.z), p.y, 4.0);
        let n = grain(p, n, t, d);
        let base = coat(p, n, d);
        // Between the crowns it is darker, which is most of what a
        // forest looks like from across a lake.
        let under = d * (1.0 - noise(vec2(p.x, p.z) * 1.6)) / (1.0 + t * 0.006);
        let shaded = base * (1.0 - clamp(under * 0.55, 0.0, 0.5));
        let sky_light = vec3(0.15, 0.21, 0.34) * (0.3 + 0.7 * clamp(n.y, 0.0, 1.0));
        let sun_light = vec3(2.85, 2.40, 1.75) * max(dot(n, sun), 0.0) * lit;
        let bounce = vec3(0.14, 0.12, 0.08) * clamp(0.0 - dot(n, sun), 0.0, 1.0);
        return shaded * (sun_light + sky_light + bounce);
    }

    fn fog(colour: Vec3, t: Float, rd: Vec3, sun: Vec3) -> Vec3 {
        let air = 1.0 - exp(0.0 - t * 0.00028);
        let towards = pow(clamp(dot(rd, sun), 0.0, 1.0), 6.0);
        let haze = mix(vec3(0.40, 0.54, 0.76), vec3(0.95, 0.78, 0.58), towards * 0.8);
        return mix(colour, haze, clamp(air, 0.0, 1.0));
    }

    compute {
        let res = domain();
        let uv = (coord() + vec2(0.5, 0.5)) / res * 2.0 - vec2(1.0, 1.0);
        let aspect = res.x / res.y;
        let t = time();

        // A slow pass along the lake.
        // The camera walks the near shore, its height taken from the
        // ground under it, and looks across the lake at the mountains.
        let walk_x = 30.0 + sin(t * 0.06) * 22.0;
        let walk_z = 385.0 - t * 2.0;
        let stand = height(vec2(walk_x, walk_z), 6.0);
        // Low, near the water: a lake seen from above is a sheet of
        // glare, and a lake seen along it is a mirror.
        let ro = vec3(walk_x, max(stand, water) + 11.0, walk_z);
        let target = vec3(walk_x * 0.25, water + 22.0, 0.0 - 560.0);
        let forward = normalize(target - ro);
        let right = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));
        let up = cross(right, forward);
        let rd = normalize(forward * 1.5 + right * (uv.x * aspect) + up * (0.0 - uv.y));
        let sun = normalize(vec3(0.0 - cos(sun_turn) * 0.86, 0.40, sin(sun_turn) * 0.86));

        let land = walk(ro, rd, steps, far, 8.0, 1.0);
        let land_t = if land.hit { settle(land, ro, rd, 8.0) } else { far };
        // The lake is a plane; where the ray meets it first, the water is
        // what is seen and the ground is what the water shows.
        let lake_t = if rd.y < -0.0005 { (water - ro.y) / rd.y } else { 0.0 - 1.0 };
        let on_water = lake_t > 0.0 && lake_t < land_t;

        let colour = if on_water {
            let p = ro + rd * lake_t;
            // The swell flattens with distance, as a lake does to the
            // eye: near it has shape, far it is a mirror.
            let n = ripple(vec2(p.x, p.z), t, 0.55 / (1.0 + lake_t * 0.004));
            // Never below the water: a reflection that dives finds the
            // bed and shows sand where the sky should be.
            let bounced = reflect(rd, n);
            let rr = normalize(vec3(bounced.x, max(bounced.y, 0.012), bounced.z));
            // A reflection is a grazing ray with a long way to go, so it
            // walks in bigger strides over fewer octaves; what it finds
            // is the far shore, which is what a lake shows.
            let mirror = walk(p + vec3(0.0, 0.02, 0.0), rr, reflect_steps, 1400.0, 3.5, 1.6);
            let mirror_colour = if mirror.hit {
                let mt = settle(mirror, p, rr, 5.0);
                let mp = p + rr * mt;
                let mn = ground_normal(vec2(mp.x, mp.z), mt);
                fog(shade_ground(mp, mn, rr, sun, mt, 1.0), mt * 0.45, rr, sun)
            } else {
                sky(rr, sun, t)
            };
            // How deep the lake is here darkens what comes back up.
            let bed = height(vec2(p.x, p.z), 5.0);
            let deep = clamp((water - bed) * 0.06, 0.0, 1.0);
            let body = mix(vec3(0.16, 0.30, 0.30), vec3(0.03, 0.09, 0.14), deep);
            let facing = clamp(dot(0.0 - rd, n), 0.0, 1.0);
            let fresnel = 0.02 + 0.98 * pow(1.0 - facing, 5.0);
            let h = normalize(sun - rd);
            let glint = pow(clamp(dot(n, h), 0.0, 1.0), 220.0) * 2.4;
            let surface = mix(body, mirror_colour, clamp(fresnel * 1.25, 0.0, 1.0))
                + vec3(1.0, 0.94, 0.84) * glint;
            fog(surface, lake_t, rd, sun)
        } else if land.hit {
            let p = ro + rd * land_t;
            let n = ground_normal(vec2(p.x, p.z), land_t);
            let lit = sunlight(p + n * 0.6, sun);
            fog(shade_ground(p, n, rd, sun, land_t, lit), land_t, rd, sun)
        } else {
            sky(rd, sun, t)
        };

        // Tone and a little contrast, so the fog does not wash it out.
        let mapped = colour * 1.05 / (colour * 1.05 + vec3(0.85, 0.85, 0.85));
        let shown = pow(mapped, vec3(0.4545, 0.4545, 0.4545));
        return vec4(shown.x, shown.y, shown.z, 1.0);
    }
}
