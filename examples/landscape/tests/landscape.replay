scene ../scene.osn

# A small window and a small bake: the picture is the same landscape at
# a coarser grain, which is enough to pin the sky, the far shore, the
# forest and what the lake shows.
param detail 192
window 160 90 1

frame 0.0
expect 20 12 = 0.576 0.631 0.710 0.04       # sky, with the cloud deck
expect 80 30 = 0.541 0.620 0.714 0.04       # the far mountains through the haze
expect 40 55 = 0.514 0.557 0.486 0.04       # the lake, with the shore in it
expect 120 70 = 0.463 0.557 0.584 0.04      # the near water
expect 80 80 = 0.471 0.569 0.573 0.04       # the forest on the near shore

# The clock moves the camera along the shore and the swell under it, so
# the same places are not the same pixels.
frame 2.5
expect 20 12 = 0.525 0.608 0.709 0.04
expect 80 30 = 0.540 0.618 0.712 0.06
