// The ground is baked into a Field once, at load; every frame marches
// that Field rather than the noise behind it, which is what makes the
// frame cost the pixels and not the landscape. The bake does not change
// with the clock, so the graph reuses it.
use "kernels/";

param span: Float = 2600.0;     // how much world the Field covers
param detail: Int = 2048;       // how finely; a replay bakes a small one

node terrain: land.bake@1 { span = span; domain = vec2(detail, detail); }
node view: land.view@1 { terrain <- terrain.result; span = span; domain = window(); }

output result <- view.result;
