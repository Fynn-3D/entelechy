scene ../scene.esn
window 320 90

# Silence until something is played; the board's words over the band.
frame 0.0
expect count heard.result = 1600
expect heard.result[400] = 0.0 0.0 0.00001
expect board.result[0].k = 0
expect board.result[0].plays = 0
expect 5 5 = 0.020 0.020 0.030
expect 8 8 = 0.900 0.850 0.700

# Space plays the first event, a step; down moves to the menu's
# move, which plays as it is chosen.
key 32 down
frame 0.1
key 32 up
frame 0.15
expect board.result[0].plays = 1
expect heard.result[400] = 0.02167 0.02167 0.0001
key 40 down
frame 0.2
key 40 up
frame 0.25
expect board.result[0].k = 1
expect board.result[0].plays = 2
expect heard.result[400] = -0.02528 -0.02528 0.0001
