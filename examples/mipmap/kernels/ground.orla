// A checkered ground running to the horizon, drawn through the shared
// mip library: the same plane, the same texture, read once at the top
// level always and once at the level each pixel asks for.
use "../../shared/mip.orla";

struct Vertex { clip: Vec4; normal: Vec3; uv: Vec2; }
struct Tri { a: Int; b: Int; c: Int; }
struct Surface { depth: Float; normal: Vec3; uv: Vec2; id: Int; }

// The texture: a fine checker under a grid of red lines, which is the
// pattern that crawls worst.
kernel ground.texture@1 {
    requires { field.write; }
    param side: Int = 256;
    output result: Image;
    compute {
        let c = icoord();
        let check = ((c.x >> 2) + (c.y >> 2)) % 2 == 0;
        let line = c.x % 32 == 0 || c.y % 32 == 0;
        let colour = if line { vec3(0.85, 0.15, 0.10) }
            else if check { vec3(0.92, 0.90, 0.86) }
            else { vec3(0.12, 0.14, 0.20) };
        return vec4(colour, 1.0);
    }
}

// The ground: two triangles from under the eye to the horizon.
kernel ground.quad@1 {
    requires { field.write; }
    param reach: Float = 900.0;
    output result: Rows<Vertex>;
    compute {
        let i = element();
        let near = i < 2;
        let left = i % 2 == 0;
        let along = if near { 2.0 } else { reach };
        let x = (if left { 0.0 - 1.0 } else { 1.0 }) * along;
        let z = if near { 1.2 } else { reach };
        let f = 1.9;
        let far = reach;
        let near_plane = 0.2;
        return Vertex {
            clip: vec4(x * f / 1.7778, 0.0 - 1.0 * f,
                       z * far / (far - near_plane) - near_plane * far / (far - near_plane), z),
            normal: vec3(0.0, 1.0, 0.0),
            uv: vec2(x * 0.5, z * 0.5),
        };
    }
}

kernel ground.faces@1 {
    requires { field.write; }
    output result: Rows<Tri>;
    compute {
        return if element() == 0 { Tri { a: 0, b: 2, c: 1 } } else { Tri { a: 1, b: 2, c: 3 } };
    }
}

// The picture. A surface a rasterizer left carries its uv at every
// pixel, so the pixel next door says how fast the texture is moving:
// that difference is the derivative a level is chosen by, and the
// triangle's own id says whether the neighbour is on the same surface.
kernel ground.shade@1 {
    requires { field.read; field.write; }
    input surface: Grid<Surface>;
    input strip: Image;
    param side: Int = 256;
    param levels: Int = 7;
    param mip: Bool = true;
    output result: Image;
    compute {
        let s = sample(surface);
        if s.id < 0 { return vec4(0.05, 0.06, 0.09, 1.0); }
        let c = icoord();
        let right = at(surface, vec2(float(c.x + 1), float(c.y)));
        let below = at(surface, vec2(float(c.x), float(c.y + 1)));
        let du = if right.id == s.id { right.uv - s.uv } else { vec2(0.0, 0.0) };
        let dv = if below.id == s.id { below.uv - s.uv } else { vec2(0.0, 0.0) };
        let wanted = if mip { mip_wanted(du, dv, side, levels) } else { 0.0 };
        let colour = mip_at(strip, s.uv, wanted, side, levels);
        return vec4(colour.rgb, 1.0);
    }
}
