// The ground, its texture, the strip of halvings the shared sub-graph
// builds, and one Kernel that reads whichever level each pixel asks
// for. `--param mip=false` reads the top level always, which is what
// the distance looks like without any of this.
use "kernels/";

param side: Int = 256;
param levels: Int = 7;
param mip: Bool = true;

node texture: ground.texture@1 { side = side; domain = vec2(side, side); }
node strip: graph "../../packages/image.orlapkg/graphs/mip.osn" { source <- texture.result; side = side; levels = levels; }

node quad: ground.quad@1 { domain = 4; }
node faces: ground.faces@1 { domain = 2; }
node raster: graph "../../packages/raster.orlapkg/graphs/window.osn" {
    vertices <- quad.result;
    triangles <- faces.result;
}

node view: ground.shade@1 {
    surface <- raster.surface;
    strip <- strip.result;
    side = side; levels = levels; mip = mip;
    domain = window();
}

output result <- view.result;
