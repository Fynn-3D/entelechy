scene ../parts/volume/scene.esn

# The density fades to nothing toward the cube's edges, so the image
# corners show the sky gradient alone: exact on both backends. The centre
# holds cloud, which is brighter and whiter than the sky behind it; noise
# differs slightly between backends, hence the wide tolerance.
frame 0.0
expect 10 10 = 0.37 0.56 0.90 0.03
expect 310 230 = 0.73 0.84 1.0 0.03
expect 160 120 = 0.75 0.8 0.87 0.2
