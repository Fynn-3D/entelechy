// A tile scrolled without end, three ways at once: nearest texels
// through `mod`, `at_linear` through `mod` (which seams at the tile's
// edge, since the blend cannot reach across it), and the shared
// library's `at_linear_wrapped`, four `at` reads blended, which wraps.
use "../../../../../packages/picture.orlapkg";

type Tile = Grid<Vec4>;

/// The tile: a checker of eight-texel squares under a tint that comes
/// round exactly at the edge, and a ring in the middle.
kernel scroll.tile@1 {
    requires { field.write; }
    output result: Tile;
    compute {
        let c = coord();
        let n = domain();
        let square = icoord() / 8;
        let checker = (square.x + square.y) % 2;
        let u = (c + 0.5) / n * 6.2831853;
        let tint = vec3(0.5 + 0.5 * sin(u.x), 0.5 + 0.5 * sin(u.y + 2.0), 0.7);
        let base = if checker == 0 { vec3(0.15, 0.2, 0.35) } else { vec3(0.9, 0.85, 0.6) };
        let ring = abs(length(c + 0.5 - n * 0.5) - n.x * 0.3) < 1.5;
        let color = if ring { vec3(0.95, 0.3, 0.2) } else { base * (0.6 + 0.4 * tint) };
        return vec4(color, 1.0);
    }
}

kernel scroll.view@1 {
    requires { field.read; field.write; time.read; }
    input tile: Tile;
    param speed: Float = 12.0;      // texels per second
    param zoom: Float = 3.0;        // pixels per texel
    output result: Image;
    compute {
        let p = coord();
        let res = domain();
        let n = size(tile);
        let band = int(p.y * 3.0 / res.y);
        let offset = vec2(time() * speed, time() * speed * 0.37);
        let q = (p + 0.5) / zoom + offset;
        let w = mod(q, n);
        return if band == 0 { at(tile, w) }
            else if band == 1 { at_linear(tile, w) }
            else { at_linear_wrapped(tile, q) };
    }
}
