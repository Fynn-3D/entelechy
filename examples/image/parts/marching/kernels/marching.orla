// Marching squares: a scalar field of moving blobs, and its contour at
// one level drawn cell by cell from the classic sixteen-case table,
// each case a pair of edges the line crosses, each edge a point found
// by interpolating the level between two corners.
type Field = Grid<Float>;

/// Three blobs orbiting: the sum of their inverse square distances.
kernel marching.field@1 {
    requires { field.write; time.read; }
    output result: Field;
    compute {
        let c = coord() + 0.5;
        let n = domain();
        let t = time();
        let centres = [
            n * 0.5 + vec2(cos(t * 0.7), sin(t * 0.9)) * n.y * 0.28,
            n * 0.5 + vec2(cos(t * 1.1 + 2.0), sin(t * 0.6 + 1.0)) * n.y * 0.32,
            n * 0.5 + vec2(cos(t * 0.5 + 4.0), sin(t * 1.3 + 3.0)) * n.y * 0.25,
        ];
        return loop 3 with sum = 0.0 {
            let d = c - centres[index()];
            sum + 30.0 / (dot(d, d) + 1.0)
        };
    }
}

// The edges a case's line crosses: edge 0 is the bottom (corner 0 to 1),
// 1 the right (1 to 2), 2 the top (2 to 3), 3 the left (3 to 0); a case
// has one segment or, at a saddle, two; -1 is none.
fn segments(case: Int) -> [Int; 4] {
    let table = [
        [-1, -1, -1, -1], [3, 0, -1, -1], [0, 1, -1, -1], [3, 1, -1, -1],
        [1, 2, -1, -1], [3, 2, 0, 1], [0, 2, -1, -1], [3, 2, -1, -1],
        [2, 3, -1, -1], [0, 2, -1, -1], [0, 1, 2, 3], [1, 2, -1, -1],
        [1, 3, -1, -1], [0, 1, -1, -1], [3, 0, -1, -1], [-1, -1, -1, -1],
    ];
    return table[case];
}

// Where the level crosses between two corner values, 0 to 1.
fn cross(a: Float, b: Float, level: Float) -> Float {
    return clamp((level - a) / (b - a), 0.0, 1.0);
}

fn to_segment(p: Vec2, a: Vec2, b: Vec2) -> Float {
    let ab = b - a;
    let t = clamp(dot(p - a, ab) / max(dot(ab, ab), 0.000001), 0.0, 1.0);
    return length(p - (a + ab * t));
}

kernel marching.draw@1 {
    requires { field.read; field.write; }
    input field: Field;
    param cell: Int = 8;
    param level: Float = 1.0;
    output result: Image;
    compute {
        let p = coord() + 0.5;
        let c = icoord() / cell;
        let local = (p - float(c * cell)) / float(cell);
        // The cell's corners, anticlockwise from its top left in
        // picture space: (0, 0), (1, 0), (1, 1), (0, 1).
        let v = [
            at(field, c), at(field, c + ivec2(1, 0)),
            at(field, c + ivec2(1, 1)), at(field, c + ivec2(0, 1)),
        ];
        let case = int(v[0] > level) | (int(v[1] > level) << 1) | (int(v[2] > level) << 2) | (int(v[3] > level) << 3);
        let points = [
            vec2(cross(v[0], v[1], level), 0.0),
            vec2(1.0, cross(v[1], v[2], level)),
            vec2(cross(v[3], v[2], level), 1.0),
            vec2(0.0, cross(v[0], v[3], level)),
        ];
        let edges = segments(case);
        let nearest = loop 2 with best = 10.0 {
            let a = edges[index() * 2];
            let b = edges[index() * 2 + 1];
            if a < 0 { best } else { min(best, to_segment(local, points[a], points[b])) }
        };
        let line = 1.0 - smoothstep(0.08, 0.16, nearest);
        // Inside the level: the field blended across the cell.
        let value = mix(mix(v[0], v[1], local.x), mix(v[3], v[2], local.x), local.y);
        let inside = smoothstep(level - 0.15, level + 0.15, value);
        let fill = mix(vec3(0.07, 0.08, 0.12), vec3(0.25, 0.45, 0.6), inside);
        let color = mix(fill, vec3(1.0, 0.95, 0.7), line);
        return vec4(color, 1.0);
    }
}
