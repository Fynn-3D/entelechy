// Image filters with mirrored edges: a Gaussian blur as two passes over
// a table of weights, and an emboss whose 3 by 3 kernel is a Mat3;
// every read past an edge is folded back by a function, which is all
// mirror addressing takes.
type Picture = Grid<Vec4>;

/// A source with features against every edge, so the edges matter: a
/// disc cut by the top, a bar along the left, stripes into the corner.
kernel blur.source@1 {
    requires { field.write; }
    output result: Picture;
    compute {
        let c = coord() + 0.5;
        let n = domain();
        let disc = length(c - vec2(n.x * 0.5, 0.0)) < n.y * 0.35;
        let bar = c.x < 12.0 && c.y > n.y * 0.3;
        let stripes = c.x > n.x * 0.7 && c.y > n.y * 0.6 && (icoord().x / 6) % 2 == 0;
        let color = if disc { vec3(0.95, 0.75, 0.2) }
            else if bar { vec3(0.2, 0.3, 0.8) }
            else if stripes { vec3(0.85, 0.2, 0.3) }
            else { vec3(0.12, 0.13, 0.16) };
        return vec4(color, 1.0);
    }
}

// An index folded back into 0..n at both ends: -1 is 0, n is n - 1.
fn fold(i: Int, n: Int) -> Int {
    return if i < 0 { -i - 1 } else if i >= n { 2 * n - 1 - i } else { i };
}

fn mirror(c: IVec2, n: IVec2) -> IVec2 {
    return ivec2(fold(c.x, n.x), fold(c.y, n.y));
}

/// One pass of a five-tap Gaussian along an axis.
kernel blur.pass@1 {
    requires { field.read; field.write; }
    input source: Picture;
    param axis: Int = 0;
    output result: Picture;
    compute {
        let weights = [0.06136, 0.24477, 0.38774, 0.24477, 0.06136];
        let along = if axis == 0 { ivec2(1, 0) } else { ivec2(0, 1) };
        let c = icoord();
        let n = isize(source);
        return loop 5 with acc = vec4(0.0, 0.0, 0.0, 0.0) {
            acc + at(source, mirror(c + along * (index() - 2), n)) * weights[index()]
        };
    }
}

/// An emboss: the 3 by 3 kernel is a matrix, read column by column with
/// the same offsets that fetch the neighbors.
kernel blur.emboss@1 {
    requires { field.read; field.write; }
    input source: Picture;
    output result: Picture;
    compute {
        let stencil = mat3(vec3(-2.0, -1.0, 0.0), vec3(-1.0, 0.0, 1.0), vec3(0.0, 1.0, 2.0));
        let c = icoord();
        let n = isize(source);
        let sum = loop 9 with acc = vec4(0.0, 0.0, 0.0, 0.0) {
            let d = ivec2(index() % 3 - 1, index() / 3 - 1);
            acc + at(source, mirror(c + d, n)) * stencil[d.x + 1][d.y + 1]
        };
        let gray = saturate(dot(sum.rgb, vec3(0.299, 0.587, 0.114)) + 0.5);
        return vec4(vec3(gray, gray, gray), 1.0);
    }
}

/// Side by side: the blur on the left, the emboss of it on the right.
kernel blur.show@1 {
    requires { field.read; field.write; }
    input blurred: Picture;
    input embossed: Picture;
    output result: Image;
    compute {
        let c = icoord();
        let n = isize(blurred);
        return if c.x < n.x { at(blurred, c) } else { at(embossed, c - ivec2(n.x, 0)) };
    }
}
