// A CHIP-8: the machine of 1977 as ordered work. RAM, the registers and
// the screen are memories the steps read and write; each frame runs
// `speed` steps; the delay and sound timers count down once a frame; the
// keypad is the keyboard's 1 2 3 4 / Q W E R / A S D F / Z X C V. Every
// opcode is here: draw, the timers, the stack, waiting for a key, BCD,
// the register file to and from RAM.
type Bytes = Rows<Int>;
type Screen = Grid<Int>;

/// The program: a box that the keypad's 4, 6, 2 and 8 (Q, E, 2, S) move,
/// one pixel a frame, paced by the delay timer so the picture never
/// flickers: set DT to one, spin until it is zero, erase, move, draw.
kernel chip8.rom@1 {
    requires { field.write; }
    output result: Bytes;
    compute {
        let program = [
            0x60, 0x00,    // 200: V0 = 0
            0x61, 0x00,    // 202: V1 = 0
            0xA2, 0x32,    // 204: I = 0x232, the sprite
            0xD0, 0x15,    // 206: draw: the sprite at (V0, V1), 5 rows
            0x6E, 0x01,    // 208: VE = 1
            0xFE, 0x15,    // 20A: DT = VE
            0xFE, 0x07,    // 20C: wait: VE = DT
            0x3E, 0x00,    // 20E: skip if VE == 0
            0x12, 0x0C,    // 210: jump wait
            0xD0, 0x15,    // 212: erase: draw again (xor)
            0x6E, 0x04,    // 214: VE = key 4
            0xEE, 0xA1,    // 216: skip if key VE is up
            0x70, 0xFF,    // 218: V0 -= 1
            0x6E, 0x06,    // 21A: VE = key 6
            0xEE, 0xA1,    // 21C: skip if key VE is up
            0x70, 0x01,    // 21E: V0 += 1
            0x6E, 0x02,    // 220: VE = key 2
            0xEE, 0xA1,    // 222: skip if key VE is up
            0x71, 0xFF,    // 224: V1 -= 1
            0x6E, 0x08,    // 226: VE = key 8
            0xEE, 0xA1,    // 228: skip if key VE is up
            0x71, 0x01,    // 22A: V1 += 1
            0xD0, 0x15,    // 22C: draw
            0x12, 0x08,    // 22E: jump 208
            0x00, 0x00,    // 230: padding
            0xF0, 0x90, 0x90, 0x90, 0xF0,    // 232: the box, 5 rows
        ];
        return program[element()];
    }
}

/// RAM at power-on: the font at 0x50, the program at 0x200, zeros elsewhere.
kernel chip8.boot@1 {
    requires { field.read; field.write; }
    input rom: Bytes;
    output result: Bytes;

    // The sixteen hexadecimal digits, five rows of eight pixels each.
    fn font(i: Int) -> Int {
        let glyphs = [
            0xF0, 0x90, 0x90, 0x90, 0xF0,    // 0
            0x20, 0x60, 0x20, 0x20, 0x70,    // 1
            0xF0, 0x10, 0xF0, 0x80, 0xF0,    // 2
            0xF0, 0x10, 0xF0, 0x10, 0xF0,    // 3
            0x90, 0x90, 0xF0, 0x10, 0x10,    // 4
            0xF0, 0x80, 0xF0, 0x10, 0xF0,    // 5
            0xF0, 0x80, 0xF0, 0x90, 0xF0,    // 6
            0xF0, 0x10, 0x20, 0x40, 0x40,    // 7
            0xF0, 0x90, 0xF0, 0x90, 0xF0,    // 8
            0xF0, 0x90, 0xF0, 0x10, 0xF0,    // 9
            0xF0, 0x90, 0xF0, 0x90, 0x90,    // A
            0xE0, 0x90, 0xE0, 0x90, 0xE0,    // B
            0xF0, 0x80, 0x80, 0x80, 0xF0,    // C
            0xE0, 0x90, 0x90, 0x90, 0xE0,    // D
            0xF0, 0x80, 0xF0, 0x80, 0xF0,    // E
            0xF0, 0x80, 0xF0, 0x80, 0x80,    // F
        ];
        return glyphs[i];
    }

    compute {
        let a = element();
        return if a >= 80 && a < 160 { font(a - 80) }
            else if a >= 512 && a < 512 + count(rom) { at(rom, a - 512) }
            else { 0 };
    }
}

/// The registers: V0..VF at 0..15, I at 16, PC at 17, SP at 18, DT at 19,
/// ST at 20, the random state at 21, the stack at 32..47.
kernel chip8.start@1 {
    requires { field.write; }
    output result: Bytes;
    compute {
        return match element() { 17 => 512, 21 => 12345, _ => 0 };
    }
}

/// One step of the machine per element of `ticks`; the opcode it ran is
/// the output, for the record.
kernel chip8.step@1 {
    requires { field.read; field.write; input.read; }
    input ticks: Rows<Int>;
    memory ram: Bytes;
    memory regs: Bytes;
    memory screen: Screen;
    output result: Rows<Int>;

    // The keypad on the keyboard: key 0 to F as X 1 2 3 Q W E A S D Z C 4 R F V.
    fn pressed(k: Int) -> Bool {
        return key([88, 49, 50, 51, 81, 87, 69, 65, 83, 68, 90, 67, 52, 82, 70, 86][k]);
    }

    scan with n = 0 {
        // The timers, once a frame.
        let dt = at(regs, 19);
        if index() == 0 && dt > 0 { put(regs, 19, dt - 1) } else { 0 };
        let st = at(regs, 20);
        if index() == 0 && st > 0 { put(regs, 20, st - 1) } else { 0 };
        // Fetch and decode.
        let pc = at(regs, 17);
        let op = (at(ram, pc) << 8) | at(ram, pc + 1);
        let hi = op >> 12;
        let x = (op >> 8) & 15;
        let y = (op >> 4) & 15;
        let nibble = op & 15;
        let kk = op & 255;
        let nnn = op & 4095;
        let vx = at(regs, x);
        let vy = at(regs, y);
        let i = at(regs, 16);
        let sp = at(regs, 18);
        let next = match hi {
            0 => {
                if op == 224 {
                    loop 2048 with k = 0 { put(screen, ivec2(index() % 64, index() / 64), 0) };
                    pc + 2
                } else if op == 238 {
                    put(regs, 18, sp - 1);
                    at(regs, 32 + sp - 1)
                } else { pc + 2 }
            },
            1 => nnn,
            2 => { put(regs, 32 + sp, pc + 2); put(regs, 18, sp + 1); nnn },
            3 => if vx == kk { pc + 4 } else { pc + 2 },
            4 => if vx != kk { pc + 4 } else { pc + 2 },
            5 => if vx == vy { pc + 4 } else { pc + 2 },
            6 => { put(regs, x, kk); pc + 2 },
            7 => { put(regs, x, (vx + kk) & 255); pc + 2 },
            8 => {
                let r = match nibble {
                    0 => vy, 1 => vx | vy, 2 => vx & vy, 3 => vx ^ vy, 4 => vx + vy,
                    5 => vx - vy, 6 => vx >> 1, 7 => vy - vx, _ => vx << 1
                };
                let flag = match nibble {
                    4 => int(r > 255),
                    5 => int(vx >= vy),
                    6 => vx & 1,
                    7 => int(vy >= vx),
                    14 => (vx >> 7) & 1,
                    _ => -1
                };
                put(regs, x, r & 255);
                if flag >= 0 { put(regs, 15, flag) } else { 0 };
                pc + 2
            },
            9 => if vx != vy { pc + 4 } else { pc + 2 },
            10 => { put(regs, 16, nnn); pc + 2 },
            11 => nnn + at(regs, 0),
            12 => {
                let s = at(regs, 21);
                let s1 = s ^ (s << 13);
                let s2 = s1 ^ (s1 >> 17);
                let s3 = s2 ^ (s2 << 5);
                put(regs, 21, s3);
                put(regs, x, s3 & kk);
                pc + 2
            },
            13 => {
                // Sprite rows from I, xor-drawn at (VX, VY) with wrap; VF says
                // whether a pixel went out.
                let hit = loop nibble with any = 0 {
                    let row = index();
                    let byte = at(ram, i + row);
                    let py = (vy + row) & 31;
                    loop 8 with h = any {
                        let bit = (byte >> (7 - index())) & 1;
                        let px = (vx + index()) & 63;
                        let old = at(screen, vec2(px, py));
                        let now = old ^ bit;
                        put(screen, vec2(px, py), now);
                        if old == 1 && now == 0 { 1 } else { h }
                    }
                };
                put(regs, 15, hit);
                pc + 2
            },
            14 => {
                let down = pressed(vx & 15);
                if (kk == 158 && down) || (kk == 161 && !down) { pc + 4 } else { pc + 2 }
            },
            15 => match kk {
                7 => { put(regs, x, at(regs, 19)); pc + 2 },
                10 => {
                    // Wait for a key: the lowest one down, else stay here.
                    let k = loop 16 with found = -1 { if pressed(index()) { break index(); } found };
                    if k >= 0 { put(regs, x, k); pc + 2 } else { pc }
                },
                21 => { put(regs, 19, vx); pc + 2 },
                24 => { put(regs, 20, vx); pc + 2 },
                30 => { put(regs, 16, (i + vx) & 4095); pc + 2 },
                41 => { put(regs, 16, 80 + (vx & 15) * 5); pc + 2 },
                51 => { put(ram, i, vx / 100); put(ram, i + 1, (vx / 10) % 10); put(ram, i + 2, vx % 10); pc + 2 },
                85 => { loop x + 1 with r = 0 { put(ram, i + index(), at(regs, index())) }; pc + 2 },
                101 => { loop x + 1 with r = 0 { put(regs, index(), at(ram, i + index())) }; pc + 2 },
                _ => pc + 2
            },
            _ => pc + 2
        };
        put(regs, 17, next & 4095);
        return op;
    }
}

/// The screen, each of its 64 by 32 cells a block of the picture with a
/// faint grid, lit green.
kernel chip8.view@1 {
    requires { field.read; field.write; }
    input screen: Screen;
    output result: Image;
    compute {
        let uv = (coord() + 0.5) / domain() * vec2(64.0, 32.0);
        let on = at(screen, floor(uv)) == 1;
        let local = fract(uv);
        let edge = local.x < 0.08 || local.y < 0.08;
        let lit = if on { vec3(0.55, 0.95, 0.45) } else { vec3(0.06, 0.09, 0.06) };
        let color = if edge { lit * 0.7 } else { lit };
        return vec4(color, 1.0);
    }
}
