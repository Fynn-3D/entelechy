scene ../scene.esn

# Silence, then the `1` key fills the lowest string with noise and it
# rings on through the frames after it, smoother and quieter each time
# the head goes round. Holding the key does not pluck again; letting it
# go and pressing another plucks that one.
window 320 200 1
frame 0.0
expect play.result[100] = 0.0 0.0
expect play.line[40] = 0.0 0.0
key 49 down
frame 0.0167
expect play.result[100] = 0.11349719 0.0005
expect play.line[40] = 0.4857592 0.001
key 49 up
frame 0.0333
expect play.result[100] = -0.11452211 0.0005
frame 0.0500
expect play.result[100] = 0.08482277 0.0005
key 52 down
frame 0.0667
expect play.result[100] = 0.00082624657 0.0005
expect play.line[1560] = -0.025965434 0.001
