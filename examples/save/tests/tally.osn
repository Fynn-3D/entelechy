// The scene as `scene.osn` writes it, saving where nothing ever is: a
// replay allows no writes, so the tally always starts from nothing.
use "../kernels/";

input saved: Rows<Tally> = "never.field" else fresh.result;

node fresh: save.fresh@1 { domain = 1; }
node tally: save.tally@1 { last <~ tally.result from saved; }
node show: save.show@1 { tally <- tally.result; domain = vec2(160, 160); }

output picture <- show.result;
output kept <- tally.result to "never.field";
