// Press space to count. Whenever the count changes it is written to
// `saves/tally.field`, and when the scene starts again it is read back
// from there; with no file yet, the count starts from nothing. Writing
// needs `--allow file.write=examples/save/saves`.
use "kernels/";

input saved: Rows<Tally> = "saves/tally.field" else fresh.result;

node fresh: save.fresh@1 { domain = 1; }
node tally: save.tally@1 { last <~ tally.result from saved; }
node show: save.show@1 { tally <- tally.result; domain = vec2(160, 160); }

output picture <- show.result;
output kept <- tally.result to "saves/tally.field";
