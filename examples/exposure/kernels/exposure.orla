// Auto-exposure: a reduction measures the whole frame, then a Kernel
// tone-maps every pixel by what it found. The measurement is one `Rows`
// element that never becomes an image.
struct Light { sum: Float; max: Float; count: Int; }
type Measure = Rows<Light>;

// A bright scene: a sun disc over a sky gradient, drifting with time,
// with values well above one.
kernel exposure.scene@1 {
    requires { field.write; time.read; }
    param brightness: Float = 6.0;
    output result: Image;

    compute {
        let uv = (coord() + vec2(0.5, 0.5)) / domain();
        let sun = vec2(0.5 + 0.25 * sin(time() * 0.3), 0.35);
        let d = length(uv - sun);
        let disc = brightness * exp(-d * d * 60.0);
        let sky = mix(vec3(0.6, 0.75, 1.0), vec3(0.05, 0.1, 0.3), uv.y) * 0.4;
        let color = sky + vec3(1.0, 0.95, 0.8) * disc;
        return vec4(color.x, color.y, color.z, 1.0);
    }
}

// The reduction: `compute` runs once per pixel of `source` and `merge`
// folds the results pairwise, so it must be associative and commutative.
kernel exposure.measure@1 {
    requires { field.read; field.write; }
    input source: Image;
    output result: Measure;

    fn luma(c: Vec4) -> Float {
        return c.r * 0.2126 + c.g * 0.7152 + c.b * 0.0722;
    }

    compute {
        let l = luma(sample(source));
        return Light { sum: l, max: l, count: 1 };
    }

    merge(a, b) {
        return Light { sum: a.sum + b.sum, max: max(a.max, b.max), count: a.count + b.count };
    }
}

// Scales the frame so its mean luma lands on `target`, then rolls off
// the highlights.
kernel exposure.apply@1 {
    requires { field.read; field.write; }
    input source: Image;
    input light: Measure;
    param target: Float = 0.3;
    output result: Image;

    compute {
        let m = at(light, 0);
        let mean = m.sum / float(m.count);
        let gain = target / max(mean, 0.001);
        let c = sample(source) * gain;
        let mapped = vec3(c.r, c.g, c.b) / (vec3(1.0, 1.0, 1.0) + vec3(c.r, c.g, c.b));
        return vec4(mapped.x, mapped.y, mapped.z, 1.0);
    }
}
