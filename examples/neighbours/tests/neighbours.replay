scene ../scene.osn
window 192 108
param count 4096
param cols 16
param bits 8
param radius 0.0625

# The sort is a sort: no pair of neighbours in the order is out of
# order, and no equal pair swapped. No cell holds more bodies than a
# body will look at, which is the one thing that would make the grid
# answer differently from every pair.
frame 0.0
expect unsorted.result[0] = 0
expect crowded.result[0] = 0
expect 96 54 = 0.127 0.121 0.120 0.02
expect 40 80 = 0.057 0.058 0.072 0.02
expect 150 30 = 0.079 0.078 0.088 0.02

# The same frame asking every pair instead of the nine cells around
# each body: the same forces, summed in another order, so the same
# picture to rounding.
reset
param grid false
frame 0.0
expect 96 54 = 0.127 0.121 0.120 0.02
expect 40 80 = 0.057 0.058 0.072 0.02
expect 150 30 = 0.079 0.078 0.088 0.02

# Further along, with the grid: the bodies have gathered.
reset
param grid true
frame 0.0
frame 0.5
frame 1.0
expect unsorted.result[0] = 0
expect crowded.result[0] = 0
expect 96 54 = 0.136 0.129 0.125 0.02
