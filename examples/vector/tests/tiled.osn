// The garden drawn plainly and tiled through one look, and how many
// pixels the two draw differently.
use "../../../packages/vector.orlapkg";

input shapes: Rows<Shape> = "../assets/garden.shapes.field";
input segments: Rows<Vec4> = "../assets/garden.segments.field";
input stops: Rows<Stop> = "../assets/garden.stops.field";
input view: Rows<Vec2> = "../assets/garden.view.field";
param center: Vec2 = vec2(200.0, 150.0);
param zoom: Float = 1.0;

node look: kernel {
    requires { field.read; field.write; }
    param center: Vec2 = center;
    param zoom: Float = zoom;
    output result: Rows<Look>;
    compute { return Look { center: center, zoom: zoom }; }
    domain = 1;
}
node across: Grid<Int> { domain = floor(window() * vec2(1, 0) + vec2(0, 1)); }
node down: Grid<Int> { domain = floor(window() * vec2(0, 1) + vec2(1, 0)); }
node frame: vector.frame@1 {
    across <- across.result; down <- down.result; view <- view; look <- look.result;
    domain = count(across) + count(down) + 1;
}
node plain: vector.draw@1 {
    shapes <- shapes; segments <- segments; stops <- stops; frame <- frame.result;
    domain = window();
}
node tiled: graph "../../../packages/vector.orlapkg/graphs/draw.osn" {
    shapes <- shapes; segments <- segments; stops <- stops; view <- view;
    look <- look.result;
}
node differ: kernel {
    requires { field.read; field.write; }
    input plain: Image <- plain.result;
    input tiled: Image <- tiled.picture;
    output result: Rows<Int>;
    compute { return if sample(plain) == sample(tiled) { 0 } else { 1 }; }
    merge(a, b) { return a + b; }
}

output picture <- tiled.picture;
