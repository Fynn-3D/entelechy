scene tiled.osn
window 400 300

# The tiled drawing is the plain one word for word, whole, zoomed into
# an edge, zoomed out, and at a window no whole number of tiles.
frame 0.0
expect differ.result[0] = 0
expect 120 170 = 1.0 0.8275 0.302 0.005

param center vec2(300.0, 60.0)
param zoom 23.0
frame 0.1
expect differ.result[0] = 0

param center vec2(120.0, 150.0)
param zoom 0.3
frame 0.2
expect differ.result[0] = 0

window 333 217
param center vec2(250.0, 200.0)
param zoom 3.7
frame 0.3
expect differ.result[0] = 0
