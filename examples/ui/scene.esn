// A settings screen and a hero's panel drawn with the widgets package. The
// arrows move through the options and change them, Enter or Space
// confirms, Esc goes back; a pad's left stick, south and east do
// the same; the pointer lights the row it is over and a click confirms
// it or sets the volume where it falls.
use "../../packages/text.entpkg";
use "../../packages/ui.entpkg";
use "../../packages/controls.entpkg";
use "kernels/settings.ent";

// The bitmap font the letters are drawn from, and the words, a row a
// line.
input font: Grid<Float> = "../../packages/text.entpkg/assets/font.png";
input text: Rows<Int> = bytes "assets/ui.txt";

node none: text.no_codes@1 { domain = 1; }
node words: graph "../../packages/text.entpkg/graphs/decode.esn" { text <- text; codes <- none.result; width = 20; }

// The navigation and the options it changes.
node layout: demo.layout@1 { domain = 1; }
node nav0: ui.navigation_start@1 { domain = 1; }
node keys: ui.navigation_keys@1 { domain = 2; }
node hands0: controls.start@1 { domain = 1; }
node hands: controls.read@1 { previous <~ hands.result from hands0.result; actions <- keys.result; }
node pointer0: controls.pointer_start@1 { domain = 1; }
node pointer: controls.pointer@1 { previous <~ pointer.result from pointer0.result; }
node nav: ui.navigate@2 { rows = 5; previous <~ nav.result from nav0.result; list <- layout.result; hands <- hands.result; pointer <- pointer.result; domain = 1; }
node settings0: demo.settings_start@1 { domain = 1; }
node settings: demo.settings@1 { previous <~ settings.result from settings0.result; nav <- nav.result; domain = 1; }

node view: demo.view@1 { letters <- font; words <- words.letters; settings <- settings.result; nav <- nav.result; domain = window(); }

output result <- view.result;
