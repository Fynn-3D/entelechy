scene glyphs.esn

# 中's square drawn into the atlas from its outline: ink inside, none at
# the corner; the code it holds; 文, which it lacks, counted once.
frame 0.0
expect atlas.result[389] = 1
expect atlas.result[0] = 0
expect codes.result[0] = 20013
expect lacking.result[0] = 1

# 42 rising a third of a second after the blow: its figures in the
# color given, their shadow beside them, the dark round them.
expect 34 23 = 1.000 0.300 0.200
expect 46 23 = 1.000 0.300 0.200
expect 42 26 = 0.040 0.040 0.048
expect 30 14 = 0.100 0.100 0.120
