// The image package on small pictures whose answers are known, for
// image.replay.
use "../../../packages/image.entpkg";

// A ramp: red grows across, green down, blue a half; 8 by 8.
node ramp: kernel {
    requires { field.write; }
    output result: Image;
    domain = vec2(8, 8);
    compute { let c = coord(); return vec4(c.x / 7.0, c.y / 7.0, 0.5, 1.0); }
}
// One colour everywhere, 16 by 16.
node flat: kernel {
    requires { field.write; }
    output result: Image;
    domain = vec2(16, 16);
    compute { return vec4(0.3, 0.6, 0.9, 1.0); }
}
// A white pixel at (4, 4) on black, 9 by 9.
node dot: kernel {
    requires { field.write; }
    output result: Image;
    domain = vec2(9, 9);
    compute {
        let c = icoord();
        return if c.x == 4 && c.y == 4 { vec4(1.0, 1.0, 1.0, 1.0) } else { vec4(0.0, 0.0, 0.0, 1.0) };
    }
}
// Two greys, 0.2 in the left half and 0.8 in the right, 8 by 8.
node halves: kernel {
    requires { field.write; }
    output result: Image;
    domain = vec2(8, 8);
    compute { let g = if coord().x < 4.0 { 0.2 } else { 0.8 }; return vec4(g, g, g, 1.0); }
}
node one: kernel {
    requires { field.write; }
    output result: Rows<Float>;
    domain = 9;
    compute { return float(element() == 4); }
}
node box: kernel {
    requires { field.write; }
    output result: Rows<Float>;
    domain = 9;
    compute { return 1.0 / 9.0; }
}
node straight: kernel {
    requires { field.write; }
    output result: Rows<Vec4>;
    domain = 2;
    compute { let v = float(element()); return vec4(v, v, v, v); }
}
// The colour functions: HSV of (0.25, 0.5, 0.75); how far its HSV and
// Oklab round trips land from it; the luminance of white.
node colour: kernel {
    requires { field.write; }
    output result: Rows<Vec4>;
    domain = 3;
    compute {
        let c = vec3(0.25, 0.5, 0.75);
        let h = rgb_to_hsv(c);
        return if element() == 0 { vec4(h, 0.0) }
            else if element() == 1 { vec4(length(hsv_to_rgb(h) - c), length(oklab_to_linear(linear_to_oklab(c)) - c), luminance(vec3(1.0, 1.0, 1.0)), 0.0) }
            else { let s = linear_to_srgb(srgb_to_linear(c)); vec4(s, srgb_decode(0.5)) };
    }
}
node base: kernel {
    requires { field.write; }
    output result: Image;
    domain = vec2(2, 2);
    compute { return vec4(0.25, 0.5, 0.75, 1.0); }
}
node grey: kernel {
    requires { field.write; }
    output result: Image;
    domain = vec2(2, 2);
    compute { return vec4(0.5, 0.5, 0.5, 1.0); }
}

// A base half there, for compositing over what does not cover.
node thin: kernel {
    requires { field.write; }
    output result: Image;
    domain = vec2(2, 2);
    compute { return vec4(0.25, 0.5, 0.75, 0.5); }
}

node multiply: image.blend@1 { base <- base.result; top <- grey.result; mode = Blend.Multiply; space = Space.Linear; }
node screen: image.blend@1 { base <- base.result; top <- grey.result; mode = Blend.Screen; space = Space.Linear; }
node overlay: image.blend@1 { base <- base.result; top <- grey.result; mode = Blend.Overlay; space = Space.Linear; }
node half: image.blend@1 { base <- base.result; top <- grey.result; opacity = 0.5; space = Space.Linear; }
node multiply_encoded: image.blend@1 { base <- base.result; top <- grey.result; mode = Blend.Multiply; }
node over_thin: image.blend@1 { base <- thin.result; top <- grey.result; opacity = 0.5; space = Space.Linear; }

node flat_blur: graph "../../../packages/image.entpkg/graphs/blur.esn" { source <- flat.result; sigma = 1.0; }
node dot_blur: graph "../../../packages/image.entpkg/graphs/blur.esn" { source <- dot.result; sigma = 1.0; }
node shrunk: image.shrink@1 { source <- ramp.result; domain = vec2(4, 4); }
node same: image.convolve@1 { source <- ramp.result; weights <- one.result; }
node mean: image.convolve@1 { source <- ramp.result; weights <- box.result; }
node bigger: image.resize@1 { source <- ramp.result; domain = vec2(16, 16); }
node flat_edges: image.edges@1 { source <- flat.result; }
node grown: image.morph@1 { source <- dot.result; radius = 2; }
node worn: image.morph@1 { source <- grown.result; radius = 1; mode = Morph.Erode; }

node brighter: image.adjust@1 { source <- flat.result; exposure = 1.0; }
node greyed: image.adjust@1 { source <- flat.result; saturation = 0.0; }
node turned: image.adjust@1 { source <- flat.result; hue = 1.0; }
node levelled: image.levels@1 { source <- flat.result; black = 0.2; white = 0.8; }
node curved: image.curve@1 { source <- flat.result; curve <- straight.result; }
node neutral: image.neutral@1 { n = 17; domain = vec2(289, 17); }
node looked_up: image.lut@1 { source <- flat.result; lut <- neutral.result; }
// Three colours from dark to light: black, red, white; the ramp held
// to them by nearness and by lightness.
node three: kernel {
    requires { field.write; }
    output result: Rows<Vec3>;
    domain = 3;
    compute { return match element() { 0 => vec3(0.0, 0.0, 0.0), 1 => vec3(1.0, 0.0, 0.0), _ => vec3(1.0, 1.0, 1.0) }; }
}
node mapped: image.tonemap@2 { source <- flat.result; }
// Two colours, black and white; a grey of 0.064 (Oklab lightness 0.4).
node two: kernel {
    requires { field.write; }
    output result: Rows<Vec3>;
    domain = 2;
    compute { return if element() == 0 { vec3(0.0, 0.0, 0.0) } else { vec3(1.0, 1.0, 1.0) }; }
}
node dim: kernel {
    requires { field.write; }
    output result: Image;
    domain = vec2(4, 4);
    compute { return vec4(0.064, 0.064, 0.064, 1.0); }
}
node dithered: image.dither@1 { source <- dim.result; colors <- two.result; }
// A red pixel at (2, 2) on nothing, 5 by 5.
node speck: kernel {
    requires { field.write; }
    output result: Image;
    domain = vec2(5, 5);
    compute { let c = icoord(); return if c.x == 2 && c.y == 2 { vec4(1.0, 0.0, 0.0, 1.0) } else { vec4(0.0, 0.0, 0.0, 0.0) }; }
}
node lined: image.outline@1 { source <- speck.result; }
node lined_round: image.outline@1 { source <- speck.result; corners = true; }
node cast: image.shadow@1 { source <- speck.result; }
// A sheet four cells across of 6 by 5: texel (13, 7) and frame timing.
node sheet: kernel {
    requires { field.write; }
    output result: Rows<Vec4>;
    domain = 2;
    compute {
        let place = sheet_place(ivec2(13, 7), 4, ivec2(6, 5));
        let back = sheet_texel(place.frame, 4, ivec2(6, 5), place.at);
        return if element() == 0 { vec4(float(place.frame), float(place.at.x), float(place.at.y), float(back.x)) }
            else { vec4(float(back.y), float(frame_at(1.3, 4.0, 3, true)), float(frame_at(1.3, 4.0, 3, false)), float(frame_at(0.3, 4.0, 3, false))) };
    }
}
node nearest: image.palette@2 { source <- ramp.result; colors <- three.result; }
node ramped: image.ramp@1 { source <- ramp.result; colors <- three.result; }

node even: graph "../../../packages/image.entpkg/graphs/equalize.esn" { source <- halves.result; }
node field: graph "../../../packages/image.entpkg/graphs/distance.esn" { mask <- dot.result; passes = 5; }

output result <- even.result;
