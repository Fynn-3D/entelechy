// A score played and drawn. `orla-import` read the MIDI file into rows
// of notes, five numbers each; this reads those rows, sums the notes
// that sound at each moment into the block the sound card takes, and
// paints the same notes as a piano roll with a playhead over it.

// The layout `orla-import` writes: seconds, seconds, key, force, channel.
struct Note { start: Float; duration: Float; pitch: Int; velocity: Float; channel: Int; }
type Notes = Rows<Note>;

// A key's frequency, twelve to the octave from A above middle C.
fn hertz(pitch: Int) -> Float {
    return 440.0 * pow(2.0, float(pitch - 69) / 12.0);
}

// How loud a note is `age` seconds in: a quick rise, a slow fall, and
// silence once it is over.
fn envelope(age: Float, duration: Float) -> Float {
    let rise = clamp(age / 0.012, 0.0, 1.0);
    let fall = clamp(1.0 - (age - duration) / 0.09, 0.0, 1.0);
    let body = 0.35 + 0.65 * exp(-age * 1.4);
    return if age < 0.0 { 0.0 } else { rise * fall * body };
}

/// The block of samples for this frame: every note that sounds at this
/// sample, added. The loop counts the score's own rows, so a scene may
/// hand it a song of any length.
kernel score.voice@1 {
    requires { field.read; field.write; time.read; }
    input song: Notes;
    param gain: Float = 0.22;
    param loops: Float = 9.6;          // seconds before the song repeats
    output result: Rows<Float>;
    compute {
        let hz = if rate() > 0.0 { rate() } else { 48000.0 };
        let at = (time() + float(element()) / hz) % loops;
        let n = count(song);
        let mixed = loop n with sum = 0.0 {
            let note = at(song, index());
            let age = at - note.start;
            let loud = envelope(age, note.duration) * note.velocity;
            // The bass takes a rounder tone than the melody.
            let f = hertz(note.pitch);
            let tone = if note.channel == 0 {
                sin(at * f * 6.2831853) * 0.7 + sin(at * f * 2.0 * 6.2831853) * 0.3
            } else {
                sin(at * f * 6.2831853) + sin(at * f * 3.0 * 6.2831853) * 0.12
            };
            sum + tone * loud
        };
        return mixed * gain;
    }
}

/// The piano roll: time across, key up, one bar per note, and the line
/// that says where the sound is.
kernel score.roll@1 {
    requires { field.read; field.write; time.read; }
    input song: Notes;
    param loops: Float = 9.6;
    param lowest: Int = 38;
    param highest: Int = 80;
    output result: Image;
    compute {
        let res = domain();
        let uv = (coord() + vec2(0.5, 0.5)) / res;
        let second = uv.x * loops;
        let key = float(highest) - uv.y * float(highest - lowest);
        let n = count(song);
        // The note under this pixel, if one is: its channel, and how far
        // through it the pixel stands.
        let found = loop n with hit = vec3(-1.0, 0.0, 0.0) {
            let note = at(song, index());
            let inside = second >= note.start
                && second < note.start + note.duration
                && key >= float(note.pitch) - 0.5
                && key < float(note.pitch) + 0.5;
            if inside {
                vec3(float(note.channel), note.velocity, (second - note.start) / max(note.duration, 0.001))
            } else {
                hit
            }
        };
        let now = time() % loops;
        let playhead = abs(second - now) < loops / res.x;
        let grid = fract(key) < 0.08 || fract(second * 2.0) < 0.01;
        let back = if grid { vec3(0.10, 0.11, 0.15) } else { vec3(0.06, 0.07, 0.10) };
        let melody = mix(vec3(0.35, 0.75, 1.0), vec3(0.75, 0.92, 1.0), found.z);
        let bass = mix(vec3(0.95, 0.55, 0.3), vec3(1.0, 0.8, 0.5), found.z);
        let sounding = second <= now && second + 0.08 > now;
        let bar = if found.x < 0.5 { melody } else { bass } * (0.55 + 0.45 * found.y);
        let lit = if sounding { bar * 1.35 } else { bar };
        let color = if playhead {
            vec3(1.0, 1.0, 0.9)
        } else if found.x >= 0.0 {
            lit
        } else {
            back
        };
        return vec4(color.x, color.y, color.z, 1.0);
    }
}
