// Tetris: the falling piece is a row of state, the settled cells a grid,
// both fed back through the Graph. The seven pieces in their four
// rotations are a table of sixteen-bit masks over a 4 by 4 box, and
// every cell question is integer vector arithmetic against that table.
struct Game {
    piece: Int; rot: Int; at: IVec2;      // the falling piece: which, how turned, where its box is
    next: Int;                            // the piece after it
    seed: Int;                            // the random state
    tick: Int; held: Int;                 // the clock's last tick, the keys held last frame
    score: Int; lines: Int; alive: Bool;
    locked: Bool; landed: Int; landed_rot: Int; landed_at: IVec2;   // what the board merges this frame
}
type State = Rows<Game>;
type Board = Grid<Int>;

// The pieces: I, O, T, S, Z, J, L; each rotation a 4 by 4 box as bits,
// bit y * 4 + x set where the piece is.
fn shape(piece: Int, rot: Int) -> Int {
    let shapes = [
        [0x00F0, 0x4444, 0x0F00, 0x2222],   // I
        [0x0066, 0x0066, 0x0066, 0x0066],   // O
        [0x0072, 0x0262, 0x0270, 0x0232],   // T
        [0x0036, 0x0462, 0x0360, 0x0231],   // S
        [0x0063, 0x0264, 0x0630, 0x0132],   // Z
        [0x0071, 0x0226, 0x0470, 0x0322],   // J
        [0x0074, 0x0622, 0x0170, 0x0223],   // L
    ];
    return shapes[piece][rot];
}

// Whether a mask covers cell `c` of its box.
fn covers(mask: Int, c: IVec2) -> Bool {
    return c.x >= 0 && c.x < 4 && c.y >= 0 && c.y < 4 && ((mask >> (c.y * 4 + c.x)) & 1) == 1;
}

// The next random state and the piece it names.
fn stir(seed: Int) -> Int { return add_wrap(mul_wrap(seed, 1103515245), 12345); }
fn pick(seed: Int) -> Int { return (seed >>> 16) % 7; }

// Whether a piece fits the board with its box at `at`: every cell of it
// inside the walls, above the floor, and on an empty cell (cells above
// the top are free, where a piece spawns).
fn fits(board: Board, mask: Int, at: IVec2) -> Bool {
    let size = isize(board);
    return loop 16 with ok = true until !ok {
        let c = ivec2(index() % 4, index() / 4);
        let cell = at + c;
        let filled = ((mask >> index()) & 1) == 1;
        let inside = cell.x >= 0 && cell.x < size.x && cell.y < size.y;
        ok && (!filled || (inside && (cell.y < 0 || at(board, cell) == 0)))
    };
}

// Whether two placed masks share a cell.
fn overlaps(a: Int, at_a: IVec2, b: Int, at_b: IVec2) -> Bool {
    return loop 16 with any = false until any {
        let c = ivec2(index() % 4, index() / 4);
        any || (covers(a, c) && covers(b, at_a + c - at_b))
    };
}

// The board's cell once a piece is merged into it.
fn merged(board: Board, c: IVec2, mask: Int, at: IVec2, color: Int) -> Int {
    let own = at(board, c);
    return if own == 0 && covers(mask, c - at) { color } else { own };
}

// Whether row `y` is full once the piece is merged.
fn full(board: Board, y: Int, mask: Int, at: IVec2) -> Bool {
    return loop 10 with all = true until !all {
        all && merged(board, ivec2(index(), y), mask, at, 1) != 0
    };
}

kernel tetris.start@1 {
    requires { field.write; }
    param seed: Int = 7;
    output result: State;
    compute {
        let second = stir(seed);
        return Game {
            piece: pick(seed), rot: 0, at: ivec2(3, 0),
            next: pick(second), seed: second,
            tick: 0, held: 0, score: 0, lines: 0, alive: true,
            locked: false, landed: 0, landed_rot: 0, landed_at: ivec2(0, 0)
        };
    }
}

// An empty board, or one with its bottom row all but one cell filled,
// for a test of the clearing.
kernel tetris.empty@1 {
    requires { field.write; }
    param prefill: Int = 0;
    output result: Board;
    compute {
        let c = icoord();
        let bottom = idomain().y - 1;
        return if prefill > 0 && c.y == bottom && c.x < 9 { 8 } else { 0 };
    }
}

// The rules, once per frame: steer on a key's press, fall on a tick or
// while down is held, drop on space, land, count the lines, spawn.
kernel tetris.step@1 {
    requires { field.read; field.write; time.read; input.read; }
    input previous: State;
    input board: Board;
    param speed: Float = 2.0;           // rows per second
    output result: State;

    compute {
        let g = sample(previous);
        let now = int(key(37)) | (int(key(39)) << 1) | (int(key(38)) << 2) | (int(key(40)) << 3) | (int(key(32)) << 4);
        let pressed = now & (g.held ^ 31);
        let alive = g.alive;
        // Sideways on a press, when the cells are free.
        let dx = if !alive { 0 } else if (pressed & 1) != 0 { -1 } else if (pressed & 2) != 0 { 1 } else { 0 };
        let shifted = g.at + ivec2(dx, 0);
        let moved_at = if dx != 0 && fits(board, shape(g.piece, g.rot), shifted) { shifted } else { g.at };
        // A turn on a press, when it fits.
        let turned = (g.rot + 1) % 4;
        let rotated = alive && (pressed & 4) != 0 && fits(board, shape(g.piece, turned), moved_at);
        let rot = if rotated { turned } else { g.rot };
        let mask = shape(g.piece, rot);
        // Falling: one row per tick, or every frame while down is held;
        // space drops to the floor at once.
        let tick = int(floor(time() * speed));
        let falling = alive && (tick != g.tick || (now & 8) != 0);
        let hard = alive && (pressed & 16) != 0;
        let dropped = if hard {
            loop 24 with at = moved_at until !fits(board, mask, at + ivec2(0, 1)) { at + ivec2(0, 1) }
        } else { moved_at };
        let can_fall = fits(board, mask, dropped + ivec2(0, 1));
        let lands = hard || (falling && !can_fall);
        let fell = !hard && falling && can_fall;
        let at = if fell { dropped + ivec2(0, 1) } else { dropped };
        // Landing: the board merges the piece; the lines it completes
        // count here; the next piece spawns, and the game ends when it
        // cannot.
        let cleared = if lands { loop 20 with n = 0 { n + int(full(board, index(), mask, at)) } } else { 0 };
        let seed = if lands { stir(g.seed) } else { g.seed };
        let spawn_at = ivec2(3, 0);
        let spawn_mask = shape(g.next, 0);
        let spawns = lands && fits(board, spawn_mask, spawn_at) && !overlaps(spawn_mask, spawn_at, mask, at);
        return Game {
            piece: if lands { g.next } else { g.piece },
            rot: if lands { 0 } else { rot },
            at: if lands { spawn_at } else { at },
            next: if lands { pick(seed) } else { g.next },
            seed: seed,
            tick: tick,
            held: now,
            score: g.score + cleared * cleared * 100,
            lines: g.lines + cleared,
            alive: alive && (!lands || spawns),
            locked: lands,
            landed: g.piece,
            landed_rot: rot,
            landed_at: at
        };
    }
}

// The settled cells: when a piece lands it is merged in, its colour the
// piece's number plus one, and every full row vanishes, the rows above
// falling by as many rows as were full beneath them.
kernel tetris.board@1 {
    requires { field.read; field.write; }
    input previous: Board;
    input game: State;
    output result: Board;

    compute {
        let g = at(game, 0);
        let c = icoord();
        return if !g.locked { sample(previous) } else {
            let mask = shape(g.landed, g.landed_rot);
            let color = g.landed + 1;
            let height = isize(previous).y;
            // From the floor up, every row that is not full lands on the
            // next free target row; this cell's source is the row that
            // lands on its own.
            let found = loop 20 with s = ivec2(-1, height - 1) {
                let row = height - 1 - index();
                if s.x >= 0 || row < 0 { s }
                else if full(previous, row, mask, g.landed_at) { s }
                else if s.y == c.y { ivec2(row, s.y - 1) }
                else { ivec2(-1, s.y - 1) }
            };
            if found.x < 0 { 0 } else { merged(previous, ivec2(c.x, found.x), mask, g.landed_at, color) }
        };
    }
}

// Pixels: the board at `cell` pixels a cell with the falling piece over
// it, the next piece in a panel to the right, grid lines, and a dimmed
// board once the game is over.
kernel tetris.draw@1 {
    requires { field.read; field.write; }
    input board: Board;
    input game: State;
    param cell: Float = 12.0;
    output result: Image;

    compute {
        let g = at(game, 0);
        let px = int(cell);
        let p = icoord();
        let c = p / px;
        let local = p % px;
        let size = isize(board);
        let palette = [
            vec3(0.08, 0.09, 0.12), vec3(0.3, 0.8, 0.9), vec3(0.9, 0.8, 0.2), vec3(0.7, 0.3, 0.8),
            vec3(0.3, 0.8, 0.3), vec3(0.9, 0.3, 0.3), vec3(0.3, 0.4, 0.9), vec3(0.9, 0.5, 0.2),
            vec3(0.45, 0.45, 0.5),
        ];
        let on_board = c.x < size.x && c.y < size.y;
        let value = if on_board {
            let settled = at(board, c);
            if settled != 0 { settled }
            else if g.alive && covers(shape(g.piece, g.rot), c - g.at) { g.piece + 1 }
            else { 0 }
        } else {
            let panel = c - ivec2(size.x + 1, 1);
            if covers(shape(g.next, 0), panel) { g.next + 1 } else { 0 }
        };
        let base = palette[value];
        let line = local.x == 0 || local.y == 0;
        let shown = if !on_board && value == 0 { vec3(0.05, 0.05, 0.07) }
            else if line { base * 0.6 }
            else { base };
        let color = if g.alive { shown } else { mix(shown, vec3(0.4, 0.1, 0.1), 0.5) };
        return vec4(color, 1.0);
    }
}
