// What the reach scene decides for itself: the point the arm reaches
// for, how much it reaches, where the camera stands, and how the arm
// and the point are lit. The posing is the `skin` package.
use "../../../packages/skin.entpkg";

struct Vertex { clip: Vec4; normal: Vec3; uv: Vec2; }
struct Tri { a: Int; b: Int; c: Int; }
struct Surface { depth: Float; normal: Vec3; uv: Vec2; id: Int; }
type Vertices = Rows<Vertex>;
type Triangles = Rows<Tri>;
type GBuffer = Grid<Surface>;

// The camera: the rig's space looked at from in front and a little
// above, the shoulder at the middle of the window.
fn view_of(p: Vec3, aspect: Float) -> Vec4 {
    let eye = vec3(0.0, 0.6, 4.2);
    let v = p - eye;
    let f = 1.7321;
    let near = 0.1;
    let far = 20.0;
    return vec4(v.x * f / aspect, v.y * f,
                v.z * far / (near - far) + near * far / (near - far), -v.z);
}

/// The point the shoulder turns to, in the rig's own space: a slow loop
/// in front of it, or, with the pointer down, where the pointer is on a
/// plane at the loop's depth.
kernel reach.target@1 {
    requires { field.write; time.read; input.read; }
    param aspect: Float = 1.7778;
    param depth: Float = 0.3;
    output result: Rows<Vec3>;
    compute {
        if pointer_down() {
            let p = pointer();
            let span = 2.0 * (4.2 + depth) / 1.7321;
            return vec3((p.x - 0.5) * span * aspect, 0.6 + (0.5 - p.y) * span, -depth);
        }
        let t = time();
        return vec3(sin(t * 0.8) * 1.6, 0.4 + sin(t * 1.3) * 1.0, -depth);
    }
}

/// How much of the reach is laid over the clip: all of it, unless a
/// scene wants the clip to show through.
kernel reach.weight@1 {
    requires { field.write; }
    param weight: Float = 1.0;
    output result: Rows<Float>;
    compute { return weight; }
}

kernel reach.project@1 {
    requires { field.read; field.write; }
    input mesh: Rows<Point>;
    param aspect: Float = 1.7778;
    output result: Vertices;
    compute {
        let v = sample(mesh);
        return Vertex { clip: view_of(v.position, aspect), normal: v.normal, uv: v.uv };
    }
}

/// The arm lit, and the point it reaches for drawn where the camera sees
/// it, so what the joint is doing can be checked by eye.
kernel reach.shade@1 {
    requires { field.read; field.write; }
    input surface: GBuffer;
    input target: Rows<Vec3>;
    param aspect: Float = 1.7778;
    param light: Vec3 = vec3(0.4, 0.8, 0.5);
    output result: Image;
    compute {
        let s = sample(surface);
        let size = domain();
        let up = coord().y / size.y;
        let sky = mix(vec3(0.10, 0.12, 0.17), vec3(0.04, 0.05, 0.07), up);
        let n = normalize(s.normal);
        let lit = max(dot(n, normalize(light)), 0.0);
        let rim = pow(1.0 - abs(n.z), 3.0) * 0.3;
        let body = vec3(0.72, 0.58, 0.44) * (0.25 + 0.75 * lit) + rim;
        let seen = if s.id < 0 { sky } else { body };
        let c = view_of(at(target, 0), aspect);
        let spot = vec2((c.x / c.w * 0.5 + 0.5) * size.x, (0.5 - c.y / c.w * 0.5) * size.y);
        let d = distance(coord() + 0.5, spot);
        let ring = d < 5.0 && d > 3.0;
        return vec4(if ring { vec3(0.95, 0.35, 0.25) } else { seen }, 1.0);
    }
}
