// An arm whose shoulder is computed and whose elbow is authored: the
// curl from Blender plays in the elbow while the shoulder turns to a
// point every frame. The turn is `animation.aim@1`, between the sample and
// the palette, so the chain below the shoulder follows it and the clip
// still bends the elbow.
use "kernels/";
use "../../packages/animation.entpkg";

input mesh: Rows<Point> = "../skin/assets/arm.vertices.field";
input faces: Triangles = "../skin/assets/arm.triangles.field";
input weights: Rows<Bound> = "../skin/assets/arm.weights.field";
input skeleton: Skeleton = "../skin/assets/arm.skeleton.field";
input curl: Clip = "../skin/assets/arm.curl.clip.field";

param rate: Float = 30.0;      // what `entelechy import` sampled the clip at
param weight: Float = 1.0;     // how much of the reach is laid over the clip

node clock: animation.clock@1 { domain = 1; }
node target: reach.target@1 { domain = 1; }
node reach: reach.weight@1 { weight = weight; domain = 1; }

node curling: animation.sample@1 { skeleton <- skeleton; clip <- curl; at <- clock.result; rate = rate; }
// The shoulder is joint 0; a bone from Blender runs along its own y.
node aimed: animation.aim@1 {
    poses <- curling.result;
    skeleton <- skeleton;
    target <- target.result;
    weight <- reach.result;
    joint = 0;
}
node palette: animation.palette@1 { poses <- aimed.result; skeleton <- skeleton; }
node posed: animation.apply@1 { mesh <- mesh; weights <- weights; palette <- palette.result; skeleton <- skeleton; }

node project: reach.project@1 { mesh <- posed.result; }
node raster: graph "../../packages/raster.entpkg/graphs/window.esn" {
    vertices <- project.result;
    triangles <- faces;
}
node view: reach.shade@1 { surface <- raster.surface; target <- target.result; domain = window(); }

output result <- view.result;
