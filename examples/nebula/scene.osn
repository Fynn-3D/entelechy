// A drift through a nebula made of noise, finished as film. The noise
// package gives the cloud, its colour and the stars; the image package
// gives the colours of heat and the wheel, and the finish: glow, depth
// of field, tone, fringing, corners and grain. `pixel` is how many
// window pixels a ray covers.
use "kernels/";
use "../../packages/image.orlapkg";

param pixel: Float = 2.0;
param steps: Int = 64;

node look: nebula.look@1 { steps = steps; domain = ceil(window() / pixel); }
node lens: nebula.lens@1 { domain = 1; }
node finish: graph "../../packages/image.orlapkg/graphs/finish.osn" {
    source <- look.result; focus <- lens.result; exposure = 1.2;
}

output result <- finish.result;
