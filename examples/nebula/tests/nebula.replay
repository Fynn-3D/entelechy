scene ../scene.osn

# The nebula through the film package's finish: the picture fills the
# window, the rays below it carry their depth (where the cloud grew half
# opaque, 30 m, or the night, 200 m), and the lens gives the finish its
# focus.
window 160 90
param steps 24
frame 0.0
frame 1.0
expect count finish.result = 14400
expect count look.result = 3600
expect look.result[1800].w >= 30.0
expect look.result[1800].w <= 200.0
expect lens.result[0] = 30.0
