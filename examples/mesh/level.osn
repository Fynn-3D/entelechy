// One level of midpoint subdivision: the rows grow by what the inputs
// say. The scene places this `level` times, carrying the vertices and
// the triangles from one level to the next.
use "kernels/";

input mesh: Vertices;
input faces: Triangles;

node vertices: mesh.split_vertices@1 { mesh <- mesh; faces <- faces; domain = count(mesh) + 3 * count(faces); }
node triangles: mesh.split_faces@1 { mesh <- mesh; faces <- faces; domain = 4 * count(faces); }

output vertices <- vertices.result;
output triangles <- triangles.result;
