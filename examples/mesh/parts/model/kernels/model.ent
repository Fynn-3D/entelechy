// A model from a file: `entelechy import` wrote the vertices, the triangles
// and the texture as Fields; project turns the model's vertices into clip
// space under an orbit, the native rasterizer lands the triangles, and
// shade reads the texture at each pixel's uv.
use "../../../../../packages/geometry.entpkg";
use "../../../../../packages/raster.entpkg";
use "../../../../../packages/mesh.entpkg";

type Model = Rows<MeshPoint>;   // as import writes it
type Vertices = Rows<Corner>;
type Triangles = Rows<Face>;
type GBuffer = Grid<Surface>;

/// Rotations as matrices, by columns: where each axis lands.
kernel model.project@1 {
    requires { field.read; field.write; time.read; }
    input mesh: Model;
    param aspect: Float = 1.3333;
    param distance: Float = 2.6;
    param tilt: Float = 0.45;
    param spin: Float = 0.5;
    output result: Vertices;
    compute {
        let v = sample(mesh);
        let angle = time() * spin;
        let orbit = rotate_x(tilt) * rotate_y(angle);   // one matrix for both
        let p = orbit * v.position;
        let n = orbit * v.normal;
        let clip = clip_point(perspective_focal(2.1445, aspect, 0.1, 10.0), p - vec3(0.0, 0.0, distance));
        return Corner { clip: clip, normal: n, uv: v.uv };
    }
}

/// The texture at the pixel's uv, lit by a key light and the sky.
kernel model.shade@1 {
    requires { field.read; field.write; }
    input surface: GBuffer;
    input albedo: Image;
    param light: Vec3 = vec3(0.4, 0.8, 0.5);
    output result: Image;
    compute {
        let s = sample(surface);
        let uv = coord() / domain();
        let sky = mix(vec3(0.12, 0.13, 0.18), vec3(0.05, 0.05, 0.08), uv.y);
        let n = normalize(s.normal);
        let l = normalize(light);
        let diffuse = max(dot(n, l), 0.0);
        let h = normalize(l + vec3(0.0, 0.0, 1.0));
        let glint = pow(max(dot(n, h), 0.0), 30.0) * 0.25;
        let tex = at_linear(albedo, s.uv * size(albedo));
        let base = tex.rgb;
        let lit = base * (0.3 + 0.7 * diffuse) + glint;
        let color = if s.id < 0 { sky } else { lit };
        return vec4(color, 1.0);
    }
}
