// How much geometry a frame places, decided inside the frame that places
// it. A camera flies over a sheet; a Kernel turns where it is into a
// resolution, and `domain = value(detail) * value(detail)` makes the
// mesh exactly that big. The number never passes through the Host as a
// parameter: it is a Field one Kernel wrote and the graph read.
use "../../../../../packages/geometry.entpkg";
use "../../../../../packages/raster.entpkg";
use "../../../../../packages/mesh.entpkg";
struct Flight { height: Float; along: Float; }

/// Where the camera is, carried from frame to frame: it climbs and dives
/// on a slow cycle and drifts forward.
kernel decided.fly@1 {
    requires { field.read; field.write; time.read; }
    input previous: Rows<Flight>;
    output result: Rows<Flight>;

    compute {
        let was = at(previous, 0);
        return Flight {
            height: 0.55 + 0.45 * sin(time() * 0.9),
            along: was.along + 0.004,
        };
    }
}

kernel decided.start@1 {
    requires { field.write; }
    output result: Rows<Flight>;
    compute { return Flight { height: 1.0, along: 0.0 }; }
}

/// The one number the whole frame is sized by: near the ground the sheet
/// is fine, far above it is coarse. A side, so the mesh is its square.
kernel decided.detail@1 {
    requires { field.read; field.write; }
    input camera: Rows<Flight>;
    param coarsest: Int = 24;
    param finest: Int = 320;
    output result: Rows<Int>;

    compute {
        let near = saturate(1.0 - at(camera, 0).height);
        let side = float(coarsest) + (float(finest) - float(coarsest)) * near * near;
        return clamp(int(side), 2, finest);
    }
}

/// The sheet, `side` by `side`, where `side` is what `detail` decided.
kernel decided.ground@1 {
    requires { field.read; field.write; }
    input detail: Rows<Int>;
    output result: Rows<MeshPoint>;

    compute {
        let side = at(detail, 0);
        let uv = mesh_lattice_uv(element(), side, side, false, false);
        let x = uv.x - 0.5;
        let z = uv.y - 0.5;
        let h = sin(x * 11.0) * cos(z * 9.0) * 0.05 + sin(x * 27.0 + z * 19.0) * 0.012;
        let dx = cos(x * 11.0) * 11.0 * 0.05 + cos(x * 27.0 + z * 19.0) * 27.0 * 0.012;
        let dz = -sin(z * 9.0) * 9.0 * 0.05 + cos(x * 27.0 + z * 19.0) * 19.0 * 0.012;
        return MeshPoint {
            position: vec3(x, h, z),
            normal: normalize(vec3(-dx, 1.0, -dz)),
            uv: uv,
        };
    }
}

/// Two faces a cell of the same lattice.
kernel decided.faces@1 {
    requires { field.read; field.write; }
    input detail: Rows<Int>;
    output result: Rows<Face>;
    compute { return mesh_lattice_face(element(), at(detail, 0), at(detail, 0), false, false); }
}

kernel decided.project@1 {
    requires { field.read; field.write; }
    input mesh: Rows<MeshPoint>;
    input camera: Rows<Flight>;
    param aspect: Float = 1.7778;
    output result: Rows<Corner>;

    compute {
        let cam = at(camera, 0);
        let v = sample(mesh);
        let p = vec3(v.position.x, v.position.y, v.position.z + fract(cam.along) - 0.5);
        // The camera looks down +z with x to the right: its own z turned
        // round for the projection, which looks down -z.
        let view = p - vec3(0.0, cam.height * 0.4, -0.85);
        return Corner {
            clip: clip_point(perspective_focal(2.0, aspect, 0.05, 10.0), vec3(view.x, view.y, -view.z)),
            normal: v.normal,
            uv: v.uv,
        };
    }
}

/// The surface lit, with the lattice drawn on it so the resolution the
/// frame chose is visible rather than merely claimed.
kernel decided.shade@1 {
    requires { field.read; field.write; }
    input surface: Grid<Surface>;
    input detail: Rows<Int>;
    output result: Image;

    compute {
        let s = sample(surface);
        let side = float(at(detail, 0));
        let sky = mix(vec3(0.42, 0.55, 0.72), vec3(0.10, 0.14, 0.24), coord().y / domain().y);
        let lit = max(dot(normalize(s.normal), normalize(vec3(0.35, 0.8, 0.45))), 0.0);
        let g = fract(s.uv * (side - 1.0));
        let wire = if min(g.x, g.y) < 0.06 { 0.55 } else { 1.0 };
        let ground = vec3(0.34, 0.46, 0.28) * (0.2 + 0.8 * lit) * wire;
        return vec4(if s.id < 0 { sky } else { ground }, 1.0);
    }
}
