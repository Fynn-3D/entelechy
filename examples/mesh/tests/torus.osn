// The scene at its real size and default parameters; time 0 fixes the
// rotation.
use "../kernels/";

node torus: mesh.torus@1 { domain = 1152; }
node faces: mesh.torus_faces@1 { domain = 2304; }
node vertices: mesh.split_vertices@1 { mesh <- torus.result; faces <- faces.result; domain = count(mesh) + 3 * count(faces); }
node triangles: mesh.split_faces@1 { mesh <- torus.result; faces <- faces.result; domain = 4 * count(faces); }
node project: mesh.project@1 { mesh <- vertices.result; }
node raster: native.rasterize@1 {
    vertices <- project.result;
    triangles <- triangles.result;
    domain = vec2(320, 240);
}
node view: mesh.shade@1 { surface <- raster.surface; }

output result <- view.result;
