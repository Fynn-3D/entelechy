// The scene at its real size and default parameters; time 0 fixes the
// rotation.
use "../kernels/";

param level: Int = 1;

node torus: mesh.torus@1 { domain = 1152; }
node faces: mesh.torus_faces@1 { domain = 2304; }
node subdivided: graph "../level.osn" {
    times = level;
    carry mesh <- vertices;
    carry faces <- triangles;
    mesh <- torus.result;
    faces <- faces.result;
}
node project: mesh.project@1 { mesh <- subdivided.vertices; }
node raster: native.rasterize@1 {
    vertices <- project.result;
    triangles <- subdivided.triangles;
    domain = vec2(320, 240);
}
node view: mesh.shade@1 { surface <- raster.surface; }

output result <- view.result;
