// The raster package's canvas preset held to the fast path's and to its
// plain preset: the torus drawn onto an empty canvas by the package's
// `canvas.esn` and by `native.rasterize@3`, and by `raster.esn` at the
// canvas's size, the pixels they draw differently counted. The two
// presets are the same Kernels and draw the same surface to the bit on
// every backend; on the interpreter and the JIT the fast path is the
// package's rule written in Rust, on a GPU the device's rasterizer. The
// keys alone likewise: `raster.cover@4` and its fast path `native.cover@1`,
// onto the empty canvas and onto a wall of keys the torus is half in
// front of.
use "../kernels/";
use "../../../packages/raster.entpkg";

param level: Int = 1;

node torus: mesh.torus_points@1 { domain = 1152; }
node faces: mesh.lattice_faces@1 { columns = 48; rows = 24; wrap_columns = true; wrap_rows = true; domain = 2304; }
node subdivided: graph "../../../packages/mesh.entpkg/graphs/subdivision.esn" {
    times = level;
    carry points <- points;
    carry faces <- faces;
    points <- torus.result;
    faces <- faces.result;
}
node project: torus.project@1 { mesh <- subdivided.points; }

node canvas: Grid<Long> { domain = vec2(320, 240); value = 9223372036854775807l; }
node package: graph "../../../packages/raster.entpkg/graphs/canvas.esn" {
    vertices <- project.result;
    triangles <- subdivided.faces;
    canvas <- canvas.result;
}
node native: native.rasterize@3 {
    vertices <- project.result;
    triangles <- subdivided.faces;
    canvas <- canvas.result;
    domain = size(canvas);
}
// A wall at depth 0.9605, triangle row 7, across the canvas.
node wall: Grid<Long> { domain = vec2(320, 240); value = 4572810946581364743l; }
node cover: raster.cover@4 { triangles <- subdivided.faces; vertices <- project.result; keys <- canvas.result; }
node fast_cover: native.cover@1 { triangles <- subdivided.faces; vertices <- project.result; keys <- canvas.result; domain = size(keys); }
node walled: raster.cover@4 { triangles <- subdivided.faces; vertices <- project.result; keys <- wall.result; }
node fast_walled: native.cover@1 { triangles <- subdivided.faces; vertices <- project.result; keys <- wall.result; domain = size(keys); }
node plain: graph "../../../packages/raster.entpkg/graphs/surface.esn" {
    vertices <- project.result;
    triangles <- subdivided.faces;
    width = 320;
    height = 240;
}

// How many pixels the canvas preset draws other than the plain one, any
// word of the surface to the bit.
node apart: kernel {
    requires { field.read; field.write; }
    input over: GBuffer <- package.surface;
    input sized: GBuffer <- plain.surface;
    output result: Rows<Int>;
    compute over over {
        let a = sample(over);
        let b = sample(sized);
        let same = a.id == b.id && bits(a.depth) == bits(b.depth)
            && bits(a.uv.x) == bits(b.uv.x) && bits(a.uv.y) == bits(b.uv.y) && bits(a.normal.z) == bits(b.normal.z);
        return if same { 0 } else { 1 };
    }
    merge(a, b) { return a + b; }
}

// How many pixels the preset and the fast path give a different
// triangle, or none where the other has one.
node differ: kernel {
    requires { field.read; field.write; }
    input over: GBuffer <- package.surface;
    input fast: GBuffer <- native.surface;
    output result: Rows<Int>;
    compute over over { return int(sample(over).id != sample(fast).id); }
    merge(a, b) { return a + b; }
}

// How many pixels the torus covers, drawn by the preset.
node drawn: kernel {
    requires { field.read; field.write; }
    input over: GBuffer <- package.surface;
    output result: Rows<Int>;
    compute over over { return int(sample(over).id >= 0); }
    merge(a, b) { return a + b; }
}

// How many pixels two covers give a different triangle (the key's low
// word), or one where the other gives none: onto the empty canvas, and
// onto the wall.
node rows_apart: kernel {
    requires { field.read; field.write; }
    input a: Grid<Long> <- cover.result;
    input b: Grid<Long> <- fast_cover.result;
    output result: Rows<Int>;
    compute over a { return int((sample(a) & 4294967295l) != (sample(b) & 4294967295l)); }
    merge(x, y) { return x + y; }
}
node walled_rows_apart: kernel {
    requires { field.read; field.write; }
    input a: Grid<Long> <- walled.result;
    input b: Grid<Long> <- fast_walled.result;
    output result: Rows<Int>;
    compute over a { return int((sample(a) & 4294967295l) != (sample(b) & 4294967295l)); }
    merge(x, y) { return x + y; }
}

// How many pixels the torus is drawn behind the wall at: the wall's key
// kept where the torus covers the empty canvas.
node behind_wall: kernel {
    requires { field.read; field.write; }
    input a: Grid<Long> <- walled.result;
    input drawn: Grid<Long> <- cover.result;
    output result: Rows<Int>;
    compute over a { return int(sample(a) == 4572810946581364743l && sample(drawn) != 9223372036854775807l); }
    merge(x, y) { return x + y; }
}

node view: torus.shade@1 { surface <- package.surface; }

output result <- view.result;
