scene ../parts/detail/scene.esn
window 640 360

# High over the ground: the Kernel asks for the coarsest mesh it has and
# the graph places exactly that much — 24 by 24 vertices, and the two
# triangles per cell that go with them.
frame 1.2
expect detail.result[0] = 24
expect count ground.result = 576
expect count faces.result = 1058
expect 320 340 = 0.224 0.303 0.184 0.03
expect 320 200 = 0.242 0.322 0.453 0.03

# Lower: the same nodes, a finer sheet, nothing in the scene rewritten.
frame 0.0
expect detail.result[0] = 83
expect count ground.result = 6889
expect count faces.result = 13448
expect 320 340 = 0.153 0.207 0.126 0.03
expect 320 200 = 0.242 0.322 0.453 0.03

# Down on the deck: a hundred times the geometry of the first frame,
# decided by a Kernel from a Field no parameter passed through.
frame 5.2
expect detail.result[0] = 263
expect count ground.result = 69169
expect count faces.result = 137288
expect 320 340 = 0.077 0.105 0.064 0.03
# the sheet now reaches up the screen where it was sky
expect 320 200 = 0.155 0.210 0.128 0.03
