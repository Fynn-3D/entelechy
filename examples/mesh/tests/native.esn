// The torus drawn by the fast path: `native.rasterize@1` in place of the
// raster package, one node for another. On the interpreter and the JIT
// it draws what the package draws, bit for bit; on a GPU it is the
// device's rasterizer, which may take an edge pixel the other way.
use "../kernels/";

param level: Int = 1;

node torus: mesh.torus_points@1 { domain = 1152; }
node faces: mesh.lattice_faces@1 { columns = 48; rows = 24; wrap_columns = true; wrap_rows = true; domain = 2304; }
node subdivided: graph "../../../packages/mesh.entpkg/graphs/subdivision.esn" {
    times = level;
    carry points <- points;
    carry faces <- faces;
    points <- torus.result;
    faces <- faces.result;
}
node project: torus.project@1 { mesh <- subdivided.points; }
node raster: native.rasterize@1 {
    vertices <- project.result;
    triangles <- subdivided.faces;
    domain = vec2(320, 240);
}
node view: torus.shade@1 { surface <- raster.surface; }

output result <- view.result;
