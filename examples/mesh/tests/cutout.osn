// The raster package's cutout held to the fast path's: the torus drawn
// through a checker mask, half its texels clear, by the package's
// `cutout.osn` and by `native.rasterize@2`, and the pixels they draw
// differently counted — which triangle, and its depth to the bit. On the
// interpreter and the JIT the fast path is the package's rule written in
// Rust, so none differ; on a GPU it is the device's rasterizer, which
// may take an edge pixel the other way. The same torus drawn without a
// mask says how much the cutout took away.
use "../kernels/";

param level: Int = 1;
param cutout: Float = 0.5;

node torus: mesh.torus@1 { domain = 1152; }
node faces: mesh.torus_faces@1 { domain = 2304; }
node subdivided: graph "../level.osn" {
    times = level;
    carry mesh <- vertices;
    carry faces <- triangles;
    mesh <- torus.result;
    faces <- faces.result;
}
node project: mesh.project@1 { mesh <- subdivided.vertices; }

// A checker of eight texels a square: alpha one, then zero.
node mask: kernel {
    requires { field.write; }
    output result: Image;
    domain = vec2(64, 64);
    compute {
        let square = floor(coord() / 8.0);
        let clear = fract((square.x + square.y) * 0.5) > 0.25;
        return vec4(1.0, 1.0, 1.0, if clear { 0.0 } else { 1.0 });
    }
}

node package: graph "../../../packages/raster.orlapkg/graphs/cutout.osn" {
    vertices <- project.result;
    triangles <- subdivided.triangles;
    mask <- mask.result;
    cutout = cutout;
    width = 320;
    height = 240;
}
node native: native.rasterize@2 {
    vertices <- project.result;
    triangles <- subdivided.triangles;
    mask <- mask.result;
    cutout = cutout;
    domain = vec2(320, 240);
}
node whole: graph "../../../packages/raster.orlapkg/graphs/raster.osn" {
    vertices <- project.result;
    triangles <- subdivided.triangles;
    width = 320;
    height = 240;
}

// How many pixels the two draw differently: a different triangle, or
// none where the other has one — which the device's rasterizer may do at
// an edge pixel, or at a texel of the mask it reads at another uv.
node differ: kernel {
    requires { field.read; field.write; }
    input cut: GBuffer <- package.surface;
    input fast: GBuffer <- native.surface;
    output result: Rows<Int>;
    compute { return if sample(cut).id != sample(fast).id { 1 } else { 0 }; }
    merge(a, b) { return a + b; }
}

// How many pixels the two place at different depths, to the bit: none on
// the interpreter and the JIT, where the fast path is the rule in Rust;
// on a device, whose depth is its own, nearly every one.
node deeper: kernel {
    requires { field.read; field.write; }
    input cut: GBuffer <- package.surface;
    input fast: GBuffer <- native.surface;
    output result: Rows<Int>;
    compute { return if bits(sample(cut).depth) != bits(sample(fast).depth) { 1 } else { 0 }; }
    merge(a, b) { return a + b; }
}

// How many pixels the mask took from the torus: drawn without it, not
// with it.
node taken: kernel {
    requires { field.read; field.write; }
    input cut: GBuffer <- package.surface;
    input all: GBuffer <- whole.surface;
    output result: Rows<Int>;
    compute {
        return if sample(all).id >= 0 && sample(cut).id < 0 { 1 } else { 0 };
    }
    merge(a, b) { return a + b; }
}

node view: mesh.shade@1 { surface <- package.surface; }

output result <- view.result;
