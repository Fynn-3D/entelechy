// Ten million triangles at 4K: the torus at `level = 6` (9.4 million)
// drawn by the render package at 3840 by 2160, the measure of the
// rasterizer's decision in `docs/DECISIONS.md`. No replay runs it: it is
// for `bench`, and the interpreter takes seconds a frame. Time 0 fixes
// the rotation.
use "../kernels/";

param level: Int = 6;

node torus: mesh.torus@1 { domain = 1152; }
node faces: mesh.torus_faces@1 { domain = 2304; }
node subdivided: graph "../level.esn" {
    times = level;
    carry mesh <- vertices;
    carry faces <- triangles;
    mesh <- torus.result;
    faces <- faces.result;
}
node project: mesh.project@1 { mesh <- subdivided.vertices; }
node raster: graph "../../../packages/raster.entpkg/graphs/surface.esn" {
    vertices <- project.result;
    triangles <- subdivided.triangles;
    width = 3840;
    height = 2160;
}
node view: mesh.shade@1 { surface <- raster.surface; }

output result <- view.result;
