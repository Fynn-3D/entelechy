// Ten million triangles at 4K: the torus at `level = 6` (9.4 million)
// drawn by the raster package at 3840 by 2160, the measure of the
// rasterizer's decision in `docs/DECISIONS.md`. No replay runs it: it is
// for `bench`, and the interpreter takes seconds a frame. Time 0 fixes
// the rotation.
use "../kernels/";

param level: Int = 6;

node torus: mesh.torus_points@1 { domain = 1152; }
node faces: mesh.lattice_faces@1 { columns = 48; rows = 24; wrap_columns = true; wrap_rows = true; domain = 2304; }
node subdivided: graph "../../../packages/mesh.entpkg/graphs/subdivision.esn" {
    times = level;
    carry points <- points;
    carry faces <- faces;
    points <- torus.result;
    faces <- faces.result;
}
node project: torus.project@1 { mesh <- subdivided.points; }
node raster: graph "../../../packages/raster.entpkg/graphs/surface.esn" {
    vertices <- project.result;
    triangles <- subdivided.faces;
    width = 3840;
    height = 2160;
}
node view: torus.shade@1 { surface <- raster.surface; }

output result <- view.result;
