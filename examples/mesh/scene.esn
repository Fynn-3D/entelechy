// torus + faces -> subdivide (level times) -> project -> rasterize (native) -> shade
use "kernels/";

param level: Int = 1;

node torus: mesh.torus_points@1 { domain = 1152; }   // 48 columns x 24 rows, wrapped both ways
node faces: mesh.lattice_faces@1 {                  // two faces a cell
    columns = 48;
    rows = 24;
    wrap_columns = true;
    wrap_rows = true;
    domain = 2304;
}

// Midpoint subdivision, `level` times: each time carries the rows on.
node subdivided: graph "../../packages/mesh.entpkg/graphs/subdivision.esn" {
    times = level;
    carry points <- points;
    carry faces <- faces;
    points <- torus.result;
    faces <- faces.result;
}

node project: torus.project@1 {
    mesh <- subdivided.points;
}

node raster: graph "../../packages/raster.entpkg/graphs/surface.esn" {
    vertices <- project.result;
    triangles <- subdivided.faces;
    width = 320;
    height = 240;
}

node view: torus.shade@1 {
    surface <- raster.surface;
}

output result <- view.result;
