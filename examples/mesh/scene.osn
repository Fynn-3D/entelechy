// torus + faces -> subdivide (level times) -> project -> rasterize (native) -> shade
use "kernels/";

param level: Int = 1;

node torus: mesh.torus@1 { domain = 1152; }        // 48 segments x 24 rings
node faces: mesh.torus_faces@1 { domain = 2304; }  // two triangles per cell

// Midpoint subdivision, `level` times: each time carries the rows on.
node subdivided: graph "level.osn" {
    times = level;
    carry mesh <- vertices;
    carry faces <- triangles;
    mesh <- torus.result;
    faces <- faces.result;
}

node project: mesh.project@1 {
    mesh <- subdivided.vertices;
}

node raster: graph "../../packages/raster.orlapkg/graphs/raster.osn" {
    vertices <- project.result;
    triangles <- subdivided.triangles;
    width = 320;
    height = 240;
}

node view: mesh.shade@1 {
    surface <- raster.surface;
}

output result <- view.result;
