// A torus as two rows: points and faces. The mesh package builds and
// subdivides it, a Kernel here projects it, the backend's native
// rasterizer turns it into a surface grid, and a Kernel shades that.
// Geometry never becomes pixels until the last step.
use "../../../packages/geometry.entpkg";
use "../../../packages/mesh.entpkg";
use "../../../packages/raster.entpkg";

type GBuffer = Grid<Surface>;

/// Rotate with time, look from `distance` down the z axis, and project
/// with a perspective whose depth spans [0, 1] from `near` to `far`.
kernel torus.project@1 {
    requires { field.read; field.write; time.read; }
    input mesh: Rows<MeshPoint>;
    param aspect: Float = 1.3333;
    param distance: Float = 3.2;
    param tilt: Float = 0.55;
    param spin: Float = 0.6;
    output result: Rows<Corner>;

    fn rotate_y(p: Vec3, a: Float) -> Vec3 {
        return vec3(p.x * cos(a) + p.z * sin(a), p.y, p.z * cos(a) - p.x * sin(a));
    }

    fn rotate_x(p: Vec3, a: Float) -> Vec3 {
        return vec3(p.x, p.y * cos(a) - p.z * sin(a), p.y * sin(a) + p.z * cos(a));
    }

    compute {
        let v = sample(mesh);
        let angle = time() * spin;
        let p = rotate_x(rotate_y(v.position, angle), tilt);
        let n = rotate_x(rotate_y(v.normal, angle), tilt);
        let clip = clip_point(perspective_focal(2.1445, aspect, 0.1, 10.0), p - vec3(0.0, 0.0, distance));
        return Corner { clip: clip, normal: n, uv: v.uv };
    }
}

/// Lambert plus a highlight over a checker from the uv; the background
/// where no triangle landed.
kernel torus.shade@1 {
    requires { field.read; field.write; }
    input surface: GBuffer;
    param light: Vec3 = vec3(0.4, 0.8, 0.5);
    output result: Image;

    compute {
        let s = sample(surface);
        let uv = coord() / domain();
        let sky = mix(vec3(0.12, 0.13, 0.18), vec3(0.05, 0.05, 0.08), uv.y);
        let n = normalize(s.normal);
        let l = normalize(light);
        let diffuse = max(dot(n, l), 0.0);
        let h = normalize(l + vec3(0.0, 0.0, 1.0));
        let glint = pow(max(dot(n, h), 0.0), 40.0) * 0.5;
        let check = (fract(s.uv.x * 12.0) < 0.5) != (fract(s.uv.y * 6.0) < 0.5);
        let base = if check { vec3(0.9, 0.55, 0.25) } else { vec3(0.25, 0.6, 0.85) };
        let lit = base * (0.12 + 0.88 * diffuse) + glint;
        let color = if s.id < 0 { sky } else { lit };
        return vec4(color, 1.0);
    }
}
