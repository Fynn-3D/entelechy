// The jukebox: a song of the music package, a mood in a style from a seed.
// Up and Down the mood, Left and Right the style, R another seed (a new
// theme), S the same seed again from its start, A the score's tour (every
// mood in turn, forty seconds each, a short tune to its end); each change
// fades the song before it out.
use "../../../packages/audio.entpkg";
use "../../../packages/music.entpkg";

struct Juke { mood: Int; style: Int; seed: Int; keys: Int; touring: Int; track: Track; }
type Jukes = Rows<Juke>;

kernel juke.start@1 {
    requires { field.write; }
    param mood: Int = 0;
    param style: Int = 0;
    param seed: Int = 1;
    output result: Jukes;
    compute {
        return Juke { mood: mood, style: style, seed: seed, keys: 0, touring: 0,
            track: Track { mood: mood, style: style, seed: seed, start: -1, was_mood: -1, was_style: 0, was_seed: 0, was_start: 0 } };
    }
}

kernel juke.step@1 {
    requires { field.read; field.write; input.read; time.read; }
    input previous: Jukes;
    input clock: Clocks;
    input moods: Moods;
    input bands: Bands;
    output result: Jukes;
    compute {
        let w = sample(previous);
        let codes = [38, 40, 37, 39, 82, 83, 65];
        let keys = loop 7 with b = 0 { if key(codes[index()]) { b | (1 << index()) } else { b } };
        let e = keys & (-1 ^ w.keys);
        let nm = count(moods);
        let ns = count(bands);
        let now = at(clock, 0).n;
        let touring = if (e & 64) != 0 { 1 - w.touring } else { w.touring };
        let here = at(moods, w.mood);
        let lasts = if here.jingle > 0 { jingle_length(here) + 1.0 } else { 40.0 };
        let next = touring == 1 && float(now - w.track.start) / hz() > lasts;
        let mood = if (e & 1) != 0 { (w.mood + nm - 1) % nm } else if (e & 2) != 0 || next { (w.mood + 1) % nm } else { w.mood };
        let style = if (e & 4) != 0 { (w.style + ns - 1) % ns } else if (e & 8) != 0 { (w.style + 1) % ns } else { w.style };
        let seed = if (e & 16) != 0 { w.seed + 1 } else { w.seed };
        let changed = mood != w.mood || style != w.style || seed != w.seed || (e & 32) != 0;
        // A track that has not begun begins now.
        let t = if w.track.start < 0 { Track { ..w.track, start: now } } else { w.track };
        let track = if changed { Track { mood: mood, style: style, seed: seed, start: now, was_mood: t.mood, was_style: t.style, was_seed: t.seed, was_start: t.start } } else { t };
        return Juke { mood: mood, style: style, seed: seed, keys: keys, touring: touring, track: track };
    }
}

kernel juke.track@1 {
    requires { field.read; field.write; }
    input juke: Jukes;
    output result: Tracks;
    compute { return at(juke, 0).track; }
}

/// Line `k` of `text`: its byte `j`, a space past its end.
fn juke_byte(text: Rows<Int>, k: Int, j: Int) -> Int {
    let n = count(text);
    let s = loop n with r = ivec3(0, 0, -1) {
        if r.z >= 0 { r } else {
            let c = at(text, index());
            if c == 10 { if r.y == k { ivec3(r.x, r.y, index()) } else { ivec3(index() + 1, r.y + 1, -1) } } else { r }
        }
    };
    let end = if s.z >= 0 { s.z } else { n };
    return if j >= 0 && s.x + j < end { at(text, s.x + j) } else { 32 };
}

/// The jukebox's words: the mood, the style, the seed, the help.
kernel juke.words@1 {
    requires { field.read; field.write; }
    input juke: Jukes;
    input names: Rows<Int>;
    input moods: Moods;
    input help: Rows<Int>;
    output result: Rows<Int>;
    compute {
        let w = at(juke, 0);
        let i = element();
        let line = i / 48;
        let j = i % 48;
        if line == 0 { return if j < 8 { juke_byte(names, w.mood, j) } else if j >= 10 && j < 22 { juke_byte(names, count(moods) + w.style, j - 10) } else if j >= 24 && j < 28 { [115, 101, 101, 100][j - 24] } else if j >= 29 && j < 33 { 48 + (w.seed / [1000, 100, 10, 1][j - 29]) % 10 } else { 32 }; }
        return juke_byte(help, line - 1, j);
    }
}
