// An arm from Blender, posed by its own skeleton.
//
//   blender -b --python bridges/blender/make_rig.py -- --out examples/animation/parts/blend/source/arm.glb
//   entelechy import examples/animation/parts/blend/source/arm.glb --out examples/animation/parts/blend/assets
//
// wrote the five rows this reads: the mesh and its triangles, what each
// vertex is bound to, the joints, and one clip per action. The Host
// watches them, so re-importing changes the running window.
//
// The rows are read here and handed to `arm.esn`, the graph, which a
// scene places as well.
input mesh: Rows<Point> = "assets/arm.vertices.field";
input faces: Triangles = "assets/arm.triangles.field";
input weights: Rows<Bound> = "assets/arm.weights.field";
input skeleton: Skeleton = "assets/arm.skeleton.field";
input swing: Clip = "assets/arm.swing.clip.field";
input curl: Clip = "assets/arm.curl.clip.field";

node arm: graph "arm.esn" { mesh <- mesh; faces <- faces; weights <- weights; skeleton <- skeleton; swing <- swing; curl <- curl; }

output result <- arm.result;
