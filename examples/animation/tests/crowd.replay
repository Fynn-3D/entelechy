scene ../parts/crowd/scene.esn
window 240 135
param instances 16
param across 4

# Sixteen arms out of one mesh: the rows are that mesh sixteen times
# over and the palette is sixteen skeletons, each at its own moment in
# the clip — the second one's upper joint is most of the way through a
# swing while the first one's has barely left rest.
frame 0.4
expect count posed.result = 27744
expect count triangles.result = 49152
expect count palette.result = 32
expect palette.result[1] = 1 0 0 0  0 0.99999 0.00490 0  0 -0.00490 0.99999 0  0 -0.00599 0 1 0.0005
expect palette.result[11] = 1 0 0 0  0 0.93865 0.34489 0  0 -0.34489 0.93865 0  0 -0.42305 -0.05830 1 0.0005
expect 109 60 = 0.883 0.693 0.437 0.02
expect 80 75 = 0.387 0.422 0.422 0.02
expect 98 118 = 0.039 0.050 0.084 0.02

# The mask is a weight a joint. With none of the second clip in the
# joint above the root, every arm poses from the first clip alone: the
# joints turn differently and so does the picture.
reset
param upper 0.0
frame 0.4
expect palette.result[11] = 1 0 0 0  0 0.97257 0.23259 0  0 -0.23259 0.97257 0  0 -0.31076 -0.02437 1 0.0005
expect 80 75 = 0.492 0.537 0.536 0.02
expect 98 118 = 0.183 0.208 0.216 0.02

# The additive layer: the second clip laid over the pose rather than
# blended into it, measured from its own first frame. At none of it the
# pose is what the blend left, which the checks above are; at all of it
# every joint carries the difference as well.
reset
param lean 1.0
frame 0.4
expect palette.result[11] = 1 0 0 0  0 0.96525 0.26134 0  0 -0.26134 0.96525 0  0 -0.33237 -0.03223 1 0.0005
expect 80 75 = 0.061 0.076 0.119 0.02
