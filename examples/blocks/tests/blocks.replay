scene ../scene.esn

# Seed 7 deals an I piece first: at time zero it lies across row 1 at
# columns 3 to 6 of the well; the bottom row is prefilled but for its
# last cell, for the clearing below. Cells are 12 pixels, centers at
# 12x + 6.
param prefill 1
frame 0.0
expect step.result[0].piece = 0
expect step.result[0].at = 3 0
expect 54 18 = 0.3 0.8 0.9 0.03           # cell (4, 1): the I
expect 6 6 = 0.08 0.09 0.12 0.03          # cell (0, 0): empty
expect 6 234 = 0.45 0.45 0.5 0.03         # cell (0, 19): prefilled

# The second tick moves it down a row.
frame 0.6
expect step.result[0].at = 3 1
expect 54 30 = 0.3 0.8 0.9 0.03
expect 54 18 = 0.08 0.09 0.12 0.03

# Up turns it upright: column 2 of its box, rows 1 to 4.
key 38 down
frame 0.7
key 38 up
frame 0.75
expect step.result[0].rot = 1
expect 66 42 = 0.3 0.8 0.9 0.03           # cell (5, 3)
expect 54 30 = 0.08 0.09 0.12 0.03

# Four presses of right take the box to x = 7, the piece to column 9;
# the tick at 1.0 drops it a row on the way.
key 39 down
frame 0.8
key 39 up
frame 0.85
key 39 down
frame 0.9
key 39 up
frame 0.95
key 39 down
frame 1.0
key 39 up
frame 1.05
key 39 down
frame 1.1
key 39 up
frame 1.15
expect step.result[0].at = 7 2

# Space drops it to the floor: it fills the gap in the bottom row, the
# row clears, its three cells above fall one row, and the next piece
# spawns.
key 32 down
frame 1.2
key 32 up
expect step.result[0].lines = 1
expect step.result[0].score = 100
expect step.result[0].at = 3 0
expect board.result[199] = 1
expect board.result[190] = 0
expect board.result[189] = 1
expect board.result[169] = 0
expect 114 234 = 0.3 0.8 0.9 0.03         # cell (9, 19): the I's color
expect 6 234 = 0.08 0.09 0.12 0.03        # cell (0, 19): cleared
