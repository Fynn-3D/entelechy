scene model.esn

# At time 0 the crate stands tilted toward the camera, turned a little by
# its node in the file: the top shows planks lit from above, the front is
# darker; the corners show the sky. Both rasterizers agree inside faces.
frame 0.0
expect 10 10 = 0.12 0.13 0.18 0.02
expect 160 70 = 0.563 0.398 0.232 0.03     # the lit top, planks
expect 160 160 = 0.141 0.1 0.058 0.03     # the front, in shade
expect 120 120 = 0.095 0.06 0.029 0.03    # the dark rim of a plank
expect project.result[0].uv = 0 1
expect project.result[2].uv = 1 0
