// Text as rows, drawn by a Kernel, with no primitive: a label is a
// Rows<Glyph>, each element a character code, the pixel where its cell's
// top-left corner lies, and its scale; `text.draw` paints such rows over
// a picture through a font atlas the Host reads from a file, `text.layout`
// makes them from a row of codes, and `text.digits` turns a number into
// codes. The atlas is `font.png`, baked from `font.orla`: cells of 6 by 8
// texels, sixteen per row, the printable ASCII codes 32 to 126 in order;
// any other code draws a `?`. A glyph at scale s covers 6s by 8s pixels.
struct Glyph { code: Int; origin: Vec2; scale: Float; }
type Text = Rows<Glyph>;
type Codes = Rows<Int>;
type Atlas = Grid<Float>;
struct Ink { next: Int; cover: Float; }

// How much of the text covers the pixel whose centre is `px`: the atlas
// texel under it, nearest, for the glyphs whose cell holds it, at most
// 256 glyphs in one row. Exact on both backends at whole scales.
fn ink(glyphs: Text, font: Atlas, px: Vec2) -> Float {
    let n = count(glyphs);
    let end = loop 256 with k = Ink { next: 0, cover: 0.0 } until k.next >= n || k.cover > 0.5 {
        let g = at(glyphs, k.next);
        let code = if g.code < 32 || g.code > 126 { 63 } else { g.code };
        let cell = code - 32;
        let local = (px - g.origin) / g.scale;
        let inside = local.x >= 0.0 && local.x < 6.0 && local.y >= 0.0 && local.y < 8.0;
        let texel = vec2(float(cell % 16) * 6.0 + floor(local.x), float(cell / 16) * 8.0 + floor(local.y));
        let hit = if inside { at(font, texel) } else { 0.0 };
        Ink { next: k.next + 1, cover: max(k.cover, hit) }
    };
    return end.cover;
}

// Codes laid out from `origin`, `advance` texels apart at `scale`; with
// `wrap` above zero, that many per line, lines 8 texels apart.
kernel text.layout@1 {
    requires { field.read; field.write; }
    input codes: Codes;
    param origin: Vec2 = vec2(0.0, 0.0);
    param scale: Float = 1.0;
    param advance: Float = 6.0;
    param wrap: Int = 0;
    output result: Text;
    compute {
        let i = element();
        let column = if wrap > 0 { i % wrap } else { i };
        let line = if wrap > 0 { i / wrap } else { 0 };
        let at = origin + vec2(float(column) * advance, float(line) * 8.0) * scale;
        return Glyph { code: sample(codes), origin: at, scale: scale };
    }
}

// The first value's magnitude, rounded, as `places` digit codes, most
// significant first, leading zeros blank; a node sets `domain = places;`.
kernel text.digits@1 {
    requires { field.read; field.write; }
    input values: Rows<Float>;
    param places: Int = 3;
    output result: Codes;
    struct Power { k: Int; p: Int; }
    compute {
        let i = element();
        let v = int(round(abs(at(values, 0))));
        let want = places - 1 - i;
        let unit = loop 9 with q = Power { k: 0, p: 1 } until q.k >= want { Power { k: q.k + 1, p: q.p * 10 } };
        let lead = v / unit.p;
        return if lead == 0 && i < places - 1 { 32 } else { 48 + lead % 10 };
    }
}

// The glyphs painted over `under` in `colour`.
kernel text.draw@1 {
    requires { field.read; field.write; }
    input under: Image;
    input glyphs: Text;
    input font: Atlas;
    param colour: Vec3 = vec3(1.0, 1.0, 1.0);
    output result: Image;
    compute {
        let c = sample(under);
        let a = ink(glyphs, font, coord() + vec2(0.5, 0.5));
        return mix(c, vec4(colour.x, colour.y, colour.z, c.a), a);
    }
}
