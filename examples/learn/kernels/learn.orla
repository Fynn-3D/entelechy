// A network that learns: a 2-16-1 perceptron trained by gradient descent,
// all of it Kernels. The weights are a Field of 65 floats carried frame
// to frame through `<~`; a step is one scatter (every point adds its
// gradient of every weight into a sum) and one map (the update). The
// picture is the network's answer over the plane, the points drawn on it.

struct Point { position: Vec2; label: Float; }
struct Loss { sum: Float; count: Int; }

// Weights, laid out: hidden unit j has its two weights and bias at
// 3j, 3j + 1, 3j + 2 (48 of them); the output's weight on unit j is at
// 48 + j and its bias at 64.
fn hidden(w: Rows<Float>, p: Vec2, j: Int) -> Float {
    return tanh(at(w, 3 * j) * p.x + at(w, 3 * j + 1) * p.y + at(w, 3 * j + 2));
}

fn logit(w: Rows<Float>, p: Vec2) -> Float {
    return loop 16 with s = at(w, 64) { s + at(w, 48 + index()) * hidden(w, p, index()) };
}

fn sigmoid(s: Float) -> Float { return 1.0 / (1.0 + exp(-s)); }

fn hash(n: Float) -> Float {
    let q = fract(n * 0.1031);
    let r = q * (q + 33.33);
    return fract((r + r) * q);
}

// The training set: points on the plane, labelled by a circle they are
// in or out of, which no line separates.
kernel learn.points@1 {
    requires { field.write; }
    output result: Rows<Point>;
    compute {
        let i = float(element());
        let p = vec2(hash(i + 0.5), hash(i + 17.25)) * 2.0 - vec2(1.0, 1.0);
        let inside = length(p - vec2(0.1, 0.05)) < 0.55;
        return Point { position: p, label: if inside { 1.0 } else { 0.0 } };
    }
}

// Small random weights to start from.
kernel learn.init@1 {
    requires { field.write; }
    output result: Rows<Float>;
    compute { return hash(float(element()) + 3.75) - 0.5; }
}

// Nothing, the size of the weights: what the gradients are summed into.
kernel learn.zeros@1 {
    requires { field.write; }
    output result: Rows<Float>;
    compute { return 0.0; }
}

// The gradient of the loss over every point, summed weight by weight:
// element e is weight e % 65 of point e / 65 (the node's domain is the
// product), so the sum needs no array and every element is one forward
// pass and one term of the chain rule.
kernel learn.grads@1 {
    requires { field.read; field.write; }
    input points: Rows<Point>;
    input weights: Rows<Float>;
    input zeros: Rows<Float>;
    output result: Rows<Float>;
    struct Term { at: Int; value: Float; }
    scatter into zeros with sum {
        let e = element();
        let k = e % 65;
        let point = at(points, e / 65);
        let p = point.position;
        let d = sigmoid(logit(weights, p)) - point.label;   // dL/ds for the log loss
        let value = if k == 64 {
            d
        } else if k >= 48 {
            d * hidden(weights, p, k - 48)
        } else {
            let j = k / 3;
            let h = hidden(weights, p, j);
            let through = d * at(weights, 48 + j) * (1.0 - h * h);
            let i = k % 3;
            through * (if i == 0 { p.x } else if i == 1 { p.y } else { 1.0 })
        };
        return Term { at: k, value: value };
    }
}

// One step down the mean gradient.
kernel learn.step@1 {
    requires { field.read; field.write; }
    input weights: Rows<Float>;
    input grads: Rows<Float>;
    param rate: Float = 2.0;
    param count: Float = 256.0;
    output result: Rows<Float>;
    compute { return sample(weights) - rate * at(grads, element()) / count; }
}

// The mean log loss over the points.
kernel learn.loss@1 {
    requires { field.read; field.write; }
    input points: Rows<Point>;
    input weights: Rows<Float>;
    output result: Loss;           // a reduction's output, written as its element
    compute {
        let point = sample(points);
        let o = clamp(sigmoid(logit(weights, point.position)), 0.0001, 0.9999);
        let l = -(point.label * log(o) + (1.0 - point.label) * log(1.0 - o));
        return Loss { sum: l, count: 1 };
    }
    merge(a, b) { return Loss { sum: a.sum + b.sum, count: a.count + b.count }; }
}

// The plane as the network sees it: warm where it answers one, cool
// where it answers zero, and the circle it is learning drawn faintly.
kernel learn.view@1 {
    requires { field.read; field.write; }
    input weights: Rows<Float>;
    output result: Image;
    compute {
        let uv = (coord() + vec2(0.5, 0.5)) / domain();
        let p = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
        let o = sigmoid(logit(weights, p));
        let colour = mix(vec3(0.15, 0.25, 0.55), vec3(0.95, 0.6, 0.2), o);
        let ring = abs(length(p - vec2(0.1, 0.05)) - 0.55) < 0.008;
        let shown = if ring { colour * 0.5 } else { colour };
        return vec4(shown.x, shown.y, shown.z, 1.0);
    }
}

// The points, a dot each in its label's colour, over the picture.
kernel learn.dots@1 {
    requires { field.read; field.write; }
    input points: Rows<Point>;
    input picture: Image;
    output result: Image;
    struct Dot { cell: Vec2; colour: Vec4; }
    scatter into picture with last {
        let point = sample(points);
        let uv = vec2(point.position.x + 1.0, 1.0 - point.position.y) * 0.5;
        let colour = if point.label > 0.5 { vec4(1.0, 0.9, 0.7, 1.0) } else { vec4(0.6, 0.75, 1.0, 1.0) };
        return Dot { cell: floor(uv * size(picture)), colour: colour };
    }
}
