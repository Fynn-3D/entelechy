// A tally: one row of state that counts the evaluations. What it carries
// is about to change while it runs: see ../agent.jsonl.
struct Tally { count: Int; }

kernel tally.zero@1 {
    requires { field.write; }
    output result: Rows<Tally>;
    compute { return Tally { count: 0 }; }
}

kernel tally.step@1 {
    requires { field.read; field.write; }
    input previous: Rows<Tally>;
    output result: Rows<Tally>;
    compute {
        let t = sample(previous);
        return Tally { count: t.count + 1 };
    }
}
