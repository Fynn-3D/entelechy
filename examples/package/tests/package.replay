scene ../scene.osn

# Eight-pixel cells, each one of the scene's four colours by its Oklab
# lightness: two pixels of one cell agree; the disc, brightest, takes the
# lightest colour; the background's left edge, nearly black, the darkest;
# the dim blue beside it the second; the far side of the background,
# brighter, the third.
frame 0.0
expect 80 60 = 1.0 0.95 0.7 0.02
expect 87 60 = 1.0 0.95 0.7 0.02
expect 2 60 = 0.06 0.05 0.12 0.02
expect 10 10 = 0.55 0.2 0.4 0.02
expect 150 110 = 0.92 0.5 0.2 0.02
