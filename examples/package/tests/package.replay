scene ../scene.osn

# Eight-pixel cells, each one of four colours: two pixels of one cell
# agree, the next cell down is brighter at the disc's edge, the corner
# is the darkest shade.
frame 0.0
expect 80 60 = 0.549 0.2 0.4 0.02
expect 87 60 = 0.549 0.2 0.4 0.02
expect 87 67 = 0.922 0.502 0.2 0.02
expect 10 10 = 0.059 0.051 0.122 0.02
expect 150 110 = 0.549 0.2 0.4 0.02
