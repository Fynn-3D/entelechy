// A picture through a package's preset: `use` of the package brings its
// Kernels (its manifest's versions checked), and its `nes` graph is
// placed as a node by path.
use "../../packages/image.entpkg";

param cell: Float = 8.0;

node picture: kernel {
    requires { field.write; }
    output result: Image;
    domain = vec2(160, 120);
    compute {
        let u = (coord() + 0.5) / domain();
        let disc = length(u - vec2(0.5, 0.5)) < 0.3;
        let color = if disc { vec3(0.9, 0.6, 0.2) * (0.5 + 0.5 * u.y) } else { vec3(0.2, 0.3, 0.6) * u.x };
        return vec4(color, 1.0);
    }
}

// Four colors from dark to light, as an old console's palette.
node colors: kernel {
    requires { field.write; }
    output result: Rows<Vec3>;
    domain = 4;
    compute {
        return match element() { 0 => vec3(0.06, 0.05, 0.12), 1 => vec3(0.55, 0.2, 0.4), 2 => vec3(0.92, 0.5, 0.2), _ => vec3(1.0, 0.95, 0.7) };
    }
}

node nes: graph "../../packages/image.entpkg/graphs/nes.esn" {
    source <- picture.result;
    colors <- colors.result;
    cell = cell;
}

output result <- nes.result;
