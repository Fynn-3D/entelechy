scene ../scene.osn

# A 320 by 200 window over a 32 by 20 grid, ten pixels a cell. Eight
# cells settle a frame and the count is exactly that: with sixteen
# tiles a neighbour rarely forces the last choice, so what spreading
# does is rule tiles out, not finish cells. Once the grid is decided a
# spot of it forgets a few times a second and grows back, which is why
# the count dips; holding the pointer down melts what is under it.
window 320 200 1
frame 0.0
expect tally.result[0] = 8.0 0.0
frame 0.0167
frame 0.0333
frame 0.05
frame 0.0667
frame 0.0833
frame 0.1
frame 0.1167
frame 0.1333
frame 0.15
frame 0.1667
frame 0.1833
frame 0.2
frame 0.2167
frame 0.2333
frame 0.25
frame 0.2667
frame 0.2833
frame 0.3
frame 0.3167
frame 0.3333
frame 0.35
frame 0.3667
frame 0.3833
frame 0.4
frame 0.4167
frame 0.4333
frame 0.45
frame 0.4667
frame 0.4833
frame 0.5
frame 0.5167
frame 0.5333
frame 0.55
frame 0.5667
frame 0.5833
frame 0.6
frame 0.6167
frame 0.6333
frame 0.65
frame 0.6667
frame 0.6833
frame 0.7
frame 0.7167
frame 0.7333
