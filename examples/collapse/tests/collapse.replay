frame 1.3
expect tally.result[0] = 632.0 0.0   # nearly all of it decided
frame 1.3167
expect tally.result[0] = 595.0 0.0   # a spot forgot
frame 1.3333
frame 1.35
frame 1.3667
frame 1.3833
frame 1.4
frame 1.4167
frame 1.4333
frame 1.45
frame 1.4667
frame 1.4833
frame 1.5
expect tally.result[0] = 640.0 0.0   # every cell decided

# The pointer melts the cells under it, and the collapse grows back
# through the hole.
pointer 160 100 down
frame 1.5167
expect tally.result[0] = 590.0 0.0
pointer up
frame 1.5333
frame 1.55
expect tally.result[0] = 606.0 0.0
frame 1.5667
frame 1.5833
frame 1.6
expect tally.result[0] = 630.0 0.0
