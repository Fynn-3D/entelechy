// A grid that decides what it is: eight steps a frame, the grid carried
// from frame to frame, and the picture of wherever it has got to. Hold
// the pointer down and the cells under it forget, and the collapse
// grows back through the hole.
use "kernels/";
use "../shared/text.orla";

input caption: Rows<Int> = text "settled";

param melt: Float = 2.5;

node start: collapse.start@1 { domain = vec2(32, 20); }
node steps: graph "step.osn" {
    times = 8;
    carry cells <- result;
    cells <~ steps.result from start.result;
    melt = melt;
}
node tally: collapse.tally@1 { cells <- steps.result; }
node view: collapse.view@1 { cells <- steps.result; domain = window(); }
node label: text.label@1 { caption <- caption; values <- tally.result; index = 0; places = 4; domain = size(caption) + 6; }
node glyphs: text.layout@1 { codes <- label.result; origin = vec2(12.0, 12.0); scale = 2.0; }
node shown: text.draw@1 { under <- view.result; glyphs <- glyphs.result; font <- font; }

input font: Grid<Float> = "../shared/font.png";

output result <- shown.result;
output settled <- tally.result;
output grid <- steps.result;
