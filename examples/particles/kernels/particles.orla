// A particle system: a Field of Particle structs advanced every frame,
// splatted onto a canvas by a scatter, and drawn from the canvas. The
// Field never becomes an image until `draw`, and no pixel ever walks the
// particles: each particle writes its own cell.

struct Particle { position: Vec2; velocity: Vec2; age: Float; }
type Canvas = Grid<Vec3>;

kernel particles.seed@1 {
    requires { field.write; }
    param spread: Float = 0.6;
    output result: Rows<Particle>;

    fn hash(n: Float) -> Float {
        // Sin-free so the CPU and GPU agree on every particle.
        let q = fract(n * 0.1031);
        let r = q + q * (q + 33.33);
        return fract(r * r * 2.0);
    }

    compute {
        let i = float(element());
        let angle = hash(i) * 6.2831853;
        let speed = 0.15 + hash(i + 7.0) * spread;
        return Particle {
            position: vec2(0.5, 0.5),
            velocity: vec2(cos(angle), sin(angle)) * speed,
            age: hash(i + 13.0) * 4.0,
        };
    }
}

kernel particles.step@1 {
    requires { field.read; field.write; time.read; input.read; }
    input previous: Rows<Particle>;
    param gravity: Float = 0.4;
    param dt: Float = 0.016;
    param pull: Float = 1.2;
    output result: Rows<Particle>;

    fn respawn(p: Particle, seed: Float) -> Particle {
        let q = fract(seed * 0.1031);
        let r = q + q * (q + 33.33);
        let angle = fract(r * r * 2.0) * 6.2831853;
        return Particle {
            position: vec2(0.5, 0.5),
            velocity: vec2(cos(angle), sin(angle)) * 0.4,
            age: 0.0,
        };
    }

    compute {
        let p = sample(previous);
        // Pointer position in the unit square attracts particles while held.
        let target = pointer() / vec2(320.0, 240.0);
        let toward = target - p.position;
        let attract = if pointer_down() { toward * pull } else { vec2(0.0, 0.0) };
        let pushed = p.velocity + (vec2(0.0, gravity) + attract) * dt;
        let moved = p.position + pushed * dt;
        // Bounce off the floor and the walls.
        let floored = if moved.y > 1.0 { vec2(pushed.x * 0.9, -pushed.y * 0.8) } else { pushed };
        let walled = if moved.x < 0.0 || moved.x > 1.0 { vec2(-floored.x, floored.y) } else { floored };
        let inside = clamp(moved, vec2(0.0, 0.0), vec2(1.0, 1.0));
        let next = Particle { position: inside, velocity: walled, age: p.age + dt };
        return if next.age > 6.0 { respawn(next, float(element()) + time()) } else { next };
    }
}

/// An empty canvas, the size of the picture.
kernel particles.clear@1 {
    requires { field.write; }
    output result: Canvas;
    compute { return vec3(0.0, 0.0, 0.0); }
}

/// Last frame's canvas dimmed, so the particles leave trails; `fade` at
/// zero forgets the past entirely.
kernel particles.fade@1 {
    requires { field.read; field.write; }
    input previous: Canvas;
    param fade: Float = 0.85;
    output result: Canvas;
    compute { return sample(previous) * fade; }
}

/// Every particle adds its tint to the cell under it. A scatter maps over
/// the particles and combines each value into the canvas at its address,
/// in element order, so the cost is one write per particle however many
/// pixels there are; a particle on the far edge falls outside and is
/// dropped rather than clamped.
kernel particles.splat@1 {
    requires { field.read; field.write; }
    input particles: Rows<Particle>;
    input canvas: Canvas;
    output result: Canvas;
    struct Splat { cell: Vec2; heat: Vec3; }
    scatter into canvas with sum {
        let p = sample(particles);
        let tint = mix(vec3(1.0, 0.85, 0.3), vec3(0.3, 0.5, 1.0), clamp(p.age / 6.0, 0.0, 1.0));
        return Splat { cell: floor(p.position * size(canvas)), heat: tint };
    }
}

/// The picture: each pixel gathers the heat of the cells within `radius`,
/// a fixed window whatever the number of particles.
kernel particles.draw@1 {
    requires { field.read; field.write; }
    input canvas: Canvas;
    param radius: Float = 3.0;
    output result: Image;

    compute {
        let px = coord();
        let extent = domain();
        let glow = loop 49 with acc = vec3(0.0, 0.0, 0.0) {
            let k = index();
            let offset = vec2(float(k % 7) - 3.0, float(k / 7) - 3.0);
            let q = px + offset;
            let inside = q.x >= 0.0 && q.x < extent.x && q.y >= 0.0 && q.y < extent.y;
            let w = clamp(1.0 - length(offset) / radius, 0.0, 1.0);
            if inside { acc + at(canvas, q) * (w * w) } else { acc }
        };
        let background = vec3(0.05, 0.06, 0.1);
        let color = background + glow;
        return vec4(color.x, color.y, color.z, 1.0);
    }
}
