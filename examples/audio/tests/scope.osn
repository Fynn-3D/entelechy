// The scene as it is; the replay checks the scope, which the sound
// follows exactly.
use "../kernels/";

node silence: audio.silence@1 { domain = 800; }
node voice: audio.voice@1 { previous <~ voice.result from silence.result; }
node filter: audio.filter@1 { voice <- voice.result; previous <~ filter.result from silence.result; }
node mix: audio.mix@1 { voice <- filter.result; }
node scope: audio.scope@1 { block <- mix.result; domain = vec2(320, 240); }

output view <- scope.result;
output sound <- mix.result;
