scene scope.osn

# 220 Hz at 48 kHz over 800 frames is 3.67 cycles per block, low-passed
# by the scan filter (cutoff 0.25 per sample lags the wave a little).
# Column 22 sits near the first peak, column 44 back at the axis, and the
# corners show the background.
frame 0.0
expect 5 5 = 0.05 0.06 0.09 0.02
expect 22 83 = 0.4 1.0 0.6 0.05
expect 22 120 = 0.2 0.25 0.3 0.05
expect 44 120 = 0.4 1.0 0.6 0.05

# The next block continues both the oscillator's phase and the filter's
# memory from the previous block's last frame: its first sample is well
# below the axis, where a restarted filter would sit near it.
frame 0.0167
expect 0 140 = 0.4 1.0 0.6 0.05
expect 0 118 = 0.05 0.06 0.09 0.05
expect voice.result[0].phase = 0.6713 0.001    # 0.6667 carried over plus one step at 220 Hz
expect mix.result[0] = -0.1124 -0.1124 0.001   # the filtered stereo frame itself
