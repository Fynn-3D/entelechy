/// The picture an agent works on: a warm gradient with a cool disc, every
/// pixel different from its neighbours so an effect on it can be measured.
kernel picture.draw@1 {
    requires { field.write; }
    output result: Image;
    compute {
        let c = coord() + 0.5;
        let n = domain();
        let u = c / n;
        let disc = length(c - n * 0.5) < n.y * 0.3;
        let color = if disc { vec3(0.2, 0.45, 0.8) * (0.7 + 0.3 * u.y) }
            else { vec3(0.9, 0.55, 0.25) * (0.5 + 0.5 * u.x) };
        return vec4(color, 1.0);
    }
}
