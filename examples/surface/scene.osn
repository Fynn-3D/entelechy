// A blob meshed out of a volume every frame: two million cells, of
// which the surface touches about twenty thousand, and only those are
// ever a Field.
//
// `surface.flags` writes one flag a cell, the compact package ranks
// them — a prefix sum over every cell in the volume — and the geometry
// nodes are sized by the count it gives back.
use "kernels/";

param size: Int = 128;        // cells across the volume: size^3 of them
param radius: Int = 20;       // a ball's radius, in hundredths of the side
param iso: Int = 45;          // the surface's threshold, in hundredths of r^2
param rate: Float = 20.0;     // steps a second the balls move at
// `--param compaction=false` flags every cell instead of the ones the
// surface passes through: the same picture, a hundred times the
// geometry, which is what the replay checks.
param compaction: Bool = true;

node start: surface.start@1 { domain = 1; }
node camera: surface.orbit@1 {
    previous <~ camera.result from start.result;
    domain = 1;
}

node field: surface.field@1 {
    radius = radius;
    iso = iso;
    rate = rate;
    domain = vec3(size + 1, size + 1, size + 1);
}

node flags: surface.flags@1 {
    field <- field.result;
    compaction = compaction;
    domain = size * size * size;
}

node kept: graph "../../packages/compact.orlapkg/graphs/compact.osn" {
    flags <- flags.result;
}

node corners: surface.corners@1 {
    kept <- kept.indices;
    field <- field.result;
    domain = max(value(count), 1) * 8;
    count <- kept.count;
}

node faces: surface.faces@1 {
    domain = max(value(count), 1) * 12;
    count <- kept.count;
}

node project: surface.project@1 {
    mesh <- corners.result;
    camera <- camera.result;
}

node raster: native.rasterize@1 {
    vertices <- project.result;
    triangles <- faces.result;
    domain = window();
}

node view: surface.shade@1 { surface <- raster.surface; }

output result <- view.result;
