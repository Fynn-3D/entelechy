// A surface meshed out of a volume, every frame, by the cells it passes
// through.
//
// The volume is `size` cells on a side — a couple of million of them at
// the default — and the blob's surface touches about one in a hundred.
// `surface.flags` writes one flag per cell, the math package turns
// those flags into the cells that are on the surface and how many there
// are, and the geometry nodes are `domain = max(value(count), 1) * <per
// cell>`. A cell the surface misses is not skipped: it is never placed.
//
// So this scene asks for a rank over every cell in the volume, which is
// what the frame is mostly spent on today: a prefix sum is ordered work
// and walks the row on one thread.
//
// The field is integer arithmetic — squared distances to three balls on
// integer paths — so every backend flags exactly the same cells and the
// replay pins the count with no tolerance at all.
struct Camera { angle: Float; height: Float; distance: Float; }
struct Point { position: Vec3; normal: Vec3; uv: Vec2; }
struct Vertex { clip: Vec4; normal: Vec3; uv: Vec2; }
struct Tri { a: Int; b: Int; c: Int; }
struct Surface { depth: Float; normal: Vec3; uv: Vec2; id: Int; }
type Field = Volume<Int>;

// A ball's coordinate at step `t`: a triangle wave between `low` and
// `high`, so it bounces inside the volume and never leaves it.
fn bounce(t: Int, low: Int, high: Int, speed: Int) -> Int {
    let span = max(high - low, 1);
    let period = 2 * span;
    let p = ((t * speed) % period + period) % period;
    return low + (if p < span { p } else { period - p });
}

fn near(c: IVec3, center: IVec3, radius: Int) -> Int {
    let d = c - center;
    return max(radius * radius - (d.x * d.x + d.y * d.y + d.z * d.z), 0);
}

// Three balls, each a quadratic falloff: `r^2 - d^2` where that is
// positive, which sums into a blob where two of them meet. Integers
// throughout, so what the field says is what every backend says.
fn blob(c: IVec3, t: Int, side: Int, radius: Int) -> Int {
    let low = radius;
    let high = side - radius;
    let a = ivec3(bounce(t, low, high, 1), bounce(t + 37, low, high, 2), bounce(t + 11, low, high, 1));
    let b = ivec3(bounce(t + 53, low, high, 2), bounce(t + 7, low, high, 1), bounce(t + 29, low, high, 3));
    let d = ivec3(bounce(t + 19, low, high, 3), bounce(t + 61, low, high, 2), bounce(t + 43, low, high, 1));
    return near(c, a, radius) + near(c, b, radius) + near(c, d, radius);
}

// The cell `i` of a volume whose corners are `corners` on a side.
fn cell_at(i: Int, corners: IVec3) -> IVec3 {
    let side = max(corners.x - 1, 1);
    let tall = max(corners.y - 1, 1);
    return ivec3(i % side, (i / side) % tall, i / (side * tall));
}

// A cell's corner `j`, 0 to 7, from its lowest: `j` is `x + 2y + 4z`.
fn corner_of(j: Int) -> IVec3 { return ivec3(j & 1, (j >> 1) & 1, j >> 2); }

// Whether the surface passes through the cell whose lowest corner is
// `c`: the eight corners are not all on one side of it. The field is
// written with its threshold already taken off, so the surface is where
// it changes sign and nothing downstream needs to know the threshold.
fn straddles(field: Field, c: IVec3) -> Bool {
    let v = [each 8 { at(field, c + corner_of(index())) }];
    let lo = min(min(min(v[0], v[1]), min(v[2], v[3])), min(min(v[4], v[5]), min(v[6], v[7])));
    let hi = max(max(max(v[0], v[1]), max(v[2], v[3])), max(max(v[4], v[5]), max(v[6], v[7])));
    return lo < 0 && hi >= 0;
}

/// The field itself, one value a corner.
kernel surface.field@1 {
    requires { field.write; time.read; }
    /// A ball's radius and the surface's threshold are both proportions,
    /// in hundredths — of the volume's side and of the radius squared —
    /// so the same blob is meshed at any `size`, which is what lets the
    /// replay run a small volume and the scene a couple of million cells.
    param radius: Int = 20;
    param iso: Int = 45;
    param rate: Float = 20.0;
    output result: Field;
    compute {
        let side = idomain().x - 1;
        let r = max(side * radius / 100, 2);
        return blob(icoord(), int(time() * rate), side, r) - r * r * iso / 100;
    }
}

/// One flag a cell: does the surface pass through it?
///
/// `--param compaction=false` flags every cell instead, so the graph
/// places a cube for all two million of them and the ones the surface
/// misses collapse to a point. The picture is the same; the geometry is
/// a hundred times as much.
kernel surface.flags@1 {
    requires { field.read; field.write; }
    input field: Field;
    param compaction: Bool = true;
    output result: Rows<Int>;
    compute {
        if !compaction { return 1; }
        return int(straddles(field, cell_at(element(), isize(field))));
    }
}

/// Eight corners a kept cell, at the cell's own place in the world, with
/// the field's gradient for a normal so the blob reads as a surface and
/// not as a heap of boxes. A cell the surface misses — which only
/// happens with the compaction turned off — puts all eight on one point,
/// and a triangle of no area is not drawn.
kernel surface.corners@1 {
    requires { field.read; field.write; }
    input kept: Rows<Int>;
    /// How many cells were kept. The Kernel does not read it: the node's
    /// `domain` does, with `value(count)`.
    input count: Rows<Int>;
    input field: Field;
    output result: Rows<Point>;

    fn place(c: IVec3, corners: IVec3) -> Vec3 {
        let side = float(max(corners.x - 1, 1));
        return (float(c) - float(corners - ivec3(1, 1, 1)) * 0.5) / side;
    }

    compute {
        let i = element();
        let corners = isize(field);
        let c = cell_at(at(kept, i / 8), corners);
        if !straddles(field, c) { return Point { position: place(c, corners), normal: vec3(0.0, 1.0, 0.0), uv: vec2(0.0, 0.0) }; }
        let corner = c + corner_of(i & 7);
        let gradient = vec3(
            float(at(field, corner + ivec3(1, 0, 0)) - at(field, corner - ivec3(1, 0, 0))),
            float(at(field, corner + ivec3(0, 1, 0)) - at(field, corner - ivec3(0, 1, 0))),
            float(at(field, corner + ivec3(0, 0, 1)) - at(field, corner - ivec3(0, 0, 1))));
        let p = place(corner, corners);
        return Point { position: p, normal: normalize(-gradient), uv: p.xz };
    }
}

/// Twelve triangles a kept cell, indexing that cell's own eight corners.
kernel surface.faces@1 {
    requires { field.read; field.write; }
    /// As in `surface.corners`: the node's `domain` reads this, not the
    /// Kernel. Which cells they are does not matter here, since a
    /// triangle indexes its own cell's block of corners.
    input count: Rows<Int>;
    output result: Rows<Tri>;
    compute {
        // A corner is `x + 2y + 4z`, as `corner_of` reads it; the six
        // faces, two triangles each.
        let cube = [0, 2, 6, 0, 6, 4,  1, 5, 7, 1, 7, 3,
                    0, 4, 5, 0, 5, 1,  2, 3, 7, 2, 7, 6,
                    0, 1, 3, 0, 3, 2,  4, 6, 7, 4, 7, 5];
        let t = element();
        let base = (t / 12) * 8;
        let k = (t % 12) * 3;
        return Tri { a: base + cube[k], b: base + cube[k + 1], c: base + cube[k + 2] };
    }
}

kernel surface.start@1 {
    requires { field.write; }
    output result: Rows<Camera>;
    compute { return Camera { angle: 0.0, height: 0.30, distance: 1.0 }; }
}

/// The eye goes round the blob on its own, and a hand takes it over: the
/// left stick, or the arrow keys, which is what the Player presses the
/// stick as.
kernel surface.orbit@1 {
    requires { field.read; field.write; time.read; input.read; }
    input previous: Rows<Camera>;
    param turn: Float = 0.04;
    param climb: Float = 0.02;
    output result: Rows<Camera>;

    fn held(code: Int) -> Float { return float(key(code)); }

    compute {
        let was = at(previous, 0);
        let pad = stick(0);
        let keys = vec2(held(39) - held(37), held(38) - held(40));
        let drive = if abs(pad.x) + abs(pad.y) > 0.01 { pad } else { keys };
        let driven = abs(drive.x) + abs(drive.y) > 0.01;
        return Camera {
            angle: if driven { was.angle + drive.x * turn } else { time() * 0.3 },
            height: if driven { clamp(was.height + drive.y * climb, -0.8, 0.8) } else { 0.30 },
            distance: was.distance,
        };
    }
}

kernel surface.project@1 {
    requires { field.read; field.write; }
    input mesh: Rows<Point>;
    input camera: Rows<Camera>;
    param aspect: Float = 1.7778;
    output result: Rows<Vertex>;

    compute {
        let cam = at(camera, 0);
        let v = sample(mesh);
        let eye = vec3(sin(cam.angle) * cam.distance, cam.height, cos(cam.angle) * cam.distance);
        let forward = normalize(-eye);
        let right = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));
        let up = cross(right, forward);
        let d = v.position - eye;
        let view = vec3(dot(d, right), dot(d, up), dot(d, forward));
        let f = 1.6;
        let near_plane = 0.02;
        let far = 6.0;
        return Vertex {
            clip: vec4(view.x * f / aspect, view.y * f,
                       view.z * far / (far - near_plane) - near_plane * far / (far - near_plane),
                       view.z),
            normal: v.normal,
            uv: v.uv,
        };
    }
}

kernel surface.shade@1 {
    requires { field.read; field.write; }
    input surface: Grid<Surface>;
    output result: Image;
    compute {
        let s = sample(surface);
        let sky = mix(vec3(0.09, 0.11, 0.16), vec3(0.03, 0.04, 0.07), coord().y / domain().y);
        let n = normalize(s.normal);
        let lit = max(dot(n, normalize(vec3(0.5, 0.8, 0.35))), 0.0);
        let rim = pow(1.0 - abs(n.z), 3.0) * 0.25;
        let tint = mix(vec3(0.85, 0.35, 0.30), vec3(0.30, 0.55, 0.90), saturate(s.uv.x + 0.5));
        let body = tint * (0.12 + 0.88 * lit) + rim;
        return vec4(if s.id < 0 { sky } else { body }, 1.0);
    }
}
