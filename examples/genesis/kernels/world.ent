//! A world of growing life that rewrites its own law of growth. The
//! law is `laws/grow.ent`; the world counts what lives, and when its
//! life is dying out or choking it fills `templates/grow.tmpl` with
//! another centre and width, and writes the law again.

/// The first life: noise, deterministic on every backend.
kernel world.seed@1 {
    requires { field.write; }
    param density: Float = 0.45;
    output result: Grid<Float>;

    fn hash(p: Vec2) -> Float {
        let q = fract(p * vec2(0.1031, 0.1030));
        let d = dot(q, q.yx + 33.33);
        let r = q + d;
        return fract((r.x + r.y) * (r.x - r.y + 1.0));
    }

    compute {
        return if hash(coord()) < density { hash(coord() + 7.0) } else { 0.0 };
    }
}

/// How many cells are more alive than not: a whole count, the same on
/// every backend.
kernel world.census@1 {
    requires { field.read; field.write; }
    input life: Grid<Float>;
    output result: Rows<Int>;
    compute { return int(sample(life) > 0.5); }
    merge(a, b) { return a + b; }
}

/// The law's numbers the world starts from, as `laws/grow.ent` holds
/// them: centre, width, the law's generation, frames since it was
/// written.
kernel world.first_tuning@1 {
    requires { field.write; }
    output result: Rows<Float>;
    compute { return [0.3, 0.06, 0.0, 0.0][element()]; }
}

/// The law's numbers, retuned while the world's life is out of balance,
/// once the last law has had `patience` frames: too crowded, a lower
/// centre and a narrower law thin it; too sparse, a higher centre and a
/// wider one let it grow. Its generation counts the laws written; in
/// balance, the law stands.
kernel world.tuning@1 {
    requires { field.read; field.write; }
    input before: Rows<Float>;
    input census: Rows<Int>;
    param cells: Float = 19200.0;
    param patience: Float = 20.0;
    output result: Rows<Float>;
    compute {
        let centre = at(before, 0);
        let width = at(before, 1);
        let generation = at(before, 2);
        let rest = at(before, 3);
        let share = float(at(census, 0)) / cells;
        let sparse = share < 0.25;
        let crowded = share > 0.31;
        let retune = rest >= patience && (sparse || crowded);
        let tuned = [
            clamp(centre + if sparse { 0.02 } else { -0.02 }, 0.1, 0.5),
            clamp(width * if sparse { 1.05 } else { 0.95 }, 0.01, 0.08),
            generation + 1.0,
            0.0
        ];
        let kept = [centre, width, generation, rest + 1.0];
        return if retune { tuned[element()] } else { kept[element()] };
    }
}

/// The life, coloured by the generation of the law it lives under; a
/// red frame while the world reads a problem in its laws.
kernel world.paint@1 {
    requires { field.read; field.write; }
    input life: Grid<Float>;
    input tuning: Rows<Float>;
    input problems: Rows<Int>;
    output result: Image;
    compute {
        let c = coord();
        let v = at(life, c);
        let hue = fract(at(tuning, 2) * 0.17 + 0.55);
        let tint = clamp(abs(fract(hue + vec3(0.0, 0.667, 0.333)) * 6.0 - 3.0) - 1.0, 0.0, 1.0);
        let lit = mix(vec3(0.02, 0.02, 0.04), tint, v);
        let edge = c.x < 2.0 || c.y < 2.0 || c.x >= domain().x - 2.0 || c.y >= domain().y - 2.0;
        let wrong = count(problems) > 1;
        return if edge && wrong { vec4(0.9, 0.1, 0.1, 1.0) } else { vec4(lit, 1.0) };
    }
}
