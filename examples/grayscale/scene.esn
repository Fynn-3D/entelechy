// gradient -> grayscale -> pixelate
use "kernels/";

node source: image.gradient@1 {
    domain = vec2(128, 128);
}

node gray: image.grayscale@1 {
    source <- source.result;
    amount = 1.0;
}

node blocks: image.pixelate@1 {
    source <- gray.result;
    size = 8;
}

output result <- blocks.result;
