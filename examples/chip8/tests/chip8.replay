scene ../scene.esn

# A 128 by 64 window: two pixels a cell. The first frame boots the
# machine: V0 and V1 to zero, I to the sprite, one draw, then the loop
# sets the delay timer and spins on it. The sprite is a 4 by 5 box, so
# the screen memory has its top row at 0..3 and its second row's ends at
# 64 and 67; the first opcodes run are 6000 and, fourth, D015.
window 128 64
frame 0.0
expect machine.result[0] = 24576
expect machine.result[3] = 53269
expect machine.screen[0] = 1
expect machine.screen[3] = 1
expect machine.screen[4] = 0
expect machine.screen[64] = 1
expect machine.screen[65] = 0
expect machine.screen[67] = 1
expect 1 1 = 0.55 0.95 0.45 0.02        # cell (0, 0) is lit
expect 7 1 = 0.55 0.95 0.45 0.02        # cell (3, 0), the box's right edge
expect 9 1 = 0.06 0.09 0.06 0.02        # cell (4, 0), beyond it
expect 3 3 = 0.06 0.09 0.06 0.02        # cell (1, 1), the box's hollow

# Every frame the timer runs out, the loop erases, reads the keys, and
# draws again; with nothing held the box stays.
frame 0.02
expect machine.screen[0] = 1
expect machine.regs[0] = 0

# E is the keypad's 6: right. Three frames move the box three cells.
key 69 down
frame 0.03
frame 0.05
frame 0.07
key 69 up
expect machine.regs[0] = 3
expect machine.screen[2] = 0
expect machine.screen[3] = 1
expect machine.screen[6] = 1
expect machine.screen[7] = 0

# S is the keypad's 8: down. Two frames, and the box's rows start at 2.
key 83 down
frame 0.08
frame 0.1
key 83 up
expect machine.regs[1] = 2
expect machine.screen[3] = 0
expect machine.screen[131] = 1        # row 2, column 3
expect machine.screen[195] = 1        # row 3, column 3: the box's side
expect machine.screen[196] = 0        # row 3, column 4: its hollow

# Q is the keypad's 4: left, wrapping round the screen after four frames.
key 81 down
frame 0.12
frame 0.13
frame 0.15
frame 0.17
key 81 up
expect machine.regs[0] = 255
expect machine.screen[191] = 1        # row 2, column 63
expect machine.screen[130] = 1        # row 2, column 2: the wrap
