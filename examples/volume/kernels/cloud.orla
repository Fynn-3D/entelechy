// A Volume<Float> of density, filled by one Kernel and ray-marched into an
// image by another. The volume never leaves the device on the GPU.

// Layered noise over the unit cube, drifting with time.
kernel cloud.density@1 {
    requires { field.write; time.read; }
    param scale: Float = 3.0;
    param cover: Float = 0.4;
    output result: Volume<Float>;

    fn hash(p: Vec3) -> Float {
        // Sin-free so the CPU and GPU agree on every cell.
        let q = fract(p * vec3(0.1031, 0.1030, 0.0973));
        let d = dot(q, vec3(q.y, q.z, q.x) + vec3(33.33, 33.33, 33.33));
        let r = q + vec3(d, d, d);
        return fract((r.x + r.y) * r.z);
    }

    fn noise(p: Vec3) -> Float {
        let i = floor(p);
        let f = fract(p);
        let u = f * f * (vec3(3.0, 3.0, 3.0) - f * 2.0);
        let a = mix(hash(i), hash(i + vec3(1.0, 0.0, 0.0)), u.x);
        let b = mix(hash(i + vec3(0.0, 1.0, 0.0)), hash(i + vec3(1.0, 1.0, 0.0)), u.x);
        let c = mix(hash(i + vec3(0.0, 0.0, 1.0)), hash(i + vec3(1.0, 0.0, 1.0)), u.x);
        let d = mix(hash(i + vec3(0.0, 1.0, 1.0)), hash(i + vec3(1.0, 1.0, 1.0)), u.x);
        return mix(mix(a, b, u.y), mix(c, d, u.y), u.z);
    }

    compute {
        let p = (coord() + vec3(0.5, 0.5, 0.5)) / domain();
        let q = p * scale + vec3(time() * 0.15, 0.0, time() * 0.1);
        let n = noise(q) * 0.5 + noise(q * 2.0) * 0.25 + noise(q * 4.0) * 0.125;
        // Fade toward the edges so the cloud floats inside the box.
        let edge = p - vec3(0.5, 0.5, 0.5);
        let inside = clamp(1.0 - length(edge) * 2.2, 0.0, 1.0);
        return clamp((n - cover) * 4.0, 0.0, 1.0) * inside;
    }
}

// March a ray per pixel through the unit cube, accumulating light through
// the density with a fixed step count.
kernel cloud.render@1 {
    requires { field.read; field.write; }
    input density: Volume<Float>;
    param absorb: Float = 9.0;
    output result: Image;

    struct March { light: Float; transmit: Float; }

    fn density_at(p: Vec3) -> Float {
        // Trilinear: the cloud reads as a field, not as the cells it is
        // stored in.
        return at_linear(density, p * size(density));
    }

    compute {
        let px = coord();
        let extent = domain();
        // Orthographic camera looking down the z axis.
        let uv = (px + vec2(0.5, 0.5)) / extent;
        let step = 1.0 / 48.0;
        let m = loop 48 with m = March { light: 0.0, transmit: 1.0 } until m.transmit < 0.01 {
            let z = (float(index()) + 0.5) * step;
            let d = density_at(vec3(uv.x, uv.y, z));
            let absorbed = exp(-d * absorb * step);
            // Light falls off with depth, as if lit from the front.
            let lit = (1.0 - absorbed) * m.transmit * (1.0 - z * 0.6);
            March { light: m.light + lit, transmit: m.transmit * absorbed }
        };
        let sky = mix(vec3(0.35, 0.55, 0.9), vec3(0.75, 0.85, 1.0), uv.y);
        let color = sky * m.transmit + vec3(1.0, 1.0, 1.0) * min(m.light * 1.3, 1.0);
        return vec4(color.x, color.y, color.z, 1.0);
    }
}
