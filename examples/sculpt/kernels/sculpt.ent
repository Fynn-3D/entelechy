// An island of 64 by 32 by 64 voxels made of shapes as data, a brush
// that digs it or raises earth where the pointer points, and its colors.
use "../../../packages/voxel.entpkg";

/// Voxel numbers: 1 grass, 2 earth, 3 stone, 4 water, 5 sand, 6 wood,
/// 7 leaves.
kernel sculpt.palette@1 {
    requires { field.write; }
    output result: Rows<Vec3>;
    compute {
        return match element() {
            1 => vec3(0.36, 0.6, 0.25), 2 => vec3(0.5, 0.36, 0.24), 3 => vec3(0.55, 0.55, 0.58), 4 => vec3(0.22, 0.42, 0.62),
            5 => vec3(0.86, 0.78, 0.55), 6 => vec3(0.42, 0.28, 0.16), 7 => vec3(0.24, 0.5, 0.2), _ => vec3(1.0, 0.0, 1.0)
        };
    }
}

/// The island, painted in order: earth with a skin of grass and a rim
/// of sand, a hill of stone, a pond dug out and filled, two trees.
kernel sculpt.island@1 {
    requires { field.write; }
    output result: Rows<VoxelShape>;
    compute {
        return match element() {
            0 => voxel_cuboid(vec3(32.0, 4.0, 32.0), vec3(30.0, 4.0, 30.0), 4.0, 5),
            1 => voxel_cuboid(vec3(32.0, 4.0, 32.0), vec3(28.0, 4.0, 28.0), 4.0, 1),
            2 => voxel_cuboid(vec3(32.0, 3.5, 32.0), vec3(28.0, 3.5, 28.0), 4.0, 2),
            3 => voxel_sphere(vec3(42.0, 0.0, 24.0), 15.0, 3),
            4 => voxel_cuboid(vec3(18.0, 8.0, 42.0), vec3(8.0, 2.0, 7.0), 2.0, 0),
            5 => voxel_cuboid(vec3(18.0, 6.5, 42.0), vec3(8.0, 0.5, 7.0), 0.5, 4),
            6 => voxel_capsule(vec3(20.0, 8.0, 18.0), vec3(20.0, 16.0, 18.0), 1.0, 6),
            7 => voxel_sphere(vec3(20.0, 18.0, 18.0), 4.5, 7),
            8 => voxel_capsule(vec3(12.0, 8.0, 28.0), vec3(12.0, 13.0, 28.0), 0.8, 6),
            _ => voxel_sphere(vec3(12.0, 15.0, 28.0), 3.5, 7)
        };
    }
}

/// What the brush paints this frame: where the pointer points, as the
/// view sees it, a ball of `radius` dug out (left button) or of earth
/// raised on the face pointed at (right button); a shape holding nothing
/// when no button is held or the pointer points at the sky.
kernel sculpt.brush@1 {
    requires { field.read; field.write; input.read; }
    input volume: Voxels;
    param yaw: Float = 0.6;
    param pitch: Float = 0.45;
    param distance: Float = 1.1;
    param radius: Float = 2.5;
    output result: Rows<VoxelShape>;
    compute {
        let n = size(volume);
        let cam = voxel_view_camera(n, yaw, pitch, distance, window());
        let dir = voxel_ray(cam, pointer(), window());
        let b = voxel_view_box(n);
        let met = voxel_meet(volume, b, cam.eye, dir, 0.0);
        let cell = voxel_cell(b, cam.eye, dir, met) + vec3(0.5, 0.5, 0.5);
        if met.id == 0 { return voxel_sphere(cell, -1.0, 0); }
        return if button(0) { voxel_sphere(cell, radius, 0) } else if button(1) { voxel_sphere(cell + met.face, radius, 2) } else { voxel_sphere(cell, -1.0, 0) };
    }
}
