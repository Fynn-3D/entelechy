// An island made of shapes and sculpted by hand: the left button digs
// where the pointer points, the right raises earth there. The brush picks
// against the world as last drawn, the world is painted over by what the
// brush gives each frame, and the render package's view draws it.
use "../../packages/voxel.entpkg";
use "kernels/";

param yaw: Float = 0.6;
param pitch: Float = 0.5;
param distance: Float = 0.75;

node shapes: sculpt.island@1 { domain = 10; }
node island: voxel.shapes@1 { shapes <- shapes.result; domain = vec3(64, 32, 64); }
node brush: sculpt.brush@1 {
    volume <~ world.result from island.result;
    yaw = yaw;
    pitch = pitch;
    distance = distance;
    domain = 1;
}
node world: voxel.paint@1 {
    volume <~ world.result from island.result;
    shapes <- brush.result;
    domain = vec3(64, 32, 64);
}
node palette: sculpt.palette@1 { domain = 8; }
node view: graph "../../packages/voxel.entpkg/graphs/view.esn" {
    volume <- world.result;
    colors <- palette.result;
    yaw = yaw;
    pitch = pitch;
    distance = distance;
}

output result <- view.result;
