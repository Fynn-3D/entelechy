// The sound board (`kernels/board.ent` has the keys).
use "kernels/board.ent";
use "../../../../packages/audio.entpkg";
use "../../../../packages/sound.entpkg";
use "../../../../packages/text.entpkg";

input materials: Materials = "../../../../packages/sound.entpkg/data/materials.csv";
input styles: Styles = "../../../../packages/sound.entpkg/data/styles.csv";
input font: Grid<Float> = "../../../../packages/text.entpkg/assets/font.png";
input kinds: Rows<Int> = text "step\nmenu move\nconfirm\ncancel\nerror\nmenu open\nmenu close\npage\ntyping\ncoin\nitem got\nequip\nbuy\nhit\ncritical\nmiss\nblock\nbody falls\njump\npick up\nswing\ndoor\nchest\nlever\nsplash\ndig\nchop\nmine\nbuild\nbell\nlevel up\nvictory\ndefeat\nfled\nnew day\nquest done\ndiscovery\nsaved\nencounter\nalarm";
input materials_names: Rows<Int> = text "grass\nstone\nwood\ndirt\nsand\nsnow\nwater\nmetal\nflesh\narmour\nbone\nslime\ncloth\ncrystal";
input styles_names: Rows<Int> = text "wood\nmetal\ncrystal\narcane\nretro\nsoft";
input help: Rows<Int> = text "Up/Down event  Left/Right material or style\nT how (gait, weight, strength)  Space play  A all";

node paced0: audio.paced_start@1 { domain = 1; }
node paced: audio.paced@1 { previous <~ paced.result from paced0.result; domain = 1; }
node clock: audio.paced_clock@1 { paced <- paced.result; domain = 1; }
node block: audio.paced_size@1 { paced <- paced.result; domain = 1; }
node board0: board.start@1 { domain = 1; }
node board: board.step@1 { previous <~ board.result from board0.result; clock <- clock.result; materials <- materials; styles <- styles; domain = 1; }
node cue: board.cue@1 { board <- board.result; domain = 1; }
node heard: sound.events@1 { cues <- cue.result; clock <- clock.result; materials <- materials; styles <- styles; block <- block.result; domain = value(block, 0); }

node back: kernel {
    requires { field.write; }
    output result: Image;
    domain = vec2(320, 90);
    compute { return vec4(0.02, 0.02, 0.03, 1.0); }
}
node said: board.words@1 { board <- board.result; kinds <- kinds; materials_names <- materials_names; styles_names <- styles_names; help <- help; domain = 200; }
node laid: text.layout@1 { codes <- said.result; origin = vec2(6.0, 6.0); wrap = 40; scale = 1.0; }
node shown: text.draw@1 { under <- back.result; glyphs <- laid.result; font <- font; color = vec3(0.9, 0.85, 0.7); }

output result <- shown.result;
output sound <- heard.result;
