// The spectrum on its own: the font and the caption read here, the
// graph in `spectrum.osn` placed over them. The block is the scene's
// sound output, so the Player plays it.
input font: Grid<Float> = "../../../../packages/text.orlapkg/font.png";
input caption: Rows<Int> = text "loudest";

param pitch: Float = 220.0;

node spectrum: graph "spectrum.osn" {
    font <- font;
    caption <- caption;
    pitch = pitch;
}

output result <- spectrum.result;
output sound <- spectrum.sound;
