// A binary file nothing in Orla knows, read by a Kernel. The scene takes
// the file as `bytes`, which is rows of one integer a byte, and this
// walks it: four bytes of magic, a version, the map's width and height,
// that many tiles, then a count two bytes wide and that many entities.
// No importer, no Rust: the format lives here, and a saved edit changes
// it while the scene runs.

type Bytes = Rows<Int>;

// The header, by its offsets.
fn version(data: Bytes) -> Int { return at(data, 4); }
fn width(data: Bytes) -> Int { return at(data, 5); }
fn height(data: Bytes) -> Int { return at(data, 6); }
fn tile_at(data: Bytes, x: Int, y: Int) -> Int { return at(data, 7 + y * width(data) + x); }

// Where the entities begin, and how many there are: a count written low
// byte first, which is two `at` reads and a shift.
fn entities_at(data: Bytes) -> Int { return 7 + width(data) * height(data); }
fn entity_count(data: Bytes) -> Int {
    let at0 = entities_at(data);
    return at(data, at0) + at(data, at0 + 1) * 256;
}
fn entity(data: Bytes, i: Int, field: Int) -> Int {
    return at(data, entities_at(data) + 2 + i * 3 + field);
}

// Whether the file is one of ours, which four bytes say.
fn ours(data: Bytes) -> Bool {
    return at(data, 0) == 79 && at(data, 1) == 82 && at(data, 2) == 76 && at(data, 3) == 86;
}

kernel level.draw@1 {
    requires { field.read; field.write; time.read; }
    input data: Bytes;
    param zoom: Float = 1.0;
    output result: Image;

    fn tile_colour(id: Int, shade: Float) -> Vec3 {
        let ground = mix(vec3(0.16, 0.19, 0.16), vec3(0.22, 0.26, 0.22), shade);
        let wall = mix(vec3(0.38, 0.35, 0.33), vec3(0.52, 0.48, 0.45), shade);
        let water = mix(vec3(0.10, 0.28, 0.5), vec3(0.16, 0.4, 0.65), shade);
        let grass = mix(vec3(0.16, 0.42, 0.18), vec3(0.24, 0.55, 0.24), shade);
        return if id == 1 { wall } else if id == 2 { water } else if id == 3 { grass } else { ground };
    }

    // A dot for an entity, by what kind it is.
    fn marker(kind: Int) -> Vec3 {
        return if kind == 0 { vec3(1.0, 0.85, 0.3) }
            else if kind == 1 { vec3(0.95, 0.35, 0.3) }
            else { vec3(0.6, 0.75, 1.0) };
    }

    compute {
        let res = domain();
        // Not our file: one flat colour, and nothing else is read. A
        // Kernel has no early return, so the guard rides to the end.
        let known = ours(data);
        let w = if known { width(data) } else { 1 };
        let h = if known { height(data) } else { 1 };
        let map = vec2(float(w), float(h));
        // The map, centred and scaled to fit, a tile a square.
        let side = min(res.x / map.x, res.y / map.y) * zoom;
        let origin = (res - map * side) * 0.5;
        let cell = (coord() + vec2(0.5, 0.5) - origin) / side;
        let inside = cell.x >= 0.0 && cell.y >= 0.0 && cell.x < map.x && cell.y < map.y;
        let x = clamp(int(cell.x), 0, w - 1);
        let y = clamp(int(cell.y), 0, h - 1);
        let id = tile_at(data, x, y);
        let local = fract(cell);
        let edge = local.x < 0.04 || local.y < 0.04;
        let shade = if edge { 0.0 } else { 1.0 };
        let ground = if inside { tile_colour(id, shade) } else { vec3(0.05, 0.05, 0.07) };
        // Every entity the file lists, drawn over the map: the count is
        // read from the file, and the loop takes it.
        let n = if known { entity_count(data) } else { 0 };
        let lit = loop n with colour = ground {
            let i = index();
            let ex = float(entity(data, i, 1)) + 0.5;
            let ey = float(entity(data, i, 2)) + 0.5;
            let away = length(cell - vec2(ex, ey));
            let pulse = 0.34 + 0.06 * sin(time() * 3.0 + float(i));
            if inside && away < pulse {
                mix(marker(entity(data, i, 0)), vec3(1.0, 1.0, 1.0), max(0.0, 1.0 - away / pulse) * 0.35)
            } else {
                colour
            }
        };
        let shown = if known { lit } else { vec3(0.35, 0.05, 0.08) };
        return vec4(shown.x, shown.y, shown.z, 1.0);
    }
}

/// What the file says about itself, as numbers a label prints: the
/// version, the width, the height and how many entities it lists.
kernel level.about@1 {
    requires { field.read; field.write; }
    input data: Bytes;
    output result: Rows<Float>;
    compute {
        let i = element();
        return float(if i == 0 { version(data) }
            else if i == 1 { width(data) }
            else if i == 2 { height(data) }
            else { entity_count(data) });
    }
}
