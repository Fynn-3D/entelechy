// signed-distance scene -> tone mapping sub-graph -> output
use "kernels/";

param exposure: Float = 1.1;

node scene: scene.march@1 {
    domain = vec2(400, 260);
    steps = 96;
}

node display: graph "../../packages/picture.orlapkg/graphs/display.osn" {
    source <- scene.result;
    exposure = exposure;
}

output result <- display.result;
