/// Signed-distance ray marching: a bounded loop walks each ray until it is
/// close to a surface or leaves the scene. The loop carries a struct, so the
/// distance, the material, and the last step travel together.
kernel scene.march@1 {
    requires { field.write; time.read; }
    param orbit_speed: Float = 0.35;
    param steps: Int = 96;
    output result: Image;

    struct Ray { origin: Vec3; direction: Vec3; }
    struct Surface { distance: Float; material: Int; }
    struct March { t: Float; material: Int; last: Float; done: Bool; }
    struct Shadow { t: Float; light: Float; }

    fn sphere(p: Vec3, r: Float) -> Float {
        return length(p) - r;
    }

    fn torus(p: Vec3, big: Float, small: Float) -> Float {
        let q = vec2(length(vec2(p.x, p.z)) - big, p.y);
        return length(q) - small;
    }

    fn rounded_box(p: Vec3, b: Vec3, r: Float) -> Float {
        let q = abs(p) - b;
        return length(max(q, vec3(0.0, 0.0, 0.0))) + min(max(q.x, max(q.y, q.z)), 0.0) - r;
    }

    fn closer(a: Surface, b: Surface) -> Surface {
        return if b.distance < a.distance { b } else { a };
    }

    // The closest surface and which material it carries.
    fn scene(p: Vec3) -> Surface {
        let floor = Surface { distance: p.y + 1.0, material: 0 };
        let ball = Surface { distance: sphere(p - vec3(-1.3, 0.0, 0.0), 1.0), material: 1 };
        let ring = Surface { distance: torus(p - vec3(1.4, -0.4, 0.4), 0.8, 0.28), material: 2 };
        let block = Surface {
            distance: rounded_box(p - vec3(0.2, -0.5, -1.6), vec3(0.45, 0.5, 0.45), 0.08),
            material: 3,
        };
        return closer(closer(closer(floor, ball), ring), block);
    }

    fn normal(p: Vec3) -> Vec3 {
        let e = 0.001;
        let dx = scene(p + vec3(e, 0.0, 0.0)).distance - scene(p - vec3(e, 0.0, 0.0)).distance;
        let dy = scene(p + vec3(0.0, e, 0.0)).distance - scene(p - vec3(0.0, e, 0.0)).distance;
        let dz = scene(p + vec3(0.0, 0.0, e)).distance - scene(p - vec3(0.0, 0.0, e)).distance;
        return normalize(vec3(dx, dy, dz));
    }

    // March along a ray; `done` is true on a hit, false when the ray escaped.
    fn march(ray: Ray, limit: Int) -> March {
        let start = March { t: 0.02, material: -1, last: 1.0, done: false };
        return loop 256 with m = start until m.done || m.t > 40.0 || index() >= limit {
            let hit = scene(ray.origin + ray.direction * m.t);
            March {
                t: m.t + hit.distance,
                material: hit.material,
                last: hit.distance,
                done: hit.distance < 0.0005,
            }
        };
    }

    // Soft shadow: track the smallest cone ratio along the light ray.
    fn shadow(ray: Ray) -> Float {
        let s = loop 48 with st = Shadow { t: 0.05, light: 1.0 } until st.t > 12.0 || st.light < 0.005 {
            let h = scene(ray.origin + ray.direction * st.t).distance;
            Shadow { t: st.t + clamp(h, 0.02, 0.5), light: min(st.light, 10.0 * h / st.t) }
        };
        return clamp(s.light, 0.0, 1.0);
    }

    fn material(id: Int, p: Vec3) -> Vec3 {
        let checker = step(0.5, fract(p.x * 0.5)) + step(0.5, fract(p.z * 0.5));
        let tile = mix(vec3(0.35, 0.35, 0.38), vec3(0.8, 0.8, 0.82), abs(checker - 1.0));
        return if id == 0 { tile }
            else if id == 1 { vec3(0.9, 0.25, 0.2) }
            else if id == 2 { vec3(0.95, 0.75, 0.2) }
            else { vec3(0.2, 0.5, 0.9) };
    }

    fn sky(d: Vec3) -> Vec3 {
        let t = clamp(d.y * 0.7 + 0.3, 0.0, 1.0);
        return mix(vec3(0.62, 0.66, 0.74), vec3(0.15, 0.28, 0.55), t);
    }

    compute {
        let res = domain();
        let px = (coord() + vec2(0.5, 0.5)) / res * 2.0 - vec2(1.0, 1.0);
        let aspect = res.x / res.y;
        let angle = time() * orbit_speed;
        let ro = vec3(sin(angle) * 5.0, 1.6, cos(angle) * 5.0);
        let forward = normalize(vec3(0.0, -0.3, 0.0) - ro);
        let right = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));
        let up = cross(right, forward);
        let rd = normalize(forward * 1.7 + right * (px.x * aspect) + up * (-px.y));

        let hit = march(Ray { origin: ro, direction: rd }, steps);
        let color = if !hit.done {
            sky(rd)
        } else {
            let p = ro + rd * hit.t;
            let n = normal(p);
            let light = normalize(vec3(1.5, 2.2, 1.0));
            let lit_by = shadow(Ray { origin: p + n * 0.02, direction: light });
            let diffuse = max(dot(n, light), 0.0) * lit_by;
            let ambient = 0.18 + 0.12 * n.y;
            let h = normalize(light - rd);
            let spec = pow(max(dot(n, h), 0.0), 48.0) * 0.5;
            let base = material(hit.material, p);
            let lit = base * (diffuse * vec3(1.0, 0.95, 0.85) + ambient) + vec3(spec, spec, spec);
            mix(lit, sky(rd), 1.0 - exp(-hit.t * 0.045))
        };
        return vec4(color.x, color.y, color.z, 1.0);
    }
}
