// Signed-distance ray marching: a bounded loop walks each ray until it is
// close to a surface or leaves the scene. Shadows and normals are loops too.
kernel scene.march@1 {
    requires { image.write; time.read; }
    param orbit_speed: Float = 0.35;
    param steps: Int = 96;
    output result: Image;

    fn sphere(p: Vec3, r: Float) -> Float {
        return length(p) - r;
    }

    fn torus(p: Vec3, big: Float, small: Float) -> Float {
        let q = vec2(length(vec2(p.x, p.z)) - big, p.y);
        return length(q) - small;
    }

    fn rounded_box(p: Vec3, b: Vec3, r: Float) -> Float {
        let q = abs(p) - b;
        return length(max(q, vec3(0.0, 0.0, 0.0))) + min(max(q.x, max(q.y, q.z)), 0.0) - r;
    }

    // Distance to the closest surface; .y carries a material id.
    fn scene(p: Vec3) -> Vec2 {
        let floor = p.y + 1.0;
        let ball = sphere(p - vec3(-1.3, 0.0, 0.0), 1.0);
        let ring = torus(p - vec3(1.4, -0.4, 0.4), 0.8, 0.28);
        let block = rounded_box(p - vec3(0.2, -0.5, -1.6), vec3(0.45, 0.5, 0.45), 0.08);
        let d1 = if ball < floor { vec2(ball, 1.0) } else { vec2(floor, 0.0) };
        let d2 = if ring < d1.x { vec2(ring, 2.0) } else { d1 };
        return if block < d2.x { vec2(block, 3.0) } else { d2 };
    }

    fn normal(p: Vec3) -> Vec3 {
        let e = 0.001;
        let dx = scene(p + vec3(e, 0.0, 0.0)).x - scene(p - vec3(e, 0.0, 0.0)).x;
        let dy = scene(p + vec3(0.0, e, 0.0)).x - scene(p - vec3(0.0, e, 0.0)).x;
        let dz = scene(p + vec3(0.0, 0.0, e)).x - scene(p - vec3(0.0, 0.0, e)).x;
        return normalize(vec3(dx, dy, dz));
    }

    // March along a ray; returns (distance, material) or material -1 on a miss.
    fn march(ro: Vec3, rd: Vec3, limit: Int) -> Vec2 {
        let state = loop 256 with s = vec3(0.02, -1.0, 1.0)
            until s.z < 0.0005 || s.x > 40.0 || index() >= limit {
            let hit = scene(ro + rd * s.x);
            vec3(s.x + hit.x, hit.y, hit.x)
        };
        return if state.z < 0.0005 { vec2(state.x, state.y) } else { vec2(state.x, -1.0) };
    }

    // Soft shadow: track the smallest cone ratio along the light ray.
    fn shadow(ro: Vec3, rd: Vec3) -> Float {
        let s = loop 48 with st = vec2(0.05, 1.0) until st.x > 12.0 || st.y < 0.005 {
            let h = scene(ro + rd * st.x).x;
            vec2(st.x + clamp(h, 0.02, 0.5), min(st.y, 10.0 * h / st.x))
        };
        return clamp(s.y, 0.0, 1.0);
    }

    fn material(id: Float, p: Vec3) -> Vec3 {
        let checker = step(0.5, fract(p.x * 0.5)) + step(0.5, fract(p.z * 0.5));
        let tile = mix(vec3(0.35, 0.35, 0.38), vec3(0.8, 0.8, 0.82), abs(checker - 1.0));
        return if id < 0.5 { tile }
            else if id < 1.5 { vec3(0.9, 0.25, 0.2) }
            else if id < 2.5 { vec3(0.95, 0.75, 0.2) }
            else { vec3(0.2, 0.5, 0.9) };
    }

    fn sky(d: Vec3) -> Vec3 {
        let t = clamp(d.y * 0.7 + 0.3, 0.0, 1.0);
        return mix(vec3(0.62, 0.66, 0.74), vec3(0.15, 0.28, 0.55), t);
    }

    compute {
        let res = domain();
        let px = (coord() + vec2(0.5, 0.5)) / res * 2.0 - vec2(1.0, 1.0);
        let aspect = res.x / res.y;
        let angle = time() * orbit_speed;
        let ro = vec3(sin(angle) * 5.0, 1.6, cos(angle) * 5.0);
        let forward = normalize(vec3(0.0, -0.3, 0.0) - ro);
        let right = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));
        let up = cross(right, forward);
        let rd = normalize(forward * 1.7 + right * (px.x * aspect) + up * (-px.y));

        let hit = march(ro, rd, steps);
        let color = if hit.y < 0.0 {
            sky(rd)
        } else {
            let p = ro + rd * hit.x;
            let n = normal(p);
            let light = normalize(vec3(1.5, 2.2, 1.0));
            let diffuse = max(dot(n, light), 0.0) * shadow(p + n * 0.02, light);
            let ambient = 0.18 + 0.12 * n.y;
            let h = normalize(light - rd);
            let spec = pow(max(dot(n, h), 0.0), 48.0) * 0.5;
            let base = material(hit.y, p);
            let lit = base * (diffuse * vec3(1.0, 0.95, 0.85) + ambient) + vec3(spec, spec, spec);
            mix(lit, sky(rd), 1.0 - exp(-hit.x * 0.045))
        };
        return vec4(color.x, color.y, color.z, 1.0);
    }
}
